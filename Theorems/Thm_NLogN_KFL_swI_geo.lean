set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD KFE KFB AModel AModelL12 NetProp7
theorem NLogN.KFL.swI_geo :
    ∃ T q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (g : NLogN.KFL.Geo), g.Pos → ∀ u : ℕ, 1 ≤ u → g.Q = 2 ^ u →
      ∀ (I : List NLogN.Sym) (t : NLogN.IState NLogN.HS) (zs : List ℤ) (R : List NLogN.Item),
      NLogN.KFL.Bits zs → t.G 0 = NLogN.ints zs ++ R → zs.length = g.V →
      (∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFL.swI q g.N0 g.N1 (AModel.vol [g.N2, g.Q, g.N3, g.B]) u) t
          (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g NLogN.KFL.sw01 zs) ++ R)) c ∧
          (c : ℝ) ≤ K * ((g.V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)) ∧
      (∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFL.swI q (AModel.vol [g.N0, g.Q, g.N1]) g.N2 (AModel.vol [g.N3, g.B]) u) t
          (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g NLogN.KFL.sw12 zs) ++ R)) c ∧
          (c : ℝ) ≤ K * ((g.V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)) ∧
      (∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFL.swI q g.N0 (AModel.vol [g.N1, g.Q, g.N2]) (AModel.vol [g.N3, g.B]) u) t
          (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g NLogN.KFL.sw02 zs) ++ R)) c ∧
          (c : ℝ) ≤ K * ((g.V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)) := by
  obtain ⟨T, q₀, H⟩ := NLogN.KFL.swI_spec
  refine ⟨T, q₀, fun q hq hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q hq hq₀
  refine ⟨K, hK, fun g hg u hu hQ I t zs R hb h0 hlen => ?_⟩
  set xs : List (ZMod 2) := zs.map fun z : ℤ => (Int.cast z : ZMod 2)
  have hx : NLogN.KIL.enc2 xs = zs := NLogN.KFL.bits_enc2 zs hb
  have pos : ∀ l : List ℕ, (∀ a ∈ l, 0 < a) → ∀ a ∈ l, 1 ≤ a := fun l h a ha => h a ha
  have hq := hg.q; have h0' := hg.n0; have h1 := hg.n1; have h2 := hg.n2; have h3 := hg.n3
  have hB := hg.b
  have hxl : xs.length = g.V := by simp [xs, hlen]
  have hsh : ∀ Pre G Suf : AModel.Shape, AModelL12.binShape Pre G Suf (2 ^ u) = g.sh8 →
      AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) = g.V := fun Pre G Suf e => by rw [e, NLogN.KFL.Geo.vol_sh8]
  refine ⟨?_, ?_, ?_⟩
  · have e : AModelL12.binShape [g.N0] [g.N1] [g.N2, g.Q, g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [AModelL12.binShape, NLogN.KFL.Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0] [g.N1] [g.N2, g.Q, g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    simp only [AModel.vol, List.foldr] at Hc
    refine ⟨c, ?_, hc⟩
    rw [← NLogN.KFL.pull_swap13 g hg]; simpa [AModel.vol] using Hc
  · have e : AModelL12.binShape [g.N0, g.Q, g.N1] [g.N2] [g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [AModelL12.binShape, NLogN.KFL.Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0, g.Q, g.N1] [g.N2] [g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    rw [← NLogN.KFL.pull_swap35 g hg]; simpa [AModel.vol] using Hc
  · have e : AModelL12.binShape [g.N0] [g.N1, g.Q, g.N2] [g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [AModelL12.binShape, NLogN.KFL.Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0] [g.N1, g.Q, g.N2] [g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    rw [← NLogN.KFL.pull_swap15 g hg]; simpa [AModel.vol] using Hc
end
