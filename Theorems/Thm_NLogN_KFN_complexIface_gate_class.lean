theorem NLogN.KFN.complexIface_gate_class (G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ)
    (hm : P8Lift.RStep.gate G ∈ P8Lift.complexIface.net) :
    (∃ as : List NLogN.KFG.Atom, (∀ a ∈ as, a.Ok P8Lift.Wc ∧ a.h ≤ 1) ∧ NLogN.KFG.NoTS as ∧
        G = NLogN.KFG.gateMat P8Lift.Wc as) ∨
      (∃ U : Finset (Fin P8Lift.Wc), G = Matrix.diagonal fun w => if w ∈ U then -1 else 1) := by
  simp only [P8Lift.complexIface, List.mem_map] at hm
  obtain ⟨st, hst, he⟩ := hm
  cases st with
  | gate G0 =>
    simp only [P8Lift.RStep.map] at he
    injection he with he
    subst he
    obtain ⟨g, hg, rfl⟩ := NLogN.KFN.gate_mem_prog G0 hst
    rcases NLogN.KFN.cxFixNamed_class NetComplex.ind₀_card NetComplex.ind₀_inj g hg with hgok | hfix
    · obtain ⟨as, h1, h2, h3⟩ := NLogN.KFN.GOK_atoms P8Lift.eW hgok
      exact Or.inl ⟨as, h1, h2, h3.symm ▸ rfl⟩
    · refine Or.inr ⟨(Finset.univ.image (NetComplex.wX (ind := NetComplex.ind₀))).map
        P8Lift.eW.toEmbedding, ?_⟩
      rw [hfix, NLogN.KFN.fixG_diag]
      ext i j
      simp only [Matrix.diagonal_apply, Finset.mem_map_equiv, P8Lift.eW.symm.injective.eq_iff]
  | rowAdd => simp [P8Lift.RStep.map] at he
  | phase => simp [P8Lift.RStep.map] at he
  | perm => simp [P8Lift.RStep.map] at he
  | child => simp [P8Lift.RStep.map] at he
end
