theorem srw_add {x y : ℕ} (hxy : x < y) (hy : y < m) :
    srw m K e k y + m ^ k * K * (y - x) = srw m K e k x := by
  obtain ⟨_, _, hx'⟩ := sR_int (K := K) (F := m ^ k) (e := e) (f1_pos hp.m1 k) (hxy.trans hy) hp.he'
  obtain ⟨_, _, hy'⟩ := sR_int (K := K) (F := m ^ k) (e := e) (f1_pos hp.m1 k) hy hp.he'
  have : ((srw m K e k y : ℕ) : ℤ) + ((m ^ k * K * (y - x) : ℕ) : ℤ) = ((srw m K e k x : ℕ) : ℤ) := by
    rw [hx', hy']; push_cast [Nat.cast_sub hxy.le]; ring
  exact_mod_cast this

theorem srw_top {x : ℕ} (hx : x < m) : srw m K e k x + m ^ k * K ≤ T := by
  obtain ⟨hE, hmod, _⟩ := sR_int (K := K) (F := m ^ k) (e := e) (f1_pos hp.m1 k) hx hp.he'
  have hf := f1_pos hp.m1 k
  have hPQ : K * (m ^ k - 1) ≤ K * (m ^ k * (x + 1) - 1) :=
    Nat.mul_le_mul_left _ (by have : m ^ k ≤ m ^ k * (x + 1) := Nat.le_mul_of_pos_right _ (by omega)
                              omega)
  have hQ : K * (m ^ k - 1) + K = m ^ k * K := by
    rw [Nat.mul_sub_one, Nat.mul_comm (m ^ k) K]
    have : K ≤ K * m ^ k := Nat.le_mul_of_pos_right _ hf
    omega
  have ht := hp.ht
  have := Nat.mod_le e K
  unfold srw KFR.sR
  omega

theorem srw_le {x : ℕ} (hx : x < m) : srw m K e k x ≤ T := by have := srw_top hp hx; omega

end SFacts

