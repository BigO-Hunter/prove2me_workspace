variable {m k K e T S0 B r H : ℕ} (hp : PF m k K e T S0 B r)
include hp

theorem PF.KT : K ≤ T := by have := hp.ht; omega

theorem PF.fT : m ^ k ≤ T := by
  have := hp.fm
  calc m ^ k = m ^ k * 1 := (mul_one _).symm
    _ ≤ m ^ k * m := Nat.mul_le_mul_left _ (by have := hp.m16; omega)
    _ ≤ T := hp.fm

theorem PF.he' : K * (m ^ k * m - 1) ≤ e := by rw [← pow_succ]; exact hp.he

theorem PF.fK : m ^ k * K ≤ e := by
  have h1 : m ^ k ≤ m ^ k * m - 1 := by
    have := f1_pos hp.m1 k
    have : m ^ k * 2 ≤ m ^ k * m := Nat.mul_le_mul_left _ (by have := hp.m16; omega)
    omega
  have := Nat.mul_le_mul_left K h1
  have := hp.he'
  rw [Nat.mul_comm (m ^ k) K]; omega

end PFacts

section SFacts

variable {m k K e T S0 B r : ℕ} (hp : PF m k K e T S0 B r)
