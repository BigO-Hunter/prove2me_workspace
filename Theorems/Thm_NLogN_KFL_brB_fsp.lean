theorem badB_fsp {B Bb : ℕ} (hB1 : 1 ≤ Bb) (s : IState HS) (G : Fin HS → List ℤ) (L l : List ℤ)
    (h0 : G 0 = L ++ l) (hL : L.length = B) (hLb : Bnd 1 L) (zB : zsz (B : ℤ) ≤ Bb)
    {kv nb : ℤ} {lk ln : List ℤ} (hK : G rK = kv :: lk) (zk : zsz kv ≤ Bb)
    (hN : G rNB = nb :: ln) (zn : zsz nb ≤ Bb) (zn1 : zsz (nb + 1) ≤ Bb) :
    FSp (badB B) (encK s G) (encK s (Function.update (Function.update (Function.update
      (Function.update (Function.update G 0 l) sKB (L.reverse ++ G sKB)) sKK (kv :: G sKK))
      sFL (1 :: G sFL)) rNB ((nb + 1) :: ln))) (cBr B Bb) := by
  have S1 := FSp.mvL (X := 0) (Y := sKB) (C := cMv) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s G L l h0 1 Bb hLb (by rw [hL]; exact zB)
  rw [hL] at S1
  set G1 := Function.update (Function.update G 0 l) sKB (L.reverse ++ G sKB)
  have g1K : G1 rK = kv :: lk := by simp only [G1]; rw [upd_ne (by decide), upd_ne (by decide)]; exact hK
  have S2 := Sp.pushQ s G1 (i := sKK) (e := .reg rK) (B := Bb) (by decide) (clean_reg (by decide))
    (ok_reg g1K) (bnd_reg g1K zk)
  rw [eval_reg g1K] at S2
  set G2 := Function.update G1 sKK (kv :: G1 sKK)
  have S3 := Sp.pushQ s G2 (i := sFL) (e := .lit 1) (B := Bb) (by decide) (clean_lit _) trivial
    (by simp only [Ex.Bnd, zsz_one]; exact hB1)
  simp only [Ex.eval] at S3
  set G3 := Function.update G2 sFL (1 :: G2 sFL)
  have g3N : G3 rNB = nb :: ln := by
    simp only [G3, G2, G1]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
      upd_ne (by decide)]; exact hN
  have S4 := Sp.asgQ s G3 (i := rNB) (e := .add (.reg rNB) (.lit 1)) (B := Bb) (by decide) g3N zn
    (clean_add (clean_reg (by decide)) (clean_lit _)) ⟨ok_reg g3N, trivial⟩
    ⟨bnd_reg g3N zn, by simp only [Ex.Bnd, zsz_one]; exact hB1, by
      simp only [Ex.eval]; rw [top_encK g3N]; exact zn1⟩
  have ev4 : (Ex.add (.reg rNB) (.lit 1) : Ex HS).eval (encK s G3) = nb + 1 := by
    simp only [Ex.eval]; rw [top_encK g3N]
  rw [ev4] at S4
  have H := S1.seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq (FSp.of_norep rfl S4)))
  refine (H.congr ?_).mono ?_
  · congr 1
  · simp only [cBr, Ex.size]
    have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
    generalize (Bb + 2) ^ 2 = X at *
    generalize cLp B (250 * (1 + 2)) Bb = Y
    try omega

theorem goodB_fsp {B Bb : ℕ} (hB1 : 1 ≤ Bb) (s : IState HS) (G : Fin HS → List ℤ) (L l : List ℤ)
    (h0 : G 0 = L ++ l) (hL : L.length = B) (hLb : Bnd 1 L) (zB : zsz (B : ℤ) ≤ Bb) :
    FSp (goodB B) (encK s G) (encK s (Function.update (Function.update (Function.update G 0 l)
      sT (L.reverse ++ G sT)) sFL (0 :: G sFL))) (cBr B Bb) := by
  have S1 := FSp.mvL (X := 0) (Y := sT) (C := cMv) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s G L l h0 1 Bb hLb (by rw [hL]; exact zB)
  rw [hL] at S1
  set G1 := Function.update (Function.update G 0 l) sT (L.reverse ++ G sT)
  have S2 := Sp.pushQ s G1 (i := sFL) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial
    (by simp only [Ex.Bnd, zsz_zero]; omega)
  simp only [Ex.eval] at S2
  have H := S1.seq (FSp.of_norep rfl S2)
  refine (H.congr ?_).mono ?_
  · congr 1
  · simp only [cBr, Ex.size]
    generalize (Bb + 2) ^ 2 = X at *
    generalize cLp B (250 * (1 + 2)) Bb = Y
    try omega

/-! ## One record of pass 1 -/

/-- The branch on `κ m ≠ m`, as an explicit state. -/
theorem brB_fsp_sol_aux {B Bb : ℕ} (hB1 : 1 ≤ Bb) (s : IState HS) (G : Fin HS → List ℤ) (L l : List ℤ)
    (h0 : G 0 = L ++ l) (hL : L.length = B) (hLb : Bnd 1 L) (zB : zsz (B : ℤ) ≤ Bb)
    {k kv nb : ℕ} {lk lm ln : List ℤ} (hK : G rK = (kv : ℤ) :: lk) (zk : zsz (kv : ℤ) ≤ Bb)
    (hm : G rm = (k : ℤ) :: lm) (zm : zsz (k : ℤ) ≤ Bb)
    (hN : G rNB = (nb : ℤ) :: ln) (zn : zsz (nb : ℤ) ≤ Bb) (zn1 : zsz ((nb : ℤ) + 1) ≤ Bb)
    (zd : zsz ((kv : ℤ) - k) ≤ Bb) :
    FSp (brB B) (encK s G) (encK s (Function.update (Function.update (Function.update
      (Function.update (Function.update (Function.update G 0 l)
      sT ((if decide (kv ≠ k) then [] else L.reverse) ++ G sT))
      sKB ((if decide (kv ≠ k) then L.reverse else []) ++ G sKB))
      sKK ((if decide (kv ≠ k) then [(kv : ℤ)] else []) ++ G sKK))
      sFL ((if kv ≠ k then 1 else 0) :: G sFL))
      rNB (((nb + if kv ≠ k then 1 else 0 : ℕ) : ℤ) :: ln))) (2 * cIte Bb + cBr B Bb) := by
  have E1 : ESp e1E (encK s G) Bb ((kv : ℤ) + -(k : ℤ)) :=
    ESp.add (ESp.reg (by decide) hK zk) (ESp.neg (ESp.reg (by decide) hm zm)) (by
      rw [← sub_eq_add_neg]; exact zd)
  have E2 : ESp e2E (encK s G) Bb ((k : ℤ) + -(kv : ℤ)) :=
    ESp.add (ESp.reg (by decide) hm zm) (ESp.neg (ESp.reg (by decide) hK zk)) (by
      rw [← sub_eq_add_neg, ← zsz_neg, neg_sub]; exact zd)
  have hl1 : e1E.Lin := ⟨trivial, trivial⟩
  have hl2 : e2E.Lin := ⟨trivial, trivial⟩
  have sz1 : e1E.size = 4 := rfl
  have sz2 : e2E.size = 4 := rfl
  by_cases hne : kv ≠ k
  · have Hb := badB_fsp hB1 s G L l h0 hL hLb zB hK zk hN zn zn1
    have e : Function.update (Function.update (Function.update (Function.update
        (Function.update G 0 l) sKB (L.reverse ++ G sKB)) sKK ((kv : ℤ) :: G sKK))
        sFL (1 :: G sFL)) rNB (((nb : ℤ) + 1) :: ln) =
      Function.update (Function.update (Function.update (Function.update (Function.update
        (Function.update G 0 l)
        sT ((if decide (kv ≠ k) then [] else L.reverse) ++ G sT))
        sKB ((if decide (kv ≠ k) then L.reverse else []) ++ G sKB))
        sKK ((if decide (kv ≠ k) then [(kv : ℤ)] else []) ++ G sKK))
        sFL ((if kv ≠ k then 1 else 0) :: G sFL))
        rNB (((nb + if kv ≠ k then 1 else 0 : ℕ) : ℤ) :: ln) := by
      have hd : decide (kv ≠ k) = true := by simpa using hne
      simp only [hd, if_true, if_pos hne, List.nil_append, List.singleton_append]
      push_cast
      funext j
      by_cases a1 : j = rNB
      · subst a1; simp +decide
      by_cases a2 : j = sFL
      · subst a2; simp +decide
      by_cases a3 : j = sKK
      · subst a3; simp +decide
      by_cases a4 : j = sKB
      · subst a4; simp +decide
      by_cases a5 : j = sT
      · subst a5; simp +decide
      simp [Function.update_apply, a1, a2, a3, a4, a5]
    rw [e] at Hb
    rcases Nat.lt_or_gt_of_ne hne with hlt | hgt
    · refine (FSp.iteT E1.clean E1.ok hl1 E1.bnd (by rw [E1.ev]; omega) Hb).mono ?_
      rw [sz1]; unfold cIte; omega
    · have H2 := FSp.iteT E2.clean E2.ok hl2 E2.bnd (by rw [E2.ev]; omega) Hb (b := goodB B)
      refine (FSp.iteF E1.clean E1.ok hl1 E1.bnd (by rw [E1.ev]; omega) H2).mono ?_
      rw [sz1, sz2]; unfold cIte; omega
  · push_neg at hne
    have Hg := goodB_fsp hB1 s G L l h0 hL hLb zB
    have e : Function.update (Function.update (Function.update G 0 l) sT (L.reverse ++ G sT))
        sFL (0 :: G sFL) =
      Function.update (Function.update (Function.update (Function.update (Function.update
        (Function.update G 0 l)
        sT ((if decide (kv ≠ k) then [] else L.reverse) ++ G sT))
        sKB ((if decide (kv ≠ k) then L.reverse else []) ++ G sKB))
        sKK ((if decide (kv ≠ k) then [(kv : ℤ)] else []) ++ G sKK))
        sFL ((if kv ≠ k then 1 else 0) :: G sFL))
        rNB (((nb + if kv ≠ k then 1 else 0 : ℕ) : ℤ) :: ln) := by
      subst hne
      simp only [ne_eq, not_true_eq_false, decide_false, if_false, Bool.false_eq_true,
        List.nil_append, add_zero]
      funext j
      by_cases a1 : j = rNB
      · subst a1; simp +decide [hN]
      by_cases a2 : j = sFL
      · subst a2; simp +decide
      by_cases a3 : j = sKK
      · subst a3; simp +decide
      by_cases a4 : j = sKB
      · subst a4; simp +decide
      by_cases a5 : j = sT
      · subst a5; simp +decide
      simp [Function.update_apply, a1, a2, a3, a4, a5]
    rw [e] at Hg
    have H2 := FSp.iteF E2.clean E2.ok hl2 E2.bnd (by rw [E2.ev]; omega) Hg (a := badB B)
    refine (FSp.iteF E1.clean E1.ok hl1 E1.bnd (by rw [E1.ev]; omega) H2).mono ?_
    rw [sz1, sz2]; unfold cIte; omega

end NLogN.KFL

