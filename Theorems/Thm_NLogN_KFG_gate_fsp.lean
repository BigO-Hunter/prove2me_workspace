namespace NLogN.KFG

open IntMul RS AModel KIL KFD KFB Complex

@[simp] theorem toC_one' : NLogN.KFB.toC ((1 : ℤ), (0 : ℤ)) = 1 := by simp [NLogN.KFB.toC]

namespace Atom

variable (a : Atom) (e : ℕ → ℕ)

end Atom

theorem Atom.M_ok (a : Atom) (e : ℕ → ℕ) (hc : Sm a.c) : (a.M e).Ok := by
  unfold Atom.M; split_ifs
  · exact ⟨by simp [SC.Ok, Sm], hc, scZero_ok, scOne_ok⟩
  · exact ⟨scOne_ok, scZero_ok, hc, by simp [SC.Ok, Sm]⟩

theorem Atom.M_sh (a : Atom) (e : ℕ → ℕ) : (a.M e).Sh (a.D e) := by
  unfold Atom.M Atom.D; split_ifs
  · exact ⟨le_max_left _ _, le_max_right _ _, Nat.zero_le _, Nat.zero_le _⟩
  · exact ⟨Nat.zero_le _, Nat.zero_le _, le_max_right _ _, le_max_left _ _⟩

theorem pow_al (a : Atom) (e : ℕ → ℕ) : (2 : ℂ) ^ (a.al e) * 2 ^ (e a.t) = 2 ^ (a.E e) := by
  rw [← pow_add]; congr 1; unfold Atom.al Atom.E; omega

theorem pow_be (a : Atom) (e : ℕ → ℕ) : (2 : ℂ) ^ (a.be e) * 2 ^ (e a.s) = 2 ^ (a.E e) / 2 ^ a.h := by
  rw [eq_div_iff (pow_ne_zero _ two_ne_zero), ← pow_add, ← pow_add]; congr 1; unfold Atom.be Atom.E; omega

/-- **One atom on the encoding.** -/
theorem enc_atom (a : Atom) {W L : ℕ} (ha : a.Ok W) (e : ℕ → ℕ) (zs : List GI)
    (y : ℕ → ℕ → ℂ) (hx : Enc W L e zs y) :
    Enc W L (a.sc e) (if a.t < a.s then pairL (a.M e) L a.t a.s zs else pairL (a.M e) L a.s a.t zs)
      (a.y y) := by
  obtain ⟨ht, hs, hts, hc⟩ := ha
  have kt : ∀ p, 2 ^ (a.sc e a.t) * a.y y a.t p =
      2 ^ (a.al e) * (2 ^ (e a.t) * y a.t p) + NLogN.KFB.toC a.c * 2 ^ (a.be e) * (2 ^ (e a.s) * y a.s p) := by
    intro p
    simp only [Atom.sc, Atom.y, Function.update_self]
    have h1 := pow_al a e; have h2 := pow_be a e
    have h3 : (2 : ℂ) ^ a.h ≠ 0 := pow_ne_zero _ two_ne_zero
    calc (2 : ℂ) ^ (a.E e) * (y a.t p + NLogN.KFB.toC a.c / 2 ^ a.h * y a.s p)
        = (2 ^ (a.al e) * 2 ^ (e a.t)) * y a.t p + NLogN.KFB.toC a.c * (2 ^ (a.E e) / 2 ^ a.h) * y a.s p := by
          rw [h1]; field_simp
      _ = _ := by rw [h2.symm]; ring
  have ks : ∀ p, 2 ^ (a.sc e a.s) * a.y y a.s p = 2 ^ (e a.s) * y a.s p := by
    intro p; simp [Atom.sc, Atom.y, Function.update_of_ne (Ne.symm hts)]
  have ko : ∀ w, w ≠ a.t → ∀ p, 2 ^ (e w) * y w p = 2 ^ (a.sc e w) * a.y y w p := by
    intro w hw p; simp [Atom.sc, Atom.y, Function.update_of_ne hw]
  by_cases hlt : a.t < a.s
  · rw [if_pos hlt]
    refine enc_pairL (a.M e) hlt hs e (a.sc e) zs y (a.y y) hx (fun p _ => ?_) (fun p _ => ?_)
      (fun w _ hw1 _ p _ => ko w hw1 p)
    · rw [kt p]; simp [Atom.M, hlt]
    · rw [ks p]; simp [Atom.M, hlt]
  · rw [if_neg hlt]
    have hlt' : a.s < a.t := by omega
    refine enc_pairL (a.M e) hlt' ht e (a.sc e) zs y (a.y y) hx (fun p _ => ?_) (fun p _ => ?_)
      (fun w _ _ hw2 p _ => ko w hw2 p)
    · rw [ks p]; simp [Atom.M, hlt]
    · rw [kt p]; simp [Atom.M, hlt]; ring

/-- **One atom as a fine run.** -/
theorem atom_fsp (a : Atom) (e : ℕ → ℕ) {W L : ℕ} (ha : a.Ok W) (s : IState HS) (f : Fin HS → List ℤ)
    (zs : List GI) (l : List ℤ) (w : ℕ) (hlen : zs.length = W * L) (h0 : f 0 = gflat zs ++ l)
    (hC : ClP f) (hb : NLogN.KFB.GB w zs) (Z : ℕ) (hZ : zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) :
    FSp (a.P e L) (encK s f) (encK s (Function.update f 0 (gflat (a.L e L zs) ++ l)))
      (cAtom w (a.D e) L W Z) ∧ NLogN.KFB.GB (w + a.D e + 2) (a.L e L zs) := by
  obtain ⟨ht, hs, hts, hc⟩ := ha
  unfold Atom.P Atom.L
  by_cases hlt : a.t < a.s
  · rw [if_pos hlt, if_pos hlt]
    have hl : (a.s + 1) * L ≤ zs.length := by rw [hlen]; exact Nat.mul_le_mul_right _ hs
    exact ⟨(pairW_fsp (a.M e) (a.M_ok e hc) (a.M_sh e) s f zs l w L a.t a.s hlt hl h0 hC hb Z
      (le_trans (zsz_natCast_le (by rw [← hlen]; omega)) hZ)).mono
      (cPairW_le_cAtom hlt hs le_rfl le_rfl),
      GB_pairL (a.M_ok e hc) (a.M_sh e) zs hlt hl hb⟩
  · rw [if_neg hlt, if_neg hlt]
    have hlt' : a.s < a.t := by omega
    have hl : (a.t + 1) * L ≤ zs.length := by rw [hlen]; exact Nat.mul_le_mul_right _ ht
    exact ⟨(pairW_fsp (a.M e) (a.M_ok e hc) (a.M_sh e) s f zs l w L a.s a.t hlt' hl h0 hC hb Z
      (le_trans (zsz_natCast_le (by rw [← hlen]; omega)) hZ)).mono
      (cPairW_le_cAtom hlt' ht le_rfl le_rfl),
      GB_pairL (a.M_ok e hc) (a.M_sh e) zs hlt' hl hb⟩

theorem gateY_cons (a : Atom) (as : List Atom) (y : ℕ → ℕ → ℂ) (h : NoTS (a :: as)) :
    gateY (a :: as) y = gateY as (a.y y) := by
  funext w p
  have hs : ∀ b ∈ as, a.y y b.s = y b.s := fun b hb => by
    simp only [Atom.y]; rw [Function.update_of_ne (Ne.symm (h a List.mem_cons_self b (List.mem_cons_of_mem _ hb)))]
  have hsum : (as.map fun b => if b.t = w then NLogN.KFB.toC b.c / 2 ^ b.h * a.y y b.s p else 0) =
      (as.map fun b => if b.t = w then NLogN.KFB.toC b.c / 2 ^ b.h * y b.s p else 0) :=
    List.map_congr_left fun b hb => by rw [hs b hb]
  simp only [gateY, List.map_cons, List.sum_cons, hsum]
  by_cases hw : a.t = w
  · subst hw; simp only [Atom.y, Function.update_self, if_true]; ring
  · simp only [Atom.y, Function.update_of_ne (Ne.symm hw), if_neg hw]; ring

end NLogN.KFG

end

