open NLogN
open NLogN.KFG
open IntMul RS AModel KIL KFD KFB Complex
theorem gate_fsp_aux {W L : ℕ} (s : NLogN.IState NLogN.HS) (l : List ℤ) (Z : ℕ)
    (hZ : NLogN.zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) :
    ∀ (as : List NLogN.KFG.Atom), (∀ a ∈ as, a.Ok W) → NLogN.KFG.NoTS as →
    ∀ (e : ℕ → ℕ) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (y : ℕ → ℕ → ℂ) (w : ℕ),
      NLogN.KFG.Enc W L e zs y → f 0 = NLogN.KFB.gflat zs ++ l → NLogN.KFG.ClP f → NLogN.KFB.GB w zs →
      NLogN.KFG.Enc W L (NLogN.KFG.gateE as e) (NLogN.KFG.gateL as e L zs) (NLogN.KFG.gateY as y) ∧ NLogN.KFB.GB (NLogN.KFG.gateW as e w) (NLogN.KFG.gateL as e L zs) ∧
      NLogN.KFD.FSp (NLogN.KFG.gateP as e L) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (NLogN.KFG.gateL as e L zs) ++ l)))
        (NLogN.KFG.cGate as e w L W Z) 
  | [], _, _, e, f, zs, y, w, hx, h0, hC, hb => by
    refine ⟨?_, hb, ?_⟩
    · have : NLogN.KFG.gateY [] y = y := by funext w p; simp [NLogN.KFG.gateY]
      simpa [NLogN.KFG.gateE, NLogN.KFG.gateL, this] using hx
    · simp only [NLogN.KFG.gateP, NLogN.KFG.gateL, NLogN.KFG.cGate]
      rw [← h0, Function.update_eq_self]; exact NLogN.KFD.FSp.skip _
  | a :: as, hok, hts, e, f, zs, y, w, hx, h0, hC, hb => by
    have ha := hok a List.mem_cons_self
    obtain ⟨H1, Hb⟩ := NLogN.KFG.atom_fsp a e ha s f zs l w hx.1 h0 hC hb Z hZ
    have hx' := NLogN.KFG.enc_atom a ha e zs y hx
    have hts' : NLogN.KFG.NoTS as := fun b hb c hc => hts b (List.mem_cons_of_mem _ hb) c (List.mem_cons_of_mem _ hc)
    obtain ⟨R1, R2, R3⟩ := gate_fsp_aux s l Z hZ as (fun b hb => hok b (List.mem_cons_of_mem _ hb)) hts'
      (a.sc e) (Function.update f 0 (NLogN.KFB.gflat (a.L e L zs) ++ l)) (a.L e L zs) (a.y y) _ hx'
      (by simp) (hC.upd0 _) Hb
    refine ⟨by rw [NLogN.KFG.gateY_cons a as y hts]; exact R1, R2, ?_⟩
    have := H1.seq R3
    rw [Function.update_idem] at this
    exact this

theorem NLogN.KFG.gate_fsp {W L : ℕ} (s : NLogN.IState NLogN.HS) (l : List ℤ) (Z : ℕ)
    (hZ : NLogN.zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) :
    ∀ (as : List NLogN.KFG.Atom), (∀ a ∈ as, a.Ok W) → NLogN.KFG.NoTS as →
    ∀ (e : ℕ → ℕ) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (y : ℕ → ℕ → ℂ) (w : ℕ),
      NLogN.KFG.Enc W L e zs y → f 0 = NLogN.KFB.gflat zs ++ l → NLogN.KFG.ClP f → NLogN.KFB.GB w zs →
      NLogN.KFG.Enc W L (NLogN.KFG.gateE as e) (NLogN.KFG.gateL as e L zs) (NLogN.KFG.gateY as y) ∧ NLogN.KFB.GB (NLogN.KFG.gateW as e w) (NLogN.KFG.gateL as e L zs) ∧
      NLogN.KFD.FSp (NLogN.KFG.gateP as e L) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (NLogN.KFG.gateL as e L zs) ++ l)))
        (NLogN.KFG.cGate as e w L W Z) := by
  first
  | exact gate_fsp_aux
  | (intros; apply gate_fsp_aux <;> assumption)
end
