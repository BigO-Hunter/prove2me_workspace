namespace NLogN.KFG

open IntMul RS AModel KIL KFD KFB Complex

theorem GB_pairL {M : M2S} (hM : M.Ok) {D : ℕ} (hD : M.Sh D) {w L i j : ℕ} (zs : List GI)
    (hij : i < j) (hlen : (j + 1) * L ≤ zs.length) (hb : NLogN.KFB.GB w zs) :
    NLogN.KFB.GB (w + D + 2) (pairL M L i j zs) := by
  rw [GB_getD] at hb ⊢
  intro p hp
  rw [length_pairL M L i j zs hij hlen] at hp
  have hb' : ∀ q, zsz (zs.getD q 0).1 ≤ w ∧ zsz (zs.getD q 0).2 ≤ w := fun q => by
    by_cases hq : q < zs.length
    · exact hb q hq
    · rw [List.getD_eq_default _ _ (by omega)]; simp [zsz_zero]
  rw [getD_pairL M L i j zs hij hlen]
  split_ifs
  · exact lin2S_bnd hM.1 hM.2.1 hD.1 hD.2.1 (hb' _) (hb' _)
  · exact lin2S_bnd hM.2.2.1 hM.2.2.2 hD.2.2.1 hD.2.2.2 (hb' _) (hb' _)
  · exact ⟨(hb' p).1.trans (by omega), (hb' p).2.trans (by omega)⟩

end NLogN.KFG

end

