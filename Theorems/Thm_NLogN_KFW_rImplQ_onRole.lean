section
-- Source module: Solutions.KFWWrap
/-!
# KFW: a uniform program on one role

`wrapQ W w ρ ρE U`: swap role `w` to the front, run `U` on the first segment, level the other
roles by `2^e` (the shift read from `ρE`), swap back.  The role length is read from `ρ`.

**`rImplQ_onRole`**: the uniform analogue of `KFN.rImplI_onRole`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
variable {Q : IState HS → Prop} {lo hi : ℕ}

/-- **A uniform stream program on one role.** -/
theorem rImplQ_onRole_sol_aux (hW : 0 < W) (w : Fin W) {ι : Type*} [Fintype ι] [DecidableEq ι]
    {r n : ℕ} (hr : 0 < r) (hn : 0 < n) (st' : ι → ℕ) (Tw : Matrix (ι → Fin 2) (ι → Fin 2) ℂ)
    {U : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (h : SImplQ I iprog Q lo hi r st' n Tw U e dw cost) (st : Fin m × κ → ℕ)
    (A : ROp (Fin W) m κ)
    (hA : ∀ X : Fin W → List (Fin r → ℂ), (∀ v, (X v).length = n) →
      roleOpF st n A X = Function.update X w (selOpF st' n Tw (X w)))
    (Z : ℕ) (hZ : zsz ((2 * (W * (n * r)) : ℕ) : ℤ) ≤ Z)
    {σ : Fin HS → Option ℤ} {ρ ρE : Fin HS} (hR : WReg σ ρ ρE (n * r) e)
    (hQ : ∀ s, Q s → Agree σ s) :
    RImplQ I iprog Q lo hi r n st A (wrapQ W w.val ρ ρE U) e (dw + (e + 2) * W)
      (cWrapQ W (n * r) Z e dw cost) := by
  intro s f zs l X F x hq hC h0 hx hX hb hlo hhi
  set L := n * r with hL
  have hL1 : 1 ≤ L := Nat.mul_pos hn hr
  set o : Fin W := ⟨0, hW⟩
  set τ := Equiv.swap o w with hτ
  have hsw : ∀ v : Fin W, swapsF (swL w.val) v.val = (τ v).val := by
    intro v
    rw [swapsF_swL, hτ, show (0 : ℕ) = o.val from rfl, ← pf_swap]
    simp [pf]
  have hsl : ∀ p ∈ swL w.val, p.1 < p.2 ∧ p.2 < W := by
    intro p hp; unfold swL at hp
    split_ifs at hp with h0
    · simp at hp
    · simp at hp; subst hp; exact ⟨by omega, w.isLt⟩
  have hsl1 : (swL w.val).length ≤ 1 := by unfold swL; split_ifs <;> simp
  have hag : ∀ g : Fin HS → List ℤ, Clean0 g → Agree σ (encK s g) :=
    fun g hg => agree_clean0 hR.zero (hQ s hq) hg
  have HS := swapsG_href hR.off hR.l hL1 hZ (swL w.val) hsl
  have NS : NoW σ (swapsG ρ (swL w.val)) := NoW.of_gT hR.off (swapsG_gT ρ _)
  have fS : fok (KFG.swapsP L (swL w.val)) = true := fok_swapsP _ _
  -- 1. swap role `w` to the front
  have E0 := enc_of_rec hr hX hx
  obtain ⟨E1, B1, H1⟩ := swaps_fsp s l x Z hZ (swL w.val) hsl (fun _ => F) f zs (yR r X) E0 h0
    hC.clN.p hb
  set zs1 := swapsL L (swL w.val) zs
  set X1 : Fin W → List (Fin r → ℂ) := fun v => X (τ v)
  have hX1 : ∀ v, (X1 v).length = n := fun v => hX _
  have R1 : RecRep r F zs1 (flatR X1) := by
    refine rec_of_enc hr hX1 E1 (fun v j hj c => ?_)
    beta_reduce
    rw [hsw v, yR_val hr X (τ v) j c]
  have hz1 : zs1.length = W * L := E1.1
  -- 2. the program on the first segment
  set seg := zs1.take L
  set rest := zs1.drop L
  have hsplit : zs1 = seg ++ rest := (List.take_append_drop _ _).symm
  have Rs : RecRep r F seg (X1 o) := recRep_take hW hX1 R1
  have hbs : GB x seg := B1.sub fun z hz => List.mem_of_mem_take hz
  have hbr : GB x rest := B1.sub fun z hz => List.mem_of_mem_drop hz
  obtain ⟨seg', r2, b2, f2⟩ := h s (Function.update f 0 (gflat zs1 ++ l)) seg (gflat rest ++ l)
    (X1 o) F x hq (hC.upd0 _) (by rw [Function.update_self, hsplit, gflat_append, List.append_assoc])
    Rs (hX1 o) hbs hlo (by omega)
  set Y2 : Fin W → List (Fin r → ℂ) := Function.update X1 o (selOpF st' n Tw (X1 o))
  have hY2 : ∀ v, (Y2 v).length = n := by
    intro v; simp only [Y2, Function.update_apply]; split_ifs
    · exact length_selOpF _ _ _ _
    · exact hX1 v
  have hsl' : seg'.length = L := by rw [r2.1, length_selOpF]
  set zs2 := seg' ++ rest
  have E2 : Enc W L (Function.update (fun _ => F) 0 (F + e)) zs2 (yR r Y2) := by
    have := enc_set0 hW (enc_of_rec hr hX1 R1) hsl' (F' := F + e) (y0 := yR r Y2 0)
      (fun p hp => by
        have hpr : p / r < n := by rw [Nat.div_lt_iff_lt_mul hr]; exact hp
        have e1 : p = p / r * r + (⟨p % r, Nat.mod_lt _ hr⟩ : Fin r) := by
          simp only; rw [Nat.div_add_mod']
        conv_lhs => rw [e1]
        rw [r2.2 _ _ (by rw [length_selOpF]; exact hpr)]
        rw [show yR r Y2 0 p = (Y2 o).getD (p / r) 0 ⟨p % r, Nat.mod_lt _ hr⟩ from by
          simp only [KFN.yR, dif_pos (And.intro hW hr)]; rfl]
        simp [Y2])
    have hy : Function.update (yR r X1) 0 (yR r Y2 0) = yR r Y2 := by
      funext v p
      by_cases hv : v = 0
      · subst hv; simp
      · rw [Function.update_of_ne hv]
        simp only [KFN.yR]
        split_ifs with hh
        · congr 2
          simp only [Y2]
          rw [Function.update_of_ne (fun e => hv (by simpa [o] using congrArg Fin.val e))]
        · rfl
    rw [hy] at this; exact this
  have bz2 : GB (x + dw) zs2 := GB_append.2 ⟨b2, hbr.mono (by omega)⟩
  -- 3. leveling
  set e2 := Function.update (fun _ : ℕ => F) 0 (F + e)
  have e2eq : e2 = shE F (Function.update (fun _ => 0) 0 e) := by
    funext t; by_cases ht : t = 0 <;> simp [e2, shE, ht, Nat.add_comm]
  have he2 : ∀ t, F ≤ e2 t ∧ e2 t ≤ F + e := fun t => by
    simp only [e2, Function.update_apply]; split_ifs <;> omega
  have hs2 : ∀ a ∈ levA W 0, e2 a.s + a.h ≤ F + e := fun a ha => by
    rw [(levA_src a ha).1, (levA_src a ha).2.1]; simp [e2]
  obtain ⟨E3, B3, H3⟩ := gate_fsp s l Z hZ (levA W 0)
    (fun a ha => (levA_ok hW a ha).1) (levA_nots W 0) e2
    (Function.update f 0 (gflat zs2 ++ l)) zs2 (yR r Y2) (x + dw) E2 (by simp) (hC.upd0 _).clN.p bz2
  rw [gateY_zero (fun a ha => (levA_src a ha).2.2)] at E3
  have E3' := enc_congr_e E3 (gateE_levA hW e2 (by simp [e2]) (fun t => (he2 t).2))
  set zs3 := gateL (levA W 0) e2 L zs2
  have w3 := gateW_le2 F (F + e) (levA W 0) e2 (x + dw) (levA_nots W 0) hs2 he2
  have hlev := levA_len W 0
  -- 4. swap back
  obtain ⟨E4, B4, H4⟩ := swaps_fsp s l (gateW (levA W 0) e2 (x + dw)) Z hZ (swL w.val) hsl
    (fun _ => F + e) (Function.update f 0 (gflat zs3 ++ l)) zs3 (yR r Y2) E3' (by simp)
    (hC.upd0 _).clN.p B3
  refine ⟨swapsL L (swL w.val) zs3, ?_, ?_, ?_⟩
  · have R4 := rec_of_enc hr (Y := fun v => Y2 (τ v)) (fun v => hY2 _) E4 (fun v j hj c => by
      beta_reduce; rw [hsw v, yR_val hr Y2 (τ v) j c])
    have hfam : (fun v => Y2 (τ v)) = Function.update X w (selOpF st' n Tw (X w)) := by
      funext v
      simp only [Y2, X1, Function.update_apply]
      by_cases hv : v = w
      · subst hv
        have : τ v = o := by rw [hτ, Equiv.swap_apply_right]
        rw [if_pos rfl, if_pos this, hτ, Equiv.swap_apply_left]
      · rw [if_neg hv]
        have : τ v ≠ o := by
          intro h'; apply hv
          have := congrArg τ h'
          rwa [hτ, Equiv.swap_apply_self, Equiv.swap_apply_left] at this
        rw [if_neg this, hτ, Equiv.swap_apply_self]
    rw [hA X hX, ← hfam]
    exact R4
  · have : (F + e - F + 2) * (levA W 0).length ≤ (e + 2) * W := Nat.mul_le_mul (by omega) hlev
    exact B4.mono (by omega)
  · have F2 : IRuns I iprog U (encK s (Function.update f 0 (gflat zs1 ++ l)))
        (encK s (Function.update f 0 (gflat zs2 ++ l))) (cost x) := by
      have := f2; rw [Function.update_idem] at this
      have e : gflat zs2 ++ l = gflat seg' ++ (gflat rest ++ l) := by simp [zs2, gflat_append]
      rw [e]; exact this
    rw [Function.update_idem] at H3 H4
    have HG : HRef (gateP (levA W 0) e2 L) (RS.sub σ (levG W ρ ρE)) (W * Xp Z) := by
      rw [e2eq, gateP_shE]; exact levG_href hR.off hR.l hR.e hL1 hZ
    have NG : NoW σ (levG W ρ ρE) := NoW.of_gT hR.off (levG_gT W ρ ρE)
    have U1 := (FSp.uni hR.cl NS HS (hag f hC) H1).irun (I := I) (iprog := iprog) (fok_uni NS HS fS)
    have U3 := (FSp.uni hR.cl NG HG (hag _ (hC.upd0 _)) H3).irun (I := I) (iprog := iprog)
      (fok_uni NG HG (fok_gateP _ _ _))
    have U4 := (FSp.uni hR.cl NS HS (hag _ (hC.upd0 _)) H4).irun (I := I) (iprog := iprog)
      (fok_uni NS HS fS)
    have := U1.seq (F2.seq (U3.seq U4))
    refine this.mono ?_
    have c3 := cGate_le2 F (F + e) L W Z (levA W 0) e2 (x + dw) (levA_nots W 0) hs2 he2
    have m1 : cAtom x 0 L W Z ≤ cAtom (x + dw + (e + 2) * W) e L W Z :=
      cAtom_mono (by omega) (by omega)
    have m3 : (levA W 0).length * cAtom (x + dw + (F + e - F + 2) * (levA W 0).length)
        (F + e - F) L W Z ≤ W * cAtom (x + dw + (e + 2) * W) e L W Z :=
      Nat.mul_le_mul hlev (cAtom_mono (by
        have : (F + e - F + 2) * (levA W 0).length ≤ (e + 2) * W :=
          Nat.mul_le_mul (by omega) hlev
        omega) (by omega))
    have m4 : cAtom (gateW (levA W 0) e2 (x + dw)) 0 L W Z ≤
        cAtom (x + dw + (e + 2) * W) e L W Z := cAtom_mono (by
          have : (F + e - F + 2) * (levA W 0).length ≤ (e + 2) * W :=
            Nat.mul_le_mul (by omega) hlev
          omega) (by omega)
    have m5 := Nat.mul_le_mul_right (cAtom x 0 L W Z) hsl1
    have m6 := Nat.mul_le_mul_right (cAtom (gateW (levA W 0) e2 (x + dw)) 0 L W Z) hsl1
    have m7 := Nat.mul_le_mul_right (Xp Z) hsl1
    have m8 : Xp Z ≤ W * Xp Z := Nat.le_mul_of_pos_left _ hW
    unfold cWrapQ
    nlinarith

end NLogN.KFW

end

theorem NLogN.KFW.rImplQ_onRole.{u_1} : type_of% @NLogN.KFW.rImplQ_onRole_sol_aux.{u_1} := @NLogN.KFW.rImplQ_onRole_sol_aux.{u_1}
