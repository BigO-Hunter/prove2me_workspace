variable {m W : ℕ} [NeZero W]
theorem NLogN.KFE.l12F_uniform_rat (Qc : AModelRat.QCircuit (ZMod 2) m W) (hm : 2 ≤ m) :
      ∀ (q : ℕ), q.Prime → ∀ (Bb u : ℕ) (Pre G Suf : AModel.Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ e Kp : ℕ, e = Nat.clog q (2 ^ u) → Kp = Nat.clog m e →
      (∀ j < Kp, AModel.FramesOK (fun X => AModelRat.GoodAtQ q ((Qc.den : ℚ)⁻¹ • AModelFac.ratM X) ∧
        ∀ T, NLogN.KIL.TStep.sh T ∈ NLogN.KIL.edgeTplQ Qc X → NLogN.KIL.TOK T (q ^ m ^ j) Bb)
        (Qc.toCircuit (q ^ m ^ Kp)).gates (Qc.toCircuit (q ^ m ^ Kp)).Min
        (Qc.toCircuit (q ^ m ^ Kp)).Mout) →
      (∀ j < Kp, NLogN.KIL.SubBnd (q ^ m ^ j) Bb) →
      NLogN.zsz (((2 * AModel.vol (AModelL12.qShape Pre G Suf q e) + m + W * e : ℕ)) : ℤ) ≤ Bb → 1 ≤ Bb →
      ∀ (I : List NLogN.Sym) (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) (xs : List (ZMod 2))
        (LP LG LS LU : List ℤ),
      F NLogN.KIL.kP = (AModel.vol Pre : ℤ) :: LP → F NLogN.KIL.kG = (AModel.vol G : ℤ) :: LG → F NLogN.KIL.kS = (AModel.vol Suf : ℤ) :: LS →
      F NLogN.KIL.aU = (u : ℤ) :: LU → F 0 = NLogN.KIL.enc2 xs →
      F 8 = [] → F 9 = [] → F 10 = [] → F 11 = [] → F 15 = [] → F 20 = [] → F 21 = [] →
      F 23 = [] → F 24 = [] →
      xs.length = AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) →
      NLogN.IRuns I (NLogN.KFD.progF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc)) (NLogN.KFE.l12F q m W) (NLogN.KIL.encK s F)
        (NLogN.KIL.encK s (Function.update F 0 (NLogN.KIL.enc2 (NLogN.KIL.l12v (NLogN.KIL.normO (AModel.prog (Qc.toCircuit (q ^ m ^ Kp)) q))
          W m q Kp (W * Kp) e u Pre G Suf 0 xs))))
        (NLogN.KFE.cL12F u e (min (W * Kp) e) Kp (e - min (W * Kp) e) (AModel.vol (AModelL12.qShape Pre G Suf q e))
          (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W Kp (q ^ min (W * Kp) e))
            (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e))) m q
          (fun j => NLogN.KFD.ilCostF W (NLogN.KFD.KlevF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) + 10 ^ 5) (NLogN.KFD.KbF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) + 10 ^ 9 + 100) (NLogN.KIL.Kd m)
            (NLogN.KIL.SWn (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc)) q Bb j
            (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W Kp (q ^ min (W * Kp) e))
              (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e)))) Bb) := by
  have huni := NLogN.KFE.progF_rat_explicit Qc (by omega : 1 ≤ m)
  intro q hq Bb u Pre G Suf hu hPre hG hS e Kp he hKp hfr hsb hBb hB1 I s F xs LP LG LS LU
    FP FG FS FU F0 F8 F9 F10 F11 F15 F20 F21 F23 F24 hxs
  have hW : 1 ≤ W := NeZero.one_le
  set M := 2 * AModel.vol (AModelL12.qShape Pre G Suf q e) + m + W * e with hMdef
  set r := min (W * Kp) e with hr
  set n := e - r with hn
  set R' := AModelL12.padRows W Kp (q ^ r) with hR'
  set V' := AModel.vol (AModelL12.rowShape (AModel.vol Pre) R' (G ++ List.replicate r q) Suf q n) with hV'
  set child := NLogN.KIL.normO (AModel.prog (Qc.toCircuit (q ^ m ^ Kp)) q) with hchild
  have hKe : e ≤ m ^ Kp := by rw [hKp]; exact Nat.le_pow_clog (by omega) e
  have hjK : ∀ j, m ^ j ≤ n → j ≤ Kp := fun j hj =>
    NLogN.KIL.le_of_pow_le_pow' hm (le_trans hj (le_trans (Nat.sub_le _ _) hKe))
  have hR'1 : 1 ≤ R' := le_trans (Nat.one_le_pow _ _ (by have := hq.two_le; omega))
    (NLogN.KIL.le_padRows W Kp (q ^ r) hW)
  have hdvd : ∀ j ≤ Kp, W ^ j ∣ R' := fun j hj =>
    (pow_dvd_pow W hj).trans (Dvd.intro _ rfl)
  have hP1 : 1 ≤ AModel.vol Pre := NLogN.KIL.one_le_vol hPre
  -- the oracle calls
  have hO : 1 ≤ n → ∀ j, m ^ j ≤ n → NLogN.KIL.CallSpec I (NLogN.KFD.progF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc)) child q m
      j (AModel.vol Pre) R' V' (NLogN.KFD.ilCostF W (NLogN.KFD.KlevF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) + 10 ^ 5) (NLogN.KFD.KbF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) + 10 ^ 9 + 100) (NLogN.KIL.Kd m)
        (NLogN.KIL.SWn (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc)) q Bb j V') := by
    intro hn1 j hj A B Cs t R ys hD hA hB hC hys hvol
    have hjK' := hjK j hj
    have hrW : r = W * Kp := by rw [hr]; apply min_eq_left; omega
    have hVM : V' ≤ M := by
      have h := NLogN.KIL.rowVol_le (n := n) hq.two_le hW Pre G Suf (show W ^ Kp ≤ q ^ r by
        rw [hrW]; exact NLogN.KIL.pow_le_q_pow hq.two_le)
      rw [show r + n = e by omega, ← hR', ← hV'] at h
      omega
    have hKpM : Kp ≤ M := by
      have : Kp ≤ e := NLogN.KIL.clog_le_self hm e |>.trans' (by rw [hKp])
      have : e < q ^ e := Nat.lt_pow_self (by have := hq.two_le; omega)
      have : q ^ e ≤ AModel.vol (AModelL12.qShape Pre G Suf q e) := by
        have hh := NLogN.KIL.vol_qShape_row Pre G Suf q 0 e
        rw [zero_add] at hh
        rw [hh, NLogN.KIL.vol_restShape']
        simp only [pow_zero, List.replicate_zero, List.append_nil]
        have h1 := NLogN.KIL.one_le_vol hG; have h2 := NLogN.KIL.one_le_vol hS; have h3 := NLogN.KIL.one_le_vol hPre
        have h4 : 1 ≤ q ^ e := Nat.one_le_pow _ _ (by have := hq.two_le; omega)
        calc q ^ e = 1 * (1 * (q ^ e * 1)) := by ring
          _ ≤ AModel.vol Pre * (1 * (q ^ e * (AModel.vol G * (q ^ e * AModel.vol Suf)))) := by
            gcongr
            · exact Nat.mul_pos h1 (Nat.mul_pos h4 h2)
      omega
    have H := huni q hq (m ^ Kp) Bb j (fun j' hj' => Nat.pow_le_pow_right (by omega) (by omega))
      (fun j' hj' => hfr j' (by omega)) (fun j' hj' => hsb j' (by omega))
      (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hBb) (AModel.vol Pre) R' A B Cs hP1 (hdvd j hjK') hR'1 hA hB hC
      (by rw [hvol]; exact le_trans (NLogN.KIL.zsz_nat_le hVM) hBb) I t R ys hD hys
    rw [hvol] at H
    have hl := NLogN.KIL.length_prog (Qc.toCircuit (q ^ m ^ Kp)) q (AModel.vol Pre) A B Cs ys j R' (hdvd j hjK')
    rw [hchild, NLogN.KIL.normO_eq (by rw [hl, hys])]
    exact H
  have hlenP : 1 ≤ n → ∀ o j' zs, zs.length = V' →
      (AModelL12.pieceStep child (AModel.vol Pre) R' (G ++ List.replicate r q) Suf q m n o j' zs).length = V' :=
    fun _ o j' zs hz => by rw [AModelL12.pieceStep, NLogN.KIL.length_normO, hz]
  exact NLogN.KFE.l12F_run s F hBb hB1 Pre G Suf child _ xs hq.two_le hm
    hW hu hPre hG hS FP FG FS FU F0 F8 F9 F10 F11 F15 F20 F21 F23 F24 hxs he hKp le_rfl hO hlenP
end
