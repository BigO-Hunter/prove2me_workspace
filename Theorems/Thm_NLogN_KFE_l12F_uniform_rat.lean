variable {m W : ℕ} [NeZero W]

/-- The fine uniform Prop. 11 code of a rational circuit, with its explicit constants. -/
theorem progF_rat_explicit (Qc : QCircuit (ZMod 2) m W) (hm : 1 ≤ m) :
      ∀ (q : ℕ), q.Prime → ∀ (b Bb k : ℕ), (∀ j < k, m ^ j ≤ b) →
      (∀ j < k, FramesOK (fun X => GoodAtQ q ((Qc.den : ℚ)⁻¹ • ratM X) ∧
        ∀ T, TStep.sh T ∈ edgeTplQ Qc X → TOK T (q ^ m ^ j) Bb)
        (Qc.toCircuit (q ^ b)).gates (Qc.toCircuit (q ^ b)).Min (Qc.toCircuit (q ^ b)).Mout) →
      (∀ j < k, SubBnd (q ^ m ^ j) Bb) → zsz (k : ℤ) ≤ Bb →
      ∀ (P L : ℕ) (A B Cs : Shape), 1 ≤ P → W ^ k ∣ L → 1 ≤ L →
      (∀ a ∈ A, 1 ≤ a) → (∀ a ∈ B, 1 ≤ a) → (∀ a ∈ Cs, 1 ≤ a) →
      zsz ((vol (P :: L :: swShape A B Cs (q ^ m ^ k)) : ℕ) : ℤ) ≤ Bb →
      ∀ (I : List Sym) (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
        DescIn t q m k P L A B Cs →
        xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k)) →
        IRuns I (progF (Qc.toCircuit 1) (edgeTplQ Qc)) (progF (Qc.toCircuit 1) (edgeTplQ Qc) 0)
          (t.upd 0 (ints (enc2 xs) ++ R))
          (t.upd 0 (ints (enc2 (AModel.prog (Qc.toCircuit (q ^ b)) q k P L A B Cs xs)) ++ R))
          (ilCostF W (KlevF (Qc.toCircuit 1) (edgeTplQ Qc) + 10 ^ 5) (KbF (Qc.toCircuit 1) (edgeTplQ Qc) + 10 ^ 9 + 100) (Kd m)
            (SWn (Qc.toCircuit 1) (edgeTplQ Qc)) q Bb k
            (vol (P :: L :: swShape A B Cs (q ^ m ^ k)))) := by
  intro q hq b Bb k hb hfr hsb hk P L A B Cs hP hL hL1 hA hB hC hV I t R xs hD hxs
  have hLv : ∀ j < k, LvOK (Qc.toCircuit (q ^ b)) (edgeTplQ Qc) (q ^ m ^ j) Bb := by
    intro j hj
    refine ⟨KIL.framesOK_mono (fun X hX => ⟨?_, hX.2⟩) _ _ _ (hfr j hj), hsb j hj⟩
    exact edgeSteps_toCircuit Qc hq (pow_dvd_pow q (hb j hj))
      (Nat.one_lt_pow (pow_ne_zero _ (by omega)) hq.one_lt) X hX.1
  exact progF_run (Qc.toCircuit (q ^ b)) (edgeTplQ Qc) hm q hq.two_le Bb I k hLv hk P L A B Cs
    hP hL hL1 hA hB hC hV t R xs hD hxs

end Rat

end NLogN.KFE

