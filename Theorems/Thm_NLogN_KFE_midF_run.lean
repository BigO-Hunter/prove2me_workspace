  simp only [padAsg, evalA]
  rw [NE.val_upd _ b hb.2.2.1, NE.val_upd _ z hz.2.2.2.1, NE.val_upd _ z hz.2.2.1,
    NE.val_upd _ t ht.2.2.2.2.1, NE.val_upd _ t ht.2.2.2.1, NE.val_upd _ t ht.2.2.1]

