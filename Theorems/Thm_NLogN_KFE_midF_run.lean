-- Source module: Solutions.KIL6Mid
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem le_padRows (W K R : ℕ) (hW : 1 ≤ W) : R ≤ padRows W K R := by
  unfold padRows
  have h : 0 < W ^ K := Nat.pos_of_ne_zero (pow_ne_zero _ (by omega))
  have := Nat.div_add_mod (R + W ^ K - 1) (W ^ K)
  have := Nat.mod_lt (R + W ^ K - 1) h
  omega

theorem vol_restShape' (G Suf : Shape) (q n : ℕ) :
    vol (restShape G Suf q n) = q ^ n * (vol G * (q ^ n * vol Suf)) := by
  simp [restShape, vol_append, vol_replicate]

theorem vol_qShape_row (Pre G Suf : Shape) (q r n : ℕ) :
    vol (qShape Pre G Suf q (r + n)) =
      vol Pre * (q ^ r * vol (restShape (G ++ List.replicate r q) Suf q n)) := by
  simp only [qShape, restShape, vol_append, vol_replicate, pow_add]; ring

theorem rowBounds {P Qr R' Qn g S : ℕ} (hP : 1 ≤ P) (hQr : 1 ≤ Qr) (hR : Qr ≤ R') (hQn : 1 ≤ Qn)
    (hg : 1 ≤ g) (hS : 1 ≤ S) :
    let Y := Qn * (g * (Qn * S))
    let V := P * (R' * Y)
    P ≤ V ∧ Qn ≤ V ∧ g ≤ V ∧ S ≤ V ∧ Qn * S ≤ V ∧ g * (Qn * S) ≤ V ∧ Y ≤ V ∧ Qr ≤ V ∧
      R' ≤ V ∧ Qr * Y ≤ V ∧ (R' - Qr) * Y ≤ V ∧ R' * Y ≤ V ∧ P * (Qr * Y) ≤ V := by
  intro Y V
  have a1 : 1 ≤ Qn * S := Nat.mul_pos hQn hS
  have a2 : 1 ≤ g * (Qn * S) := Nat.mul_pos hg a1
  have a3 : 1 ≤ Y := Nat.mul_pos hQn a2
  have hR1 : 1 ≤ R' := le_trans hQr hR
  have hRY : R' * Y ≤ V := Nat.le_mul_of_pos_left _ hP
  have hY : Y ≤ R' * Y := Nat.le_mul_of_pos_left _ hR1
  have hR' : R' ≤ R' * Y := Nat.le_mul_of_pos_right _ a3
  have hQrY : Qr * Y ≤ R' * Y := Nat.mul_le_mul_right _ hR
  have h2 : g * (Qn * S) ≤ Y := Nat.le_mul_of_pos_left _ hQn
  have h3 : Qn * S ≤ g * (Qn * S) := Nat.le_mul_of_pos_left _ hg
  have h4 : S ≤ Qn * S := Nat.le_mul_of_pos_left _ hQn
  have h5 : Qn ≤ Qn * S := Nat.le_mul_of_pos_right _ hS
  have h6 : g ≤ g * (Qn * S) := Nat.le_mul_of_pos_right _ a1
  have h7 : (R' - Qr) * Y ≤ R' * Y := Nat.mul_le_mul_right _ (Nat.sub_le _ _)
  have h8 : P ≤ V := Nat.le_mul_of_pos_right _ (Nat.mul_pos hR1 a3)
  have h9 : P * (Qr * Y) ≤ V := Nat.mul_le_mul_left _ hQrY
  refine ⟨h8, by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega,
    by omega, by omega, hRY, h9⟩

theorem padE_row {F : Fin HS → List ℤ} {v : Fin HS → ℕ} {M P Qr R' Qn g S : ℕ}
    {LP LS : List ℤ} (FP : F kP = (P : ℤ) :: LP) (FS : F NLogN.KIL.kS = (S : ℤ) :: LS)
    (vP : v kP = P) (vS : v NLogN.KIL.kS = S) (vQr : v aQR = Qr) (vR : v aRp = R') (vQn : v aQN = Qn)
    (vG : v aGR = g) (hP : 1 ≤ P) (hQr : 1 ≤ Qr) (hR : Qr ≤ R') (hQn : 1 ≤ Qn)
    (hg : 1 ≤ g) (hS : 1 ≤ S) (hVM : P * (R' * (Qn * (g * (Qn * S)))) ≤ M) :
    PadE F v M (.reg kP) ∧ PadE F v M NLogN.KIL.bR ∧ PadE F v M zR ∧ PadE F v M NLogN.KIL.tR ∧ PadE F v M tUR := by
  obtain ⟨b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13⟩ :=
    rowBounds hP hQr hR hQn hg hS
  simp +decide only [PadE, RegsIn, NE.regs, NE.OK, NE.val, yR, NLogN.KIL.bR, zR, NLogN.KIL.tR, tUR,
    vP, vS, vQr, vR, vQn, vG, FP, FS, List.mem_cons, List.mem_append, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, List.cons.injEq, true_and, exists_eq', and_true, or_true,
    not_false_eq_true]
  simp +decide only [or_assoc, forall_eq_or_imp, forall_eq, true_or, true_and, vP, vS, vQr, vR,
    vQn, vG, FP, FS, List.cons.injEq, exists_eq', and_true, or_true]
  and_intros <;> omega

end NLogN.KIL

