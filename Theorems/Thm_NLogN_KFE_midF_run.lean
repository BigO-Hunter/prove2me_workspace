theorem extract_rowShape (P : ℕ) {R R' : ℕ} (G Suf : Shape) (q n : ℕ) (hR : R ≤ R') (d : α)
    {ys : List α} (hys : ys.length = AModel.vol (rowShape P R' G Suf q n)) :
    extract (rowShape P R G Suf q n) (rowShape P R' G Suf q n) d ys =
      unpadL P R R' (AModel.vol (restShape G Suf q n)) ys := by
  have := extract_eq_unpadL [P] (restShape G Suf q n) hR d (ys := ys) hys
  rw [show AModel.vol [P] = P by simp] at this
  exact this

