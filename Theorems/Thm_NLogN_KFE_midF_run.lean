theorem embed_rowShape (P : ℕ) {R R' : ℕ} (G Suf : Shape) (q n : ℕ) (hR : R ≤ R') (d : α)
    {xs : List α} (hxs : xs.length = AModel.vol (rowShape P R G Suf q n)) :
    AModelL12.embed (rowShape P R G Suf q n) (rowShape P R' G Suf q n) d xs =
      NLogN.KIL.padL P R R' (AModel.vol (restShape G Suf q n)) d xs := by
  have := embed_eq_padL [P] (restShape G Suf q n) hR d (xs := xs) hxs
  rw [show AModel.vol [P] = P by simp] at this
