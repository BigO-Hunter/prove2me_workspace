theorem norep_asgL : ∀ l : List (Fin HS × NE), norep (asgL l) = true
  | [] => rfl
  | (i, e) :: l => by simp [asgL, norep, norep_asgL l]

theorem padS_fsp (s : IState HS) (F : Fin HS → List ℤ) (v : Fin HS → ℕ) {M B : ℕ}
    (hM : zsz (M : ℤ) ≤ B) (hv : ∀ i ∈ regD, v i ≤ M) (x b z t : NE)
    (hx : PadE F v M x) (hb : PadE F v M b) (hz : PadE F v M z) (ht : PadE F v M t)
    {X Fa Fb Y : ℕ} (vx : x.val v = X) (vb : b.val v = Fa * Y) (vz : z.val v = (Fb - Fa) * Y)
    (vt : t.val v = X * (Fb * Y)) (hF : Fa ≤ Fb) (hF1 : 1 ≤ Fb) (hY : 1 ≤ Y)
    (xs : List ℤ) (h0 : F 0 = xs) (h15 : F 15 = []) (h20 : F 20 = []) (h21 : F 21 = [])
    (hxs : xs.length = X * (Fa * Y)) (hbd : Bnd 1 xs) :
    FSp (padS x b z t) (encK s (regState F v regD))
      (encK s (regState (Function.update F 0 (KIL.padL X Fa Fb Y 0 xs)) (padV v X (Fa * Y)
        ((Fb - Fa) * Y) (X * (Fb * Y))) regD))
      ((x.size + b.size + z.size + t.size + 5) * 10 ^ 7 * (B + 2) ^ 2 + cPadF (X * (Fb * Y)) B) := by
  have S1 := Sp.asgs s F regD hM (padAsg x b z t) v (okA_padAsg x b z t v hv hx hb hz ht)
  rw [evalA_padAsg x b z t v hx hb hz ht, vx, vb, vz, vt, szA_padAsg] at S1
  set v' := padV v X (Fa * Y) ((Fb - Fa) * Y) (X * (Fb * Y)) with hv'
  have hVM : X * (Fb * Y) ≤ M := by rw [← vt]; exact NE.le_of_OK t ht.2.1
  have S2 := padP_fsp s (regState F v' regD) (X := X) (F := Fa) (F' := Fb) (Y := Y) xs [] hF hF1 hY
    hxs B hbd (le_trans (zsz_nat_le hVM) hM)
    (by rw [regState_nmem (by decide), h0, List.append_nil])
    (by rw [regState_nmem (by decide), h15]) (by rw [regState_nmem (by decide), h20])
    (by rw [regState_nmem (by decide), h21])
    (L1 := ints (F pX) ++ s.G pX) (L2 := ints (F pB) ++ s.G pB) (L3 := ints (F pZ) ++ s.G pZ)
    (L4 := ints (F pT) ++ s.G pT)
    (encK_G_cons s (regState_mem (by decide)))
    (encK_G_cons s (regState_mem (by decide)))
    (encK_G_cons s (regState_mem (by decide)))
    (encK_G_cons s (regState_mem (by decide)))
  rw [List.append_nil, regState_upd_nmem _ _ (by decide)] at S2
  exact (FSp.of_norep (norep_asgL _) S1).seq S2

theorem unpadS_fsp (s : IState HS) (F : Fin HS → List ℤ) (v : Fin HS → ℕ) {M B : ℕ}
    (hM : zsz (M : ℤ) ≤ B) (hv : ∀ i ∈ regD, v i ≤ M) (x b z t : NE)
    (hx : PadE F v M x) (hb : PadE F v M b) (hz : PadE F v M z) (ht : PadE F v M t)
    {X Fa Fb Y : ℕ} (vx : x.val v = X) (vb : b.val v = Fa * Y) (vz : z.val v = (Fb - Fa) * Y)
    (vt : t.val v = X * (Fa * Y)) (hF : Fa ≤ Fb) (hF1 : 1 ≤ Fb) (hY : 1 ≤ Y)
    (hVM : X * (Fb * Y) ≤ M)
    (ys : List ℤ) (h0 : F 0 = ys) (h15 : F 15 = []) (h20 : F 20 = []) (h21 : F 21 = [])
    (hys : ys.length = X * (Fb * Y)) (hbd : Bnd 1 ys) :
    FSp (unpadS x b z t) (encK s (regState F v regD))
      (encK s (regState (Function.update F 0 (unpadL X Fa Fb Y ys)) (padV v X (Fa * Y)
        ((Fb - Fa) * Y) (X * (Fa * Y))) regD))
      ((x.size + b.size + z.size + t.size + 5) * 10 ^ 7 * (B + 2) ^ 2 + cPadF (X * (Fb * Y)) B) := by
  have S1 := Sp.asgs s F regD hM (padAsg x b z t) v (okA_padAsg x b z t v hv hx hb hz ht)
  rw [evalA_padAsg x b z t v hx hb hz ht, vx, vb, vz, vt, szA_padAsg] at S1
  set v' := padV v X (Fa * Y) ((Fb - Fa) * Y) (X * (Fa * Y)) with hv'
  have S2 := unpadP_fsp s (regState F v' regD) (X := X) (F := Fa) (F' := Fb) (Y := Y) ys [] hF hF1
    hY hys B hbd (le_trans (zsz_nat_le hVM) hM)
    (by rw [regState_nmem (by decide), h0, List.append_nil])
    (by rw [regState_nmem (by decide), h15]) (by rw [regState_nmem (by decide), h20])
    (by rw [regState_nmem (by decide), h21])
    (L1 := ints (F pX) ++ s.G pX) (L2 := ints (F pB) ++ s.G pB) (L3 := ints (F pZ) ++ s.G pZ)
    (L4 := ints (F pT) ++ s.G pT)
    (encK_G_cons s (regState_mem (by decide)))
    (encK_G_cons s (regState_mem (by decide)))
    (encK_G_cons s (regState_mem (by decide)))
    (encK_G_cons s (regState_mem (by decide)))
  rw [List.append_nil, regState_upd_nmem _ _ (by decide)] at S2
  exact (FSp.of_norep (norep_asgL _) S1).seq S2

end NLogN.KFE

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFE
open IntMul RS AModel AModelL12 KIL KFD
set_option maxHeartbeats 2000000
theorem NLogN.KFE.midF_run {I : List NLogN.Sym} {iprog : Fin 1 → NLogN.IStmt NLogN.HS 1} (s : NLogN.IState NLogN.HS)
    (F : Fin NLogN.HS → List ℤ) (v : Fin NLogN.HS → ℕ) {M B : ℕ} (hM : NLogN.zsz (M : ℤ) ≤ B)
    (hv : ∀ i ∈ NLogN.KIL.regD, v i ≤ M) {q m W K r n : ℕ} (Pre G Suf : AModel.Shape) (child : AModelL12.Oracle (ZMod 2))
    (cO : ℕ → ℕ) (ys : List (ZMod 2)) (hq : 2 ≤ q) (hm : 2 ≤ m) (hW : 1 ≤ W)
    (hPre : ∀ a ∈ Pre, 1 ≤ a) (hG : ∀ a ∈ G, 1 ≤ a) (hS : ∀ a ∈ Suf, 1 ≤ a)
    {LP LS : List ℤ} (FP : F NLogN.KIL.kP = (AModel.vol Pre : ℤ) :: LP) (FS : F NLogN.KIL.kS = (AModel.vol Suf : ℤ) :: LS)
    (vP : v NLogN.KIL.kP = AModel.vol Pre) (vS : v NLogN.KIL.kS = AModel.vol Suf) (vK : v NLogN.KIL.aK = K) (vQR : v NLogN.KIL.aQR = q ^ r)
    (vN : v NLogN.KIL.aN = n) (vQN : v NLogN.KIL.aQN = q ^ n) (vGR : v NLogN.KIL.aGR = AModel.vol G * q ^ r)
    (F0 : F 0 = NLogN.KIL.enc2 ys) (F15 : F 15 = []) (F20 : F 20 = []) (F21 : F 21 = [])
    (F23 : F 23 = []) (F8 : F 8 = []) (F9 : F 9 = []) (F10 : F 10 = []) (F11 : F 11 = [])
    (hys : ys.length = AModel.vol (AModelL12.qShape Pre G Suf q (r + n))) (hn1 : 1 ≤ n) (hWK : W ^ K ≤ q ^ r)
    (hVM : 2 * AModel.vol (AModelL12.qShape Pre G Suf q (r + n)) ≤ M) (hWM : W ≤ M) (hmM : m ≤ M) (hB1 : 1 ≤ B)
    (hO : ∀ j, m ^ j ≤ n → NLogN.KIL.CallSpec I iprog child q m j (AModel.vol Pre) (AModelL12.padRows W K (q ^ r))
      (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W K (q ^ r)) (G ++ List.replicate r q) Suf q n)) (cO j))
    (hlenP : ∀ o j' zs, zs.length =
        AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W K (q ^ r)) (G ++ List.replicate r q) Suf q n) →
      (AModelL12.pieceStep child (AModel.vol Pre) (AModelL12.padRows W K (q ^ r)) (G ++ List.replicate r q) Suf q m n o j'
        zs).length =
        AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W K (q ^ r)) (G ++ List.replicate r q) Suf q n)) :
    ∃ v' : Fin NLogN.HS → ℕ, (∀ i ∈ NLogN.KIL.regD, v' i ≤ M) ∧
      (∀ i, i ∉ [NLogN.KIL.aJ, NLogN.KIL.aNN, NLogN.KIL.aQO, NLogN.KIL.aQM, NLogN.KIL.aTw, NLogN.KIL.aY, NLogN.KIL.aL, NLogN.KIL.aDg, NLogN.KIL.aWK, NLogN.KIL.aRp, NLogN.KIL.pX, NLogN.KIL.pB, NLogN.KIL.pZ, NLogN.KIL.pT] → v' i = v i) ∧
      NLogN.IRuns I iprog (NLogN.KFE.midF q m W) (NLogN.KIL.encK s (NLogN.KIL.regState F v NLogN.KIL.regD))
        (NLogN.KIL.encK s (NLogN.KIL.regState (Function.update F 0 (NLogN.KIL.enc2 (NLogN.KIL.l12mid child W m q K r Pre G Suf n 0 ys)))
          v' NLogN.KIL.regD))
        (NLogN.KFE.cMidF K (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W K (q ^ r)) (G ++ List.replicate r q) Suf q n))
          m n cO B) := by
  set P := AModel.vol Pre with hPdef
  set G' := G ++ List.replicate r q with hG'def
  set R' := AModelL12.padRows W K (q ^ r) with hR'def
  set V' := AModel.vol (AModelL12.rowShape P R' G' Suf q n) with hV'def
  set Y := AModel.vol (AModelL12.restShape G' Suf q n) with hYdef
  set Vq := AModel.vol (AModelL12.qShape Pre G Suf q (r + n)) with hVqdef
  have hq0 : 0 < q := by omega
  have hP1 : 1 ≤ P := NLogN.KIL.one_le_vol hPre
  have hg1 : 1 ≤ AModel.vol G := NLogN.KIL.one_le_vol hG
  have hS1 : 1 ≤ AModel.vol Suf := NLogN.KIL.one_le_vol hS
  have hG' : ∀ a ∈ G', 1 ≤ a := by
    intro a ha; simp only [G', List.mem_append, List.mem_replicate] at ha
    rcases ha with h | ⟨-, rfl⟩
    · exact hG a h
    · omega
  have hQr1 : 1 ≤ q ^ r := Nat.one_le_pow _ _ hq0
  have hQn1 : 1 ≤ q ^ n := Nat.one_le_pow _ _ hq0
  have hgr : AModel.vol G' = AModel.vol G * q ^ r := by simp [G', AModel.vol_append, AModel.vol_replicate]
  have hgr1 : 1 ≤ AModel.vol G * q ^ r := Nat.mul_pos hg1 hQr1
  have hRle := NLogN.KIL.padRows_le W K (q ^ r) hW
  have hRge := NLogN.KIL.le_padRows W K (q ^ r) hW
  rw [← hR'def] at hRle hRge
  have hY : Y = q ^ n * (AModel.vol G * q ^ r * (q ^ n * AModel.vol Suf)) := by
    rw [hYdef, NLogN.KIL.vol_restShape', hgr]
  have hY1 : 1 ≤ Y := by rw [hY]; exact Nat.mul_pos hQn1 (Nat.mul_pos hgr1 (Nat.mul_pos hQn1 hS1))
  have hVq : Vq = P * (q ^ r * Y) := NLogN.KIL.vol_qShape_row Pre G Suf q r n
  have hV' : V' = P * (R' * Y) := by rw [hV'def, AModelL12.vol_rowShape]; ring
  have hV'2 : V' ≤ 2 * Vq := by
    rw [hV', hVq]
    have : R' ≤ 2 * q ^ r := by omega
    calc P * (R' * Y) ≤ P * (2 * q ^ r * Y) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ this)
      _ = 2 * (P * (q ^ r * Y)) := by ring
  have hV'M : V' ≤ M := le_trans hV'2 hVM
  have hQrVq : q ^ r ≤ Vq := by
    rw [hVq]; calc q ^ r = 1 * (q ^ r * 1) := by ring
      _ ≤ P * (q ^ r * Y) := Nat.mul_le_mul hP1 (Nat.mul_le_mul_left _ hY1)
  -- 1. the descriptor of the rows
  obtain ⟨v1, fr1, v1W, v1R, S1⟩ := NLogN.KIL.desc4_sp s F hM hW v hv vK vQR F23 hWK (by omega) hWM
  rw [← hR'def] at v1R
  have hV'M' : P * (R' * Y) ≤ M := by rw [← hV']; exact hV'M
  have hv1 : ∀ i ∈ NLogN.KIL.regD, v1 i ≤ M := NLogN.KIL.bound_keep hv fr1 (by
    intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl
    · rw [v1W]; omega
    · rw [v1R]; have : R' ≤ V' := by rw [hV']; nlinarith
      omega)
  have k1 : ∀ i, i ∉ [NLogN.KIL.aWK, NLogN.KIL.aRp] → v1 i = v i := fr1
  -- 2. row padding
  obtain ⟨e1, e2, e3, e4, e5⟩ := NLogN.KIL.padE_row (F := F) (v := v1) (M := M) FP FS
    (by rw [k1 _ (by decide), vP]) (by rw [k1 _ (by decide), vS]) (by rw [k1 _ (by decide), vQR])
    v1R (by rw [k1 _ (by decide), vQN]) (by rw [k1 _ (by decide), vGR]) hP1 hQr1 hRge hQn1 hgr1 hS1
    (by rw [← hY, ← hV']; exact hV'M)
  have S2 := NLogN.KFE.padS_fsp s F v1 hM hv1 (.reg NLogN.KIL.kP) NLogN.KIL.bR NLogN.KIL.zR NLogN.KIL.tR e1 e2 e3 e4 (X := P) (Fa := q ^ r)
    (Fb := R') (Y := Y)
    (by simp [NLogN.KIL.NE.val, k1 NLogN.KIL.kP (by decide), vP])
    (by simp [NLogN.KIL.bR, NLogN.KIL.yR, NLogN.KIL.NE.val, k1 NLogN.KIL.aQR (by decide), k1 NLogN.KIL.aQN (by decide), k1 NLogN.KIL.aGR (by decide),
      k1 NLogN.KIL.kS (by decide), vQR, vQN, vGR, vS, hY])
    (by simp [NLogN.KIL.zR, NLogN.KIL.yR, NLogN.KIL.NE.val, v1R, k1 NLogN.KIL.aQR (by decide), k1 NLogN.KIL.aQN (by decide), k1 NLogN.KIL.aGR (by decide),
      k1 NLogN.KIL.kS (by decide), vQR, vQN, vGR, vS, hY])
    (by simp [NLogN.KIL.tR, NLogN.KIL.yR, NLogN.KIL.NE.val, v1R, k1 NLogN.KIL.kP (by decide), k1 NLogN.KIL.aQN (by decide), k1 NLogN.KIL.aGR (by decide),
      k1 NLogN.KIL.kS (by decide), vP, vQN, vGR, vS, hY])
    hRge (by omega) hY1 (NLogN.KIL.enc2 ys) F0 F15 F20 F21 (by rw [NLogN.KIL.length_enc2, hys, hVq])
    (NLogN.KIL.bnd_enc2 ys (le_refl 1))
  set v2 := NLogN.KIL.padV v1 P (q ^ r * Y) ((R' - q ^ r) * Y) (P * (R' * Y)) with hv2
  have k2 : ∀ i, i ∉ [NLogN.KIL.pX, NLogN.KIL.pB, NLogN.KIL.pZ, NLogN.KIL.pT] → v2 i = v1 i := fun i hi => by
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    exact NLogN.KIL.padV_frame _ _ _ _ _ i hi.1 hi.2.1 hi.2.2.1 hi.2.2.2
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13⟩ :=
    NLogN.KIL.rowBounds hP1 hQr1 hRge hQn1 hgr1 hS1
  rw [← hY] at c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13
  have hv2 : ∀ i ∈ NLogN.KIL.regD, v2 i ≤ M := NLogN.KIL.padV_bound hv1 (by omega) (by omega) (by omega)
    (by rw [← hV']; exact hV'M)
  -- 3. the pieces
  set ys' := NLogN.KIL.padL P (q ^ r) R' Y 0 ys with hys'
  have hys'l : ys'.length = V' := by
    rw [hys', NLogN.KIL.length_padL hRge 0 (by rw [hys, hVq])]; rw [hV']
  set F2 := Function.update F 0 (NLogN.KIL.padL P (q ^ r) R' Y 0 (NLogN.KIL.enc2 ys)) with hF2
  have F2n : ∀ i, i ≠ 0 → F2 i = F i := fun i hi => Function.update_of_ne hi _ _
  obtain ⟨v3, fr3, hv3, H3⟩ := NLogN.KIL.pieces_run (I := I) (iprog := iprog) s F2 v2 hM (q := q) (m := m)
    (n := n) (P := P) (R' := R') G' Suf child cO ys' hq hm hG' hS hP1 (by omega) hO hlenP hv2
    (by rw [k2 _ (by decide), k1 _ (by decide), vN])
    (by rw [k2 _ (by decide), k1 _ (by decide), vQN])
    (by rw [k2 _ (by decide), k1 _ (by decide), vP])
    (by rw [k2 _ (by decide), v1R])
    (by rw [k2 _ (by decide), k1 _ (by decide), vGR, hgr])
    (by rw [k2 _ (by decide), k1 _ (by decide), vS])
    ⟨LP, by rw [F2n _ (by decide), FP]⟩ ⟨LS, by rw [F2n _ (by decide), FS]⟩
    (by rw [F2n _ (by decide), F23]) (by rw [F2n _ (by decide), F8])
    (by rw [F2n _ (by decide), F9]) (by rw [F2n _ (by decide), F10])
    (by rw [F2n _ (by decide), F11]) (by rw [hF2, Function.update_self, NLogN.KIL.padL_enc2])
    hn1 hys'l hV'M hmM hB1
  set zs := AModelL12.runPieces (AModelL12.pieceStep child P R' G' Suf q m n) (fun j => m ^ j) 0 (AModelL12.pieceLevels m n) ys'
    with hzs
  have hzsl : zs.length = V' := NLogN.KIL.runPieces_length hlenP _ _ _ hys'l
  -- 4. removing the row padding
  have k3 : ∀ i, i ∉ [NLogN.KIL.aJ, NLogN.KIL.aNN, NLogN.KIL.aQO, NLogN.KIL.aQM, NLogN.KIL.aTw, NLogN.KIL.aY, NLogN.KIL.aL, NLogN.KIL.aDg] → v3 i = v2 i := fr3
  set F3 := Function.update F2 0 (NLogN.KIL.enc2 zs) with hF3
  have F3n : ∀ i, i ≠ 0 → F3 i = F i := fun i hi => by
    rw [hF3, Function.update_of_ne hi, F2n i hi]
  have kk : ∀ i, i ∈ [NLogN.KIL.kP, NLogN.KIL.kS, NLogN.KIL.aQR, NLogN.KIL.aRp, NLogN.KIL.aQN, NLogN.KIL.aGR] → v3 i = v1 i := by
    intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;>
      rw [k3 _ (by decide), k2 _ (by decide)]
  obtain ⟨d1, d2, d3, -, d5⟩ := NLogN.KIL.padE_row (F := F3) (v := v3) (M := M)
    (by rw [F3n _ (by decide)]; exact FP) (by rw [F3n _ (by decide)]; exact FS)
    (by rw [kk _ (by decide), k1 _ (by decide), vP]) (by rw [kk _ (by decide), k1 _ (by decide), vS])
    (by rw [kk _ (by decide), k1 _ (by decide), vQR]) (by rw [kk _ (by decide), v1R])
    (by rw [kk _ (by decide), k1 _ (by decide), vQN]) (by rw [kk _ (by decide), k1 _ (by decide), vGR])
    hP1 hQr1 hRge hQn1 hgr1 hS1 (by rw [← hY, ← hV']; exact hV'M)
  have S4 := NLogN.KFE.unpadS_fsp s F3 v3 hM hv3 (.reg NLogN.KIL.kP) NLogN.KIL.bR NLogN.KIL.zR NLogN.KIL.tUR d1 d2 d3 d5 (X := P) (Fa := q ^ r)
    (Fb := R') (Y := Y)
    (by simp [NLogN.KIL.NE.val, kk NLogN.KIL.kP (by decide), k1 NLogN.KIL.kP (by decide), vP])
    (by simp [NLogN.KIL.bR, NLogN.KIL.yR, NLogN.KIL.NE.val, kk NLogN.KIL.aQR (by decide), kk NLogN.KIL.aQN (by decide), kk NLogN.KIL.aGR (by decide),
      kk NLogN.KIL.kS (by decide), k1 NLogN.KIL.aQR (by decide), k1 NLogN.KIL.aQN (by decide), k1 NLogN.KIL.aGR (by decide),
      k1 NLogN.KIL.kS (by decide), vQR, vQN, vGR, vS, hY])
    (by simp [NLogN.KIL.zR, NLogN.KIL.yR, NLogN.KIL.NE.val, kk NLogN.KIL.aRp (by decide), v1R, kk NLogN.KIL.aQR (by decide), kk NLogN.KIL.aQN (by decide),
      kk NLogN.KIL.aGR (by decide), kk NLogN.KIL.kS (by decide), k1 NLogN.KIL.aQR (by decide), k1 NLogN.KIL.aQN (by decide),
      k1 NLogN.KIL.aGR (by decide), k1 NLogN.KIL.kS (by decide), vQR, vQN, vGR, vS, hY])
    (by simp [NLogN.KIL.tUR, NLogN.KIL.yR, NLogN.KIL.NE.val, kk NLogN.KIL.kP (by decide), kk NLogN.KIL.aQR (by decide), kk NLogN.KIL.aQN (by decide),
      kk NLogN.KIL.aGR (by decide), kk NLogN.KIL.kS (by decide), k1 NLogN.KIL.kP (by decide), k1 NLogN.KIL.aQR (by decide),
      k1 NLogN.KIL.aQN (by decide), k1 NLogN.KIL.aGR (by decide), k1 NLogN.KIL.kS (by decide), vP, vQR, vQN, vGR, vS, hY])
    hRge (by omega) hY1 (by rw [← hV']; exact hV'M) (NLogN.KIL.enc2 zs) (by rw [hF3, Function.update_self])
    (by rw [F3n _ (by decide), F15]) (by rw [F3n _ (by decide), F20])
    (by rw [F3n _ (by decide), F21]) (by rw [NLogN.KIL.length_enc2, hzsl, hV'])
    (NLogN.KIL.bnd_enc2 zs (le_refl 1))
  refine ⟨NLogN.KIL.padV v3 P (q ^ r * Y) ((R' - q ^ r) * Y) (P * (q ^ r * Y)),
    NLogN.KIL.padV_bound hv3 (by omega) (by omega) (by omega) (by omega), ?_, ?_⟩
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    rw [NLogN.KIL.padV_frame _ _ _ _ _ i hi.2.2.2.2.2.2.2.2.2.2.1 hi.2.2.2.2.2.2.2.2.2.2.2.1
      hi.2.2.2.2.2.2.2.2.2.2.2.2.1 hi.2.2.2.2.2.2.2.2.2.2.2.2.2,
      k3 i (by simp [hi]), k2 i (by simp [hi]), k1 i (by simp [hi])]
  · have HB := (S1.toIRuns (I := I) (iprog := iprog)).seq ((S2.irun (I := I) (iprog := iprog)
      (by decide)).seq (H3.seq (S4.irun (I := I) (iprog := iprog) (by decide))))
    refine HB.mono' ?_ ?_
    · congr 2
      rw [hF3, hF2, Function.update_idem, Function.update_idem, NLogN.KIL.unpadL_enc2]
      congr 2
      have hysr : ys.length = AModel.vol (AModelL12.rowShape P (q ^ r) G' Suf q n) := by
        rw [hys, hVq, AModelL12.vol_rowShape]; ring
      have hzr : zs.length = AModel.vol (AModelL12.rowShape P R' G' Suf q n) := hzsl
      rw [← NLogN.KIL.extract_rowShape P G' Suf q n hRge 0 hzr]
      unfold NLogN.KIL.l12mid
      rw [NLogN.KIL.embed_rowShape P G' Suf q n hRge 0 hysr]
    · unfold NLogN.KFE.cMidF
      have hc : NLogN.KFE.cPadF (P * (R' * Y)) B = NLogN.KFE.cPadF V' B := by rw [hV']
      simp only [NLogN.KIL.bR, NLogN.KIL.zR, NLogN.KIL.tR, NLogN.KIL.tUR, NLogN.KIL.yR, NLogN.KIL.NE.size, hc]
      have hX : 1 ≤ (B + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
      generalize (B + 2) ^ 2 = X at hX ⊢
      generalize NLogN.KFE.cPadF V' B = CP
      generalize NLogN.KIL.cPcs m n cO B = CC
      nlinarith
end
