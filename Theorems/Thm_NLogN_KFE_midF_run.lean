    e.eval s = e.eval t
  | .reg i, h => NLogN.KFD.top_congr (h i (by simp [Ex.regs]))
  | .lit _, _ => rfl
  | .add a b, h | .mul a b, h | .shl a b, h | .quo a b, h | .rem a b, h | .ndiv a b, h
