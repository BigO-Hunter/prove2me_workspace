theorem selM_eq_sum (K ρ n : ℕ) : selM K ρ n = ∑ i ∈ Finset.range n, 2 ^ (ρ + i * K) := by
  induction n with
  | zero => simp [selM]
  | succ n ih => rw [selM_succ, ih, Finset.sum_range_succ]

section Facts

variable {K ρ f : ℕ}

/-- `offset` is a nonnegative number below `2^{fK}`. -/
theorem offset_bounds (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (x t b : ℤ) : 0 ≤ Butterfly.offset K ρ f x t b ∧ Butterfly.offset K ρ f x t b < 2 ^ (f * K) := by
  have h1 : 0 ≤ Butterfly.offset K ρ f x t b := by
    unfold Butterfly.offset
    exact Finset.sum_nonneg fun i _ => by positivity
  refine ⟨h1, ?_⟩
  have h2 : Butterfly.offset K ρ f x t b ≤ (selM K ρ (f - 1) : ℤ) := by
    unfold Butterfly.offset
    rw [selM_eq_sum]
    push_cast
    refine Finset.sum_le_sum fun i _ => ?_
    split_ifs <;> simp
  have h3 : selM K ρ (f - 1) < 2 ^ (f * K) := by
    have := selM_lt hK ρ (f - 1)
    refine lt_of_lt_of_le this (Nat.pow_le_pow_right (by norm_num) ?_)
    obtain ⟨g, rfl⟩ : ∃ g, f = g + 1 := ⟨f - 1, by omega⟩
    simp only [Nat.add_sub_cancel]; nlinarith
  have : ((selM K ρ (f - 1) : ℕ) : ℤ) < 2 ^ (f * K) := by exact_mod_cast h3
  linarith

end Facts

end NLogN.KFL

end

