      (encK s (Function.update G tgt (r :: lt)))
      (cStep K n T Bb (eu.size + ev.size + ea.size + efin.size)) := by
  -- push u
  have S1 := Sp.pushQ s G (i := NLogN.KFL.rU) (by decide) Eu.clean Eu.ok Eu.bnd
  rw [Eu.ev] at S1
  set G1 := Function.update G NLogN.KFL.rU (u :: G NLogN.KFL.rU) with hG1
  have Ev1 : ESp ev (encK s G1) Bb v := Ev.congr (fun i hi => by
