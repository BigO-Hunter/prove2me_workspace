-- Source module: Solutions.R6ZParam
/-!
# Round six, chirp: the chirp procedure parameters of a size `Q`

The frozen `KFZParam` facts for a round-six size `Q` with `QOk Q` and `Q.d = D + 1`:
`h = ℓ - 1`, `σ = d - d'`, the bits `bs6`, the sources `ss6`, `t_i = 2^{h + bit i}`,
`(D+1) h + σ = L`, the chirp descriptor `descChirp6`, the chirp-table descriptor
`descT (sB D) (tB D)`, the register width `BN6 ≤ 5p` with `RB`, and the Prop 18 descriptor side
conditions `MG`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RP NLogN.KFZ

noncomputable section

section Facts

variable {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1)
include hQ hD

theorem σ_le6 : σ6 Q ≤ D + 1 := by unfold σ6; omega

theorem σ_pos6 : 1 ≤ σ6 Q := by have := dp_le6 hQ hD; unfold σ6; omega

theorem sum_bs6 : (bs6 Q).sum = σ6 Q := by
  unfold bs6 bit6 σ6
  exact sum_bits Q.dp Q.d

theorem length_bs6 : (bs6 Q).length = D + 1 := by simp [bs6, hD]

theorem length_ss6 : (ss6 Q).length = D + 1 := by simp [ss6, hD]

theorem bs6_get (i : ℕ) (hi : i < D + 1) :
    (bs6 Q)[i]'(by rw [length_bs6 hQ hD]; exact hi) = bit6 Q i := by
  simp only [bs6, List.getElem_map, List.getElem_range]

theorem ss6_get (i : ℕ) (hi : i < D + 1) :
    (ss6 Q)[i]'(by rw [length_ss6 hQ hD]; exact hi) = Q.src i := by
  simp only [ss6, List.getElem_map, List.getElem_range]

theorem bs6_le1 : ∀ b ∈ bs6 Q, b ≤ 1 := by
  intro b hb
  simp only [bs6, List.mem_map] at hb
  obtain ⟨j, -, rfl⟩ := hb
  unfold bit6; split_ifs <;> omega

theorem ss6_le (i : ℕ) (hi : i < D + 1) :
    (ss6 Q)[i]'(by rw [length_ss6 hQ hD]; exact hi) ≤
      2 ^ (Q.h + (bs6 Q)[i]'(by rw [length_bs6 hQ hD]; exact hi)) := by
  rw [ss6_get hQ hD i hi, bs6_get hQ hD i hi]
  have := s_le6 hQ hD ⟨i, hi⟩
  rw [tB_bit6 hQ hD] at this
  exact this

theorem eS6 : eS Q.h (bs6 Q) (D + 1) = (D + 1) * Q.h + σ6 Q := by
  unfold eS
  rw [List.take_of_length_le (by rw [length_bs6 hQ hD]), sum_bs6 hQ hD]

theorem axD_eq6 : axD Q.h (bs6 Q) (ss6 Q) = axL (Q.sB D) (Q.tB D) := by
  apply List.ext_getElem
  · rw [length_axD _ _ _ (by rw [length_ss6 hQ hD, length_bs6 hQ hD]), length_bs6 hQ hD]
    simp [axL]
  · intro i h1 h2
    have hi : i < D + 1 := by simpa [axL] using h2
    rw [getElem_axD _ _ _ (by rw [length_ss6 hQ hD, length_bs6 hQ hD])]
    simp only [axL, List.getElem_ofFn]
    rw [ss6_get hQ hD i hi, bs6_get hQ hD i hi, tB_bit6 hQ hD ⟨i, hi⟩]
    rfl

theorem desc_eq6 : descA 1 (axD Q.h (bs6 Q) (ss6 Q)) ++
    [(2 * 2 ^ eS Q.h (bs6 Q) (D + 1) : ℤ)] = descT (Q.sB D) (Q.tB D) := by
  rw [descT, axD_eq6 hQ hD, eS6 hQ hD, prod_t6 hQ hD]
  push_cast; rfl

theorem dCh_eq6 : Q.dCh = (Q.K : ℤ) :: (Q.p : ℤ) :: (Q.α : ℤ) :: (Q.h : ℤ) ::
    ((D + 1 : ℕ) : ℤ) :: (zl (bs6 Q) ++ zl (ss6 Q)) := by
  show (KP6 Q.P Q.n : ℤ) :: descLine (pP6 Q.P Q.n) (αN6 Q.P Q.n) (hN6 Q.P Q.n) (dP6 Q.P Q.n)
    (bL6 Q.P Q.n) Q.src = _
  unfold descLine
  have hD' : dP6 Q.P Q.n = D + 1 := hD
  rw [hD']
  congr 5
  unfold bitsZ zl bs6 ss6 bit6 bL6
  rw [show Q.d = D + 1 from hD, List.map_map, List.map_map]
  congr 1
  · congr 1; funext j; simp only [Function.comp, decide_eq_true_eq]; split_ifs <;> rfl

theorem RB6 : RB Q.p Q.h (D + 1) (σ6 Q) Q.K (BN6 Q) := by
  have hσ := σ_pos6 hQ hD
  have hσd := σ_le6 hQ hD
  have hh : Q.h ≤ (D + 1) * Q.h := Nat.le_mul_of_pos_left _ (by omega)
  refine ⟨hσd, by omega, ?_, ?_⟩
  · unfold BN6; rw [hD]; omega
  · unfold BN6; omega

theorem MG6 : MG Q.p Q.h (D + 1) (σ6 Q) Q.K := by
  have hp6 : Q.p / 6 = Q.b := by rw [Q.p_eq]; omega
  have hb := hQ.hb
  have hdb := hQ.hdb
  have hl := ell_le_L6 hQ hD
  have hLb := L_le_b6 hQ hD
  have hs := hQ.h_succ
  refine ⟨by rw [hp6, Q.p_eq], by omega, by omega, by omega,
    Nat.pow_le_pow_right (by norm_num) (by omega), by rw [hp6]; exact K_le6 hQ hD, by omega⟩

theorem setupB6 : eS Q.h (bs6 Q) (D + 1) + Q.h + 6 ≤ BN6 Q ∧ D + 1 + 2 ≤ BN6 Q ∧
    zsz (Q.K : ℤ) ≤ BN6 Q ∧ zsz (Q.p : ℤ) ≤ BN6 Q ∧ zsz (Q.α : ℤ) ≤ BN6 Q := by
  rw [eS6 hQ hD]
  refine ⟨?_, ?_, zszS ?_, zszS ?_, zszS ?_⟩ <;> unfold BN6 dlV <;> rw [hD] <;> omega

theorem tsG_eq6 : tsG Q.d Q.dp Q.r = tsOf (Q.tB D) := by
  apply List.ext_getElem
  · simp [tsG, tsOf, hD]
  · intro i h1 h2
    simp only [tsG, tsOf, List.getElem_map, List.getElem_range, List.getElem_ofFn]
    show _ = tF6 Q.P Q.n i
    unfold tF6 bL6
    have hs := hQ.h_succ
    have er : Q.r = 2 ^ hN6 Q.P Q.n * 2 := by
      show 2 ^ ℓP6 Q.P Q.n = _
      rw [← pow_succ]; congr 1; exact hs.symm
    by_cases h : dpN6 Q.P Q.n ≤ i
    · rw [if_pos h, if_pos (decide_eq_true h)]; exact er
    · rw [if_neg h, if_neg (by simpa using h)]
      show Q.r / 2 = _
      rw [er]; omega

theorem ts_mem6 : ∀ t ∈ tsG Q.d Q.dp Q.r, t = Q.r ∨ 2 * t = Q.r := by
  intro t ht
  simp only [tsG, List.mem_map] at ht
  obtain ⟨j, -, rfl⟩ := ht
  have hs := hQ.h_succ
  have er : Q.r = 2 ^ Q.h * 2 := by
    show 2 ^ ℓP6 Q.P Q.n = _
    rw [← pow_succ]; congr 1; exact hs.symm
  split_ifs
  · left; rfl
  · right; rw [er]; omega

theorem ts_prod6 : (tsG Q.d Q.dp Q.r).prod * Q.r = Q.T := by
  rw [tsG_eq6 hQ hD, tsOf_prod, ← hQ.tB_last hD, ← Fin.prod_univ_castSucc, hQ.prod_tB hD]; rfl

theorem desc18_bnd6 : ∀ x ∈ dsG Q.p Q.h (D + 1) (σ6 Q) Q.K, zsz x ≤ BN6 Q := by
  have hB := p_le_B6 hQ hD
  have hs := hQ.h_succ
  have hK := K_le6 hQ hD
  have hlb := ell_le_L6 hQ hD
  have hLb := L_le_b6 hQ hD
  have hpb : Q.p = 6 * Q.b := Q.p_eq
  rw [dsG_eq6 hQ hD]
  intro x hx
  simp [desc18] at hx
  rcases hx with rfl | rfl | rfl | rfl | ⟨t, ht, rfl⟩
  · exact zszS (by omega)
  · exact zszS (by unfold BN6 dlV; omega)
  · exact zszS (by unfold BN6; omega)
  · have := ts_len6 hQ hD
    exact zszS (by unfold BN6 dlV; rw [hD] at *; omega)
  · have er : Q.r = 2 ^ (Q.h + 1) := by rw [hs]; rfl
    rcases ts_mem6 hQ hD t ht with e | e
    · rw [e, er]
      exact zszN (k := Q.h + 1) le_rfl (by unfold BN6 dlV; omega)
    · have : t ≤ 2 ^ (Q.h + 1) := by rw [← er]; omega
      exact zszN (k := Q.h + 1) this (by unfold BN6 dlV; omega)

theorem hM6 : 2 ^ ((D + 1) * Q.h + σ6 Q - (Q.h + 1)) = ∏ i : Fin D, Q.tB D i.castSucc := by
  have e1 := prod_init6 hQ hD
  have hle : Q.h + 1 ≤ (D + 1) * Q.h + σ6 Q := (RB6 hQ hD).hL
  have e2 : 2 ^ ((D + 1) * Q.h + σ6 Q - (Q.h + 1)) * 2 ^ (Q.h + 1) =
      2 ^ ((D + 1) * Q.h + σ6 Q) := by
    rw [← pow_add, Nat.sub_add_cancel hle]
  rw [← e2] at e1
  exact (Nat.eq_of_mul_eq_mul_right (by positivity) e1).symm

end Facts

end

