section
-- Source module: Solutions.KFZBox
/-!
# KFZ Box: row-major Gaussian lists as functions on the box

The arrays of the chirp step are row-major lists of Gaussian numerators (`RepFull`, last axis
fastest). This file is the dictionary between such lists and functions on the box
`∏ ZMod t_i`:

* `digL_append`, `digL_append_len`, `boxIx_castSucc`, `boxIx_last`: digits of `x` over
  `t_0 … t_D` are the digits of `x / t_D` over `t_0 … t_{D−1}`, then `x mod t_D`.
* `ptB t x`: the box point of index `x`; **`flatIx_ptB`**, **`ptB_flatIx`** (`flatIx` of
  `KFMTabQ` is its inverse).
* `decB p t zs K = toC zs[flatIx K] / 2^p`; **`repFull_decB`**, **`RepFull.eq_decB`**.
* **`decB_gmulT`** (the `gmulP` pass is `Q_p` of the pointwise product), **`decB_gconj`**,
  **`decB_gtr`** (rounding), **`decB_repl`** (a record table repeated over the records),
  **`decB_chirpArr`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul KIL KFB NLogN.KFM Complex

noncomputable section

variable {d : ℕ}

theorem ptB_flatIx : ∀ (d : ℕ) (t : Fin d → ℕ) [∀ i, NeZero (t i)] (K : (i : Fin d) → ZMod (t i)),
    ptB t (flatIx d t K) = K
  | 0, t, _, K => by funext i; exact i.elim0
  | d + 1, t, _, K => by
    have hr : 0 < t (Fin.last d) := Nat.pos_of_ne_zero (NeZero.ne _)
    have hc := ZMod.val_lt (K (Fin.last d))
    set F := flatIx d (fun i => t i.castSucc) (fun i => K i.castSucc)
    have hdiv : (F * t (Fin.last d) + (K (Fin.last d)).val) / t (Fin.last d) = F := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hr, Nat.div_eq_of_lt hc, zero_add]
    have hmod : (F * t (Fin.last d) + (K (Fin.last d)).val) % t (Fin.last d) =
        (K (Fin.last d)).val := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hc]
    have ih := ptB_flatIx d (fun i => t i.castSucc) (fun i => K i.castSucc)
    funext i
    rw [flatIx]
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [ptB]; rw [boxIx_last, hmod, ZMod.natCast_zmod_val]
    · have := congrFun ih j
      simp only [ptB] at this ⊢
      rw [boxIx_castSucc t hr, hdiv]; exact this

theorem RepFull.eq_decB {p : ℕ} {t : Fin d → ℕ} [∀ i, NeZero (t i)] {zs : List GI}
    {w : ((i : Fin d) → ZMod (t i)) → ℂ} (h : RepFull p t zs w) : w = decB p t zs := by
  funext K
  have hK := flatIx_lt d t K
  have := h.2 (flatIx d t K) (by rw [prod_ofFn']; exact hK)
  have e : (fun i => ((boxIx t (flatIx d t K) i : ℕ) : ZMod (t i))) = K := ptB_flatIx d t K
  rw [e, gC_eq_toC] at this
  simp only [decB]
  rw [this]; field_simp

/-! ## Pointwise operations -/

theorem getD_zipWith {f : GI → GI → GI} (zs ts : List GI) (k : ℕ) (hz : k < zs.length)
    (ht : k < ts.length) : (List.zipWith f zs ts).getD k 0 = f (zs.getD k 0) (ts.getD k 0) := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getD_eq_getElem _ _ hz,
    List.getD_eq_getElem _ _ ht, List.getElem_zipWith]

/-- `toC` of a `Q_p` product. -/
theorem toC_gmulT (p : ℕ) (z w : GI) :
    toC (gmulT p z w) / 2 ^ p = Butterfly.Qp p ((toC z / 2 ^ p) * (toC w / 2 ^ p)) := by
  rw [gmulT_eq, ← KFH.Qp_toC p p, toC_gmul]
  congr 1
  rw [pow_add]; field_simp

theorem decB_gmulT (p : ℕ) (t : Fin d → ℕ) [∀ i, NeZero (t i)] (zs ts : List GI)
    (hz : zs.length = ∏ i, t i) (ht : ts.length = ∏ i, t i) :
    decB p t (List.zipWith (gmulT p) zs ts) = QA p (decB p t zs * decB p t ts) := by
  funext K
  have hK := flatIx_lt d t K
  simp only [decB, QA, Pi.mul_apply]
  rw [getD_zipWith _ _ _ (by omega) (by omega), toC_gmulT]

end

end NLogN.KFZ

end

