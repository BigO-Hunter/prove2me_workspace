section
-- Source module: Solutions.KFZRec
/-!
# KFZ Rec: the box arrays as `P18IL` record lists

`P18IL` takes and returns row-major lists of records of `r` coefficients (`RecRep r p`). On the
box `t` with last axis `t_D = r` these are the `RepFull` arrays (`KFMBridge.recL`, `boxOf`):

* `ptB_rec`: the index `j·r + c` is the box point `fullIdx t j c`.
* `castR`: transport of records along `t_D = r` (the identity after `subst`).
* **`rec_in`**: `RepFull p t zs w` gives `RecRep r p zs (castR (recL t w))`, length `∏_{i<D} t_i`.
* **`rec_out`**: a `RecRep` output with the `P18IL` bound gives `RepFull p t zh h` with
  `‖h − mrX t f g‖ ≤ E`.
* **`GB_of_repFull`**: arrays of norm `≤ 2^k` have `p + k + 2`-bit numerators.
* **`mrtCall`**: the per-call map `M̃r` (`h` at the actual operands, `mrX` elsewhere).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul KIL KFB NLogN.KFM NLogN.KFH Complex

noncomputable section

variable {D : ℕ}

theorem prod_box (t : Fin (D + 1) → ℕ) : (tsOf t).prod * t (Fin.last D) = ∏ i, t i := by
  rw [tsOf_prod, Fin.prod_univ_castSucc]

theorem ptB_rec (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (j c : ℕ) (hc : c < t (Fin.last D)) :
    ptB t (j * t (Fin.last D) + c) = fullIdx t j c := by
  have hr : 0 < t (Fin.last D) := Nat.pos_of_ne_zero (NeZero.ne _)
  have hdiv : (j * t (Fin.last D) + c) / t (Fin.last D) = j := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hr, Nat.div_eq_of_lt hc, zero_add]
  have hmod : (j * t (Fin.last D) + c) % t (Fin.last D) = c := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hc]
  funext i
  refine Fin.lastCases ?_ (fun k => ?_) i
  · simp only [ptB, fullIdx, Fin.val_last, lt_irrefl, if_false]; rw [boxIx_last, hmod]
  · simp only [ptB, fullIdx, Fin.val_castSucc, k.isLt, if_true]
    rw [boxIx_castSucc t hr, hdiv]; rfl

@[simp] theorem castR_rfl {a : ℕ} (L : List (Fin a → ℂ)) : castR rfl L = L := by
  simp [castR]

theorem norm_rec_le (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (w : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {C : ℝ}
    (hC : 0 ≤ C) (hw : ‖w‖ ≤ C) : ∀ v ∈ recL t w, ‖v‖ ≤ C := by
  intro v hv
  simp only [recL, List.mem_map] at hv
  obtain ⟨j, -, rfl⟩ := hv
  exact pi_le hC fun c => (norm_le_pi_norm w _).trans hw

theorem rec_in (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (r : ℕ) (hr : t (Fin.last D) = r)
    (p : ℕ) {zs : List GI} {w : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ} (h : RepFull p t zs w) :
    RecRep r p zs (castR hr (recL t w)) ∧ (castR hr (recL t w)).length = (tsOf t).prod ∧
      (‖w‖ ≤ 1 → ∀ v ∈ castR hr (recL t w), ‖v‖ ≤ 1) := by
  subst hr
  simp only [castR_rfl]
  refine ⟨⟨?_, fun j c hj => ?_⟩, recL_length t w, fun hw => norm_rec_le t w zero_le_one hw⟩
  · rw [RepFull.length h, recL_length, prod_box]
  · rw [recL_length] at hj
    have hx : j * t (Fin.last D) + c < (List.ofFn t).prod := by
      rw [prod_ofFn', ← prod_box]; nlinarith [c.isLt]
    have := h.2 _ hx
    rw [show (fun i => ((boxIx t (j * t (Fin.last D) + c) i : ℕ) : ZMod (t i))) =
      fullIdx t j c from ptB_rec t j c c.isLt, gC_eq_toC] at this
    rw [this, recL_getD t w hj]

theorem boxOf_fullIdx (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (xs : List (Fin (t (Fin.last D)) → ℂ)) (j : ℕ) (hj : j < (tsOf t).prod)
    (c : Fin (t (Fin.last D))) : boxOf t xs (fullIdx t j c) = xs.getD j 0 c := by
  simp only [boxOf]
  have e : (Equiv.ofBijective _ (phiB_bij t)).symm (fullIdx t j c) = (⟨j, hj⟩, c) :=
    (Equiv.ofBijective _ (phiB_bij t)).symm_apply_apply (⟨j, hj⟩, c)
  rw [e]

theorem rec_out (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (r : ℕ) (hr : t (Fin.last D) = r)
    (p : ℕ) (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {zh : List GI}
    {xh : List (Fin r → ℂ)} {E : ℝ} (hE : 0 ≤ E) (hrep : RecRep r p zh xh)
    (hl : xh.length = (tsOf t).prod)
    (herr : ∀ j < (tsOf t).prod, ∀ k : Fin r,
      ‖xh.getD j 0 k - (mrL r (tsOf t) (castR hr (recL t f)) (castR hr (recL t g))).getD j 0 k‖ ≤ E) :
    RepFull p t zh (boxOf t (castR hr.symm xh)) ∧
      ‖boxOf t (castR hr.symm xh) - mrX t f g‖ ≤ E := by
  subst hr
  simp only [castR_rfl] at *
  refine ⟨⟨?_, fun x hx => ?_⟩, mrt_err_of_list t f g hE hl herr⟩
  · rw [hrep.1, hl, prod_box, prod_ofFn']
  · have hr0 : 0 < t (Fin.last D) := Nat.pos_of_ne_zero (NeZero.ne _)
    rw [prod_ofFn', ← prod_box] at hx
    have hj : x / t (Fin.last D) < (tsOf t).prod := by rw [Nat.div_lt_iff_lt_mul hr0]; exact hx
    have hc : x % t (Fin.last D) < t (Fin.last D) := Nat.mod_lt _ hr0
    have ex : x = x / t (Fin.last D) * t (Fin.last D) + x % t (Fin.last D) :=
      (Nat.div_add_mod' x _).symm
    have hp := ptB_rec t (x / t (Fin.last D)) (x % t (Fin.last D)) hc
    rw [← ex] at hp
    rw [show (fun i => ((boxIx t x i : ℕ) : ZMod (t i))) = ptB t x from rfl, hp,
      boxOf_fullIdx t xh _ hj ⟨_, hc⟩, gC_eq_toC]
    have := hrep.2 (x / t (Fin.last D)) ⟨_, hc⟩ (by rw [hl]; exact hj)
    simp only at this
    rw [← ex] at this
    exact this

/-! ## The per-call ring convolution -/

theorem mrtCall_eq (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (f g h : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) : mrtCall t f g h f g = h := by
  simp [mrtCall]

theorem mrtCall_err (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (f g h : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {E : ℝ} (hE : 0 ≤ E)
    (hh : ‖h - mrX t f g‖ ≤ E) (a b : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :
    ‖mrtCall t f g h a b - mrX t a b‖ ≤ E := by
  unfold mrtCall
  split_ifs with hab
  · obtain ⟨rfl, rfl⟩ := hab; exact hh
  · simpa using hE

end

end NLogN.KFZ

