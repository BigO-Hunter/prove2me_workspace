set_option maxHeartbeats 8000000 in
/-- **The chirp from Prop 18** at the round-six sizes. -/
theorem chirp_of_P18_sol_aux (P : Prm) (hP : P.Ok) (tab : Fin 1 → IStmt HS 1) (H : P18Body6 P tab) :
    ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (eC : Fin (7 + E)) (C₀ : ℝ) (A n₁ : ℕ),
      0 ≤ C₀ ∧
    ∀ (Q : Q6), Q.P = P → QOk Q → n₁ ≤ Q.n → ∀ (D : ℕ), Q.d = D + 1 →
    ∀ [∀ i, NeZero (Q.tB D i)],
    ∃ (θt θit at' bt : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) (ζ : ℂ),
      ζ ^ Q.tB D (Fin.last D) = -1 ∧
      Phases Q.p (twX (Q.tB D) ζ) θt ∧
      Phases Q.p (fun j => (twX (Q.tB D) ζ j)⁻¹) θit ∧
      Phases Q.p (fun j => (starRingEnd ℂ) (chirp (Q.sB D) (Q.tB D) j)) at' ∧
      Phases Q.p (chirp (Q.sB D) (Q.tB D)) bt ∧
      Grid Q.p bt ∧
      ∀ Isym, chirpG6 Isym (IL.kTableP tab ext) eC cS C₀ A Q D θt θit at' bt := by
  obtain ⟨E18, ext18, entry18, d18, C18, A18, n18, hd18, hC18, H18⟩ := H
  refine ⟨E18 + 0 + 0 + 0 + 1, extZ6 ext18 entry18 d18, gO4 E18 0 0 0 1 0,
    C18 + Kc * ((P.x : ℝ) + 4) ^ 2, A18 + 2, n18, by have := Kc_nonneg; positivity, ?_⟩
  intro Q hQP hQ hn18 D hD inst
  obtain ⟨Pq, n, src⟩ := Q
  simp only at hQP
  subst hQP
  set Q : Q6 := ⟨Pq, n, src⟩ with hQdef
  -- names
  set p := Q.p with hpP
  set h := Q.h with hh
  set t := Q.tB D with ht
  set sv := Q.sB D with hsv
  have htl : t (Fin.last D) = 2 ^ (h + 1) := t_last6 hQ hD
  have hst : ∀ i, sv i ≤ t i := s_le6 hQ hD
  have hT : ∀ i, t i ≤ 2 ^ (h + 1) := t_le6 hQ hD
  have hPb := phases_bt (p := p) (D := D) hst hT
  have hPa := phases_at (p := p) (D := D) hst hT
  have hPt := phases_θt (p := p) htl
  have hPi := phases_θit (p := p) htl
  refine ⟨decB p t (tLz p h D t), decB p t (iLz p h D t), decB p t (aLz p h D sv t),
    decB p t (bLz p h D sv t), zt h, zt_pow htl, hPt, hPi, hPa, hPb, grid_bt, ?_⟩
  intro Isym s f l hf hdesc xs x h0 hx hx1
  -- the input
  have hxl : xs.length = ∏ i, t i := RepFull.length hx
  have hxe : x = decB p t xs := RepFull.eq_decB hx
  subst hxe
  have hX1 : ‖decB p t xs‖ ≤ 1 := hx1.trans (by norm_num)
  have gx : GB (p + 2) xs := gb_of_box hxl hX1
  have la := length_aLz p h D sv t
  have lb := length_bLz p h D sv t
  have lt := length_tLz p h D htl
  have li := length_iLz p h D htl
  -- U = Q(ã x)
  have eU : decB p t (List.zipWith (gmulT p) xs (aLz p h D sv t)) =
      QA p (decB p t (aLz p h D sv t) * decB p t xs) := by
    rw [decB_gmulT p t _ _ hxl la, mul_comm]
  have nU := (phase_err p _ _ (decB p t xs) hPa.e hPa.t hPa.t1 hX1).2
  have lU : (List.zipWith (gmulT p) xs (aLz p h D sv t)).length = ∏ i, t i := by
    rw [List.length_zipWith, hxl, la, min_self]
  have gU : GB (p + 2) (List.zipWith (gmulT p) xs (aLz p h D sv t)) :=
    gb_of_box lU (by rw [eU]; linarith)
  -- G = Q(θ̃ U)
  have eG : decB p t (zGz p h D sv t xs) =
      QA p (decB p t (tLz p h D t) * QA p (decB p t (aLz p h D sv t) * decB p t xs)) := by
    rw [zGz, decB_gmulT p t _ _ lU lt, eU, mul_comm]
  have nG := (phase_err p _ _ (QA p (decB p t (aLz p h D sv t) * decB p t xs)) hPt.e hPt.t hPt.t1
    (nU.trans hX1)).2
  have lG : (zGz p h D sv t xs).length = ∏ i, t i := by
    rw [zGz, List.length_zipWith, lU, lt, min_self]
  have gG : GB (p + 2) (zGz p h D sv t xs) := gb_of_box lG (by rw [eG]; linarith)
  -- F = Q(θ̃ b̃)
  have eF : decB p t (zFz p h D sv t) =
      QA p (decB p t (tLz p h D t) * decB p t (bLz p h D sv t)) := by
    rw [zFz, decB_gmulT p t _ _ lb lt, mul_comm]
  have nF := (phase_err p _ _ (decB p t (bLz p h D sv t)) hPt.e hPt.t hPt.t1
    (Phases.norm_le hPb)).2
  have lF : (zFz p h D sv t).length = ∏ i, t i := by
    rw [zFz, List.length_zipWith, lb, lt, min_self]
  have gF : GB (p + 2) (zFz p h D sv t) :=
    gb_of_box lF (by rw [eF]; linarith [Phases.norm_le hPb])
  -- the records
  set Fv := QA p (decB p t (tLz p h D t) * decB p t (bLz p h D sv t)) with hFv
  set Gv := QA p (decB p t (tLz p h D t) * QA p (decB p t (aLz p h D sv t) * decB p t xs))
    with hGv
  have hFn : ‖Fv‖ ≤ 1 := nF.trans (Phases.norm_le hPb)
  have hGn : ‖Gv‖ ≤ 1 := nG.trans (nU.trans hX1)
  have hrl : t (Fin.last D) = Q.r := hQ.tB_last hD
  have rF := rec_in t Q.r hrl p (show RepFull p t (zFz p h D sv t) Fv by
    rw [← eF]; exact repFull_decB p t _ lF)
  have rG := rec_in t Q.r hrl p (show RepFull p t (zGz p h D sv t xs) Gv by
    rw [← eG]; exact repFull_decB p t _ lG)
  have hts := tsG_eq6 hQ hD
  have hds := dsG_eq6 hQ hD
  -- the Prop 18 call
  obtain ⟨zh, xh, c18, hrun, hrep, hlen, hgb, herr, hcost⟩ := H18 Isym n hn18
    (tsG Q.d Q.dp Q.r) (ts_len6 hQ hD) (ts_mem6 hQ hD) (ts_prod6 hQ hD)
    (bgS s (preM (FC f p h D (σ6 Q) Q.K sv t (gflat xs ++ l)) (zFz p h D sv t)
      (zGz p h D sv t xs) l) d18 l)
    (fC d18 (gflat (zFz p h D sv t) ++ gflat (zGz p h D sv t xs) ++ [])
      (dsG p h (D + 1) (σ6 Q) Q.K))
    (zFz p h D sv t) (zGz p h D sv t xs) [] _ _
    (fun j h1 h2 => fC_ne _ _ _ j h1 h2) (by rw [fC_d18, hds]) (fC_0 _ hd18 _ _) rF.1 rG.1
    (by rw [rF.2.1, hts]) (by rw [rG.2.1, hts]) gF gG (rF.2.2 hFn) (rG.2.2 hGn)
  -- its result
  rw [hts] at hlen herr
  have hEr0 : 0 ≤ Q.er * hp p := mul_nonneg (by show (0 : ℝ) ≤ errW6 _ _; unfold errW6; positivity) (hp_pos p).le
  obtain ⟨repH, errH⟩ := rec_out t Q.r hrl p Fv Gv hEr0 hrep hlen herr
  set Hv := boxOf t (castR hrl.symm xh) with hHv
  have hHz : Hv = decB p t zh := RepFull.eq_decB repH
  have lh : zh.length = ∏ i, t i := RepFull.length repH
  set Mrt := mrtCall t Fv Gv Hv with hMrt
  have hMb : ∀ a b, Grid p a → Grid p b → ‖a‖ ≤ 1 → ‖b‖ ≤ 1 →
      ‖Mrt a b - mrX t a b‖ ≤ Q.er * hp p :=
    fun a b _ _ _ _ => mrtCall_err t Fv Gv Hv hEr0 errH a b
  -- V = Q(θ̃⁻ H)
  have eM : mcT p Mrt (decB p t (tLz p h D t)) (decB p t (iLz p h D t))
      (decB p t (bLz p h D sv t)) (QA p (decB p t (aLz p h D sv t) * decB p t xs)) =
      QA p (decB p t (iLz p h D t) * Hv) := by
    unfold mcT
    rw [← hFv, ← hGv, hMrt, mrtCall_eq]
  have eV : decB p t (List.zipWith (gmulT p) zh (iLz p h D t)) =
      QA p (decB p t (iLz p h D t) * Hv) := by
    rw [decB_gmulT p t _ _ lh li, hHz, mul_comm]
  have nV : ‖QA p (decB p t (iLz p h D t) * Hv)‖ ≤ 1 := by
    rw [← eM]
    have := (mc_err p (bilC_mrX t) Q.er hMb hPt hPi (Phases.norm_le hPb)
      ((nU.trans hx1).trans (by norm_num)) (hQ.hεA.trans (by norm_num))).2
    have := hQ.hεA
    linarith
  have lV : (List.zipWith (gmulT p) zh (iLz p h D t)).length = ∏ i, t i := by
    rw [List.length_zipWith, lh, li, min_self]
  have gV : GB (p + 2) (List.zipWith (gmulT p) zh (iLz p h D t)) :=
    gb_of_box lV (by rw [eV]; exact nV)
  -- y = Q(ã V)
  have eY : decB p t (yz p h D sv t zh) = chirpT p (mcT p Mrt (decB p t (tLz p h D t))
      (decB p t (iLz p h D t))) (decB p t (bLz p h D sv t)) (decB p t (aLz p h D sv t))
      (decB p t xs) := by
    rw [yz, decB_gmulT p t _ _ lV la, eV, chirpT, eM, mul_comm]
  have lY : (yz p h D sv t zh).length = ∏ i, t i := by
    rw [yz, List.length_zipWith, lV, la, min_self]
  have nY : ‖decB p t (yz p h D sv t zh)‖ ≤ 1 := by
    rw [yz, decB_gmulT p t _ _ lV la, eV, mul_comm]
    exact (phase_err p _ _ _ hPa.e hPa.t hPa.t1 nV).2.trans nV
  -- the run
  have hrun' := IRuns.relabel (iprog' := IL.kTableP tab (extZ6 ext18 entry18 d18))
    (g := g4₁ E18 0 0 0 1)
    (mTab4_g1 tab ext18 (Fin.elim0 : Fin 0 → IStmt HS (7 + 0)) (Fin.elim0 : Fin 0 → IStmt HS (7 + 0))
      (Fin.elim0 : Fin 0 → IStmt HS (7 + 0))
      (fun _ => body (g4₁ E18 0 0 0 1 entry18) d18)) hrun
  obtain ⟨sB1, sB2, sB3, sB4, sB5⟩ := setupB6 hQ hD
  have hc : f cS = (Q.K : ℤ) :: (p : ℤ) :: (Q.α : ℤ) :: (h : ℤ) :: ((D + 1 : ℕ) : ℤ) ::
      (zl (bs6 Q) ++ zl (ss6 Q)) := by rw [hdesc, dCh_eq6 hQ hD]
  have hrb := body_runsP tab (extZ6 ext18 entry18 d18) (I := Isym) s
    (g4₁ E18 0 0 0 1 entry18) d18 hd18 (RB6 hQ hD) (MG6 hQ hD) (BN6 Q) (desc18_bnd6 hQ hD)
    sv t hst (fun i => lt_of_lt_of_le (by norm_num) (t_ge6 hQ hD i)) hT htl (prod_t6 hQ hD)
    (hM6 hQ hD) (bs6 Q) (ss6 Q) (length_bs6 hQ hD) (length_ss6 hQ hD) (bs6_le1 hQ hD)
    (ss6_le hQ hD) (sum_bs6 hQ hD) sB1 sB2 sB3 sB4 sB5 (desc_eq6 hQ hD) f hf hc xs l h0 hxl gx
    zh lh hgb gU gG gF gV c18 hrun'
  have hown := mTab4_own tab ext18 (Fin.elim0 : Fin 0 → IStmt HS (7 + 0))
    (Fin.elim0 : Fin 0 → IStmt HS (7 + 0)) (Fin.elim0 : Fin 0 → IStmt HS (7 + 0))
    (fun _ => body (g4₁ E18 0 0 0 1 entry18) d18) 0
  have hown' : IL.kTableP tab (extZ6 ext18 entry18 d18) (gO4 E18 0 0 0 1 0) =
      body (g4₁ E18 0 0 0 1 entry18) d18 := hown
  refine ⟨Mrt, hMb, yz p h D sv t zh, _, IRuns.call (by rw [hown']; exact hrb), ?_,
    gb_of_box lY nY, ?_⟩
  · rw [← eY]; exact repFull_decB p t _ lY
  · exact cost_final6 hQ hD hP C18 hC18 A18 c18 hcost

end

