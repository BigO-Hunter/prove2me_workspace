theorem NLogN.KIL.Sp_seq {a b : NLogN.RS} {s t u : NLogN.IState NLogN.HS} {c1 c2 : ℕ} (ha : NLogN.KIL.Sp a s t c1) (hb : NLogN.KIL.Sp b t u c2) :
