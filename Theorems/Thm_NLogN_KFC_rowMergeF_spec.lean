open NLogN
open IntMul AModel
open NLogN.KFC
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem NLogN.KFC.rowMergeF_spec (t : NLogN.IState NLogN.HS) {W : ℕ} (s : Fin W → List ℤ) (P L : ℕ) [NeZero W]
    (rest : AModel.Shape) (w : ℕ) (R L1 L2 L3 L4 : List NLogN.Item)
    (hs : ∀ v, (s v).length = P * L * AModel.vol rest) (hb : ∀ v, NLogN.Bnd w (s v))
    (hB1 : 1 ≤ AModel.vol rest) (hPL : 1 ≤ P * L)
    (h0 : t.G 0 = NLogN.ints ((List.finRange W).flatMap s) ++ R)
    (h1 : t.G 1 = .int ((1 : ℕ) : ℤ) :: L1)
    (h2 : t.G 2 = .int (W : ℤ) :: L2) (h3 : t.G 3 = .int ((P * L : ℕ) : ℤ) :: L3)
    (h4 : t.G 4 = .int (AModel.vol rest : ℤ) :: L4) :
    NLogN.IRuns I iprog NLogN.KFC.fwdF t (t.upd 0 (NLogN.ints (AModel.rowMerge P W L rest 0 s) ++ R))
      (NLogN.KFC.cFwdF 1 W (P * L) (AModel.vol rest) w) := by
  rw [NLogN.KIL.rowMerge_eq P W L rest s hs]
  refine NLogN.KFC.fwdF_spec t _ 1 W (P * L) (AModel.vol rest) w R L1 L2 L3 L4 ?_ ?_ hB1 hPL (NeZero.pos W)
    le_rfl h0 h1 h2 h3 h4
  · rw [NLogN.KIL.length_fm_const _ _ (P * L * AModel.vol rest) (fun v _ => hs v)]; simp; ring
  · intro x hx
    simp only [List.mem_flatMap] at hx
    obtain ⟨v, -, hv⟩ := hx; exact hb v x hv
end
