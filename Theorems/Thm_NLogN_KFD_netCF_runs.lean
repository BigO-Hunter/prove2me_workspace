theorem irun_topJ {G0 : Fin HS → List Item} {code : IStmt HS Pp} {ys ys' : List ℤ} {c : ℕ}
    (h : ∀ (t : IState HS) (R : List Item), NLogN.KIL.Inv G0 t → IRuns I iprog code (t.upd 0 (ints ys ++ R))
      (t.upd 0 (ints ys' ++ R)) c)
    (s : IState HS) (hs : NLogN.KIL.Inv G0 s) (f : Fin HS → List ℤ) (hf : ∀ r, Prot r → f r = [])
