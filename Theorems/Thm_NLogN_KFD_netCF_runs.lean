/-- `acc ← acc ⊕ (stream w)ʳᵉᵛ` (fine). -/
theorem accCU_fsp {W v w : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (hw : w < W)
    (s : IState HS) (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) (hR : RegS s f W v) (acc hr : List ℤ) (hf20 : f 20 = acc ++ hr)
    (hacc : acc.length = v) (hab : NLogN.KIL.Bits acc) {Bb : ℕ} (hB : TabB W v Bb) (hv1 : 1 ≤ v) :
    FSp (accCU w) (encK s f)
      (encK s (Function.update f 20 (List.zipWith xr acc (F w).reverse ++ hr)))
      (cCF (W * v) Bb + 300 * cOF (W * v) Bb) := by
  have hFw := hU w hw
  have hvv : v ≤ W * v := hB.vle
  obtain ⟨Lv, hLv⟩ := hR.sV
  have h1 := copyCU_fsp hU hw s f rest hf hf21 hR hB hv1
  set g1 := Function.update f 16 ((F w).reverse ++ f 16)
  have hz := FSp.zipK (A := 20) (Z := 16) (O := 19) (C := 21) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s g1
    acc (F w).reverse hr (f 16) (by simp +decide [g1, hf20]) (by simp [g1])
    (by rw [List.length_reverse, hFw.1, hacc]) hab (bits_reverse hFw.2)
    (by simp +decide [g1, hf21]) Bb (by rw [hacc]; exact hB.le hvv)
  have h2 := FSp.simReg (r := NLogN.KIL.rV) (by decide) (rsim_zipK 20 16 19 21 NLogN.KIL.rV acc.length)
    (by simp +decide [zipK, RS.writes]) (by
      refine ⟨Lv, ?_⟩; rw [hacc]; simp +decide [g1, hR.fV, hLv]) hz
  set g2 := Function.update (Function.update (Function.update g1 20 hr) 16
      (f 16)) 19 ((List.zipWith xr acc (F w).reverse).reverse ++ g1 19)
  have hlz : (List.zipWith xr acc (F w).reverse).length = v := by
    simp [hacc, hFw.1]
  have h3 := FSp.mvR (X := 19) (Y := 20) (C := 21) (r := NLogN.KIL.rV) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s g2
    (List.zipWith xr acc (F w).reverse).reverse (g1 19) (by simp +decide [g2]) (Lr := Lv)
    (by rw [List.length_reverse, hlz]; simp +decide [g2, g1, hR.fV, hLv]) 1 Bb
    (NLogN.KIL.bnd_reverse (bits_bnd (bits_zipWith_xr hab (bits_reverse hFw.2)) le_rfl))
    (by rw [List.length_reverse, hlz]; exact hB.le hvv)
  rw [List.length_reverse, hlz] at h3
  have H := h1.seq (h2.seq h3)
  refine FSp.mono (FSp.congr H ?_) ?_
  · congr 1
    funext j
    simp only [g2, g1, Function.update_apply]
    by_cases h16 : j = 16
    · subst h16; simp +decide
    by_cases h19 : j = 19
    · subst h19; simp +decide
    by_cases h20 : j = 20
    · subst h20; simp +decide
    · simp [h16, h19, h20]
  · have := cLp_le_cOF (Bb := Bb) (c := 250 * (1 + 2)) hvv (by norm_num)
    have := cLp_le_cOF (Bb := Bb) (c := 200000) hvv (by norm_num)
    rw [hacc] at *
    omega

theorem accLU_fsp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) (hR : RegS s f W v) {Bb : ℕ} (hB : TabB W v Bb) (hv1 : 1 ≤ v)
    (hr : List ℤ) :
    ∀ (l : List ℕ) (acc : List ℤ), (∀ w ∈ l, w < W) → f 20 = acc ++ hr → acc.length = v →
      NLogN.KIL.Bits acc →
      FSp (accLU l) (encK s f) (encK s (Function.update f 20 (accR F acc l ++ hr)))
        (l.length * (2 * cCF (W * v) Bb) + 1)
  | [], acc, _, h20, _, _ => by
    simp only [accLU, accR, List.foldl_nil, List.length_nil, Nat.zero_mul, Nat.zero_add]
    rw [← h20, Function.update_eq_self]; exact FSp.skip _
  | w :: l, acc, hl, h20, hlen, hbits => by
    have hw := hl w List.mem_cons_self
    have h1 := accCU_fsp hU hw s f rest hf hf21 hR acc hr h20 hlen hbits hB hv1
    have hFw := hU w hw
    have h2 := accLU_fsp hU s (Function.update f 20 (List.zipWith xr acc (F w).reverse ++ hr)) rest
      (by simp +decide [hf]) (by simp +decide [hf21]) (hR.upd (by decide) _) hB hv1 hr l
      (List.zipWith xr acc (F w).reverse)
      (fun w' hw' => hl w' (List.mem_cons_of_mem _ hw')) (by simp)
      (by rw [length_zipWith_xr (by simp [hlen, hFw.1]), hlen])
      (bits_zipWith_xr hbits (bits_reverse hFw.2))
    have H := h1.seq h2
    refine FSp.mono (FSp.congr H ?_) ?_
    · congr 1
      rw [Function.update_idem]
      rfl
    · simp only [List.length_cons]
      unfold cCF at *
      have : 300 * cOF (W * v) Bb ≤ 1000 * cOF (W * v) Bb + cPushT Bb + (2 * Bb + 2) := by omega
      nlinarith

theorem buildCU_fsp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) (hR : RegS s f W v) {Bb : ℕ} (hB : TabB W v Bb) (hv1 : 1 ≤ v)
    (l : List ℕ) (hl : ∀ w ∈ l, w < W) :
    FSp (buildCU l) (encK s f)
      (encK s (Function.update f 20 ((sumS F v l).reverse ++ f 20)))
      ((l.length * 2 + 1) * cCF (W * v) Bb + 1) := by
  have hvv := hB.vle
  obtain ⟨Lv, hLv⟩ := hR.sV
  have hz := FSp.zeroK (Y := 20) (C := 21) (by decide) (by decide) (by decide) s f v hf21 Bb
    (hB.le hvv)
  have h1 := FSp.simReg (r := NLogN.KIL.rV) (by decide) (rsim_zeroK 20 21 NLogN.KIL.rV v)
    (by simp +decide [zeroK, RS.writes]) ⟨Lv, by simp [hR.fV, hLv]⟩ hz
  have h2 := accLU_fsp hU s (Function.update f 20 (List.replicate v 0 ++ f 20)) rest
    (by simp +decide [hf]) (by simp +decide [hf21]) (hR.upd (by decide) _) hB hv1 (f 20) l
    (List.replicate v 0) hl (by simp) (by simp) (bits_replicate v)
  have H := h1.seq h2
  refine FSp.mono (FSp.congr H ?_) ?_
  · congr 1
    rw [Function.update_idem, show List.replicate v (0 : ℤ) = (List.replicate v 0).reverse by simp,
      accR_rev hU l _ hl (by simp)]
    rfl
  · have := cLp_le_cOF (Bb := Bb) (c := 8000) hvv (by norm_num)
    unfold cCF at *
    nlinarith

theorem buildsCU_fsp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) (hR : RegS s f W v) {Bb : ℕ} (hB : TabB W v Bb) (hv1 : 1 ≤ v)
    {T : ℕ → List ℕ} (hT : SrcOK W T) :
    ∀ n, n ≤ W → FSp (buildsCU T n) (encK s f)
      (encK s (Function.update f 20 ((tabR 0 n (fun w => sumS F v (T w))).reverse ++ f 20)))
      (n * ((2 * W + 1) * cCF (W * v) Bb + 1) + 1)
  | 0, _ => by
    simp only [buildsCU, tabR, List.range'_zero, List.flatMap_nil, List.reverse_nil,
      List.nil_append, Function.update_eq_self, Nat.zero_mul, Nat.zero_add]
    exact FSp.skip _
  | n + 1, hn => by
    have h1 := buildsCU_fsp hU s f rest hf hf21 hR hB hv1 hT n (by omega)
    have h2 := buildCU_fsp hU s (Function.update f 20 ((tabR 0 n (fun w => sumS F v (T w))).reverse ++
      f 20)) rest (by simp +decide [hf]) (by simp +decide [hf21]) (hR.upd (by decide) _) hB hv1
      (T n) (hT n (by omega)).1
    have H := h1.seq h2
    refine FSp.mono (FSp.congr H ?_) ?_
    · congr 1
      rw [Function.update_idem, Function.update_self, tabR_add, List.reverse_append]
      simp [tabR]
    · have := (hT n (by omega)).2
      have : (T n).length * 2 + 1 ≤ 2 * W + 1 := by omega
      have := Nat.mul_le_mul_right (cCF (W * v) Bb) this
      nlinarith

theorem rebuildCU_fsp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) (hR : RegS s f W v) {Bb : ℕ} (hB : TabB W v Bb) (hv1 : 1 ≤ v)
    {T : ℕ → List ℕ} (hT : SrcOK W T) :
    FSp (rebuildCU W T) (encK s f)
      (encK s (Function.update f 0 (tabR 0 W (fun w => sumS F v (T w)) ++ rest)))
      (cRebuildF W (W * v) Bb) := by
  have hG := uni_sumS hU hT
  obtain ⟨Lw, hLw⟩ := hR.sWV
  have h1 := buildsCU_fsp hU s f rest hf hf21 hR hB hv1 hT W le_rfl
  have hlenF := length_tabR hU 0 W (by omega)
  have hlenG := length_tabR hG 0 W (by omega)
  set g1 := Function.update f 20 ((tabR 0 W (fun w => sumS F v (T w))).reverse ++ f 20)
  have hd := FSp.dropK (X := 0) (C := 21) (by decide) (by decide) (by decide) s g1
    (tabR 0 W F) rest (by simp +decide [g1, hf]) (by simp +decide [g1, hf21]) 1 Bb
    (bits_bnd (bits_tabR hU 0 W (by omega)) le_rfl) (by rw [hlenF]; exact hB.le le_rfl)
  have h2 := FSp.simReg (r := rWV) (by decide) (rsim_dropK 0 21 rWV (tabR 0 W F).length)
    (by simp +decide [dropK, RS.writes]) ⟨Lw, by rw [hlenF]; simp +decide [g1, hR.fWV, hLw]⟩ hd
  have h3 := FSp.mvR (X := 20) (Y := 0) (C := 21) (r := rWV) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s (Function.update g1 0 rest)
    (tabR 0 W (fun w => sumS F v (T w))).reverse (f 20) (by simp +decide [g1]) (Lr := Lw)
    (by rw [List.length_reverse, hlenG]; simp +decide [g1, hR.fWV, hLw]) 1 Bb
    (NLogN.KIL.bnd_reverse (bits_bnd (bits_tabR hG 0 W (by omega)) le_rfl))
    (by rw [List.length_reverse, hlenG]; exact hB.le le_rfl)
  rw [List.length_reverse, hlenG] at h3
  have H := h1.seq (h2.seq h3)
  refine FSp.mono (FSp.congr H ?_) ?_
  · congr 1
    funext j
    simp only [g1, Function.update_apply]
    by_cases h0 : j = 0
    · subst h0; simp +decide
    by_cases h20 : j = 20
    · subst h20; simp +decide
    · simp [h0, h20]
  · have := cLp_le_cOF (Bb := Bb) (c := 2 * 1 + 2) (le_refl (W * v)) (by norm_num)
    have := cLp_le_cOF (Bb := Bb) (c := 250 * (1 + 2)) (le_refl (W * v)) (by norm_num)
    rw [hlenF] at *
    unfold cRebuildF cCF at *
    nlinarith

theorem fok_accCU (w : ℕ) : fok (accCU w) = true := by simp +decide [copyCU, accCU, zipKE, dupKE, fok, touch, NLogN.KFD.scr, NLogN.mvK, Ex.regs, mAdd, KFC.uK, KFC.uR, KFC.uY, KFC.uB]

theorem fok_accLU : ∀ l : List ℕ, fok (accLU l) = true
  | [] => rfl
  | w :: l => by simp only [accLU, fok, fok_accCU, fok_accLU l, Bool.and_self]

theorem fok_buildCU (l : List ℕ) : fok (buildCU l) = true := by
  simp only [buildCU, fok, fok_accLU, Bool.and_true]; decide

theorem fok_buildsCU (T : ℕ → List ℕ) : ∀ n, fok (buildsCU T n) = true
  | 0 => rfl
  | n + 1 => by simp only [buildsCU, fok, fok_buildsCU T n, fok_buildCU, Bool.and_self]

theorem fok_rebuildCU (W : ℕ) (T : ℕ → List ℕ) : fok (rebuildCU W T) = true := by
  simp only [rebuildCU, fok, fok_buildsCU, Bool.true_and]; decide

section Apply

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem applyCF_runs {G0 : Fin HS → List Item} {W v w : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F)
    (hw : w < W) {code : IStmt HS Pp} {ys' : List ℤ} {c : ℕ}
    (hc : ∀ (t : IState HS) (R : List Item), NLogN.KIL.Inv G0 t → IRuns I iprog code
      (t.upd 0 (ints (F w) ++ R)) (t.upd 0 (ints ys' ++ R)) c)
    (s : IState HS) (hs : NLogN.KIL.Inv G0 s) (f : Fin HS → List ℤ) (hfp : ∀ r, Prot r → f r = [])
    (hR : RegS s f W v) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (Bb : ℕ) (hV : zsz ((W * v : ℕ) : ℤ) ≤ Bb) (hv1 : 1 ≤ v) :
    IRuns I iprog (applyCF w code) (encK s f)
      (encK s (Function.update f 0 (tabR 0 W (Function.update F w ys') ++ rest)))
      (c + 2 * cOF (W * v) Bb + cPushT Bb + (2 * Bb + 2)) := by
  have hpre : (tabR 0 w F).length = w * v := length_tabR hU 0 w (by omega)
  have hbits := bits_tabR hU 0 w (by omega)
  have hwv : w * v ≤ W * v := Nat.mul_le_mul_right v hw.le
  have zw : zsz (((tabR 0 w F).length : ℕ) : ℤ) ≤ Bb := by
    rw [hpre]; exact le_trans (zsz_natCast_le' hwv) hV
  obtain ⟨Lv, hLv⟩ := hR.gV
  have hvW : v ≤ W * v := Nat.le_mul_of_pos_left v (by omega)
  have S0 := Sp.pushQ s f (i := NLogN.KIL.rT) (e := .mul (.lit (w : ℤ)) (.reg NLogN.KIL.rV)) (B := Bb) (by decide)
    (clean_mul (clean_lit _) (clean_reg (by decide))) ⟨trivial, IState.isInt_of hLv⟩
    ⟨le_trans (zsz_natCast_le' (show w ≤ W * v from le_trans hw.le (Nat.le_mul_of_pos_right W hv1))) hV,
      by simp only [Ex.Bnd]; rw [IState.top_eq hLv]; exact le_trans (zsz_natCast_le' hvW) hV,
      by simp only [Ex.eval]; rw [IState.top_eq hLv]; exact_mod_cast le_trans (zsz_natCast_le' hwv) hV⟩
  have ev : (Ex.mul (.lit (w : ℤ)) (.reg NLogN.KIL.rV)).eval (encK s f) = ((w * v : ℕ) : ℤ) := by
    simp only [Ex.eval]; rw [IState.top_eq hLv]; push_cast; ring
  rw [ev] at S0
  set f0 := Function.update f NLogN.KIL.rT [((w * v : ℕ) : ℤ)]
  have ef0 : Function.update f NLogN.KIL.rT (((w * v : ℕ) : ℤ) :: f NLogN.KIL.rT) = f0 := by simp +decide [f0, hR.fT]
  rw [ef0] at S0
  have h1 := FSp.mvR (X := 0) (Y := 15) (C := 21) (r := NLogN.KIL.rT) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f0 (tabR 0 w F)
    (F w ++ tabR (w + 1) (W - (w + 1)) F ++ rest)
    (by simp +decide [f0, hf, tab_split hw]) (Lr := s.G NLogN.KIL.rT) (by simp +decide [f0, hpre]) 1 Bb
    (bits_bnd hbits le_rfl) zw
  rw [hpre] at h1
  set f1 := Function.update (Function.update f0 0 (F w ++ tabR (w + 1) (W - (w + 1)) F ++ rest)) 15
    ((tabR 0 w F).reverse ++ f0 15)
  have hf1p : ∀ r, Prot r → f1 r = [] := fun r hr => by
    have h0 : r ≠ 0 := fun e => by subst e; exact not_prot (by decide) hr
    have h15 : r ≠ 15 := fun e => by subst e; exact not_prot (by decide) hr
    have hT : r ≠ rT := fun e => by subst e; exact not_prot_rT hr
    simp [f1, f0, h0, h15, hT, hfp r hr]
  have h2 := irun_topJ (I := I) (iprog := iprog) hc s hs f1 hf1p (tabR (w + 1) (W - (w + 1)) F ++ rest)
    (by simp +decide [f1])
  set f2 := Function.update f1 0 (ys' ++ (tabR (w + 1) (W - (w + 1)) F ++ rest))
  have h3 := FSp.mvR (X := 15) (Y := 0) (C := 21) (r := NLogN.KIL.rT) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f2 (tabR 0 w F).reverse (f 15)
    (by simp +decide [f2, f1, f0]) (Lr := s.G NLogN.KIL.rT) (by simp +decide [f2, f1, f0, hpre]) 1 Bb
    (NLogN.KIL.bnd_reverse (bits_bnd hbits le_rfl)) (by rw [List.length_reverse]; exact zw)
  rw [List.length_reverse, hpre] at h3
  set f3 := Function.update (Function.update f2 15 (f 15)) 0 ((tabR 0 w F).reverse.reverse ++ f2 0)
  have h4 := Sp.pop s f3 (i := NLogN.KIL.rT) (a := ((w * v : ℕ) : ℤ)) (l := []) (B := Bb) (by decide)
    (by simp +decide [f3, f2, f1, f0]) (le_trans (zsz_natCast_le' hwv) hV)
  have HA := ((FSp.of_norep rfl S0).seq h1).irun (I := I) (iprog := iprog)
    (by simp +decide [fok, touch, NLogN.KFD.scr, NLogN.mvK, Ex.regs, KFC.uK, KFC.uR, KFC.uY, KFC.uB])
  have HB := (h3.seq (FSp.of_norep rfl h4)).irun (I := I) (iprog := iprog) (by decide)
  have H := HA.seq (h2.seq HB)
  refine H.mono' ?_ ?_
  · congr 1
    funext j
    simp only [f3, f2, f1, f0, Function.update_apply]
    by_cases h0 : j = 0
    · subst h0
      simp only [if_true, show (0 : Fin HS) ≠ 15 by decide, if_false, List.reverse_reverse,
        show (0 : Fin HS) ≠ NLogN.KIL.rT by decide]
      rw [tab_split hw (Function.update F w ys')]
      rw [tabR_congr 0 w (F := Function.update F w ys') (G := F)
          (fun k _ hk => Function.update_of_ne (show k ≠ w by omega) _ _),
        tabR_congr (w + 1) (W - (w + 1)) (F := Function.update F w ys') (G := F)
          (fun k hk _ => Function.update_of_ne (show k ≠ w by omega) _ _), Function.update_self]
      simp +decide
    · by_cases h15 : j = 15
      · subst h15; simp +decide
      · by_cases hT : j = NLogN.KIL.rT
        · subst hT; simp +decide [hR.fT]
        · simp [h0, h15, hT]
  · have := cLp_le_cOF (Bb := Bb) (c := 250 * (1 + 2)) hwv (by norm_num)
    unfold cPushT
    simp only [Ex.size]
    omega

