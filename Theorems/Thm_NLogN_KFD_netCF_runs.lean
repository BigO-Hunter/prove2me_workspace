section Seq

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **Frame changes in place** (register counts, under the invariant). -/
theorem framesF_runs {G0 : Fin HS → List Item} {W v : ℕ} (s : IState HS) (hs : NLogN.KIL.Inv G0 s)
    (rest : List ℤ) {Bb : ℕ} (hB : TabB W v Bb) (hv1 : 1 ≤ v)
    (codes : Fin W → IStmt HS Pp) (cs : Fin W → ℕ) (G : Fin W → List ℤ) :
    ∀ (l : List (Fin W)) (F : ℕ → List ℤ) (f : Fin HS → List ℤ), l.Nodup → Uni W v F →
      (∀ w ∈ l, (G w).length = v ∧ NLogN.KIL.Bits (G w)) →
      (∀ w ∈ l, ∀ (t : IState HS) (R : List Item), NLogN.KIL.Inv G0 t → IRuns I iprog (codes w)
        (t.upd 0 (ints (F w) ++ R)) (t.upd 0 (ints (G w) ++ R)) (cs w)) →
      (∀ r, Prot r → f r = []) → RegS s f W v →
      f 0 = tabR 0 W F ++ rest →
      IRuns I iprog (KIL.seqL (l.map fun (w : Fin W) => applyCF (w : ℕ) (codes w))) (encK s f)
        (encK s (Function.update f 0 (tabR 0 W
          (fun n => if h : n < W then (if (⟨n, h⟩ : Fin W) ∈ l then G ⟨n, h⟩ else F n) else F n)
          ++ rest)))
        ((l.map fun (w : Fin W) => cs w + cCF (W * v) Bb).sum + 1)
  | [], F, f, _, _, _, _, _, _, hf => by
    simp only [List.map_nil, KIL.seqL, List.sum_nil, Nat.zero_add, List.not_mem_nil, if_false,
      dite_eq_ite, ite_self]
    rw [← hf, Function.update_eq_self]; exact IRuns.skip _
  | w :: l, F, f, hnd, hU, hG, hc, hfp, hR, hf => by
    have hw := w.2
    have h1 := applyCF_runs (I := I) (iprog := iprog) hU hw (hc w List.mem_cons_self) s hs f hfp hR
      rest hf Bb hB.vol hv1
    have hU' : Uni W v (Function.update F w (G w)) := fun n hn => by
      by_cases e : n = w
      · subst e; simpa using hG w List.mem_cons_self
      · rw [Function.update_of_ne e]; exact hU n hn
    have hnd' := (List.nodup_cons.1 hnd)
    have h2 := framesF_runs s hs rest hB hv1 codes cs G l (Function.update F w (G w))
      (Function.update f 0 (tabR 0 W (Function.update F w (G w)) ++ rest)) hnd'.2 hU'
      (fun w' hw' => hG w' (List.mem_cons_of_mem _ hw'))
      (fun w' hw' t R ht => by
        have hne : (w' : ℕ) ≠ w := fun e => hnd'.1 (by rw [show w' = w from Fin.ext e] at hw'; exact hw')
        rw [Function.update_of_ne hne]
        exact hc w' (List.mem_cons_of_mem _ hw') t R ht)
      (fun r hr => by
        have : r ≠ 0 := fun e => by subst e; exact not_prot (by decide) hr
        simp [this, hfp r hr])
      (hR.upd (by decide) _) (by simp)
    have H := h1.seq h2
    refine H.mono' ?_ ?_
    · rw [Function.update_idem]
      congr 3
      congr 1
      funext n
      by_cases hn : n < W
      · simp only [dif_pos hn, List.mem_cons]
        by_cases e : (⟨n, hn⟩ : Fin W) ∈ l
        · simp [e]
        · by_cases e' : (⟨n, hn⟩ : Fin W) = w
          · subst e'; simp [e]
          · have : n ≠ (w : ℕ) := fun h => e' (Fin.ext h)
            simp [e, e', Function.update_of_ne this]
      · simp only [dif_neg hn]
        rw [Function.update_of_ne (show n ≠ (w : ℕ) by omega)]
    · simp only [List.map_cons, List.sum_cons]
      unfold cCF
      omega

end Seq

section Net

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W v : ℕ} {M : Type*} [AddGroup M]

variable (E : M → IStmt HS Pp)

variable (cE : M → ℕ)

variable {E cE}

/-- **One gate** (register counts, under the invariant). -/
theorem gateCF_runs {G0 : Fin HS → List Item} (Φ : M → List (ZMod 2) → List (ZMod 2))
    (Pr : M → Prop)
    (hΦl : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → (Φ X ys).length = v)
    (hE : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → ∀ (t : IState HS) (R : List Item),
      NLogN.KIL.Inv G0 t →
      IRuns I iprog (E X) (t.upd 0 (ints (enc2 ys) ++ R)) (t.upd 0 (ints (enc2 (Φ X ys)) ++ R))
        (cE X))
    (s : IState HS) (hs : NLogN.KIL.Inv G0 s) (rest : List ℤ) {Bb : ℕ} (hB : TabB W v Bb) (hv1 : 1 ≤ v)
    (lab : Fin W → M) (Y : Fin W → Fin v → ZMod 2) (g : NGate (Fin W) (ZMod 2) M)
    (hPr : ∀ w ∈ g.2.1, Pr (g.2.2 - lab w))
    (f : Fin HS → List ℤ) (hfp : ∀ r, Prot r → f r = []) (hR : RegS s f W v)
    (hf : f 0 = tabR 0 W (tabOf Y) ++ rest) (hf21 : f 21 = []) :
    IRuns I iprog (gateCF E lab g) (encK s f)
      (encK s (Function.update f 0
        (tabR 0 W (tabOf (physStepF (funΦ v Φ) (lab, Y) g).2) ++ rest)))
      (((touchL g.2.1).map fun (w : Fin W) => cE (g.2.2 - lab w) + cCF (W * v) Bb).sum + 1 +
        cRebuildF W (W * v) Bb) := by
  set S := g.2.1
  set Z : ℕ → List (ZMod 2) := fun n => if h : n < W then
    (if (⟨n, h⟩ : Fin W) ∈ S then Φ (g.2.2 - lab ⟨n, h⟩) (List.ofFn (Y ⟨n, h⟩))
      else List.ofFn (Y ⟨n, h⟩)) else [] with hZ
  have h1 := framesF_runs (I := I) (iprog := iprog) s hs rest hB hv1
    (fun w => E (g.2.2 - lab w)) (fun w => cE (g.2.2 - lab w))
    (fun w => enc2 (Φ (g.2.2 - lab w) (List.ofFn (Y w)))) (touchL S) (tabOf Y) f (touchL_nodup S)
    (uni_tabOf Y)
    (fun w hw => ⟨by rw [length_enc2, hΦl _ (hPr w (mem_touchL.1 hw)) _ (by simp)],
      NLogN.KIL.bits_enc2 _⟩)
    (fun w hw t R ht => by
      have := hE _ (hPr w (mem_touchL.1 hw)) (List.ofFn (Y w)) (by simp) t R ht
      simpa [tabOf, liftF] using this) hfp hR hf
  have eZ : (fun n => if h : n < W then (if (⟨n, h⟩ : Fin W) ∈ touchL S then
      enc2 (Φ (g.2.2 - lab ⟨n, h⟩) (List.ofFn (Y ⟨n, h⟩))) else tabOf Y n) else tabOf Y n) =
      fun n => enc2 (Z n) := by
    funext n
    by_cases hn : n < W
    · simp only [dif_pos hn, mem_touchL, hZ, tabOf, liftF]
      split_ifs <;> rfl
    · simp [hn, hZ, tabOf, liftF, enc2]
  rw [eZ] at h1
  have hUZ : Uni W v fun n => enc2 (Z n) := by
    intro n hn
    refine ⟨?_, NLogN.KIL.bits_enc2 _⟩
    simp only [hZ, dif_pos hn, length_enc2]
    split_ifs with hS
    · exact hΦl _ (hPr _ hS) _ (by simp)
    · simp
  have h2 := rebuildCU_fsp hUZ s (Function.update f 0 (tabR 0 W (fun n => enc2 (Z n)) ++ rest)) rest
    (by simp) (by simp [hf21]) (hR.upd (by decide) _) hB hv1 (srcOK g)
  have H := h1.seq (h2.irun (fok_rebuildCU _ _))
  refine H.mono' ?_ le_rfl
  rw [Function.update_idem]
  congr 3
  apply tabR_congr
  intro n _ hn
  simp only [Nat.zero_add] at hn
  rw [sumS_enc2]
  simp only [tabOf, liftF, dif_pos hn]
  congr 1
  have hZl : ∀ n', n' < W → (Z n').length = v := fun n' hn' => by
    have := (hUZ n' hn').1; simpa using this
  have hsrc := (srcOK g n hn).1
  apply List.ext_getElem
  · rw [length_sumZ Z _ _ (fun w hw => by rw [List.length_replicate]; exact hZl w (hsrc w hw))]
    simp
  intro i h1 h2
  have hi : i < v := by simpa using h2
  rw [← List.getD_eq_getElem _ (0 : ZMod 2) h1,
    getD_sumZ Z i _ _ (fun w hw => by rw [List.length_replicate]; exact hZl w (hsrc w hw))
      (by simpa using hi)]
  simp only [List.getElem_ofFn, physStepF]
  rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_replicate, zero_add]
  by_cases hS : (⟨n, hn⟩ : Fin W) ∈ S
  · have hS' : (⟨n, hn⟩ : Fin W) ∈ g.2.1 := hS
    simp only [srcT, dif_pos hn, if_pos hS']
    rw [gate_sum g ⟨n, hn⟩ Z i, Finset.sum_apply]
    refine Finset.sum_congr rfl fun w' hw' => ?_
    have hw'' : w' ∈ S := hw'
    simp only [Pi.smul_apply, hZ, dif_pos w'.2, Fin.eta, if_pos hw'', funΦ]
  · have hS' : (⟨n, hn⟩ : Fin W) ∉ g.2.1 := hS
    simp only [srcT, dif_pos hn, if_neg hS', List.map_cons, List.map_nil, List.sum_cons,
      List.sum_nil, add_zero]
    simp only [hZ, dif_pos hn, if_neg hS]
    rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_ofFn]

end Net

end NLogN.KFD

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KFD
open IntMul RS AModel KIL
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W v : ℕ} {M : Type*} [AddGroup M]
variable (E : M → IStmt HS Pp)
variable (cE : M → ℕ)
variable {E cE}
theorem netCF_runs_aux {G0 : Fin NLogN.HS → List NLogN.Item} (Φ : M → List (ZMod 2) → List (ZMod 2))
    (Pr : M → Prop)
    (hΦl : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → (Φ X ys).length = v)
    (hE : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → ∀ (t : NLogN.IState NLogN.HS) (R : List NLogN.Item),
      NLogN.KIL.Inv G0 t →
      NLogN.IRuns I iprog (E X) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R)) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (Φ X ys)) ++ R))
        (cE X))
    (s : NLogN.IState NLogN.HS) (hs : NLogN.KIL.Inv G0 s) (rest : List ℤ) {Bb : ℕ} (hB : NLogN.KIL.TabB W v Bb) (hv1 : 1 ≤ v)
    (Mout : Fin W → M) :
    ∀ (gates : List (AModel.NGate (Fin W) (ZMod 2) M)) (lab : Fin W → M) (Y : Fin W → Fin v → ZMod 2)
      (f : Fin NLogN.HS → List ℤ), AModel.FramesOK Pr gates lab Mout →
      (∀ r, NLogN.KIL.Prot r → f r = []) → NLogN.KIL.RegS s f W v →
      f 0 = NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf Y) ++ rest → f 21 = [] →
      NLogN.IRuns I iprog (NLogN.KFD.netCF E Mout lab gates) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0
          (NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf (AModel.netRunF (NLogN.KIL.funΦ v Φ) gates lab Mout Y)) ++ rest)))
        (NLogN.KFD.netCIF cE (W * v) Bb Mout lab gates) 
  | [], lab, Y, f, hF, hfp, hR, hf, _ => by
    have h1 := NLogN.KFD.framesF_runs (I := I) (iprog := iprog) s hs rest hB hv1
      (fun w => E (Mout w - lab w)) (fun w => cE (Mout w - lab w))
      (fun w => NLogN.KIL.enc2 (Φ (Mout w - lab w) (List.ofFn (Y w)))) (List.finRange W) (NLogN.KIL.tabOf Y) f
      (List.nodup_finRange W) (NLogN.KIL.uni_tabOf Y)
      (fun w _ => ⟨by rw [NLogN.KIL.length_enc2, hΦl _ (hF w) _ (by simp)], NLogN.KIL.bits_enc2 _⟩)
      (fun w _ t R ht => by
        have := hE _ (hF w) (List.ofFn (Y w)) (by simp) t R ht
        simpa [NLogN.KIL.tabOf, NLogN.KIL.liftF] using this) hfp hR hf
    refine h1.mono' ?_ le_rfl
    congr 3
    apply NLogN.KIL.tabR_congr
    intro n _ hn
    simp only [Nat.zero_add] at hn
    simp only [dif_pos hn, List.mem_finRange, if_true, NLogN.KIL.tabOf, NLogN.KIL.liftF, AModel.netRunF, List.foldl_nil]
    rw [NLogN.KIL.ofFn_funΦ _ _ _ (hΦl _ (hF _) _ (by simp))]
  | g :: gs, lab, Y, f, hF, hfp, hR, hf, hf21 => by
    have h1 := NLogN.KFD.gateCF_runs (E := E) (cE := cE) (I := I) (iprog := iprog) Φ Pr hΦl hE s hs rest hB
      hv1 lab Y g hF.1 f hfp hR hf hf21
    have h2 := netCF_runs_aux Φ Pr hΦl hE s hs rest hB hv1 Mout gs (AModel.labStep lab g)
      (AModel.physStepF (NLogN.KIL.funΦ v Φ) (lab, Y) g).2
      (Function.update f 0 (NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf (AModel.physStepF (NLogN.KIL.funΦ v Φ) (lab, Y) g).2) ++ rest)) hF.2
      (NLogN.KIL.prot_upd0 hfp _) (hR.upd (by decide) _) (by simp) (by simp [hf21])
    have H := h1.seq h2
    refine H.mono' ?_ le_rfl
    rw [Function.update_idem, NLogN.KIL.netRunF_cons]

theorem NLogN.KFD.netCF_runs {G0 : Fin NLogN.HS → List NLogN.Item} (Φ : M → List (ZMod 2) → List (ZMod 2))
    (Pr : M → Prop)
    (hΦl : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → (Φ X ys).length = v)
    (hE : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → ∀ (t : NLogN.IState NLogN.HS) (R : List NLogN.Item),
      NLogN.KIL.Inv G0 t →
      NLogN.IRuns I iprog (E X) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R)) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (Φ X ys)) ++ R))
        (cE X))
    (s : NLogN.IState NLogN.HS) (hs : NLogN.KIL.Inv G0 s) (rest : List ℤ) {Bb : ℕ} (hB : NLogN.KIL.TabB W v Bb) (hv1 : 1 ≤ v)
    (Mout : Fin W → M) :
    ∀ (gates : List (AModel.NGate (Fin W) (ZMod 2) M)) (lab : Fin W → M) (Y : Fin W → Fin v → ZMod 2)
      (f : Fin NLogN.HS → List ℤ), AModel.FramesOK Pr gates lab Mout →
      (∀ r, NLogN.KIL.Prot r → f r = []) → NLogN.KIL.RegS s f W v →
      f 0 = NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf Y) ++ rest → f 21 = [] →
      NLogN.IRuns I iprog (NLogN.KFD.netCF E Mout lab gates) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0
          (NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf (AModel.netRunF (NLogN.KIL.funΦ v Φ) gates lab Mout Y)) ++ rest)))
        (NLogN.KFD.netCIF cE (W * v) Bb Mout lab gates) := by
  first
  | exact netCF_runs_aux
  | (intros; apply netCF_runs_aux <;> assumption)
end
