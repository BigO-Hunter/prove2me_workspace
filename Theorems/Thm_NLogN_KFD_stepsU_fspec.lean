variable {m : ℕ}
theorem stepsU_fspec_aux {N : ℕ} [NeZero N] (A B Cs : AModel.Shape) (P L : ℕ) (rX : Fin NLogN.HS)
    (hrX : 38 ≤ rX.val ∧ rX.val < 56)
    (hpos : ∀ a ∈ P :: L :: AModel.hdShape A B Cs m N, 1 ≤ a) (w Bb : ℕ) (R : List NLogN.Item)
    (hV : NLogN.zsz ((AModel.vol (P :: L :: AModel.hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : NLogN.zsz ((2 * N : ℕ) : ℤ) ≤ Bb)
    {LN LQ LX LB LC : List NLogN.Item} (t : NLogN.IState NLogN.HS) (hNQ : t.G NLogN.KIL.sNQ = .int (-(N : ℤ)) :: LN)
    (hQQ : t.G NLogN.KIL.sQQ = .int (N : ℤ) :: LQ)
    (hX : t.G rX = .int ((AModel.vol (P :: L :: A) : ℕ) : ℤ) :: LX)
    (hB : t.G NLogN.KIL.rVB = .int ((AModel.vol B : ℕ) : ℤ) :: LB)
    (hC : t.G NLogN.KIL.rVC = .int ((AModel.vol Cs : ℕ) : ℤ) :: LC) :
    ∀ (Ts : List (NLogN.KIL.TSh m)) (xs : List ℤ), (∀ T ∈ Ts, NLogN.KIL.TOK T N Bb) →
      xs.length = AModel.vol (P :: L :: AModel.hdShape A B Cs m N) → NLogN.Bnd w xs → t.G 0 = NLogN.ints xs ++ R →
      NLogN.KFD.FSp (NLogN.KIL.stepsU m rX Ts) t
        (t.upd 0 (NLogN.ints (AModel.runArr ((AModel.hdLayout A B Cs m N).cons2 P L) 0 (Ts.map (·.eval N)) xs) ++ R))
        (NLogN.KFD.cStepsUF rX (AModel.vol (P :: L :: AModel.hdShape A B Cs m N)) w Bb Ts) 
  | [], xs, _, _, _, h0 => by
    have : t.upd 0 (NLogN.ints xs ++ R) = t := by rw [← h0, NLogN.IState.upd_self]
    simp only [List.map_nil, AModel.runArr, List.foldl_nil, this]
    exact (NLogN.KFD.FSp.skip t).mono (by simp [NLogN.KFD.cStepsUF])
  | T :: Ts, xs, hT, hlen, hb, h0 => by
    have h0n : (0 : Fin NLogN.HS) ≠ NLogN.KIL.sNQ ∧ (0 : Fin NLogN.HS) ≠ NLogN.KIL.sQQ ∧ (0 : Fin NLogN.HS) ≠ NLogN.KIL.rVB ∧
        (0 : Fin NLogN.HS) ≠ rVC := by decide
    have hX0 : (0 : Fin NLogN.HS) ≠ rX := fun h => by
      have := congrArg Fin.val h; simp at this; omega
    have S1 := NLogN.KFD.stepU_fspec A B Cs P L T rX hrX hpos t xs w Bb R (hT T List.mem_cons_self) hlen hb hV
      hQ2 h0 hNQ hQQ hX hB hC
    set ys := (T.eval N).arr ((AModel.hdLayout A B Cs m N).cons2 P L) 0 xs
    have hyl : ys.length = AModel.vol (P :: L :: AModel.hdShape A B Cs m N) := by
      simp only [ys, AModel.Step.arr, AModel.length_pull]
    have hyb : NLogN.Bnd w ys := NLogN.KIL.bnd_pull hb
    have S2 := stepsU_fspec_aux A B Cs P L rX hrX hpos w Bb R hV hQ2 (t := t.upd 0 (NLogN.ints ys ++ R))
      (by simpa [h0n.1.symm] using hNQ) (by simpa [h0n.2.1.symm] using hQQ)
      (by simpa [Ne.symm hX0] using hX) (by simpa [h0n.2.2.1.symm] using hB)
      (by simpa [h0n.2.2.2.symm] using hC) Ts ys (fun T' h' => hT T' (List.mem_cons_of_mem _ h'))
      hyl hyb (by simp)
    rw [NLogN.IState.upd_upd_same] at S2
    refine (S1.seq S2).mono ?_
    simp only [NLogN.KFD.cStepsUF]; omega

theorem NLogN.KFD.stepsU_fspec {N : ℕ} [NeZero N] (A B Cs : AModel.Shape) (P L : ℕ) (rX : Fin NLogN.HS)
    (hrX : 38 ≤ rX.val ∧ rX.val < 56)
    (hpos : ∀ a ∈ P :: L :: AModel.hdShape A B Cs m N, 1 ≤ a) (w Bb : ℕ) (R : List NLogN.Item)
    (hV : NLogN.zsz ((AModel.vol (P :: L :: AModel.hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : NLogN.zsz ((2 * N : ℕ) : ℤ) ≤ Bb)
    {LN LQ LX LB LC : List NLogN.Item} (t : NLogN.IState NLogN.HS) (hNQ : t.G NLogN.KIL.sNQ = .int (-(N : ℤ)) :: LN)
    (hQQ : t.G NLogN.KIL.sQQ = .int (N : ℤ) :: LQ)
    (hX : t.G rX = .int ((AModel.vol (P :: L :: A) : ℕ) : ℤ) :: LX)
    (hB : t.G NLogN.KIL.rVB = .int ((AModel.vol B : ℕ) : ℤ) :: LB)
    (hC : t.G NLogN.KIL.rVC = .int ((AModel.vol Cs : ℕ) : ℤ) :: LC) :
    ∀ (Ts : List (NLogN.KIL.TSh m)) (xs : List ℤ), (∀ T ∈ Ts, NLogN.KIL.TOK T N Bb) →
      xs.length = AModel.vol (P :: L :: AModel.hdShape A B Cs m N) → NLogN.Bnd w xs → t.G 0 = NLogN.ints xs ++ R →
      NLogN.KFD.FSp (NLogN.KIL.stepsU m rX Ts) t
        (t.upd 0 (NLogN.ints (AModel.runArr ((AModel.hdLayout A B Cs m N).cons2 P L) 0 (Ts.map (·.eval N)) xs) ++ R))
        (NLogN.KFD.cStepsUF rX (AModel.vol (P :: L :: AModel.hdShape A B Cs m N)) w Bb Ts) := by
  first
  | exact stepsU_fspec_aux
  | (intros; apply stepsU_fspec_aux <;> assumption)
end
