-- Source module: Solutions.ButterflyLayer
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Butterfly

open AModel Matrix Finset

variable {sh : Shape} {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

variable (Sb : SelBits sh ι)

/-- Composition of selected-bit operators is the matrix product. -/
theorem selOp_mul (T U : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    selOp Sb T (selOp Sb U xs) = selOp Sb (T * U) xs := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_selOp] at h₁
  have hv := valid_decode h₁
  rw [getElem_selOp, getElem_selOp]
  simp_rw [getD_selOp_encode Sb U xs (Sb.valid_set _ _ hv), Sb.bits_set _ _ hv,
    Sb.set_set _ _ _ hv, Finset.smul_sum, smul_smul, Matrix.mul_apply, Finset.sum_smul]
  exact Finset.sum_comm

theorem selOp_smul (c : ℂ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    selOp Sb (c • T) xs = (selOp Sb T xs).map (c • ·) := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [List.getElem_map, getElem_selOp, Matrix.smul_apply, smul_eq_mul, mul_smul,
    Finset.smul_sum]

/-- (18) on arrays: `H0^{⊗D} z = b^D • S_D C^{⊗D} S_D z`. -/
theorem butterflyLayer_eq (xs : List M) :
    butterflyLayer Sb xs =
      (phaseLayer Sb (Butterfly.cLayer Sb (phaseLayer Sb xs))).map ((Butterfly.cb ^ Fintype.card ι) • ·) := by
  rw [butterflyLayer, tens_H0, selOp_smul, phaseLayer, Butterfly.cLayer, phaseLayer, selOp_mul, selOp_mul]

/-- Disk arrays go to disk arrays (every row of `H0^{⊗D}` has absolute row sum one). -/
theorem butterflyLayer_norm_le {N : Type*} [SeminormedAddCommGroup N] [NormedSpace ℂ N]
    (Sb : SelBits sh ι) (xs : List N) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∀ j (h : j < (butterflyLayer Sb xs).length), ‖(butterflyLayer Sb xs)[j]‖ ≤ 1 := by
  intro j h
  rw [show (butterflyLayer Sb xs)[j] = _ from getElem_selOp Sb (Butterfly.tens H0) xs j h]
  have hg : ∀ k, ‖xs.getD k 0‖ ≤ 1 := by
    intro k
    by_cases hk : k < xs.length
    · rw [List.getD_eq_getElem _ _ hk]; exact hxs k hk
    · rw [List.getD_eq_default _ _ (by omega)]; simp
  calc ‖∑ y, (Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y •
          xs.getD (encode sh (Sb.set (decode sh j) y)) 0‖
      ≤ ∑ y, ‖(Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y •
          xs.getD (encode sh (Sb.set (decode sh j) y)) 0‖ := norm_sum_le _ _
    _ ≤ ∑ y, ‖(Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y‖ := by
        apply Finset.sum_le_sum; intro y _
        rw [norm_smul]
        exact mul_le_of_le_one_right (norm_nonneg _) (hg _)
    _ = 1 := tens_H0_row_sum _

section BitArith

end BitArith

section Layout

variable (P K D S ρ : ℕ)

/-- (18) for the concrete layout. -/
theorem layerH_eq (hρ : ρ < K) (xs : List M) :
    layerH P K D S ρ hρ xs =
      (phaseLayer (layerSel P K D S ρ hρ) (Butterfly.cLayer (layerSel P K D S ρ hρ)
        (phaseLayer (layerSel P K D S ρ hρ) xs))).map (((-Complex.I / 2) ^ (D / 2) * Butterfly.cb ^ (D % 2)) • ·) := by
  rw [layerH, butterflyLayer_eq, Fintype.card_fin, cb_pow]

end Layout

end Butterfly

