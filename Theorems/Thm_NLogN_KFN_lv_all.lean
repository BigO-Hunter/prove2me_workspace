set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

section Ind

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {K : ℕ}
variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}

/-- **The leaf level.** -/
theorem lv_zero (hr : 1 ≤ r) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) :
    Lv Isym iprog K W m r Z Ψ 0 1 2 2 100000 := by
  intro pos t S0 B hinj hpos _ hS hB hdvd hZ
  set eqv : Fin 1 ≃ Fin (m ^ 0) := finCongr (pow_zero m).symm
  have hZ12 : zsz ((12 * (B * 2 ^ t * S0 * r)) : ℕ) ≤ Z :=
    le_trans (zsz_nat_le (by omega)) hZ
  have H := sImpl_leaf (pos ∘ eqv) t S0 B (hpos _) hS hB hr Z hZ12
  refine ⟨_, 1, 2, _, sImpl_equiv eqv (fun i => 2 ^ pos i * S0) Cm
    (H.toI (fok_kerP _ _ _ _ _ _ _ _)),
    le_rfl, le_rfl, fun w => ?_⟩
  have hn := one_le_nR (t := t) hS hB
  have hΨ := hZΨ (w + 2)
  have q : ck (B * 2 ^ t * S0 * r) Z w ≤ 100000 * (B * 2 ^ t * S0) * Xf r Ψ (w + 2) := by
    unfold ck Xf
    have e : w + 2 + 1 = w + 3 := by ring
    rw [e]
    have h1 : 30000 * (Z + 2) ≤ 100000 * (B * 2 ^ t * S0) * Ψ (w + 2) := by
      have : 1 ≤ B * 2 ^ t * S0 := hn
      nlinarith
    nlinarith
  exact_mod_cast q

end Ind

end NLogN.KFN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFN
open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly
variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {K : ℕ}
variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}
theorem lv_all_aux (hGc : NLogN.KFN.GClass J A) (hrow : NLogN.KFN.RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) :
    ∀ k, NLogN.KFN.Lv Isym iprog K W m r Z Ψ k (NLogN.KFN.Eb J.net.length s k) (NLogN.KFN.DWb J.net.length s W A k)
      (NLogN.KFN.Whb J.net.length s W A k) (NLogN.KFN.cb J.net.length s W A m CR τ k) ∧
      0 ≤ NLogN.KFN.cb J.net.length s W A m CR τ k 
  | 0 => ⟨NLogN.KFN.lv_zero hr hZΨ, by simp [NLogN.KFN.cb]⟩
  | k + 1 => by
    obtain ⟨IH, hc⟩ := lv_all_aux hGc hrow hCR hτ hW hr hΨm hZΨ k
    refine ⟨NLogN.KFN.lv_succ J hGc hrow hCR hτ hW hr hΨm hZΨ hc IH, ?_⟩
    simp only [NLogN.KFN.cb]
    have : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ := mul_nonneg hCR (by positivity)
    positivity

theorem NLogN.KFN.lv_all (hGc : NLogN.KFN.GClass J A) (hrow : NLogN.KFN.RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) :
    ∀ k, NLogN.KFN.Lv Isym iprog K W m r Z Ψ k (NLogN.KFN.Eb J.net.length s k) (NLogN.KFN.DWb J.net.length s W A k)
      (NLogN.KFN.Whb J.net.length s W A k) (NLogN.KFN.cb J.net.length s W A m CR τ k) ∧
      0 ≤ NLogN.KFN.cb J.net.length s W A m CR τ k := by
  first
  | exact lv_all_aux
  | (intros; apply lv_all_aux <;> assumption)
end
