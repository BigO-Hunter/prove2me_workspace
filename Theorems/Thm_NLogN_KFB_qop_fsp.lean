  | (c, r) :: l, h => ⟨tmE_ok c (h (c, r) List.mem_cons_self),
      lcE_ok l fun t ht => h t (List.mem_cons_of_mem _ ht)⟩

/-- Absolute value bound of a sum of `n` terms each of size `≤ w`. -/
theorem natAbs_sum_le {w : ℕ} (s : IState HS) : ∀ (l : List (ℤ × Fin HS)),
    (∀ t ∈ l, t.1.natAbs ≤ 1) → (∀ t ∈ l, zsz (s.top t.2) ≤ w) →
    ((l.map fun t => t.1 * s.top t.2).sum).natAbs ≤ l.length * (2 ^ w - 1)
  | [], _, _ => by simp
  | (c, r) :: l, h1, h2 => by
    simp only [List.map_cons, List.sum_cons, List.length_cons]
    have ih := natAbs_sum_le s l (fun t ht => h1 t (List.mem_cons_of_mem _ ht))
      (fun t ht => h2 t (List.mem_cons_of_mem _ ht))
    have hc := h1 (c, r) List.mem_cons_self
    have hr : (s.top r).natAbs < 2 ^ w := zsz_le_iff.1 (h2 (c, r) List.mem_cons_self)
    have hm : (c * s.top r).natAbs ≤ 2 ^ w - 1 := by
      rw [Int.natAbs_mul]
      have : c.natAbs * (s.top r).natAbs ≤ 1 * (s.top r).natAbs := Nat.mul_le_mul_right _ hc
      omega
    have := Int.natAbs_add_le (c * s.top r) ((l.map fun t => t.1 * s.top t.2).sum)
    nlinarith

theorem tmE_bnd {s : IState HS} {c : ℤ} {r : Fin HS} {B : ℕ} (h : zsz (s.top r) ≤ B) :
    (tmE c r).Bnd s B := by
  unfold tmE; split_ifs
  · exact h
  · exact h
  · simp [Ex.Bnd, zsz_zero]

theorem lcE_bnd {w e : ℕ} (s : IState HS) : ∀ (l : List (ℤ × Fin HS)), l.length ≤ 2 ^ e →
    (∀ t ∈ l, t.1.natAbs ≤ 1) → (∀ t ∈ l, zsz (s.top t.2) ≤ w) → (lcE l).Bnd s (w + e)
  | [], _, _, _ => by simp [lcE, Ex.Bnd, zsz_zero]
  | (c, r) :: l, hl, h1, h2 => by
    have hl' : l.length ≤ 2 ^ e := by simp at hl; omega
    have ih := lcE_bnd s l hl' (fun t ht => h1 t (List.mem_cons_of_mem _ ht))
      (fun t ht => h2 t (List.mem_cons_of_mem _ ht))
    refine ⟨tmE_bnd ((h2 (c, r) List.mem_cons_self).trans (Nat.le_add_right _ _)), ih, ?_⟩
    have hs := lcE_eval s ((c, r) :: l) h1
    simp only [lcE, Ex.eval] at hs
    rw [hs]
    have hb := natAbs_sum_le s ((c, r) :: l) h1 h2
    apply zsz_le_of_lt
    have hw : 1 ≤ 2 ^ w := Nat.one_le_two_pow
    calc _ ≤ ((c, r) :: l).length * (2 ^ w - 1) := hb
      _ < 2 ^ e * 2 ^ w := by
        have : ((c, r) :: l).length * (2 ^ w - 1) ≤ 2 ^ e * (2 ^ w - 1) := Nat.mul_le_mul_right _ hl
        have h3 : 2 ^ e * (2 ^ w - 1) < 2 ^ e * 2 ^ w :=
          Nat.mul_lt_mul_of_pos_left (by omega) (Nat.two_pow_pos e)
        omega
      _ = 2 ^ (w + e) := by rw [pow_add, mul_comm]

theorem cLp_self (N c : ℕ) : cLp N c (zsz (N : ℤ)) ≤ N * (c + 2100) + 2000 := by
  unfold cLp
  have := KFE.zsz_le_self N
  nlinarith

/-- Fine move of `N` entries, count in a register, overhead `O(N)`. -/
theorem FSp.mvN {X Y C r : Fin HS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (hX5 : X.val < 56)
    (hY5 : Y.val < 56) (hC5 : C.val < 56) (hr5 : r.val < 56) (s : IState HS)
