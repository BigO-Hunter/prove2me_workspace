    have s3 := Sp.push s g2 (i := Xr) (e := .reg qT) (B := w) h6 (clean_reg (by decide))
      (ok_reg g2T) trivial (bnd_reg g2T hz.1)
    rw [eval_reg g2T] at s3
    set g3 := Function.update g2 Xr (z.1 :: g2 Xr)
    have g3T : g3 qT = z.1 :: ((gflat (zs.take j)).reverse ++ t) := by
      simp only [g3, Function.update_apply, if_neg (Ne.symm h1)]; exact g2T
    have s4 := Sp.pop s g3 (i := qT) (B := w) (by decide) g3T hz.1
    refine (FSp.of_norep rfl (s1.seq (s2.seq (s3.seq s4)))).mono ?_ |>.congr ?_
    · simp only [Ex.size, cD]; omega
    · congr 1
      have hd : zs.drop j = z :: zs.drop (j + 1) := List.drop_eq_getElem_cons hjn
      funext x
      simp only [g3, g2, g1, g, F, Function.update_apply, hj, hk1, hd]
      by_cases e1 : x = Xi
      · subst e1; simp [h2, h3.symm, h5, Ne.symm h3]
      by_cases e2 : x = Xr
      · subst e2; simp [h1, h4, e1]
      by_cases e3 : x = qT
      · subst e3; simp [e1, e2, show qT ≠ NLogN.KFB.c1 by decide]
      simp [e1, e2, e3]

theorem push_lcE (s : IState HS) (f : Fin HS → List ℤ) {Y : Fin HS} (hY : Y.val < 56)
    (l : List (ℤ × Fin HS)) (w e : ℕ) (hl : ∀ t ∈ l, t.2.val < 56) (hc : ∀ t ∈ l, t.1.natAbs ≤ 1)
    (hv : ∀ t ∈ l, ∃ a r, f t.2 = a :: r ∧ zsz a ≤ w) (hle : l.length ≤ 2 ^ e) :
    Sp (.push Y (lcE l)) (encK s f)
      (encK s (Function.update f Y ((l.map fun t => t.1 * (f t.2).headD 0).sum :: f Y)))
      ((3 * l.length + 2) * 2000 * (w + e + 2)) := by
  have htop : ∀ t ∈ l, (encK s f).top t.2 = (f t.2).headD 0 := by
    intro t ht
    obtain ⟨a, r, h1, -⟩ := hv t ht
    rw [top_encK h1, h1]; rfl
  have H := Sp.push s f (i := Y) (e := lcE l) (B := w + e) hY (lcE_clean l hl)
    (lcE_ok l fun t ht => by obtain ⟨a, r, h1, -⟩ := hv t ht; exact isInt_encK h1)
    (lcE_lin l) (lcE_bnd _ l hle hc fun t ht => by
      obtain ⟨a, r, h1, h2⟩ := hv t ht; rw [top_encK h1]; exact h2)
  rw [lcE_eval _ l hc] at H
  have e1 : (l.map fun t => t.1 * (encK s f).top t.2) = (l.map fun t => t.1 * (f t.2).headD 0) :=
    List.map_congr_left fun t ht => by rw [htop t ht]
  rw [e1] at H
  refine H.mono ?_
  have := lcE_size l
  have : (lcE l).size + 1 ≤ 3 * l.length + 2 := by omega
  exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ this)

theorem reT_sum (p q x y : GI) (f : Fin HS → List ℤ) (hur : (f rUr).headD 0 = x.1)
    (hui : (f rUi).headD 0 = x.2) (hvr : (f rVr).headD 0 = y.1) (hvi : (f rVi).headD 0 = y.2) :
    ((reT p q).map fun t => t.1 * (f t.2).headD 0).sum = (lin2 p q x y).1 := by
  simp only [reT, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hur, hui, hvr, hvi,
    lin2, gmul, Prod.fst_add]
  ring

theorem imT_sum (p q x y : GI) (f : Fin HS → List ℤ) (hur : (f rUr).headD 0 = x.1)
    (hui : (f rUi).headD 0 = x.2) (hvr : (f rVr).headD 0 = y.1) (hvi : (f rVi).headD 0 = y.2) :
    ((imT p q).map fun t => t.1 * (f t.2).headD 0).sum = (lin2 p q x y).2 := by
  simp only [imT, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hur, hui, hvr, hvi,
    lin2, gmul, Prod.snd_add]
  ring

theorem hv4 {g : Fin HS → List ℤ} {w : ℕ} (h1 : ∃ a r, g rUr = a :: r ∧ zsz a ≤ w)
    (h2 : ∃ a r, g rUi = a :: r ∧ zsz a ≤ w) (h3 : ∃ a r, g rVr = a :: r ∧ zsz a ≤ w)
    (h4 : ∃ a r, g rVi = a :: r ∧ zsz a ≤ w) (p q : GI) :
    (∀ t ∈ reT p q, ∃ a r, g t.2 = a :: r ∧ zsz a ≤ w) ∧
      (∀ t ∈ imT p q, ∃ a r, g t.2 = a :: r ∧ zsz a ≤ w) := by
  constructor <;> intro t ht <;>
    simp only [reT, imT, List.mem_cons, List.not_mem_nil, or_false] at ht <;>
    rcases ht with rfl | rfl | rfl | rfl <;> assumption

theorem regs_reT (p q : GI) : ∀ t ∈ reT p q, t.2.val < 56 := by
  intro t ht; simp only [reT, List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl <;> dsimp only <;> decide

theorem regs_imT (p q : GI) : ∀ t ∈ imT p q, t.2.val < 56 := by
  intro t ht; simp only [imT, List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl <;> dsimp only <;> decide

theorem co_reT {p q : GI} (hp : NLogN.KFB.Sm p) (hq : NLogN.KFB.Sm q) : ∀ t ∈ reT p q, t.1.natAbs ≤ 1 := by
  intro t ht; simp only [reT, List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl
  · exact hp.1
  · simpa using hp.2
  · exact hq.1
  · simpa using hq.2

theorem co_imT {p q : GI} (hp : NLogN.KFB.Sm p) (hq : NLogN.KFB.Sm q) : ∀ t ∈ imT p q, t.1.natAbs ≤ 1 := by
  intro t ht; simp only [imT, List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl
  · exact hp.2
  · exact hp.1
  · exact hq.2
  · exact hq.1

theorem length_reT (p q : GI) : (reT p q).length = 4 := rfl
theorem length_imT (p q : GI) : (imT p q).length = 4 := rfl

/-- The zip loop. -/
theorem zipR_fsp (M : M2G) (hM : M.Ok) (s : IState HS) (f : Fin HS → List ℤ) (u v : List GI)
    (lur lui lvr lvi A0 O0 : List ℤ) (w : ℕ) (huv : u.length = v.length)
    (hur : f rUr = u.map Prod.fst ++ lur) (hui : f rUi = u.map Prod.snd ++ lui)
    (hvr : f rVr = v.map Prod.fst ++ lvr) (hvi : f rVi = v.map Prod.snd ++ lvi)
    (hA : f qA = A0) (hO : f qO = O0) (hC : f NLogN.KFB.c1 = []) {Lr : List Item}
    (hr : (encK s f).G NLogN.KFB.rB = .int (u.length : ℤ) :: Lr) (hbu : NLogN.KFB.GB w u) (hbv : NLogN.KFB.GB w v) :
    FSp (zipR M) (encK s f)
      (encK s (Function.update (Function.update (Function.update (Function.update
        (Function.update (Function.update f rUr lur) rUi lui) rVr lvr) rVi lvi)
        qA ((gflat (List.zipWith (lin2 M.a M.b) u v)).reverse ++ A0))
        qO ((gflat (List.zipWith (lin2 M.c M.d) u v)).reverse ++ O0)))
      (u.length * (NLogN.KFB.cZ w + 2100) + 2000) := by
  obtain ⟨n, hn⟩ : ∃ n, n = u.length := ⟨_, rfl⟩
  rw [← hn] at hr ⊢
  have hvn : v.length = n := by omega
  set o0 := List.zipWith (lin2 M.a M.b) u v with ho0
  set o1 := List.zipWith (lin2 M.c M.d) u v with ho1
  have ho0l : o0.length = n := by simp [o0, huv, hn]
  have ho1l : o1.length = n := by simp [o1, huv, hn]
  let F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update (Function.update
    (Function.update (Function.update (Function.update f rUr ((u.drop k).map Prod.fst ++ lur))
      rUi ((u.drop k).map Prod.snd ++ lui)) rVr ((v.drop k).map Prod.fst ++ lvr))
      rVi ((v.drop k).map Prod.snd ++ lvi))
      qA ((gflat (o0.take k)).reverse ++ A0)) qO ((gflat (o1.take k)).reverse ++ O0)
  have F0 : F 0 = f := by
    funext j
    simp only [F, List.drop_zero, List.take_zero, gflat_nil, List.reverse_nil, List.nil_append,
      Function.update_apply]
    split_ifs with e1 e2 e3 e4 e5 e6 <;> (try subst e1) <;> (try subst e2) <;> (try subst e3) <;>
      (try subst e4) <;> (try subst e5) <;> (try subst e6) <;> simp_all
  have hFC : ∀ k, F k NLogN.KFB.c1 = [] := fun k => by
    simp +decide [F, Function.update_apply, hC]
  have H := FSp.repReg (C := NLogN.KFB.c1) (r := NLogN.KFB.rB) (s := s) (F := F) (N := n) (Bb := zsz (n : ℤ))
    (c := NLogN.KFB.cZ w) (b := zb M) (by decide) (by decide) hFC
    (by simp +decide [zb, RS.writes]) (L := Lr) (by rw [F0]; exact hr) le_rfl ?_
  · rw [F0] at H
    refine (H.mono (cLp_self n (NLogN.KFB.cZ w))).congr ?_
    congr 1
    funext j
    have h1 : u.drop n = [] := List.drop_of_length_le (by omega)
    have h2 : v.drop n = [] := List.drop_of_length_le (by omega)
    have h3 : o0.take n = o0 := List.take_of_length_le (by omega)
    have h4 : o1.take n = o1 := List.take_of_length_le (by omega)
    simp only [F, h1, h2, h3, h4, List.map_nil, List.nil_append]
  · intro k hk
    have hku : k < u.length := by omega
    have hkv : k < v.length := by omega
    have hk0 : k < o0.length := by omega
    have hk1 : k < o1.length := by omega
    set x := u[k]
    set y := v[k]
    have hx := hbu x (List.getElem_mem hku)
    have hy := hbv y (List.getElem_mem hkv)
    have hdu : u.drop k = x :: u.drop (k + 1) := List.drop_eq_getElem_cons hku
    have hdv : v.drop k = y :: v.drop (k + 1) := List.drop_eq_getElem_cons hkv
    have ho0k : o0[k] = lin2 M.a M.b x y := by simp [o0]; rfl
    have ho1k : o1[k] = lin2 M.c M.d x y := by simp [o1]; rfl
    set g := Function.update (F k) NLogN.KFB.c1 [(n : ℤ) - k]
    have gur : g rUr = x.1 :: ((u.drop (k + 1)).map Prod.fst ++ lur) := by
      simp +decide [g, F, Function.update_apply, -List.map_drop, hdu]
    have gui : g rUi = x.2 :: ((u.drop (k + 1)).map Prod.snd ++ lui) := by
      simp +decide [g, F, Function.update_apply, -List.map_drop, hdu]
    have gvr : g rVr = y.1 :: ((v.drop (k + 1)).map Prod.fst ++ lvr) := by
      simp +decide [g, F, Function.update_apply, -List.map_drop, hdv]
    have gvi : g rVi = y.2 :: ((v.drop (k + 1)).map Prod.snd ++ lvi) := by
      simp +decide [g, F, Function.update_apply, -List.map_drop, hdv]
    -- push 1
    have hv := hv4 (g := g) (w := w) ⟨_, _, gur, hx.1⟩ ⟨_, _, gui, hx.2⟩ ⟨_, _, gvr, hy.1⟩
      ⟨_, _, gvi, hy.2⟩ M.a M.b
    have p1 := push_lcE s g (Y := qA) (by decide) (reT M.a M.b) w 2 (regs_reT _ _)
      (co_reT hM.1 hM.2.1) hv.1 (by rw [length_reT]; norm_num)
    rw [reT_sum M.a M.b x y g (by rw [gur]; rfl) (by rw [gui]; rfl) (by rw [gvr]; rfl)
      (by rw [gvi]; rfl)] at p1
    set g1 := Function.update g qA ((lin2 M.a M.b x y).1 :: g qA)
    have g1ur : g1 rUr = g rUr := by simp +decide [g1, Function.update_apply]
    have g1ui : g1 rUi = g rUi := by simp +decide [g1, Function.update_apply]
    have g1vr : g1 rVr = g rVr := by simp +decide [g1, Function.update_apply]
    have g1vi : g1 rVi = g rVi := by simp +decide [g1, Function.update_apply]
    -- push 2
    have hv1 := hv4 (g := g1) (w := w) ⟨_, _, g1ur.trans gur, hx.1⟩ ⟨_, _, g1ui.trans gui, hx.2⟩
      ⟨_, _, g1vr.trans gvr, hy.1⟩ ⟨_, _, g1vi.trans gvi, hy.2⟩ M.a M.b
    have p2 := push_lcE s g1 (Y := qA) (by decide) (imT M.a M.b) w 2 (regs_imT _ _)
      (co_imT hM.1 hM.2.1) hv1.2 (by rw [length_imT]; norm_num)
    rw [imT_sum M.a M.b x y g1 (by rw [g1ur, gur]; rfl) (by rw [g1ui, gui]; rfl)
      (by rw [g1vr, gvr]; rfl) (by rw [g1vi, gvi]; rfl)] at p2
    set g2 := Function.update g1 qA ((lin2 M.a M.b x y).2 :: g1 qA)
    have g2ur : g2 rUr = g rUr := by simp +decide [g2, g1, Function.update_apply]
    have g2ui : g2 rUi = g rUi := by simp +decide [g2, g1, Function.update_apply]
    have g2vr : g2 rVr = g rVr := by simp +decide [g2, g1, Function.update_apply]
    have g2vi : g2 rVi = g rVi := by simp +decide [g2, g1, Function.update_apply]
    -- push 3
    have hv2 := hv4 (g := g2) (w := w) ⟨_, _, g2ur.trans gur, hx.1⟩ ⟨_, _, g2ui.trans gui, hx.2⟩
      ⟨_, _, g2vr.trans gvr, hy.1⟩ ⟨_, _, g2vi.trans gvi, hy.2⟩ M.c M.d
    have p3 := push_lcE s g2 (Y := qO) (by decide) (reT M.c M.d) w 2 (regs_reT _ _)
      (co_reT hM.2.2.1 hM.2.2.2) hv2.1 (by rw [length_reT]; norm_num)
    rw [reT_sum M.c M.d x y g2 (by rw [g2ur, gur]; rfl) (by rw [g2ui, gui]; rfl)
      (by rw [g2vr, gvr]; rfl) (by rw [g2vi, gvi]; rfl)] at p3
    set g3 := Function.update g2 qO ((lin2 M.c M.d x y).1 :: g2 qO)
    have g3ur : g3 rUr = g rUr := by simp +decide [g3, g2, g1, Function.update_apply]
    have g3ui : g3 rUi = g rUi := by simp +decide [g3, g2, g1, Function.update_apply]
    have g3vr : g3 rVr = g rVr := by simp +decide [g3, g2, g1, Function.update_apply]
    have g3vi : g3 rVi = g rVi := by simp +decide [g3, g2, g1, Function.update_apply]
    -- push 4
    have hv3 := hv4 (g := g3) (w := w) ⟨_, _, g3ur.trans gur, hx.1⟩ ⟨_, _, g3ui.trans gui, hx.2⟩
      ⟨_, _, g3vr.trans gvr, hy.1⟩ ⟨_, _, g3vi.trans gvi, hy.2⟩ M.c M.d
    have p4 := push_lcE s g3 (Y := qO) (by decide) (imT M.c M.d) w 2 (regs_imT _ _)
      (co_imT hM.2.2.1 hM.2.2.2) hv3.2 (by rw [length_imT]; norm_num)
    rw [imT_sum M.c M.d x y g3 (by rw [g3ur, gur]; rfl) (by rw [g3ui, gui]; rfl)
      (by rw [g3vr, gvr]; rfl) (by rw [g3vi, gvi]; rfl)] at p4
    set g4 := Function.update g3 qO ((lin2 M.c M.d x y).2 :: g3 qO)
    -- pops
    have g4ur : g4 rUr = x.1 :: ((u.drop (k + 1)).map Prod.fst ++ lur) := by
      rw [← gur]; simp +decide [g4, g3, g2, g1, Function.update_apply]
    have q1 := Sp.pop s g4 (i := rUr) (B := w) (by decide) g4ur hx.1
    set g5 := Function.update g4 rUr ((u.drop (k + 1)).map Prod.fst ++ lur)
    have g5ui : g5 rUi = x.2 :: ((u.drop (k + 1)).map Prod.snd ++ lui) := by
      rw [← gui]; simp +decide [g5, g4, g3, g2, g1, Function.update_apply]
    have q2 := Sp.pop s g5 (i := rUi) (B := w) (by decide) g5ui hx.2
    set g6 := Function.update g5 rUi ((u.drop (k + 1)).map Prod.snd ++ lui)
    have g6vr : g6 rVr = y.1 :: ((v.drop (k + 1)).map Prod.fst ++ lvr) := by
      rw [← gvr]; simp +decide [g6, g5, g4, g3, g2, g1, Function.update_apply]
    have q3 := Sp.pop s g6 (i := rVr) (B := w) (by decide) g6vr hy.1
    set g7 := Function.update g6 rVr ((v.drop (k + 1)).map Prod.fst ++ lvr)
    have g7vi : g7 rVi = y.2 :: ((v.drop (k + 1)).map Prod.snd ++ lvi) := by
      rw [← gvi]; simp +decide [g7, g6, g5, g4, g3, g2, g1, Function.update_apply]
    have q4 := Sp.pop s g7 (i := rVi) (B := w) (by decide) g7vi hy.2
    refine (FSp.of_norep rfl (p1.seq (p2.seq (p3.seq (p4.seq (q1.seq (q2.seq (q3.seq q4))))))))
      |>.mono ?_ |>.congr ?_
    · simp only [NLogN.KFB.cZ, length_reT, length_imT]; omega
    · congr 1
      have t0 : (gflat (o0.take (k + 1))).reverse = (lin2 M.a M.b x y).2 :: (lin2 M.a M.b x y).1 ::
          (gflat (o0.take k)).reverse := by rw [gflat_take_succ_rev o0 hk0, ho0k]
      have t1 : (gflat (o1.take (k + 1))).reverse = (lin2 M.c M.d x y).2 :: (lin2 M.c M.d x y).1 ::
          (gflat (o1.take k)).reverse := by rw [gflat_take_succ_rev o1 hk1, ho1k]
      funext j
      simp only [g7, g6, g5, g4, g3, g2, g1, g, F, Function.update_apply, t0, t1]
      by_cases e1 : j = rVi
      · subst e1; simp +decide
      by_cases e2 : j = rVr
      · subst e2; simp +decide
      by_cases e3 : j = rUi
      · subst e3; simp +decide
      by_cases e4 : j = rUr
      · subst e4; simp +decide
      by_cases e5 : j = qO
      · subst e5; simp +decide
      by_cases e6 : j = qA
      · subst e6; simp +decide
      simp [e1, e2, e3, e4, e5, e6]

theorem length_pairOut (M : M2G) {u v : List GI} (h : u.length = v.length) :
    (pairOut M u v).length = 2 * u.length := by
  simp [pairOut, h]; ring

theorem lin2_bnd {p q x y : GI} {w : ℕ} (hp : NLogN.KFB.Sm p) (hq : NLogN.KFB.Sm q) (hx : zsz x.1 ≤ w ∧ zsz x.2 ≤ w)
    (hy : zsz y.1 ≤ w ∧ zsz y.2 ≤ w) :
    zsz (lin2 p q x y).1 ≤ w + 2 ∧ zsz (lin2 p q x y).2 ≤ w + 2 := by
  have b : ∀ (c a : ℤ), c.natAbs ≤ 1 → zsz a ≤ w → (c * a).natAbs ≤ 2 ^ w - 1 := by
    intro c a hc ha
    have := zsz_le_iff.1 ha
    rw [Int.natAbs_mul]
    have : c.natAbs * a.natAbs ≤ 1 * a.natAbs := Nat.mul_le_mul_right _ hc
    omega
  have hw : 1 ≤ 2 ^ w := Nat.one_le_two_pow
  have h4 : 4 * (2 ^ w - 1) < 2 ^ (w + 2) := by rw [pow_add]; omega
  constructor
  · apply zsz_le_of_lt
    simp only [lin2, gmul, Prod.fst_add]
    have e1 := b p.1 x.1 hp.1 hx.1; have e2 := b p.2 x.2 hp.2 hx.2
    have e3 := b q.1 y.1 hq.1 hy.1; have e4 := b q.2 y.2 hq.2 hy.2
    have := Int.natAbs_add_le (p.1 * x.1 - p.2 * x.2) (q.1 * y.1 - q.2 * y.2)
    have := Int.natAbs_sub_le (p.1 * x.1) (p.2 * x.2)
    have := Int.natAbs_sub_le (q.1 * y.1) (q.2 * y.2)
    omega
  · apply zsz_le_of_lt
    simp only [lin2, gmul, Prod.snd_add]
    have e1 := b p.2 x.1 hp.2 hx.1; have e2 := b p.1 x.2 hp.1 hx.2
    have e3 := b q.2 y.1 hq.2 hy.1; have e4 := b q.1 y.2 hq.1 hy.2
    have := Int.natAbs_add_le (p.2 * x.1 + p.1 * x.2) (q.2 * y.1 + q.1 * y.2)
    have := Int.natAbs_add_le (p.2 * x.1) (p.1 * x.2)
    have := Int.natAbs_add_le (q.2 * y.1) (q.1 * y.2)
    omega

theorem GB_zipWith {p q : GI} {w : ℕ} (hp : NLogN.KFB.Sm p) (hq : NLogN.KFB.Sm q) {u v : List GI} (hu : NLogN.KFB.GB w u)
    (hv : NLogN.KFB.GB w v) : NLogN.KFB.GB (w + 2) (List.zipWith (lin2 p q) u v) := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hi1 : i < u.length := by simp at hi; omega
  have hi2 : i < v.length := by simp at hi; omega
  rw [List.getElem_zipWith]
  exact lin2_bnd hp hq (hu _ (List.getElem_mem hi1)) (hv _ (List.getElem_mem hi2))

theorem GB_pairOut {M : M2G} (hM : M.Ok) {w : ℕ} {u v : List GI} (hu : NLogN.KFB.GB w u) (hv : NLogN.KFB.GB w v) :
    NLogN.KFB.GB (w + 2) (pairOut M u v) := by
  intro z hz
  rcases List.mem_append.1 hz with h | h
  · exact GB_zipWith hM.1 hM.2.1 hu hv z h
  · exact GB_zipWith hM.2.2.1 hM.2.2.2 hu hv z h

theorem blk_fsp (M : M2G) (hM : M.Ok) (s : IState HS) (f : Fin HS → List ℤ) (u v : List GI)
    (l : List ℤ) (w B1 : ℕ) (hu : u.length = B1) (hv : v.length = B1)
    (h0 : f 0 = gflat (u ++ v) ++ l) (hS : Scr f) (hc : Cnt s f B1) (hbu : NLogN.KFB.GB w u) (hbv : NLogN.KFB.GB w v) :
    FSp (NLogN.KFB.blk M) (encK s f)
      (encK s (Function.update (Function.update f 0 l) qA ((gflat (pairOut M u v)).reverse ++ f qA)))
      (NLogN.KFB.cBlk w B1) := by
  obtain ⟨L4, h4⟩ := hc.b4
  -- 1. block to qT
  have m1 := FSp.mvN (X := 0) (Y := qT) (C := NLogN.KFB.c1) (r := rB4) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f (gflat (u ++ v)) l h0 (Lr := L4)
    (by rw [h4]; congr 2; simp [hu, hv]; ring) w (GB.bnd (fun z hz => by
      rcases List.mem_append.1 hz with h | h
      · exact hbu z h
      · exact hbv z h))
  set f1 := Function.update (Function.update f 0 l) qT ((gflat (u ++ v)).reverse ++ f qT)
  have c1' : Cnt s f1 B1 := hc.congr (by simp +decide [f1]) (by simp +decide [f1])
    (by simp +decide [f1])
  -- 2. distribute v
  obtain ⟨Lb, hb⟩ := c1'.b
  have m2 := distB_fsp (Xr := rVr) (Xi := rVi) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s f1 v ((gflat u).reverse) w
    (by simp [f1, hS.t, gflat_append]) (by simp +decide [f1, hS.c]) (Lr := Lb)
    (by rw [hb, hv]) hbv
  set f2 := Function.update (Function.update (Function.update f1 qT (gflat u).reverse) rVr
    (v.map Prod.fst ++ f1 rVr)) rVi (v.map Prod.snd ++ f1 rVi)
  -- 3. distribute u
  have c2' : Cnt s f2 B1 := c1'.congr (by simp +decide [f2]) (by simp +decide [f2])
    (by simp +decide [f2])
  obtain ⟨Lb2, hb2⟩ := c2'.b
  have m3 := distB_fsp (Xr := rUr) (Xi := rUi) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s f2 u [] w
    (by simp +decide [f2]) (by simp +decide [f2, f1, hS.c]) (Lr := Lb2)
    (by rw [hb2, hu]) hbu
  set f3 := Function.update (Function.update (Function.update f2 qT []) rUr
    (u.map Prod.fst ++ f2 rUr)) rUi (u.map Prod.snd ++ f2 rUi)
  -- 4. zip
  have c3' : Cnt s f3 B1 := c2'.congr (by simp +decide [f3]) (by simp +decide [f3])
    (by simp +decide [f3])
  obtain ⟨Lb3, hb3⟩ := c3'.b
  have m4 := zipR_fsp M hM s f3 u v [] [] [] [] (f qA) [] w (by omega)
    (by simp +decide [f3, f2, f1, hS.ur]) (by simp +decide [f3, f2, f1, hS.ui])
    (by simp +decide [f3, f2, f1, hS.vr]) (by simp +decide [f3, f2, f1, hS.vi])
    (by simp +decide [f3, f2, f1]) (by simp +decide [f3, f2, f1, hS.o])
    (by simp +decide [f3, f2, f1, hS.c]) (Lr := Lb3) (by rw [hb3, hu]) hbu hbv
  set o0 := List.zipWith (lin2 M.a M.b) u v
  set o1 := List.zipWith (lin2 M.c M.d) u v
  set f4 := Function.update (Function.update (Function.update (Function.update
    (Function.update (Function.update f3 rUr []) rUi []) rVr []) rVi [])
    qA ((gflat o0).reverse ++ f qA)) qO ((gflat o1).reverse ++ [])
  have ho1 : o1.length = B1 := by simp [o1, hu, hv]
  have hbo1 : NLogN.KFB.GB (w + 2) o1 := GB_zipWith hM.2.2.1 hM.2.2.2 hbu hbv
  -- 5. qO → qT
  have c4' : Cnt s f4 B1 := c3'.congr (by simp +decide [f4]) (by simp +decide [f4])
    (by simp +decide [f4])
  obtain ⟨L2, h2⟩ := c4'.b2
  have m5 := FSp.mvN (X := qO) (Y := qT) (C := NLogN.KFB.c1) (r := rB2) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f4 ((gflat o1).reverse) []
    (by simp +decide [f4]) (Lr := L2) (by rw [h2]; simp [ho1]) (w + 2)
    (NLogN.KIL.bnd_reverse (GB.bnd hbo1))
  set f5 := Function.update (Function.update f4 qO []) qT ((gflat o1).reverse.reverse ++ f4 qT)
  -- 6. qT → qA
  have c5' : Cnt s f5 B1 := c4'.congr (by simp +decide [f5]) (by simp +decide [f5])
    (by simp +decide [f5])
  obtain ⟨L2', h2'⟩ := c5'.b2
  have m6 := FSp.mvN (X := qT) (Y := qA) (C := NLogN.KFB.c1) (r := rB2) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f5 (gflat o1) []
    (by simp +decide [f5, f4, f3, f2, f1]) (Lr := L2') (by rw [h2']; simp [ho1]) (w + 2)
    (GB.bnd hbo1)
  refine (m1.seq (m2.seq (m3.seq (m4.seq (m5.seq m6))))).mono ?_ |>.congr ?_
  · simp only [length_gflat, List.length_append, hu, hv, List.length_reverse, ho1, NLogN.KFB.cBlk, cD, NLogN.KFB.cZ]
    nlinarith
  · congr 1
    funext x
    simp only [f5, f4, f3, f2, f1, Function.update_apply]
    by_cases e1 : x = qA
    · subst e1; simp +decide [pairOut, gflat_append, o0, o1]
    by_cases e2 : x = qT
    · subst e2; simp +decide [hS.t]
    by_cases e3 : x = qO
    · subst e3; simp +decide [hS.o]
    by_cases e4 : x = rUr
    · subst e4; simp +decide [hS.ur]
    by_cases e5 : x = rUi
    · subst e5; simp +decide [hS.ui]
    by_cases e6 : x = rVr
    · subst e6; simp +decide [hS.vr]
    by_cases e7 : x = rVi
    · subst e7; simp +decide [hS.vi]
    by_cases e8 : x = 0
    · subst e8; simp +decide
    simp [e1, e2, e3, e4, e5, e6, e7, e8]

theorem GB_take {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (n : ℕ) : NLogN.KFB.GB w (zs.take n) :=
  h.sub fun _ hz => List.mem_of_mem_take hz

theorem GB_drop {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (n : ℕ) : NLogN.KFB.GB w (zs.drop n) :=
  h.sub fun _ hz => List.mem_of_mem_drop hz

theorem length_grpOut {B1 : ℕ} : ∀ (Ms : List M2G) (zs : List GI), 2 * B1 * Ms.length ≤ zs.length →
    (grpOut Ms B1 zs).length = 2 * B1 * Ms.length
  | [], _, _ => by simp [grpOut]
  | M :: Ms, zs, h => by
    simp only [List.length_cons] at h
    have hB : 2 * B1 ≤ zs.length := le_trans (by nlinarith) h
    have h1 : (zs.take B1).length = B1 := by simp; omega
    have h2 : ((zs.drop B1).take B1).length = B1 := by simp; omega
    rw [grpOut, List.length_append, length_pairOut M (by rw [h1, h2]), h1,
      length_grpOut Ms _ (by simp; rw [Nat.mul_add, mul_one] at h; omega), List.length_cons]
    ring

theorem GB_grpOut {w B1 : ℕ} : ∀ (Ms : List M2G), (∀ M ∈ Ms, M.Ok) → ∀ (zs : List GI), NLogN.KFB.GB w zs →
    NLogN.KFB.GB (w + 2) (grpOut Ms B1 zs)
  | [], _, _, _ => by intro z hz; simp [grpOut] at hz
  | M :: Ms, hM, zs, h => by
    intro z hz
    rw [grpOut] at hz
    rcases List.mem_append.1 hz with hz | hz
    · exact GB_pairOut (hM M List.mem_cons_self) (GB_take h _) (GB_take (GB_drop h _) _) z hz
    · exact GB_grpOut Ms (fun M' h' => hM M' (List.mem_cons_of_mem _ h')) _ (GB_drop h _) z hz

theorem blks_fsp (s : IState HS) (w B1 : ℕ) : ∀ (Ms : List M2G), (∀ M ∈ Ms, M.Ok) →
    ∀ (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ), 2 * B1 * Ms.length ≤ zs.length →
    f 0 = gflat zs ++ l → Scr f → Cnt s f B1 → NLogN.KFB.GB w zs →
    FSp (blks Ms) (encK s f)
      (encK s (Function.update (Function.update f 0 (gflat (zs.drop (2 * B1 * Ms.length)) ++ l))
        qA ((gflat (grpOut Ms B1 zs)).reverse ++ f qA)))
      (Ms.length * NLogN.KFB.cBlk w B1 + 1)
  | [], _, f, zs, l, _, h0, _, _, _ => by
    have e : Function.update (Function.update f 0 (gflat (zs.drop (2 * B1 * ([] : List M2G).length)) ++ l))
        qA ((gflat (grpOut [] B1 zs)).reverse ++ f qA) = f := by
      simp only [List.length_nil, mul_zero, List.drop_zero, grpOut, gflat_nil, List.reverse_nil,
        List.nil_append]
      rw [← h0, Function.update_eq_self, Function.update_eq_self]
    rw [e]
    exact (FSp.skip _).mono (by simp)
  | M :: Ms, hM, f, zs, l, hlen, h0, hS, hc, hb => by
    simp only [List.length_cons] at hlen
    set u := zs.take B1
    set v := (zs.drop B1).take B1
    set rest := zs.drop (2 * B1)
    have hB : 2 * B1 ≤ zs.length := le_trans (by nlinarith) hlen
    have hu : u.length = B1 := by simp [u]; omega
    have hv : v.length = B1 := by simp [v]; omega
    have e1 : (zs.drop B1).drop B1 = rest := by rw [List.drop_drop]; congr 1; ring
    have hz : zs = u ++ v ++ rest := by
      rw [List.append_assoc, ← e1, List.take_append_drop, List.take_append_drop]
    have h0' : f 0 = gflat (u ++ v) ++ (gflat rest ++ l) := by
      rw [h0, hz]; simp only [gflat_append, List.append_assoc]
    have B := blk_fsp M (hM M List.mem_cons_self) s f u v (gflat rest ++ l) w B1 hu hv h0' hS hc
      (GB_take hb _) (GB_take (GB_drop hb _) _)
    set f1 := Function.update (Function.update f 0 (gflat rest ++ l)) qA
      ((gflat (pairOut M u v)).reverse ++ f qA)
    have hS1 : Scr f1 := ⟨by simp +decide [f1, hS.t], by simp +decide [f1, hS.o],
      by simp +decide [f1, hS.ur], by simp +decide [f1, hS.ui], by simp +decide [f1, hS.vr],
      by simp +decide [f1, hS.vi], by simp +decide [f1, hS.c]⟩
    have hc1 : Cnt s f1 B1 := hc.congr (by simp +decide [f1]) (by simp +decide [f1])
      (by simp +decide [f1])
    have IH := blks_fsp s w B1 Ms (fun M' h' => hM M' (List.mem_cons_of_mem _ h')) f1 rest l
      (by simp [rest]; rw [Nat.mul_add, mul_one] at hlen; omega) (by simp +decide [f1]) hS1 hc1
      (GB_drop hb _)
    refine (B.seq IH).mono ?_ |>.congr ?_
    · simp only [List.length_cons]; ring_nf; omega
    · congr 1; funext x
      simp only [f1, Function.update_apply]
      by_cases e1 : x = qA
      · subst e1
        simp +decide [grpOut, u, v, rest, gflat_append, List.append_assoc]
      by_cases e2 : x = 0
      · subst e2
        simp +decide [rest, List.drop_drop, List.length_cons]
        congr 2; ring
      simp [e1, e2]

theorem qopL_succ (Ms : List M2G) (B1 G : ℕ) (zs : List GI) :
    qopL Ms B1 (G + 1) zs = qopL Ms B1 G zs ++ grpOut Ms B1 (zs.drop (G * (2 * B1 * Ms.length))) := by
  simp [qopL, List.range_succ, List.flatMap_append]

theorem length_qopL (Ms : List M2G) (B1 : ℕ) : ∀ (G : ℕ) (zs : List GI),
    G * (2 * B1 * Ms.length) ≤ zs.length → (qopL Ms B1 G zs).length = G * (2 * B1 * Ms.length)
  | 0, _, _ => by simp [qopL]
  | G + 1, zs, h => by
    rw [qopL_succ, List.length_append, length_qopL Ms B1 G zs (le_trans (by nlinarith) h)]
    rw [length_grpOut Ms _ (by simp; rw [Nat.succ_mul] at h; omega)]; ring

theorem blks_nw : ∀ Ms : List M2G, cG ∉ (blks Ms).writes
  | [] => by simp [blks, RS.writes]
  | M :: Ms => by
    have := blks_nw Ms
    simp +decide [blks, NLogN.KFB.blk, RS.writes, NLogN.mvK, distB, zipR, zb, this]

theorem GB_qopL {w B1 : ℕ} (Ms : List M2G) (hM : ∀ M ∈ Ms, M.Ok) (zs : List GI) (hb : NLogN.KFB.GB w zs) :
    ∀ G, NLogN.KFB.GB (w + 2) (qopL Ms B1 G zs)
  | 0 => by intro z hz; simp [qopL] at hz
  | G + 1 => by
    rw [qopL_succ]; intro z hz
    rcases List.mem_append.1 hz with h | h
    · exact GB_qopL Ms hM zs hb G z h
    · exact GB_grpOut Ms hM _ (GB_drop hb _) z h

end NLogN.KFB

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFB
open IntMul RS AModel KIL KFD
theorem NLogN.KFB.qop_fsp (s : NLogN.IState NLogN.HS) (w B1 G : ℕ) (Ms : List NLogN.KFB.M2G) (hM : ∀ M ∈ Ms, M.Ok)
    (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ)
    (hlen : G * (2 * B1 * Ms.length) ≤ zs.length)
    (h0 : f 0 = NLogN.KFB.gflat zs ++ l) (hS : NLogN.KFB.Scr f) (hc : NLogN.KFB.Cnt s f B1) (hA : f NLogN.KFB.qA = []) (hG : f NLogN.KFB.cG = [])
    {LG LN : List NLogN.Item} (hrG : (NLogN.KIL.encK s f).G NLogN.KFB.rG = .int (G : ℤ) :: LG)
    (hrN : (NLogN.KIL.encK s f).G NLogN.KFB.rN = .int ((2 * (G * (2 * B1 * Ms.length)) : ℕ) : ℤ) :: LN)
    (hb : NLogN.KFB.GB w zs) :
    NLogN.KFD.FSp (NLogN.KFB.qop Ms) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0
        (NLogN.KFB.gflat (NLogN.KFB.qopL Ms B1 G zs ++ zs.drop (G * (2 * B1 * Ms.length))) ++ l)))
      (NLogN.KFB.cQop w B1 Ms.length G) := by
  set S := 2 * B1 * Ms.length with hSdef
  let F : ℕ → Fin NLogN.HS → List ℤ := fun g => Function.update (Function.update f 0
    (NLogN.KFB.gflat (zs.drop (g * S)) ++ l)) NLogN.KFB.qA (NLogN.KFB.gflat (NLogN.KFB.qopL Ms B1 g zs)).reverse
  have F0 : F 0 = f := by
    funext x
    simp only [F, zero_mul, List.drop_zero, NLogN.KFB.qopL, List.range_zero, List.flatMap_nil, NLogN.KFB.gflat_nil,
      List.reverse_nil, Function.update_apply]
    by_cases e1 : x = NLogN.KFB.qA
    · rw [if_pos e1, e1, hA]
    by_cases e2 : x = 0
    · rw [if_neg e1, if_pos e2, e2, h0]
    rw [if_neg e1, if_neg e2]
  have hFC : ∀ g, F g NLogN.KFB.cG = [] := fun g => by simp +decide [F, Function.update_apply, hG]
  have H := NLogN.KFD.FSp.repReg (C := NLogN.KFB.cG) (r := NLogN.KFB.rG) (s := s) (F := F) (N := G) (Bb := NLogN.zsz (G : ℤ))
    (c := Ms.length * NLogN.KFB.cBlk w B1 + 1) (b := NLogN.KFB.blks Ms) (by decide) (by decide) hFC (NLogN.KFB.blks_nw Ms)
    (L := LG) (by rw [F0]; exact hrG) le_rfl ?_
  · rw [F0] at H
    have hq : (NLogN.KFB.qopL Ms B1 G zs).length = G * S := NLogN.KFB.length_qopL Ms B1 G zs hlen
    have hFA : F G NLogN.KFB.qA = (NLogN.KFB.gflat (NLogN.KFB.qopL Ms B1 G zs)).reverse := by simp [F]
    have M := NLogN.KFB.FSp.mvN (X := NLogN.KFB.qA) (Y := 0) (C := NLogN.KFB.c1) (r := NLogN.KFB.rN) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) s (F G) (NLogN.KFB.gflat (NLogN.KFB.qopL Ms B1 G zs)).reverse []
      (by rw [hFA, List.append_nil]) (Lr := LN)
      (by
        have e : F G NLogN.KFB.rN = f rN := by simp +decide [F]
        rw [NLogN.KIL.encK_G, e, ← NLogN.KIL.encK_G, hrN]
        simp [NLogN.KFB.length_gflat, hq]) (w + 2)
      (fun x hx => (NLogN.KFB.GB_qopL Ms hM zs hb G).bnd x (List.mem_reverse.1 hx))
    refine (H.seq M).mono ?_ |>.congr ?_
    · have := NLogN.KFB.cLp_self G (Ms.length * NLogN.KFB.cBlk w B1 + 1)
      rw [show Ms.length * NLogN.KFB.cBlk w B1 + 1 + 2100 = Ms.length * NLogN.KFB.cBlk w B1 + 2101 by ring] at this
      simp only [List.length_reverse, NLogN.KFB.length_gflat, hq, NLogN.KFB.cQop]
      rw [← hSdef]; omega
    · congr 1; funext x
      simp only [F, Function.update_apply, List.reverse_reverse]
      by_cases e2 : x = 0
      · subst e2; simp +decide [NLogN.KFB.gflat_append, List.append_assoc]
      by_cases e1 : x = NLogN.KFB.qA
      · subst e1; simp +decide [hA]
      simp [e1, e2]
  · intro k hk
    have hk1 : (k + 1) * S ≤ zs.length := le_trans (Nat.mul_le_mul_right _ hk) hlen
    set g := Function.update (F k) NLogN.KFB.cG [(G : ℤ) - k]
    have B := NLogN.KFB.blks_fsp s w B1 Ms hM g (zs.drop (k * S)) l
      (by simp; rw [Nat.succ_mul] at hk1; omega) (by simp +decide [g, F])
      ⟨by simp +decide [g, F, hS.t], by simp +decide [g, F, hS.o],
      by simp +decide [g, F, hS.ur], by simp +decide [g, F, hS.ui], by simp +decide [g, F, hS.vr],
      by simp +decide [g, F, hS.vi], by simp +decide [g, F, hS.c]⟩
      (hc.congr (by simp +decide [g, F]) (by simp +decide [g, F]) (by simp +decide [g, F]))
      (NLogN.KFB.GB_drop hb _)
    refine B.congr ?_
    congr 1; funext x
    simp only [g, F, Function.update_apply]
    by_cases e1 : x = NLogN.KFB.qA
    · subst e1; simp +decide [NLogN.KFB.qopL_succ, NLogN.KFB.gflat_append]; rfl
    by_cases e2 : x = 0
    · subst e2; simp +decide [List.drop_drop]; congr 2; ring
    simp [e1, e2]
end
