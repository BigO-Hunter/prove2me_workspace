  induction zs with
  | nil => rfl
  | cons z zs ih => simp [ih]; ring

theorem tmE_eval {c : ℤ} (hc : c.natAbs ≤ 1) (r : Fin HS) (s : IState HS) :
    (tmE c r).eval s = c * s.top r := by
  unfold tmE
  split_ifs with h1 h2
  · subst h1; simp [Ex.eval]
  · subst h2; simp [Ex.eval]
  · have : c = 0 := by omega
    subst this; simp [Ex.eval]

theorem lcE_eval (s : IState HS) : ∀ (l : List (ℤ × Fin HS)), (∀ t ∈ l, t.1.natAbs ≤ 1) →
    (lcE l).eval s = (l.map fun t => t.1 * s.top t.2).sum
  | [], _ => rfl
  | (c, r) :: l, h => by
    simp only [lcE, Ex.eval, List.map_cons, List.sum_cons]
    rw [tmE_eval (h (c, r) List.mem_cons_self), lcE_eval s l fun t ht => h t (List.mem_cons_of_mem _ ht)]

theorem tmE_regs (c : ℤ) (r : Fin HS) : ∀ x ∈ (tmE c r).regs, x = r := by
  intro x hx
  unfold tmE at hx
  split_ifs at hx <;> simp [Ex.regs] at hx <;> exact hx

theorem lcE_regs : ∀ (l : List (ℤ × Fin HS)), ∀ x ∈ (lcE l).regs, ∃ t ∈ l, x = t.2
  | [], x, hx => by simp [lcE, Ex.regs] at hx
  | (c, r) :: l, x, hx => by
    simp only [lcE, Ex.regs, List.mem_append] at hx
    rcases hx with hx | hx
    · exact ⟨(c, r), List.mem_cons_self, tmE_regs c r x hx⟩
    · obtain ⟨t, ht, e⟩ := lcE_regs l x hx
      exact ⟨t, List.mem_cons_of_mem _ ht, e⟩

theorem lcE_clean (l : List (ℤ × Fin HS)) (h : ∀ t ∈ l, t.2.val < 56) : (lcE l).Clean := by
  intro x hx
  obtain ⟨t, ht, rfl⟩ := lcE_regs l x hx
  exact clean_of_lt (h t ht) _ (by simp [Ex.regs])

theorem tmE_lin (c : ℤ) (r : Fin HS) : (tmE c r).Lin := by
  unfold tmE; split_ifs <;> trivial

theorem lcE_lin : ∀ (l : List (ℤ × Fin HS)), (lcE l).Lin
  | [] => trivial
  | (c, r) :: l => ⟨tmE_lin c r, lcE_lin l⟩

theorem tmE_size (c : ℤ) (r : Fin HS) : (tmE c r).size ≤ 2 := by
  unfold tmE; split_ifs <;> simp [Ex.size]

theorem lcE_size : ∀ (l : List (ℤ × Fin HS)), (lcE l).size ≤ 3 * l.length + 1
