  | (c, r) :: l => by
    have := tmE_size c r; have := lcE_size l
    simp only [lcE, Ex.size, List.length_cons]; omega

theorem tmE_ok {s : IState HS} (c : ℤ) {r : Fin HS} (h : s.IsInt r) : (tmE c r).ok s := by
