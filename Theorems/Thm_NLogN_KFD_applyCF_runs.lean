section
-- Source module: Solutions.KIL3Tab
/-!
# KIL3: a table of `W` streams on one stack

The `W` streams of the network are kept on stack `0`, one after the other (stream `0` on top):
`tab W F = F 0 ++ F 1 ++ ⋯ ++ F (W − 1)`, every stream of the same length `v`.

Operations (all `O(W · v)` item moves, plus the cost of the applied code):

* `applyC v w code`: run `code` (any stack-`0` program) on stream `w` in place
  (`applyC_runs`): the streams before `w` are parked on stack `15` and moved back.
* `copyC v w`: push a reversed copy of stream `w` on stack `16` (`copyC_sp`).
* `buildC v l`: push on stack `20` the (reversed) pointwise sum mod 2 of the streams `l`.
* `rebuildC W v T`: replace the table by the streams `w ↦ Σ_{w' ∈ T w} F w'` (`rebuildC_sp`).

Scratch stacks: `15` (park), `16` (copy), `17` (temp), `19` (zip out), `20` (new table),
`21` (loop counter).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-! ## Tables -/

theorem tabR_succ (a n : ℕ) (F : ℕ → List ℤ) : tabR a (n + 1) F = F a ++ tabR (a + 1) n F := by
  simp [tabR, List.range'_succ]

theorem tabR_add (a n k : ℕ) (F : ℕ → List ℤ) :
    tabR a (n + k) F = tabR a n F ++ tabR (a + n) k F := by
  simp only [tabR]; rw [← List.flatMap_append, List.range'_append_1]

theorem tab_split {W w : ℕ} (hw : w < W) (F : ℕ → List ℤ) :
    tabR 0 W F = tabR 0 w F ++ (F w ++ tabR (w + 1) (W - (w + 1)) F) := by
  conv_lhs => rw [show W = w + ((W - (w + 1)) + 1) by omega, tabR_add, Nat.zero_add, tabR_succ]

theorem length_tabR {W v : ℕ} {F : ℕ → List ℤ} (h : Uni W v F) :
    ∀ a n, a + n ≤ W → (tabR a n F).length = n * v
  | a, 0, _ => by simp [tabR]
  | a, n + 1, hn => by
    rw [tabR_succ, List.length_append, (h a (by omega)).1, length_tabR h (a + 1) n (by omega)]
    ring

theorem bits_tabR {W v : ℕ} {F : ℕ → List ℤ} (h : Uni W v F) :
    ∀ a n, a + n ≤ W → Bits (tabR a n F)
  | a, 0, _ => by simp [tabR, Bits]
  | a, n + 1, hn => by
    rw [tabR_succ]
    intro x hx
    rcases List.mem_append.1 hx with hx | hx
    · exact (h a (by omega)).2 x hx
    · exact bits_tabR h (a + 1) n (by omega) x hx

theorem tabR_congr {F G : ℕ → List ℤ} : ∀ a n, (∀ k, a ≤ k → k < a + n → F k = G k) →
    tabR a n F = tabR a n G
  | a, 0, _ => by simp [tabR]
  | a, n + 1, h => by
    rw [tabR_succ, tabR_succ, h a le_rfl (by omega),
      tabR_congr (a + 1) n (fun k h1 h2 => h k (by omega) (by omega))]

theorem bits_bnd {l : List ℤ} (h : Bits l) {Bb : ℕ} (hB : 1 ≤ Bb) : Bnd Bb l :=
  fun x hx => zsz_bit (h x hx) hB

