  have hB := NLogN.KFM.cst_bnd Δ t (NLogN.KFM.cRoot Δ s t) (NLogN.KFM.hRoot Δ s t) _ _ hC hH (NLogN.KFM.cRoot_err Δ s t hst ht)
    (NLogN.KFM.hRoot_err Δ s t hst ht) hu
  have hcb : NLogN.KFM.GBnd (Δ + 2) (NLogN.KFM.cRoot Δ s t) := NLogN.KFM.zsz_of_near Δ _ _ hC
    ((NLogN.KFM.cRoot_err Δ s t hst ht).trans (pow_le_one₀ (by norm_num) (by norm_num)))
  have g := NLogN.KFM.chirpGU_runs (I := I) (iprog := iprog) hM hdom hΦ Δ t s4 (NLogN.KFM.hRoot Δ s t) (NLogN.KFM.oneP Δ)
    (NLogN.KFM.cRoot Δ s t) (st.G 0) (st.G NLogN.KFM.pH) (st.G NLogN.KFM.pK) LR L4 (by simp +decide [hs4, hs3, hs2, NLogN.KFM.oneP])
    (by simp +decide [hs4, hs3]) (by simp +decide [hs4]) (by simp +decide [hs4, hs3, hs2, hR])
    (by simp +decide [hs4, hs3, hs2, hX]) hB hcb
  rw [show s4.G NLogN.KFM.pW = st.G NLogN.KFM.pW by simp +decide [hs4, hs3, hs2]] at g
  refine (k12.seq (t1.seq (t2.seq g))).mono' ?_ ?_
  · simp only [NLogN.KFM.axTab, hs4, hs3, hs2]
    clear k12 t1 t2 g
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
