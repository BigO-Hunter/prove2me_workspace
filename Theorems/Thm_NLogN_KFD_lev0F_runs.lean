  have hB : 1 ≤ AModel.vol B := NLogN.KIL.vol_pos_of (fun a ha => hpos a (by simp [AModel.swShape, ha]))
  have hC : 1 ≤ AModel.vol Cs := NLogN.KIL.vol_pos_of (fun a ha => hpos a (by simp [AModel.swShape, ha]))
  have hVe : V = P * (L * AModel.vol A) * (q * (AModel.vol B * (q * AModel.vol Cs))) := by
    simp only [V, AModel.swShape, AModel.vol_cons, AModel.vol_append]; ring
  have hle : ∀ x : ℕ, x ≤ V → NLogN.zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (NLogN.KIL.zsz_nat_le hx) hV
  have hX1 : 1 ≤ q * (AModel.vol B * (q * AModel.vol Cs)) := Nat.mul_pos hq (Nat.mul_pos hB (Nat.mul_pos hq hC))
  have lA : P * (L * AModel.vol A) ≤ V := by rw [hVe]; exact Nat.le_mul_of_pos_right _ hX1
  have lLA : L * AModel.vol A ≤ V := le_trans (Nat.le_mul_of_pos_left _ hP) lA
  have lvA : AModel.vol A ≤ V := le_trans (Nat.le_mul_of_pos_left _ hL) lLA
  have lP : P ≤ V := le_trans (Nat.le_mul_of_pos_right _ (Nat.mul_pos hL hA)) lA
  have lL : L ≤ V := le_trans (Nat.le_mul_of_pos_right _ hA) lLA
  have lR : q * (AModel.vol B * (q * AModel.vol Cs)) ≤ V := by
    rw [hVe]; exact Nat.le_mul_of_pos_left _ (Nat.mul_pos hP (Nat.mul_pos hL hA))
  have lq : q ≤ V := le_trans (Nat.le_mul_of_pos_right _ (Nat.mul_pos hB (Nat.mul_pos hq hC))) lR
  have lBC : AModel.vol B * (q * AModel.vol Cs) ≤ V := le_trans (Nat.le_mul_of_pos_left _ hq) lR
  have lB : AModel.vol B ≤ V := le_trans (Nat.le_mul_of_pos_right _ (Nat.mul_pos hq hC)) lBC
  have lC : AModel.vol Cs ≤ V := le_trans (le_trans (Nat.le_mul_of_pos_left _ hq)
    (Nat.le_mul_of_pos_left _ hB)) lBC
  have gP := NLogN.KIL.goodE_reg (NLogN.KIL.rd_desc (r := NLogN.KIL.dP) ⟨by decide, by decide⟩) h2 (hle _ lP)
  have gL := NLogN.KIL.goodE_reg (NLogN.KIL.rd_desc (r := NLogN.KIL.dL) ⟨by decide, by decide⟩) h3 (hle _ lL)
  have gA := NLogN.KIL.goodE_reg (NLogN.KIL.rd_desc (r := NLogN.KIL.dA) ⟨by decide, by decide⟩) h4 (hle _ lvA)
  have gB := NLogN.KIL.goodE_reg (NLogN.KIL.rd_desc (r := NLogN.KIL.dB) ⟨by decide, by decide⟩) h5 (hle _ lB)
  have gC := NLogN.KIL.goodE_reg (NLogN.KIL.rd_desc (r := NLogN.KIL.dC) ⟨by decide, by decide⟩) h6 (hle _ lC)
  have gT := NLogN.KIL.goodE_reg (NLogN.KIL.rd_desc (r := NLogN.KIL.dT) ⟨by decide, by decide⟩) h7 (hle _ lq)
  have gLA := NLogN.KIL.goodE_mul gL gA (by rw [NLogN.KIL.eval_reg' h3, NLogN.KIL.eval_reg' h4]; exact_mod_cast hle _ lLA)
  have gPLA := NLogN.KIL.goodE_mul gP gLA (by
    simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq h2, NLogN.IState.top_eq h3, NLogN.IState.top_eq h4]
    exact_mod_cast hle _ lA)
  have e1 : (P :: L :: A) ++ q :: (B ++ q :: Cs) = P :: L :: AModel.swShape A B Cs q := by simp [AModel.swShape]
  have H := NLogN.KFD.swapEF_runs (I := I) (iprog := iprog) (P :: L :: A) B Cs q Bb w _ _ _ _ t xs R h0
    (by rw [hlen, e1]) hb
    (by simp only [AModel.vol_cons]; exact Nat.mul_pos hP (Nat.mul_pos hL hA)) hq hB hC
    (by rw [e1]; exact hV) gPLA gT gB gC
    (by simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq h2, NLogN.IState.top_eq h3, NLogN.IState.top_eq h4]
        simp only [AModel.vol_cons]; push_cast; ring)
    (NLogN.KIL.eval_reg' h7) (NLogN.KIL.eval_reg' h5) (NLogN.KIL.eval_reg' h6)
  rw [e1, show (P :: L :: A).length = A.length + 2 by simp,
    show A.length + 2 + 1 + B.length = A.length + B.length + 3 by omega] at H
  exact H
end
