namespace NLogN.KIL

open IntMul RS AModel AModelL12 AModelFac

theorem valid_app_split {X Y : Shape} {a : List ℕ} (h : Valid (X ++ Y) a) :
    ∃ a1 a2, a = a1 ++ a2 ∧ Valid X a1 ∧ Valid Y a2 := by
  induction X generalizing a with
  | nil => exact ⟨[], a, rfl, List.Forall₂.nil, h⟩
  | cons x X ih =>
    rcases h with _ | ⟨hx, h⟩
    obtain ⟨a1, a2, rfl, h1, h2⟩ := ih h
    exact ⟨_ :: a1, a2, rfl, List.Forall₂.cons hx h1, h2⟩

theorem valid_cons_split {q : ℕ} {Y : Shape} {a : List ℕ} (h : Valid (q :: Y) a) :
    ∃ y a', a = y :: a' ∧ y < q ∧ Valid Y a' := by
  rcases h with _ | ⟨hx, h⟩
  exact ⟨_, _, rfl, hx, h⟩

/-- The two moves compose to the interchange. -/
theorem pull_two_moves {α : Type*} (A0 B Cs : Shape) (q : ℕ) (d : α) (xs : List α) :
    AModel.pull (A0 ++ B ++ [q] ++ ([q] ++ Cs)) (A0 ++ [q] ++ B ++ ([q] ++ Cs))
      (swapMid A0.length B.length 1) d
      (AModel.pull (A0 ++ [q] ++ (B ++ [q]) ++ Cs) (A0 ++ (B ++ [q]) ++ [q] ++ Cs)
        (swapMid A0.length 1 (B ++ [q]).length) d xs) =
    AModel.pull (A0 ++ q :: (B ++ q :: Cs)) (A0 ++ q :: (B ++ q :: Cs))
      (swapPos A0.length (A0.length + 1 + B.length)) d xs := by
  have e1 : A0 ++ (B ++ [q]) ++ [q] ++ Cs = A0 ++ B ++ [q] ++ ([q] ++ Cs) := by simp
  have e2 : A0 ++ [q] ++ (B ++ [q]) ++ Cs = A0 ++ q :: (B ++ q :: Cs) := by simp
  have e3 : A0 ++ [q] ++ B ++ ([q] ++ Cs) = A0 ++ q :: (B ++ q :: Cs) := by simp
  rw [e1, e2, e3]
  have hdec : ∀ a, Valid (A0 ++ q :: (B ++ q :: Cs)) a → ∃ a0 y b x c, a = a0 ++ [y] ++ (b ++ [x] ++ c) ∧
      Valid A0 a0 ∧ y < q ∧ Valid B b ∧ x < q ∧ Valid Cs c := by
    intro a ha
    obtain ⟨a0, a1, rfl, h0, h1⟩ := valid_app_split ha
    obtain ⟨y, a2, rfl, hy, h2⟩ := valid_cons_split h1
    obtain ⟨b, a3, rfl, hb, h3⟩ := valid_app_split h2
    obtain ⟨x, c, rfl, hx, hc⟩ := valid_cons_split h3
    exact ⟨a0, y, b, x, c, by simp, h0, hy, hb, hx, hc⟩
  have hg2 : ∀ a0 y b x c, a0.length = A0.length → b.length = B.length →
      swapMid A0.length B.length 1 (a0 ++ [y] ++ (b ++ [x] ++ c)) = a0 ++ b ++ [y] ++ ([x] ++ c) := by
    intro a0 y b x c h0 hb
    have := swapMid_app a0 b [y] ([x] ++ c)
    rw [h0, hb] at this
    simpa using this
  rw [pull_comp _ _ (fun a ha => by
    obtain ⟨a0, y, b, x, c, rfl, h0, hy, hb, hx, hc⟩ := hdec a ha
    rw [hg2 a0 y b x c h0.length_eq hb.length_eq]
    exact valid_append (valid_append (valid_append h0 hb) (List.Forall₂.cons hy .nil))
      (valid_append (List.Forall₂.cons hx .nil) hc))]
  refine pull_congr (fun a ha => ?_) _ _
  obtain ⟨a0, y, b, x, c, rfl, h0, hy, hb, hx, hc⟩ := hdec a ha
  simp only [Function.comp_apply]
  rw [hg2 a0 y b x c h0.length_eq hb.length_eq]
  have := swapMid_app a0 [x] (b ++ [y]) c
  rw [h0.length_eq, List.length_singleton] at this
  rw [show a0 ++ b ++ [y] ++ ([x] ++ c) = a0 ++ (b ++ [y]) ++ [x] ++ c by simp,
    show (B ++ [q]).length = (b ++ [y]).length by simp [hb.length_eq], this]
  have := swapPos_append a0 b c y x
  rw [h0.length_eq, hb.length_eq] at this
  rw [this]
  simp

