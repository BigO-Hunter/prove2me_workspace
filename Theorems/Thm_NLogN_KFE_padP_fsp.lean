namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem padL_succ {α : Type*} (k F F' Y : ℕ) (d : α) (xs : List α) :
    padL (k + 1) F F' Y d xs = padL k F F' Y d xs ++
      ((xs.drop (k * (F * Y))).take (F * Y) ++ List.replicate ((F' - F) * Y) d) := by
  simp [padL, List.range_succ, List.flatMap_append]

theorem bnd_padL {Bb : ℕ} {X F F' Y : ℕ} {xs : List ℤ} (h : Bnd Bb xs) :
    Bnd Bb (padL X F F' Y 0 xs) := by
  intro a ha
  simp only [padL, List.mem_flatMap, List.mem_append, List.mem_replicate] at ha
  obtain ⟨x, -, hx | ⟨-, rfl⟩⟩ := ha
  · exact h a (List.mem_of_mem_drop (List.mem_of_mem_take hx))
  · simp [zsz_zero]

end NLogN.KIL

end

