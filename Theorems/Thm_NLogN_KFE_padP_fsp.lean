theorem FSp.zeroR {Y C r : Fin HS} (hYC : Y ≠ C) (hY5 : Y.val < 56) (hC5 : C.val < 56)
    (hr5 : r.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (n : ℕ) (hfC : f C = [])
    {Lr : List Item} (hr : (encK s f).G r = .int (n : ℤ) :: Lr) (Bb : ℕ)
    (hn : zsz (n : ℤ) ≤ Bb) :
    FSp (zeroKE Y C (.reg r)) (encK s f) (encK s (Function.update f Y (List.replicate n 0 ++ f Y)))
      (cLp n 8000 Bb) := by
  have e0 : Function.update f Y (List.replicate 0 0 ++ f Y) = f := by simp
  have H := FSp.repReg (C := C) (r := r) (s := s)
    (F := fun k => Function.update f Y (List.replicate k 0 ++ f Y)) (N := n) (Bb := Bb)
    (c := 8000) (b := .push Y (.lit 0)) hC5 hr5
    (fun k => by simp [Function.update_apply, hYC.symm, hfC])
    (by simp [RS.writes, hYC.symm]) (L := Lr) (by simp only [e0]; exact hr) hn ?_
  · simp only [e0] at H
    exact H
  · intro k hk
    have h1 := Sp.push s (Function.update (Function.update f Y (List.replicate k 0 ++ f Y)) C
      [(n : ℤ) - k]) (i := Y) (e := .lit 0) (B := 0) hY5 (clean_lit _) trivial trivial
      (by simp [Ex.Bnd, zsz_zero])
    refine FSp.mono (FSp.congr (FSp.of_norep rfl h1) ?_) (by simp [Ex.size])
    congr 1
    funext j
    simp only [Function.update_apply, Ex.eval]
    by_cases h1 : j = Y
    · simp only [h1, if_true, if_neg hYC, List.replicate_succ, List.cons_append]
    · simp only [h1, if_false]

theorem zsz_le_self (n : ℕ) : zsz (n : ℤ) ≤ n := KFC.zsz_nat_le n

theorem cPadF_bound {X a b V Bb : ℕ} (h1 : X * a + X * b = V) (hX : X ≤ V) (bl : ℕ)
    (hbl : bl ≤ a + b) (T : ℕ) (hT : T ≤ V) :
    cLp X (cLp a (250 * (1 + 2)) bl + cLp b 8000 bl) Bb + cLp T (250 * (1 + 2)) Bb ≤
      cPadF V Bb := by
  unfold cLp cPadF
  have e1 : X * (1000 * (bl + 2) + a * (250 * (1 + 2) + 1100) + (1000 * (bl + 2) + b * (8000 + 1100))
      + 1100) = 2000 * (X * bl) + 5100 * X + 1850 * (X * a) + 9100 * (X * b) := by ring
  rw [e1]
  have f1 : X * bl ≤ X * a + X * b := by rw [← Nat.mul_add]; exact Nat.mul_le_mul_left _ hbl
  have f2 : T * (250 * (1 + 2) + 1100) = 1850 * T := by ring
  rw [f2]
  omega

end NLogN.KFE

end

