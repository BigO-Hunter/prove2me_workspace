theorem NLogN.KFN.rImplI_onRole (hW : 0 < W) (w : Fin W) {ι : Type*} [Fintype ι] [DecidableEq ι]
    {r n : ℕ} (hr : 0 < r) (st' : ι → ℕ) (Tw : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) {code : ℕ → NLogN.IStmt NLogN.HS Pp}
    {e dw : ℕ} {cost : ℕ → ℕ} (h : NLogN.KFN.SImplI I iprog r st' n Tw code e dw cost) (st : Fin m × κ → ℕ)
    (A : P8Lift.ROp (Fin W) m κ)
    (hA : ∀ X : Fin W → List (Fin r → ℂ), (∀ v, (X v).length = n) →
      NLogN.KFN.roleOpF st n A X = Function.update X w (NLogN.KFN.selOpF st' n Tw (X w)))
    (Z : ℕ) (hZ : NLogN.zsz ((2 * (W * (n * r)) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFN.RImplI I iprog r n st A (NLogN.KFN.wrapCI W (n * r) w.val e code) e (dw + (e + 2) * W)
      (NLogN.KFN.cWrapR W (n * r) Z e dw cost) := by
  intro s f zs l X F x hC h0 hx hX hb
  set L := n * r with hL
  set o : Fin W := ⟨0, hW⟩
  set σ := Equiv.swap o w with hσ
  have hsw : ∀ v : Fin W, NLogN.KFG.swapsF (NLogN.KFN.swL w.val) v.val = (σ v).val := by
    intro v
    rw [NLogN.KFN.swapsF_swL, hσ, show (0 : ℕ) = o.val from rfl, ← NLogN.KFG.pf_swap]
    simp [NLogN.KFG.pf]
  have hsl : ∀ p ∈ NLogN.KFN.swL w.val, p.1 < p.2 ∧ p.2 < W := by
    intro p hp; unfold NLogN.KFN.swL at hp
    split_ifs at hp with h0
    · simp at hp
    · simp at hp; subst hp; exact ⟨by omega, w.isLt⟩
  have hsl1 : (NLogN.KFN.swL w.val).length ≤ 1 := by unfold NLogN.KFN.swL; split_ifs <;> simp
  -- 1. swap role `w` to the front
  have E0 := NLogN.KFN.enc_of_rec hr hX hx
  obtain ⟨E1, B1, H1⟩ := NLogN.KFG.swaps_fsp s l x Z hZ (NLogN.KFN.swL w.val) hsl (fun _ => F) f zs (NLogN.KFN.yR r X) E0 h0
    hC.p hb
  set zs1 := NLogN.KFG.swapsL L (NLogN.KFN.swL w.val) zs
  set X1 : Fin W → List (Fin r → ℂ) := fun v => X (σ v)
  have hX1 : ∀ v, (X1 v).length = n := fun v => hX _
  have R1 : NLogN.KFH.RecRep r F zs1 (NLogN.KFN.flatR X1) := by
    refine NLogN.KFN.rec_of_enc hr hX1 E1 (fun v j hj c => ?_)
    beta_reduce
    rw [hsw v, NLogN.KFN.yR_val hr X (σ v) j c]
  have hz1 : zs1.length = W * L := E1.1
  -- 2. the program on the first segment
  set seg := zs1.take L
  set rest := zs1.drop L
  have hsplit : zs1 = seg ++ rest := (List.take_append_drop _ _).symm
  have Rs : NLogN.KFH.RecRep r F seg (X1 o) := NLogN.KFN.recRep_take hW hX1 R1
  have hbs : NLogN.KFB.GB x seg := B1.sub fun z hz => List.mem_of_mem_take hz
  have hbr : NLogN.KFB.GB x rest := B1.sub fun z hz => List.mem_of_mem_drop hz
  obtain ⟨seg', r2, b2, f2⟩ := h s (Function.update f 0 (NLogN.KFB.gflat zs1 ++ l)) seg (NLogN.KFB.gflat rest ++ l)
    (X1 o) F x (hC.upd0 _) (by rw [Function.update_self, hsplit, NLogN.KFB.gflat_append, List.append_assoc]) Rs (hX1 o) hbs
  set Y2 : Fin W → List (Fin r → ℂ) := Function.update X1 o (NLogN.KFN.selOpF st' n Tw (X1 o))
  have hY2 : ∀ v, (Y2 v).length = n := by
    intro v; simp only [Y2, Function.update_apply]; split_ifs
    · exact NLogN.KFN.length_selOpF _ _ _ _
    · exact hX1 v
  have hsl' : seg'.length = L := by rw [r2.1, NLogN.KFN.length_selOpF]
  set zs2 := seg' ++ rest
  have E2 : NLogN.KFG.Enc W L (Function.update (fun _ => F) 0 (F + e)) zs2 (NLogN.KFN.yR r Y2) := by
    have := NLogN.KFN.enc_set0 hW (NLogN.KFN.enc_of_rec hr hX1 R1) hsl' (F' := F + e) (y0 := NLogN.KFN.yR r Y2 0)
      (fun p hp => by
        have hpr : p / r < n := by rw [Nat.div_lt_iff_lt_mul hr]; exact hp
        have e1 : p = p / r * r + (⟨p % r, Nat.mod_lt _ hr⟩ : Fin r) := by
          simp only; rw [Nat.div_add_mod']
        conv_lhs => rw [e1]
        rw [r2.2 _ _ (by rw [NLogN.KFN.length_selOpF]; exact hpr)]
        rw [show NLogN.KFN.yR r Y2 0 p = (Y2 o).getD (p / r) 0 ⟨p % r, Nat.mod_lt _ hr⟩ from by
          simp only [NLogN.KFN.yR, dif_pos (And.intro hW hr)]; rfl]
        simp [Y2])
    have hy : Function.update (NLogN.KFN.yR r X1) 0 (NLogN.KFN.yR r Y2 0) = NLogN.KFN.yR r Y2 := by
      funext v p
      by_cases hv : v = 0
      · subst hv; simp
      · rw [Function.update_of_ne hv]
        simp only [NLogN.KFN.yR]
        split_ifs with hh
        · congr 2
          simp only [Y2]
          rw [Function.update_of_ne (fun e => hv (by simpa [o] using congrArg Fin.val e))]
        · rfl
    rw [hy] at this; exact this
  have bz2 : NLogN.KFB.GB (x + dw) zs2 := NLogN.KFB.GB_append.2 ⟨b2, hbr.mono (by omega)⟩
  -- 3. leveling
  set e2 := Function.update (fun _ : ℕ => F) 0 (F + e)
  have e2eq : e2 = NLogN.KFN.shE F (Function.update (fun _ => 0) 0 e) := by
    funext t; by_cases ht : t = 0 <;> simp [e2, NLogN.KFN.shE, ht, Nat.add_comm]
  have he2 : ∀ t, F ≤ e2 t ∧ e2 t ≤ F + e := fun t => by
    simp only [e2, Function.update_apply]; split_ifs <;> omega
  have hs2 : ∀ a ∈ NLogN.KFN.levA W 0, e2 a.s + a.h ≤ F + e := fun a ha => by
    rw [(NLogN.KFN.levA_src a ha).1, (NLogN.KFN.levA_src a ha).2.1]; simp [e2]
  obtain ⟨E3, B3, H3⟩ := NLogN.KFG.gate_fsp s l Z hZ (NLogN.KFN.levA W 0)
    (fun a ha => (NLogN.KFN.levA_ok hW a ha).1) (NLogN.KFN.levA_nots W 0) e2
    (Function.update f 0 (NLogN.KFB.gflat zs2 ++ l)) zs2 (NLogN.KFN.yR r Y2) (x + dw) E2 (by simp) (hC.p.upd0 _) bz2
  rw [NLogN.KFN.gateY_zero (fun a ha => (NLogN.KFN.levA_src a ha).2.2)] at E3
  have E3' := NLogN.KFN.enc_congr_e E3 (NLogN.KFN.gateE_levA hW e2 (by simp [e2]) (fun t => (he2 t).2))
  set zs3 := NLogN.KFG.gateL (NLogN.KFN.levA W 0) e2 L zs2
  have w3 := NLogN.KFN.gateW_le2 F (F + e) (NLogN.KFN.levA W 0) e2 (x + dw) (NLogN.KFN.levA_nots W 0) hs2 he2
  have hlev := NLogN.KFN.levA_len W 0
  -- 4. swap back
  obtain ⟨E4, B4, H4⟩ := NLogN.KFG.swaps_fsp s l (NLogN.KFG.gateW (NLogN.KFN.levA W 0) e2 (x + dw)) Z hZ (NLogN.KFN.swL w.val) hsl
    (fun _ => F + e) (Function.update f 0 (NLogN.KFB.gflat zs3 ++ l)) zs3 (NLogN.KFN.yR r Y2) E3' (by simp)
    (hC.p.upd0 _) B3
  refine ⟨NLogN.KFG.swapsL L (NLogN.KFN.swL w.val) zs3, ?_, ?_, ?_⟩
  · have R4 := NLogN.KFN.rec_of_enc hr (Y := fun v => Y2 (σ v)) (fun v => hY2 _) E4 (fun v j hj c => by
      beta_reduce; rw [hsw v, NLogN.KFN.yR_val hr Y2 (σ v) j c])
    have hfam : (fun v => Y2 (σ v)) = Function.update X w (NLogN.KFN.selOpF st' n Tw (X w)) := by
      funext v
      simp only [Y2, X1, Function.update_apply]
      by_cases hv : v = w
      · subst hv
        have : σ v = o := by rw [hσ, Equiv.swap_apply_right]
        rw [if_pos rfl, if_pos this, hσ, Equiv.swap_apply_left]
      · rw [if_neg hv]
        have : σ v ≠ o := by
          intro h'; apply hv
          have := congrArg σ h'
          rwa [hσ, Equiv.swap_apply_self, Equiv.swap_apply_left] at this
        rw [if_neg this, hσ, Equiv.swap_apply_self]
    rw [hA X hX, ← hfam]
    exact R4
  · have : (F + e - F + 2) * (NLogN.KFN.levA W 0).length ≤ (e + 2) * W := Nat.mul_le_mul (by omega) hlev
    exact B4.mono (by omega)
  · have F2 : NLogN.IRuns I iprog (code x) (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs1 ++ l)))
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs2 ++ l))) (cost x) := by
      have := f2; rw [Function.update_idem] at this
      have e : NLogN.KFB.gflat zs2 ++ l = NLogN.KFB.gflat seg' ++ (NLogN.KFB.gflat rest ++ l) := by simp [zs2, NLogN.KFB.gflat_append]
      rw [e]; exact this
    rw [Function.update_idem] at H3 H4
    have := (H1.irun (I := I) (iprog := iprog) (NLogN.KFG.fok_swapsP _ _)).seq (F2.seq
      ((H3.irun (I := I) (iprog := iprog) (NLogN.KFG.fok_gateP _ _ _)).seq
        (H4.irun (I := I) (iprog := iprog) (NLogN.KFG.fok_swapsP _ _))))
    have hc : NLogN.KFN.wrapCI (Pp := Pp) W L w.val e code x = .seq (NLogN.KFD.fcode (NLogN.KFG.swapsP L (NLogN.KFN.swL w.val)))
        (.seq (code x) (.seq (NLogN.KFD.fcode (NLogN.KFG.gateP (NLogN.KFN.levA W 0) e2 L)) (NLogN.KFD.fcode (NLogN.KFG.swapsP L (NLogN.KFN.swL w.val))))) := by
      unfold NLogN.KFN.wrapCI; rw [e2eq, NLogN.KFN.gateP_shE]
    rw [hc]
    refine this.mono ?_
    have c3 := NLogN.KFN.cGate_le2 F (F + e) L W Z (NLogN.KFN.levA W 0) e2 (x + dw) (NLogN.KFN.levA_nots W 0) hs2 he2
    have m1 : NLogN.KFG.cAtom x 0 L W Z ≤ NLogN.KFG.cAtom (x + dw + (e + 2) * W) e L W Z :=
      NLogN.KFN.cAtom_mono (by omega) (by omega)
    have m3 : (NLogN.KFN.levA W 0).length * NLogN.KFG.cAtom (x + dw + (F + e - F + 2) * (NLogN.KFN.levA W 0).length)
        (F + e - F) L W Z ≤ W * NLogN.KFG.cAtom (x + dw + (e + 2) * W) e L W Z :=
      Nat.mul_le_mul hlev (NLogN.KFN.cAtom_mono (by
        have : (F + e - F + 2) * (NLogN.KFN.levA W 0).length ≤ (e + 2) * W :=
          Nat.mul_le_mul (by omega) hlev
        omega) (by omega))
    have m4 : NLogN.KFG.cAtom (NLogN.KFG.gateW (NLogN.KFN.levA W 0) e2 (x + dw)) 0 L W Z ≤
        NLogN.KFG.cAtom (x + dw + (e + 2) * W) e L W Z := NLogN.KFN.cAtom_mono (by
          have : (F + e - F + 2) * (NLogN.KFN.levA W 0).length ≤ (e + 2) * W :=
            Nat.mul_le_mul (by omega) hlev
          omega) (by omega)
    have m5 := Nat.mul_le_mul_right (NLogN.KFG.cAtom x 0 L W Z) hsl1
    have m6 := Nat.mul_le_mul_right (NLogN.KFG.cAtom (NLogN.KFG.gateW (NLogN.KFN.levA W 0) e2 (x + dw)) 0 L W Z) hsl1
    unfold NLogN.KFN.cWrapR
    nlinarith
end
