theorem NLogN.exp_loop (n : ℕ) (x y : ℤ) (s : NLogN.IState NLogN.HS) (L5 L6 L7 : List NLogN.Item)
    (h5 : s.G 5 = .int n :: L5) (h6 : s.G 6 = .int x :: L6) (h7 : s.G 7 = .int y :: L7) :
    (NLogN.RS.rep 39 NLogN.eKE NLogN.expBody).ok (NLogN.expPre.run s) ∧
    (NLogN.RS.rep 39 NLogN.eKE NLogN.expBody).run (NLogN.expPre.run s) =
      (NLogN.RS.repSt 39 NLogN.eKE NLogN.expBody (NLogN.expPre.run s) (2 * n + 13)).upd 39 (s.G 39) := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, gj⟩ := NLogN.exp_pre n x y s L5 L6 L7 h5 h6 h7
  have hK := NLogN.exp_K n x y s L5 L6 L7 h5 h6 h7
  have hinv := NLogN.exp_inv_all n x y s L5 L6 L7 h5 h6 h7
  have hw : (39 : Fin NLogN.HS) ∉ NLogN.expBody.writes := by simp [NLogN.expBody, NLogN.RS.seqL, NLogN.RS.writes]
  refine ⟨⟨by decide, ?_, ?_, ?_, hw, ?_⟩, ?_⟩
  · simp (config := {decide := true}) [NLogN.eKE, NLogN.Ex.Clean, NLogN.Ex.regs, NLogN.zX_all]
  · simp (config := {decide := true}) [NLogN.eKE, NLogN.Ex.ok, NLogN.IState.IsInt, NLogN.IState.top, gj 5 (by decide), h5]
  · rw [hK]; positivity
  · intro k hk
    rw [hK, Int.toNat_natCast] at hk
    exact (NLogN.exp_body _ _ _ _ s _ k (hinv k hk.le)).1
  · rw [NLogN.RS.run_rep 39 _ _ _ hw (by rw [hK]; positivity), hK, Int.toNat_natCast, gj 39 (by decide)]
end
