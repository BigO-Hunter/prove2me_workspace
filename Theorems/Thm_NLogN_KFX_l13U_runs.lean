  simp only [rotPl, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] at hm
  have : 13 ≤ r.val := by
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact h1 r hr
    · exact h2 r hr
    · exact h3 r hr
    · exact h4 r hr
    · exact h5 r hr
    · exact h6 r hr
    · exact h7 r hr
    · exact h8 r hr
  rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> revert this <;> decide

theorem rotU_runs {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {d0 d1 : ℕ}
    (hd0 : 0 < d0) (hd1 : 0 < d1) (l : Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zd0 : zsz (d0 : ℤ) ≤ Bb) (zd1 : zsz (d1 : ℤ) ≤ Bb)
    (P B w : ℕ) (zP : zsz (P : ℤ) ≤ Bb)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = P * 2 ^ (f * K) * B)
    (hbw : Bnd w xs) (h0 : t.G 0 = ints xs ++ R)
    {eP eQ eB ed0 ed1 er ef eK : Ex HS}
    (hsz : ((rotPl eP eQ eB ed0 ed1 er ef eK).map fun p => p.2.size + 1).sum ≤ 100)
    (n1 : NoLow eP) (n2 : NoLow eQ) (n3 : NoLow eB) (n4 : NoLow ed0) (n5 : NoLow ed1)
    (n6 : NoLow er) (n7 : NoLow ef) (n8 : NoLow eK)
    (E1 : ESp eP t Bb (P : ℤ)) (E2 : ESp eQ t Bb ((2 ^ (f * K) : ℕ) : ℤ)) (E3 : ESp eB t Bb (B : ℤ))
    (E4 : ESp ed0 t Bb (d0 : ℤ)) (E5 : ESp ed1 t Bb (d1 : ℤ)) (E6 : ESp er t Bb ((2 : ℤ) ^ ρ))
    (E7 : ESp ef t Bb ((f - 1 : ℕ) : ℤ)) (E8 : ESp eK t Bb ((2 : ℤ) ^ K)) :
    IRuns I iprog (rotU l.sgn l.b eP eQ eB ed0 ed1 er ef eK) t
      (t.upd 0 (ints (pull [P, 2 ^ (f * K), B] [P, 2 ^ (f * K), B]
        (KIL.rotAddr (2 ^ (f * K)) (tabA K ρ f d0 d1 (2 ^ (f * K)) l)) 0 xs) ++ R))
      (NLogN.KFX.cRotU K f l.b P (2 ^ (f * K)) B w Bb) := by
  set Q := 2 ^ (f * K) with hQe
  have hQ0 : 0 < Q := by positivity
  set pl := rotPl eP eQ eB ed0 ed1 er ef eK
  have hE : ∀ p ∈ pl, ∃ v, ESp p.2 t Bb v := by
    intro p hp
    simp only [pl, rotPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, E1⟩, ⟨_, E2⟩, ⟨_, E3⟩, ⟨_, E4⟩, ⟨_, E5⟩, ⟨_, E6⟩, ⟨_, E7⟩, ⟨_, E8⟩]
  have hl : NLogN.KIL.PushOK t Bb pl := pushOK_of (by
    intro p hp; simp only [pl, rotPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide))
    (noLow_rotPl n1 n2 n3 n4 n5 n6 n7 n8) hE
  have ev : evalP t pl = [(1, (P : ℤ)), (2, ((Q : ℕ) : ℤ)), (4, (B : ℤ)), (3, (d0 : ℤ)),
      (5, (d1 : ℤ)), (6, (2 : ℤ) ^ ρ), (7, ((f - 1 : ℕ) : ℤ)), (8, (2 : ℤ) ^ K)] := by
    simp only [evalP, pl, rotPl, List.map_cons, List.map_nil, E1.ev, E2.ev, E3.ev, E4.ev, E5.ev,
      E6.ev, E7.ev, E8.ev]
  have hnd : (pl.map Prod.fst).Nodup := by simp only [pl, rotPl, List.map_cons, List.map_nil]; decide
  set u := pushSt t (evalP t pl)
  -- the table, uniformly
  have TG := tabGen_fsp hK hρK hf hd0 hd1 hQ0 l hs hb hB2 hbig zd0 zd1 le_rfl P zP u
    (fun _ => []) rfl rfl
  rw [encK_nil, ← encK_upd, encK_nil] at TG
  simp only [List.append_nil] at TG
  set σ := σT P (Q : ℕ) d0 d1 (2 ^ ρ) (f - 1 : ℕ) (2 ^ K)
  have hag : Agree σ u := by
    refine agree_pushSt t _ (by rw [evalP_fst]; exact hnd) (fun i v hv => ?_)
    rw [ev]
