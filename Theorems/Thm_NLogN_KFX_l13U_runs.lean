namespace NLogN.KFL

open AModel

theorem rix_id {α : Type*} {V : ℕ} (d : α) {xs : List α} (h : xs.length = V) :
    rix V id d xs = xs := by
  apply List.ext_getElem (by simp [h])
  intro j h1 h2
  simp only [length_rix] at h1
  simp [rix, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2]

namespace Geo

variable (g : Geo)

variable {g}

end Geo

section Phi

variable {g : Geo} (hg : g.Pos)
include hg

end Phi

theorem rixT_id {g : Geo} {xs : List ℤ} (h : xs.length = g.V) : rixT g id xs = xs := by
  unfold rixT
  rw [rix_congr (φ' := id) (fun j _ => phi_id j)]
  exact rix_id 0 h

theorem TV_sw01 {Q : ℕ} (c : Tr) (h : NLogN.KFL.TV Q c) : NLogN.KFL.TV Q (sw01 c) := ⟨h.2.1, h.1, h.2.2⟩
theorem TV_sw12 {Q : ℕ} (c : Tr) (h : NLogN.KFL.TV Q c) : NLogN.KFL.TV Q (sw12 c) := ⟨h.1, h.2.2, h.2.1⟩
theorem TV_sw02 {Q : ℕ} (c : Tr) (h : NLogN.KFL.TV Q c) : NLogN.KFL.TV Q (sw02 c) := ⟨h.2.2, h.2.1, h.1⟩

/-- The rotation pull of `rotF` on `[P, Q, S]` as an index map. -/
theorem pull_rotAddr (P Q S : ℕ) (hQ : 0 < Q) (hS : 0 < S) (as : ℕ → ℕ) (xs : List ℤ) :
    AModel.pull [P, Q, S] [P, Q, S] (KIL.rotAddr Q as) 0 xs =
      rix (P * Q * S) (fun j => NLogN.KFL.sc Q S ((NLogN.KFL.gc Q S j + Q - as (j / (Q * S))) % Q) j) 0 xs := by
  apply List.ext_getElem (by simp [vol]; ring)
  intro j h1 h2
  simp only [length_pull, vol, List.prod_cons, List.prod_nil, mul_one] at h1
  rw [getElem_pull]
  simp only [rix, List.getElem_map, List.getElem_range]
  congr 1
  have hQS : 0 < Q * S := Nat.mul_pos hQ hS
  have hjp : j / (Q * S) < P := by
    rw [Nat.div_lt_iff_lt_mul hQS]; linarith
  simp only [decode, encode, KIL.rotAddr, vol, List.prod_cons, List.prod_nil, mul_one,
    List.getD_cons_zero, List.getD_cons_succ, List.headD_cons, List.tail_cons, Nat.div_one,
    List.getD_cons_zero]
  rw [Nat.mod_eq_of_lt hjp]
  unfold NLogN.KFL.sc NLogN.KFL.gc
  have e1 : j % (Q * S) / S % Q = j / S % Q := by
    rw [mul_comm Q S, Nat.mod_mul_right_div_self, Nat.mod_mod]
  have e2 : j % (Q * S) % S = j % S := by
    rw [Nat.mod_mul_left_mod]
  rw [Nat.mod_eq_of_lt (Nat.mod_lt _ hS)] at *
  simp only [e1, e2, Nat.mod_mod]
  ring_nf

theorem TV_rot2 {Q : ℕ} (hQ : 0 < Q) (a : ℕ → ℕ → ℕ) (c : Tr) (h : NLogN.KFL.TV Q c) : NLogN.KFL.TV Q (rot2 Q a c) :=
  ⟨h.1, h.2.1, Nat.mod_lt _ hQ⟩

/-- **`rotF` on the rectangle**: the view `[N0 Q N1 Q N2, Q, N3 B]` with the table
`as p = a (slot 0) (slot 1)` is the triple map `rot2`. -/
theorem pull_rot (g : Geo) (hg : g.Pos) (a : ℕ → ℕ → ℕ) (as : ℕ → ℕ)
    (has : ∀ p, as p = a (p / (g.N2 * g.Q * g.N1) % g.Q) (p / g.N2 % g.Q)) (xs : List ℤ) :
    AModel.pull [g.N0 * g.Q * g.N1 * g.Q * g.N2, g.Q, g.S2] [g.N0 * g.Q * g.N1 * g.Q * g.N2, g.Q, g.S2]
      (KIL.rotAddr g.Q as) 0 xs = rixT g (rot2 g.Q a) xs := by
  rw [pull_rotAddr _ _ _ hg.q hg.s2]
  have hV : g.N0 * g.Q * g.N1 * g.Q * g.N2 * g.Q * g.S2 = g.V := by
    simp only [Geo.V, Geo.S0, Geo.S1]; ring
  rw [hV]
  unfold rixT
  refine rix_congr (fun j hj => ?_) _ _
  have hT := TV_rot2 hg.q a
  have e : ((NLogN.KFL.sc g.Q g.S2 ((NLogN.KFL.gc g.Q g.S2 j + g.Q - as (j / (g.Q * g.S2))) % g.Q) j : ℕ) : ℤ) =
      phi g (rot2 g.Q a) j := by
    rw [sc_int, phi_int hg hT]
    have h0 : j / (g.Q * g.S2) / (g.N2 * g.Q * g.N1) % g.Q = NLogN.KFL.gc g.Q g.S0 j := by
      unfold NLogN.KFL.gc; rw [Nat.div_div_eq_div_mul]; congr 2; simp only [Geo.S0, Geo.S1]; ring
    have h1 : j / (g.Q * g.S2) / g.N2 % g.Q = NLogN.KFL.gc g.Q g.S1 j := by
      unfold NLogN.KFL.gc; rw [Nat.div_div_eq_div_mul]; rfl
    simp only [trOf, rot2, has, h0, h1]; ring
  exact_mod_cast e

/-- Setting a sub-chunk: the `2`-field at stride `D S` inside the `Q`-chunk at stride `S`
(`Q = 2 D E`). -/
theorem gc_sub {Q S D E : ℕ} (hQ : Q = 2 * D * E) (hD : 0 < D) (hS : 0 < S) (hE : 0 < E) (j : ℕ) :
    NLogN.KFL.gc 2 (D * S) j = NLogN.KFL.gc 2 D (NLogN.KFL.gc Q S j) := by
  unfold NLogN.KFL.gc
  rw [mul_comm D S, ← Nat.div_div_eq_div_mul]
  rw [hQ, show 2 * D * E = D * (2 * E) by ring, Nat.mod_mul_right_div_self, Nat.mod_mul_right_mod]

theorem sc_sub {Q S D E : ℕ} (hQ : Q = 2 * D * E) (hD : 0 < D) (hS : 0 < S) (hE : 0 < E)
    {v : ℕ} (hv : v < 2) (j : ℕ) :
    NLogN.KFL.sc 2 (D * S) v j = NLogN.KFL.sc Q S (NLogN.KFL.sc 2 D v (NLogN.KFL.gc Q S j)) j := by
  have h1 := sc_int 2 (D * S) v j
  have h2 := sc_int Q S (NLogN.KFL.sc 2 D v (NLogN.KFL.gc Q S j)) j
  have h3 := sc_int 2 D v (NLogN.KFL.gc Q S j)
  rw [gc_sub hQ hD hS hE] at h1
  have : (NLogN.KFL.sc 2 (D * S) v j : ℤ) = NLogN.KFL.sc Q S (NLogN.KFL.sc 2 D v (NLogN.KFL.gc Q S j)) j := by
    rw [h1, h2, h3]; push_cast; ring
  exact_mod_cast this

/-- **`rotF` on a bit field**: the view `[N0 Q N1 E, 2, D S1]` (bit `D` of slot 1) with the table
`as p = b (slot 0)` is the triple map `flip1`. -/
theorem pull_bit (g : Geo) (hg : g.Pos) {D E : ℕ} (hQ : g.Q = 2 * D * E) (hD : 0 < D) (hE : 0 < E)
    (b : ℕ → ℕ) (as : ℕ → ℕ) (has : ∀ p, as p = b (p / (g.N1 * E) % g.Q)) (xs : List ℤ) :
    AModel.pull [g.N0 * g.Q * g.N1 * E, 2, D * g.S1] [g.N0 * g.Q * g.N1 * E, 2, D * g.S1]
      (KIL.rotAddr 2 as) 0 xs = rixT g (flip1 D b) xs := by
  rw [pull_rotAddr _ _ _ (by norm_num) (Nat.mul_pos hD hg.s1)]
  have hV : g.N0 * g.Q * g.N1 * E * 2 * (D * g.S1) = g.V := by
    simp only [Geo.V, Geo.S0]; rw [hQ]; ring
  rw [hV]
  unfold rixT
  refine rix_congr (fun j hj => ?_) _ _
  have hT := TV_flip1 hQ hD hE b
  have hx : j / (2 * (D * g.S1)) / (g.N1 * E) % g.Q = NLogN.KFL.gc g.Q g.S0 j := by
    unfold NLogN.KFL.gc; rw [Nat.div_div_eq_div_mul]; congr 2; simp only [Geo.S0]; rw [hQ]; ring
  rw [has, hx, sc_sub hQ hD hg.s1 hE (Nat.mod_lt _ (by norm_num))]
  have e : ((NLogN.KFL.sc g.Q g.S1 (NLogN.KFL.sc 2 D ((NLogN.KFL.gc 2 (D * g.S1) j + 2 - b (NLogN.KFL.gc g.Q g.S0 j)) % 2)
      (NLogN.KFL.gc g.Q g.S1 j)) j : ℕ) : ℤ) = phi g (flip1 D b) j := by
    rw [sc_int, phi_int hg hT]
    simp only [trOf, flip1, gc_sub hQ hD hg.s1 hE]; ring
  exact_mod_cast e

end NLogN.KFL

end

