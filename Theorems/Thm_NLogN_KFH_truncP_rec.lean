section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFH
open IntMul RS AModel KIL KFD KFB Complex
theorem NLogN.KFH.truncP_rec (s : NLogN.IState NLogN.HS) {r p Δ w : ℕ} (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI)
    (xs : List (Fin r → ℂ)) (l : List ℤ) (hx : NLogN.KFH.RecRep r (p + Δ) zs xs)
    (h0 : f 0 = NLogN.KFB.gflat zs ++ l) (hC : NLogN.KFB.Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : NLogN.zsz ((2 * zs.length : ℕ) : ℤ) ≤ Z) :
    NLogN.KFH.RecRep r p (zs.map (NLogN.KFH.gtr Δ)) (Butterfly.QpArr p xs) ∧ NLogN.KFB.GB w (zs.map (NLogN.KFH.gtr Δ)) ∧
      NLogN.KFD.FSp (NLogN.KFH.truncP Δ (2 * zs.length)) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (zs.map (NLogN.KFH.gtr Δ)) ++ l)))
        (NLogN.KFH.cTrunc w Δ (2 * zs.length) Z) := by
  refine ⟨NLogN.KFH.truncP_rep hx, NLogN.KFH.GB_map_gtr hb, ?_⟩
  have H := NLogN.KFH.truncP_fsp s Δ w f (NLogN.KFB.gflat zs) l h0 hC hb.bnd Z (by simpa using hZ)
  rw [NLogN.KFB.length_gflat, ← NLogN.KFH.gflat_map_gtr] at H
  exact H
end
