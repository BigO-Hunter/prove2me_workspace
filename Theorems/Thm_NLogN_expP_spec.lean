      simp [NLogN.expPost, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.IState.upd_G, hj8, hj9, this, fj j hlo]
    · have : j = 30 ∨ j = 31 ∨ j = 32 ∨ j = 33 ∨ j = 34 ∨ j = 35 ∨ j = 36 ∨ j = 37 ∨ j = 38 ∨
          j = 39 := by
