@[simp] theorem fdiv_pow2_eval (s : IState HS) (a b : Ex HS) :
    (fdiv a (.pow2 b)).eval s = a.eval s / 2 ^ (b.eval s).toNat :=
  fdiv_eval s a _ (by simp only [eval]; positivity)

