    NLogN.expP.ok s ∧ NLogN.expP.run s = (s.upd 8 (.int (expBits n x y).1 :: s.G 8)).upd 9
      (.int (expBits n x y).2 :: s.G 9) := by
  obtain ⟨hpre, -⟩ := NLogN.exp_pre n x y s L5 L6 L7 h5 h6 h7
  obtain ⟨hlok, hrun⟩ := NLogN.exp_loop n x y s L5 L6 L7 h5 h6 h7
  obtain ⟨f30, f31, f32, f33, f34, f35, f36, f37, f38, -, fj⟩ :=
    NLogN.exp_inv_all n x y s L5 L6 L7 h5 h6 h7 (2 * n + 13) le_rfl
  have e8 : ((n : ℤ) + 8).toNat = n + 8 := by omega
  have e9 : ((n : ℤ) + 9).toNat = n + 9 := by omega
  have f5 := fj 5 (by decide)
  rw [h5] at f5
  refine ⟨⟨hpre, hlok, ?_⟩, ?_⟩
  · rw [hrun]
    simp (config := {decide := true}) only [NLogN.expPost, NLogN.RS.seqL, NLogN.RS.ok, NLogN.RS.run_seq, NLogN.RS.run_push_G,
      NLogN.RS.run_pop_G, NLogN.IState.upd_G, NLogN.IState.IsInt, NLogN.IState.top, if_true, if_false, List.tail_cons,
      f30, f31, f32, f33, f34, f35, f36, f37, f38, NLogN.rndE, NLogN.Ex.Clean, NLogN.Ex.fdiv_regs, NLogN.Ex.regs, NLogN.zX_all]
    refine ⟨⟨trivial, trivial, ?_⟩, ⟨trivial, trivial, ?_⟩, by simp⟩
    all_goals (apply NLogN.Ex.fdiv_ok) <;> simp (config := {decide := true}) [NLogN.Ex.ok, NLogN.Ex.eval,
      NLogN.IState.IsInt, NLogN.IState.top, NLogN.IState.upd_G, f5, f36, f37, NLogN.RS.run_push_G] <;> omega
  · show NLogN.expPost.run ((NLogN.RS.rep 39 NLogN.eKE NLogN.expBody).run (NLogN.expPre.run s)) = _
    rw [hrun]
    refine NLogN.RS.run_ext ?_ ?_ ?_
    rotate_left
    · simp only [NLogN.IState.upd_ip]
      exact (NLogN.RS.repSt_ip_out _ _ _ _ _).1.trans (NLogN.RS.run_ip_out _ s).1
    · simp only [NLogN.IState.upd_out]
      exact (NLogN.RS.repSt_ip_out _ _ _ _ _).2.trans (NLogN.RS.run_ip_out _ s).2
    intro j
    by_cases hj8 : j = 8
    · subst hj8
      simp (config := {decide := true}) [NLogN.expPost, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.rndE, NLogN.Ex.eval, NLogN.IState.top,
        NLogN.IState.upd_G, f36, f5, fj 8 (by decide), e8, e9, expBits]
    by_cases hj9 : j = 9
    · subst hj9
      simp (config := {decide := true}) [NLogN.expPost, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.rndE, NLogN.Ex.eval, NLogN.IState.top,
        NLogN.IState.upd_G, f37, f5, fj 9 (by decide), e8, e9, expBits]
    by_cases hlo : j.val < 30 ∨ 39 < j.val
    · have : j ≠ 30 ∧ j ≠ 31 ∧ j ≠ 32 ∧ j ≠ 33 ∧ j ≠ 34 ∧ j ≠ 35 ∧ j ≠ 36 ∧ j ≠ 37 ∧ j ≠ 38 ∧
          j ≠ 39 := by
