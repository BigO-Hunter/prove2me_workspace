    (hQe : g.Q = 2 ^ (f * K)) (zs : List ℤ) :
    NLogN.KFL.rixT g (NLogN.KFL.XLc K ρ f) (NLogN.KFL.rixT g (NLogN.KFL.corrc K ρ f) (NLogN.KFL.rixT g (NLogN.KFL.FSc K ρ f) zs)) = NLogN.KFL.rixT g (NLogN.KFL.RAc K ρ f) zs := by
