  have TC : ∀ c, NLogN.KFL.TV g.Q c → NLogN.KFL.TV g.Q (NLogN.KFL.corrc K ρ f c) := fun c hc =>
    hQe ▸ NLogN.KFL.TV_S0c _ (NLogN.KFL.TV_T0c c (hQe ▸ hc))
  have TX : ∀ c, NLogN.KFL.TV g.Q c → NLogN.KFL.TV g.Q (NLogN.KFL.XLc K ρ f c) := fun c hc => hQe ▸ NLogN.KFL.TV_XLc c hρK hf (hQe ▸ hc)
  rw [NLogN.KFL.rixT_rixT hg TF TC, NLogN.KFL.rixT_rixT hg (F := NLogN.KFL.FSc K ρ f ∘ NLogN.KFL.corrc K ρ f) (fun c hc => TF _ (TC c hc)) TX]
  refine NLogN.KFL.rixT_congr hg (fun c hc => ?_) _
  simp only [Function.comp_apply, NLogN.KFL.corrc]
  have hx := TX c hc
  rw [hQe] at hx
  rw [NLogN.KFL.FSc_S0c _ (NLogN.KFL.TV_T0c _ hx), NLogN.KFL.T0c_XLc hK hf]
