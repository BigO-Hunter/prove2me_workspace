variable {K ρ f : ℕ}

theorem TV_XLc (c : Tr) (hρK : ρ < K) (hf : 1 ≤ f) (hc : TV (2 ^ (f * K)) c) :
    TV (2 ^ (f * K)) (XLc K ρ f c) := by
  have hQ : 2 ^ (f * K) = 2 * 2 ^ (ρ + (f - 1) * K) * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) := by
    rw [← pow_succ', ← pow_add]; congr 1
    obtain ⟨g, rfl⟩ : ∃ g, f = g + 1 := ⟨f - 1, by omega⟩
    simp only [Nat.add_sub_cancel]
    have : ρ + g * K + 1 ≤ (g + 1) * K := by nlinarith
    omega
  exact TV_flip1 hQ (by positivity) (by positivity) _ c hc

end Facts

end NLogN.KFL

