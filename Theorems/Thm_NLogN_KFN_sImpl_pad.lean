open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

section Lists

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {M : Type*} [AddCommMonoid M] [Module ℂ M]

theorem selOpF_pad {st : ι → ℕ} {n np : ℕ} (hs : SLaws st n) (hnp : n ≤ np)
    (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) {xs : List M} (hl : xs.length = n) (ys : List M) :
    (selOpF st np T (xs ++ ys)).take n = selOpF st n T xs := by
  apply List.ext_getElem (by simp; omega)
  intro j h1 h2
  simp only [length_selOpF] at h2
  rw [List.getElem_take, ← List.getD_eq_getElem _ 0, ← List.getD_eq_getElem _ 0,
    getD_selOpF _ _ _ _ (by omega), getD_selOpF _ _ _ _ h2]
  refine Finset.sum_congr rfl fun y _ => ?_
  rw [List.getD_append _ _ _ _ (by rw [hl]; exact hs.lt j h2 y)]

end Lists

end NLogN.KFN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFN
open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly
theorem NLogN.KFN.sImpl_pad {Pp : ℕ} {Isym : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    {ι : Type*} [Fintype ι] [DecidableEq ι] {r : ℕ} {st : ι → ℕ} {n np : ℕ}
    (hs : NLogN.KFN.SLaws st n) (hnp : n ≤ np) {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ}
    {code : ℕ → NLogN.IStmt NLogN.HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (h : NLogN.KFN.SImplI Isym iprog r st np T code e dw cost) (Z : ℕ)
    (hZ : NLogN.zsz ((2 * ((np - n) * r) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFN.SImplI Isym iprog r st n T (NLogN.KFN.padC (2 * (n * r)) (2 * ((np - n) * r)) code) e dw
      (fun w => NLogN.KFN.cPadC (2 * (n * r)) (2 * ((np - n) * r)) Z w dw cost) := by
  intro s f zs l xs F w hC h0 hx hl hb
  have hzl : zs.length = n * r := by rw [hx.1, hl]
  have hL0 : (NLogN.KFB.gflat zs).length = 2 * (n * r) := by rw [NLogN.KFB.length_gflat, hzl]
  set Q := 2 * ((np - n) * r) with hQ
  set zpad := zs ++ List.replicate ((np - n) * r) ((0, 0) : NLogN.KFB.GI) with hzpad
  have hfqP : f NLogN.KFB.qP = [] := hC.cl.p
  have hq0 : (0 : Fin NLogN.HS) ≠ qP := by decide
  have hc0 : (NLogN.KFB.c1 : Fin NLogN.HS) ≠ 0 := by decide
  have hcq : (NLogN.KFB.c1 : Fin NLogN.HS) ≠ qP := by decide
  have hfc1 : f NLogN.KFB.c1 = [] := hC.t.c1
  -- 1. park
  have m1 := NLogN.KFN.mv_fsp (X := 0) (Y := NLogN.KFB.qP) (by decide) (by decide) (by decide) (by decide) (by decide)
    s f (NLogN.KFB.gflat zs) l (by rw [h0]) w hb.bnd
  rw [hL0] at m1
  set f1 := Function.update (Function.update f 0 l) NLogN.KFB.qP ((NLogN.KFB.gflat zs).reverse ++ f NLogN.KFB.qP)
  -- 2. zeros
  have m2 := NLogN.KFD.FSp.zeroK (Y := 0) (C := NLogN.KFB.c1) (by decide) (by decide) (by decide) s f1 Q
    (by simp only [f1]; rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide)]
        exact hfc1) Z hZ
  set f2 := Function.update f1 0 (List.replicate Q 0 ++ f1 0)
  -- 3. unpark
  have m3 := NLogN.KFN.mv_fsp (X := NLogN.KFB.qP) (Y := 0) (by decide) (by decide) (by decide) (by decide) (by decide)
    s f2 (NLogN.KFB.gflat zs).reverse [] (by
      simp only [f2, f1]
      rw [Function.update_of_ne hq0.symm, Function.update_self, hfqP, List.append_nil])
      w (NLogN.KIL.bnd_reverse hb.bnd)
  rw [List.length_reverse, hL0, List.reverse_reverse] at m3
  have e3 : Function.update (Function.update f2 NLogN.KFB.qP []) 0 (NLogN.KFB.gflat zs ++ f2 0) =
      Function.update f 0 (NLogN.KFB.gflat zpad ++ l) := by
    funext j
    simp only [f2, f1, Function.update_apply]
    by_cases hj0 : j = 0
    · subst hj0
      simp [hzpad, NLogN.KFB.gflat_append, NLogN.KFN.gflat_zeros, hQ, hq0]
    · by_cases hjq : j = NLogN.KFB.qP
      · subst hjq; simp [hfqP, hq0.symm]
      · simp [hj0, hjq]
  rw [e3] at m3
  -- 4. the program on the padded stream
  obtain ⟨zs', r1, b1, f4⟩ := h s (Function.update f 0 (NLogN.KFB.gflat zpad ++ l)) zpad l
    (xs ++ List.replicate (np - n) 0) F w (hC.upd0 _) (by simp) (NLogN.KFN.recRep_pad hx (np - n))
    (by simp [hl]; omega) (NLogN.KFB.GB_append.2 ⟨hb, NLogN.KFN.GB_zeros _ _⟩)
  rw [Function.update_idem] at f4
  have hz' : zs'.length = np * r := by
    rw [r1.1, NLogN.KFN.length_selOpF]
  set g4 := Function.update f 0 (NLogN.KFB.gflat zs' ++ l)
  have hsplit : NLogN.KFB.gflat zs' = NLogN.KFB.gflat (zs'.take (n * r)) ++ NLogN.KFB.gflat (zs'.drop (n * r)) := by
    rw [← NLogN.KFB.gflat_append, List.take_append_drop]
  have hLt : (NLogN.KFB.gflat (zs'.take (n * r))).length = 2 * (n * r) := by
    rw [NLogN.KFB.length_gflat, List.length_take, hz', Nat.min_eq_left (Nat.mul_le_mul_right _ hnp)]
  have hLd : (NLogN.KFB.gflat (zs'.drop (n * r))).length = Q := by
    rw [NLogN.KFB.length_gflat, List.length_drop, hz', hQ, Nat.sub_mul]
  -- 5. park the kept part
  have m5 := NLogN.KFN.mv_fsp (X := 0) (Y := NLogN.KFB.qP) (by decide) (by decide) (by decide) (by decide) (by decide)
    s g4 (NLogN.KFB.gflat (zs'.take (n * r))) (NLogN.KFB.gflat (zs'.drop (n * r)) ++ l)
    (by simp only [g4, Function.update_self, hsplit, List.append_assoc]) (w + dw)
    (NLogN.KFN.GB_take b1 _).bnd
  rw [hLt] at m5
  set g5 := Function.update (Function.update g4 0 (NLogN.KFB.gflat (zs'.drop (n * r)) ++ l)) NLogN.KFB.qP
    ((NLogN.KFB.gflat (zs'.take (n * r))).reverse ++ g4 NLogN.KFB.qP)
  -- 6. drop the padding
  have m6 := NLogN.KFD.FSp.dropK (X := 0) (C := NLogN.KFB.c1) (by decide) (by decide) (by decide) s g5
    (NLogN.KFB.gflat (zs'.drop (n * r))) l (by
      simp only [g5]
      rw [Function.update_of_ne hq0, Function.update_self]) (by
      simp only [g5, g4]
      rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
        Function.update_of_ne (by decide)]
      exact hfc1) (w + dw) Z (NLogN.KFN.GB_drop b1 _).bnd (by rw [hLd]; exact hZ)
  rw [hLd] at m6
  set g6 := Function.update g5 0 l
  -- 7. unpark
  have m7 := NLogN.KFN.mv_fsp (X := NLogN.KFB.qP) (Y := 0) (by decide) (by decide) (by decide) (by decide) (by decide)
    s g6 (NLogN.KFB.gflat (zs'.take (n * r))).reverse [] (by
      simp only [g6, g5, g4]
      rw [Function.update_of_ne hq0.symm, Function.update_self, Function.update_of_ne hq0.symm,
        hfqP, List.append_nil]) (w + dw)
    (NLogN.KIL.bnd_reverse (NLogN.KFN.GB_take b1 _).bnd)
  rw [List.length_reverse, hLt, List.reverse_reverse] at m7
  have e7 : Function.update (Function.update g6 NLogN.KFB.qP []) 0 (NLogN.KFB.gflat (zs'.take (n * r)) ++ g6 0) =
      Function.update f 0 (NLogN.KFB.gflat (zs'.take (n * r)) ++ l) := by
    funext j
    simp only [g6, g5, g4, Function.update_apply]
    by_cases hj0 : j = 0
    · subst hj0; simp [hq0]
    · by_cases hjq : j = NLogN.KFB.qP
      · subst hjq; simp [hfqP, hq0.symm]
      · simp [hj0, hjq]
  rw [e7] at m7
  refine ⟨zs'.take (n * r), ?_, NLogN.KFN.GB_take b1 _, ?_⟩
  · have := NLogN.KFN.recRep_take' r1 (n := n) (by rw [NLogN.KFN.length_selOpF]; exact hnp)
    rwa [NLogN.KFN.selOpF_pad hs hnp T hl] at this
  · have P1 : NLogN.KFD.FSp (NLogN.KFN.padPre (2 * (n * r)) Q) _ _ _ := m1.seq (m2.seq m3)
    have P2 : NLogN.KFD.FSp (NLogN.KFN.padPost (2 * (n * r)) Q) _ _ _ := m5.seq (m6.seq m7)
    have H := (P1.irun (I := Isym) (iprog := iprog) (NLogN.KFN.fok_padPre _ _)).seq
      (f4.seq (P2.irun (I := Isym) (iprog := iprog) (NLogN.KFN.fok_padPost _ _)))
    refine H.mono (le_of_eq ?_)
    unfold NLogN.KFN.cPadC; ring
end
