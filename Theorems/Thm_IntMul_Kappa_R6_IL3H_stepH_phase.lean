open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## Expressions over a register assignment -/

namespace ExV

variable {σ : Fin HS → Option ℤ} {B : ℕ}

end ExV

theorem pushSeq_nil (σ : Fin HS → Option ℤ) : PushSeq σ [] [] 1 := by
  simp [PushSeq]

theorem pushSeq_cons {σ : Fin HS → Option ℤ} {i : Fin HS} {e : Ex HS} {v : ℤ} {c1 c2 : ℕ}
    {l : List (Fin HS × Ex HS)} {vl : List (Fin HS × ℤ)} (hi : i.val < 56) (hc : e.Clean)
    (he : ExC σ e v c1) (hr : PushSeq (Function.update σ i (some v)) l vl c2) :
    PushSeq σ ((i, e) :: l) ((i, v) :: vl) (c1 + (2 * moveCost (zsz v) + 19) + c2) := by
  simp only [PushSeq, true_and]
  exact ⟨hi, hc, c1 + (2 * moveCost (zsz v) + 19), c2, le_rfl,
    fun t ht => let ⟨a, b, d⟩ := he t ht; ⟨a, b, by omega⟩, hr⟩

/-! ## The phase step -/

theorem uE_size (a b : ℕ) : (uE a b).size = 7 := rfl

theorem uE_val (k0 k1 F : ℕ) :
    (((k0 % 4 : ℕ) : ℤ) + ((k1 % 4 : ℕ) : ℤ) * (F : ℤ)) % 4 = (((k0 + k1 * F) % 4 : ℕ) : ℤ) := by
  have h : (k0 % 4 + k1 % 4 * F) % 4 = (k0 + k1 * F) % 4 := by
    simp [Nat.add_mod, Nat.mul_mod, Nat.mod_mod]
  have := congrArg (Nat.cast : ℕ → ℤ) h
  push_cast at this ⊢
  exact this

/-- The phase constant on `wU`. -/
theorem uE_exv {σ : Fin HS → Option ℤ} {F Z : ℕ} (hF : σ wF = some (F : ℤ)) (k0 k1 : ℕ)
    (hZ : zsz ((6 * F + 6 : ℕ) : ℤ) ≤ Z) :
    ExV σ (uE (k0 % 4) (k1 % 4)) (((k0 + k1 * F) % 4 : ℕ) : ℤ) Z := by
  have h0 : k0 % 4 ≤ 3 := by omega
  have h1 : k1 % 4 ≤ 3 := by omega
  have hb : ∀ x : ℕ, x ≤ 6 * F + 6 → zsz (x : ℤ) ≤ Z := fun x hx => le_trans (zsz_natCast_le hx) hZ
  have hF1 : (k1 % 4) * F ≤ 3 * F := Nat.mul_le_mul_right _ h1
  have H := ExV.nmod (σ := σ) (B := Z)
    (ExV.add (ExV.lit (σ := σ) (B := Z) (c := ((k0 % 4 : ℕ) : ℤ)) (hb _ (by omega)))
      (ExV.mul (ExV.lit (σ := σ) (B := Z) (c := ((k1 % 4 : ℕ) : ℤ)) (hb _ (by omega)))
        (ExV.reg hF (hb _ (by omega)))
        (zszN (n := k1 % 4 * F) (by push_cast; ring) (by omega) hZ))
      (zszN (n := k0 % 4 + k1 % 4 * F) (by push_cast; ring) (by omega) hZ))
    (ExV.lit (σ := σ) (B := Z) (c := 4) (hb 4 (by omega)))
    (by positivity) (by norm_num)
    (zszN (n := (k0 % 4 + k1 % 4 * F) % 4) (by push_cast; ring_nf) (by omega) hZ)
  exact H.congr (uE_val k0 k1 F)

theorem zsz4 {N Z : ℕ} (hN : 4 ≤ N) (hZ : zsz (N : ℤ) ≤ Z) : zsz (((4 : ℕ) : ℤ)) ≤ Z :=
  le_trans (zsz_natCast_le hN) hZ

end NLogN.KFW

