  have hok : (Ex.neg (.reg sFL) : Ex HS).ok (encK s G) := ok_reg gF
  have hbd : (Ex.neg (.reg sFL) : Ex HS).Bnd (encK s G) Bb := bnd_reg gF zF
  have hev : (Ex.neg (.reg sFL) : Ex HS).eval (encK s G) = -flagV κ k := by
    simp only [Ex.eval]; rw [top_encK gF]
  have h0 : G 0 = restR (fun d => recs (γ d)) M (k + 1) ++ G0 0 := by
    simp +decide [G, P3, Function.update_apply]
  by_cases hm : κ k ≠ k
  · -- a moved destination: the sorted record of `γ k`
    have gB : G sKB = (recs (γ k)).reverse ++ (stkF (mvP κ) (fun d => (recs (γ d)).reverse) k ++ G0 sKB) := by
      simp +decide [G, P3, Function.update_apply, stkF_succ, mvP, hm]
    have S1 := FSp.mvL (X := sKB) (Y := 0) (C := NLogN.KFL.cMv) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s G _ _ gB 1 Bb (by intro a ha; exact hbits _ a (by simpa using ha))
      (by rw [List.length_reverse, hlen]; exact zB)
    rw [List.length_reverse, hlen, List.reverse_reverse] at S1
    set G1 := Function.update (Function.update G sKB (stkF (mvP κ) (fun d => (recs (γ d)).reverse) k
      ++ G0 sKB)) 0 (recs (γ k) ++ G 0)
    have g1K : G1 sKK = ((k / 2 ^ A : ℕ) : ℤ) :: (stkK (mvP κ) (fun d => ((d / 2 ^ A : ℕ) : ℤ)) k
        ++ G0 sKK) := by
      simp +decide [G1, G, P3, Function.update_apply, stkK_succ, mvP, hm]
    have S2 := Sp.pop s G1 (B := Bb) (by decide) g1K (zK k hk)
    set G2 := Function.update G1 sKK (stkK (mvP κ) (fun d => ((d / 2 ^ A : ℕ) : ℤ)) k ++ G0 sKK)
    have T := S1.seq (FSp.of_norep rfl S2)
    have gF2 : G2 sFL = flagV κ k :: (flL κ k ++ G0 sFL) := by
      simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]; exact gF
    have S3 := Sp.pop s G2 (B := Bb) (by decide) gF2 zF
    have I := FSp.iteT hc hok trivial hbd (by rw [hev]; simp [flagV, hm]) T
      (b := NLogN.mvK sT 0 NLogN.KFL.cMv (.lit (B : ℤ)))
    refine ((I.seq (FSp.of_norep rfl S3)).congr ?_).mono ?_
    · congr 1
      funext r
      simp only [G2, G1, G, P3]
      by_cases a1 : r = sFL
      · subst a1; simp +decide
      by_cases a2 : r = sKK
      · subst a2; simp +decide
      by_cases a3 : r = sKB
      · subst a3; simp +decide
      by_cases a4 : r = sT
      · subst a4; simp +decide [stkF_succ, mvP, hm]
      by_cases a5 : r = 0
      · subst a5; simp +decide [restR_succ _ hk]
      simp [Function.update_apply, a1, a2, a3, a4, a5]
    · simp only [cP3, Ex.size]; omega
  · -- an unmoved record: `γ k = k`
    push_neg at hm
    have hγ : γ k = k := by have := hγκ k; rwa [hm] at this
    have gT : G sT = (recs k).reverse ++ (stkF (fun m => !mvP κ m) (fun m => (recs m).reverse) k
        ++ G0 sT) := by
      simp +decide [G, P3, Function.update_apply, stkF_succ, mvP, hm]
    have S1 := FSp.mvL (X := sT) (Y := 0) (C := NLogN.KFL.cMv) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s G _ _ gT 1 Bb (by intro a ha; exact hbits _ a (by simpa using ha))
      (by rw [List.length_reverse, hlen]; exact zB)
    rw [List.length_reverse, hlen, List.reverse_reverse] at S1
    set G1 := Function.update (Function.update G sT (stkF (fun m => !mvP κ m)
      (fun m => (recs m).reverse) k ++ G0 sT)) 0 (recs k ++ G 0)
    have gF1 : G1 sFL = flagV κ k :: (flL κ k ++ G0 sFL) := by
      simp only [G1]; rw [upd_ne (by decide), upd_ne (by decide)]; exact gF
    have S3 := Sp.pop s G1 (B := Bb) (by decide) gF1 zF
    have I := FSp.iteF hc hok trivial hbd (by rw [hev]; simp [flagV, hm]) S1
      (a := .seq (NLogN.mvK sKB 0 NLogN.KFL.cMv (.lit (B : ℤ))) (.pop sKK))
    refine ((I.seq (FSp.of_norep rfl S3)).congr ?_).mono ?_
    · congr 1
      funext r
      simp only [G1, G, P3]
      by_cases a1 : r = sFL
      · subst a1; simp +decide
      by_cases a2 : r = sKK
      · subst a2; simp +decide [stkK_succ, mvP, hm]
      by_cases a3 : r = sKB
      · subst a3; simp +decide [stkF_succ, mvP, hm]
      by_cases a4 : r = sT
      · subst a4; simp +decide
      by_cases a5 : r = 0
      · subst a5; simp +decide [restR_succ _ hk, hγ]
      simp [Function.update_apply, a1, a2, a3, a4, a5]
    · simp only [cP3, Ex.size]; omega

theorem P3_upd (κ γ : ℕ → ℕ) (recs : ℕ → List ℤ) (M A : ℕ) (G0 : Fin HS → List ℤ) (k : ℕ)
    {j : Fin HS} (h0 : j ≠ 0) (h1 : j ≠ sT) (h2 : j ≠ sKB) (h3 : j ≠ sKK) (h4 : j ≠ sFL)
    (v : List ℤ) :
    Function.update (P3 κ γ recs M A G0 k) j v = P3 κ γ recs M A (Function.update G0 j v) k := by
  funext i
  by_cases hi : i = j
  · subst hi; simp [P3, Function.update_apply, h0, h1, h2, h3, h4]
  · simp only [P3, Function.update_apply, hi, if_false]
    simp [Ne.symm h0, Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4]

theorem p3_fsp {κ γ : ℕ → ℕ} (hγκ : ∀ m, γ (κ m) = m) {recs : ℕ → List ℤ} {M A B Bb : ℕ}
    (hB2 : 2 ≤ Bb) (hlen : ∀ m, (recs m).length = B) (hbits : ∀ m, Bnd 1 (recs m))
    (zB : zsz (B : ℤ) ≤ Bb) (zK : ∀ d < M, zsz ((d / 2 ^ A : ℕ) : ℤ) ≤ Bb)
    (zM : zsz (M : ℤ) ≤ Bb) (s : IState HS) (G0 : Fin HS → List ℤ) (hc4 : G0 c4 = []) :
    FSp (p3Prog B M) (encK s (P3 κ γ recs M A G0 M)) (encK s (P3 κ γ recs M A G0 0))
      (cLp M (cP3 B Bb) Bb) := by
  have H := FSp.repLit (C := c4) (b := p3B B) (s := s)
    (F := fun j => P3 κ γ recs M A G0 (M - j)) (N := M) (c := cP3 B Bb) (Bb := Bb) (by decide)
    (fun j => by simp +decide [P3, Function.update_apply, hc4])
    (by simp +decide [p3B, NLogN.mvK, RS.writes]) zM ?_
  · simpa [p3Prog] using H
  · intro j hj
    rw [P3_upd _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      P3_upd _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)]
    have e : M - j = (M - (j + 1)) + 1 := by omega
    rw [e]
    exact p3B_fsp hγκ hB2 hlen hbits zB zK s _ (by omega)

section Lists

variable (κ γ : ℕ → ℕ) (recs : ℕ → List ℤ) (M A : ℕ)

theorem mvP_eq : mvP κ = fun m => !decide (κ m = m) := by funext m; simp [mvP]

theorem stkK_ent0 : stkK (mvP κ) (fun m => (κ m : ℤ)) M = (ent0 κ M recs).map (kh 0) := by
  simp [stkK, ent0, NLogN.KFL.mvL, mvP_eq, kh, List.map_map, Function.comp_def]

theorem stkF_ent0 : stkF (mvP κ) (fun m => (recs m).reverse) M = (ent0 κ M recs).flatMap Prod.snd := by
  simp only [stkF, ent0, NLogN.KFL.mvL, mvP_eq, ne_eq, List.flatMap_map, decide_not]

theorem length_ent0 : (ent0 κ M recs).length = nMv κ M := by
  simp [ent0, NLogN.KFL.mvL, nMv, mvP_eq, List.filter_reverse]

theorem stkK_ent1 : stkK (mvP κ) (fun d => ((d / 2 ^ A : ℕ) : ℤ)) M =
    (ent1 κ γ M recs).map (kh A) := by
  simp [stkK, ent1, NLogN.KFL.mvL, mvP_eq, kh, List.map_map, Function.comp_def]

theorem stkF_ent1 : stkF (mvP κ) (fun d => (recs (γ d)).reverse) M =
    (ent1 κ γ M recs).flatMap Prod.snd := by
  simp only [stkF, ent1, NLogN.KFL.mvL, mvP_eq, ne_eq, List.flatMap_map, decide_not]

end Lists

theorem fok_corrRS (K ρ f : ℕ) (g : Geo) (A : ℕ) : fok (corrRS K ρ f g A) = true := by
  rfl

set_option maxHeartbeats 4000000 in
/-- **The correction**: `flR recs M ↦ flR (recs ∘ corrR) M`. -/
theorem corrRS_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {g : Geo} (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = g.B)
    (hbits : ∀ m, Bnd 1 (recs m)) (s : IState HS) :
    FSp (corrRS K ρ f g (zsz (g.V : ℤ))) (encK s (Function.update (fun _ => []) 0 (flR recs g.recG.V)))
      (encK s (Function.update (fun _ => []) 0 (flR (fun d => recs (corrR K ρ f g d)) g.recG.V)))
      (cCorr K f g (zsz (g.V : ℤ)) (nMv (keyR K ρ f g) g.recG.V) (zsz (g.V : ℤ) + 3)) := by
  set κ := keyR K ρ f g
  set γ := corrR K ρ f g
  set M := g.recG.V
  set A := zsz (g.V : ℤ)
  set Bb := zsz (g.V : ℤ) + 3
  have hV : g.V < 2 ^ A := by
    have := natAbs_lt_zsz (g.V : ℤ); simpa using this
  have hbig : 4 * g.V < 2 ^ Bb := by
    have : 2 ^ Bb = 8 * 2 ^ A := by simp only [Bb, A]; rw [pow_add]; ring
    omega
  have hB2 : 2 ≤ Bb := by omega
  have hb4 : ((4 * g.V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  have hW : ∀ n : ℕ, n ≤ 4 * g.V → zsz (n : ℤ) ≤ Bb := fun n hn => zsz_of_le hb4 (by
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast hn)
  have hMV : M ≤ g.V := recG_V_le g hg
  have hBV : g.B ≤ g.V := by
    have := hg.v; rw [Geo.V_rec g] at this ⊢
    exact Nat.le_mul_of_pos_left _ (Nat.pos_of_mul_pos_right this)
  have hMB : M * g.B = g.V := (Geo.V_rec g).symm
  have hVp := hg.v
  have hγκ : ∀ m, γ (κ m) = m := corrR_keyR hg hQe
  have hκγ : ∀ m, κ (γ m) = m := keyR_corrR hg hQe
  have hκ : ∀ m < M, κ m < M := fun m hm => keyR_lt hg hQe hm
  have hγ : ∀ m < M, γ m < M := fun m hm => corrR_lt hg hQe hm
  have hAW : A ≤ 4 * g.V := by
    have := zsz_le_of_lt (z := (g.V : ℤ)) (m := g.V) (by simpa using Nat.lt_two_pow_self)
    omega
  set Gn : Fin HS → List ℤ := fun _ => []
  -- pushes
  have S1 := Sp.push s (Function.update Gn 0 (flR recs M)) (i := NLogN.KFL.rm) (e := .lit 0) (B := Bb)
    (by decide) (clean_lit _) trivial trivial (by rw [Ex.Bnd, zsz_zero]; omega)
  simp only [Ex.eval] at S1
  have S2 := Sp.push s (Function.update (Function.update Gn 0 (flR recs M)) NLogN.KFL.rm
      ((0 : ℤ) :: Function.update Gn 0 (flR recs M) NLogN.KFL.rm)) (i := rNB) (e := .lit 0) (B := Bb)
    (by decide) (clean_lit _) trivial trivial (by rw [Ex.Bnd, zsz_zero]; omega)
  simp only [Ex.eval] at S2
  have e2 : Function.update (Function.update (Function.update Gn 0 (flR recs M)) NLogN.KFL.rm
      ((0 : ℤ) :: Function.update Gn 0 (flR recs M) NLogN.KFL.rm)) rNB ((0 : ℤ) :: Function.update
      (Function.update Gn 0 (flR recs M)) NLogN.KFL.rm ((0 : ℤ) :: Function.update Gn 0 (flR recs M) NLogN.KFL.rm) rNB) =
      NLogN.KFL.P1 κ recs M Gn 0 := by
    funext r
    simp only [NLogN.KFL.P1, Gn]
    by_cases a1 : r = rNB
    · subst a1; simp +decide [nMv]
    by_cases a2 : r = NLogN.KFL.rm
    · subst a2; simp +decide
    by_cases a3 : r = 0
    · subst a3; simp +decide [restR_zero]
    simp [Function.update_apply, a1, a2, a3, stkF, stkK, flL]
  rw [e2] at S2
  -- pass 1
  have SP1 := p1_fsp hK hρK hf hg hQe hB2 hbig recs hlen hbits s Gn rfl rfl
  have g3 : NLogN.KFL.P1 κ recs M Gn M NLogN.KFL.rm = (M : ℤ) :: [] := by simp +decide [NLogN.KFL.P1, Function.update_apply, Gn]
  have S3 := Sp.pop s (NLogN.KFL.P1 κ recs M Gn M) (B := Bb) (by decide) g3 (hW _ (by omega))
  set G3 := Function.update (NLogN.KFL.P1 κ recs M Gn M) NLogN.KFL.rm []
  -- the sort
  set E := ent0 κ M recs
  have hE : ∀ e ∈ E, e.2.length = g.B ∧ Bnd 1 e.2 ∧ e.1 ≤ 4 * g.V := by
    intro e he
    simp only [E, ent0, List.mem_map] at he
    obtain ⟨m, hm, rfl⟩ := he
    have hmM := (mem_mvL.1 hm).1
    refine ⟨by simp [hlen], fun a ha => hbits m a (by simpa using ha), ?_⟩
    have := hκ m hmM; simp only; omega
  have hEl : E.length = nMv κ M := length_ent0 κ recs M
  have hEM : E.length ≤ M := by rw [hEl]; exact nMv_le κ M
  have hEW : (E.length + 1) * (g.B + 1) ≤ 4 * g.V := by nlinarith
  have hK0 : E.map (kh 0) = stkK (mvP κ) (fun m => (κ m : ℤ)) M := (stkK_ent0 κ recs M).symm
  have hB0 : E.flatMap Prod.snd = stkF (mvP κ) (fun m => (recs m).reverse) M :=
    (stkF_ent0 κ recs M).symm
  have SR := radix_fsp hB2 hW hAW s G3 E hE hEW (kk0 := []) (kb0 := []) (lnb := [])
    (by rw [hK0]; simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by rw [hB0]; simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn, hEl])
  rw [sort_moved hγκ hκγ hκ hγ (le_of_lt (lt_of_le_of_lt hMV hV)) recs, hEl] at SR
  set Gn' := Function.update Gn rNB [(nMv κ M : ℤ)]
  have e4 : Function.update (Function.update G3 sKK ((ent1 κ γ M recs).map (kh A) ++ []))
      sKB ((ent1 κ γ M recs).flatMap Prod.snd ++ []) = P3 κ γ recs M A Gn' M := by
    rw [← stkK_ent1 κ γ recs M A, ← stkF_ent1 κ γ recs M]
    funext r
    simp only [G3, NLogN.KFL.P1, P3, Gn', Gn]
    by_cases a1 : r = sKB
    · subst a1; simp +decide
    by_cases a2 : r = sKK
    · subst a2; simp +decide
    by_cases a3 : r = NLogN.KFL.rm
    · subst a3; simp +decide
    by_cases a4 : r = rNB
    · subst a4; simp +decide
    by_cases a5 : r = sFL
    · subst a5; simp +decide
    by_cases a6 : r = sT
    · subst a6; simp +decide
    by_cases a7 : r = 0
    · subst a7; simp +decide [restR_full]
    simp [Function.update_apply, a1, a2, a3, a4, a5, a6, a7]
  rw [e4] at SR
  -- pass 3
  have SP3 := p3_fsp (A := A) (M := M) hγκ hB2 hlen hbits (hW _ (by omega))
    (fun d hd => hW _ (le_trans (Nat.div_le_self _ _) (by omega))) (hW _ (by omega)) s Gn' rfl
  have g5 : P3 κ γ recs M A Gn' 0 rNB = (nMv κ M : ℤ) :: [] := by
    simp +decide [P3, Function.update_apply, Gn', Gn]
  have S5 := Sp.pop s (P3 κ γ recs M A Gn' 0) (B := Bb) (by decide) g5
    (hW _ (by have := nMv_le κ M; omega))
  have e5 : Function.update (P3 κ γ recs M A Gn' 0) rNB [] =
      Function.update (fun _ => []) 0 (flR (fun d => recs (γ d)) M) := by
    funext r
    simp only [P3, Gn', Gn]
    by_cases a1 : r = rNB
    · subst a1; simp +decide
    by_cases a7 : r = 0
    · subst a7; simp +decide [restR_zero]
    simp +decide [Function.update_apply, a1, a7, stkF, stkK, flL]
  rw [e5] at S5
  have H := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq (SP1.seq ((FSp.of_norep rfl S3).seq
    (SR.seq (SP3.seq (FSp.of_norep rfl S5))))))
  refine H.mono ?_
  clear H S1 S2 SP1 S3 SR SP3 S5
  have : cLp M (cP3 g.B Bb) Bb = cLp g.recG.V (cP3 g.B Bb) Bb := rfl
  simp only [cCorr, Ex.size]
  omega

end NLogN.KFL

end

