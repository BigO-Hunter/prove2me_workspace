  have S1 := FSp.mvL (X := 0) (Y := sT) (C := NLogN.KFL.cMv) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s G L l h0 1 Bb hLb (by rw [hL]; exact zB)
