theorem gc_mul {Q S B m b : ℕ} (hB : 0 < B) (hb : b < B) : gc Q (S * B) (m * B + b) = gc Q S m := by
  unfold gc
  rw [mul_comm S B, ← Nat.div_div_eq_div_mul]
  congr 2
