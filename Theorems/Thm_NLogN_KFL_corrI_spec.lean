theorem phi_lt {F : Tr → Tr} (hF : ∀ c, TV g.Q c → TV g.Q (F c)) {n : ℕ} (hn : n < g.V) :
    phi g F n < g.V := by
  obtain ⟨h0, h1, h2⟩ := hF _ (TV_trOf hg n)
  have hV : g.V = g.Q * g.S0 * g.N0 := rfl
  have hS0 : g.Q * g.S0 * g.N0 = g.Q * g.S1 * (g.N1 * g.Q * g.N0) := by
