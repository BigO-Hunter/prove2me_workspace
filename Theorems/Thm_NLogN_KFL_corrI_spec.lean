    simp only [G3, G2, G1]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
      upd_ne (by decide)]; exact hN
  have S4 := Sp.asgQ s G3 (i := rNB) (e := .add (.reg rNB) (.lit 1)) (B := Bb) (by decide) g3N zn
    (clean_add (clean_reg (by decide)) (clean_lit _)) ⟨ok_reg g3N, trivial⟩
    ⟨bnd_reg g3N zn, by simp only [Ex.Bnd, zsz_one]; exact hB1, by
      simp only [Ex.eval]; rw [top_encK g3N]; exact zn1⟩
  have ev4 : (Ex.add (.reg rNB) (.lit 1) : Ex HS).eval (encK s G3) = nb + 1 := by
    simp only [Ex.eval]; rw [top_encK g3N]
  rw [ev4] at S4
  have H := S1.seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq (FSp.of_norep rfl S4)))
  refine (H.congr ?_).mono ?_
  · congr 1
  · simp only [cBr, Ex.size]
    have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
    generalize (Bb + 2) ^ 2 = X at *
    generalize cLp B (250 * (1 + 2)) Bb = Y
    try omega

theorem goodB_fsp {B Bb : ℕ} (hB1 : 1 ≤ Bb) (s : IState HS) (G : Fin HS → List ℤ) (L l : List ℤ)
