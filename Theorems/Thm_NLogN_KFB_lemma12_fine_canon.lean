theorem NLogN.KFB.lemma12_fine_canon :
    ∃ T q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u : ℕ) (Pre G Suf : AModel.Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List NLogN.Sym) (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) (xs : List (ZMod 2))
        (LP LG LS LU : List ℤ),
      F NLogN.KIL.kP = (AModel.vol Pre : ℤ) :: LP → F NLogN.KIL.kG = (AModel.vol G : ℤ) :: LG → F NLogN.KIL.kS = (AModel.vol Suf : ℤ) :: LS →
      F NLogN.KIL.aU = (u : ℤ) :: LU → F 0 = NLogN.KIL.enc2 xs →
      F 8 = [] → F 9 = [] → F 10 = [] → F 11 = [] → F 15 = [] → F 20 = [] → F 21 = [] →
      F 23 = [] → F 24 = [] →
      xs.length = AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) →
      ∃ c : ℕ, NLogN.IRuns I (NLogN.KFD.progF ((NetProp7.bitQC NetProp7.ind₀).toCircuit 1) (NLogN.KIL.edgeTplQ (NetProp7.bitQC NetProp7.ind₀)))
        (NLogN.KFE.l12F q (100 ^ 3) (Fintype.card (NetScalar.Wr NetProp7.ind₀))) (NLogN.KIL.encK s F)
        (NLogN.KIL.encK s (Function.update F 0 (NLogN.KIL.enc2 (AModel.pull (AModelL12.binShape Pre G Suf (2 ^ u))
          (AModelL12.binShape Pre G Suf (2 ^ u)) (AModel.swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs))))
        c ∧
        (c : ℝ) ≤ K * ((AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) + 1) *
          (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  obtain ⟨T, q₀, cE, H⟩ := NLogN.KFE.lemma12_fine
  refine ⟨T, q₀, fun q hq hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q hq hq₀
  set A := NLogN.zsz ((T * (q ^ 2 + 1) ^ 2 : ℕ) : ℤ) + 1
  obtain ⟨D, hD0, hD⟩ := NLogN.KFB.overhead_le cE A
  refine ⟨K * (1 + D), by positivity, fun u Pre G Suf hu hPre hG hS I s F xs LP LG LS LU FP FG
    FS FU F0 F8 F9 F10 F11 F15 F20 F21 F23 F24 hxs => ?_⟩
  set V := AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) with hVdef
  have hV1 : 1 ≤ V := le_trans Nat.one_le_two_pow (NLogN.KFE.two_pow_le_vol Pre G Suf hPre hG hS)
  set Bb := NLogN.zsz ((T * (q ^ 2 * V + 1) ^ 2 : ℕ) : ℤ) + 1
  obtain ⟨c, Hc, hc⟩ := HK u Pre G Suf Bb hu hPre hG hS (Nat.le_succ _) (by omega) I s F xs LP LG LS LU
    FP FG FS FU F0 F8 F9 F10 F11 F15 F20 F21 F23 F24 hxs
  refine ⟨c, Hc, le_trans hc ?_⟩
  have hu1 := NLogN.KFE.succ_le_zsz_vol (u := u) Pre G Suf hPre hG hS
  have hBb : Bb ≤ A + 2 * NLogN.zsz (V : ℤ) := by
    have := NLogN.KFB.zsz_canon_le T q V hV1
    omega
  have hov := hD u V Bb hV1 hu1 hBb
  have huτ : (1 : ℝ) ≤ (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) :=
    Real.one_le_rpow (by exact_mod_cast hu) (by norm_num)
  have hV0 : (0 : ℝ) ≤ V := Nat.cast_nonneg _
  have h1 : D * V ≤ D * (((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)) := by
    apply mul_le_mul_of_nonneg_left _ hD0; nlinarith
  calc K * (((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) + ((u : ℝ) + 1) ^ cE * ((Bb : ℝ) + 2) ^ 2)
      ≤ K * (((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) +
          D * (((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50))) := by
        apply mul_le_mul_of_nonneg_left _ hK; linarith
    _ = K * (1 + D) * ((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by ring
end
