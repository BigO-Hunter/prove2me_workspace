      (l.stepP (fun x c => TlS K ρ n x (flipS (ρ + n * K) x c)))
      (26 + cCmp Ksw τ l K ρ G n L Br + cTop Ksw l (ρ + n * K) Br) := by
  have hV := hP.kv
  have hOK := hP.ok
  have hq : ρ + n * K < L := hT.hq
  have T := topC_step (I := I) (K := K) (ρ := ρ) (G := G) (n := n) hKsw H hT hpos hneg
  have h0 := cCmp_nonneg (τ := τ) (l := l) (K := K) (ρ := ρ) (G := G) (n := n) (L := L) (Br := Br)
