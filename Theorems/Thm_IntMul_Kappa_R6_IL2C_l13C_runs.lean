-- Source module: Solutions.R6IL2CStep
/-!
# Round six, compact controls (I2C): the steps of the compact program on records

* `swRec_runs`: a Lemma 12 swap (`IL2.swE`) of two fields of the same size on the record array
  `flR recs M` is `recs ∘ swP`.
* `rotRec_runs`: a uniform table rotation (`rotR`) on the record array is `recs ∘ rotP`.
* The four segment terms `tmA, tmB, tmS, tmC` (`SegTR`).
* The offsets of the program depend only on the digits (`oA_mod`, …), and the table entries of the
  ten rotations are the offsets of the pulls (`rotYA_eq`, …): every step is `Lay.stepP`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS AModel AModelL12 Finset

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

section Terms

variable {Bb : ℕ} {Rv : ℤ}

end Terms

/-! ## Offsets through digits -/

section Offs

variable {K ρ G n L : ℕ}

theorem oA_mod (hG : 1 ≤ G) (u t : ℕ) : oA K ρ G n (u % Qc G n) (t % Qc G n) = oA K ρ G n u t := by
  rw [oA_eq hG, oA_eq hG]
  refine sum_congr rfl fun s hs => ?_
  rw [cdg_mod (mem_range.1 hs), cdg_mod (mem_range.1 hs)]

theorem oB_mod (hG : 1 ≤ G) (u t : ℕ) : oB K ρ G n (u % Qc G n) (t % Qc G n) = oB K ρ G n u t := by
  rw [oB_eq hG, oB_eq hG]
  refine sum_congr rfl fun s hs => ?_
  rw [cdg_mod (mem_range.1 hs), cdg_mod (mem_range.1 hs)]

theorem oS_mod (hK : 1 ≤ K) (hL : ρ + n * K ≤ L) (y : ℕ) :
    oS K ρ G n (y % 2 ^ L) = oS K ρ G n y := by
  rw [oS_eq hK, oS_eq hK]
  refine sum_congr rfl fun s hs => ?_
  have hs' := mem_range.1 hs
  rw [ybit_mod (by nlinarith)]

theorem oC_mod (hK : 1 ≤ K) (hG : 1 ≤ G) (hL : ρ + n * K ≤ L) (u y : ℕ) :
    oC K ρ G n (u % Qc G n) (y % 2 ^ L) = oC K ρ G n u y := by
  rw [oC_eq hK hG, oC_eq hK hG]
  refine sum_congr rfl fun s hs => ?_
  have hs' := mem_range.1 hs
  rw [ybit_mod (by nlinarith), cdg_mod hs']

end Offs

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CRec
/-!
# Round six, compact controls (I2C): the ten rotations as steps of the record index

For a layout `l` with `QC = R^n`, `QL = 2^L`, the table rotations of the program (with the tables
`tabE` of `R6IL2CTab`, offsets of `R6IL2CMath`) are the record pulls `l.stepP F` of the steps of
`Psi` (`rotA_pull`, `rotB_pull`, `rotS_pull`, `rotC_pull`, `rotL_pull`), and the composite of the
ten pulls is `l.stepP Psi` (`psi_pull`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL AModel AModelL12

namespace Lay

variable {l : Lay} {K ρ G n L : ℕ}

theorem div_div' {m a b c : ℕ} (h : a * b = c) : m / a / b = m / c := by
  rw [Nat.div_div_eq_div_mul, h]

theorem gc_eq (Q S m : ℕ) : gc Q S m = m / S % Q := rfl

theorem tabE_one (tf : ℤ → ℤ → ℤ) (ru rv rw w0 : ℤ) (d1 d2 Q n p : ℕ) :
    tabE 1 tf ru rv rw w0 d1 d2 Q n p =
      (segSum tf ru rv rw w0 ((p / d1 : ℕ) : ℤ) ((p / d2 : ℕ) : ℤ) n % (Q : ℤ)).toNat := by
  unfold tabE; rw [one_mul]

theorem tabE_neg (tf : ℤ → ℤ → ℤ) (ru rv rw w0 : ℤ) (d1 d2 Q n p : ℕ) :
    tabE (-1) tf ru rv rw w0 d1 d2 Q n p =
      ((-segSum tf ru rv rw w0 ((p / d1 : ℕ) : ℤ) ((p / d2 : ℕ) : ℤ) n) % (Q : ℤ)).toNat := by
  unfold tabE; rw [neg_one_mul]

/-- **Step A**: `Y += oA(U, T)`. -/
theorem rotA_pull (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hG : 1 ≤ G)
    {d1 d2 : ℕ} (hd1 : l.QL * l.sY * d1 = l.sU) (hd2 : l.QL * l.sY * d2 = l.sT) (m : ℕ) :
    rotP l.QL l.sY (tabE 1 (tfA ((2 : ℤ) ^ G)) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) ((2 : ℤ) ^ K)
      ((2 : ℤ) ^ ρ) d1 d2 l.QL n) m =
      l.stepP (fun _ c => pY L (oA K ρ G n c.u c.t) c) m := by
  have key : oA K ρ G n (m / l.sU) (m / l.sT) =
      oA K ρ G n (gc l.QC l.sU m) (gc l.QC l.sT m) := by
    rw [hQC, gc_eq, gc_eq, oA_mod hG]
  have e := rotY_eq h (tabE 1 (tfA ((2 : ℤ) ^ G)) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) ((2 : ℤ) ^ K)
      ((2 : ℤ) ^ ρ) d1 d2 l.QL n) (fun _ c => oA K ρ G n c.u c.t) (m := m) (by
    rw [tabE_one, div_div' hd1, div_div' hd2, oA_tab, key]; rfl)
  rw [e]; simp only [pY, ← hQL]

/-- **Step B**: `Y += oB(U, T)`. -/
theorem rotB_pull (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hG : 1 ≤ G)
    {d1 d2 : ℕ} (hd1 : l.QL * l.sY * d1 = l.sU) (hd2 : l.QL * l.sY * d2 = l.sT) (m : ℕ) :
    rotP l.QL l.sY (tabE 1 (tfB' ((2 : ℤ) ^ G)) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) ((2 : ℤ) ^ K)
      ((2 : ℤ) ^ ρ) d1 d2 l.QL n) m =
      l.stepP (fun _ c => pY L (oB K ρ G n c.u c.t) c) m := by
  have key : oB K ρ G n (m / l.sU) (m / l.sT) =
      oB K ρ G n (gc l.QC l.sU m) (gc l.QC l.sT m) := by
    rw [hQC, gc_eq, gc_eq, oB_mod hG]
  have e := rotY_eq h (tabE 1 (tfB' ((2 : ℤ) ^ G)) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) ((2 : ℤ) ^ K)
      ((2 : ℤ) ^ ρ) d1 d2 l.QL n) (fun _ c => oB K ρ G n c.u c.t) (m := m) (by
    rw [tabE_one, div_div' hd1, div_div' hd2, oB_tab, key]; rfl)
  rw [e]; simp only [pY, ← hQL]

/-- **Step S**: `T += oS(Y)` (through `Bk`). -/
theorem rotS_pull (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hL : ρ + n * K ≤ L) {d1 : ℕ} (hd1 : l.QC * l.sB * d1 = l.sY * 2 ^ ρ) (m : ℕ) :
    swP l.QC l.sT l.sB (rotP l.QC l.sB (tabE 1 tfS ((2 : ℤ) ^ K) ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) 1
      d1 d1 l.QC n) (swP l.QC l.sT l.sB m)) =
      l.stepP (fun _ c => pT G n (oS K ρ G n c.y) c) m := by
  obtain ⟨k, hk, ek⟩ := h.kTY
  have key : oS K ρ G n (swP l.QC l.sT l.sB m / l.sY) = oS K ρ G n (gc l.QL l.sY m) := by
    rw [← gcY_swP h hk ek m, hQL, gc_eq, oS_mod hK hL]
  have e := rotT_eq h (tabE 1 tfS ((2 : ℤ) ^ K) ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) 1
      d1 d1 l.QC n) (fun _ c => oS K ρ G n c.y) (m := m) (by
    rw [tabE_one, div_div' hd1, ← Nat.div_div_eq_div_mul, oS_tab, key]; rfl)
  rw [e]; simp only [pT, ← hQC]

/-- **Step C**: `T -= oC(U, Y)` (through `Bk`). -/
theorem rotC_pull (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hG : 1 ≤ G) (hL : ρ + n * K ≤ L) {d1 d2 : ℕ} (hd1 : l.QC * l.sB * d1 = l.sY * 2 ^ ρ)
    (hd2 : l.QC * l.sB * d2 = l.sU) (m : ℕ) :
    swP l.QC l.sT l.sB (rotP l.QC l.sB (tabE (-1) tfC ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) 1
      d1 d2 l.QC n) (swP l.QC l.sT l.sB m)) =
      l.stepP (fun _ c => pT G n (-(oC K ρ G n c.u c.y)) c) m := by
  obtain ⟨k, hk, ek⟩ := h.kTY
  have key : oC K ρ G n (swP l.QC l.sT l.sB m / l.sU) (swP l.QC l.sT l.sB m / l.sY) =
      oC K ρ G n (gc l.QC l.sU m) (gc l.QL l.sY m) := by
    rw [← gcY_swP h hk ek m, ← gcU_swPT h m, hQC, hQL, gc_eq, gc_eq, oC_mod hK hG hL]
  have e := rotT_eq h (tabE (-1) tfC ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) 1
      d1 d2 l.QC n) (fun _ c => -(oC K ρ G n c.u c.y)) (m := m) (by
    rw [tabE_neg, div_div' hd1, div_div' hd2, ← Nat.div_div_eq_div_mul, oC_tab, key]; rfl)
  rw [e]; simp only [pT, ← hQC]

/-- **Load / unload**: `U += sgn · oS(X)` (through `Bk`). -/
theorem rotL_pull (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hL : ρ + n * K ≤ L) {d1 : ℕ} (hd1 : l.QC * l.sB * d1 = l.sX * 2 ^ ρ) (sgn : ℤ)
    (hs : sgn = 1 ∨ sgn = -1) (m : ℕ) :
    swP l.QC l.sU l.sB (rotP l.QC l.sB (tabE sgn tfS ((2 : ℤ) ^ K) ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) 1
      d1 d1 l.QC n) (swP l.QC l.sU l.sB m)) =
      l.stepP (fun x c => pU G n (sgn * oS K ρ G n x) c) m := by
  obtain ⟨k, hk, ek⟩ := h.kUX
  have key : oS K ρ G n (swP l.QC l.sU l.sB m / l.sX) = oS K ρ G n (gc l.QL l.sX m) := by
    rw [← gcX_swP h hk ek m, hQL, gc_eq, oS_mod hK hL]
  have e := rotU_eq h (tabE sgn tfS ((2 : ℤ) ^ K) ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) 1
      d1 d1 l.QC n) (fun x _ => sgn * oS K ρ G n x) (m := m) (by
    unfold tabE
    rw [div_div' hd1, ← Nat.div_div_eq_div_mul, oS_tab, key]; rfl)
  rw [e]; simp only [pU, ← hQC]

theorem box_pT' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) (o : ℤ) :
    l.BoxL (pT G n o c) := (boxL_iff hQC hQL _).2 (box_pT ((boxL_iff hQC hQL _).1 hc) o)
theorem box_pU' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) (o : ℤ) :
    l.BoxL (pU G n o c) := (boxL_iff hQC hQL _).2 (box_pU ((boxL_iff hQC hQL _).1 hc) o)
theorem box_pY' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) (o : ℤ) :
    l.BoxL (pY L o c) := (boxL_iff hQC hQL _).2 (box_pY ((boxL_iff hQC hQL _).1 hc) o)

theorem stepP4 (h : l.OK) {F1 F2 F3 F4 : ℕ → CS → CS}
    (h1 : ∀ x c, l.BoxL c → l.BoxL (F1 x c)) (h2 : ∀ x c, l.BoxL c → l.BoxL (F2 x c))
    (h3 : ∀ x c, l.BoxL c → l.BoxL (F3 x c)) (h4 : ∀ x c, l.BoxL c → l.BoxL (F4 x c)) (m : ℕ) :
    l.stepP F1 (l.stepP F2 (l.stepP F3 (l.stepP F4 m))) =
      l.stepP (fun x c => F1 x (F2 x (F3 x (F4 x c)))) m := by
  rw [stepP_stepP h h3 h4, stepP_stepP h h2 (fun x c hc => h3 x _ (h4 x c hc)),
    stepP_stepP h h1 (fun x c hc => h2 x _ (h3 x _ (h4 x c hc)))]

/-- One phase of pulls (`A, S, B, C`, the first one outermost) is `phInv`. -/
theorem phase_pull (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (m : ℕ) :
    l.stepP (fun _ c => pY L (oA K ρ G n c.u c.t) c)
      (l.stepP (fun _ c => pT G n (oS K ρ G n c.y) c)
      (l.stepP (fun _ c => pY L (oB K ρ G n c.u c.t) c)
      (l.stepP (fun _ c => pT G n (-(oC K ρ G n c.u c.y)) c) m))) =
      l.stepP (fun _ c => phInv K ρ G n L c) m :=
  (stepP4 h (F1 := fun _ c => pY L (oA K ρ G n c.u c.t) c)
    (F2 := fun _ c => pT G n (oS K ρ G n c.y) c) (F3 := fun _ c => pY L (oB K ρ G n c.u c.t) c)
    (F4 := fun _ c => pT G n (-(oC K ρ G n c.u c.y)) c)
    (fun _ c hc => box_pY' hQC hQL hc _) (fun _ c hc => box_pT' hQC hQL hc _)
    (fun _ c hc => box_pY' hQC hQL hc _) (fun _ c hc => box_pT' hQC hQL hc _) m).trans rfl

theorem box_phInv' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) :
    l.BoxL (phInv K ρ G n L c) :=
  (boxL_iff hQC hQL _).2 (box_phInv (K := K) (ρ := ρ) ((boxL_iff hQC hQL _).1 hc))

/-- **The ten pulls** (phase, load, phase, unload) compose to `Psi`. -/
theorem psi_pull (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (m : ℕ) :
    l.stepP (fun _ c => phInv K ρ G n L c)
      (l.stepP (fun x c => pU G n (1 * oS K ρ G n x) c)
      (l.stepP (fun _ c => phInv K ρ G n L c)
      (l.stepP (fun x c => pU G n (-1 * oS K ρ G n x) c) m))) =
      l.stepP (fun x c => Psi K ρ G n L x c) m := by
  rw [stepP4 h (F1 := fun _ c => phInv K ρ G n L c) (F2 := fun x c => pU G n (1 * oS K ρ G n x) c)
    (F3 := fun _ c => phInv K ρ G n L c) (F4 := fun x c => pU G n (-1 * oS K ρ G n x) c)
    (fun _ c hc => box_phInv' hQC hQL hc) (fun _ c hc => box_pU' hQC hQL hc _)
    (fun _ c hc => box_phInv' hQC hQL hc) (fun _ c hc => box_pU' hQC hQL hc _) m]
  unfold Psi
  simp only [one_mul, neg_one_mul]

end Lay

end IntMul.Kappa.R6.IL2C

end

