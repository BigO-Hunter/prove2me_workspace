section
-- Source module: Solutions.R6IL2CCore
/-!
# Round six, compact controls (I2C): the compact Lemma 13 code

* `layR`: the record layout of a row addition (`T`, `U` in the top of `N0`, the bit-control field
  `Bk` at stride `1` in the bottom of `N3`, `X`, `Y` the slots `px`, `py`), `layR_ok`, `layR_kval`.
* `midC`: the compact phase (only when `n = f - 1 > 0`) and the top bit; `midC_step`: it is the
  record pull `stepP (TlS ∘ flipS)`.
* `l13C`: to bits, `midC`, from bits; **`l13C_runs`**: it is the row addition
  `permRecs (rect …) (rowAddAddr K ρ f px py)`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX NLogN.KFB NLogN.KFH IntMul RS AModel AModelL12 Butterfly

/-! ## The layout of a row addition -/

section Lay

variable {N0 N1 N2 N3 L G n : ℕ}

theorem strd_nest (h1 : 0 < N1) (h2 : 0 < N2) {t t' : Fin 3} (h : t < t') :
    ∃ k, 0 < k ∧ strd (gR N0 N1 N2 N3 L) t = strd (gR N0 N1 N2 N3 L) t' * 2 ^ L * k := by
  obtain ⟨a, ha⟩ := t
  obtain ⟨b, hb⟩ := t'
  simp only [Fin.mk_lt_mk] at h
  have : (a = 0 ∧ b = 1) ∨ (a = 0 ∧ b = 2) ∨ (a = 1 ∧ b = 2) := by omega
  rcases this with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact ⟨N1, h1, show (gR N0 N1 N2 N3 L).S0 = (gR N0 N1 N2 N3 L).S1 * 2 ^ L * N1 by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨2 ^ L * N2 * N1, by positivity, show (gR N0 N1 N2 N3 L).S0 =
      (gR N0 N1 N2 N3 L).S2 * 2 ^ L * (2 ^ L * N2 * N1) by simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨N2, h2, show (gR N0 N1 N2 N3 L).S1 = (gR N0 N1 N2 N3 L).S2 * 2 ^ L * N2 by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩

theorem strd_U (h1 : 0 < N1) (h2 : 0 < N2) (t : Fin 3) :
    ∃ k, 0 < k ∧ 2 ^ L * (gR N0 N1 N2 N3 L).S0 = strd (gR N0 N1 N2 N3 L) t * 2 ^ L * k := by
  obtain ⟨a, ha⟩ := t
  have : a = 0 ∨ a = 1 ∨ a = 2 := by omega
  rcases this with rfl | rfl | rfl
  · exact ⟨1, Nat.one_pos, show 2 ^ L * (gR N0 N1 N2 N3 L).S0 = (gR N0 N1 N2 N3 L).S0 * 2 ^ L * 1 by
      ring⟩
  · exact ⟨2 ^ L * N1, by positivity, show 2 ^ L * (gR N0 N1 N2 N3 L).S0 =
      (gR N0 N1 N2 N3 L).S1 * 2 ^ L * (2 ^ L * N1) by simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨2 ^ L * 2 ^ L * N2 * N1, by positivity, show 2 ^ L * (gR N0 N1 N2 N3 L).S0 =
      (gR N0 N1 N2 N3 L).S2 * 2 ^ L * (2 ^ L * 2 ^ L * N2 * N1) by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩

theorem strd_B {C : ℕ} (h1 : 0 < N1) (h2 : 0 < N2) {b : ℕ} (hb : 0 < b) (h3 : N3 = C * b)
    (t : Fin 3) : ∃ k, 0 < k ∧ strd (gR N0 N1 N2 N3 L) t = 1 * C * k := by
  obtain ⟨a, ha⟩ := t
  have : a = 0 ∨ a = 1 ∨ a = 2 := by omega
  subst h3
  rcases this with rfl | rfl | rfl
  · exact ⟨2 ^ L * (2 ^ L * b * N2) * N1, by positivity, show (gR N0 N1 N2 (C * b) L).S0 = _ by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨2 ^ L * b * N2, by positivity, show (gR N0 N1 N2 (C * b) L).S1 = _ by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨b, hb, show (gR N0 N1 N2 (C * b) L).S2 = _ by simp only [gR, Geo.S2]; ring⟩

theorem qc_pos : 0 < Qc G n := by unfold Qc; positivity

theorem layR_ok {px py : Fin 3} (hpxy : px ≠ py) {a b : ℕ} (ha : 0 < a)
    (h0 : N0 = Qc G n * Qc G n * a) (h1 : 0 < N1) (h2 : 0 < N2) (hb : 0 < b)
    (h3 : N3 = Qc G n * b) : (layR N0 N1 N2 N3 L G n px py).OK := by
  have hC : 0 < Qc G n := qc_pos
  refine ⟨hC, by simp only [layR]; positivity, Nat.one_pos,
    ⟨1, Nat.one_pos, by simp only [layR]; ring⟩, strd_U h1 h2 px, strd_U h1 h2 py,
    strd_B h1 h2 hb h3 px, strd_B h1 h2 hb h3 py, ?_, ⟨a, ha, ?_⟩⟩
  · rcases lt_or_gt_of_ne hpxy with h | h
    · exact Or.inl (strd_nest h1 h2 h)
    · exact Or.inr (strd_nest h1 h2 h)
  · show (gR N0 N1 N2 N3 L).V = Qc G n * (2 ^ L * (gR N0 N1 N2 N3 L).S0) * Qc G n * a
    simp only [gR, Geo.V]; rw [h0]; ring

end Lay

namespace RP

variable {N0 N1 N2 N3 K f ρ G : ℕ} {px py : Fin 3} (hp : RP N0 N1 N2 N3 K f ρ G px py)
include hp

theorem ok : (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).OK := by
  obtain ⟨a, ha, ea⟩ := hp.n0
  obtain ⟨b, hb, eb⟩ := hp.n3
  exact layR_ok hp.hpxy ha ea hp.n1 hp.n2 hb eb

theorem pos : (gR N0 N1 N2 N3 (f * K)).Pos := by
  obtain ⟨a, ha, ea⟩ := hp.n0
  obtain ⟨b, hb, eb⟩ := hp.n3
  have := qc_pos (G := G) (n := f - 1)
  refine ⟨by simp only [gR]; positivity, ?_, hp.n1, hp.n2, ?_, Nat.one_pos⟩
  · show 0 < N0
    rw [ea]; exact Nat.mul_pos (Nat.mul_pos this this) ha
  · show 0 < N3
    rw [eb]; exact Nat.mul_pos this hb

theorem QQM : 2 ^ (f * K) * 2 ^ (f * K) ≤ (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M := by
  have hg := hp.pos
  show 2 ^ (f * K) * 2 ^ (f * K) ≤ (gR N0 N1 N2 N3 (f * K)).V
  have e : (gR N0 N1 N2 N3 (f * K)).V = 2 ^ (f * K) * 2 ^ (f * K) *
      ((gR N0 N1 N2 N3 (f * K)).N0 * (gR N0 N1 N2 N3 (f * K)).N1 * (gR N0 N1 N2 N3 (f * K)).S1) := by
    simp only [Geo.V, Geo.S0]; simp only [gR]; ring
  rw [e]
  exact Nat.le_mul_of_pos_right _ (Nat.mul_pos (Nat.mul_pos hg.n0 hg.n1) hg.s1)

/-- The value facts of the compact phase. -/
theorem kval (Br : ℕ) (hBr : 1 ≤ Br) :
    KVal (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) K ρ G (f - 1) (f * K)
      (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M
      (zsz (((layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M * Br : ℕ) : ℤ) + 3) := by
  have hK := hp.hK
  have hρ := hp.hρ
  have hf := hp.hf
  have hG := hp.hG
  have hGK := hp.hGK
  set n := f - 1 with hn
  have hfn : f = n + 1 := by omega
  have hnK : n * K + K = f * K := by rw [hfn]; ring
  have hp2 : ∀ {a b : ℕ}, a ≤ b → 2 ^ a ≤ 2 ^ b := fun h => Nat.pow_le_pow_right (by norm_num) h
  refine ⟨hp.ok, rfl, rfl, rfl, by omega, hG, by nlinarith, ?_, ?_, hp2 (by nlinarith),
    hp2 (by nlinarith), hp2 (by nlinarith), ?_, ?_, hp.QQM, ?_⟩
  · have e : 2 * 2 ^ G * 2 ^ ρ * (2 ^ K) ^ n = 2 ^ (1 + G + ρ + K * n) := by
      rw [pow_add, pow_add, pow_add, pow_mul]; ring
    rw [e, ← pow_add]
    exact hp2 (by nlinarith)
  · have e : 2 ^ ρ * (2 ^ K) ^ n = 2 ^ (ρ + K * n) := by rw [pow_add, pow_mul]
    rw [e, ← pow_add]
    exact hp2 (by nlinarith)
  · exact le_trans (Nat.lt_two_pow_self).le (hp2 (by nlinarith))
  · show (2 ^ G) ^ n ≤ 2 ^ (f * K)
    rw [← pow_mul]; exact hp2 (by nlinarith)
  · set V := (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M
    have h1 := natAbs_lt_zsz (((V * Br : ℕ) : ℤ))
    rw [Int.natAbs_natCast] at h1
    have h2 : V ≤ V * Br := Nat.le_mul_of_pos_right _ hBr
    rw [pow_add]; omega

theorem phok (Br : ℕ) (hBr : 1 ≤ Br) :
    PhOK (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) K ρ G (f - 1) (f * K) Br :=
  ⟨hp.kval Br hBr, rfl, hBr⟩

theorem topok (Br : ℕ) (hBr : 1 ≤ Br) :
    TopOK (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) (f * K) (ρ + (f - 1) * K) Br := by
  refine ⟨hp.ok, rfl, ?_, hBr⟩
  have := hp.hρ; have := hp.hf
  have e : f * K = (f - 1) * K + K := by
    conv_lhs => rw [show f = (f - 1) + 1 by omega]
    ring
  omega

end RP

/-! ## The middle part: the compact phase and the top bit -/

section Mid

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {l : Lay} {K ρ G n L Br : ℕ} {fl : ℤ}

theorem cW_nonneg {Ksw : ℝ} (h : 0 ≤ Ksw) : 0 ≤ cW Ksw τ l n G Br := by unfold cW; positivity

theorem cCmp_nonneg {Ksw : ℝ} (h : 0 ≤ Ksw) : 0 ≤ cCmp Ksw τ l K ρ G n L Br := by
  have := cW_nonneg (τ := τ) (l := l) (n := n) (G := G) (Br := Br) h
  unfold cCmp cPsi cPh cCo cR
  positivity

theorem TlS_zero (K ρ x : ℕ) (c : CS) : TlS K ρ 0 x c = c := by
  have h : Tl K ρ 0 x c.y = c.y := by
    rcases Nat.eq_zero_or_pos K with hK | hK
    · unfold Tl oT; simp [segSum]
    · rw [Tl_xor hK]; simp [selM]
  unfold TlS; rw [h]

/-- **The middle part** is `stepP (TlS ∘ flipS q)`. -/
theorem midC_step {Ksw : ℝ} (hKsw : 0 ≤ Ksw) (H : SwOK tab l12 τ Ksw) (hP : PhOK l K ρ G n L Br)
    (hT : TopOK l L (ρ + n * K) Br)
    (hpos : 0 < fl → ∃ k, 0 < k ∧ l.sX = l.sY * l.QL * k)
    (hneg : ¬ 0 < fl → ∃ k, 0 < k ∧ l.sY = l.sX * l.QL * k) :
