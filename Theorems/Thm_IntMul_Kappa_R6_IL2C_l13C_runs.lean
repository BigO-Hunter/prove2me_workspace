-- Source module: Solutions.R6IL2CTop
/-!
# Round six, compact controls (I2C): the top selected bit and the record-step calculus

* `Tl_xor`: the ideal toggle is `y ⊕ (x ∧ selM n)`; with the top bit `q = ρ + n K` flipped as
  well (`flipS q`) the composite step is the slot row addition `phi g (Fpp K ρ (n+1) px py)`
  (`tlflip_phi`).
* `flip_pull`, `swflip`: the last-bit table rotation (directly when `X` is above `Y`, between two
  swaps of single bits otherwise) is the record pull `l.stepP (flipS q)`.
* `RecStep`: a program acting on the record array `flR recs M` as `recs ∘ π`, with sequencing,
  branching and skip.
* `CEnv`: the registers of the compact program; `topC_step`: the top-bit code as a `RecStep`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel AModelL12 Butterfly

theorem ybit_eq (K ρ s y : ℕ) (hK : 1 ≤ K) : ybit K ρ s y = y / 2 ^ (ρ + s * K) % 2 := by
  unfold ybit seg dgt
  rw [Nat.mod_mod_of_dvd _ (dvd_pow_self 2 (by omega : K ≠ 0)), Nat.div_div_eq_div_mul,
    ← pow_mul, ← pow_add, mul_comm K s]

theorem Tl_xor {K : ℕ} (hK : 1 ≤ K) (ρ n x y : ℕ) : Tl K ρ n x y = y ^^^ (x &&& selM K ρ n) := by
  have h := T0n_eq hK ρ x y n
  have e : (y : ℤ) + oT K ρ n x y = T0n K ρ n (x : ℤ) (y : ℤ) := by
    rw [oT_eq hK]
    unfold T0n
    congr 1
    refine Finset.sum_congr rfl fun s _ => ?_
    have hx : bitAt (x : ℤ) (ρ + s * K) = ((x / 2 ^ (ρ + s * K) % 2 : ℕ) : ℤ) := bitAt_nat x _
    have hy : bitAt (y : ℤ) (ρ + s * K) = ((y / 2 ^ (ρ + s * K) % 2 : ℕ) : ℤ) := bitAt_nat y _
    have hc : (if ctl K ρ (x : ℤ) s then (1 : ℤ) else 0) = ((x / 2 ^ (ρ + s * K) % 2 : ℕ) : ℤ) := by
      unfold ctl; rw [hx]
      rcases Nat.mod_two_eq_zero_or_one (x / 2 ^ (ρ + s * K)) with h0 | h0 <;> simp [h0]
    rw [hc, hy, ybit_eq K ρ s x hK, ybit_eq K ρ s y hK, pow_add, ← pow_mul, mul_comm K s]
    ring
  unfold Tl
  rw [e, h, Int.toNat_natCast]

theorem xor_sel_succ {K : ℕ} (hK : 1 ≤ K) (ρ n x y : ℕ) :
    (y ^^^ (x &&& 2 ^ (ρ + n * K))) ^^^ (x &&& selM K ρ n) = y ^^^ (x &&& selM K ρ (n + 1)) := by
  have hsel : ∀ i, (selM K ρ (n + 1)).testBit i =
      ((selM K ρ n).testBit i || decide (i = ρ + n * K)) := by
    intro i
    apply Bool.eq_iff_iff.2
    rw [Bool.or_eq_true, testBit_selM hK, testBit_selM hK, decide_eq_true_iff]
    constructor
    · rintro ⟨k, hk, rfl⟩
      rcases Nat.lt_succ_iff_lt_or_eq.1 hk with h | h
      · exact Or.inl ⟨k, h, rfl⟩
      · exact Or.inr (by rw [h])
    · rintro (⟨k, hk, rfl⟩ | rfl)
      · exact ⟨k, by omega, rfl⟩
      · exact ⟨n, by omega, rfl⟩
  have hq : (selM K ρ n).testBit (ρ + n * K) = false := Nat.testBit_lt_two_pow (selM_lt hK ρ n)
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_xor, Nat.testBit_and, hsel, Nat.testBit_two_pow]
  by_cases hi : i = ρ + n * K
  · subst hi; simp [hq]
  · have : ¬ (ρ + n * K = i) := fun e => hi e.symm
    simp [hi, this]

/-! ## The top-bit step on the record index -/

namespace Lay

variable {l : Lay} {L q : ℕ}

theorem gcX_bit (hQL : l.QL = 2 ^ L) (hq : q < L) (m : ℕ) :
    gc 2 (l.sX * 2 ^ q) m = l.xv m / 2 ^ q % 2 := by
  simp only [gc, xv]; rw [hQL, mod_pow_div_bit hq, Nat.div_div_eq_div_mul]

/-- **Two swapped bit fields**: flipping the lower one by the upper one between two swaps is
flipping the upper one by the lower one. -/
theorem swflip {S1 S2 k : ℕ} (hS2 : 0 < S2) (hk : 0 < k) (hS : S1 = S2 * 2 * k) (m : ℕ) :
    swP 2 S1 S2 (sc 2 S2 ((gc 2 S2 (swP 2 S1 S2 m) + 2 - gc 2 S1 (swP 2 S1 S2 m)) % 2)
      (swP 2 S1 S2 m)) = sc 2 S1 ((gc 2 S1 m + 2 - gc 2 S2 m) % 2) m := by
  have hS1 : 0 < S1 := by rw [hS]; positivity
  set a := gc 2 S1 m with had
  set b := gc 2 S2 m with hbd
  have ha : a < 2 := gc_lt (by norm_num) _
  have hb : b < 2 := gc_lt (by norm_num) _
  have g1 : gc 2 S2 (swP 2 S1 S2 m) = a := by
    unfold swP; rw [gc_dn hS2 hS, gc_sc_same hS2 ha]
  have g2 : gc 2 S1 (swP 2 S1 S2 m) = b := by
    unfold swP; rw [gc_sc_same hS1 hb]
  rw [g1, g2]
  set v := (a + 2 - b) % 2 with hvd
  have hv : v < 2 := Nat.mod_lt _ (by norm_num)
  set m1 := swP 2 S1 S2 m with hm1
  set m2 := sc 2 S2 v m1 with hm2
  have g3 : gc 2 S2 m2 = v := gc_sc_same hS2 hv m1
  have g4 : gc 2 S1 m2 = b := by rw [hm2, gc_up hS2 hk hS hv, g2]
  have e1 : (m1 : ℤ) = m + ((a : ℤ) - b) * S2 + ((b : ℤ) - a) * S1 :=
    swP_int (by norm_num) hS2 hk hS m
  have e0 : swP 2 S1 S2 m2 = sc 2 S1 (gc 2 S2 m2) (sc 2 S2 (gc 2 S1 m2) m2) := rfl
  rw [e0, g3, g4]
  have g5 : gc 2 S1 (sc 2 S2 b m2) = b := by rw [gc_up hS2 hk hS hb, g4]
  have E : (sc 2 S1 v (sc 2 S2 b m2) : ℤ) = sc 2 S1 v m := by
    rw [sc_int, g5, sc_int, g3, hm2, sc_int, g1, e1, sc_int]
    ring
  exact_mod_cast E

end Lay

/-! ## The composite is the slot row addition -/

theorem slotG_trOf (g : Geo) (m : ℕ) (t : Fin 3) : slotG (trOf g m) t = gc g.Q (strd g t) m := by
  fin_cases t <;> rfl

/-- **The toggle of the `n` low selected bits and the flip of bit `ρ + n K` together are the
slot row addition** `Fpp K ρ (n + 1) px py` on the record index. -/
theorem tlflip_phi {g : Geo} (hg : g.Pos) {l : Lay} (h : l.OK) {K ρ n L : ℕ} {px py : Fin 3}
    (hQL : l.QL = g.Q) (hQ : g.Q = 2 ^ L) (hX : l.sX = strd g px) (hY : l.sY = strd g py)
    (hpxy : px ≠ py) (hK : 1 ≤ K) (hq : ρ + n * K < L) (m : ℕ) :
    l.stepP (fun x c => TlS K ρ n x (flipS (ρ + n * K) x c)) m =
      phi g (Fpp K ρ (n + 1) px py) m := by
  have hL' : ρ + n * K ≤ L := hq.le
  have hQL' : l.QL = 2 ^ L := hQL.trans hQ
  have hF : ∀ c, TV g.Q c → TV g.Q (Fpp K ρ (n + 1) px py c) := fun c hc => by
    rw [hQ] at hc ⊢; exact TV_Fpp px py c hc
  have e1 := phi_slotS hg hF py (fun c => slotG c py ^^^ (slotG c px &&& selM K ρ (n + 1)))
    (fun c => rfl) m
  have hfb := Lay.flip_box hQL' hq (Lay.box_cs h m) (l.xv m)
  have hy' : Tl K ρ n (l.xv m) ((l.cs m).y ^^^ (l.xv m &&& 2 ^ (ρ + n * K))) < l.QL := by
    rw [hQL']; exact (Tl_spec hK hL' _ (hQL' ▸ hfb.2.2)).1
  have hbox : l.BoxL (TlS K ρ n (l.xv m) (flipS (ρ + n * K) (l.xv m) (l.cs m))) :=
    ⟨(Lay.box_cs h m).1, (Lay.box_cs h m).2.1, hy'⟩
  have e2 := Lay.set_int h hbox m
  have sY : slotG (trOf g m) py = (l.cs m).y := by
    rw [slotG_trOf, ← hY, ← hQL]; rfl
  have sX : slotG (trOf g m) px = l.xv m := by
    rw [slotG_trOf, ← hX, ← hQL]; rfl
  have key : Tl K ρ n (l.xv m) ((l.cs m).y ^^^ (l.xv m &&& 2 ^ (ρ + n * K))) =
      (l.cs m).y ^^^ (l.xv m &&& selM K ρ (n + 1)) := by
    rw [Tl_xor hK, xor_sel_succ hK]
  have E : (l.stepP (fun x c => TlS K ρ n x (flipS (ρ + n * K) x c)) m : ℤ) =
      (phi g (Fpp K ρ (n + 1) px py) m : ℤ) := by
    unfold Lay.stepP
    rw [e2, e1, sX, sY, ← hY]
    simp only [TlS, flipS, Lay.cs]
    rw [show (Tl K ρ n (l.xv m) (gc l.QL l.sY m ^^^ (l.xv m &&& 2 ^ (ρ + n * K)))) =
      gc l.QL l.sY m ^^^ (l.xv m &&& selM K ρ (n + 1)) from key]
    ring
  exact_mod_cast E

/-! ## Record steps -/

namespace RecStep

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {E : IState HS → Prop} {M B : ℕ}

theorem iteT {r : Fin HS} {f : Cls → Bool} {p q : IStmt HS 1} {π : ℕ → ℕ} {c : ℝ}
    (hf : ∀ t, E t → f (t.cl r) = true) (h : RecStep I tab p E M B π c) :
    RecStep I tab (.ite r f p q) E M B π (c + 25) := by
  intro t recs R0 ht hl hb h0
  obtain ⟨d, H, hd⟩ := h t recs R0 ht hl hb h0
  exact ⟨d + 25, IRuns.iteT (hf t ht) H, by push_cast; linarith⟩

theorem iteF {r : Fin HS} {f : Cls → Bool} {p q : IStmt HS 1} {π : ℕ → ℕ} {c : ℝ}
    (hf : ∀ t, E t → f (t.cl r) = false) (h : RecStep I tab q E M B π c) :
    RecStep I tab (.ite r f p q) E M B π (c + 25) := by
  intro t recs R0 ht hl hb h0
  obtain ⟨d, H, hd⟩ := h t recs R0 ht hl hb h0
  exact ⟨d + 25, IRuns.iteF (hf t ht) H, by push_cast; linarith⟩

end RecStep

/-! ## The registers of the compact program -/

theorem upd0_G {t : IState HS} {r : Fin HS} (hr : r ≠ 0) (L : List Item) : (t.upd 0 L).G r = t.G r := by
  simp [IState.upd_G, hr]

theorem CEnv.stab {l : Lay} {K ρ G n q Br : ℕ} {fl : ℤ} :
    Stab (fun t => CEnv t l K ρ G n q Br fl) := by
  intro t L ⟨k, m, j, f, g, b, a⟩
  obtain ⟨⟨a1, h1⟩, ⟨a2, h2⟩, ⟨a3, h3⟩, ⟨a4, h4⟩, ⟨a5, h5⟩, ⟨a6, h6⟩, ⟨a7, h7⟩, ⟨a8, h8⟩,
    ⟨a9, h9⟩, ⟨a10, h10⟩⟩ := k
  refine ⟨⟨⟨a1, ?_⟩, ⟨a2, ?_⟩, ⟨a3, ?_⟩, ⟨a4, ?_⟩, ⟨a5, ?_⟩, ⟨a6, ?_⟩, ⟨a7, ?_⟩, ⟨a8, ?_⟩,
    ⟨a9, ?_⟩, ⟨a10, ?_⟩⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals first
    | (rw [upd0_G (by decide)]; assumption)
    | (obtain ⟨L', hL'⟩ := ‹∃ L, _›; exact ⟨L', by rw [upd0_G (by decide)]; exact hL'⟩)

/-! ## The top-bit code -/

section Top

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {l : Lay} {K ρ G n q L Br : ℕ} {fl : ℤ}

/-- **`X` below `Y`**: swap, flip, swap is the flip. -/
theorem topB_step {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hT : TopOK l L q Br) {k : ℕ} (hk : 0 < k)
    (hYX : l.sY = l.sX * l.QL * k) :
    RecStep I tab (topB l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br (l.stepP (flipS q))
      (Ksw * (((l.M * Br : ℕ) : ℝ) + 1) +
        ((cXorU (l.M / (2 * (l.sX * 2 ^ q))) (l.sX * 2 ^ q * Br) 1 (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) +
          Ksw * (((l.M * Br : ℕ) : ℝ) + 1))) := by
  have hOK := hT.ok
  have S := RecStep.seq CEnv.stab (topSw_step (I := I) (fl := fl) (K := K) (ρ := ρ) (G := G) (n := n) H hT hk hYX)
    (RecStep.seq CEnv.stab (topXB_step (I := I) (tab := tab) (fl := fl) (K := K) (ρ := ρ) (G := G) (n := n) hT hk hYX)
      (topSw_step (I := I) (fl := fl) (K := K) (ρ := ρ) (G := G) (n := n) H hT hk hYX))
  refine S.congr (fun m => ?_) le_rfl
  set Mid := 2 ^ (L - 1) * k with hMidd
  have hMid0 : 0 < Mid := by positivity
  have hS20 : 0 < l.sX * 2 ^ q := Nat.mul_pos hOK.pX (by positivity)
  have eY : l.sY * 2 ^ q = l.sX * 2 ^ q * 2 * Mid := by rw [hYX, hT.L1, hMidd]; ring
  have has : ∀ m', xorA Mid 2 0 (m' / (2 * (l.sX * 2 ^ q))) = gc 2 (l.sY * 2 ^ q) m' := by
    intro m'
    simp only [xorA, gc, pow_zero, Nat.div_one, Nat.mod_mod]
    rw [Nat.div_div_eq_div_mul, eY]; ring_nf
  show swP 2 (l.sY * 2 ^ q) (l.sX * 2 ^ q) (rotP 2 (l.sX * 2 ^ q) (xorA Mid 2 0)
    (swP 2 (l.sY * 2 ^ q) (l.sX * 2 ^ q) m)) = l.stepP (flipS q) m
  unfold rotP
  rw [has, Lay.swflip hS20 hMid0 eY m]
  exact Lay.flip_pull hOK hT.ql hT.hq m (Lay.gcX_bit hT.ql hT.hq m)

theorem isPos_of {t : IState HS} {r : Fin HS} {v : ℤ} (h : ∃ L, t.G r = .int v :: L) :
    NLogN.KFX.isPos (t.cl r) = decide (0 < v) := by
  obtain ⟨L, hL⟩ := h
  rw [cl_int _ _ _ _ hL]
  unfold NLogN.KFX.isPos
  by_cases h0 : v = 0
  · subst h0; simp
  · by_cases h1 : v < 0
    · simp [h0, h1]; omega
    · simp [h0, h1]; omega

/-- **The top-bit step.** -/
theorem topC_step {Ksw : ℝ} (hKsw : 0 ≤ Ksw) (H : SwOK tab l12 τ Ksw) (hT : TopOK l L q Br)
    (hpos : 0 < fl → ∃ k, 0 < k ∧ l.sX = l.sY * l.QL * k)
    (hneg : ¬ 0 < fl → ∃ k, 0 < k ∧ l.sY = l.sX * l.QL * k) :
    RecStep I tab (topC l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br (l.stepP (flipS q))
      (25 + (cXorU (l.M / (2 * (l.sY * 2 ^ q))) (l.sY * 2 ^ q * Br) 1 (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) +
        (cXorU (l.M / (2 * (l.sX * 2 ^ q))) (l.sX * 2 ^ q * Br) 1 (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) +
        2 * (Ksw * (((l.M * Br : ℕ) : ℝ) + 1))) := by
  have h0 : 0 ≤ Ksw * (((l.M * Br : ℕ) : ℝ) + 1) := by positivity
  by_cases hf : 0 < fl
  · obtain ⟨k, hk, e⟩ := hpos hf
    refine (RecStep.iteT (fun t ht => by rw [isPos_of ht.fl]; simpa using hf)
      (topA_step (I := I) (tab := tab) (fl := fl) (K := K) (ρ := ρ) (G := G) (n := n) hT hk e)).congr
      (fun m => rfl) ?_
    have : (0 : ℝ) ≤ (cXorU (l.M / (2 * (l.sX * 2 ^ q))) (l.sX * 2 ^ q * Br) 1
      (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) := Nat.cast_nonneg _
    linarith
  · obtain ⟨k, hk, e⟩ := hneg hf
    refine (RecStep.iteF (fun t ht => by rw [isPos_of ht.fl]; simpa using hf)
      (topB_step (I := I) (fl := fl) (K := K) (ρ := ρ) (G := G) (n := n) H hT hk e)).congr
      (fun m => rfl) ?_
    have : (0 : ℝ) ≤ (cXorU (l.M / (2 * (l.sY * 2 ^ q))) (l.sY * 2 ^ q * Br) 1
      (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) := Nat.cast_nonneg _
    linarith

end Top

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CPhase
/-!
# Round six, compact controls (I2C): the compact phase as record steps

The ten table rotations (`rotYA`, `rotYB` on `Y`; `rotS`, `rotC`, `rotL ±1` on `Bk`) and the
twelve Lemma 12 swaps (`swT`, `swU`: the compact fields `T`, `U` with `Bk`) of the compact
program, with all parameters read from the registers of `CEnv`, as `RecStep`s:

* `phaseC_step`: one phase is `l.stepP phInv`;
* `psiC_step`: phase, load, phase, unload is `l.stepP Psi`;
* `compactC_step`: followed by the correction it is `l.stepP TlS` (exactly).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel AModelL12

/-! ## Generic rotation and swap steps -/

/-! ## The layout facts of the compact phase -/

namespace PhOK

variable {l : Lay} {K ρ G n L Br : ℕ} (hP : PhOK l K ρ G n L Br)
include hP

end PhOK

/-! ## The register expressions -/

/-! ## The steps -/

section Steps

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {l : Lay} {K ρ G n L q Br : ℕ} {fl : ℤ}

variable (hP : PhOK l K ρ G n L Br)
include hP

/-- `s 2^ρ / QC` on a stride `s = QC k` (on register `r`). -/
theorem eBd_sp {t : IState HS} {r : Fin HS} {s : ℕ} (hs : ∃ L, t.G r = .int (s : ℤ) :: L)
    (hr : r.val < 56) (ht : CEnv t l K ρ G n q Br fl) (hsM : s * l.QL ≤ l.M) :
    ESp (eBd r) t (zsz ((l.M * Br : ℕ) : ℤ) + 3) ((s * 2 ^ ρ / l.QC : ℕ) : ℤ) := by
  have hV := hP.kv
  have hqc := hV.qc1
  have hρ : 2 ^ ρ ≤ l.QL := by rw [hV.ql]; exact hV.hρL
  have h1 : s * 2 ^ ρ ≤ l.M := le_trans (Nat.mul_le_mul_left _ hρ) hsM
  have hQM : l.QC ≤ l.M := le_trans hV.qcQL hV.qlM
  have hs1 : s ≤ l.M := le_trans (Nat.le_mul_of_pos_right _ hV.ql1) hsM
  exact ESp.ndivN (ESp.mulN (sp_reg hs hr (hP.z3 (by omega)))
    (ESp.of_eq' (sp_pow ht.key.r2 (by decide) (hP.z3 (by have := hV.ρM; omega))) (by push_cast; ring))
    (hP.z3 (by omega))) (sp_reg ht.key.qc (by decide) (hP.z3 (by omega))) (by omega)
    (hP.z3 (by have := Nat.div_le_self (s * 2 ^ ρ) l.QC; omega))

theorem div_qc {s k : ℕ} (hs : s = 1 * l.QC * k) : s * 2 ^ ρ / l.QC = k * 2 ^ ρ := by
  have := hP.kv.qc1
  rw [hs, show 1 * l.QC * k * 2 ^ ρ = l.QC * (k * 2 ^ ρ) by ring, Nat.mul_div_cancel_left _ (by omega)]

/-- **Step `S`**. -/
theorem rotS_RS :
    RecStep I tab rotS (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (rotP l.QC 1 (tabE 1 tfS ((2 : ℤ) ^ K) ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) 1
        (l.sY * 2 ^ ρ / l.QC) (l.sY * 2 ^ ρ / l.QC) l.QC n))
      (cR tmS l n Br (l.M / l.QC) l.QC 1) := by
  have hV := hP.kv
  have hOK := hP.ok
  obtain ⟨k, hk, ek⟩ := hOK.kYB
  rw [hP.sb] at ek
  have hd : l.sY * 2 ^ ρ / l.QC = k * 2 ^ ρ := div_qc hP ek
  have hdM : l.sY * 2 ^ ρ / l.QC ≤ l.M := by
    have : l.sY * 2 ^ ρ ≤ l.M := le_trans (Nat.mul_le_mul_left _ (by rw [hV.ql]; exact hV.hρL))
      hOK.yq_le
    exact le_trans (Nat.div_le_self _ _) this
  have hK2 : 2 ^ K ≤ l.M := hV.KM
  refine rotBk_RS hP (segTR_S (by positivity) hV.R4) 1 (Or.inl rfl) (by decide +kernel)
    (by rw [hd]; positivity) (by rw [hd]; positivity) (by positivity) (by positivity)
    (by have := hP.z3 (v := 2 ^ K) (by omega); push_cast at this; exact this)
    (by have := hP.z3 (v := 2 ^ K) (by omega); push_cast at this; exact this) hdM hdM (by decide)
    (by intro p hp; simp only [rotPlR, List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          (unfold KFX.NoLow; decide))
    (fun t ht => eBd_sp hP ht.key.sy (by decide) ht hOK.yq_le)
    (fun t ht => eBd_sp hP ht.key.sy (by decide) ht hOK.yq_le)
    (fun t ht => sp_pow ht.key.k2 (by decide) (hP.z3 (by omega)))
    (fun t ht => sp_pow ht.key.k2 (by decide) (hP.z3 (by omega)))
    (fun t ht => sp_pow ht.key.rr (by decide) (hP.z3 (by have := hV.RM; omega)))

/-- **Step `C`**. -/
theorem rotC_RS :
    RecStep I tab rotC (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (rotP l.QC 1 (tabE (-1) tfC ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) 1
        (l.sY * 2 ^ ρ / l.QC) (l.sU / l.QC) l.QC n))
      (cR tmC l n Br (l.M / l.QC) l.QC 1) := by
  have hV := hP.kv
  have hOK := hP.ok
  obtain ⟨k, hk, ek⟩ := hOK.kYB
  obtain ⟨k', hk', ek'⟩ := hOK.kUB
  rw [hP.sb] at ek ek'
  have hd : l.sY * 2 ^ ρ / l.QC = k * 2 ^ ρ := div_qc hP ek
  have hqc := hV.qc1
  have hd' : l.sU / l.QC = k' := by
    rw [ek', show 1 * l.QC * k' = l.QC * k' by ring, Nat.mul_div_cancel_left _ (by omega)]
  have hdM : l.sY * 2 ^ ρ / l.QC ≤ l.M := by
    have : l.sY * 2 ^ ρ ≤ l.M := le_trans (Nat.mul_le_mul_left _ (by rw [hV.ql]; exact hV.hρL))
      hOK.yq_le
    exact le_trans (Nat.div_le_self _ _) this
  have hdM' : l.sU / l.QC ≤ l.M := le_trans (Nat.div_le_self _ _) hP.uM
  have hK2 : 2 ^ K ≤ l.M := hV.KM
  have hQM : l.QC ≤ l.M := le_trans hV.qcQL hV.qlM
  refine rotBk_RS hP (segTR_C (by positivity) hV.R4) (-1) (Or.inr rfl) (by decide +kernel)
    (by rw [hd]; positivity) (by rw [hd']; exact hk') (by positivity) (by positivity)
    (by have := hP.z3 (v := 2 ^ K) (by omega); push_cast at this; exact this)
    (by have := hP.z3 (v := 2 ^ G) (by have := hV.RM; omega); push_cast at this; exact this)
    hdM hdM' (by decide)
    (by intro p hp; simp only [rotPlR, List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          (unfold KFX.NoLow; decide))
    (fun t ht => eBd_sp hP ht.key.sy (by decide) ht hOK.yq_le)
    (fun t ht => ESp.ndivN (sp_reg ht.key.su (by decide) (hP.z3 (by have := hP.uM; omega)))
      (sp_reg ht.key.qc (by decide) (hP.z3 (by omega))) (by omega) (hP.z3 (by omega)))
    (fun t ht => sp_pow ht.key.k2 (by decide) (hP.z3 (by omega)))
    (fun t ht => sp_pow ht.key.rr (by decide) (hP.z3 (by have := hV.RM; omega)))
    (fun t ht => sp_pow ht.key.rr (by decide) (hP.z3 (by have := hV.RM; omega)))

/-- **Load / unload**. -/
theorem rotL_RS (sgn : ℤ) (hs : sgn = 1 ∨ sgn = -1) (hfok : fok (tabGenR sgn tmS) = true) :
    RecStep I tab (rotL sgn) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (rotP l.QC 1 (tabE sgn tfS ((2 : ℤ) ^ K) ((2 : ℤ) ^ K) ((2 : ℤ) ^ G) 1
        (l.sX * 2 ^ ρ / l.QC) (l.sX * 2 ^ ρ / l.QC) l.QC n))
      (cR tmS l n Br (l.M / l.QC) l.QC 1) := by
  have hV := hP.kv
  have hOK := hP.ok
  obtain ⟨k, hk, ek⟩ := hOK.kXB
  rw [hP.sb] at ek
  have hd : l.sX * 2 ^ ρ / l.QC = k * 2 ^ ρ := div_qc hP ek
  have hdM : l.sX * 2 ^ ρ / l.QC ≤ l.M := by
    have : l.sX * 2 ^ ρ ≤ l.M := le_trans (Nat.mul_le_mul_left _ (by rw [hV.ql]; exact hV.hρL))
      hOK.xq_le
    exact le_trans (Nat.div_le_self _ _) this
  have hK2 : 2 ^ K ≤ l.M := hV.KM
  refine rotBk_RS hP (segTR_S (by positivity) hV.R4) sgn hs hfok
    (by rw [hd]; positivity) (by rw [hd]; positivity) (by positivity) (by positivity)
    (by have := hP.z3 (v := 2 ^ K) (by omega); push_cast at this; exact this)
    (by have := hP.z3 (v := 2 ^ K) (by omega); push_cast at this; exact this) hdM hdM (by decide)
    (by intro p hp; simp only [rotPlR, List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          (unfold KFX.NoLow; decide))
    (fun t ht => eBd_sp hP ht.key.sx (by decide) ht hOK.xq_le)
    (fun t ht => eBd_sp hP ht.key.sx (by decide) ht hOK.xq_le)
    (fun t ht => sp_pow ht.key.k2 (by decide) (hP.z3 (by omega)))
    (fun t ht => sp_pow ht.key.k2 (by decide) (hP.z3 (by omega)))
    (fun t ht => sp_pow ht.key.rr (by decide) (hP.z3 (by have := hV.RM; omega)))

/-- The swap of `T` with `Bk`. -/
theorem swT_RS {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (swW l12 kST) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (swP l.QC l.sT l.sB) (cW Ksw τ l n G Br) := by
  obtain ⟨k, hk, ek⟩ := hP.ok.kTB
  obtain ⟨P, hP0, eP⟩ := hP.ok.kMT
  rw [hP.sb] at ek ⊢
  exact swW_RS hP H hnG (Or.inr rfl) (fun t ht => ht.key.st) (by rw [ek]; ring) (by rw [eP]; ring)
    hP0 hk

/-- The swap of `U` with `Bk`. -/
theorem swU_RS {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (swW l12 kSU) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (swP l.QC l.sU l.sB) (cW Ksw τ l n G Br) := by
  obtain ⟨k, hk, ek⟩ := hP.ok.kUB
  obtain ⟨a, ha, ea⟩ := hP.ok.kTU
  obtain ⟨P, hP0, eP⟩ := hP.ok.kMT
  have hq := hP.ok.qc
  rw [hP.sb] at ek ⊢
  exact swW_RS hP (P := a * l.QC * P) H hnG (Or.inl rfl) (fun t ht => ht.key.su) (by rw [ek]; ring)
    (by rw [eP, ea]; ring) (by positivity) hk

/-- `A ↦ A` through two swaps. -/
theorem thru_RS {r : Fin HS} {p : IStmt HS 1} {π1 π2 : ℕ → ℕ} {c1 c2 : ℝ}
    (hW : RecStep I tab (swW l12 r) (fun t => CEnv t l K ρ G n q Br fl) l.M Br π1 c1)
    (hp : RecStep I tab p (fun t => CEnv t l K ρ G n q Br fl) l.M Br π2 c2) :
    RecStep I tab (thru l12 r p) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (fun m => π1 (π2 (π1 m))) (c2 + 2 * c1) :=
  (RecStep.seq CEnv.stab hW (RecStep.seq CEnv.stab hp hW)).congr (fun m => rfl) (le_of_eq (by ring))

theorem dvd_cancel {a b : ℕ} (h : a ∣ b) : a * (b / a) = b := Nat.mul_div_cancel' h

/-- **One phase** is `phInv`. -/
theorem phaseC_step {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (phaseC l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (l.stepP (fun _ c => phInv K ρ G n L c)) (cPh Ksw τ l n G Br) := by
  have hV := hP.kv
  have hOK := hP.ok
  have hR4 := hV.R4
  have sA := rotY_RS (I := I) (tab := tab) (q := q) (fl := fl) hP (segTR_A (by positivity) hR4)
    (by decide +kernel) (by decide)
  have sB := rotY_RS (I := I) (tab := tab) (q := q) (fl := fl) hP (segTR_B (by positivity) hR4)
    (by decide +kernel) (by decide)
  have sS := rotS_RS (I := I) (tab := tab) (q := q) (fl := fl) hP
  have sC := rotC_RS (I := I) (tab := tab) (q := q) (fl := fl) hP
  have sw := swT_RS (I := I) (tab := tab) (q := q) (fl := fl) hP H hnG
  have S := RecStep.seq CEnv.stab sA (RecStep.seq CEnv.stab (thru_RS hP sw sS)
    (RecStep.seq CEnv.stab sB (thru_RS hP sw sC)))
  obtain ⟨c, hc, ec⟩ := hOK.kUY
  obtain ⟨b, hb, eb⟩ := hOK.kTY
  obtain ⟨k, hk, ek⟩ := hOK.kYB
  obtain ⟨k', hk', ek'⟩ := hOK.kUB
  have d1 : l.QL * l.sY * (l.sU / (l.QL * l.sY)) = l.sU := dvd_cancel hP ⟨c, by rw [ec]; ring⟩
  have d2 : l.QL * l.sY * (l.sT / (l.QL * l.sY)) = l.sT := dvd_cancel hP ⟨b, by rw [eb]; ring⟩
  have d3 : l.QC * l.sB * (l.sY * 2 ^ ρ / l.QC) = l.sY * 2 ^ ρ := by
    rw [hP.sb, mul_one]; exact dvd_cancel hP ⟨k * 2 ^ ρ, by rw [ek, hP.sb]; ring⟩
  have d4 : l.QC * l.sB * (l.sU / l.QC) = l.sU := by
    rw [hP.sb, mul_one]; exact dvd_cancel hP ⟨k', by rw [ek', hP.sb]; ring⟩
  have eA := Lay.rotA_pull (K := K) (ρ := ρ) hOK hV.qc hV.ql hV.hG d1 d2
  have eB := Lay.rotB_pull (K := K) (ρ := ρ) hOK hV.qc hV.ql hV.hG d1 d2
  have eS := Lay.rotS_pull (G := G) hOK hV.qc hV.ql hV.hK hV.hL d3
  have eC := Lay.rotC_pull hOK hV.qc hV.ql hV.hK hV.hG hV.hL d3 d4
  simp only [hP.sb] at eS eC
  refine S.congr (fun m => ?_) (le_of_eq (by unfold cPh; ring))
  try simp only [hP.sb]
  rw [eC, eB, eS, eA]
  exact Lay.phase_pull hOK hV.qc hV.ql m

/-- **The ten pulls** are `Psi`. -/
theorem psiC_step {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (psiC l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (l.stepP (fun x c => Psi K ρ G n L x c)) (cPsi Ksw τ l n G Br) := by
  have hV := hP.kv
  have hOK := hP.ok
  have sP := phaseC_step (I := I) (q := q) (fl := fl) (L := L) hP H hnG
  have sw := swU_RS (I := I) (tab := tab) (q := q) (fl := fl) hP H hnG
  have s1 := rotL_RS (I := I) (tab := tab) (q := q) (fl := fl) hP 1 (Or.inl rfl) (by decide +kernel)
  have s2 := rotL_RS (I := I) (tab := tab) (q := q) (fl := fl) hP (-1) (Or.inr rfl)
    (by decide +kernel)
  have S := RecStep.seq CEnv.stab sP (RecStep.seq CEnv.stab (thru_RS hP sw s1)
    (RecStep.seq CEnv.stab sP (thru_RS hP sw s2)))
  obtain ⟨k, hk, ek⟩ := hOK.kXB
  have d3 : l.QC * l.sB * (l.sX * 2 ^ ρ / l.QC) = l.sX * 2 ^ ρ := by
    rw [hP.sb, mul_one]; exact dvd_cancel hP ⟨k * 2 ^ ρ, by rw [ek, hP.sb]; ring⟩
  have e1 := Lay.rotL_pull (G := G) hOK hV.qc hV.ql hV.hK hV.hL d3 1 (Or.inl rfl)
  have e2 := Lay.rotL_pull (G := G) hOK hV.qc hV.ql hV.hK hV.hL d3 (-1) (Or.inr rfl)
  simp only [hP.sb] at e1 e2
  refine S.congr (fun m => ?_) (le_of_eq (by unfold cPsi; ring))
  try simp only [hP.sb]
  rw [e2, e1]
  exact Lay.psi_pull hOK hV.qc hV.ql m

/-- **The correction** is `corrC`. -/
theorem corr_RS :
    RecStep I tab (corrLC (.reg kBr) (.reg kM) (.reg kA)) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (corrC l K ρ G n L) (cCo l K ρ G n L Br) := by
  intro t recs R0 ht hl hb h0
  have hM1 : 1 ≤ l.M := hP.ok.pM
  refine ⟨_, corrLC_runs hP.br hP.kv t recs hl (fun m => bnd_bits (hb m)) R0 h0 ht.key
    (by decide) (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (sp_reg ht.br (by decide) (hP.zB (by nlinarith [hP.br])))
    (sp_reg ht.m (by decide) (hP.z3 (by omega)))
    (sp_reg ht.a (by decide) (le_trans (NLogN.zsz_natCast_le_self _) (by omega))), le_rfl⟩

/-- **The compact phase** is `TlS` on every record. -/
theorem compactC_step {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (compactC l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (l.stepP (fun x c => TlS K ρ n x c)) (cCmp Ksw τ l K ρ G n L Br) := by
  have hV := hP.kv
  refine (RecStep.seq CEnv.stab (psiC_step (I := I) (q := q) (fl := fl) hP H hnG)
    (corr_RS (I := I) (tab := tab) (q := q) (fl := fl) hP)).congr
    (fun m => psi_corrC hP.ok hV.qc hV.ql hV.hK hV.hL m) le_rfl

end Steps

end IntMul.Kappa.R6.IL2C

