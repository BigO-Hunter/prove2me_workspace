    sc l.QC l.sU v m = l.set ⟨(l.cs m).t, v, (l.cs m).y⟩ m := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨d, hd, ed⟩ := h.kUY
  simp only [set, cs]
  rw [sc_gc, sc_gc_of (gc_up h.pU ha ea hv m)]

theorem scT_eq (h : l.OK) {v : ℕ} (hv : v < l.QC) (m : ℕ) :
    sc l.QC l.sT v m = l.set ⟨v, (l.cs m).u, (l.cs m).y⟩ m := by
  simp only [set, cs]
  rw [sc_gc, sc_gc]

/-! ### Rotations as steps -/

/-- The rotation amount of a table entry `(o mod Q)`. -/
theorem rot_subM {Q a : ℕ} (hQ : 0 < Q) (ha : a < Q) (o : ℤ) :
    (a + Q - (o % (Q : ℤ)).toNat) % Q = subM Q a o := by
  have h0 : 0 ≤ o % (Q : ℤ) := Int.emod_nonneg _ (by omega)
  have h1 : o % (Q : ℤ) < Q := Int.emod_lt_of_pos _ (by omega)
  have hr : ((o % (Q : ℤ)).toNat : ℤ) = o % (Q : ℤ) := Int.toNat_of_nonneg h0
  have hle : (o % (Q : ℤ)).toNat ≤ a + Q := by omega
  have e : (((a + Q - (o % (Q : ℤ)).toNat) % Q : ℕ) : ℤ) = ((a : ℤ) - o) % (Q : ℤ) := by
    push_cast [Nat.cast_sub hle]
    rw [hr]
    have : (a : ℤ) + Q - o % Q = ((a : ℤ) - o) + Q * (1 + o / Q) := by
      linear_combination (-1 : ℤ) * Int.emod_add_mul_ediv o (Q : ℤ)
    rw [this, Int.add_mul_emod_self_left]
  unfold subM
  rw [← e, Int.toNat_natCast]

/-- **Rotation of `Y`** by a table whose entry at the prefix of `m` is `o (xv m) (cs m) mod QL`. -/
theorem rotY_eq (h : l.OK) (as : ℕ → ℕ) (o : ℕ → CS → ℤ) {m : ℕ}
    (has : as (m / (l.QL * l.sY)) = ((o (l.xv m) (l.cs m)) % (l.QL : ℤ)).toNat) :
    rotP l.QL l.sY as m = l.stepP (fun x c => ⟨c.t, c.u, subM l.QL c.y (o x c)⟩) m := by
  unfold rotP stepP
  rw [has, rot_subM h.ql (gc_lt h.ql _), scY_eq h (subM_lt h.ql _ _)]
  rfl

/-- **Rotation of an upper compact field `(QC, S)` through `Bk`** (swap, rotate `Bk`, swap). -/
theorem rotUp_eq (h : l.OK) {S k : ℕ} (hk : 0 < k) (hS : S = l.sB * l.QC * k) (as : ℕ → ℕ)
    {m : ℕ} {a : ℤ}
    (has : as (swP l.QC S l.sB m / (l.QC * l.sB)) = (a % (l.QC : ℤ)).toNat) :
    swP l.QC S l.sB (rotP l.QC l.sB as (swP l.QC S l.sB m)) = sc l.QC S (subM l.QC (gc l.QC S m) a) m := by
  have hB := h.pB; have hQ := h.qc
  set m1 := swP l.QC S l.sB m with hm1
  have g1 : gc l.QC l.sB m1 = gc l.QC S m := by
    rw [hm1, swP, gc_dn hB hS, gc_sc_same hB (gc_lt hQ _)]
  have g1' : gc l.QC S m1 = gc l.QC l.sB m := by
    rw [hm1, swP, gc_sc_same (by rw [hS]; positivity) (gc_lt hQ _)]
  set w := subM l.QC (gc l.QC S m) a with hw
  have hwl : w < l.QC := subM_lt hQ _ _
  have e2 : rotP l.QC l.sB as m1 = sc l.QC l.sB w m1 := by
    unfold rotP
    rw [has, g1, rot_subM hQ (gc_lt hQ _)]
  rw [e2]
  set m2 := sc l.QC l.sB w m1 with hm2
  have g2 : gc l.QC l.sB m2 = w := gc_sc_same hB hwl m1
  have g2' : gc l.QC S m2 = gc l.QC l.sB m := by
    rw [hm2, gc_up hB hk hS hwl, g1']
  unfold swP
  rw [g2, g2', hm2, sc_sc hB hwl, hm1, swP, ← sc_comm hB hk hS (gc_lt hQ _), sc_sc hB (gc_lt hQ _),
    sc_gc, sc_sc (by rw [hS]; positivity) (gc_lt hQ _)]

theorem rotT_eq (h : l.OK) (as : ℕ → ℕ) (o : ℕ → CS → ℤ) {m : ℕ}
    (has : as (swP l.QC l.sT l.sB m / (l.QC * l.sB)) = ((o (l.xv m) (l.cs m)) % (l.QC : ℤ)).toNat) :
    swP l.QC l.sT l.sB (rotP l.QC l.sB as (swP l.QC l.sT l.sB m)) =
      l.stepP (fun x c => ⟨subM l.QC c.t (o x c), c.u, c.y⟩) m := by
  obtain ⟨k, hk, e⟩ := h.kTB
  rw [rotUp_eq h hk e as has, scT_eq h (subM_lt h.qc _ _)]
  rfl

theorem rotU_eq (h : l.OK) (as : ℕ → ℕ) (o : ℕ → CS → ℤ) {m : ℕ}
    (has : as (swP l.QC l.sU l.sB m / (l.QC * l.sB)) = ((o (l.xv m) (l.cs m)) % (l.QC : ℤ)).toNat) :
    swP l.QC l.sU l.sB (rotP l.QC l.sB as (swP l.QC l.sU l.sB m)) =
      l.stepP (fun x c => ⟨c.t, subM l.QC c.u (o x c), c.y⟩) m := by
  obtain ⟨k, hk, e⟩ := h.kUB
  rw [rotUp_eq h hk e as has, scU_eq h (subM_lt h.qc _ _)]
  rfl

/-! ### Fields read through the swaps -/

theorem gcY_swP (h : l.OK) {S k : ℕ} (hk : 0 < k) (hS : S = l.sY * l.QL * k) (m : ℕ) :
    gc l.QL l.sY (swP l.QC S l.sB m) = gc l.QL l.sY m := by
  obtain ⟨a, ha, ea⟩ := h.kYB
  unfold swP
  rw [gc_dn h.pY hS, gc_up h.pB ha ea (gc_lt h.qc _)]

theorem gcX_swP (h : l.OK) {S k : ℕ} (hk : 0 < k) (hS : S = l.sX * l.QL * k) (m : ℕ) :
    gc l.QL l.sX (swP l.QC S l.sB m) = gc l.QL l.sX m := by
  obtain ⟨a, ha, ea⟩ := h.kXB
  unfold swP
  rw [gc_dn h.pX hS, gc_up h.pB ha ea (gc_lt h.qc _)]

/-- `U` read through the `T`/`Bk` swap. -/
theorem gcU_swPT (h : l.OK) (m : ℕ) : gc l.QC l.sU (swP l.QC l.sT l.sB m) = gc l.QC l.sU m := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨b, hb, eb⟩ := h.kUB
  unfold swP
  rw [gc_dn h.pU ea, gc_up h.pB hb eb (gc_lt h.qc _)]

end Lay

/-! ## Digits of unreduced field values -/

theorem dgt_mod_dvd {W N : ℕ} (hW : 0 < W) {s : ℕ} (h : W ^ (s + 1) ∣ N) (b : ℕ) :
    dgt W s (b % N) = dgt W s b := by
  unfold dgt
  obtain ⟨c, hc⟩ := h
  have hb : b = b % N + N * (b / N) := (Nat.mod_add_div b N).symm
  conv_rhs => rw [hb]
  have hWs : 0 < W ^ s := pow_pos hW s
  rw [show N * (b / N) = W ^ s * (W * (c * (b / N))) by rw [hc]; ring,
    Nat.add_mul_div_left _ _ hWs, Nat.add_mul_mod_self_left]

theorem cdg_mod {G n s : ℕ} (hs : s < n) (a : ℕ) : cdg G s (a % Qc G n) = cdg G s a := by
  unfold cdg Qc
  refine dgt_mod_dvd (by positivity) ?_ a
  exact Nat.pow_dvd_pow _ (by omega)

theorem seg_mod {K ρ L s : ℕ} (hL : ρ + (s + 1) * K ≤ L) (a : ℕ) :
    seg K ρ s (a % 2 ^ L) = seg K ρ s a := by
  unfold seg
  have e : a % 2 ^ L / 2 ^ ρ = a / 2 ^ ρ % 2 ^ (L - ρ) := by
    rw [← Nat.mod_mul_right_div_self, ← pow_add]; congr 3; omega
  rw [e]
  refine dgt_mod_dvd (by positivity) ?_ _
  rw [← pow_mul]; exact Nat.pow_dvd_pow _ (by rw [mul_comm]; omega)

theorem ybit_mod {K ρ L s : ℕ} (hL : ρ + (s + 1) * K ≤ L) (a : ℕ) :
    ybit K ρ s (a % 2 ^ L) = ybit K ρ s a := by
  unfold ybit; rw [seg_mod hL]

end IntMul.Kappa.R6.IL2C

end

