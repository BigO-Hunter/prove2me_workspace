section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD Butterfly AModel
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem NLogN.KFL.rotStep_runs {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {d0 d1 Q : ℕ}
    (hd0 : 0 < d0) (hd1 : 0 < d1) (hQe : Q = 2 ^ (f * K)) (l : Butterfly.Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zd0 : NLogN.zsz (d0 : ℤ) ≤ Bb) (zd1 : NLogN.zsz (d1 : ℤ) ≤ Bb)
    (P B w : ℕ) (zP : NLogN.zsz (P : ℤ) ≤ Bb) (zB : NLogN.zsz (B : ℤ) ≤ Bb)
    (t : NLogN.IState NLogN.HS) (xs : List ℤ) (R : List NLogN.Item) (hlen : xs.length = P * Q * B) (hbw : NLogN.Bnd w xs)
    (h0 : t.G 0 = NLogN.ints xs ++ R) :
    NLogN.IRuns I iprog (NLogN.KFL.rotStep K ρ f d0 d1 Q P B l.sgn l.b) t
      (t.upd 0 (NLogN.ints (AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.rotAddr Q (NLogN.KFL.tabA K ρ f d0 d1 Q l)) 0 xs) ++ R))
      (NLogN.KFL.cRot K f l.b P Q B w Bb) := by
  have hQ0 : 0 < Q := by rw [hQe]; positivity
  have zQ : NLogN.zsz (Q : ℤ) ≤ Bb := NLogN.KFL.zsz_nat_lt (by omega)
  set as := NLogN.KFL.tabA K ρ f d0 d1 Q l
  have has : ∀ p, as p ≤ Q := by
    intro p
    simp only [as, NLogN.KFL.tabA, NLogN.KFL.amt]
    have h1 := Int.emod_nonneg (l.sgn * Butterfly.offset K ρ f ↑(p / d0 % Q) ↑(p / d1 % Q) l.b)
      (by positivity : (2 : ℤ) ^ (f * K) ≠ 0)
    have h2 := Int.emod_lt_of_pos (l.sgn * Butterfly.offset K ρ f ↑(p / d0 % Q) ↑(p / d1 % Q) l.b)
      (by positivity : (0 : ℤ) < 2 ^ (f * K))
    have : ((2 : ℤ) ^ (f * K)) = ((Q : ℕ) : ℤ) := by rw [hQe]; push_cast; rfl
    omega
  set ys := AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.rotAddr Q as) 0 xs
  set ev := NLogN.KIL.evalP t (NLogN.KFL.rotL P Q B)
  set u := NLogN.KIL.pushSt t ev
  have hev : ev = [(1, (P : ℤ)), (2, (Q : ℤ)), (4, (B : ℤ))] := by simp [ev, NLogN.KIL.evalP, NLogN.KFL.rotL, NLogN.Ex.eval]
  have uG : ∀ r : Fin NLogN.HS, u.G r = if r = 1 then .int (P : ℤ) :: t.G 1 else if r = 2 then
      .int (Q : ℤ) :: t.G 2 else if r = 4 then .int (B : ℤ) :: t.G 4 else t.G r := by
    intro r
    simp only [u, hev, NLogN.KIL.pushSt]
    by_cases h1 : r = 1
    · subst h1; simp +decide [NLogN.IState.upd_G]
    by_cases h2 : r = 2
    · subst h2; simp +decide [NLogN.IState.upd_G]
    by_cases h4 : r = 4
    · subst h4; simp +decide [NLogN.IState.upd_G]
    simp [NLogN.IState.upd_G, h1, h2, h4]
  -- the table
  have TG := NLogN.KFL.tabGen_fsp hK hρK hf hd0 hd1 hQ0 l hs hb hB2 hbig zd0 zd1 (by omega) P zP u
    (fun _ => []) rfl rfl
  rw [NLogN.KIL.encK_nil, ← NLogN.KIL.encK_upd, NLogN.KIL.encK_nil] at TG
  simp only [List.append_nil] at TG
  set tbl := (List.range P).map (fun p => (as p : ℤ))
  have T1 := TG.irun (I := I) (iprog := iprog) (NLogN.KFL.fok_tabGen _ _ _ _ _ _ _ _ _)
  set t1 := u.upd 14 (NLogN.ints tbl ++ u.G 14)
  have t1G : ∀ {r : Fin NLogN.HS}, r ≠ 14 → t1.G r = u.G r := fun h => by
    simp only [t1, NLogN.IState.upd_G]; simp [h]
  have u0 : u.G 0 = NLogN.ints xs ++ R := by rw [uG]; simp +decide [h0]
  have u1 : u.G 1 = .int (P : ℤ) :: t.G 1 := by rw [uG]; simp +decide
  have u2 : u.G 2 = .int (Q : ℤ) :: t.G 2 := by rw [uG]; simp +decide
  have u4 : u.G 4 = .int (B : ℤ) :: t.G 4 := by rw [uG]; simp +decide
  have RT := NLogN.KFC.rotF_spec (I := I) (iprog := iprog) t1 xs as P Q B w R (t.G 1) (t.G 2) (t.G 4)
    (u.G 14) has hlen hbw (by rw [t1G (by decide)]; exact u0) (by rw [t1G (by decide)]; exact u1)
    (by rw [t1G (by decide)]; exact u2) (by rw [t1G (by decide)]; exact u4)
    (by simp only [t1, NLogN.IState.upd_G, Function.update_self]; rfl)
  have eout : (t1.upd 0 (NLogN.ints ys ++ R)).upd 14 (u.G 14) = u.upd 0 (NLogN.ints ys ++ R) := by
    refine NLogN.IState.ext' (fun j => ?_) rfl rfl
    simp only [t1, NLogN.IState.upd_G, Function.update_apply]
    split_ifs with h1 h2 <;> simp_all
  rw [eout] at RT
  have hl : NLogN.KIL.PushOK t Bb (NLogN.KFL.rotL P Q B) := by
    apply NLogN.KIL.pushOK_low
    · intro p hp; simp only [NLogN.KFL.rotL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> (dsimp only; decide)
    · intro p hp; simp only [NLogN.KFL.rotL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> exact NLogN.KIL.goodE_lit ‹_›
  have hv : ∀ q ∈ NLogN.KFL.rotL P Q B, NLogN.zsz (q.2.eval t) ≤ Bb := by
    intro q hq; simp only [NLogN.KFL.rotL, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl <;> simpa [NLogN.Ex.eval]
  have W := NLogN.KFD.IRuns.withPushI (I := I) (iprog := iprog) (NLogN.KFL.rotL P Q B) _ t Bb hl hv (by simp +decide [NLogN.KFL.rotL])
    ys R _ (T1.seq RT)
  refine W.mono ?_
  have hpc : NLogN.KIL.pushCost Bb (NLogN.KFL.rotL P Q B) = 6 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 := by
    rw [NLogN.KIL.pushCost]; simp only [NLogN.KFL.rotL, List.map_cons, List.map_nil, NLogN.Ex.size]
    rw [List.sum_cons, List.sum_cons, List.sum_cons, List.sum_nil]; ring
  have hl3 : (NLogN.KFL.rotL P Q B).length = 3 := rfl
  rw [hpc, hl3]
  simp only [NLogN.KFL.cRot]
  have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  generalize (Bb + 2) ^ 2 = X at *
  omega
end
