variable {P K D S ρ : ℕ}
theorem NLogN.KFN.sImpl_leaf (pos : Fin 1 → ℕ) (t S0 B : ℕ) (hpos : pos 0 < t) (hS : 1 ≤ S0) (hB : 1 ≤ B)
    {r : ℕ} (hr : 1 ≤ r) (Z : ℕ) (hZ : NLogN.zsz ((12 * (B * 2 ^ t * S0 * r)) : ℕ) ≤ Z) :
    NLogN.KFN.SImpl r (fun i => 2 ^ pos i * S0) (B * 2 ^ t * S0) (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin 1))
      (NLogN.KFH.kerP t 1 S0 (pos 0) B r 0 NLogN.KFH.MC) 1 2 (NLogN.KFH.ck (B * 2 ^ t * S0 * r) Z) := by
  have hv : AModel.vol (Butterfly.layerShape B t 1 S0) = B * 2 ^ t * S0 := by
    rw [NLogN.KFH.vol_layer, pow_one]
  have L := NLogN.KFH.limpl_ker (P := B) (K := t) (D := 1) (S := S0) (ρ := pos 0) hpos 0 hr hS hB NLogN.KFH.MC_ok
    NLogN.KFH.kerOk_MC Z (by rw [hv]; exact hZ)
  have H := NLogN.KFN.sImpl_of_limpl hpos L
  have e1 : (fun i : Fin 1 => NLogN.KFH.stT t 1 S0 (pos 0) i) = fun i => 2 ^ pos i * S0 := by
    funext i
    have : i = 0 := Subsingleton.elim _ _
    subst this
    simp [NLogN.KFH.stT, NLogN.KFH.stS_eq]
  have e2 : (Butterfly.tensF (Butterfly.kerAt (0 : Fin 1) Butterfly.Cm)) =
      (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin 1)) := by
    rw [Butterfly.tens_eq_prod_kerAt Butterfly.Cm [0] (by simp) (fun i => by simp [Subsingleton.elim i 0])]
    simp
  rw [e1, e2, hv] at H
  exact H
end
