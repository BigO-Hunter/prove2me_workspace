  set f5 := Function.update f4 rN [((2 * (G * S) : ℕ) : ℤ)]
  have p6 := Sp.push s f5 (i := NLogN.KFB.rP) (e := .lit ((2 * off : ℕ) : ℤ)) (B := Z) (by decide)
    (clean_lit _) trivial trivial (zl _ (by omega))
