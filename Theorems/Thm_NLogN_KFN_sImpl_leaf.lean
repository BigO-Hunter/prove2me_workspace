  have p4 := Sp.push s f3 (i := rG) (e := .lit (G : ℤ)) (B := Z) (by decide)
    (clean_lit _) trivial trivial (zl G (by omega))
  rw [show Ex.eval (encK s f3) (.lit (G : ℤ)) :: f3 rG = [(G : ℤ)] by
    simp +decide [Ex.eval, f3, f2, f1, hC.rg]] at p4
  set f4 := Function.update f3 rG [(G : ℤ)]
  have p5 := Sp.push s f4 (i := rN) (e := .lit ((2 * (G * S) : ℕ) : ℤ)) (B := Z) (by decide)
    (clean_lit _) trivial trivial (zl _ (by omega))
