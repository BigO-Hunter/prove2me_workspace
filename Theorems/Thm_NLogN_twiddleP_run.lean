    (by simp (config := {decide := true}) [NLogN.IState.top, NLogN.Ex.eval, h28])
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top, h29])
    (by simp (config := {decide := true}) [NLogN.IState.top, NLogN.Ex.eval, h29])
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top])
    (by rw [NLogN.top_push, NLogN.aE_eval]; positivity)]
  apply NLogN.IState.ext' _ (by simp) (by simp)
  intro j'
  simp (config := {decide := true, maxSteps := 4000000}) only [NLogN.RS.run_push_G, NLogN.RS.run_pop_G, NLogN.IState.upd_G, NLogN.Ex.eval,
    NLogN.IState.top, h28, h29, h53, if_true, if_false, List.tail_cons, NLogN.Ex.ediv_eval, NLogN.Ex.emod_eval,
    NLogN.aE_eval, NLogN.yE_eval, NLogN.reE_eval, NLogN.imE_eval, NLogN.qE, NLogN.rE, NLogN.cE, NLogN.tE, NLogN.jkE, Int.toNat_natCast]
