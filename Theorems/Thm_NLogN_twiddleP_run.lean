theorem piCost_le (x₁ x₂ n : ℕ) (h₁ : x₁ ≤ 239) (h₂ : x₂ ≤ 239) :
    piCost x₁ x₂ n ≤ 10 ^ 18 * (n + 10) ^ 3 := by
  simp only [piCost, atanB]
  have a1 : (2 * (2 * n + 9) + 3) * (x₁ + 1) ≤ 960 * (n + 10) := by nlinarith
  have a2 : (2 * (2 * n + 9) + 3) * (x₂ + 1) ≤ 960 * (n + 10) := by nlinarith
  have hs : 2 * n + 9 + (2 * (2 * n + 9) + 3) * (x₁ + 1) + 2 +
      (2 * n + 9 + (2 * (2 * n + 9) + 3) * (x₂ + 1) + 2) + 6 ≤ 2000 * (n + 10) := by omega
  have hs2 := Nat.pow_le_pow_left hs 2
  have : 2 * n + 11 ≤ 2 * (n + 10) := by omega
  calc 10 ^ 11 * (2 * n + 11) * _ ≤ 10 ^ 11 * (2 * (n + 10)) * (2000 * (n + 10)) ^ 2 := by
        gcongr
    _ ≤ _ := by ring_nf; nlinarith [Nat.zero_le n]

end NLogN

