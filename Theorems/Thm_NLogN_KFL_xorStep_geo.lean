set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD Butterfly AModel
theorem NLogN.KFL.xorStep_geo {Pp : ℕ} {I : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    {K ρ f : ℕ} (hρK : ρ < K) (hf : 1 ≤ f) (g : NLogN.KFL.Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) {Bb : ℕ} (hB2 : 2 ≤ Bb) (zV : NLogN.zsz (g.V : ℤ) ≤ Bb) (w : ℕ)
    (t : NLogN.IState NLogN.HS) (xs : List ℤ) (R : List NLogN.Item) (hlen : xs.length = g.V) (hbw : NLogN.Bnd w xs)
    (h0 : t.G 0 = NLogN.ints xs ++ R) :
    NLogN.IRuns I iprog (NLogN.KFL.xorStep (g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) g.Q (ρ + (f - 1) * K)
        (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)) t
      (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g (NLogN.KFL.XLc K ρ f) xs) ++ R))
      (NLogN.KFL.cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)
        w Bb) := by
  set j := ρ + (f - 1) * K
  set E := 2 ^ (f * K - j - 1)
  set D := 2 ^ j
  have hjK : j + 1 ≤ f * K := by
    have : (f - 1) * K + K = f * K := by
      have : f = (f - 1) + 1 := by omega
      conv_rhs => rw [this]
      ring
    omega
  have hQ : g.Q = 2 * D * E := by
    rw [hQe]; simp only [D, E]; rw [← pow_succ', ← pow_add]; congr 1; omega
  have hD : 0 < D := by positivity
  have hE : 0 < E := by positivity
  have hV : g.V = g.N0 * g.Q * g.N1 * E * 2 * (D * g.S1) := by
    simp only [NLogN.KFL.Geo.V, NLogN.KFL.Geo.S0]; rw [hQ]; ring
  have hV0 := hg.v
  have le : ∀ a : ℕ, a ∣ g.V → NLogN.zsz (a : ℤ) ≤ Bb := fun a hd =>
    le_trans (NLogN.KIL.zsz_nat_le (Nat.le_of_dvd (by omega) hd)) zV
  have H := NLogN.KFL.xorStep_runs (I := I) (iprog := iprog) (j := j) (Nat.mul_pos hg.n1 hE) hg.q hB2
    (le _ ⟨g.N0 * g.Q * 2 * (D * g.S1), by rw [hV]; ring⟩) (le _ ⟨g.S0 * g.N0, by simp only [NLogN.KFL.Geo.V]; ring⟩)
    (by have := le D ⟨g.N0 * g.Q * g.N1 * E * 2 * g.S1, by rw [hV]; ring⟩; simpa [D] using this)
    (g.N0 * g.Q * g.N1 * E) (D * g.S1) w (le _ ⟨2 * (D * g.S1), by rw [hV]; ring⟩)
    (le _ ⟨g.N0 * g.Q * g.N1 * E * 2, by rw [hV]; ring⟩) t xs R (by rw [hlen, hV]) hbw h0
  have e := NLogN.KFL.pull_bit g hg hQ hD hE (fun x => NLogN.KFL.gc 2 D x) (NLogN.KFL.xorA (g.N1 * E) g.Q j)
    (fun p => by simp [NLogN.KFL.xorA, NLogN.KFL.gc, D]) xs
  rw [e] at H
  exact H
end
