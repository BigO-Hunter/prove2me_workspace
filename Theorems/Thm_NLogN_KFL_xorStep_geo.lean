namespace NLogN.KFL

open AModel

theorem decomp (Q S n : ℕ) : n = n / (Q * S) * (Q * S) + gc Q S n * S + n % S := by
  unfold gc
  have h1 := Nat.div_add_mod n S
  have h2 := Nat.div_add_mod (n / S) Q
  rw [Nat.div_div_eq_div_mul] at h2
  rw [mul_comm Q S]
  nlinarith [h1, h2]

theorem sc_int (Q S v n : ℕ) : (NLogN.KFL.sc Q S v n : ℤ) = n + ((v : ℤ) - gc Q S n) * S := by
  have h := decomp Q S n
  unfold NLogN.KFL.sc
  have h' : (n : ℤ) = (n / (Q * S) * (Q * S) : ℕ) + (gc Q S n * S : ℕ) + (n % S : ℕ) := by
    exact_mod_cast h
  push_cast at h' ⊢
  linarith

theorem gc_lt {Q S : ℕ} (hQ : 0 < Q) (n : ℕ) : gc Q S n < Q := Nat.mod_lt _ hQ

theorem div_sc {Q S : ℕ} (hS : 0 < S) {v : ℕ} (hv : v < Q) (n : ℕ) :
    NLogN.KFL.sc Q S v n / (Q * S) = n / (Q * S) := by
  unfold NLogN.KFL.sc
  have hQS : 0 < Q * S := Nat.mul_pos (by omega) hS
  have hr : v * S + n % S < Q * S := by
    have := Nat.mod_lt n hS
    have : v * S + S ≤ Q * S := by nlinarith
    omega
  rw [add_assoc, Nat.add_comm, Nat.add_mul_div_right _ _ hQS, Nat.div_eq_of_lt hr, zero_add]

/-- A chunk at a higher stride `S' = Q S m` is unchanged. -/
theorem gc_sc_hi {Q S Q' S' m : ℕ} (hS : 0 < S) (hm : 0 < m) (hS' : S' = Q * S * m) {v : ℕ}
    (hv : v < Q) (n : ℕ) : gc Q' S' (NLogN.KFL.sc Q S v n) = gc Q' S' n := by
  unfold gc
  subst hS'
  rw [← Nat.div_div_eq_div_mul (NLogN.KFL.sc Q S v n), ← Nat.div_div_eq_div_mul n, div_sc hS hv]

theorem sc_lt {Q S m v n : ℕ} (hS : 0 < S) (hv : v < Q) (hn : n < Q * S * m) :
    NLogN.KFL.sc Q S v n < Q * S * m := by
  have hQS : 0 < Q * S := Nat.mul_pos (by omega) hS
  have h1 : n / (Q * S) < m := by
    rw [Nat.div_lt_iff_lt_mul hQS]; linarith
  have hr : v * S + n % S < Q * S := by
    have := Nat.mod_lt n hS
    have : v * S + S ≤ Q * S := by nlinarith
    omega
  unfold NLogN.KFL.sc
  have : n / (Q * S) * (Q * S) + (Q * S) ≤ Q * S * m := by nlinarith
  omega

@[simp] theorem length_rix {α : Type*} (V : ℕ) (φ : ℕ → ℕ) (d : α) (xs : List α) :
    (rix V φ d xs).length = V := by simp [rix]

theorem rix_congr {α : Type*} {V : ℕ} {φ φ' : ℕ → ℕ} (h : ∀ j < V, φ j = φ' j) (d : α)
    (xs : List α) : rix V φ d xs = rix V φ' d xs := by
  apply List.ext_getElem (by simp)
  intro j h1 h2
  simp only [length_rix] at h1
  simp [rix, h j h1]

namespace Geo

variable (g : Geo)

variable {g}

end Geo

theorem TV_trOf {g : Geo} (hg : g.Pos) (n : ℕ) : TV g.Q (trOf g n) :=
  ⟨gc_lt hg.q _, gc_lt hg.q _, gc_lt hg.q _⟩

section Phi

variable {g : Geo} (hg : g.Pos)
include hg

theorem gc1_sc2 (v n : ℕ) (hv : v < g.Q) : gc g.Q g.S1 (NLogN.KFL.sc g.Q g.S2 v n) = gc g.Q g.S1 n :=
  gc_sc_hi hg.s2 hg.n2 rfl hv n

theorem gc0_sc2 (v n : ℕ) (hv : v < g.Q) : gc g.Q g.S0 (NLogN.KFL.sc g.Q g.S2 v n) = gc g.Q g.S0 n :=
  gc_sc_hi hg.s2 (Nat.mul_pos hg.n2 (Nat.mul_pos hg.q hg.n1))
    (by simp only [Geo.S0, Geo.S1]; ring) hv n

theorem gc0_sc1 (v n : ℕ) (hv : v < g.Q) : gc g.Q g.S0 (NLogN.KFL.sc g.Q g.S1 v n) = gc g.Q g.S0 n :=
  gc_sc_hi hg.s1 hg.n1 rfl hv n

/-- Integer formula of `phi`. -/
theorem phi_int {F : Tr → Tr} (hF : ∀ c, TV g.Q c → TV g.Q (F c)) (n : ℕ) :
    (phi g F n : ℤ) = n + (((F (trOf g n)).1 : ℤ) - (trOf g n).1) * g.S0 +
      (((F (trOf g n)).2.1 : ℤ) - (trOf g n).2.1) * g.S1 +
      (((F (trOf g n)).2.2 : ℤ) - (trOf g n).2.2) * g.S2 := by
  obtain ⟨h0, h1, h2⟩ := hF _ (TV_trOf hg n)
  show ((NLogN.KFL.sc g.Q g.S0 (F (trOf g n)).1 (NLogN.KFL.sc g.Q g.S1 (F (trOf g n)).2.1
    (NLogN.KFL.sc g.Q g.S2 (F (trOf g n)).2.2 n)) : ℕ) : ℤ) = _
  generalize F (trOf g n) = c at h0 h1 h2 ⊢
  rw [sc_int, sc_int, sc_int, gc0_sc1 hg _ _ h1, gc0_sc2 hg _ _ h2, gc1_sc2 hg _ _ h2]
  simp only [trOf]; ring

end Phi

/-- The rotation pull of `rotF` on `[P, Q, S]` as an index map. -/
theorem pull_rotAddr (P Q S : ℕ) (hQ : 0 < Q) (hS : 0 < S) (as : ℕ → ℕ) (xs : List ℤ) :
    AModel.pull [P, Q, S] [P, Q, S] (KIL.rotAddr Q as) 0 xs =
      rix (P * Q * S) (fun j => NLogN.KFL.sc Q S ((gc Q S j + Q - as (j / (Q * S))) % Q) j) 0 xs := by
  apply List.ext_getElem (by simp [vol]; ring)
  intro j h1 h2
  simp only [length_pull, vol, List.prod_cons, List.prod_nil, mul_one] at h1
  rw [getElem_pull]
  simp only [rix, List.getElem_map, List.getElem_range]
  congr 1
  have hQS : 0 < Q * S := Nat.mul_pos hQ hS
  have hjp : j / (Q * S) < P := by
    rw [Nat.div_lt_iff_lt_mul hQS]; linarith
  simp only [decode, encode, KIL.rotAddr, vol, List.prod_cons, List.prod_nil, mul_one,
    List.getD_cons_zero, List.getD_cons_succ, List.headD_cons, List.tail_cons, Nat.div_one,
    List.getD_cons_zero]
  rw [Nat.mod_eq_of_lt hjp]
  unfold NLogN.KFL.sc gc
  have e1 : j % (Q * S) / S % Q = j / S % Q := by
    rw [mul_comm Q S, Nat.mod_mul_right_div_self, Nat.mod_mod]
  have e2 : j % (Q * S) % S = j % S := by
    rw [Nat.mod_mul_left_mod]
  rw [Nat.mod_eq_of_lt (Nat.mod_lt _ hS)] at *
  simp only [e1, e2, Nat.mod_mod]
  ring_nf

/-- Setting a sub-chunk: the `2`-field at stride `D S` inside the `Q`-chunk at stride `S`
(`Q = 2 D E`). -/
theorem gc_sub {Q S D E : ℕ} (hQ : Q = 2 * D * E) (hD : 0 < D) (hS : 0 < S) (hE : 0 < E) (j : ℕ) :
    gc 2 (D * S) j = gc 2 D (gc Q S j) := by
  unfold gc
  rw [mul_comm D S, ← Nat.div_div_eq_div_mul]
  rw [hQ, show 2 * D * E = D * (2 * E) by ring, Nat.mod_mul_right_div_self, Nat.mod_mul_right_mod]

theorem sc_sub {Q S D E : ℕ} (hQ : Q = 2 * D * E) (hD : 0 < D) (hS : 0 < S) (hE : 0 < E)
    {v : ℕ} (hv : v < 2) (j : ℕ) :
    NLogN.KFL.sc 2 (D * S) v j = NLogN.KFL.sc Q S (NLogN.KFL.sc 2 D v (gc Q S j)) j := by
  have h1 := sc_int 2 (D * S) v j
  have h2 := sc_int Q S (NLogN.KFL.sc 2 D v (gc Q S j)) j
  have h3 := sc_int 2 D v (gc Q S j)
  rw [gc_sub hQ hD hS hE] at h1
  have : (NLogN.KFL.sc 2 (D * S) v j : ℤ) = NLogN.KFL.sc Q S (NLogN.KFL.sc 2 D v (gc Q S j)) j := by
    rw [h1, h2, h3]; push_cast; ring
  exact_mod_cast this

theorem TV_flip1 {Q D E : ℕ} (hQ : Q = 2 * D * E) (hD : 0 < D) (hE : 0 < E) (b : ℕ → ℕ) (c : Tr)
    (h : TV Q c) : TV Q (flip1 D b c) := by
  refine ⟨h.1, ?_, h.2.2⟩
  have := sc_lt (Q := 2) (S := D) (m := E) (v := (gc 2 D c.2.1 + 2 - b c.1) % 2) hD
    (Nat.mod_lt _ (by norm_num)) (n := c.2.1)
    (by rw [← hQ]; exact h.2.1)
  simpa [flip1, ← hQ] using this

/-- **`rotF` on a bit field**: the view `[N0 Q N1 E, 2, D S1]` (bit `D` of slot 1) with the table
`as p = b (slot 0)` is the triple map `flip1`. -/
theorem pull_bit (g : Geo) (hg : g.Pos) {D E : ℕ} (hQ : g.Q = 2 * D * E) (hD : 0 < D) (hE : 0 < E)
    (b : ℕ → ℕ) (as : ℕ → ℕ) (has : ∀ p, as p = b (p / (g.N1 * E) % g.Q)) (xs : List ℤ) :
    AModel.pull [g.N0 * g.Q * g.N1 * E, 2, D * g.S1] [g.N0 * g.Q * g.N1 * E, 2, D * g.S1]
      (KIL.rotAddr 2 as) 0 xs = rixT g (flip1 D b) xs := by
  rw [pull_rotAddr _ _ _ (by norm_num) (Nat.mul_pos hD hg.s1)]
  have hV : g.N0 * g.Q * g.N1 * E * 2 * (D * g.S1) = g.V := by
    simp only [Geo.V, Geo.S0]; rw [hQ]; ring
  rw [hV]
  unfold rixT
  refine rix_congr (fun j hj => ?_) _ _
  have hT := TV_flip1 hQ hD hE b
  have hx : j / (2 * (D * g.S1)) / (g.N1 * E) % g.Q = gc g.Q g.S0 j := by
    unfold gc; rw [Nat.div_div_eq_div_mul]; congr 2; simp only [Geo.S0]; rw [hQ]; ring
  rw [has, hx, sc_sub hQ hD hg.s1 hE (Nat.mod_lt _ (by norm_num))]
  have e : ((NLogN.KFL.sc g.Q g.S1 (NLogN.KFL.sc 2 D ((gc 2 (D * g.S1) j + 2 - b (gc g.Q g.S0 j)) % 2)
      (gc g.Q g.S1 j)) j : ℕ) : ℤ) = phi g (flip1 D b) j := by
    rw [sc_int, phi_int hg hT]
    simp only [trOf, flip1, gc_sub hQ hD hg.s1 hE]; ring
  exact_mod_cast e

end NLogN.KFL

