theorem fok_xorGen (d Q j P : ℕ) : fok (xorGen d Q j P) = true := by
  simp [xorGen, xorBody, bE, uE, fok, touch, Ex.regs, NLogN.KFD.scr]; decide

theorem xorBody_fsp {d Q j : ℕ} (hd : 0 < d) (hQ : 0 < Q) {Bb : ℕ} (hB2 : 2 ≤ Bb)
    (zd : zsz (d : ℤ) ≤ Bb) (zQ : zsz (Q : ℤ) ≤ Bb) (zr : zsz ((2 : ℤ) ^ j) ≤ Bb)
    (s : IState HS) (G : Fin HS → List ℤ) (N : ℕ) (hN : 1 ≤ N) (zN : zsz (N : ℤ) ≤ Bb)
    {LP : List ℤ} (hGq : G NLogN.KFL.rP = (N : ℤ) :: LP) :
    FSp (xorBody d Q j) (encK s G)
      (encK s (Function.update (Function.update G 14 ((xorA d Q j (N - 1) : ℤ) :: G 14)) NLogN.KFL.rP
        (((N : ℤ) - 1) :: LP))) (20 * 10 ^ 7 * (Bb + 2) ^ 2) := by
  have hB1 : 1 ≤ Bb := by omega
  obtain ⟨ev, ok, bd⟩ := uE_spec d Q j (encK s G) N (top_encK hGq) (isInt_encK hGq) hN hd hQ hB1 zN
    zd zQ zr
  have z2 : zsz (2 : ℤ) ≤ Bb := zsz_nat_lt (a := 2) (by
    have : (2 : ℕ) ^ 2 ≤ 2 ^ Bb := Nat.pow_le_pow_right (by norm_num) hB2
    omega)
  have ev' : (bE d Q j).eval (encK s G) = (xorA d Q j (N - 1) : ℤ) := by
    simp only [bE, Ex.eval]; rw [ev]; simp [xorA]
  have S1 := Sp.pushQ s G (i := 14) (e := bE d Q j) (B := Bb) (by decide)
    (clean_all _ (by intro i hi; simp [bE, uE, Ex.regs] at hi; subst hi; decide))
    ⟨ok, trivial, by rw [ev]; positivity, by simp [Ex.eval]⟩
    ⟨bd, z2, by
      simp only [Ex.eval]; rw [ev]
      exact zsz_nat_lt (a := (N - 1) / d % Q / 2 ^ j % 2) (by
        have := Nat.mod_lt ((N - 1) / d % Q / 2 ^ j) (by norm_num : 0 < 2)
        have : (2 : ℕ) ^ 2 ≤ 2 ^ Bb := Nat.pow_le_pow_right (by norm_num) hB2
        push_cast; omega)⟩
  rw [ev'] at S1
  set G1 := Function.update G 14 ((xorA d Q j (N - 1) : ℤ) :: G 14)
  have g1P : G1 NLogN.KFL.rP = (N : ℤ) :: LP := by simp only [G1]; rw [upd_ne (by decide)]; exact hGq
  have S2 := Sp.asgQ s G1 (i := NLogN.KFL.rP) (e := .add (.reg NLogN.KFL.rP) (.lit (-1))) (B := Bb) (by decide) g1P zN
    (clean_all _ (by intro i hi; simp [Ex.regs] at hi; subst hi; decide))
    ⟨ok_reg g1P, trivial⟩
    ⟨bnd_reg g1P zN, by rw [Ex.Bnd, zsz_neg, zsz_one]; exact hB1, by
      simp only [Ex.eval]; rw [top_encK g1P]
      exact zsz_le_of_abs (by
        rw [abs_of_nonneg (by omega)]
        have := (zsz_le_iff (z := (N : ℤ)) (m := Bb)).1 zN
        simp only [Int.natAbs_natCast] at this
        have : (N : ℤ) < 2 ^ Bb := by exact_mod_cast this
        omega)⟩
  have ev2 : (Ex.add (.reg NLogN.KFL.rP) (.lit (-1)) : Ex HS).eval (encK s G1) = (N : ℤ) - 1 := by
    simp only [Ex.eval]; rw [top_encK g1P]; ring
  rw [ev2] at S2
  refine ((FSp.of_norep rfl S1).seq (FSp.of_norep rfl S2)).mono ?_
  simp only [bE, uE, Ex.size]
  generalize (Bb + 2) ^ 2 = X
  omega

theorem xorGen_fsp {d Q j : ℕ} (hd : 0 < d) (hQ : 0 < Q) {Bb : ℕ} (hB2 : 2 ≤ Bb)
    (zd : zsz (d : ℤ) ≤ Bb) (zQ : zsz (Q : ℤ) ≤ Bb) (zr : zsz ((2 : ℤ) ^ j) ≤ Bb)
    (P : ℕ) (zP : zsz (P : ℤ) ≤ Bb)
    (s : IState HS) (F : Fin HS → List ℤ) (hq : F NLogN.KFL.rq = []) :
    FSp (xorGen d Q j P) (encK s F)
      (encK s (Function.update F 14
        ((List.range P).map (fun p => (xorA d Q j p : ℤ)) ++ F 14)))
      (cXorGen P Bb) := by
  set as := xorA d Q j
  have nq : NLogN.KFL.rP ≠ rq := by decide
  have n14 : (14 : Fin HS) ≠ rq := by decide
  have n14P : (14 : Fin HS) ≠ rP := by decide
  have S0 := Sp.pushQ s F (i := NLogN.KFL.rP) (e := .lit (P : ℤ)) (B := Bb) (by decide) (clean_lit _) trivial zP
  simp only [Ex.eval] at S0
  set F0 := Function.update F NLogN.KFL.rP ((P : ℤ) :: F NLogN.KFL.rP)
  set Fk : ℕ → Fin HS → List ℤ := fun k =>
    Function.update (Function.update F0 14 (NLogN.KFL.tabL as P k ++ F 14)) NLogN.KFL.rP (((P - k : ℕ) : ℤ) :: F NLogN.KFL.rP)
  have H := FSp.repLit (C := NLogN.KFL.rq) (b := xorBody d Q j) (s := s)
    (F := Fk) (N := P) (c := 20 * 10 ^ 7 * (Bb + 2) ^ 2) (Bb := Bb) (by decide)
    (fun k => by simp only [Fk, F0]; rw [upd_ne nq.symm, upd_ne n14.symm, upd_ne nq.symm]; exact hq)
    (by simp +decide [xorBody, RS.writes]) zP
    (fun k hk => ?_)
  · have e0 : Fk 0 = F0 := by
      funext j
      simp only [Fk, F0, NLogN.KFL.tabL, List.range_zero, List.map_nil, List.nil_append, Nat.sub_zero]
      by_cases h : j = NLogN.KFL.rP
      · subst h; rw [Function.update_self, Function.update_self]
      rw [upd_ne h, upd_ne h]
      by_cases h' : j = 14
      · subst h'; rw [Function.update_self]
      rw [upd_ne h', upd_ne h]
    rw [e0] at H
    have fP : Fk P NLogN.KFL.rP = 0 :: F rP := by simp only [Fk]; rw [Function.update_self]; simp
    have S2 := Sp.pop s (Fk P) (B := Bb) (by decide) fP (by rw [zsz_zero]; omega)
    have T := (FSp.of_norep rfl S0).seq (H.seq (FSp.of_norep rfl S2))
    refine (T.congr ?_).mono ?_
    · congr 1
      funext j
      simp only [Fk, F0]
      by_cases h : j = NLogN.KFL.rP
      · subst h; rw [Function.update_self, upd_ne n14P.symm]
      rw [upd_ne h, upd_ne h]
      by_cases h' : j = 14
      · subst h'; rw [Function.update_self, Function.update_self, tabL_full]
      rw [upd_ne h', upd_ne h', upd_ne h]
    · simp only [cXorGen, Ex.size]
      have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
      omega
  · have hN : ((P : ℤ) - k) = ((P - k : ℕ) : ℤ) := by omega
    rw [hN]
    have T := xorBody_fsp hd hQ hB2 zd zQ zr s
      (Function.update (Fk k) NLogN.KFL.rq [((P - k : ℕ) : ℤ)])
      (P - k) (by omega) (le_trans (zsz_nat_le (Nat.sub_le _ _)) zP)
      (LP := F NLogN.KFL.rP) (by rw [upd_ne nq]; simp only [Fk]; rw [Function.update_self])
    refine T.congr ?_
    congr 1
    funext j
    simp only [Fk]
    by_cases hr : j = NLogN.KFL.rq
    · subst hr; simp +decide [Function.update_apply]
    by_cases h : j = NLogN.KFL.rP
    · subst h
      simp +decide only [Function.update_apply, if_true]
      congr 1; push_cast [Nat.cast_sub hk.le, Nat.cast_sub (Nat.succ_le_of_lt hk)]; ring
    by_cases h' : j = 14
    · subst h'
      simp +decide only [Function.update_apply, if_true, if_false]
      rw [tabL_succ as P k hk]
      simp only [as, List.cons_append]
    simp only [Function.update_apply, hr, h, h', if_false]

section
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem xorStep_runs {d Q j : ℕ} (hd : 0 < d) (hQ : 0 < Q) {Bb : ℕ} (hB2 : 2 ≤ Bb)
    (zd : zsz (d : ℤ) ≤ Bb) (zQ : zsz (Q : ℤ) ≤ Bb) (zr : zsz ((2 : ℤ) ^ j) ≤ Bb)
    (P B w : ℕ) (zP : zsz (P : ℤ) ≤ Bb) (zB : zsz (B : ℤ) ≤ Bb)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = P * 2 * B) (hbw : Bnd w xs)
    (h0 : t.G 0 = ints xs ++ R) :
    IRuns I iprog (xorStep d Q j P B) t
      (t.upd 0 (ints (AModel.pull [P, 2, B] [P, 2, B] (KIL.rotAddr 2 (xorA d Q j)) 0 xs) ++ R))
      (cXor P B w Bb) := by
  have z2 : zsz ((2 : ℕ) : ℤ) ≤ Bb := zsz_nat_lt (a := 2) (by
    have : (2 : ℕ) ^ 2 ≤ 2 ^ Bb := Nat.pow_le_pow_right (by norm_num) hB2
    omega)
  set as := xorA d Q j
  have has : ∀ p, as p ≤ 2 := fun p => by
    have := Nat.mod_lt (p / d % Q / 2 ^ j) (by norm_num : 0 < 2); simp only [as, xorA]; omega
  set ys := AModel.pull [P, 2, B] [P, 2, B] (KIL.rotAddr 2 as) 0 xs
  set ev := evalP t (rotL P 2 B)
  set u := pushSt t ev
  have hev : ev = [(1, (P : ℤ)), (2, ((2 : ℕ) : ℤ)), (4, (B : ℤ))] := by simp [ev, evalP, rotL, Ex.eval]
  have uG : ∀ r : Fin HS, u.G r = if r = 1 then .int (P : ℤ) :: t.G 1 else if r = 2 then
      .int ((2 : ℕ) : ℤ) :: t.G 2 else if r = 4 then .int (B : ℤ) :: t.G 4 else t.G r := by
    intro r
    simp only [u, hev, pushSt]
    by_cases h1 : r = 1
    · subst h1; simp +decide [IState.upd_G]
    by_cases h2 : r = 2
    · subst h2; simp +decide [IState.upd_G]
    by_cases h4 : r = 4
    · subst h4; simp +decide [IState.upd_G]
    simp [IState.upd_G, h1, h2, h4]
  have TG := xorGen_fsp hd hQ hB2 zd zQ zr P zP u (fun _ => []) rfl
  rw [encK_nil, ← encK_upd, encK_nil] at TG
  simp only [List.append_nil] at TG
  set tbl := (List.range P).map (fun p => (as p : ℤ))
  have T1 := TG.irun (I := I) (iprog := iprog) (fok_xorGen _ _ _ _)
  set t1 := u.upd 14 (ints tbl ++ u.G 14)
  have t1G : ∀ {r : Fin HS}, r ≠ 14 → t1.G r = u.G r := fun h => by
    simp only [t1, IState.upd_G]; simp [h]
  have u0 : u.G 0 = ints xs ++ R := by rw [uG]; simp +decide [h0]
  have u1 : u.G 1 = .int (P : ℤ) :: t.G 1 := by rw [uG]; simp +decide
  have u2 : u.G 2 = .int ((2 : ℕ) : ℤ) :: t.G 2 := by rw [uG]; simp +decide
  have u4 : u.G 4 = .int (B : ℤ) :: t.G 4 := by rw [uG]; simp +decide
  have RT := KFC.rotF_spec (I := I) (iprog := iprog) t1 xs as P 2 B w R (t.G 1) (t.G 2) (t.G 4)
    (u.G 14) has hlen hbw (by rw [t1G (by decide)]; exact u0) (by rw [t1G (by decide)]; exact u1)
    (by rw [t1G (by decide)]; exact u2) (by rw [t1G (by decide)]; exact u4)
    (by simp only [t1, IState.upd_G, Function.update_self]; rfl)
  have eout : (t1.upd 0 (ints ys ++ R)).upd 14 (u.G 14) = u.upd 0 (ints ys ++ R) := by
    refine IState.ext' (fun j => ?_) rfl rfl
    simp only [t1, IState.upd_G, Function.update_apply]
    split_ifs with h1 h2 <;> simp_all
  rw [eout] at RT
  have hl : PushOK t Bb (rotL P 2 B) := by
    apply pushOK_low
    · intro p hp; simp only [rotL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> (dsimp only; decide)
    · intro p hp; simp only [rotL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> exact goodE_lit ‹_›
  have hv : ∀ q ∈ rotL P 2 B, zsz (q.2.eval t) ≤ Bb := by
    intro q hq; simp only [rotL, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl <;> simpa [Ex.eval]
  have W := KFD.IRuns.withPushI (I := I) (iprog := iprog) (rotL P 2 B) _ t Bb hl hv
    (by simp +decide [rotL]) ys R _ (T1.seq RT)
  refine W.mono ?_
  have hpc : pushCost Bb (rotL P 2 B) = 6 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 := by
    rw [pushCost]; simp only [rotL, List.map_cons, List.map_nil, Ex.size]
    rw [List.sum_cons, List.sum_cons, List.sum_cons, List.sum_nil]; ring
  have hl3 : (rotL P 2 B).length = 3 := rfl
  rw [hpc, hl3]
  simp only [cXor]
  have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  generalize (Bb + 2) ^ 2 = X at *
  omega

end
end NLogN.KFL
