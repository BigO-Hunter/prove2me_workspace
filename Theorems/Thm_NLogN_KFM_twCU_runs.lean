variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem NLogN.KFM.twCU_runs (rn rk rj X : Fin NLogN.HS) (n k j : ℕ) (hk : 0 < k)
    (hn28 : rn ≠ 28) (hk28 : rk ≠ 28) (hk29 : rk ≠ 29) (hj28 : rj ≠ 28) (hj29 : rj ≠ 29)
    (hj53 : rj ≠ 53)
    (hX51 : X ≠ 51) (hX52 : X ≠ 52) (hX28 : X ≠ 28) (hX29 : X ≠ 29) (hX53 : X ≠ 53)
    (s : NLogN.IState NLogN.HS) (Ln Lk Lj : List NLogN.Item)
    (hn : s.G rn = .int (n : ℤ) :: Ln) (hkk : s.G rk = .int (k : ℤ) :: Lk)
    (hj : s.G rj = .int (j : ℤ) :: Lj) :
    NLogN.IRuns I iprog (NLogN.KFM.twCU rn rk rj X) s
      (s.upd X (.int (IntMul.HvdH.twiddle n k j).1 :: .int (IntMul.HvdH.twiddle n k j).2 :: s.G X))
      (NLogN.KFM.cTwU n k j) := by
  have d1 := NLogN.IRuns.dup (I := I) (iprog := iprog) (s := s) hn28 hn
  set u1 := s.upd 28 (.int (n : ℤ) :: s.G 28) with hu1
  have d2 := NLogN.IRuns.dup (I := I) (iprog := iprog) (s := u1) (i := rk) (j := 29) (a := (k : ℤ))
    (L := Lk) hk29 (by simp [hu1, NLogN.IState.upd_G, hk28, hkk])
  set u2 := u1.upd 29 (.int (k : ℤ) :: u1.G 29) with hu2
  have d3 := NLogN.IRuns.dup (I := I) (iprog := iprog) (s := u2) (i := rj) (j := 53) (a := (j : ℤ))
    (L := Lj) hj53 (by simp [hu2, hu1, NLogN.IState.upd_G, hj28, hj29, hj])
  set u3 := u2.upd 53 (.int (j : ℤ) :: u2.G 53) with hu3
  have g28 : u3.G 28 = .int (n : ℤ) :: s.G 28 := by simp +decide [hu3, hu2, hu1]
  have g29 : u3.G 29 = .int (k : ℤ) :: s.G 29 := by simp +decide [hu3, hu2, hu1]
  have g53 : u3.G 53 = .int (j : ℤ) :: s.G 53 := by simp +decide [hu3, hu2, hu1]
  obtain ⟨o4, r4⟩ := NLogN.twiddleP_spec n k j u3 (s.G 28) (s.G 29) (s.G 53) g28 g29 g53
  have c4 := NLogN.twiddleP_cost n k j u3 (s.G 28) (s.G 29) (s.G 53) g28 g29 g53
  have t4 := NLogN.RS.code_runs (I := I) (iprog := iprog) NLogN.twiddleP u3 o4
  rw [r4] at t4
  set u4 := (u3.upd 51 (.int (IntMul.HvdH.twiddle n k j).1 :: u3.G 51)).upd 52
    (.int (IntMul.HvdH.twiddle n k j).2 :: u3.G 52) with hu4
  have e5 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := u4) (i := 53) (a := (j : ℤ)) (L := s.G 53)
    (by simp +decide [hu4, g53])
  set u5 := u4.upd 53 (s.G 53) with hu5
  have e6 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := u5) (i := 29) (a := (k : ℤ)) (L := s.G 29)
    (by simp +decide [hu5, hu4, g29])
  set u6 := u5.upd 29 (s.G 29) with hu6
  have e7 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := u6) (i := 28) (a := (n : ℤ)) (L := s.G 28)
    (by simp +decide [hu6, hu5, hu4, g28])
  set u7 := u6.upd 28 (s.G 28) with hu7
  have m1 := NLogN.IRuns.mv (I := I) (iprog := iprog) (s := u7) (i := 52) (j := X)
    (a := (IntMul.HvdH.twiddle n k j).2) (L := u3.G 52) hX52.symm (by simp +decide [hu7, hu6, hu5, hu4])
  set u8 := (u7.upd 52 (u3.G 52)).upd X (.int (IntMul.HvdH.twiddle n k j).2 :: u7.G X) with hu8
  have m2 := NLogN.IRuns.mv (I := I) (iprog := iprog) (s := u8) (i := 51) (j := X)
    (a := (IntMul.HvdH.twiddle n k j).1) (L := u3.G 51) hX51.symm
    (by simp +decide [hu8, hu7, hu6, hu5, hu4, hX51.symm, hX52.symm])
  have hb := NLogN.KFM.zsz_of_near n (IntMul.HvdH.twiddle n k j) _ (NLogN.KFM.norm_exp_phase (2 * Real.pi * j / k) _
    (by push_cast; ring)) ((NLogN.KFM.vP_twiddle n k j hk).trans (pow_le_one₀ (by norm_num) (by norm_num)))
  refine (d1.seq (d2.seq (d3.seq (t4.seq (e5.seq (e6.seq (e7.seq (m1.seq m2)))))))).mono' ?_ ?_
  · simp only [hu8, hu7, hu6, hu5, hu4, hu3, hu2, hu1]
    clear d1 d2 d3 t4 e5 e6 e7 m1 m2
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have := NLogN.moveIntCost_le (NLogN.zsz (IntMul.HvdH.twiddle n k j).1)
    have := NLogN.moveIntCost_le (NLogN.zsz (IntMul.HvdH.twiddle n k j).2)
    obtain ⟨b1, b2⟩ := hb
    clear d1 d2 d3 t4 e5 e6 e7 m1 m2 r4 o4
    exact NLogN.KFM.twCU_cost n k j _ c4 (by omega) (by omega)
end
