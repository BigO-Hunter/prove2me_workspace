          (2 * NLogN.zsz (NLogN.sg (a.eval s) ((a.eval s).natAbs % 2 ^ m)) + 2) + (2 * NLogN.zsz ((2 : ℤ) ^ m) + 2)) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.IStmt.run, NLogN.IOp.run, s1]
      refine ⟨by ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), by omega⟩
    refine (ha.seq (hb.seq hr)).mono' (by simp [NLogN.Ex.eval, hm, NLogN.sg_tdiv]) ?_
    simp only [NLogN.Ex.cost, hm, NLogN.zsz_two_pow]
    have : NLogN.splitCost m ≤ NLogN.splitCost (m + 1) := by
      simp only [NLogN.splitCost, NLogN.moveCost, NLogN.takeCost]; omega
    have := NLogN.zsz_sg_mod_le (a.eval s) m
    omega
  | rem a r, s, hc, hok => by
    have hca : a.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    have hcb : r.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    obtain ⟨hoa, hor, m, hm⟩ := hok
    have ha := code_runs_aux a s hca hoa
    set s1 := s.upd 56 (.int (a.eval s) :: s.G 56)
    have hb := code_runs_aux r s1 hcb ((NLogN.Ex.ok_upd s 56 _ r hcb.not56).2 hor)
    rw [NLogN.Ex.eval_upd s 56 _ r hcb.not56, NLogN.Ex.cost_upd s 56 _ r hcb.not56, hm] at hb
    have hr : NLogN.IRuns I iprog (.seq (.op (.mv NLogN.zX.V NLogN.zX.A)) (.seq (.op (.split NLogN.zX.V NLogN.zX.A NLogN.zX.B))
        (.seq (.op (.drop NLogN.zX.V)) (.seq (.op (.mv NLogN.zX.B NLogN.zX.V)) (.op (.drop NLogN.zX.A))))))
        (s1.upd 56 (.int (2 ^ m) :: s1.G 56))
        (s.upd 56 (.int (NLogN.sg (a.eval s) ((a.eval s).natAbs % 2 ^ m)) :: s.G 56))
        (2 * NLogN.moveCost (NLogN.zsz ((2 : ℤ) ^ m)) + 19 + (NLogN.splitCost m + 17) +
          (2 * NLogN.zsz (NLogN.sg (a.eval s) ((a.eval s).natAbs / 2 ^ m)) + 2) +
          (2 * NLogN.moveCost (NLogN.zsz (NLogN.sg (a.eval s) ((a.eval s).natAbs % 2 ^ m))) + 19) +
          (2 * NLogN.zsz ((2 : ℤ) ^ m) + 2)) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.IStmt.run, NLogN.IOp.run, s1]
      refine ⟨by ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), by omega⟩
    refine (ha.seq (hb.seq hr)).mono' (by simp [NLogN.Ex.eval, hm, NLogN.sg_tmod]) ?_
    simp only [NLogN.Ex.cost, hm, NLogN.zsz_two_pow]
    have : NLogN.splitCost m ≤ NLogN.splitCost (m + 1) := by
      simp only [NLogN.splitCost, NLogN.moveCost, NLogN.takeCost]; omega
    have h1 := NLogN.zsz_sg_mod_le (a.eval s) m
    have h2 := NLogN.zsz_sg_div_le (a.eval s) m
    have : NLogN.moveCost (NLogN.zsz (NLogN.sg (a.eval s) ((a.eval s).natAbs % 2 ^ m))) ≤ NLogN.moveCost (NLogN.zsz (a.eval s)) := by
      simp only [NLogN.moveCost]; nlinarith
    omega
  | pow2 a, s, hc, hok => by
    have hca : a.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    obtain ⟨hoa, h0⟩ := hok
    have ha := code_runs_aux a s hca hoa
    obtain ⟨k, hk⟩ : ∃ k : ℕ, a.eval s = k := ⟨(a.eval s).toNat, by omega⟩
    rw [hk] at ha
    have hr := NLogN.pow2Code_runs (I := I) (iprog := iprog) NLogN.zX NLogN.zX_good
      (s.upd 56 (.int k :: s.G 56)) k (s.G 56) (by simp)
    refine (ha.seq hr).mono' (by simp [NLogN.Ex.eval, hk]) ?_
    simp only [NLogN.Ex.cost, hk, Int.toNat_natCast]
    omega
  | sel c x y, s, hc, hok => by
    have hcc : c.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    have hcx : x.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    have hcy : y.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    obtain ⟨hoc, hoxy⟩ := hok
    have h1 := code_runs_aux c s hcc hoc
    have h2 := NLogN.IRuns.mv (I := I) (iprog := iprog) (s := s.upd 56 (.int (c.eval s) :: s.G 56))
      (i := NLogN.zX.V) (j := NLogN.zX.A) (a := c.eval s) (L := s.G 56) (by decide) (by simp)
    set s2 := ((s.upd 56 (.int (c.eval s) :: s.G 56)).upd NLogN.zX.V (s.G 56)).upd NLogN.zX.A
      (.int (c.eval s) :: (s.upd 56 (.int (c.eval s) :: s.G 56)).G NLogN.zX.A)
    have hd := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := s2) (i := NLogN.zX.A) (a := c.eval s)
      (L := s.G 57) (by simp [s2])
    have e3 : s2.upd NLogN.zX.A (s.G 57) = s := by simp only [s2]; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
    rw [e3] at hd
    by_cases hneg : c.eval s < 0
    · have hx := code_runs_aux x s hcx (by simpa [hneg] using hoxy)
      have hi := NLogN.IRuns.iteT (I := I) (iprog := iprog) (i := NLogN.zX.A) (f := fun k => k == .neg)
        (q := .seq (.op (.drop NLogN.zX.A)) (y.code NLogN.zX))
        (by rw [NLogN.cl_int s2 NLogN.zX.A (c.eval s) (s.G 57) (by simp [s2])]; simp [hneg]; omega)
        (hd.seq hx)
      refine (h1.seq (h2.seq hi)).mono' (by simp [NLogN.Ex.eval, hneg]) ?_
      simp only [NLogN.Ex.cost, if_pos hneg]; omega
    · have hy := code_runs_aux y s hcy (by simpa [hneg] using hoxy)
      have hi := NLogN.IRuns.iteF (I := I) (iprog := iprog) (i := NLogN.zX.A) (f := fun k => k == .neg)
        (p := .seq (.op (.drop NLogN.zX.A)) (x.code NLogN.zX))
        (by rw [NLogN.cl_int s2 NLogN.zX.A (c.eval s) (s.G 57) (by simp [s2])]; simp [hneg]; split_ifs <;> simp)
        (hd.seq hy)
      refine (h1.seq (h2.seq hi)).mono' (by simp [NLogN.Ex.eval, hneg]) ?_
      simp only [NLogN.Ex.cost, if_neg hneg]; omega
  | ndiv a b, s, hc, hok => by
    have hca : a.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    have hcb : b.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    obtain ⟨hoa, hob, ha0, hb0⟩ := hok
    have ha := code_runs_aux a s hca hoa
    set s1 := s.upd 56 (.int (a.eval s) :: s.G 56)
    have hb := code_runs_aux b s1 hcb ((NLogN.Ex.ok_upd s 56 _ b hcb.not56).2 hob)
    rw [NLogN.Ex.eval_upd s 56 _ b hcb.not56, NLogN.Ex.cost_upd s 56 _ b hcb.not56] at hb
    obtain ⟨u, hu⟩ : ∃ u : ℕ, a.eval s = u := ⟨(a.eval s).toNat, by omega⟩
    obtain ⟨v, hv⟩ : ∃ v : ℕ, b.eval s = v := ⟨(b.eval s).toNat, by omega⟩
    have hv0 : 0 < v := by omega
    rw [hv] at hb
    have hd := NLogN.ldivCode_runs (I := I) (iprog := iprog) (s1.upd 56 (.int v :: s1.G 56)) u v hv0
      (s.G 56) (by simp [s1, hu])
    have ht : NLogN.IRuns I iprog (.op (.drop NLogN.zX.G))
        (((s1.upd 56 (.int v :: s1.G 56)).upd 56 (.int ((u / v : ℕ) : ℤ) :: s.G 56)).upd 63
          (.int ((u % v : ℕ) : ℤ) :: (s1.upd 56 (.int v :: s1.G 56)).G 63))
        (s.upd 56 (.int ((u / v : ℕ) : ℤ) :: s.G 56)) (2 * NLogN.zsz ((u % v : ℕ) : ℤ) + 2) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.IStmt.run, NLogN.IOp.run, s1]
      try refine ⟨?_, ?_⟩
      all_goals first | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)) | omega
    refine (ha.seq (hb.seq (hd.seq ht))).mono' (by simp [NLogN.Ex.eval, hu, hv]) ?_
    simp only [NLogN.Ex.cost, hu, hv]
    have : NLogN.zsz ((u % v : ℕ) : ℤ) ≤ NLogN.zsz (v : ℤ) :=
      NLogN.zsz_mono (by simp; exact (Nat.mod_lt _ hv0).le)
    have : 2 * NLogN.zsz (v : ℤ) + 2 ≤ NLogN.ldivCost (NLogN.zsz (u : ℤ) + NLogN.zsz (v : ℤ)) := by
      have := Nat.le_self_pow (n := 2) (by norm_num) (NLogN.zsz (u : ℤ) + NLogN.zsz (v : ℤ) + 2)
      simp only [NLogN.ldivCost]; omega
    omega
  | nmod a b, s, hc, hok => by
    have hca : a.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    have hcb : b.Clean := fun i hi => hc i (by simp [NLogN.Ex.regs, hi])
    obtain ⟨hoa, hob, ha0, hb0⟩ := hok
    have ha := code_runs_aux a s hca hoa
    set s1 := s.upd 56 (.int (a.eval s) :: s.G 56)
    have hb := code_runs_aux b s1 hcb ((NLogN.Ex.ok_upd s 56 _ b hcb.not56).2 hob)
    rw [NLogN.Ex.eval_upd s 56 _ b hcb.not56, NLogN.Ex.cost_upd s 56 _ b hcb.not56] at hb
    obtain ⟨u, hu⟩ : ∃ u : ℕ, a.eval s = u := ⟨(a.eval s).toNat, by omega⟩
    obtain ⟨v, hv⟩ : ∃ v : ℕ, b.eval s = v := ⟨(b.eval s).toNat, by omega⟩
    have hv0 : 0 < v := by omega
    rw [hv] at hb
    have hd := NLogN.ldivCode_runs (I := I) (iprog := iprog) (s1.upd 56 (.int v :: s1.G 56)) u v hv0
      (s.G 56) (by simp [s1, hu])
    have ht : NLogN.IRuns I iprog (.seq (.op (.drop NLogN.zX.V)) (.op (.mv NLogN.zX.G NLogN.zX.V)))
        (((s1.upd 56 (.int v :: s1.G 56)).upd 56 (.int ((u / v : ℕ) : ℤ) :: s.G 56)).upd 63
          (.int ((u % v : ℕ) : ℤ) :: (s1.upd 56 (.int v :: s1.G 56)).G 63))
        (s.upd 56 (.int ((u % v : ℕ) : ℤ) :: s.G 56))
        (2 * NLogN.zsz ((u / v : ℕ) : ℤ) + 2 + (2 * NLogN.moveCost (NLogN.zsz ((u % v : ℕ) : ℤ)) + 19)) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.IStmt.run, NLogN.IOp.run, s1]
      try refine ⟨?_, ?_⟩
      all_goals first | ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)) | omega
    refine (ha.seq (hb.seq (hd.seq ht))).mono' (by simp [NLogN.Ex.eval, hu, hv]) ?_
    simp only [NLogN.Ex.cost, hu, hv]
    have h1 : NLogN.zsz ((u % v : ℕ) : ℤ) ≤ NLogN.zsz (v : ℤ) :=
      NLogN.zsz_mono (by simp; exact (Nat.mod_lt _ hv0).le)
    have h2 : NLogN.zsz ((u / v : ℕ) : ℤ) ≤ NLogN.zsz (u : ℤ) :=
      NLogN.zsz_mono (by simp; exact Nat.div_le_self _ _)
    have : 2 * NLogN.zsz (u : ℤ) + 2 + (2 * NLogN.moveCost (NLogN.zsz (v : ℤ)) + 19) ≤
        NLogN.ldivCost (NLogN.zsz (u : ℤ) + NLogN.zsz (v : ℤ)) := by
      have := Nat.le_self_pow (n := 2) (by norm_num) (NLogN.zsz (u : ℤ) + NLogN.zsz (v : ℤ) + 2)
      simp only [NLogN.ldivCost, NLogN.moveCost]; omega
    have : NLogN.moveCost (NLogN.zsz ((u % v : ℕ) : ℤ)) ≤ NLogN.moveCost (NLogN.zsz (v : ℤ)) := by
      simp only [NLogN.moveCost]; omega
    omega

theorem NLogN.Ex.code_runs : ∀ (e : Ex HS) (s : IState HS), e.Clean → e.ok s →
    IRuns I iprog (e.code zX) s (s.upd 56 (.int (e.eval s) :: s.G 56)) (e.cost s) :=
  code_runs_aux
end
