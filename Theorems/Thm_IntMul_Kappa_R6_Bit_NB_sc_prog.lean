-- Source module: Solutions.R6BitNBStW
/-!
# Round six, bit network: the generated chunks of the two stage words

For the stage words `W1F`, `W2F`:
* their gates are the lists `G1`, `G2` of `R6BitNBScalB`;
* every instruction has a valid code, touches local wires (`< NL`) and its gates join distinct
  touched wires;
* the generator, started at the packed states `SG1_0`, `SG2_0`, ends at `SG1_11`, `SG2_10`; all
  its moves are nested (`nestOK`) between valid codes, and the move ranks are counted by the sums
  of the segment counts.

The segments are the kernel checks `seg1_j`, `seg2_j`; the static ops are handled by
`genF_static` with the code facts `sgk*` of the packed states.
-/

set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

theorem segW1_0 : segW1 0 = copyo (fun t => cND (t + 1)) ++ mixFB 0 12 cND := rfl
theorem segW1_1 : segW1 1 = mixFB 12 24 cND := rfl
theorem segW1_2 : segW1 2 = mixFB 24 48 cND := rfl
theorem segW1_3 : segW1 3 = mixFB 48 72 cND := rfl
theorem segW1_4 : segW1 4 = mixFB 72 96 cND := rfl
theorem segW1_5 : segW1 5 = mixFB 96 120 cND := rfl
theorem segW1_6 : segW1 6 = mixFB 120 143 cND := rfl
theorem segW1_7 : segW1 7 = scatT ++ injo cPT := rfl
theorem segW1_8 : segW1 8 = sweepR 0 20000 cHIGH := rfl
theorem segW1_9 : segW1 9 = sweepR 20000 NR cHIGH := rfl
theorem segW1_10 : segW1 10 = copyo fun _ => cHIGH := rfl

theorem gates_W1F : gatesW W1F = G1 := by
  have hs : gatesW (segW1 0 ++ segW1 1 ++ segW1 2 ++ segW1 3 ++ segW1 4 ++ segW1 5 ++ segW1 6 ++
      segW1 7 ++ segW1 8 ++ segW1 9) = Cg ++ (Ag ++ (Tg ++ STg ++ Ig)) := by
    simp only [segW1_0, segW1_1, segW1_2, segW1_3, segW1_4, segW1_5, segW1_6, segW1_7, segW1_8, segW1_9,
      gatesW_append, gates_copyo, gates_mixFB, scatT, gates_tcopy, gates_scat,
      gates_injo, gates_sweepR, List.append_nil]
    rw [← Ag_blocks]
    simp only [List.flatMap_append, STg, List.append_assoc]
  rw [W1F]
  simp only [gatesW_append] at hs ⊢
  rw [hs]
  simp only [ gates_mixF, gates_mixI, gates_scat, gates_injo, gates_copyo,
    segW1_10, G1, Sg, List.append_assoc]

theorem WF_segW1 : ∀ j, j ≤ 10 → WFw (segW1 j) := by
  intro j hj
  interval_cases j
  · exact WFw_append (ok_copyo _ (fun t ht => cND_lt (by simp only [NV] at ht; omega)) (fun _ => True)
      (fun _ _ => trivial)).1 (ok_mixFB _ _ _ ndc)
  all_goals first
    | exact ok_mixFB _ _ _ ndc
    | exact WFw_append (WFw_append ok_tcopy (ok_scatT _ (fun _ _ => by decide)))
        (ok_injo _ (fun T hT => cPT_lt hT) (fun _ => True) (fun _ _ => trivial)).1
    | exact ok_sweepR _ _ _ (by simp [NR]) (by decide)
    | exact (ok_copyo _ (fun _ _ => by decide) (fun _ => True) (fun _ _ => trivial)).1

theorem static_S {S c : ℕ} {W : List LInstr} (hW : WFw W) (hT : TouchC IsS (· = c) W)
    (hS : ∀ q < NR, codeOf S (wS q) = c) : Seg S S 0 W :=
  seg_static hW fun f hf i hi w hw => by
    obtain ⟨hc, hP⟩ := hT i hi
    rw [hc]
    obtain ⟨q, hq, e⟩ := hP w hw
    rw [e, hf _ (lt65536 (wS_lt hq)), hS q hq]

/-! ## The stages -/

theorem stage1_seg : Seg SG1_0 SG1_11 CNs1 W1F := by
  obtain ⟨fx, fy, fs⟩ := sgFacts_spec sgk1
  have k2 : ∀ q < NR, codeOf SG1_10 (wS q) = cHIGH := by
    intro q hq
    have := List.all_eq_true.1 sgk2 q (List.mem_range.2 hq)
    rw [codeOf_pget _ (lt65536 (wS_lt hq))]
    simpa using this
  have lowS : Seg SG1_0 SG1_0 0 ((mixF fun _ => cLOW) ++ (scat rdS fun _ => cLOW) ++
      (injo fun _ => cLOW) ++ (mixI fun _ => cLOW)) := by
    have a := ok_mixF (fun _ => cLOW) (fun _ _ => by decide) (· = cLOW) (fun _ _ => rfl)
    have b := ok_scatS (fun _ => cLOW) (fun _ _ => by decide) (· = cLOW) (fun _ _ => rfl)
    have c := ok_injo (fun _ => cLOW) (fun _ _ => by decide) (· = cLOW) (fun _ _ => rfl)
    have d := ok_mixI (fun _ => cLOW) (fun _ _ => by decide) (· = cLOW) (fun _ _ => rfl)
    exact static_SY (WFw_append (WFw_append (WFw_append a.1 b.1) c.1) d.1)
      (TouchC_append (TouchC_append (TouchC_append (TouchC_mono a.2 fun w h => Or.inl h) b.2) c.2)
        (TouchC_mono d.2 fun w h => Or.inl h)) fs fy
  have high : Seg SG1_10 SG1_10 0 (mixI fun _ => cHIGH) := by
    have d := ok_mixI (fun _ => cHIGH) (fun _ _ => by decide) (· = cHIGH) (fun _ _ => rfl)
    exact static_S d.1 d.2 k2
  have s0 := seg_of_chk (WF_segW1 0 (by norm_num)) seg1_0
  have s1 := seg_of_chk (WF_segW1 1 (by norm_num)) seg1_1
  have s2 := seg_of_chk (WF_segW1 2 (by norm_num)) seg1_2
  have s3 := seg_of_chk (WF_segW1 3 (by norm_num)) seg1_3
  have s4 := seg_of_chk (WF_segW1 4 (by norm_num)) seg1_4
  have s5 := seg_of_chk (WF_segW1 5 (by norm_num)) seg1_5
  have s6 := seg_of_chk (WF_segW1 6 (by norm_num)) seg1_6
  have s7 := seg_of_chk (WF_segW1 7 (by norm_num)) seg1_7
  have s8 := seg_of_chk (WF_segW1 8 (by norm_num)) seg1_8
  have s9 := seg_of_chk (WF_segW1 9 (by norm_num)) seg1_9
  have s10 := seg_of_chk (WF_segW1 10 (by norm_num)) seg1_10
  have := seg_append (seg_append (seg_append lowS (seg_append (seg_append (seg_append (seg_append
    (seg_append (seg_append (seg_append (seg_append (seg_append s0 s1) s2) s3) s4) s5) s6) s7) s8) s9))
    high) s10
  rw [W1F]
  convert this using 1
  simp only [CNs1]
  ring

end IntMul.Kappa.R6.Bit

