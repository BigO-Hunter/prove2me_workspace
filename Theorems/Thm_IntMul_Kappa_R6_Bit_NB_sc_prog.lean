    (fun p hp => ⟨Or.inr (mem_Cg hp).1, Or.inl (mem_Cg hp).2⟩) z z' h

theorem SgIg_tmp (z : ℕ → M) (w : ℕ) (hw : 43619 ≤ w) :
    xrL (Ag ++ (Sg ++ Ig) ++ Ag.reverse) z w = z w := by
  rw [xrL_append, xrL_append, Agr_notslot _ _ (by simp only [IsSlot]; omega),
    reads_of_sep _ SgIg_tgt _ w (Or.inr (Or.inr hw)), Ag_notslot _ _ (by simp only [IsSlot]; omega)]

include h2 in
/-- Stage one on any start with zero temporaries. -/
theorem stage1_key (z : ℕ → M) (hz : TmpZ z) :
    (∀ w, w < 1771 ∨ IsSlot w → xrL G1 z w = xrL Cg (xrL Cg z) w) ∧
      ∀ T < NV, xrL G1 z (wY T) =
        z (wY T) + readSum (xrL Ag z) T + readSum (xrL Ag (xrL Cg z)) T := by
  obtain ⟨a1, a2⟩ := sandwich h2 (Sg ++ Ig) z (readsP_SgIg _)
  obtain ⟨z1, hz1⟩ : ∃ z1, z1 = xrL (Ag ++ (Sg ++ Ig) ++ Ag.reverse) z := ⟨_, rfl⟩
  rw [← hz1] at a1 a2
  have hz1T : TmpZ z1 := TmpZ_of z hz z1 fun w hw => by rw [hz1]; exact SgIg_tmp z w hw
  obtain ⟨z2, hz2⟩ : ∃ z2, z2 = xrL Cg z1 := ⟨_, rfl⟩
  have hz2T : TmpZ z2 := TmpZ_of z1 hz1T z2 fun w hw => by
    rw [hz2]; exact Cg_x z1 w (by simp only [IsSlot]; omega)
  obtain ⟨b1, b2⟩ := sandwich h2 (Tg ++ STg ++ Ig) z2 (readsP_T1 _ (TmpZ_of z2 hz2T _
    fun w hw => Ag_notslot z2 w (by simp only [IsSlot]; omega)))
  have hG : xrL G1 z = xrL Cg (xrL (Ag ++ (Tg ++ STg ++ Ig) ++ Ag.reverse) z2) := by
    rw [hz2, hz1, G1, xrL_append (Ag ++ (Sg ++ Ig) ++ Ag.reverse ++ Cg ++
      (Ag ++ (Tg ++ STg ++ Ig) ++ Ag.reverse)), xrL_append (Ag ++ (Sg ++ Ig) ++ Ag.reverse ++ Cg),
      xrL_append (Ag ++ (Sg ++ Ig) ++ Ag.reverse)]
  have hz2' : ∀ w, w < 1771 ∨ IsSlot w → z2 w = xrL Cg z w := by
    intro w hw; rw [hz2]; exact Cg_congr z1 z a1 w hw
  refine ⟨fun w hw => ?_, fun T hT => ?_⟩
  · rw [hG]
    exact Cg_congr _ _ (fun w' hw' => by rw [b1 w' hw', hz2' w' hw']) w hw
  · have hns : ¬ IsSlot (wY T) := by simp only [IsSlot, wY, Nat.add_eq, NV] at *; omega
    rw [hG, Cg_x _ _ hns, b2 T hT, show z2 (wY T) = z1 (wY T) by rw [hz2]; exact Cg_x z1 _ hns, a2 T hT]
    rw [readSum_congr (xrL Ag z2) (xrL Ag (xrL Cg z)) hT (fun w hw =>
      xrL_congr IsSlot Ag Ag_inSlot z2 (xrL Cg z) (fun w' hw' => hz2' w' (Or.inr hw')) w hw)]

include h2 in
/-- Stage two on any start with zero temporaries. -/
theorem stage2_key (z : ℕ → M) (hz : TmpZ z) :
    (∀ w, w < 1771 ∨ IsSlot w → xrL G2 z w = xrL Cg (xrL Cg z) w) ∧
      ∀ T < NV, xrL G2 z (wY T) =
        z (wY T) + readSum (xrL Ag (xrL Cg z)) T + readSum (xrL Ag z) T := by
  obtain ⟨z0, hz0⟩ : ∃ z0, z0 = xrL Cg z := ⟨_, rfl⟩
  have hz0T : TmpZ z0 := TmpZ_of z hz z0 fun w hw => by
    rw [hz0]; exact Cg_x z w (by simp only [IsSlot]; omega)
  obtain ⟨a1, a2⟩ := sandwich h2 (Ig.reverse ++ (Tg ++ STg.reverse)) z0 (readsP_T2 _ (TmpZ_of z0 hz0T _
    fun w hw => Ag_notslot z0 w (by simp only [IsSlot]; omega)))
  obtain ⟨z1, hz1⟩ : ∃ z1, z1 = xrL (Ag ++ (Ig.reverse ++ (Tg ++ STg.reverse)) ++ Ag.reverse) z0 :=
    ⟨_, rfl⟩
  rw [← hz1] at a1 a2
  obtain ⟨z2, hz2⟩ : ∃ z2, z2 = xrL Cg z1 := ⟨_, rfl⟩
  obtain ⟨b1, b2⟩ := sandwich h2 (Ig.reverse ++ Sg.reverse) z2 (readsP_IgSg _)
  have hCr : ∀ z : ℕ → M, xrL Cg.reverse z = xrL Cg z := xrL_rev_sep Cg Cg_sep
  have hG : xrL G2 z = xrL (Ag ++ (Ig.reverse ++ Sg.reverse) ++ Ag.reverse) z2 := by
    rw [hz2, hz1, hz0, G2, xrL_append (Cg.reverse ++ (Ag ++ (Ig.reverse ++ (Tg ++ STg.reverse)) ++
      Ag.reverse) ++ Cg.reverse), xrL_append (Cg.reverse ++ (Ag ++ (Ig.reverse ++ (Tg ++ STg.reverse)) ++
      Ag.reverse)), xrL_append Cg.reverse, hCr, hCr]
  have hz2' : ∀ w, w < 1771 ∨ IsSlot w → z2 w = xrL Cg (xrL Cg z) w := by
    intro w hw; rw [hz2, ← hz0]; exact Cg_congr z1 z0 a1 w hw
  refine ⟨fun w hw => ?_, fun T hT => ?_⟩
  · rw [hG, b1 w hw, hz2' w hw]
  · have hns : ¬ IsSlot (wY T) := by simp only [IsSlot, wY, Nat.add_eq, NV] at *; omega
    rw [hG, b2 T hT, show z2 (wY T) = z1 (wY T) by rw [hz2]; exact Cg_x z1 _ hns, a2 T hT,
      show z0 (wY T) = z (wY T) by rw [hz0]; exact Cg_x z _ hns, ← hz0]
    rw [readSum_congr (xrL Ag z2) (xrL Ag z) hT (fun w hw =>
      xrL_congr IsSlot Ag Ag_inSlot z2 z (fun w' hw' => by
        rw [hz2' w' (Or.inr hw'), xrL_sep_twice h2 Cg Cg_sep]) w hw)]

include h2 in
theorem stage_of_key (G : List (ℕ × ℕ)) (u : ℕ → M) (hu : TmpZ u)
    (key : ∀ z : ℕ → M, TmpZ z →
      (∀ w, w < 1771 ∨ IsSlot w → xrL G z w = xrL Cg (xrL Cg z) w) ∧
        ∀ T < NV, xrL G z (wY T) =
          z (wY T) + readSum (xrL Ag z) T + readSum (xrL Ag (xrL Cg z)) T) :
    (∀ t < NV, xrL G u (wX t) = u (wX t)) ∧ (∀ q < NR, xrL G u (wS q) = u (wS q)) ∧
      ∀ T < NV, xrL G u (wY T) = u (wY T) + u (wX T) := by
  obtain ⟨ur, hur⟩ : ∃ ur, ur = u - xPart u := ⟨_, rfl⟩
  have hur0 : ∀ w, w < 1771 → ur w = 0 := fun w hw => by simp [hur, xPart, hw]
  have hurS : ∀ w, ¬ w < 1771 → ur w = u w := fun w hw => by simp [hur, xPart, hw]
  have hurT : TmpZ ur := fun c hc => by rw [hurS _ (by simp only [wT, Nat.add_eq]; omega), hu c hc]
  have hsplit : u = ur + xPart u := by simp [hur]
  have hu_eq : ∀ w, u w = ur w + xPart u w := fun w => by simp [hur]
  have hlin : xrL G u = xrL G ur + xrL G (xPart u) := by
    conv_lhs => rw [hsplit]
    exact xrL_add G ur (xPart u)
  obtain ⟨r1, r2⟩ := key ur hurT
  obtain ⟨x1, x2⟩ := key (xPart u) (xPart_tmp u)
  have hc : xrL Cg ur = ur := Cg_zero ur hur0
  rw [hc, hc] at r1
  rw [hc] at r2
  have hxx : ∀ w, xrL Cg (xrL Cg (xPart u)) w = xPart u w := by
    intro w; rw [xrL_sep_twice h2 Cg Cg_sep]
  refine ⟨fun t ht => ?_, fun q hq => ?_, fun T hT => ?_⟩
  · have hw : wX t < 1771 ∨ IsSlot (wX t) := Or.inl (by simp only [wX, NV] at *; omega)
    rw [hlin, Pi.add_apply, r1 _ hw, x1 _ hw, hxx, hu_eq (wX t)]
  · have hw : wS q < 1771 ∨ IsSlot (wS q) := Or.inr (isSlot_wS hq)
    rw [hlin, Pi.add_apply, r1 _ hw, x1 _ hw, hxx, hu_eq (wS q)]
  · rw [hlin, Pi.add_apply, r2 T hT, x2 T hT, prod_reads h2 u hT,
      readSum_zero (xPart u) hT (fun w hw => xPart_slot u w hw), add_zero, add_assoc (ur (wY T)), h2,
      add_zero]
    have hy : ¬ wY T < 1771 := by simp only [wY, Nat.add_eq]; omega
    rw [show xPart u (wY T) = 0 by simp [xPart, hy], hurS _ hy, zero_add]

include h2 in
/-- **Stage one.** -/
theorem stage1_scalar (u : ℕ → M) (hu : TmpZ u) :
    (∀ t < NV, xrL G1 u (wX t) = u (wX t)) ∧ (∀ q < NR, xrL G1 u (wS q) = u (wS q)) ∧
      ∀ T < NV, xrL G1 u (wY T) = u (wY T) + u (wX T) :=
  stage_of_key h2 G1 u hu (stage1_key h2)

include h2 in
/-- **Stage two.** -/
theorem stage2_scalar (u : ℕ → M) (hu : TmpZ u) :
    (∀ t < NV, xrL G2 u (wX t) = u (wX t)) ∧ (∀ q < NR, xrL G2 u (wS q) = u (wS q)) ∧
      ∀ T < NV, xrL G2 u (wY T) = u (wY T) + u (wX T) :=
  stage_of_key h2 G2 u hu fun z hz => by
    obtain ⟨k1, k2⟩ := stage2_key h2 z hz
    exact ⟨k1, fun T hT => by rw [k2 T hT, add_assoc, add_assoc, add_comm (readSum (xrL Ag (xrL Cg z)) T)]⟩

end Stages

end IntMul.Kappa.R6.Bit

