-- Source module: Solutions.R6BitNBNetA
/-!
# Round six, bit network: the network (definitions, wires, generic fold lemmas)

Global roles (`v = 1771`, `N = v² = 3136441`, `R = 40077`): `X(a₁, a₂) = a₁ v + a₂`,
`Y(a₁, a₂) = N + a₁ v + a₂`, `A₁(b, q) = 2N + b R + q`, `A₂(a, q) = 2N + v R + a R + q`
(`W = 2N + 2vR = 148225616`). Temporaries: `tmp₁(b, c) = 23 b + c`, `tmp₂(a, c) = 23 v + 23 a + c`,
`τ(a₁, a₂) = 46 v + a₁ v + a₂` (`T = 46 v + N = 3217907`).

Stage-one invocation `b` maps the local wires `x_t ↦ X(t, b)`, `y_T ↦ Y(T, b)`, `s_q ↦ A₁(b, q)`,
`tmp_c ↦ tmp₁(b, c)`; stage-two invocation `a` maps `x_t ↦ Y(a, t)`, `y_S ↦ X(a, S)`,
`s_q ↦ A₂(a, q)`, `tmp_c ↦ tmp₂(a, c)`, `u_S ↦ τ(a, S)` (local `u_S = 43642 + S`).

Program: for each `b`, the stage-one chunks then the aux exits on its slots; then for each `a`, the
entrance edges on its `x`, `y` and slot wires, the stage-two chunks and the copy corrections.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

/-! ## Generic fold lemmas -/

section Fold

variable {Wr I α : Type*}

end Fold

section Edges

variable {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {R : Type*} [CommRing R] {m N : ℕ}

end Edges

theorem g1_lt {b w : ℕ} (hb : b < 1771) (hw : w < 43642) : g1 b w < 148225616 + 3217907 := by
  unfold g1; split_ifs <;> omega

theorem g1_inj {b b' w w' : ℕ} (hb : b < 1771) (hb' : b' < 1771) (hw : w < 43642) (hw' : w' < 43642)
    (h : g1 b w = g1 b' w') : b = b' ∧ w = w' := by
  unfold g1 at h; split_ifs at h <;> omega

/-- Stage-two wires of stage-one images. -/
theorem g2_x {a t : ℕ} (ht : t < 1771) (ha : a < 1771) : g2 a t = g1 t (wY a) := by
  rw [show wY a = 1771 + a from rfl]; unfold g1 g2
  rw [if_pos ht, if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel_left]

theorem g2_y {a s : ℕ} (hs : s < 1771) (ha : a < 1771) : g2 a (wY s) = g1 s (wX a) := by
  rw [show wY s = 1771 + s from rfl, show wX a = a from rfl]; unfold g1 g2
  rw [if_neg (by omega), if_pos (by omega), if_pos ha, Nat.add_sub_cancel_left]

/-- Stage-two wires beyond the `x, y` banks are not stage-one wires. -/
theorem g2_ne_g1 {a w b w' : ℕ} (ha : a < 1771) (hw : 3542 ≤ w) (hw2 : w < 45413) (hb : b < 1771)
    (hw' : w' < 43642) : g2 a w ≠ g1 b w' := by
  unfold g1 g2; split_ifs <;> omega

theorem ι1_inj {b b' w w' : ℕ} (hb : b < 1771) (hb' : b' < 1771) (hw : w < 43642) (hw' : w' < 43642)
    (h : ι1 b w = ι1 b' w') : b = b' ∧ w = w' :=
  g1_inj hb hb' hw hw' (gw_inj (g1_lt hb hw) (g1_lt hb' hw') h)

