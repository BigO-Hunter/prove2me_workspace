theorem TmpZ_of (z : ℕ → M) (hz : TmpZ z) (z' : ℕ → M) (h : ∀ w, 43619 ≤ w → z' w = z w) : TmpZ z' :=
  fun c hc => by rw [h _ (by simp only [wT, Nat.add_eq]; omega), hz c hc]

include h2 in
/-- Values of the producer from the input part (`x` on the inputs, slots `0`). -/
theorem prod_reads (u : ℕ → M) {T : ℕ} (hT : T < NV) :
