  rw [readSum_congr (xrL Ag z) (0 : ℕ → M) hT (fun w hw => by
    rw [xrL_congr IsSlot Ag Ag_inSlot z 0 (fun w' hw' => h w' hw') w hw, xrL_zero])]
  simp [readSum]

theorem xPart_slot (u : ℕ → M) (w : ℕ) (hw : IsSlot w) : xPart u w = 0 := by
  simp only [xPart, IsSlot] at *; rw [if_neg (by omega)]

theorem Cg_x (z : ℕ → M) (w : ℕ) (hw : ¬ IsSlot w) : xrL Cg z w = z w :=
