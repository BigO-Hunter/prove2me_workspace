theorem coreQH_sol_aux (c : Cfg) (hc : CfgOK c) (cW : ℕ) (hWc : c.W ≤ 2 ^ cW) {body : IStmt HS Pp}
    {σ : Fin HS → Option ℤ} {P K D S ρ r w G Z Mb Bz : ℕ}
    (hd : DescR σ P K D S ρ r w) (hG : σ vG = some (G : ℤ))
    (h12 : σ 12 = some (dep c.m D : ℤ)) (h13 : σ 13 = some ((c.W ^ dep c.m D : ℕ) : ℤ))
    (hD : 1 ≤ D) (hK : 1 ≤ K) (hS : 1 ≤ S) (hP : 1 ≤ P) (hr : 1 ≤ r)
    (hKW : cW * dep c.m D + 2 * (D / c.m * G) ≤ K * D)
    (hGm : G + c.m ≤ P * 2 ^ (K * D) * S * r)
    (hZ32 : zsz ((32 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z)
    (hMb : zsz (Mb : ℤ) ≤ Bz)
    (hM : w + EwH c D + c.Aw * (D + 1) ^ c.p + (D + 1) ^ c.p + 2 * c.m +
      (cW + 4) * (K * D + K) + G + 100 ≤ Mb)
    {f g : Fin HS → List ℤ} (hf : Clean0 f) (hg : Clean0 g) {cc : ℕ}
    (Cont : ∀ σ', CoreR σ' K S r (w + EwH c D) P D ρ 0 (q0v c.m cW K D (dep c.m D) G)
        (BpV c.W c.m K P D (dep c.m D) G (q0v c.m cW K D (dep c.m D) G)) →
      σ' vG = some (G : ℤ) → RunQ Isym tbl σ' body f g cc) :
    RunQ Isym tbl σ (coreCH c cW body) f g (cCoreH cc Z Bz (szC c)) := by
  have hfx : ∀ x : Fin HS, x ≠ 0 → f x = [] ∧ g x = [] := fun x hx => ⟨hf x hx, hg x hx⟩
  have hfσ : ∀ σ : Fin HS → Option ℤ, σ 0 = none → ∀ j, (σ j).isSome → f j = [] := by
    intro σ h0 j hj
    have : j ≠ 0 := by rintro rfl; simp [h0] at hj
    exact hf j this
  have hm := hc.m1
  set d := dep c.m D with hdd
  set q0 := q0v c.m cW K D d G with hq0
  set H := w + EwH c D with hH
  set Wk := WkV c.W c.m D d G with hWk
  set Bp := BpV c.W c.m K P D d G q0 with hBp
  have hq0D : q0 ≤ D := q0v_le _ _ _ _ _ _
  have hσ0 : σ 0 = none := hd.base.off 0 (by decide)
  set N := P * 2 ^ (K * D) * S * r with hN
  obtain ⟨b1, b2, b3, b4, b5⟩ := layer_bounds (K := K) (D := D) hS hP hr
  have zb : ∀ x : ℕ, x ≤ 32 * N → zsz (x : ℤ) ≤ Z := fun x hx => le_trans (zsz_natCast_le hx) hZ32
  have hKD : K ≤ K * D := Nat.le_mul_of_pos_right _ hD
  have hDK : D ≤ K * D := Nat.le_mul_of_pos_left _ (by omega)
  have hFD : D / c.m ≤ D := Nat.div_le_self _ _
  have hgw : D / c.m * G ≤ K * D := by omega
  -- the values of `core1`
  set qr := (cW * d + 2 * (D / c.m * G) + K - 1) / K with hqr
  have hqr_le : qr ≤ cW * d + 2 * (D / c.m * G) + K := by
    have := Nat.div_le_self (cW * d + 2 * (D / c.m * G) + K - 1) K
    omega
  have hval_r : (q0rNE c.m cW).val (vOf σ) = qr := by
    simp only [q0rNE, gWNE, NE.val, vOf_eq h12, vOf_eq hG, vOf_eq hd.hD, vOf_eq hd.hK]
    exact hqr.symm
  have hv28 : (q0NE c.m cW).val (vOf σ) = q0 := by
    simp only [q0NE, NE.val, hval_r, vOf_eq hd.hD, hq0, q0v]
    rw [← hqr]
    split_ifs with h <;> omega
  have hGD : c.G D ≤ c.Aw * (D + 1) ^ c.p := Gs_le_pow hc.Aw1 hc.p1
  have hv5 : (NE.add (.reg 25) (ewNE c)).val (vOf σ) = H := by
    simp only [ewNE, NE.val, vOf_eq hd.hw, vOf_eq hd.hD, gsNE_val, hH, EwH]
  have hv5' : vOf σ 25 + NE.val (vOf σ) (ewNE c) = H := hv5
  have hfr1 : frV σ (coreF1 c cW) = [(27, ((0 : ℕ) : ℤ)), (32, ((1 : ℕ) : ℤ)), (19, ((1 : ℕ) : ℤ)),
      (28, (q0 : ℤ)), (5, (H : ℤ))] := by
    simp only [frV, coreF1, List.map_cons, List.map_nil, hv28, hv5, NE.val, hv5']
  have hnat : ∀ i ∈ (descL ++ [(12 : Fin HS), 13, vG]), ∃ n : ℕ, σ i = some (n : ℤ) := by
    intro i hi
    rcases List.mem_append.1 hi with h | h
    · exact hd.nat i h
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at h
      rcases h with rfl | rfl | rfl
      exacts [⟨_, h12⟩, ⟨_, h13⟩, ⟨_, hG⟩]
  have hsz28 : (q0NE c.m cW).size ≤ szC c := by
    simp only [szC, q0NE, q0rNE, gWNE, NE.size]; omega
  have hsz5 : (NE.add (.reg 25) (ewNE c)).size ≤ szC c := by
    simp only [szC, NE.size]; omega
  have hregs28 : ∀ i ∈ (q0NE c.m cW).regs, i = 22 ∨ i = 12 ∨ i = vG ∨ i = 1 := by
    have e : (q0NE c.m cW).regs = (q0NE 0 0).regs := rfl
    rw [e]
    decide
  have hregs5 : ∀ i ∈ (NE.add (.reg 25) (ewNE c)).regs, i = 25 ∨ i = 22 := by
    intro i hi
    have hgr : i ∈ (gsNE c.Aw c.p c.m (.reg 22)).regs → i = 22 := fun h => by
      have := gsNE_regs _ _ _ _ i h
      simpa [NE.regs] using this
    simp only [ewNE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false, false_or, List.nil_append, List.append_nil] at hi
    rcases hi with h | h | h
    · exact Or.inl h
    · exact Or.inr h
    · exact Or.inr (hgr h)
  have hdD : d ≤ D := dep_le_self hm D
  have hcd : cW * d ≤ K * D := by omega
  have hY1 : cW + 4 ≤ (cW + 4) * (K * D + K) := Nat.le_mul_of_pos_right _ (by omega)
  have hY2 : 4 * (K * D + K) ≤ (cW + 4) * (K * D + K) := Nat.mul_le_mul_right _ (by omega)
  have hq0rOK : (q0rNE c.m cW).OK (vOf σ) Mb := by
    simp only [q0rNE, gWNE, NE.OK, NE.val, vOf_eq h12, vOf_eq hG, vOf_eq hd.hD, vOf_eq hd.hK]
    repeat' apply And.intro
    all_goals omega
  have hGs : Gs c.Aw c.p c.m D ≤ c.Aw * (D + 1) ^ c.p := hGD
  have hEw : (c.Wr + 4) * (D + Gs c.Aw c.p c.m D) + 4 = EwH c D := rfl
  have hWr4 : c.Wr + 4 ≤ (c.Wr + 4) * (D + Gs c.Aw c.p c.m D) := Nat.le_mul_of_pos_right _ (by omega)
  have hDG : D + Gs c.Aw c.p c.m D ≤ (c.Wr + 4) * (D + Gs c.Aw c.p c.m D) :=
    Nat.le_mul_of_pos_left _ (by omega)
  have hFr1 : FrOK σ Mb (szC c) (coreF1 c cW) := by
    intro x hx
    simp only [coreF1, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl
    · exact ⟨by decide, fun i hi => by simp [NE.regs] at hi, by simp [NE.size, szC],
        fun i hi => by simp [NE.regs] at hi, by simp only [NE.OK]; omega⟩
    · exact ⟨by decide, fun i hi => by simp [NE.regs] at hi, by simp [NE.size, szC],
        fun i hi => by simp [NE.regs] at hi, by simp only [NE.OK]; omega⟩
    · exact ⟨by decide, fun i hi => by simp [NE.regs] at hi, by simp [NE.size, szC],
        fun i hi => by simp [NE.regs] at hi, by simp only [NE.OK]; omega⟩
    · refine ⟨by (try dsimp only); decide,
        fun i hi => by rcases hregs28 i hi with h | h | h | h <;> (subst h; decide), hsz28,
        natR_of _ hnat (fun i hi => by
          rcases hregs28 i hi with h | h | h | h <;> (subst h; decide)), ?_⟩
      show (q0NE c.m cW).OK (vOf σ) Mb
      simp only [q0NE, NE.OK]
      refine ⟨by simp only [NE.OK, vOf_eq hd.hD]; omega, hq0rOK, ?_⟩
      split_ifs
      · simp only [NE.OK, vOf_eq hd.hD]; omega
      · exact hq0rOK
    · refine ⟨by (try dsimp only); decide,
        fun i hi => by rcases hregs5 i hi with h | h <;> (subst h; decide), hsz5,
        fun i hi => by rcases hregs5 i hi with h | h <;> (subst h; first | exact ⟨_, hd.hw⟩ | exact ⟨_, hd.hD⟩), ?_⟩
      show (NE.add (.reg 25) (ewNE c)).OK (vOf σ) Mb
      have hgs := gsNE_OK (v := vOf σ) (M := Mb) c.Aw c.p c.m (.reg 22)
        (by simp only [NE.OK, vOf_eq hd.hD]; omega)
        (by simp only [NE.val, vOf_eq hd.hD]; omega)
      have hHe : H = w + ((c.Wr + 4) * (D + Gs c.Aw c.p c.m D) + 4) := by rw [hH]; rfl
      have hM' : w + ((c.Wr + 4) * (D + Gs c.Aw c.p c.m D) + 4) + G + 100 ≤ Mb := by omega
      simp only [ewNE, NE.OK, NE.val, vOf_eq hd.hw, vOf_eq hd.hD, gsNE_val]
      clear hv5 hv5' hfr1
      refine ⟨?_, ⟨⟨?_, ⟨?_, hgs, ?_⟩, ?_⟩, ?_, ?_⟩, ?_⟩
      all_goals omega
  have hnr1 : NoRdN [] (coreF1 c cW) := by
    refine ⟨by simp [NE.regs], by simp [NE.regs], by simp [NE.regs], fun j hj => ?_,
      fun j hj => ?_, trivial⟩
    · rcases hregs28 j hj with h | h | h | h <;> (subst h; (try dsimp only); decide)
    · rcases hregs5 j hj with h | h <;> (subst h; (try dsimp only); decide)
  set σ1 := σPush σ (frV σ (coreF1 c cW)) with hσ1
  have hnd1 : ((frV σ (coreF1 c cW)).map Prod.fst).Nodup := by
    rw [hfr1]; simp only [List.map_cons, List.map_nil]; decide
  have g1 : ∀ i v, (i, v) ∈ frV σ (coreF1 c cW) → σ1 i = some v := fun i v h => σPush_mem _ σ _ _ hnd1 h
  have n1 : ∀ i, i ∉ [(27 : Fin HS), 32, 19, 28, 5] → σ1 i = σ i := fun i hi =>
    σPush_ne _ σ i (fun q hq e => by
      rw [hfr1] at hq
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl | rfl | rfl <;> (subst e; revert hi; (try dsimp only); decide))
  have hb1 : BaseR σ1 := hd.base.push _ (by
    rw [hfr1]; intro q hq
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl | rfl <;> ((try dsimp only); decide))
  have hσ10 : σ1 0 = none := hb1.off 0 (by decide)
  have s28 : σ1 28 = some (q0 : ℤ) := g1 _ _ (by rw [hfr1]; simp)
  have s13 : σ1 13 = some ((c.W ^ d : ℕ) : ℤ) := by rw [n1 _ (by decide)]; exact h13
  have s21 : σ1 21 = some (P : ℤ) := by rw [n1 _ (by decide)]; exact hd.hP
  have s1 : σ1 1 = some (K : ℤ) := by rw [n1 _ (by decide)]; exact hd.hK
  have s22 : σ1 22 = some (D : ℤ) := by rw [n1 _ (by decide)]; exact hd.hD
  have s24 : σ1 vG = some (G : ℤ) := by rw [n1 _ (by decide)]; exact hG
  -- the values of `core2`
  have hWd1 : 1 ≤ c.W ^ d := Nat.one_le_pow _ _ hc.W1
  have hW1 : 1 ≤ Wk := by
    rw [hWk, WkV]; exact Nat.mul_le_mul hWd1 Nat.one_le_two_pow
  have hWkD : Wk ≤ 2 ^ (K * D) := by
    -- `Wk ≤ 2^{cW d + 2 ⌊D/m⌋ G} ≤ 2^{K D}`
    have h4 : c.W ^ d ≤ 2 ^ (cW * d) := by rw [pow_mul]; exact Nat.pow_le_pow_left hWc d
    calc Wk = c.W ^ d * 2 ^ (2 * (D / c.m * G)) := rfl
      _ ≤ 2 ^ (cW * d) * 2 ^ (2 * (D / c.m * G)) := Nat.mul_le_mul_right _ h4
      _ = 2 ^ (cW * d + 2 * (D / c.m * G)) := by rw [pow_add]
      _ ≤ 2 ^ (K * D) := Nat.pow_le_pow_right (by norm_num) hKW
  have hKq : K * q0 ≤ K * D := Nat.mul_le_mul_left _ hq0D
  have hpq : 2 ^ (K * q0) ≤ 2 ^ (K * D) := Nat.pow_le_pow_right (by norm_num) hKq
  have hPD : P * 2 ^ (K * D) ≤ N := by
    rw [hN, Nat.mul_assoc (P * 2 ^ (K * D)) S r]; exact Nat.le_mul_of_pos_right _ (Nat.mul_pos hS hr)
  have hPq : P * 2 ^ (K * q0) ≤ N := le_trans (Nat.mul_le_mul_left _ hpq) hPD
  have hWN : Wk ≤ N := le_trans hWkD (by omega)
  obtain ⟨pb1, pb2, pb3⟩ := padB_le (P * 2 ^ (K * q0)) Wk hW1
  have hlt : ∀ x : ℕ, 2 ^ x ≤ 32 * N → x + 1 ≤ Z := by
    intro x hx
    have h2 := NLogN.lt_two_pow_zsz (32 * N)
    have h3 : 2 ^ x < 2 ^ Z :=
      lt_of_lt_of_le (lt_of_le_of_lt hx h2) (Nat.pow_le_pow_right (by norm_num) hZ32)
    have := (Nat.pow_lt_pow_iff_right (by norm_num)).1 h3
    omega
  have hKD2 := Nat.lt_two_pow_self (n := K * D)
  have rK := ExV.reg (B := Z) s1 (zb K (by omega))
  have rP := ExV.reg (B := Z) s21 (zb P (by omega))
  have rD := ExV.reg (B := Z) s22 (zb D (by omega))
  have rq := ExV.reg (B := Z) s28 (zb q0 (by omega))
  have hWdN : c.W ^ d ≤ Wk := by
    rw [hWk, WkV]; exact Nat.le_mul_of_pos_right _ (Nat.one_le_two_pow)
  have rW := ExV.reg (B := Z) s13 (zb _ (by omega))
  have eDqV : ExV σ1 eDq ((D - q0 : ℕ) : ℤ) Z :=
    (ExV.add rD rq.neg (zszN (n := D - q0) (by push_cast [hq0D]; ring) (by omega) (le_trans
      (zsz_natCast_le (show 32 * N ≤ 32 * N from le_rfl)) hZ32))).congr (by push_cast [hq0D]; ring)
  -- `2^{2 ⌊D/m⌋ G}`
  have hgwv : (gWNE c.m).val (vOf σ1) = D / c.m * G := by
    simp only [gWNE, NE.val, vOf_eq s22, vOf_eq s24]
  have hnat1 : NatR σ1 (gWNE c.m) := by
    intro i hi
    simp only [gWNE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false] at hi
    rcases hi with rfl | rfl
    exacts [⟨_, s22⟩, ⟨_, s24⟩]
  have hg2 : 2 ^ (2 * (D / c.m * G)) ≤ 2 ^ (K * D) := by
    have : 2 * (D / c.m * G) ≤ K * D := by omega
    exact Nat.pow_le_pow_right (by norm_num) this
  have eG := exV_NE (σ := σ1) (e := gWNE c.m) hnat1 (M := 32 * N) (B := Z) hZ32
    (by simp only [gWNE, NE.OK, NE.val, vOf_eq s22, vOf_eq s24]
        refine ⟨⟨by omega, by omega, by omega⟩, by omega, by omega⟩)
  rw [hgwv] at eG
  have e2G := (ExV.mul (ExV.lit (σ := σ1) (c := 2) (zb 2 (by omega))) eG
    (zszN (n := 2 * (D / c.m * G)) (by push_cast; ring) (by omega) hZ32)).congr
    (show (2 : ℤ) * ((D / c.m * G : ℕ) : ℤ) = ((2 * (D / c.m * G) : ℕ) : ℤ) by push_cast; ring)
  have ep2 : ExV σ1 (.pow2 (.mul (.lit 2) (gWNE c.m).toEx)) ((2 ^ (2 * (D / c.m * G)) : ℕ) : ℤ) Z := by
    have := ExV.pow2 e2G (by positivity) (by rw [Int.toNat_natCast]; exact hlt _ (by omega))
    rw [Int.toNat_natCast] at this
    exact this.congr (by push_cast; ring)
  have eWkV : ExV σ1 (eWk c.m) (Wk : ℤ) Z :=
    (ExV.mul rW ep2 (zszN (n := Wk) (by rw [hWk, WkV]; push_cast; ring) (by omega) hZ32)).congr
      (by rw [hWk, WkV]; push_cast; ring)
  have hKqZ : K * q0 + 1 ≤ Z := hlt _ (by omega)
  have eKq := (ExV.mul rK rq (zszN (n := K * q0) (by push_cast; ring) (by omega) hZ32)).congr
    (show (K : ℤ) * (q0 : ℤ) = ((K * q0 : ℕ) : ℤ) by push_cast; ring)
  have ep : ExV σ1 (.pow2 (.mul (.reg 1) (.reg 28))) ((2 ^ (K * q0) : ℕ) : ℤ) Z := by
    have := ExV.pow2 eKq (by positivity) (by rw [Int.toNat_natCast]; exact hKqZ)
    rw [Int.toNat_natCast] at this
    exact this.congr (by push_cast; ring)
  have ePq := (ExV.mul rP ep (zszN (n := P * 2 ^ (K * q0)) (by push_cast; ring) (by omega) hZ32)).congr
    (show (P : ℤ) * ((2 ^ (K * q0) : ℕ) : ℤ) = ((P * 2 ^ (K * q0) : ℕ) : ℤ) by push_cast; ring)
  have em1 : ExV σ1 (.lit (-1)) (-1) Z := ExV.lit (by
    have h1 := zb 1 (by omega)
    have h2 : zsz ((1 : ℕ) : ℤ) = 1 := by push_cast; exact NLogN.zsz_one
    rw [NLogN.zsz_neg_one']
    omega)
  have eW1 := (ExV.add eWkV em1 (zszN (n := Wk - 1) (by push_cast [hW1]; ring) (by omega) hZ32)).congr
    (show (Wk : ℤ) + -1 = ((Wk - 1 : ℕ) : ℤ) by push_cast [hW1]; ring)
  have eS := (ExV.add ePq eW1 (zszN (n := P * 2 ^ (K * q0) + (Wk - 1)) (by push_cast; ring)
    (by omega) hZ32)).congr
    (show ((P * 2 ^ (K * q0) : ℕ) : ℤ) + ((Wk - 1 : ℕ) : ℤ) = ((P * 2 ^ (K * q0) + Wk - 1 : ℕ) : ℤ) by
      rw [Nat.add_sub_assoc hW1, Nat.cast_add])
  have eQ := (ExV.ndiv eS eWkV (by positivity) (by exact_mod_cast hW1)
    (zszN (n := (P * 2 ^ (K * q0) + Wk - 1) / Wk) (by push_cast; rfl)
      (le_trans (Nat.div_le_self _ _) (by omega)) hZ32)).congr
    (show ((P * 2 ^ (K * q0) + Wk - 1 : ℕ) : ℤ) / (Wk : ℤ) = (((P * 2 ^ (K * q0) + Wk - 1) / Wk : ℕ) : ℤ) by
      push_cast; rfl)
  have hBpN : Bp ≤ 32 * N := by
    have : Bp = padB (P * 2 ^ (K * q0)) Wk := rfl
    rw [this]; omega
  have eBpV : ExV σ1 (eBpH c.m) (Bp : ℤ) Z := by
    have := ExV.mul eWkV eQ (zszN (n := Bp) (by rw [hBp, BpV, padB]; push_cast; ring) hBpN hZ32)
    exact this.congr (by rw [hBp, BpV, padB]; push_cast; ring)
  set l2 := core2H c.m D q0 Bp with hl2
  have hsz2 : (eBpH c.m).size ≤ 64 := by
    simp only [eBpH, eWk, gWNE, Ex.size, NE.size_toEx, NE.size] <;> omega
  have hregsB : ∀ j ∈ (eBpH c.m).regs, j = 13 ∨ j = 22 ∨ j = vG ∨ j = 21 ∨ j = 1 ∨ j = 28 := by
    have e : (eBpH c.m).regs = (eBpH 0).regs := rfl
    rw [e]
    decide
  have hok2 : FrXOK σ1 Z 64 l2 := by
    intro x hx
    simp only [hl2, core2H, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl
    · exact ⟨by (try dsimp only); decide, clean_of_lt (by (try dsimp only); decide),
        by (try dsimp only); decide, eDqV⟩
    · refine ⟨by (try dsimp only); decide, clean_of_lt (fun j hj => ?_), hsz2, eBpV⟩
      rcases hregsB j hj with h | h | h | h | h | h <;> (subst h; decide)
  have hnr2 : NoRd [] l2 := by
    refine ⟨fun j _ => by simp, fun j hj => ?_, trivial⟩
    rcases hregsB j hj with h | h | h | h | h | h <;> (subst h; (try dsimp only); decide)
  set σ2 := σPush σ1 (l2.map fun x => (x.1, x.2.2)) with hσ2
  have hm2 : (l2.map fun x => (x.1, x.2.2)) = [(29, ((D - q0 : ℕ) : ℤ)), (20, (Bp : ℤ))] := rfl
  have hnd2 : (((l2.map fun x => (x.1, x.2.2))).map Prod.fst).Nodup := by
    rw [hm2]; simp only [List.map_cons, List.map_nil]; decide
  have n2 : ∀ i, i ∉ [(29 : Fin HS), 20] → σ2 i = σ1 i := fun i hi =>
    σPush_ne _ σ1 i (fun q hq e => by
      rw [hm2] at hq
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl <;> (subst e; revert hi; (try dsimp only); decide))
  have hb2 : BaseR σ2 := hb1.push _ (by
    rw [hm2]; intro q hq
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
