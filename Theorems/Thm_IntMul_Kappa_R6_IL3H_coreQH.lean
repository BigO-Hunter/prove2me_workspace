variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {lo hi r : ℕ} {st : ι → ℕ} {n : ℕ}

/-- **An expression frame** around a run specification. -/
theorem runQ_frX {σ : Fin HS → Option ℤ} (l : List (Fin HS × Ex HS × ℤ))
    (B sz : ℕ) (h : FrXOK σ B sz l) (hn : NoRd [] l)
    {f g : Fin HS → List ℤ} (hf : ∀ j, (σ j).isSome → f j = [])
    (hfp : ∀ x ∈ l, f x.1 = [] ∧ g x.1 = []) {U : IStmt HS Pp} {c : ℕ}
    (H : RunQ I iprog (σPush σ (l.map fun x => (x.1, x.2.2))) U f g c) :
    RunQ I iprog σ (withPushI (l.map fun x => (x.1, x.2.1)) U) f g
      (cFrame l.length sz B + c + (l.length * (2 * B + 2) + 1)) := by
  have hP := pushSeq_of σ B sz [] l σ (fun _ _ => rfl) h hn
  have := runQ_push _ _ _ B hP hf
    (fun p hp => by
      obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hp
      exact hfp y hy)
    (frX_zsz h) H
  simp only [List.length_map] at this
  exact this

end Frames

/-! ## The phase `S_D` -/

/-- Size bounds of the layer. -/
theorem layer_bounds {K S r P D : ℕ} (hS : 1 ≤ S) (hP : 1 ≤ P) (hr : 1 ≤ r) :
    1 ≤ P * 2 ^ (K * D) * S * r ∧ S * r ≤ P * 2 ^ (K * D) * S * r ∧
    P ≤ P * 2 ^ (K * D) * S * r ∧ 2 ^ (K * D) ≤ P * 2 ^ (K * D) * S * r ∧
    K * D < 2 ^ (K * D) := by
  have h2 : 1 ≤ 2 ^ (K * D) := Nat.one_le_two_pow
  have hKD : K * D < 2 ^ (K * D) := Nat.lt_two_pow_self
  have a1 : 1 ≤ P * 2 ^ (K * D) := Nat.mul_le_mul hP h2
  refine ⟨?_, ?_, ?_, ?_, hKD⟩
  · have := Nat.mul_le_mul (Nat.mul_le_mul a1 hS) hr; simpa using this
  · have := Nat.mul_le_mul_right (S * r) a1
    calc S * r = 1 * (S * r) := (one_mul _).symm
      _ ≤ P * 2 ^ (K * D) * (S * r) := this
      _ = _ := by ring
  · have : 1 ≤ 2 ^ (K * D) * S * r := by
      have := Nat.mul_le_mul (Nat.mul_le_mul h2 hS) hr; simpa using this
    have := Nat.mul_le_mul_left P this
    calc P = P * 1 := (mul_one _).symm
      _ ≤ P * (2 ^ (K * D) * S * r) := this
      _ = _ := by ring
  · have : 1 ≤ P * S * r := by
      have := Nat.mul_le_mul (Nat.mul_le_mul hP hS) hr; simpa using this
    have := Nat.mul_le_mul_left (2 ^ (K * D)) this
    calc 2 ^ (K * D) = 2 ^ (K * D) * 1 := (mul_one _).symm
      _ ≤ 2 ^ (K * D) * (P * S * r) := this
      _ = _ := by ring

end NLogN.KFW

