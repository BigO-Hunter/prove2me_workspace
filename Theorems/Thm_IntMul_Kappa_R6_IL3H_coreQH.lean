theorem frX_zsz {σ : Fin HS → Option ℤ} {B sz : ℕ} {l : List (Fin HS × Ex HS × ℤ)}
    (h : FrXOK σ B sz l) : ∀ p ∈ l.map (fun x => (x.1, x.2.2)), zsz p.2 ≤ B := by
  intro p hp
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hp
  obtain ⟨-, -, -, hv⟩ := h y hy
  obtain ⟨-, b, c⟩ := hv (stOf σ) (agree_stOf σ)
  have := Ex.zsz_eval_le _ B _ c
  rw [b] at this
  exact this

