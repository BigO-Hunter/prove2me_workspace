/-- `K ⌈x/K⌉ ≤ x + K - 1`. -/
theorem mul_ceil_le (x K : ℕ) : K * ((x + K - 1) / K) ≤ x + K - 1 := by
  rw [mul_comm]; exact Nat.div_mul_le_self _ _

namespace Hyp14

variable {c : Cfg} {P K D S r p w Z : ℕ} {lamp : ℝ} (h : Hyp14 c P K D S r p w Z lamp)
include h

/-- **The kernel count.** -/
theorem kerN (hc : CfgOK c) :
    K * ((chV c (cWc c) P K D S r w).q0 + (chV c (cWc c) P K D S r w).qB) ≤
      K0c c * D * (zsz (p : ℤ) + 1) + 2 * K := by
  have hK1 : 1 ≤ K := by have := h.K6; omega
  have hG := h.G_le hc
  set G := Gv czH (Zl c P K D S r w) with hGd
  have hd := dep_le_self hc.m1 D
  have hDm : D / c.m ≤ D := Nat.div_le_self _ _
  have hq0 : (chV c (cWc c) P K D S r w).q0 ≤
      (cWc c * dep c.m D + 2 * (D / c.m * G) + K - 1) / K := by
    show q0v c.m (cWc c) K D (dep c.m D) G ≤ _
    exact min_le_right _ _
  have hqB : (chV c (cWc c) P K D S r w).qB ≤ (D / c.m * G + K - 1) / K := by
    show qBv c.m K D G _ ≤ _
    exact min_le_right _ _
  have a := mul_ceil_le (cWc c * dep c.m D + 2 * (D / c.m * G)) K
  have b := mul_ceil_le (D / c.m * G) K
  have a' := Nat.mul_le_mul_left K hq0
  have b' := Nat.mul_le_mul_left K hqB
  have c1 : cWc c * dep c.m D ≤ cWc c * D := Nat.mul_le_mul_left _ hd
  have c2 : D / c.m * G ≤ D * (2 * zsz (p : ℤ) + 2 * c.Wr + 10) := Nat.mul_le_mul hDm hG
  have hK := h.K0_big
  have e : K0c c * D * (zsz (p : ℤ) + 1) ≥ (cWc c + 3 * (2 * c.Wr + 12)) * D * (zsz (p : ℤ) + 1) :=
    Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hK)
  have h36 := Nat.mul_le_mul_right (zsz (p : ℤ)) (show 36 ≤ cWc c + 3 * (2 * c.Wr + 12) by omega)
  have f1 : cWc c + 6 * zsz (p : ℤ) + 6 * c.Wr + 30 ≤
      (cWc c + 3 * (2 * c.Wr + 12)) * (zsz (p : ℤ) + 1) := by
    rw [Nat.mul_succ]; omega
  have g : cWc c * dep c.m D + 2 * (D / c.m * G) + D / c.m * G ≤
      (cWc c + 3 * (2 * c.Wr + 12)) * D * (zsz (p : ℤ) + 1) := by
    calc cWc c * dep c.m D + 2 * (D / c.m * G) + D / c.m * G
        ≤ cWc c * D + 3 * (D * (2 * zsz (p : ℤ) + 2 * c.Wr + 10)) := by omega
      _ = D * (cWc c + 6 * zsz (p : ℤ) + 6 * c.Wr + 30) := by ring
      _ ≤ D * ((cWc c + 3 * (2 * c.Wr + 12)) * (zsz (p : ℤ) + 1)) := Nat.mul_le_mul_left _ f1
      _ = (cWc c + 3 * (2 * c.Wr + 12)) * D * (zsz (p : ℤ) + 1) := by ring
  rw [Nat.mul_add]
