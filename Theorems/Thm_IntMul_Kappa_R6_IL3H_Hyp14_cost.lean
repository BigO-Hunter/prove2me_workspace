  set E := D - v.q0 - v.qB with hE
  set D0 : ℝ := 10 ^ 14 * (2 * c.m + 1) with hD0
  set L : ℝ := (D : ℝ) ^ lamp with hL
  set A : ℝ := Kc * ((v.G : ℝ) + 2) + 1 + 1 with hA
  set A' : ℝ := (Kc + 2) * (2 * c.Wr + 12) with hA'
  set Q : ℝ := Cc + D0 with hQ
  have hD0p : 0 ≤ D0 := by rw [hD0]; positivity
  have hDR : (1 : ℝ) ≤ D := by exact_mod_cast hD1
  have hL1 : 1 ≤ L := Real.one_le_rpow hDR (by linarith [h.l0])
  have hsR : (0 : ℝ) ≤ s := Nat.cast_nonneg _
  have hA0 : 0 ≤ A := by
    rw [hA]; have := mul_nonneg hKc (by positivity : (0 : ℝ) ≤ (v.G : ℝ) + 2); linarith
  -- `A ≤ A' (s + 1)`
  have hGR : (v.G : ℝ) + 2 ≤ (2 * c.Wr + 12) * ((s : ℝ) + 1) := by
    have : v.G + 2 ≤ (2 * c.Wr + 12) * (s + 1) := by
      have m1 : 2 * s ≤ (2 * c.Wr + 12) * s := Nat.mul_le_mul_right _ (by omega)
      have m2 : (2 * c.Wr + 12) * (s + 1) = (2 * c.Wr + 12) * s + (2 * c.Wr + 12) := by ring
      omega
    exact_mod_cast this
  have hAA : A ≤ A' * ((s : ℝ) + 1) := by
    rw [hA, hA']
    have hG0 : (0 : ℝ) ≤ v.G := Nat.cast_nonneg _
    have : Kc * ((v.G : ℝ) + 2) + 2 ≤ (Kc + 2) * ((v.G : ℝ) + 2) := by
      have e : (Kc + 2) * ((v.G : ℝ) + 2) = Kc * ((v.G : ℝ) + 2) + 2 * (v.G : ℝ) + 4 := by ring
      linarith
    have h2 : (Kc + 2) * ((v.G : ℝ) + 2) ≤ (Kc + 2) * ((2 * c.Wr + 12) * ((s : ℝ) + 1)) :=
      mul_le_mul_of_nonneg_left hGR (by linarith)
    have e : (Kc + 2) * ((2 * (c.Wr : ℝ) + 12) * ((s : ℝ) + 1)) =
      (Kc + 2) * (2 * (c.Wr : ℝ) + 12) * ((s : ℝ) + 1) := by ring
    linarith
  -- the level coefficients
  have hPhi1 : PhiH c.m Cc D0 θ 1 ≤ Q := by
    have := PhiH_le (m := c.m) (D0 := D0) (θ := θ) hCc le_rfl 1
    simpa [Real.one_rpow, hQ] using this
  have hEθ : ((E : ℕ) : ℝ) ^ θ ≤ L := by
    have a : ((E : ℕ) : ℝ) ^ θ ≤ (D : ℝ) ^ θ :=
      Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast (show E ≤ D by omega)) hθ0
    exact a.trans (Real.rpow_le_rpow_of_exponent_le hDR hθl)
  have hPhiE : PhiH c.m Cc D0 θ E ≤ Q * L := by
    have := PhiH_le (m := c.m) (D0 := D0) (θ := θ) hCc le_rfl E
    have b : Cc * ((E : ℕ) : ℝ) ^ θ ≤ Cc * L := mul_le_mul_of_nonneg_left hEθ hCc
    have c' : D0 ≤ D0 * L := le_mul_of_one_le_right hD0p hL1
    have e : (Cc + D0) * L = Cc * L + D0 * L := by ring
    rw [hQ, e]; linarith
  have hCB1 : CBc c Kc v.G Cc θ 1 = A * PhiH c.m Cc D0 θ 1 := rfl
  have hCBE : CBc c Kc v.G Cc θ E = A * PhiH c.m Cc D0 θ E := rfl
  have hP1 : 0 ≤ PhiH c.m Cc D0 θ 1 := PhiH_nonneg hCc hD0p 1
  have hPE : 0 ≤ PhiH c.m Cc D0 θ E := PhiH_nonneg hCc hD0p E
  -- `q₀ + q_B ≤ 3 D^lamp`
  have hqR : ((v.q0 + v.qB : ℕ) : ℝ) ≤ 3 * L := by
    have hkR : ((K * (v.q0 + v.qB) : ℕ) : ℝ) ≤ ((K0c c * D * (s + 1) + 2 * K : ℕ) : ℝ) := by
      exact_mod_cast hker
    push_cast at hkR h3
    have hKR : (1 : ℝ) ≤ K := by exact_mod_cast hK1
    have hKL : (K : ℝ) ≤ K * L := le_mul_of_one_le_right (by positivity) hL1
    have : (K : ℝ) * ((v.q0 : ℝ) + v.qB) ≤ (K : ℝ) * (3 * L) := by linarith
    push_cast
    exact le_of_mul_le_mul_left this (by linarith)
  -- the floors
  have hnU : ((n * U : ℕ) : ℝ) ≤ (n : ℝ) * (25 * ((r : ℝ) * ((w : ℝ) + 1))) := by
    have : n * U ≤ n * (25 * (r * (w + 1))) := Nat.mul_le_mul_left _ hU
    exact_mod_cast this
  have hnpU : ((v.Bp * 2 ^ (K * (D - v.q0)) * S * U : ℕ) : ℝ) ≤
      2 * ((n : ℝ) * (25 * ((r : ℝ) * ((w : ℝ) + 1)))) := by
    have : v.Bp * 2 ^ (K * (D - v.q0)) * S * U ≤ 2 * (n * (25 * (r * (w + 1)))) := by
      calc v.Bp * 2 ^ (K * (D - v.q0)) * S * U ≤ (2 * n) * U := Nat.mul_le_mul_right _ hnp
        _ ≤ (2 * n) * (25 * (r * (w + 1))) := Nat.mul_le_mul_left _ hU
        _ = 2 * (n * (25 * (r * (w + 1)))) := by ring
    exact_mod_cast this
  set M : ℝ := (n : ℝ) * ((r : ℝ) * ((w : ℝ) + 1)) with hM
  have hM0 : 0 ≤ M := by rw [hM]; positivity
  have hQ0 : 0 ≤ Q := by rw [hQ]; linarith
  have hA'0 : 0 ≤ A' := by rw [hA']; exact mul_nonneg (by linarith) (by positivity)
  have hAs : 0 ≤ A' * ((s : ℝ) + 1) := mul_nonneg hA'0 (by linarith)
  have hF1 : (⌊CBc c Kc v.G Cc θ 1 * ((n * U : ℕ) : ℝ)⌋₊ : ℝ) ≤ A' * ((s : ℝ) + 1) * Q * (25 * M) := by
    rw [hCB1]
    refine (Nat.floor_le (mul_nonneg (mul_nonneg hA0 hP1) (Nat.cast_nonneg _))).trans ?_
    have a : A * PhiH c.m Cc D0 θ 1 ≤ A' * ((s : ℝ) + 1) * Q :=
      mul_le_mul hAA hPhi1 hP1 hAs
    exact mul_le_mul a (by rw [hM]; linarith) (Nat.cast_nonneg _) (mul_nonneg hAs hQ0)
  have hFm : (⌊CBc c Kc v.G Cc θ E * ((v.Bp * 2 ^ (K * (D - v.q0)) * S * U : ℕ) : ℝ)⌋₊ : ℝ) ≤
      A' * ((s : ℝ) + 1) * (Q * L) * (50 * M) := by
    rw [hCBE]
    refine (Nat.floor_le (mul_nonneg (mul_nonneg hA0 hPE) (Nat.cast_nonneg _))).trans ?_
    have a : A * PhiH c.m Cc D0 θ E ≤ A' * ((s : ℝ) + 1) * (Q * L) :=
      mul_le_mul hAA hPhiE hPE hAs
    exact mul_le_mul a (by rw [hM]; linarith) (Nat.cast_nonneg _)
      (mul_nonneg hAs (mul_nonneg hQ0 (by linarith)))
  -- assemble
  have HNR : ((8 * (2 * moveCost Z + 19) + (cChainH c (CBc c Kc v.G Cc θ) (cWc c) P K D S r w Z
      (3 * Z) (3 * Z) + 8 * (2 * moveCost Z + 19)) + 2 : ℕ) : ℝ) ≤
      ((v.q0 + v.qB : ℕ) : ℝ) * (⌊CBc c Kc v.G Cc θ 1 * ((n * U : ℕ) : ℝ)⌋₊ : ℝ) +
      401 * (⌊CBc c Kc v.G Cc θ E * ((v.Bp * 2 ^ (K * (D - v.q0)) * S * U : ℕ) : ℝ)⌋₊ : ℝ) +
      10 ^ 17 * (((Sc c + 1 : ℕ) : ℝ) * (2 * c.Wr + 14)) * (M * ((s : ℝ) + 1)) := by
    have := (Nat.cast_le (α := ℝ)).2 HN
    push_cast at this ⊢
    rw [hM]
    linarith
  have t1 : ((v.q0 + v.qB : ℕ) : ℝ) * (⌊CBc c Kc v.G Cc θ 1 * ((n * U : ℕ) : ℝ)⌋₊ : ℝ) ≤
      75 * (A' * ((s : ℝ) + 1) * Q * M) * L := by
    have := mul_le_mul hqR hF1 (Nat.cast_nonneg _) (by linarith)
    linarith
  have t2 : (401 : ℝ) * (⌊CBc c Kc v.G Cc θ E * ((v.Bp * 2 ^ (K * (D - v.q0)) * S * U : ℕ) : ℝ)⌋₊ : ℝ) ≤
      20050 * (A' * ((s : ℝ) + 1) * Q * M) * L := by
    linarith
  have hSc0 : (0 : ℝ) ≤ ((Sc c + 1 : ℕ) : ℝ) * (2 * c.Wr + 14) := by positivity
  have t3 : 10 ^ 17 * (((Sc c + 1 : ℕ) : ℝ) * (2 * c.Wr + 14)) * (M * ((s : ℝ) + 1)) ≤
      10 ^ 17 * (((Sc c + 1 : ℕ) : ℝ) * (2 * c.Wr + 14)) * (M * ((s : ℝ) + 1)) * L := by
    have : 0 ≤ 10 ^ 17 * (((Sc c + 1 : ℕ) : ℝ) * (2 * c.Wr + 14)) * (M * ((s : ℝ) + 1)) :=
      mul_nonneg (mul_nonneg (by norm_num) hSc0) (mul_nonneg hM0 (by linarith))
    exact le_mul_of_one_le_right this hL1
  have hfin : C0c c Kc Cc * ((P * 2 ^ (K * D) * S * r : ℕ) : ℝ) * ((w : ℝ) + 1) *
      ((s : ℝ) + 1) * L = (20125 * (A' * ((s : ℝ) + 1) * Q * M) +
        10 ^ 17 * (((Sc c + 1 : ℕ) : ℝ) * (2 * c.Wr + 14)) * (M * ((s : ℝ) + 1))) * L := by
    have hn' : (n : ℝ) = (P : ℝ) * 2 ^ (K * D) * S := by rw [hnd]; push_cast; ring
    rw [C0c, hM, hA', hQ, hD0]
    push_cast
    (try rw [hn'])
    ring
  rw [hfin]
  linarith

