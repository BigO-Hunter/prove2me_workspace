  have hn2 := hp.n2
  fin_cases px
  · refine ⟨1 + 25, ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    refine IRuns.iteF (by rw [hfa]; decide) ?_
    refine (IRuns.skip t).mono' ?_ le_rfl
    show t = t.upd 0 (ints (rixT (gB N0 N1 N2 N3 K f R w) id zs) ++ R0)
    rw [rixT_id hl, ← h0, IState.upd_self]
  · obtain ⟨c, Hc, hc⟩ := HSw 0 _ hg (f * K) hu hQ I t zs R0 hb h0 hl (.reg mN0) eGA eSA eFK _
      le_rfl (by decide) nk_N0 nk_GA nk_SA nk_FK (sN0 hp hA)
      (ESp.of_eq (sGA hp hA) (by simp [gxV, svG, gB, geoB]))
      (ESp.of_eq (sSA hp hA) (by simp [gxV, svS, vol, gB, geoB] <;> ring)) (sFK hp hA)
    refine ⟨c + 25, IRuns.iteT (by rw [hfa]; decide) ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    exact Hc.mono' (by simp [lA, compL]) le_rfl
  · have hdiv : N2 * 2 ^ (f * K) * N3 * (R * (2 * (w + 1))) / (2 ^ (f * K) * N2) =
        N3 * (R * (2 * (w + 1))) := by
      rw [show N2 * 2 ^ (f * K) * N3 * (R * (2 * (w + 1))) =
        (2 ^ (f * K) * N2) * (N3 * (R * (2 * (w + 1)))) by ring,
        Nat.mul_div_cancel_left _ (Nat.mul_pos (by positivity) (by omega))]
    obtain ⟨c, Hc, hc⟩ := HSw 2 _ hg (f * K) hu hQ I t zs R0 hb h0 hl (.reg mN0) eGA eSA eFK _
      le_rfl (by decide) nk_N0 nk_GA nk_SA nk_FK (sN0 hp hA)
      (ESp.of_eq (sGA hp hA) (by simp [gxV, svG, vol, gB, geoB] <;> ring))
      (ESp.of_eq (sSA hp hA) (by simp only [gxV]; rw [if_pos (by decide), hdiv]; simp [svS, vol, gB, geoB])) (sFK hp hA)
    refine ⟨c + 25, IRuns.iteT (by rw [hfa]; decide) ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    exact Hc.mono' (by simp [lA, compL]) le_rfl

theorem optB_runs {Ksw : ℝ} (hK : 0 ≤ Ksw) (HSw : SwEOK tab l12 τ Ksw)
    (hp : PPos N0 N1 N2 N3 K f ρ R) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (I : List Sym) (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hl : zs.length = (gB N0 N1 N2 N3 K f R w).V) :
    ∃ c : ℕ, IRuns I tab (optB l12) t
      (t.upd 0 (ints (rixT (gB N0 N1 N2 N3 K f R w) (compL (lB px py)) zs) ++ R0)) c ∧
      (c : ℝ) ≤ 26 + Ksw * (((gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ := by
  have hg : (gB N0 N1 N2 N3 K f R w).Pos := hp.geo
  have hu : 1 ≤ f * K := Nat.mul_pos hp.f hp.k
  have hQ : (gB N0 N1 N2 N3 K f R w).Q = 2 ^ (f * K) := rfl
  have hX : 0 ≤ Ksw * (((gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ := by positivity
  have hfb : t.cl mFb = cls (some (.int (flB px py : ℕ))) := cl_of_agree hA rfl
  by_cases h1 : flB px py = 1
  · obtain ⟨c, Hc, hc⟩ := HSw 1 _ hg (f * K) hu hQ I t zs R0 hb h0 hl eP1 (.reg mN2) eS2 eFK _
      le_rfl (by decide) nk_P1 nk_N2 nk_S2 nk_FK (ESp.of_eq (sP1 hp hA) (by simp [svP, vol, gB, geoB] <;> ring))
      (sN2 hp hA) (ESp.of_eq (sS2 hp hA) (by simp [svS, vol, gB, geoB])) (sFK hp hA)
    refine ⟨c + 25, IRuns.iteT (by rw [hfb, h1]; decide) ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    exact Hc.mono' (by simp [lB, h1, compL]) le_rfl
  · have h0' : flB px py = 0 := by have := flB_le px py; omega
    refine ⟨1 + 25, ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    refine IRuns.iteF (by rw [hfb, h0']; decide) ?_
    refine (IRuns.skip t).mono' ?_ le_rfl
    simp only [lB, h1, if_false, compL]
    rw [rixT_id hl, ← h0, IState.upd_self]

set_option maxHeartbeats 2000000 in
/-- **Lemma 13, register-driven**: the denotation and the cost pieces (`KFL.l13_runs` for
`l13U`). -/
theorem l13U_runs_sol_aux {Ksw Kc : ℝ} (hKsw : 0 ≤ Ksw) (hKc : 0 ≤ Kc) (HSw : SwEOK tab l12 τ Ksw)
    (HC : CorrUOK Kc) (hne : px ≠ py) (hK6 : 6 ≤ K) (hp : PPos N0 N1 N2 N3 K f ρ R)
    (I : List Sym) (t : IState HS) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (zs : List GI) (R0 : List Item) (h0 : t.G 0 = ints (gflat zs) ++ R0)
    (hl : zs.length = vol (rect N0 N1 N2 N3 (f * K)) * R) (hGB : GB w zs) :
    ∃ c, IRuns I tab (l13U l12) t
        (t.upd 0 (ints (gflat (permRecs (rect N0 N1 N2 N3 (f * K))
          (rowAddAddr K ρ f px py) R zs)) ++ R0)) c ∧
      (c : ℝ) ≤ 2000 * (cTo (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ) +
        4 * (26 + Ksw * (((gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) *
          ((f * K : ℕ) : ℝ) ^ τ) +
        (400 * coreCost τ Ksw Kc K ρ f (gB N0 N1 N2 N3 K f R w) +
          10 ^ 10 * (((zsz ((gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 : ℕ) : ℝ) + 2) ^ 2) +
        2000 * (cFrom (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ) := by
  set gm := gB N0 N1 N2 N3 K f R w with hgm
  have hg : gm.Pos := hp.geo
  set M := vol (rect N0 N1 N2 N3 (f * K))
  set P := permRecs (rect N0 N1 N2 N3 (f * K)) (rowAddAddr K ρ f px py) R zs
  set xs := gflat zs
  have hxs : ∀ x ∈ xs, zsz x ≤ w := zsz_gflat hGB
  have hxl : xs.length = 2 * (M * R) := by simp only [xs, length_gflat, hl]
  -- 1. to bits
  obtain ⟨L1, hL1⟩ := hA mNt _ rfl
  obtain ⟨L2, hL2⟩ := hA mW _ rfl
  have S1 := toBitsU_spec (I := I) (iprog := tab) t xs w hxs R0 h0
    (L1 := L1) (L2 := L2) (by rw [hxl]; exact hL1) hL2
  rw [hxl] at S1
  set xb := bitsL w xs
  have hxbl : xb.length = gm.V := by
    simp only [xb, length_bitsL, hxl, hgm, gB, geoB_V]; ring
  have hxbb : KFL.Bits xb := bits_bitsL w xs
  set t1 := t.upd 0 (ints xb ++ R0)
  have hA1 : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t1 := agree_upd0 hA rfl _
  -- 2. swaps
  obtain ⟨c2, S2, hc2⟩ := optA_runs (l12 := l12) hKsw HSw hp hA1 I xb R0 hxbb (by simp [t1]) hxbl
  set za := rixT gm (compL (lA px)) xb
  obtain ⟨c2', S2', hc2'⟩ := optB_runs (l12 := l12) hKsw HSw hp (agree_upd0 hA1 rfl (ints za ++ R0)) I za R0
    (bits_rixT hxbb) (by simp) (length_rixT _ _ _)
  have TA : ∀ l : List (Fin 3), ∀ c, TV gm.Q c → TV gm.Q (compL l c) := fun l c hc => TV_compL _ c hc
  have ez2 : rixT gm (compL (lB px py)) za = rixT gm (compL (preL px py)) xb := by
    simp only [za]
    rw [rixT_rixT hg (TA _) (TA _), preL_eq px py hne, compL_append]
  have S2'' : IRuns I tab (optB l12) (t1.upd 0 (ints za ++ R0))
      (t1.upd 0 (ints (rixT gm (compL (preL px py)) xb) ++ R0)) c2' :=
    S2'.mono' (by rw [IState.upd_upd_same, ez2]) le_rfl
  set z2 := rixT gm (compL (preL px py)) xb
  set t2 := t1.upd 0 (ints z2 ++ R0)
  -- 3. core
  obtain ⟨c3, S3, hc3⟩ := coreBU_runs (l12 := l12) hKsw hKc HSw HC hK6 hp I t2
    (agree_upd0 hA1 rfl _) z2 R0 (bits_rixT hxbb) (by simp [t2]) (length_rixT _ _ _)
  set z3 := rixT gm (RAc K ρ f) z2
  set t3 := t2.upd 0 (ints z3 ++ R0)
  -- 4. inverse swaps
  obtain ⟨c4, S4, hc4⟩ := optB_runs (l12 := l12) hKsw HSw hp (agree_upd0 (agree_upd0 hA1 rfl _) rfl (ints z3 ++ R0))
    I z3 R0 (bits_rixT (bits_rixT hxbb)) (by simp [t3]) (length_rixT _ _ _)
  set zb := rixT gm (compL (lB px py)) z3
  obtain ⟨c4', S4', hc4'⟩ := optA_runs (l12 := l12) hKsw HSw hp
    (agree_upd0 (agree_upd0 (agree_upd0 hA1 rfl _) rfl _) rfl (ints zb ++ R0)) I zb R0
    (bits_rixT (bits_rixT (bits_rixT hxbb))) (by simp) (length_rixT _ _ _)
  have ez4 : rixT gm (compL (lA px)) zb = rixT gm (compL (preL px py).reverse) z3 := by
    simp only [zb]
    rw [rixT_rixT hg (TA _) (TA _), preL_rev px py hne, compL_append]
  have S4'' : IRuns I tab (optA l12) (t3.upd 0 (ints zb ++ R0))
      (t3.upd 0 (ints (rixT gm (compL (preL px py).reverse) z3) ++ R0)) c4' :=
    S4'.mono' (by rw [IState.upd_upd_same, ez4]) le_rfl
  set z4 := rixT gm (compL (preL px py).reverse) z3
  have hz4 : z4 = bitsL w (gflat P) := by
    have TR : ∀ c, TV gm.Q c → TV gm.Q (RAc K ρ f c) := fun c hc => TV_RAc' c hc
    simp only [z4, z3, z2]
    rw [rixT_rixT hg (TA _) TR, rixT_rixT hg (F := compL (preL px py) ∘ RAc K ρ f)
      (fun c hc => TA _ _ (TR c hc)) (TA _),
      bits_permRecs (w := w) hp.n0 hp.n1 hp.n2 hp.n3 hp.r px py zs hl]
    exact rixT_congr hg (fun c _ => (Fpp_conj K ρ f px py hne c).symm) _
  set t4 := t3.upd 0 (ints z4 ++ R0)
  -- 5. from bits
  have hPl : P.length = M * R := by
    have e1 := congrArg List.length hz4
    rw [length_rixT, length_bitsL, length_gflat] at e1
    have e2 : gm.V = M * R * (2 * (w + 1)) := geoB_V
    rw [e2] at e1
    have : P.length * (2 * (w + 1)) = M * R * (2 * (w + 1)) := by
      rw [e1]; ring
    exact Nat.eq_of_mul_eq_mul_right (by positivity) this
  have hPx : ∀ x ∈ gflat P, zsz x ≤ w := zsz_gflat (fun z hz => hGB z (mem_permRecs hz))
  have hA4 : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t4 :=
    agree_upd0 (agree_upd0 (agree_upd0 hA1 rfl _) rfl _) rfl _
  obtain ⟨L3, hL3⟩ := hA4 mNt _ rfl
  obtain ⟨L4, hL4⟩ := hA4 mW _ rfl
  have S5 := fromBitsU_spec (I := I) (iprog := tab) t4 (gflat P) w hPx R0
    (by simp [t4, hz4]) (L1 := L3) (L2 := L4) (by rw [length_gflat, hPl]; exact hL3) hL4
  rw [length_gflat, hPl] at S5
  refine ⟨_, (S1.seq (S2.seq (S2''.seq (S3.seq (S4.seq (S4''.seq S5)))))).mono' ?_ le_rfl, ?_⟩
  · simp only [t4, t3, t2, t1, IState.upd_upd_same]
  · rw [← hgm] at hc2 hc2' hc3 hc4 hc4'
    generalize ((f * K : ℕ) : ℝ) ^ τ = Lτ at hc2 hc2' hc4 hc4' ⊢
    simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] at hc3 ⊢
    linarith

end Runs

end IntMul.Kappa.R6.IL2

