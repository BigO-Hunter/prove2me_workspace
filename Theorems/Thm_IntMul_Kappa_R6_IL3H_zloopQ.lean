theorem aNE_facts {c : Cfg} (hc : CfgOK c) {σ : Fin HS → Option ℤ} {P K D S ρ r w : ℕ}
    (hd : DescR σ P K D S ρ r w) (hP : 1 ≤ P) (hS : 1 ≤ S) (hr : 1 ≤ r) {M : ℕ}
    (hM : 2 * aV c P S r w D + c.Aw * (D + 1) ^ c.p + (D + 1) ^ c.p + 2 * c.m + 10 ≤ M) :
    (aNE c).RegsLt ∧ NatR σ (aNE c) ∧ (aNE c).OK (vOf σ) M ∧
      (aNE c).val (vOf σ) = aV c P S r w D := by
  have hW : 1 ≤ c.Wr := by have := hc.W1; simp only [Cfg.Wr]; omega
  have hGD : c.G D ≤ c.Aw * (D + 1) ^ c.p := Gs_le_pow hc.Aw1 hc.p1
  have hval : (aNE c).val (vOf σ) = aV c P S r w D := by
    simp only [aNE, a0NE, ewNE, NE.val, vOf_eq hd.hP, vOf_eq hd.hS, vOf_eq hd.hr, vOf_eq hd.hw,
      vOf_eq hd.hD, gsNE_val, aV, EwH]
  have h1 : 32 * c.Wr ≤ 32 * c.Wr * P := Nat.le_mul_of_pos_right _ hP
  have h2 : 32 * c.Wr * P ≤ 32 * c.Wr * P * S := Nat.le_mul_of_pos_right _ hS
  have h3 : 32 * c.Wr * P * S ≤ 32 * c.Wr * P * S * r := Nat.le_mul_of_pos_right _ hr
  have h4 : P ≤ 32 * c.Wr * P := Nat.le_mul_of_pos_left _ (by omega)
  have h5 : S ≤ 32 * c.Wr * P * S := Nat.le_mul_of_pos_left _ (by positivity)
  have h6 : r ≤ 32 * c.Wr * P * S * r := Nat.le_mul_of_pos_left _ (by positivity)
  have hA : aV c P S r w D = 32 * c.Wr * P * S * r + w + EwH c D := rfl
  have hEw : EwH c D = (c.Wr + 4) * (D + c.G D) + 4 := rfl
  have e3 : D + c.G D ≤ (c.Wr + 4) * (D + c.G D) := Nat.le_mul_of_pos_left _ (by omega)
  refine ⟨fun i hi => ?_, fun i hi => ?_, ?_, hval⟩
  · rcases aNE_regs c i hi with rfl | rfl | rfl | rfl | rfl <;> decide
  · rcases aNE_regs c i hi with rfl | rfl | rfl | rfl | rfl
