theorem zloopQ_sol_aux {c : Cfg} (hc : CfgOK c) {jZ : Fin Pp} {cont : IStmt HS Pp}
    (hj : tbl jZ = zloopC c jZ cont) {P K D S ρ r w Mb Bz : ℕ} (hP : 1 ≤ P)
    (hS : 1 ≤ S) (hr : 1 ≤ r) (hMb : zsz (Mb : ℤ) ≤ Bz)
    (hM : 2 * aV c P S r w D + c.Aw * (D + 1) ^ c.p + (D + 1) ^ c.p + 2 * c.m + 10 ≤ Mb)
    {f g : Fin HS → List ℤ} (hf : Clean0 f) (hg : Clean0 g) {cc : ℕ}
    (Cont : ∀ σ, DescR σ P K D S ρ r w → σ 11 = some (Nat.size (aV c P S r w D) : ℤ) →
      RunQ Isym tbl σ cont f g cc) :
    ∀ n σ, (DescR σ P K D S ρ r w ∧ ∃ j : ℕ, σ 11 = some (j : ℤ) ∧
      σ 12 = some ((2 ^ j : ℕ) : ℤ) ∧ j + n = Nat.size (aV c P S r w D)) →
      RunQ Isym tbl σ (.call jZ) f g (cc + (n + 1) * cLoopS (szZ c) 2 Bz) := by
  set a := aV c P S r w D with ha
  have hsz := Nat.lt_size_self a
  have hcR : (zCond c).RegsLt := by
    intro i hi
    simp only [zCond, NE.regs, List.mem_append] at hi
    rcases hi with ((h | h) | h) | h
    · rcases aNE_regs c i h with rfl | rfl | rfl | rfl | rfl <;> decide
    · simp only [NE.regs, List.mem_singleton] at h; subst h; (try dsimp only); decide
    · simp [NE.regs] at h
    · simp [NE.regs] at h
  have hnat : ∀ σ : Fin HS → Option ℤ, DescR σ P K D S ρ r w → ∀ j : ℕ,
      σ 12 = some (j : ℤ) → NatR σ (zCond c) := by
    intro σ hd j h12 i hi
    simp only [zCond, NE.regs, List.mem_append] at hi
    rcases hi with ((h | h) | h) | h
    · rcases aNE_regs c i h with rfl | rfl | rfl | rfl | rfl
      exacts [⟨_, hd.hP⟩, ⟨_, hd.hS⟩, ⟨_, hd.hr⟩, ⟨_, hd.hw⟩, ⟨_, hd.hD⟩]
    · simp only [NE.regs, List.mem_singleton] at h; subst h; exact ⟨_, h12⟩
    · simp [NE.regs] at h
    · simp [NE.regs] at h
  refine loopQS (Isym := Isym) (tbl := tbl) (sz := szZ c) hj _ hMb hcR le_rfl
    (noRdN_of_B _ _ (by decide)) (by decide) hf hg ?_ ?_
  · rintro σ ⟨hd, j, h11, h12, hjn⟩
    have hjG : j = Nat.size a := by omega
    subst hjG
    obtain ⟨-, -, hok, hval⟩ := aNE_facts hc hd hP hS hr hM
    have hv : (zCond c).val (vOf σ) = 1 := by
      simp only [zCond, NE.val, hval, vOf_eq h12]; rw [if_pos hsz]
    have hle : 2 ^ Nat.size a ≤ 2 * a + 1 := by
      rcases Nat.eq_zero_or_pos a with h0 | h0
      · rw [h0, Nat.size_zero]; omega
      · have := Nat.lt_size.1 (show Nat.size a - 1 < Nat.size a by
          have := Nat.size_pos.2 h0; omega)
        have e : 2 ^ Nat.size a = 2 * 2 ^ (Nat.size a - 1) := by
          rw [← pow_succ']; congr 1; have := Nat.size_pos.2 h0; omega
        omega
    refine ⟨hd.base.off 0 (by decide), hnat σ hd _ h12, ?_, by rw [hv]; norm_num, ?_⟩
    · simp only [zCond, NE.OK, vOf_eq h12, hval]
      refine ⟨hok, by omega, ?_⟩
      split_ifs <;> (try simp only [NE.OK]) <;> omega
    · rw [hv]
      exact Cont _ (hd.push _ (fun q hq => by simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide))
        (by rw [σPush16_ne σ _ (by decide)]; exact h11)
  · rintro n σ ⟨hd, j, h11, h12, hjn⟩
    have hjG : j < Nat.size a := by omega
    have hlt : 2 ^ j ≤ a := Nat.lt_size.1 hjG
    obtain ⟨-, -, hok, hval⟩ := aNE_facts hc hd hP hS hr hM
    have hv : (zCond c).val (vOf σ) = 0 := by
      simp only [zCond, NE.val, hval, vOf_eq h12]; rw [if_neg (by omega)]
    set σ1 := σPush σ [((16 : Fin HS), ((0 : ℕ) : ℤ))] with hσ1
    have hd1 : DescR σ1 P K D S ρ r w :=
      hd.push _ (fun q hq => by simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide)
    have h11' : σ1 11 = some (j : ℤ) := by rw [hσ1, σPush16_ne σ _ (by decide)]; exact h11
    have h12' : σ1 12 = some ((2 ^ j : ℕ) : ℤ) := by rw [hσ1, σPush16_ne σ _ (by decide)]; exact h12
    have hfr : frV σ1 gStep = [(11, ((j + 1 : ℕ) : ℤ)), (12, ((2 ^ (j + 1) : ℕ) : ℤ))] := by
      simp only [frV, gStep, List.map_cons, List.map_nil, NE.val, vOf_eq h11', vOf_eq h12', pow_succ]
      try rfl
    have hnd : (([(11, ((j + 1 : ℕ) : ℤ)), (12, ((2 ^ (j + 1) : ℕ) : ℤ))] : List (Fin HS × ℤ)).map
        Prod.fst).Nodup := by simp only [List.map_cons, List.map_nil]; decide
    have hj1 : j < 2 ^ j := Nat.lt_two_pow_self
    refine ⟨hd.base.off 0 (by decide), hnat σ hd _ h12, ?_, hv, ?_, ?_⟩
    · simp only [zCond, NE.OK, vOf_eq h12, hval]
      refine ⟨hok, by omega, ?_⟩
      split_ifs <;> (try simp only [NE.OK]) <;> omega
    · intro x hx
      simp only [gStep, List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      all_goals refine ⟨by decide, regsLt_of_all (by decide), by decide, fun i hi => ?_, ?_⟩
      · simp only [NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false] at hi
        subst hi; exact ⟨_, h11'⟩
      · simp only [NE.OK, NE.val, vOf_eq h11']
        repeat' apply And.intro
        all_goals omega
      · simp only [NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false] at hi
        subst hi; exact ⟨_, h12'⟩
      · simp only [NE.OK, NE.val, vOf_eq h12']
        repeat' apply And.intro
        all_goals omega
    · rw [hfr]
      refine ⟨hd1.push _ (fun q hq => by
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
          rcases hq with rfl | rfl <;> ((try dsimp only); decide)),
        j + 1, σPush_mem _ _ _ _ hnd (by simp), σPush_mem _ _ _ _ hnd (by simp), by omega⟩

end ZLoop

end IntMul.Kappa.R6.IL3H

