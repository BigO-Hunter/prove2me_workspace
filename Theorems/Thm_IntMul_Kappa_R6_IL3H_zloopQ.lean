theorem aNE_regs (c : Cfg) : ∀ i ∈ (aNE c).regs, i = 21 ∨ i = 3 ∨ i = 4 ∨ i = 25 ∨ i = 22 := by
  intro i hi
  have h' : i ∈ (a0NE c.Wr).regs ∨ i = 25 ∨ i ∈ (gsNE c.Aw c.p c.m (.reg 22)).regs ∨ i = 22 := by
    simp only [aNE, ewNE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false, List.nil_append, List.append_nil, false_or] at hi
    tauto
  rcases h' with h | h | h | h
  · simp only [a0NE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false,
      List.nil_append, false_or] at h
    tauto
  · tauto
  · have := gsNE_regs _ _ _ _ i h
    simp only [NE.regs, List.mem_singleton] at this
    tauto
  · tauto

