-- Source module: Solutions.KIL4Steps
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

variable {m : ℕ}

theorem fracZ_one (N : ℕ) (p : ℤ) : fracZ N p 1 = (p : ZMod N) := by
  simp [fracZ, ZMod.inv_one]

theorem dhT_eval (N : ℕ) (neg : Bool) (cc : ℤ) (j : Fin m) :
    (dhT neg cc j).eval N = dhStep (if neg then -1 else 1) (cc : ZMod N) j := by
  simp only [TSh.eval, dhStep, dhT]
  congr 1
  · cases neg <;> simp [fracU, ZMod.inv_one]
  · funext l
    simp only [TSh.ctrl, Pi.single_apply]
    by_cases hl : l = Fin.castAdd m j
    · subst hl
      have : Fin.castAdd m j < Fin.natAdd m j := by
        rw [Fin.lt_def]; simp; exact Fin.pos j
      simp only [this, if_true, fracZ_one, if_pos]
      simp [fracZ_one]
    · rw [if_neg hl]
      split_ifs with h1 h2
      · exfalso; apply hl; ext; simp [h2]
      · simp [fracZ_one]
      · rfl

theorem subT_eval (N : ℕ) : (subT m).map (·.eval N) = subSteps (Q := N) m := by
  simp only [subT, subSteps, List.map_map]
  refine List.map_congr_left fun j _ => ?_
  simp [dhT_eval]

theorem flipT_eval (N : ℕ) : (flipT m).map (·.eval N) = flipSteps (Q := N) m := by
  simp only [flipT, flipSteps, List.map_map]
  refine List.map_congr_left fun j _ => ?_
  simp [dhT_eval]

theorem dhT_ok {N Bb : ℕ} (hN : 1 ≤ N) (neg : Bool) (cc : ℤ) (j : Fin m)
    (hB : zsz ((ctrlBnd cc 1 N : ℕ) : ℤ) ≤ Bb) (hB0 : zsz ((ctrlBnd 0 1 N : ℕ) : ℤ) ≤ Bb) :
    TOK (dhT neg cc j) N Bb := by
  refine ⟨le_rfl, hN, le_rfl, hN, Nat.coprime_one_right _, Nat.coprime_one_right _, ?_⟩
  intro l _
  simp only [dhT]
  split_ifs
  · exact ⟨le_rfl, Nat.coprime_one_right _, hB⟩
  · exact ⟨le_rfl, Nat.coprime_one_right _, hB0⟩

end NLogN.KIL

end

