theorem edgeCF_runs {m N : ℕ} {sh : Shape} (Λ : Layout sh (m + m) N) (j0 : Fin Pp)
    (G0 : Fin HS → List Item) (cS : TSh m → ℕ) (cC : ℕ)
    (child : Fin (m + m) → Fin (m + m) → List (ZMod 2) → List (ZMod 2)) :
    ∀ Ts : List (TStep m),
    (∀ T, TStep.sh T ∈ Ts → ∀ (t : IState HS) (R : List Item) (ys : List (ZMod 2)), NLogN.KIL.Inv G0 t →
      ys.length = vol sh →
      IRuns I iprog (fcode (stepU m rXs T)) (t.upd 0 (ints (enc2 ys) ++ R))
        (t.upd 0 (ints (enc2 ((T.eval N).arr Λ 0 ys)) ++ R)) (cS T)) →
    (∀ a b, TStep.sw a b ∈ Ts → ∀ (t : IState HS) (R : List Item) (ys : List (ZMod 2)),
      NLogN.KIL.Inv G0 t → ys.length = vol sh →
      IRuns I iprog (NLogN.KIL.swC m j0 (a : ℕ) (b : ℕ)) (t.upd 0 (ints (enc2 ys) ++ R))
        (t.upd 0 (ints (enc2 (child a b ys)) ++ R)) cC ∧ (child a b ys).length = vol sh) →
    ∀ (t : IState HS) (R : List Item) (xs : List (ZMod 2)), NLogN.KIL.Inv G0 t → xs.length = vol sh →
      IRuns I iprog (edgeCF m j0 Ts) (t.upd 0 (ints (enc2 xs) ++ R))
        (t.upd 0 (ints (enc2 (runC Λ child 0 (Ts.map (TStep.eval N)) xs)) ++ R))
        (edgeCost cS cC Ts)
  | [], _, _, t, R, xs, _, _ => by
    simpa [edgeCF, KIL.seqL, runC, edgeCost] using
      IRuns.skip (I := I) (iprog := iprog) (t.upd 0 (ints (enc2 xs) ++ R))
  | s :: rest, hS, hC, t, R, xs, ht, hx => by
    have hS' : ∀ T, TStep.sh T ∈ rest → _ := fun T h => hS T (List.mem_cons_of_mem _ h)
    have hC' : ∀ a b, TStep.sw a b ∈ rest → _ := fun a b h => hC a b (List.mem_cons_of_mem _ h)
    have e : runC Λ child 0 ((s :: rest).map (TStep.eval N)) xs =
        runC Λ child 0 (rest.map (TStep.eval N)) (stepC Λ child 0 xs (s.eval N)) := rfl
    cases s with
    | sh T =>
      have h1 := hS T List.mem_cons_self t R xs ht hx
      have h2 := edgeCF_runs Λ j0 G0 cS cC child rest hS' hC' t R ((T.eval N).arr Λ 0 xs) ht
        (by simp [Step.arr])
      have hst : stepC Λ child 0 xs (TStep.eval N (.sh T)) = (T.eval N).arr Λ 0 xs := by
        simp only [TStep.eval, TSh.eval, stepC]
      refine (h1.seq h2).mono' (by rw [e, hst]) ?_
      simp [edgeCost, tCost]; omega
    | sw a b =>
      have h1 := hC a b List.mem_cons_self t R xs ht hx
      have h2 := edgeCF_runs Λ j0 G0 cS cC child rest hS' hC' t R (child a b xs) ht h1.2
      refine (h1.1.seq h2).mono' (by rw [e]; rfl) ?_
      simp [edgeCost, tCost]; omega

end Edge

