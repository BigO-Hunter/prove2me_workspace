open IntMul RS AModel AModelL12 AModelFac

theorem pull_enc2 (sh sh' : Shape) (g : List ℕ → List ℕ) (xs : List (ZMod 2)) :
    AModel.pull sh sh' g 0 (enc2 xs) = enc2 (AModel.pull sh sh' g 0 xs) := by
  simp only [AModel.pull, enc2, List.map_map]
  refine List.map_congr_left fun j _ => ?_
  simp only [Function.comp]
  rw [show (0 : ℤ) = (((0 : ZMod 2).val : ℕ) : ℤ) by simp, List.getD_map]

theorem arr_enc2 {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) (s : Step n Q) (xs : List (ZMod 2)) :
    s.arr Λ 0 (enc2 xs) = enc2 (s.arr Λ 0 xs) := pull_enc2 _ _ _ _

theorem runArr_enc2 {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) :
    ∀ (steps : List (Step n Q)) (xs : List (ZMod 2)),
      AModel.runArr Λ 0 steps (enc2 xs) = enc2 (AModel.runArr Λ 0 steps xs)
  | [], _ => rfl
  | s :: rest, xs => by
    simp only [AModel.runArr, List.foldl_cons] at *
    rw [arr_enc2]; exact runArr_enc2 Λ rest _

theorem rowSplit_enc2 {W : ℕ} (P L : ℕ) (rest : Shape) (w : Fin W) (xs : List (ZMod 2)) :
    rowSplit P W L rest w 0 (enc2 xs) = enc2 (rowSplit P W L rest w 0 xs) := pull_enc2 _ _ _ _

theorem rowMerge_enc2 {W : ℕ} [NeZero W] (P L : ℕ) (rest : Shape) (s : Fin W → List (ZMod 2)) :
    rowMerge P W L rest 0 (fun w => enc2 (s w)) = enc2 (rowMerge P W L rest 0 s) := by
  simp only [rowMerge, enc2, List.map_map]
  refine List.map_congr_left fun j _ => ?_
  simp only [Function.comp]
  rw [show (0 : ℤ) = (((0 : ZMod 2).val : ℕ) : ℤ) by simp, List.getD_map]

section Runner

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

theorem bnd_enc2 (xs : List (ZMod 2)) {Bb : ℕ} (hB : 1 ≤ Bb) : Bnd Bb (enc2 xs) :=
  bits_bnd (NLogN.KIL.bits_enc2 xs) hB

end Runner

/-- The concatenated streams as a table. -/
theorem flatMap_finRange_tabR {W : ℕ} (s : Fin W → List ℤ) :
    (List.finRange W).flatMap s = tabR 0 W (liftF [] s) := by
  rw [flatMap_finRange, tabR, ← List.range_eq_range']
  rfl

theorem encK_single (s : IState HS) (L : List ℤ) :
    NLogN.KIL.encK s (Function.update (fun _ => []) 0 L) = s.upd 0 (ints L ++ s.G 0) := by
  refine IState.ext' (fun j => ?_) (by simp [NLogN.KIL.encK]) (by simp [NLogN.KIL.encK])
  by_cases h : j = 0
  · subst h; simp
  · simp [h]

theorem upd_as_encK (t : IState HS) (L : List ℤ) (R : List Item) :
    t.upd 0 (ints L ++ R) = NLogN.KIL.encK (t.upd 0 R) (Function.update (fun _ => []) 0 L) := by
  rw [encK_single]; simp

theorem ofFn_getD_eq {v : ℕ} (l : List (ZMod 2)) (h : l.length = v) :
    List.ofFn (fun i : Fin v => l.getD (i : ℕ) 0) = l := by
  apply List.ext_getElem (by simp [h])
  intro i h1 h2
  simp only [List.getElem_ofFn]
  rw [List.getD_eq_getElem _ _ h2]

theorem sumS_single {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) {k : ℕ} (hk : k < W) :
    sumS F v [k] = F k := by
  simp only [sumS, List.foldl_cons, List.foldl_nil]
  have hF := hU k hk
  apply List.ext_getElem (by simp [hF.1])
  intro i h1 h2
  rw [List.getElem_zipWith, List.getElem_replicate]
  have := hF.2 _ (List.getElem_mem h2)
  rcases this with h | h <;> rw [h] <;> decide

