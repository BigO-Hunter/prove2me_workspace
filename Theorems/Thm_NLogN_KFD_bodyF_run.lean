namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem goodE_reg {t : IState HS} {Bb : ℕ} {r : Fin HS} (hr : RdOK r) {v : ℤ} {L : List Item}
    (h : t.G r = .int v :: L) (hv : zsz v ≤ Bb) : GoodE t Bb (.reg r) :=
  ⟨rd_reg hr, IState.isInt_of h, by simp only [Ex.Bnd]; rw [IState.top_eq h]; exact hv⟩

theorem eval_reg' {t : IState HS} {r : Fin HS} {v : ℤ} {L : List Item} (h : t.G r = .int v :: L) :
    (Ex.reg r : Ex HS).eval t = v := by simp only [Ex.eval]; rw [IState.top_eq h]

theorem goodE_mul {t : IState HS} {Bb : ℕ} {a b : Ex HS} (ha : GoodE t Bb a) (hb : GoodE t Bb b)
    (hab : zsz (a.eval t * b.eval t) ≤ Bb) : GoodE t Bb (.mul a b) :=
  ⟨fun r hr => by
    simp only [Ex.regs, List.mem_append] at hr
    rcases hr with h | h
    · exact ha.rd r h
    · exact hb.rd r h, ⟨ha.ok, hb.ok⟩, ⟨ha.bnd, hb.bnd, hab⟩⟩

theorem goodE_ndiv {t : IState HS} {Bb : ℕ} {a b : Ex HS} (ha : GoodE t Bb a) (hb : GoodE t Bb b)
    (h0 : 0 ≤ a.eval t) (h1 : 0 < b.eval t) (hab : zsz (a.eval t / b.eval t) ≤ Bb) :
    GoodE t Bb (.ndiv a b) :=
  ⟨fun r hr => by
    simp only [Ex.regs, List.mem_append] at hr
    rcases hr with h | h
    · exact ha.rd r h
    · exact hb.rd r h, ⟨ha.ok, hb.ok, h0, h1⟩, ⟨ha.bnd, hb.bnd, hab⟩⟩

theorem goodE_lit {t : IState HS} {Bb : ℕ} {c : ℤ} (hc : zsz c ≤ Bb) : GoodE t Bb (.lit c) :=
  ⟨by simp [Ex.regs], trivial, by simpa [Ex.Bnd] using hc⟩

theorem pushOK_low {t : IState HS} {Bb : ℕ} (L : List (Fin HS × Ex HS))
    (hL : ∀ p ∈ L, p.1.val < 22) (hg : ∀ p ∈ L, GoodE t Bb p.2) : PushOK t Bb L := by
  intro p hp
  refine ⟨by have := hL p hp; omega, clean_of_rd (hg p hp).rd, ?_, (hg p hp).ok, (hg p hp).bnd⟩
  intro r hr hm
  obtain ⟨q, hq, rfl⟩ := List.mem_map.1 hm
  have h1 := hL q hq
  rcases (hg p hp).rd q.1 hr with h | h
  · rw [h] at h1; exact absurd h1 (by decide)
  · omega

