theorem gatePG_href {σ : Fin HS → Option ℤ} (hσ : OffG σ) {ρ : Fin HS} {L W Z : ℕ}
    (hρ : σ ρ = some (L : ℤ)) (hL : 1 ≤ L) (hZ : zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) :
    ∀ (as : List Atom), (∀ a ∈ as, a.Ok W) → ∀ e : ℕ → ℕ,
      HRef (gateP as e L) (RS.sub σ (gatePG as e ρ)) (as.length * Xp Z)
  | [], _, e => by simpa [gateP, gatePG, RS.sub] using HRef.refl RS.skip
  | a :: as, hok, e => by
    obtain ⟨ht, hs, hts, _⟩ := hok a List.mem_cons_self
    have IH := gatePG_href hσ hρ hL hZ as (fun b hb => hok b (List.mem_cons_of_mem _ hb)) (a.sc e)
    have hz : ∀ j : ℕ, j < W → zsz ((2 * ((j + 1) * L) : ℕ) : ℤ) ≤ Z := fun j hj =>
      le_trans (zsz_natCast_le (by have := Nat.mul_le_mul_right L (show j + 1 ≤ W by omega); omega)) hZ
    simp only [gateP, gatePG, RS.sub, Atom.P]
    refine (HRef.seq (X := Xp Z) ?_ IH).mono (le_of_eq (by simp [List.length_cons]; ring))
    split_ifs with h
    · exact pairWG_href hσ hρ _ _ (sub_zbS hσ _) _ _ Z h hL (hz _ hs)
    · exact pairWG_href hσ hρ _ _ (sub_zbS hσ _) _ _ Z (by omega) hL (hz _ ht)

