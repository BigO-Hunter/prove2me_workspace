      dw ≤ dwStH c DWc (E / c.m) a ∧
      (cc : ℝ) ≤ (chCostH cI a : ℝ) +
        ((MH c : ℝ) + 18 * aK K * (((E / c.m : ℕ) : ℝ) + 1) ^ τ) *
          ((c.Wr * nN (B / c.W) t S0 * Yu r Zr H : ℕ) : ℝ) := by
  set F := E / c.m with hFd
  have hK : 1 ≤ K := by omega
  have hQ : ∀ s, (fun s => Agree σ s) s → Agree σ s := fun s h => h
  have hn : 1 ≤ nN (B / c.W) t S0 := one_le_nN hBn hS
  set P := c.Wr * nN (B / c.W) t S0 * Yu r Zr H with hP
  set Γ : ℝ := 18 * aK K * ((F : ℝ) + 1) ^ τ with hΓ
  have hG0 : (0 : ℝ) ≤ Γ := by have := haK K; positivity
  have hP0 : (0 : ℝ) ≤ (P : ℝ) := by positivity
  obtain ⟨hL1, hb1, hb2, hb4⟩ := nN_boundsW (W := c.Wr) (t := t) hW hS hBn hr
  have hz16r : zsz ((16 * (c.Wr * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ) ≤ Zr := le_trans hz16 hZZ
  have hz2r : zsz ((2 * (c.Wr * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ) ≤ Zr :=
    le_trans (zsz_natCast_le hb2) hz16r
  have hMl : MlocH c.Wr c.A c.m ≤ MH c := MlocH_mono (by omega)
  -- a local step with an `ℕ` bound `MH c · P`
  have loc : ∀ (U : IStmt HS Pp) (e' dw : ℕ) (cost : ℕ → ℕ),
      RImplQ Isym tbl (fun s => Agree σ s) 0 H r (nN (B / c.W) t S0) (stH c.m K e F S0)
        (a.den (chEx (κ := Fin F))) U e' dw cost → (∀ w, w + dw ≤ H → cost w ≤ MH c * P) →
      U = stepH c jL rowC a → e' = eStH c F a → dw ≤ dwloc c.Wr c.A → a.width = none →
      ∃ (dw cc : ℕ), RImplQ Isym tbl (fun s => Agree σ s) 0 H r (nN (B / c.W) t S0)
        (stH c.m K e F S0) (a.den (chEx (κ := Fin F))) (stepH c jL rowC a)
        (eStH c F a) dw (fun _ => cc) ∧
      dw ≤ dwStH c DWc F a ∧ (cc : ℝ) ≤ (chCostH cI a : ℝ) + ((MH c : ℝ) + Γ) * (P : ℝ) := by
    intro U e' dw cost R hc hU he hd hch
    subst hU he
    refine ⟨dw, MH c * P, R.mono (fun w _ hw => hc w hw), ?_, ?_⟩
    · simp only [dwStH, hch, Option.elim]; exact hd
    simp only [chCostH, hch, Option.elim, Nat.cast_zero, zero_add]
    have h1 : (0 : ℝ) ≤ Γ * (P : ℝ) := mul_nonneg hG0 hP0
    rw [Nat.cast_mul, add_mul]
    exact le_add_of_nonneg_right h1
  cases a with
  | gate G =>
    by_cases hat : ∃ as, GAtH c.Wr c.A G as
    · obtain ⟨as, hg⟩ : ∃ as, gAtH c.Wr c.A G = some as := ⟨_, by unfold gAtH; rw [dif_pos hat]⟩
      obtain ⟨hAl, hokA, hts, hG⟩ := gAtH_some hg
      have R := stepH_gate (Isym := Isym) (tbl := tbl) (lo := 0) (hi := H) hN hQ hr hS hBn as hokA
        hts Zr hz2r
      rw [← hG] at R
      refine loc _ _ _ _ R (fun w hw => ?_) (by simp [stepH, hg])
        (by simp [eStH, eLocH, hg]) (dw_gate hAl) rfl
      exact (cost_gateH (m := c.m) hW hn as hAl hokA hw).trans
        (Nat.mul_le_mul_right _ hMl)
    · have hD : ∃ U : Finset (Fin c.Wr),
          G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1 := by
        rcases hok.gate G ha with h | h
        · exact absurd h hat
        · exact h
      obtain ⟨U, hU⟩ := gDiagH_isSome hD
      have hg : gAtH c.Wr c.A G = none := by unfold gAtH; rw [dif_neg hat]
      have hGU := gDiagH_some hU
      have R := stepH_fixG (Isym := Isym) (tbl := tbl) (Q := fun s => Agree σ s) (lo := 0) (hi := H)
        hN hQ hm hF hW hr hS hBn hK hKe het Zr hz16r hze hzu U
      rw [← hGU] at R
      have he0 : ((negSteps (m := c.m) U.toList).map (fun _ => 0)).sum = 0 := by simp
      rw [he0] at R
      have hlen : (negSteps (m := c.m) U.toList).length ≤ c.Wr := by
        simp only [negSteps, List.length_map, Finset.length_toList]
        exact (Finset.card_le_univ U).trans (le_of_eq (Fintype.card_fin _))
      refine loc _ _ _ _ R (fun w hw => (cost_fixGH (A := c.A) hW hS hBn hz3 U hw).trans
        (Nat.mul_le_mul_right _ hMl)) (by simp [stepH, hg, hU])
        (by simp [eStH, eLocH, hg]) (dw_diag _ hlen) rfl
  | rowAdd w i j hij =>
    obtain ⟨cost, R, hcost⟩ := stepH_row (lo := 0) (hi := H) hRow hG24 hN hQ le_rfl hm hF hW hK6 hr
      Z hZG hGK hS hBn hKe het hdB hdS hz16 Zr hzrow hGz w i j hij
    set Rb : ℝ := aK K * ((nN (B / c.W) t S0 : ℕ) : ℝ) *
      ((r : ℝ) * (H + 1) * ((F : ℝ) + 1) ^ τ + (KFR.PsiR r Z H : ℝ))
    refine ⟨_, ⌊Rb⌋₊ + MH c * P, R.mono (fun x _ hx => ?_), ?_, ?_⟩
    · have h1 := cost_rowH (A := c.A + gsSz c + 6) (m := c.m) (t := t) (r := r) (Z := Z) (Zr := Zr)
        (H := H) (x := x) hW hZZ hS hBn cost (by omega)
      have h2 : cost x ≤ ⌊Rb⌋₊ := Nat.le_floor (hcost x (by omega))
      unfold MH; rw [hP]
      omega
    · simp only [dwStH, HStep.width, Option.elim]
      exact dw_loc0
    · simp only [chCostH, HStep.width, Option.elim, Nat.cast_zero, zero_add]
      have h1 : (⌊Rb⌋₊ : ℝ) ≤ Rb := Nat.floor_le (by have := haK K; positivity)
      have h2 : Rb ≤ Γ * ((nN (B / c.W) t S0 * Yu r Z H : ℕ) : ℝ) := rowB_leH (haK K) hτ hHZ
      have h3 : ((nN (B / c.W) t S0 * Yu r Z H : ℕ) : ℝ) ≤ (P : ℝ) := by
        have : nN (B / c.W) t S0 * Yu r Z H ≤ P := by
          rw [hP, mul_assoc c.Wr]
          exact le_trans (Nat.mul_le_mul_left _ (yu_monoZ hZZ)) (Nat.le_mul_of_pos_left _ hW)
        exact_mod_cast this
      have h4 := mul_le_mul_of_nonneg_left h3 hG0
      rw [Nat.cast_add, Nat.cast_mul, add_mul]
      linarith
  | phase w k0 k1 a =>
    have R := stepH_phase (Isym := Isym) (tbl := tbl) (Q := fun s => Agree σ s) (lo := 0) (hi := H)
      hN hQ hm hF hW hr hS hBn hK hKe het Zr hz16r hze hzu w k0 k1 a
    have hv : zsz ((((k0 + k1 * F) % 4 : ℕ) : ℤ)) ≤ Zr := by
      have : ((k0 + k1 * F) % 4 : ℕ) < 2 ^ 3 := by
        have := Nat.mod_lt (k0 + k1 * F) (show 4 > 0 by norm_num); omega
      have := zszN_lt this
      omega
    have hsz : (εTab vE vK vF wF (List.ofFn a)).size ≤ 12 * c.m + 27 := by
      rw [εTab_size, List.length_ofFn]; exact le_of_eq (by ring)
    refine loc _ _ _ _ R (fun x hx => le_trans (cost_phaseH hW hS hBn _ hv _ hsz ?_)
      (Nat.mul_le_mul_right _ ((MphH_le _ _ _).trans hMl))) rfl rfl dw_loc0 rfl
    rw [zero_add, zero_add] at hx; exact hx
  | perm π =>
    have R := stepH_perm (Isym := Isym) (tbl := tbl) (Q := fun s => Agree σ s) (lo := 0) (hi := H)
      hN hQ hr hS hBn π Zr hz2r
    exact loc _ _ _ _ R (fun x hx => cost_permH (A := c.A + gsSz c + 6) (m := c.m) hW hn π
      (by rw [add_zero] at hx; exact hx)) rfl rfl (Nat.zero_le _) rfl
  | child w S neg =>
    obtain ⟨rfl, hS', hs⟩ := hok.child w S neg ha
    generalize hsd : S.card = s at hS' hs
    subst hS'
    have hcard : (pref c.m s).card = s := card_pref hs.le
    have R := stepH_child (Isym := Isym) (tbl := tbl) (Q := fun s => Agree σ s) (lo := 0) (hi := H)
      hN hQ le_rfl hA hp hm hW hr hS hBn Zr hz2r M Zr hM hMZ s hs hj w (DWc s) (fun _ => cI s)
      (IH s hs)
    have hsF : s * F ≤ E := by
      have h1 : s * F ≤ c.m * F := Nat.mul_le_mul_right _ (by omega)
      have h2 : c.m * F ≤ E := Nat.mul_div_le E c.m
      omega
    have hGs : c.G (s * F) ≤ c.G E := Gs_mono hA hp hsF
    have hGM : c.G (s * F) ≤ M := by
      have h1 := Gs_le_pow (m := c.m) (x := s * F) hA hp
      have h2 : (s * F + 1) ^ c.p ≤ (E + 1) ^ c.p := Nat.pow_le_pow_left (by omega) _
      have h3 : c.Aw * (s * F + 1) ^ c.p ≤ c.Aw * (E + 1) ^ c.p := Nat.mul_le_mul_left _ h2
      show Gs c.Aw c.p c.m (s * F) ≤ M
      omega
    refine ⟨DWc s + (c.G (s * F) + 2) * c.Wr, cI s + MH c * P, ?_, ?_, ?_⟩
    · have e1 : stepH c jL rowC (HStep.child w (pref c.m s) ∅) =
          withPushI (childFrH c s) (wrapQ c.Wr w.val wL wP (.call jL)) := by
        simp only [stepH, hcard]
      have e2 : eStH c F (HStep.child w (pref c.m s) ∅) = c.G (s * F) := by
        simp only [eStH, hcard]
      rw [e1, e2]
      refine R.mono (fun x _ hx => ?_)
      have := cost_childH (c := c) (A := c.A + gsSz c + 6) (m := c.m) (Z := Zr) (Zr := Zr)
        (G := c.G (s * F)) (DWc := DWc s) (x := x) (cI := cI s) (t := t) (S0 := S0) (Bn := B / c.W)
        (r := r) (H := H) hW le_rfl hS hBn (by omega) (by omega)
        (le_trans (zsz_natCast_le hGM) hMZ) hZr hx
      unfold MH; rw [hP]
      exact this
    · simp only [dwStH, HStep.width, Option.elim, hcard]; exact le_rfl
    · simp only [chCostH, HStep.width, Option.elim, hcard]
      have h1 : (0 : ℝ) ≤ Γ * (P : ℝ) := mul_nonneg hG0 hP0
      rw [Nat.cast_add, Nat.cast_mul, add_mul]
      linarith

end Step

