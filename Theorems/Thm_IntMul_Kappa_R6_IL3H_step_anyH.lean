theorem writes_gateUH (W' : ℕ) (as : List KFG.Atom) : ∀ j ∈ (gateUH W' as).writes, j ∈ gT := by
  intro j hj
  simp only [gateUH, RS.writes, List.mem_append] at hj
  rcases hj with h | h
  · exact gatePG_gT _ _ _ j h
  · exact gatePG_gT _ _ _ j h

/-- **A gate of atoms** on the node roles. -/
theorem stepH_gate (hN : NodeRH c σ K t S0 r H E e B) (hQ : ∀ s, Q s → Agree σ s)
    (hr : 1 ≤ r) (hS : 1 ≤ S0) (hBn : 1 ≤ B / c.W) (as : List KFG.Atom)
    (hok : ∀ a ∈ as, a.Ok c.Wr ∧ a.h ≤ 1) (hts : KFG.NoTS as) (Z : ℕ)
    (hZ : zsz ((2 * (c.Wr * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ) ≤ Z) :
    RImplQ Isym tbl Q lo hi r (nN (B / c.W) t S0) (stH c.m K e (E / c.m) S0)
      ((RStep.gate (KFG.gateMat c.Wr as) : RStep (Fin c.Wr) c.m).den (1 : Op (Fin (E / c.m))))
      (fcode (gateUH c.Wr as)) (gδ as) (3 * as.length + 3 * c.Wr)
      (fun w => 400 * (cGateC c.Wr (nN (B / c.W) t S0 * r) Z as.length w + xGateH c.Wr as Z)) := by
  have hn := one_le_nN (t := t) hBn hS
  have hL1 : 1 ≤ nN (B / c.W) t S0 * r := Nat.mul_le_mul hn hr
  have hok' : ∀ a ∈ as, a.Ok c.Wr := fun a ha => (hok a ha).1
  obtain ⟨lok, lts, lc, llen⟩ := levOf_props hok
  have hO : HRef (KFN.gateC c.Wr (nN (B / c.W) t S0 * r) as) (RS.sub σ (gateUH c.Wr as))
      (xGateH c.Wr as Z) := by
    unfold KFN.gateC gateUH xGateH
    simp only [RS.sub]
    exact HRef.seq (gatePG_href hN.lev.off hN.gL hL1 hZ as hok' _)
      (gatePG_href hN.lev.off hN.gL hL1 hZ _ (fun a ha => (lok a ha).1) _)
  exact rImplQ_leaf (rImpl_gate (1 : Op (Fin (E / c.m))) as hok hts (by omega) _ Z hZ) hN.cl
    (NoW.of_gT hN.lev.off (writes_gateUH c.Wr as)) hO (fok_gateC _ _ as) hQ hN.zero

/-- **A role permutation** on the node roles. -/
theorem stepH_perm (hN : NodeRH c σ K t S0 r H E e B) (hQ : ∀ s, Q s → Agree σ s)
    (hr : 1 ≤ r) (hS : 1 ≤ S0) (hBn : 1 ≤ B / c.W) (π : Equiv.Perm (Fin c.Wr)) (Z : ℕ)
    (hZ : zsz ((2 * (c.Wr * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ) ≤ Z) :
    RImplQ Isym tbl Q lo hi r (nN (B / c.W) t S0) (stH c.m K e (E / c.m) S0)
      ((RStep.perm π : RStep (Fin c.Wr) c.m).den (1 : Op (Fin (E / c.m))))
      (fcode (swapsG wL (permSw π))) 0 0
      (fun w => 400 * ((c.Wr * cAtom w 0 (nN (B / c.W) t S0 * r) c.Wr Z + 1) +
        (permSw π).length * Xp Z)) := by
  have hn := one_le_nN (t := t) hBn hS
  have hL1 : 1 ≤ nN (B / c.W) t S0 * r := Nat.mul_le_mul hn hr
  exact rImplQ_leaf (rImpl_perm (1 : Op (Fin (E / c.m))) π (by omega) _ Z hZ) hN.cl
    (NoW.of_gT hN.lev.off (swapsG_gT _ _))
    (swapsG_href hN.lev.off hN.gL hL1 hZ _ (permSw_spec π).2.1) (fok_swapsP _ _) hQ hN.zero

theorem slaws_nodeH {m K e F t S0 Bn : ℕ} (hK : 1 ≤ K) (hKe : K * (F * m - 1) ≤ e)
    (hF : 1 ≤ F) (het : e - e % K + K ≤ t) : SLaws (stH m K e F S0) (nN Bn t S0) := by
  unfold stH
  exact slaws_pow (IL3F.posR m K e F) (IL3F.posR_inj' hK hF hKe) t S0 Bn (posRH_lt hK het)

/-- **A `±1` role diagonal** as phase steps. -/
theorem stepH_fixG (hN : NodeRH c σ K t S0 r H E e B) (hQ : ∀ s, Q s → Agree σ s)
    (hm : 1 ≤ c.m) (hF : 1 ≤ E / c.m) (hW : 1 ≤ c.Wr)
    (hr : 1 ≤ r) (hS : 1 ≤ S0) (hBn : 1 ≤ B / c.W) (hK : 1 ≤ K)
    (hKe : K * (c.m * (E / c.m) - 1) ≤ e) (het : e - e % K + K ≤ t) (Z : ℕ)
    (hZ : zsz ((16 * (c.Wr * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ) ≤ Z)
    (hZe : zsz ((e + t + K + c.m * (E / c.m) + E / c.m : ℕ) : ℤ) ≤ Z)
    (hZu : zsz ((6 * (E / c.m) + 6 : ℕ) : ℤ) ≤ Z) (U : Finset (Fin c.Wr)) :
    RImplQ Isym tbl Q lo hi r (nN (B / c.W) t S0) (stH c.m K e (E / c.m) S0)
      ((RStep.gate (Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1) :
        RStep (Fin c.Wr) c.m).den (1 : Op (Fin (E / c.m))))
      (seqLQ phStepH (negSteps (m := c.m) U.toList))
      ((negSteps (m := c.m) U.toList).map (fun _ => 0)).sum
      ((negSteps (m := c.m) U.toList).map (fun _ => 0 + (0 + 2) * c.Wr)).sum
      (costL (phCostFH c.Wr c.m Z (B / c.W) t S0 r (E / c.m)) (fun _ => 0 + (0 + 2) * c.Wr)
        (negSteps (m := c.m) U.toList)) := by
  have hKe' : K * ((E / c.m) * c.m - 1) ≤ e := by rw [Nat.mul_comm (E / c.m)]; exact hKe
  have hsl := slaws_nodeH (S0 := S0) (Bn := B / c.W) hK hKe' hF het
  have H := rImplQ_list (I := Isym) (iprog := tbl) (Q := Q) (lo := lo) (hi := hi) hsl
    (1 : Op (Fin (E / c.m))) phStepH (fun _ => 0)
    (fun _ => 0 + (0 + 2) * c.Wr) (phCostFH c.Wr c.m Z (B / c.W) t S0 r (E / c.m))
    (negSteps U.toList)
    (fun a ha => by
      obtain ⟨w, hw, rfl⟩ := List.mem_map.1 ha
      exact stepH_phase hN hQ hm hF hW hr hS hBn hK hKe het Z hZ hZe hZu w 2 0 0)
  rw [denListR_negSteps _ _ (Finset.nodup_toList U)] at H
  rw [den_gate_diag]
  exact H

