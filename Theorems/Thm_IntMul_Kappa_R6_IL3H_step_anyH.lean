theorem gAtH_some {W' A : ℕ} {G : Matrix (Fin W') (Fin W') ℂ} {as : List KFG.Atom}
    (h : gAtH W' A G = some as) : GAtH W' A G as := by
  unfold gAtH at h
  split_ifs at h with hh
  · cases h; exact Classical.choose_spec hh

theorem gDiagH_some {W' : ℕ} {G : Matrix (Fin W') (Fin W') ℂ} {U : Finset (Fin W')}
    (h : gDiagH W' G = some U) : G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1 := by
  unfold gDiagH at h
  split_ifs at h with hh
  · cases h; exact Classical.choose_spec hh

theorem gDiagH_isSome {W' : ℕ} {G : Matrix (Fin W') (Fin W') ℂ}
    (h : ∃ U : Finset (Fin W'), G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1) :
    ∃ U, gDiagH W' G = some U := by
  unfold gDiagH
  rw [dif_pos h]
  exact ⟨_, rfl⟩

