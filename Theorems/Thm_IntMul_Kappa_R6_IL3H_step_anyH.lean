theorem MphH_le (W A m : ℕ) : MphH W m ≤ MlocH W A m := by
  unfold MphH MlocH
  have h : W + 3 ≤ (W + A + 10) ^ 2 :=
    le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + A + 10))
  have := Nat.mul_le_mul_left (10 ^ 12 * (12 * m + 30)) h
  have e : 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 =
      10 * (10 ^ 12 * (12 * m + 30) * (W + A + 10) ^ 2) := by ring
  rw [e]; omega

theorem MlocH_mono {W A A' m : ℕ} (h : A ≤ A') : MlocH W A m ≤ MlocH W A' m := by
  unfold MlocH
  exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 2)

/-- **A permutation of the roles.** -/
theorem cost_permH {W A m n r Z H x : ℕ} (hW : 1 ≤ W) (hn : 1 ≤ n) (π : Equiv.Perm (Fin W))
    (hx : x ≤ H) :
    400 * ((W * cAtom x 0 (n * r) W Z + 1) + (permSw π).length * Xp Z) ≤
      MlocH W A m * ((W * n) * Yu r Z H) := by
  have hl := (permSw_spec π).1
  unfold MlocH
  generalize (permSw π).length = q at hl ⊢
  have h1 := cAtom_Y (r := r) (Z := Z) (H := H) (x := x) (D := 0) hW hn (by omega)
  have h3 := xp_Y r Z H
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set P := W * n * Y with hP
  have hYP : Y ≤ P := Nat.le_mul_of_pos_left _ (by omega)
  have e1 : 1000000 * (W * n) * Y = 1000000 * P := by rw [hP]; ring
  rw [e1] at h1
  have k1 : W * cAtom x 0 (n * r) W Z ≤ W * (1000000 * P) := Nat.mul_le_mul_left _ h1
  have k3 : q * Xp Z ≤ W * (90000000 * P) := Nat.mul_le_mul hl (h3.trans (Nat.mul_le_mul_left _ hYP))
  have k4 : 400 * ((W * cAtom x 0 (n * r) W Z + 1) + q * Xp Z) ≤ (4 * 10 ^ 10 * (W + 1)) * P := by
    have : 1 ≤ P := le_trans (by omega) hYP
    have e : (4 * 10 ^ 10 * (W + 1)) * P = 4 * 10 ^ 10 * (W * P) + 4 * 10 ^ 10 * P := by ring
    have e3 : W * (1000000 * P) = 1000000 * (W * P) := by ring
    have e4 : W * (90000000 * P) = 90000000 * (W * P) := by ring
    omega
  refine k4.trans (Nat.mul_le_mul_right _ ?_)
  have h5 : W + 1 ≤ (W + A + 10) ^ 2 :=
    le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + A + 10))
  calc 4 * 10 ^ 10 * (W + 1) ≤ 10 ^ 13 * 1 * (W + A + 10) ^ 2 := by
        have := Nat.mul_le_mul_left (4 * 10 ^ 10) h5
        nlinarith
    _ ≤ 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_left; omega

/-- **The row wrapper** with the data size `Z` and the register size `Zr`. -/
theorem cost_rowH {W A m Bn t S0 r Z Zr H x : ℕ} (hW : 1 ≤ W) (hZZ : Z ≤ Zr) (hS : 1 ≤ S0)
    (hBn : 1 ≤ Bn) (cost : ℕ → ℕ) (hx : x + 2 * W ≤ H) :
    cWrapQ W (nN Bn t S0 * r) Z 0 0
      (fun x => cFrame 13 1 Zr + cost x + (13 * (2 * Zr + 2) + 1)) x ≤
      cost x + MlocH W A m * ((W * nN Bn t S0) * Yu r Zr H) := by
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have h1 := cWrapQ_Y (r := r) (Z := Z) (H := H) (e := 0) (dw := 0) (x := x) hW hn
    (fun x => cFrame 13 1 Zr + cost x + (13 * (2 * Zr + 2) + 1)) (by omega)
  have hF := cFrame_Y 13 1 r Zr H
  have hYm : Yu r Z H ≤ Yu r Zr H := yu_monoZ hZZ
  refine h1.trans ?_
  unfold MlocH
  set n := nN Bn t S0
  set Y := Yu r Zr H
  have hY8 := yu_8 r Zr H
  have h5 := yu_z1 r Zr H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  have hYP : Y ≤ W * n * Y := Nat.le_mul_of_pos_left _ (by omega)
  have hPm : W * n * Yu r Z H ≤ W * n * Y := Nat.mul_le_mul_left _ hYm
  set P := W * n * Y with hP
  have hPm' : 10 ^ 12 * (W + 2) * (W * n * Yu r Z H) ≤ 10 ^ 12 * (W + 2) * P :=
    Nat.mul_le_mul_left _ hPm
  have k : 13 * (1 + 1) * 10 ^ 8 * Y + 1 + (13 * (2 * Zr + 2) + 1) +
      10 ^ 12 * (W + 2) * P ≤ 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 * P := by
    have a : (W + 2) + 1 ≤ (W + A + 10) ^ 2 :=
      le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + A + 10))
    have b : 10 ^ 12 * ((W + 2) + 1) * P ≤ 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 * P := by
      apply Nat.mul_le_mul_right
      have : 10 ^ 12 * ((W + 2) + 1) ≤ 10 ^ 12 * (W + A + 10) ^ 2 := Nat.mul_le_mul_left _ a
      have : 10 ^ 12 * (W + A + 10) ^ 2 ≤ 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 :=
        Nat.mul_le_mul_right _ (by omega)
      omega
    have e : 10 ^ 12 * ((W + 2) + 1) * P = 10 ^ 12 * (W + 2) * P + 10 ^ 12 * P := by ring
    omega
  omega

end IntMul.Kappa.R6.IL3H

