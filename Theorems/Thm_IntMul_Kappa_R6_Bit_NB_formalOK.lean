  rw [Φ₁, show cHIGH = 1 from rfl, Pc_high, pswQ_mul, K_mul hSi, Matrix.one_mul, Matrix.sub_mul,
    Pl_idem hb, Matrix.one_mul, sub_self, K_zero_right, mul_zero, sub_zero, ← K_add_right,
