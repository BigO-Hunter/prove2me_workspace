      have ew : (.inl ⟨3136441 + a * 1771 + s, hg⟩ : Wr) = ι2 a (wX s) := by rw [ι2x_eq ha hs]
      rw [eρ, (l2 a ha s hs).1, (s1 a ha s hs).1, ← ew]
      have hφ : φ0 ch N (.inl ⟨3136441 + a * 1771 + s, hg⟩) = Finsupp.single (1, ⟨3136441 + a * 1771 + s, hg⟩) 1 := by
