variable {R : Type*} [CommRing R] {U : Type*} {m N : ℕ}

lemma lmulF_one (φ : FV R U m N) : lmulF 1 φ = φ := by
  simp only [lmulF, Finsupp.lmapDomain_apply, one_mul]
  exact Finsupp.mapDomain_id

lemma lmulF_single (L F : FMat m N) (u : U) (c : R) :
    lmulF L (Finsupp.single (F, u) c) = Finsupp.single (L * F, u) c := by
  simp [lmulF, Finsupp.mapDomain_single]

end Formal

