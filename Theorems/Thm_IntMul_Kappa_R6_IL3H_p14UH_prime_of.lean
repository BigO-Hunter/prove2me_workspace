/-- **All level claims.** -/
theorem lvAllH {c : Cfg} (hc : CfgOK c) {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
    {jL : Fin Pp} {rowC : IStmt HS Pp} (hj : tbl jL = levCH c jL rowC) {τ Kc θ Cc : ℝ}
    (hRow : RowUCC c.m τ Isym tbl rowC Kc) (hKc : 0 ≤ Kc) (hτ0 : 0 ≤ τ) (hτθ : τ ≤ θ)
    (hCc0 : 0 ≤ Cc)
    (hCc : ((chWs c).length : ℝ) * (10 ^ 14 * (2 * c.m + 1)) + 18 * c.Wr * c.net.length * 2 ^ τ +
      C1H c ≤ Cc * ((c.W : ℝ) - momH c θ))
    {P K D S r p w Z : ℕ} {lamp : ℝ} (h : Hyp14 c P K D S r p w Z lamp) :
    ∀ E, LvH c Isym tbl jL rowC K r (Zl c P K D S r w) (3 * Z) (w + EwH c D)
      (Gv czH (Zl c P K D S r w)) (CBc c Kc (Gv czH (Zl c P K D S r w)) Cc θ) E := by
  obtain ⟨hG1, -, -⟩ := Gv_spec czH (Zl c P K D S r w) (by decide)
  have hR := hRow _ hG1
  have haK : ∀ K', (0 : ℝ) ≤ (fun _ : ℕ => Kc * ((Gv czH (Zl c P K D S r w) : ℕ) + 2) + 1) K' :=
    fun _ => by positivity
  have hCB := cbRec_of hc (aK := fun _ : ℕ => Kc * ((Gv czH (Zl c P K D S r w) : ℕ) + 2) + 1)
    (K := K) (haK K) hτ0 hτθ Cc (10 ^ 14 * (2 * c.m + 1)) hCc0 rfl hCc
  have hWr := h.Wr_le_Zc
  have hZcZ := h.Zc_lt_Z
  have hZl := h.Zl_le_Z hc
  have hGz : zsz ((Gv czH (Zl c P K D S r w) : ℕ) : ℤ) ≤ 3 * Z :=
    le_trans (zsz_natCast_le_self _) (h.G_le_Z hc)
  have hZr : 3 * Z + 2 ≤ r := by
    have := h.rZ
    have : 2 * Z + 4 ≤ (2 * Z + 4) ^ 3 := Nat.le_self_pow (by norm_num) _
    omega
  have hHZ := (zl_spec c P K D S r w h.P1 h.S1 h.r1 (h.Wr1 hc)).2
  exact lvH_all hc hR haK hτ0 hj h.K6 h.r1 h.guardG (h.guardK hc) hGz (by omega) hZr hHZ
    (by omega) hCB

