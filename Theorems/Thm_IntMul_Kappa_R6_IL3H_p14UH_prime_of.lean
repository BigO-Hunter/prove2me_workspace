theorem VbH_top (hc : CfgOK c) {ρ : ℕ} (hρ : ρ < K) :
    zsz ((VbH c K (K * D) S r (chV c (cWc c) P K D S r w).H 1 (ρ + K * (D - 1)) P : ℕ) : ℤ) ≤
      3 * Z := by
  apply zsz_nat_le_of_lt
  have hN := h.N_lt
  obtain ⟨b1, b2, b3, b4, b5⟩ := layer_bounds (K := K) (D := D) h.S1 h.P1 h.r1
  have hK := h.K_le_KD
  have hH := h.H_lt
  have hA := Ap_le hc 1
