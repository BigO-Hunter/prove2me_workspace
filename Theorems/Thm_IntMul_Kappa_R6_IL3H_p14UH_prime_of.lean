/-- The first field-width guard. -/
theorem guardG : 4 * Zl c P K D S r w * (Zl c P K D S r w + 2) ≤ 2 ^ Gv czH (Zl c P K D S r w) := by
  obtain ⟨-, h2, -⟩ := Gv_spec czH (Zl c P K D S r w) (by decide)
  unfold gBnd czH at h2
  nlinarith

/-- The second field-width guard. -/
theorem guardK (hc : CfgOK c) :
    16 * Zl c P K D S r w * (Zl c P K D S r w + 2) * 2 ^ Gv czH (Zl c P K D S r w) ≤ 2 ^ K := by
  obtain ⟨-, -, h3⟩ := Gv_spec czH (Zl c P K D S r w) (by decide)
  have hZl := h.Zl_le_p hc
  set z := Zl c P K D S r w with hz
  set q := p + K0c c with hq
  have hK0 : c.Wr + 2048 ≤ K0c c := by
    have := K0_ge c
    have : c.Wr + 64 ≤ Zc c := by unfold Zc; omega
    omega
  have hz3 : z + 3 ≤ 2 * q := by omega
  have hq2 : 2048 ≤ q := by omega
  unfold gBnd czH at h3
  have a : 16 * z * (z + 2) * 2 ^ Gv czH z ≤ 16 * (z + 3) * (z + 3) * (8 * (z + 3) * (z + 3)) := by
    have b1 : 2 ^ Gv czH z ≤ 8 * (z + 3) * (z + 3) := by nlinarith
    have b2 : 16 * z * (z + 2) ≤ 16 * (z + 3) * (z + 3) := by nlinarith
    exact Nat.mul_le_mul b2 b1
  have b : 16 * (z + 3) * (z + 3) * (8 * (z + 3) * (z + 3)) ≤ 2048 * q ^ 4 := by
    have := Nat.pow_le_pow_left hz3 4
    have e : 16 * (z + 3) * (z + 3) * (8 * (z + 3) * (z + 3)) = 128 * (z + 3) ^ 4 := by ring
    rw [e]
    have e2 : (2 * q) ^ 4 = 16 * q ^ 4 := by ring
    omega
  have c' : 2048 * q ^ 4 ≤ q ^ 5 := by
    have : q ^ 5 = q * q ^ 4 := by ring
    rw [this]; exact Nat.mul_le_mul_right _ hq2
  have h2' : q ^ 5 ≤ 2 ^ K := h.h2
  omega

end Hyp14

