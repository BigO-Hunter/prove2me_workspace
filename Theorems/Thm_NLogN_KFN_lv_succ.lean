theorem sum_le_count' {α : Type*} (p : α → Bool) (x y : ℕ) (f : α → ℕ) :
    ∀ l : List α, (∀ a ∈ l, f a ≤ if p a then x else y) →
      (l.map f).sum ≤ l.countP p * x + l.length * y
  | [], _ => by simp
  | a :: l, hf => by
    have ih := sum_le_count' p x y f l (fun b hb => hf b (List.mem_cons_of_mem _ hb))
    have ha := hf a List.mem_cons_self
    simp only [List.map_cons, List.sum_cons, List.countP_cons, List.length_cons]
    split_ifs at ha with hp
    · simp only [hp, if_true]; nlinarith
    · simp only [hp, Bool.false_eq_true, if_false, add_zero]; nlinarith

theorem sum_ite_le' {α : Type*} (p : α → Bool) (x y : ℝ) (hy : 0 ≤ y) (f : α → ℝ) :
    ∀ l : List α, (∀ a ∈ l, f a ≤ if p a then x else y) →
      (l.map f).sum ≤ (l.countP p : ℝ) * x + (l.length : ℝ) * y
  | [], _ => by simp
  | a :: l, hf => by
    have ih := sum_ite_le' p x y hy f l (fun b hb => hf b (List.mem_cons_of_mem _ hb))
    have ha := hf a List.mem_cons_self
    simp only [List.map_cons, List.sum_cons, List.countP_cons, List.length_cons]
    split_ifs at ha with hp
    · simp only [hp, if_true]; push_cast; linarith
    · simp only [hp, Bool.false_eq_true, if_false, add_zero]; push_cast; linarith

section Ind

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {K : ℕ}
variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}

/-- **Every step of the network has an implementation with the step bounds.** -/
theorem step_ok (hGc : GClass J A) (hrow : RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k Ek DWk Wk : ℕ} {ck : ℝ} (IH : Lv Isym iprog K W m r Z Ψ k Ek DWk Wk ck)
    (pos : Fin m × Fin (m ^ k) → ℕ) (hinj : Function.Injective pos) {t S0 B : ℕ}
    (hpos : ∀ p, pos p < t) (haff : AffK2 K t m k pos) (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hdvd : W ^ k ∣ B) (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) (O : ℕ)
    (hO1 : DWk + (Ek + 2) * W + Ek + 4 ≤ O) (hO2 : dwloc W A + 5 ≤ O)
    (a : RStep (Fin W) m) (ha : a ∈ J.net) :
    ∃ (code : ℕ → IStmt HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      RImplI Isym iprog r (nR t S0 B) (fun p => 2 ^ pos p * S0) (a.den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ (if a.isChild then Ek else 1) ∧
      dw ≤ (if a.isChild then DWk + (Ek + 2) * W else dwloc W A) ∧
      ∀ w, (cost w : ℝ) ≤ (if a.isChild then ck * ((nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + Wk) : ℝ)
          else 0) +
        ((alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) * ((W * nR t S0 B : ℕ) : ℝ) *
          (Xf r Ψ (w + O) : ℝ) := by
  have hG0 : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ := mul_nonneg hCR (by positivity)
  have lift : ∀ (cost : ℕ → ℕ),
      (∀ w, cost w ≤ alN W A * (W * nR t S0 B) * Xf r Ψ (w + O)) →
      ∀ w, (cost w : ℝ) ≤ 0 + ((alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) *
        ((W * nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + O) : ℝ) := by
    intro cost hc w
    have h1 : (cost w : ℝ) ≤ (alN W A : ℝ) * ((W * nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + O) : ℝ) := by
      exact_mod_cast hc w
    have h2 : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ * ((W * nR t S0 B : ℕ) : ℝ) *
        (Xf r Ψ (w + O) : ℝ) := by positivity
    rw [zero_add, add_mul, add_mul]; linarith
  cases a with
  | gate G =>
    rcases hGc G ha with ⟨as, hA, hok, hts, rfl⟩ | ⟨U, rfl⟩
    · obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_gate (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
        pos hS hB (zsz_role2 hZ) as hA hok hts O hO2
      exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
        by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
    · obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_fixG (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
        pos hinj hpos hS hB hZ U O hO2
      exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
        by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
  | rowAdd w0 i j hij =>
    obtain ⟨c, e, d, k', R, he, hd, hk⟩ := step_row (A := A) hrow hCR hτ hW hr hΨm hZΨ pos hinj
      hpos haff hS hB hZ w0 i j hij O hO2
    exact ⟨c, e, d, k', R, by simpa [RStep.isChild] using he, by simpa [RStep.isChild] using hd,
      fun w => by simpa [RStep.isChild] using hk w⟩
  | phase w0 k₀ k₁ a =>
    obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_phase (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
      pos hpos hS hB hZ w0 k₀ k₁ a O hO2
    exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
      by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
  | perm σ =>
    obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_perm (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
      pos hS hB (zsz_role2 hZ) σ O hO2
    exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
      by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
  | child w0 h fwd =>
    obtain ⟨c, e, d, k', R, he, hd, hk⟩ := step_child (A := A) IH _ hG0 hW hr hΨm hZΨ pos hinj
      hpos haff hS hB hdvd hZ w0 h fwd O hO1
    exact ⟨c, e, d, k', R, by simpa [RStep.isChild] using he, by simpa [RStep.isChild] using hd,
      fun w => by simpa [RStep.isChild] using hk w⟩

end Ind

