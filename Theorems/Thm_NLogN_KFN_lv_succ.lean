section Wrap

theorem fok_wrapC (W L w e : ℕ) {code : RS} (h : NLogN.KFD.fok code = true) :
    NLogN.KFD.fok (wrapC W L w e code) = true := by
  simp [wrapC, NLogN.KFD.fok, fok_swapsP, fok_gateP, h]

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-- **A stream program on one role.** -/
theorem rImpl_onRole (hW : 0 < W) (w : Fin W) {ι : Type*} [Fintype ι] [DecidableEq ι]
    {r n : ℕ} (hr : 0 < r) (st' : ι → ℕ) (Tw : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) {code : RS}
    {e dw : ℕ} {cost : ℕ → ℕ} (h : SImpl r st' n Tw code e dw cost) (st : Fin m × κ → ℕ)
    (A : ROp (Fin W) m κ)
    (hA : ∀ X : Fin W → List (Fin r → ℂ), (∀ v, (X v).length = n) →
      roleOpF st n A X = Function.update X w (selOpF st' n Tw (X w)))
    (Z : ℕ) (hZ : zsz ((2 * (W * (n * r)) : ℕ) : ℤ) ≤ Z) :
    RImpl r n st A (wrapC W (n * r) w.val e code) e (dw + (e + 2) * W)
      (cWrapR W (n * r) Z e dw cost) := by
  intro s f zs l X F x hC h0 hx hX hb
  set L := n * r with hL
  set o : Fin W := ⟨0, hW⟩
  set σ := Equiv.swap o w with hσ
  have hsw : ∀ v : Fin W, NLogN.KFG.swapsF (NLogN.KFN.swL w.val) v.val = (σ v).val := by
    intro v
    rw [swapsF_swL, hσ, show (0 : ℕ) = o.val from rfl, ← pf_swap]
    simp [pf]
  have hsl : ∀ p ∈ NLogN.KFN.swL w.val, p.1 < p.2 ∧ p.2 < W := by
    intro p hp; unfold NLogN.KFN.swL at hp
    split_ifs at hp with h0
    · simp at hp
    · simp at hp; subst hp; exact ⟨by omega, w.isLt⟩
  have hsl1 : (NLogN.KFN.swL w.val).length ≤ 1 := by unfold NLogN.KFN.swL; split_ifs <;> simp
  -- 1. swap role `w` to the front
  have E0 := enc_of_rec hr hX hx
  obtain ⟨E1, B1, H1⟩ := swaps_fsp s l x Z hZ (NLogN.KFN.swL w.val) hsl (fun _ => F) f zs (yR r X) E0 h0
    hC.p hb
  set zs1 := swapsL L (NLogN.KFN.swL w.val) zs
  set X1 : Fin W → List (Fin r → ℂ) := fun v => X (σ v)
  have hX1 : ∀ v, (X1 v).length = n := fun v => hX _
  have R1 : RecRep r F zs1 (flatR X1) := by
    refine rec_of_enc hr hX1 E1 (fun v j hj c => ?_)
    beta_reduce
    rw [hsw v, yR_val hr X (σ v) j c]
  have hz1 : zs1.length = W * L := E1.1
  -- 2. the program on the first segment
  set seg := zs1.take L
  set rest := zs1.drop L
  have hsplit : zs1 = seg ++ rest := (List.take_append_drop _ _).symm
  have Rs : RecRep r F seg (X1 o) := recRep_take hW hX1 R1
  have hbs : NLogN.KFB.GB x seg := B1.sub fun z hz => List.mem_of_mem_take hz
  have hbr : NLogN.KFB.GB x rest := B1.sub fun z hz => List.mem_of_mem_drop hz
  obtain ⟨seg', r2, b2, f2⟩ := h s (Function.update f 0 (gflat zs1 ++ l)) seg (gflat rest ++ l)
    (X1 o) F x (hC.upd0 _) (by rw [Function.update_self, hsplit, gflat_append, List.append_assoc]) Rs (hX1 o) hbs
  set Y2 : Fin W → List (Fin r → ℂ) := Function.update X1 o (selOpF st' n Tw (X1 o))
  have hY2 : ∀ v, (Y2 v).length = n := by
    intro v; simp only [Y2, Function.update_apply]; split_ifs
    · exact length_selOpF _ _ _ _
    · exact hX1 v
  have hsl' : seg'.length = L := by rw [r2.1, length_selOpF]
  set zs2 := seg' ++ rest
  have E2 : Enc W L (Function.update (fun _ => F) 0 (F + e)) zs2 (yR r Y2) := by
    have := enc_set0 hW (enc_of_rec hr hX1 R1) hsl' (F' := F + e) (y0 := yR r Y2 0)
      (fun p hp => by
        have hpr : p / r < n := by rw [Nat.div_lt_iff_lt_mul hr]; exact hp
        have e1 : p = p / r * r + (⟨p % r, Nat.mod_lt _ hr⟩ : Fin r) := by
          simp only; rw [Nat.div_add_mod']
        conv_lhs => rw [e1]
        rw [r2.2 _ _ (by rw [length_selOpF]; exact hpr)]
        rw [show yR r Y2 0 p = (Y2 o).getD (p / r) 0 ⟨p % r, Nat.mod_lt _ hr⟩ from by
          simp only [yR, dif_pos (And.intro hW hr)]; rfl]
        simp [Y2])
    have hy : Function.update (yR r X1) 0 (yR r Y2 0) = yR r Y2 := by
      funext v p
      by_cases hv : v = 0
      · subst hv; simp
      · rw [Function.update_of_ne hv]
        simp only [yR]
        split_ifs with hh
        · congr 2
          simp only [Y2]
          rw [Function.update_of_ne (fun e => hv (by simpa [o] using congrArg Fin.val e))]
        · rfl
    rw [hy] at this; exact this
  have bz2 : NLogN.KFB.GB (x + dw) zs2 := GB_append.2 ⟨b2, hbr.mono (by omega)⟩
  -- 3. leveling
  set e2 := Function.update (fun _ : ℕ => F) 0 (F + e)
  have e2eq : e2 = shE F (Function.update (fun _ => 0) 0 e) := by
    funext t; by_cases ht : t = 0 <;> simp [e2, shE, ht, Nat.add_comm]
  have he2 : ∀ t, F ≤ e2 t ∧ e2 t ≤ F + e := fun t => by
    simp only [e2, Function.update_apply]; split_ifs <;> omega
  have hs2 : ∀ a ∈ levA W 0, e2 a.s + a.h ≤ F + e := fun a ha => by
    rw [(levA_src a ha).1, (levA_src a ha).2.1]; simp [e2]
  obtain ⟨E3, B3, H3⟩ := gate_fsp s l Z hZ (levA W 0)
    (fun a ha => (levA_ok hW a ha).1) (levA_nots W 0) e2
    (Function.update f 0 (gflat zs2 ++ l)) zs2 (yR r Y2) (x + dw) E2 (by simp) (hC.p.upd0 _) bz2
  rw [gateY_zero (fun a ha => (levA_src a ha).2.2)] at E3
  have E3' := enc_congr_e E3 (gateE_levA hW e2 (by simp [e2]) (fun t => (he2 t).2))
  set zs3 := gateL (levA W 0) e2 L zs2
  have w3 := gateW_le2 F (F + e) (levA W 0) e2 (x + dw) (levA_nots W 0) hs2 he2
  have hlev := levA_len W 0
  -- 4. swap back
  obtain ⟨E4, B4, H4⟩ := swaps_fsp s l (gateW (levA W 0) e2 (x + dw)) Z hZ (NLogN.KFN.swL w.val) hsl
    (fun _ => F + e) (Function.update f 0 (gflat zs3 ++ l)) zs3 (yR r Y2) E3' (by simp)
    (hC.p.upd0 _) B3
  refine ⟨swapsL L (NLogN.KFN.swL w.val) zs3, ?_, ?_, ?_⟩
  · have R4 := rec_of_enc hr (Y := fun v => Y2 (σ v)) (fun v => hY2 _) E4 (fun v j hj c => by
      beta_reduce; rw [hsw v, yR_val hr Y2 (σ v) j c])
    have hfam : (fun v => Y2 (σ v)) = Function.update X w (selOpF st' n Tw (X w)) := by
      funext v
      simp only [Y2, X1, Function.update_apply]
      by_cases hv : v = w
      · subst hv
