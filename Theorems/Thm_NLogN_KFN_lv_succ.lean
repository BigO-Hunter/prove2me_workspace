    (fun p => NLogN.KFN.dvd_pow_lay pos t S0 B' hpos' p) code e dw cost (fun a ha => (hP a ha).1)
  have N' := NLogN.KFN.sImpl_equiv eqv (fun i => 2 ^ pos' i * S0) Butterfly.Cm N
  have hn : W * (B' * 2 ^ t * S0) = B * 2 ^ t * S0 := by rw [hBB]; ring
  rw [hn] at N'
  have hcount : J.net.countP P8Lift.RStep.isChild = s := J.count
  have hdw : (J.net.map dw).sum ≤ s * (DWk + (Ek + 2) * W) + L * NLogN.KFN.dwloc W A := by
    have := NLogN.KFN.sum_le_count' P8Lift.RStep.isChild _ _ dw J.net (fun a ha => (hP a ha).2.2.1)
    rw [hcount] at this; exact this
  refine ⟨_, _, _, _, N', ?_, hdw, fun w => ?_⟩
  · have := NLogN.KFN.sum_le_count' P8Lift.RStep.isChild _ _ e J.net (fun a ha => (hP a ha).2.1)
    rw [hcount] at this; omega
  -- the cost
  set n' := NLogN.KFN.nR t S0 B'
  set DW' := s * (DWk + (Ek + 2) * W) + L * NLogN.KFN.dwloc W A
  set Wh := DW' + O + Wk
  set bd : P8Lift.RStep (Fin W) m → ℕ → ℝ := fun a v =>
    (if a.isChild then ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + Wk) : ℝ) else 0) +
      G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + O) : ℝ)
  have hXm : ∀ a b, a ≤ b → (NLogN.KFN.Xf r Ψ a : ℝ) ≤ (NLogN.KFN.Xf r Ψ b : ℝ) := fun a b h => by
    exact_mod_cast NLogN.KFN.Xf_mono hΨm h
  have hmono : ∀ a, Monotone (bd a) := by
    intro a u v huv
    simp only [bd]
    have h2 : G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (u + O) : ℝ) ≤
        G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + O) : ℝ) :=
      mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
    split_ifs
    · have h1 : ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (u + Wk) : ℝ) ≤ ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + Wk) : ℝ) :=
        mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
      linarith
    · linarith
  have C := NLogN.KFN.costL_le cost dw bd hmono J.net (fun a ha => (hP a ha).2.2.2) w
  set X1 := (NLogN.KFN.Xf r Ψ (w + DW' + Wk) : ℝ)
  set y := G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + DW' + O) : ℝ)
  have hy : 0 ≤ y := by positivity
  have S := NLogN.KFN.sum_ite_le' P8Lift.RStep.isChild (ck * ((n' : ℕ) : ℝ) * X1 + y) y hy
    (fun a => bd a (w + (J.net.map dw).sum)) J.net (fun a ha => by
      simp only [bd]
      have h2 : G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + (J.net.map dw).sum + O) : ℝ) ≤ y :=
        mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
      split_ifs
      · have h1 : ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + (J.net.map dw).sum + Wk) : ℝ) ≤
            ck * ((n' : ℕ) : ℝ) * X1 :=
          mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
        linarith
      · linarith)
  rw [hcount] at S
  -- assemble
  have hXW1 : (1 : ℝ) ≤ (NLogN.KFN.Xf r Ψ (w + Wh) : ℝ) := by
    have : 1 ≤ NLogN.KFN.Xf r Ψ (w + Wh) := by unfold NLogN.KFN.Xf; have := hZΨ (w + Wh); omega
    exact_mod_cast this
  set XW := (NLogN.KFN.Xf r Ψ (w + Wh) : ℝ)
  have hX1 : X1 ≤ XW := hXm _ _ (by omega)
  have hXO : (NLogN.KFN.Xf r Ψ (w + DW' + O) : ℝ) ≤ XW := hXm _ _ (by omega)
  have hn1 : 1 ≤ n' := NLogN.KFN.one_le_nR hS hB'
  have hWr : (W : ℝ) ≠ 0 := by
    have : (1 : ℝ) ≤ W := by exact_mod_cast hW
    linarith
  have hNW : ((B * 2 ^ t * S0 : ℕ) : ℝ) = (W : ℝ) * (n' : ℝ) := by
    have : B * 2 ^ t * S0 = W * n' := by rw [hBB]; simp only [n', NLogN.KFN.nR]; ring
    rw [this]; push_cast; ring
  have hNWn : ((W * n' : ℕ) : ℝ) = (W : ℝ) * (n' : ℝ) := by push_cast; ring
  have hN1 : (1 : ℝ) ≤ (W : ℝ) * (n' : ℝ) := by
    have : 1 ≤ W * n' := Nat.mul_le_mul hW hn1
    exact_mod_cast this
  rw [hNW]
  have hy' : y ≤ G' * ((W : ℝ) * (n' : ℝ)) * XW := by
    simp only [y]; rw [hNWn]
    exact mul_le_mul_of_nonneg_left hXO (by positivity)
  have hs1 : (s : ℝ) * (ck * (n' : ℝ) * X1) ≤ (s / W : ℝ) * ck * ((W : ℝ) * (n' : ℝ)) * XW := by
    have e : (s / W : ℝ) * ck * ((W : ℝ) * (n' : ℝ)) * XW = (s : ℝ) * (ck * (n' : ℝ) * XW) := by
      field_simp
    rw [e]
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    exact mul_le_mul_of_nonneg_left hX1 (by positivity)
  have h1W : (1 : ℝ) ≤ ((W : ℝ) * (n' : ℝ)) * XW := by nlinarith
  have hL : ((L : ℕ) : ℝ) * y ≤ ((L : ℕ) : ℝ) * (G' * ((W : ℝ) * (n' : ℝ)) * XW) :=
    mul_le_mul_of_nonneg_left hy' (by positivity)
  have hS' : (s : ℝ) * y ≤ (s : ℝ) * (G' * ((W : ℝ) * (n' : ℝ)) * XW) :=
    mul_le_mul_of_nonneg_left hy' (by positivity)
  calc (NLogN.KFN.costL cost dw J.net w : ℝ)
      ≤ (J.net.map fun a => bd a (w + (J.net.map dw).sum)).sum + 1 := C
    _ ≤ (s : ℝ) * (ck * ((n' : ℕ) : ℝ) * X1 + y) + (L : ℝ) * y + 1 := by linarith
    _ ≤ ((s / W : ℝ) * ck + ((s + L : ℕ) : ℝ) * G' + 1) * ((W : ℝ) * (n' : ℝ)) * XW := by
      push_cast
      nlinarith
end
