theorem exit_sp {q m k P L W : ℕ} {A B Cs : Shape} (t : IState HS) (R7 : List Item)
    (h7 : t.G dT = ints (towerL q m (k + 1)) ++ R7) (Y : List Item) (Bb : ℕ)
    (hb : ∀ p ∈ entV W m (q ^ m ^ k) P L k A B Cs, zsz p.2 ≤ Bb)
    (zF : zsz ((q ^ m ^ (k + 1) : ℕ) : ℤ) ≤ Bb) :
    Sp (exitU W m) (pushSt ((entS t (q ^ m ^ (k + 1)) (ints (towerL q m k) ++ R7)).upd 0 Y)
      (entV W m (q ^ m ^ k) P L k A B Cs)) (t.upd 0 Y) (cExit W m Bb) := by
  set F := q ^ m ^ (k + 1)
  set u := (entS t F (ints (towerL q m k) ++ R7)).upd 0 Y
  have S1 := Sp.popsR Bb (entV W m (q ^ m ^ k) P L k A B Cs) u (fun p hp => by
    refine ⟨?_, hb p hp⟩
    simp only [entV, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      (dsimp only; decide))
  have hfst : (entV W m (q ^ m ^ k) P L k A B Cs).map Prod.fst = (entL W m).map Prod.fst := rfl
  rw [hfst] at S1
  have uS : u.G NLogN.KIL.rS = .int (F : ℤ) :: t.G rS := by simp +decide [u, entS, IState.upd_G]
  have uT : u.G dT = ints (towerL q m k) ++ R7 := by simp +decide [u, entS, IState.upd_G]
  have g := goodE_reg (t := u) (rd_reg' (r := NLogN.KIL.rS) ⟨by decide, by decide⟩) uS zF
