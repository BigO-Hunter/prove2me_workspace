theorem goodE_add {t : IState HS} {Bb : ℕ} {a b : Ex HS} (ha : GoodE t Bb a) (hb : GoodE t Bb b)
    (hab : zsz (a.eval t + b.eval t) ≤ Bb) : GoodE t Bb (.add a b) :=
  ⟨fun r hr => by
    simp only [Ex.regs, List.mem_append] at hr
    rcases hr with h | h
    · exact ha.rd r h
    · exact hb.rd r h, ⟨ha.ok, hb.ok⟩, ⟨ha.bnd, hb.bnd, hab⟩⟩

theorem powE_reg_regs (r : Fin HS) (n : ℕ) : ∀ r' ∈ (powE (.reg r) n : Ex HS).regs, r' = r := by
  intro r' hr
  obtain ⟨e', he', hr'⟩ := prodE_regs _ r' hr
  rw [List.eq_of_mem_replicate he'] at hr'
  simpa [Ex.regs] using hr'

theorem regs_hdE (m : ℕ) : ∀ r ∈ (hdE m).regs, 46 ≤ r.val ∧ r.val ≤ 52 := by
  intro r hr
  simp only [hdE, Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with h | h | h | h | h
  · subst h; decide
  · rw [powE_reg_regs _ _ r h]; decide
  · subst h; decide
  · rw [powE_reg_regs _ _ r h]; decide
  · subst h; decide

theorem regs_entL (W m : ℕ) : ∀ p ∈ entL W m, ∀ r ∈ p.2.regs, 46 ≤ r.val ∧ r.val ≤ 52 := by
  intro p hp r hr
  simp only [entL, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
  all_goals first
    | (subst hr; decide)
    | (rcases hr with h | h | h | h <;> first | (subst h; decide) | exact regs_hdE m r h)
    | (rcases hr with h | h | h <;> first | (subst h; decide) | exact regs_hdE m r h)

theorem tgt_entL (W m : ℕ) : ∀ p ∈ entL W m, p.1.val < 46 ∨ 52 < p.1.val := by
  intro p hp
  simp only [entL, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide)

theorem towerL_head (q m k : ℕ) : ∃ rest, towerL q m k = ((q ^ m ^ k : ℕ) : ℤ) :: rest := by
  cases k with
  | zero => exact ⟨[], by rw [towerL_zero]; simp⟩
  | succ k => exact ⟨_, towerL_succ q m k⟩

