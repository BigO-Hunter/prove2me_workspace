  have H := FSp.rep (C := Ctr) (n := n) (b := NLogN.mvK X Y C' (.reg Br)) (s := s) (F := F)
    (N := recs.length) (c := cRecF B w) hCt5 hFC
    (by simp [NLogN.mvK, RS.writes, hCC, hCY, hCX]) hnc (by rw [hF0]; exact hno)
    (by rw [hF0]; exact hn) (fun k hk => by
