      have hrk : Bnd w recs[k] := fun a ha => hb a (List.mem_flatten.2 ⟨_, List.getElem_mem hk, ha⟩)
      have hGB : (Function.update (F k) Ctr [(recs.length : ℤ) - k]) Br = (B : ℤ) :: lB := by
        simp [hF, Function.update_apply, hBC, hBX, hBY, hBr]
      have m := FSp.mvK hXY hXC hYC hX5 hY5 hC5 s (Function.update (F k) Ctr [(recs.length : ℤ) - k])
        (.reg Br) (clean_reg hB5) (ok_reg (a := (B : ℤ)) (l := lB) hGB)
        recs[k] ((recs.drop (k + 1)).flatten ++ l)
        (by simp [hF, Function.update_apply, Ne.symm hCX, hXY, flatten_drop recs k hk])
        (by rw [eval_reg (a := (B : ℤ)) (l := lB) hGB, hl]) w hrk
      have hc1 := cost_reg_le (encK s (Function.update (F k) Ctr [(recs.length : ℤ) - k])) Br
      rw [top_encK hGB] at hc1
      have hc2 := cRep_le_lin recs[k].length
      have hzB := zszN B
      refine (m.congr ?_).mono ?_
      · congr 1
        funext j
        simp only [hF, Function.update_apply]
        split_ifs <;> simp_all [flatten_take_succ recs k hk]
      · rw [hl] at hc2 ⊢
        unfold cRecF
        nlinarith)
  rw [hF0, hFN] at H
  exact H

