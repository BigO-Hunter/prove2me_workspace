theorem cRotF_le {P Q B w Bb : ℕ} (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) :
    NLogN.KFD.cRotF P Q B w Bb ≤ 10 ^ 6 * (P * (Q * B) + 1) * (w + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
