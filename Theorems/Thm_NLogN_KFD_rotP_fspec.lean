    ((recs.drop k).flatten ++ l)) Y ((recs.take k).flatten.reverse ++ f Y) with hF
  have hF0 : F 0 = f := by
    funext j; simp only [hF, List.drop_zero, List.take_zero, List.flatten_nil, List.reverse_nil,
