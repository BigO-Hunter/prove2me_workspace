    (l : List ℤ) (B w : ℕ) (hrec : ∀ r ∈ recs, r.length = B) (hX : f X = recs.flatten ++ l)
    (lB : List ℤ) (hBr : f Br = (B : ℤ) :: lB) (hCt : f Ctr = [])
