-- Source module: Solutions.KFX3Corr
/-!
# KFX §3: the guard-set correction with register parameters

`corrRSU` is `KFL.corrRS K ρ f g A` with the size-dependent literals read from the registers
`1 … 10`: `recG.S0, Q, recG.S1, recG.S2, B, 2^ρ, f-1, 2^K, M = recG.V, A`.  `corrRSU_sub`: the
literal instance is `RS.sub`.  **`corrU_spec`**: `withPushI plC (fcode corrRSU)` computes
`rixT g (corrc K ρ f)` at the cost of `KFL.corrI_spec` (times `400`, plus the pushes).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW AModel Butterfly

/-! ## The uniform program -/

theorem σC_none (s0 q s1 s2 b r2 fm k2 m a : ℤ) {i : Fin HS} (h : 11 ≤ i.val) :
    σC s0 q s1 s2 b r2 fm k2 m a i = none := by
  simp only [σC]
  split_ifs <;> subst_vars <;> first | rfl | (exfalso; revert h; decide)

theorem sclean_σC (s0 q s1 s2 b r2 fm k2 m a : ℤ) : SClean (σC s0 q s1 s2 b r2 fm k2 m a) := by
  intro i hi
  have : i.val ≤ 10 := by
    by_contra hc
    rw [σC_none s0 q s1 s2 b r2 fm k2 m a (by omega)] at hi
    simp at hi
  exact notMem_zX (by omega)

theorem noW_corrRSU (s0 q s1 s2 b r2 fm k2 m a : ℤ) : NoW (σC s0 q s1 s2 b r2 fm k2 m a) corrRSU := by
  intro i hi
  have : ∀ j ∈ corrRSU.writes, j.val = 0 ∨ 11 ≤ j.val := by decide +kernel
  rcases this i hi with h | h
  · have : i = 0 := Fin.ext h
    subst this; rfl
  · exact σC_none _ _ _ _ _ _ _ _ _ _ h

theorem fok_corrRSU : fok corrRSU = true := by decide +kernel

theorem offE_subC (s0 q s1 s2 b r2 fm k2 m a bb : ℤ) :
    Ex.sub (σC s0 q s1 s2 b r2 fm k2 m a) (offE bb) = offE bb := by
  unfold offE; split_ifs <;> rfl

theorem t0E_subC (s0 q s1 s2 b r2 fm k2 m a : ℤ) :
    Ex.sub (σC s0 q s1 s2 b r2 fm k2 m a) t0E = t0E := rfl

theorem σC_mem {s0 q s1 s2 b r2 fm k2 m a : ℤ} {i : Fin HS} {v : ℤ}
    (hv : σC s0 q s1 s2 b r2 fm k2 m a i = some v) :
    (i, v) ∈ [((1 : Fin HS), s0), (2, q), (3, s1), (4, s2), (5, b), (6, r2), (7, fm), (8, k2),
      (9, m), (10, a)] := by
  simp only [σC] at hv
  split_ifs at hv <;> cases hv <;> subst_vars <;> simp

theorem corrRSU_sub (K ρ f : ℕ) (g : Geo) (hQe : g.Q = 2 ^ (f * K)) (A : ℕ) :
    RS.sub (σCg K ρ f g A) corrRSU = corrRS K ρ f g A := by
  have hQ : ((g.Q : ℕ) : ℤ) = (2 : ℤ) ^ (f * K) := by rw [hQe]; push_cast; rfl
  simp only [σCg, corrRSU, p1ProgU, p1BU, keyProgU, progLU, lines, lineRU, t0RU, segStepU,
    segLoopU, segBodyU, gcEU, keyEU, brBU, badBU, goodBU, radixProgU, passBU, entLoopU, entBU,
    bucketU, p3ProgU, p3BU, NLogN.mvK, RS.sub, Ex.sub, offE_subC, t0E_subC]
  simp only [corrRS, p1Prog, p1B, keyProg, progL, lines, lineR,
    t0R, segStep, segLoop, segBody, gcE, keyE, brB, badB, goodB, radixProg, passB, entLoop, entB,
    bucket, p3Prog, p3B, NLogN.mvK, Geo.recG_Q, hQ]
  all_goals (repeat' constructor)

/-! ## The register-driven correction -/

theorem aux_k2 {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) : a * (b + a + 5) ≤ 5 * ((a + 1) * (b + a + 1)) := by
  nlinarith [mul_nonneg ha hb, sq_nonneg a]

theorem aux_k1 {a : ℝ} (ha : 0 ≤ a) : (a + 5) ^ 3 ≤ 125 * (a + 1) ^ 3 := by
  have : a + 5 ≤ 5 * (a + 1) := by linarith
  calc (a + 5) ^ 3 ≤ (5 * (a + 1)) ^ 3 := pow_le_pow_left₀ (by linarith) this 3
    _ = 125 * (a + 1) ^ 3 := by ring

theorem aux_bb {b : ℝ} (hb : 0 ≤ b) : 1 ≤ (b + 2) ^ 2 ∧ 2 * b + 2 ≤ (b + 2) ^ 2 :=
  ⟨by nlinarith, by nlinarith⟩

/-- **The correction, register-driven.** -/
theorem corrU_spec_sol_aux :
    ∃ Kc : ℝ, 0 < Kc ∧
      ∀ (K ρ f : ℕ), 6 ≤ K → ρ < K → 1 ≤ f →
      ∀ (g : Geo), g.Pos → g.Q = 2 ^ (f * K) →
      ∀ (I : List Sym) (iprog : Fin 1 → IStmt HS 1) (t : IState HS) (zs : List ℤ) (R : List Item),
      KFL.Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
      ∀ (e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 : Ex HS) (Bb : ℕ),
      ((corrPl e1 e2 e3 e4 e5 e6 e7 e8 e9 e10).map fun p => p.2.size + 1).sum ≤ 100 →
      NoLow e1 → NoLow e2 → NoLow e3 → NoLow e4 → NoLow e5 → NoLow e6 → NoLow e7 → NoLow e8 →
      NoLow e9 → NoLow e10 →
      ESp e1 t Bb (g.recG.S0 : ℤ) → ESp e2 t Bb ((2 : ℤ) ^ (f * K)) →
      ESp e3 t Bb (g.recG.S1 : ℤ) → ESp e4 t Bb (g.recG.S2 : ℤ) → ESp e5 t Bb (g.B : ℤ) →
      ESp e6 t Bb ((2 : ℤ) ^ ρ) → ESp e7 t Bb ((f - 1 : ℕ) : ℤ) → ESp e8 t Bb ((2 : ℤ) ^ K) →
      ESp e9 t Bb (g.recG.V : ℤ) → ESp e10 t Bb (zsz (g.V : ℤ) : ℤ) →
      ∃ c : ℕ, IRuns I iprog (corrU e1 e2 e3 e4 e5 e6 e7 e8 e9 e10) t
          (t.upd 0 (ints (rixT g (corrc K ρ f) zs) ++ R)) c ∧
        (c : ℝ) ≤ Kc * corrB K f g + 10 ^ 10 * ((Bb : ℝ) + 2) ^ 2 := by
  refine ⟨400 * (10 ^ 13 * 125), by norm_num, ?_⟩
  intro K ρ f hK hρK hf g hg hQe I iprog t zs R hz h0 hl e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 Bb hsz
    n1 n2 n3 n4 n5 n6 n7 n8 n9 n10 E1 E2 E3 E4 E5 E6 E7 E8 E9 E10
  set M := g.recG.V with hMdef
  set A := zsz (g.V : ℤ) with hAdef
  set nB := nMv (keyR K ρ f g) M with hnB
  set pl := corrPl e1 e2 e3 e4 e5 e6 e7 e8 e9 e10
  have hE : ∀ p ∈ pl, ∃ v, ESp p.2 t Bb v := by
    intro p hp
    simp only [pl, corrPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, E1⟩, ⟨_, E2⟩, ⟨_, E3⟩, ⟨_, E4⟩, ⟨_, E5⟩, ⟨_, E6⟩, ⟨_, E7⟩, ⟨_, E8⟩, ⟨_, E9⟩,
      ⟨_, E10⟩]
  have hpl : PushOK t Bb pl := by
    refine pushOK_of (by
      intro p hp; simp only [pl, corrPl, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide)) ?_ hE
    intro p hp r hr hm
    simp only [pl, corrPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    simp only [pl, corrPl, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil,
      or_false] at hm
    have : 13 ≤ r.val := by
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact n1 r hr
      · exact n2 r hr
      · exact n3 r hr
      · exact n4 r hr
      · exact n5 r hr
      · exact n6 r hr
      · exact n7 r hr
      · exact n8 r hr
      · exact n9 r hr
      · exact n10 r hr
    rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> revert this <;>
      decide
  have ev : evalP t pl = [(1, (g.recG.S0 : ℤ)), (2, (2 : ℤ) ^ (f * K)), (3, (g.recG.S1 : ℤ)),
      (4, (g.recG.S2 : ℤ)), (5, (g.B : ℤ)), (6, (2 : ℤ) ^ ρ), (7, ((f - 1 : ℕ) : ℤ)),
      (8, (2 : ℤ) ^ K), (9, (M : ℤ)), (10, (A : ℤ))] := by
    simp only [evalP, pl, corrPl, List.map_cons, List.map_nil, E1.ev, E2.ev, E3.ev, E4.ev, E5.ev,
      E6.ev, E7.ev, E8.ev, E9.ev, E10.ev]
  have hnd : (pl.map Prod.fst).Nodup := by simp only [pl, corrPl, List.map_cons, List.map_nil]; decide
  set u := pushSt t (evalP t pl)
  have hl' : zs.length = M * g.B := by rw [hl, Geo.V_rec]
  have hlen := length_chunk hl'
  have hfl := flR_chunk hg.b hl'
  have S := corrRS_fsp (by omega) hρK hf hg hQe (chunk g.B M zs) hlen (bnd_chunk hz) (u.upd 0 R)
  rw [hfl] at S
  have hu0 : u.G 0 = ints zs ++ R := by
    rw [pushSt_G_of_not_mem _ _ _ (by rw [evalP_fst]; simp only [pl, corrPl, List.map_cons, List.map_nil]; decide), h0]
  have e0 : encK (u.upd 0 R) (Function.update (fun _ => []) 0 zs) = u := by
    rw [← encK_upd, encK_nil, IState.upd_G, if_pos rfl, IState.upd_upd_same, ← hu0,
      IState.upd_self]
  have e1' : flR (fun d => chunk g.B M zs (corrR K ρ f g d)) M = rixT g (corrc K ρ f) zs := by
    conv_rhs => rw [← hfl]
    rw [rixT_flR hg (TV_corrc' hg hQe) hlen]; rfl
  have e2' : encK (u.upd 0 R) (Function.update (fun _ => []) 0
      (flR (fun d => chunk g.B M zs (corrR K ρ f g d)) M)) =
      u.upd 0 (ints (rixT g (corrc K ρ f) zs) ++ R) := by
    rw [e1', ← encK_upd, encK_nil, IState.upd_G, if_pos rfl, IState.upd_upd_same]
  rw [e0, e2'] at S
  set σ := σCg K ρ f g A
  have hag : Agree σ u := by
    refine agree_pushSt t _ (by rw [evalP_fst]; exact hnd) (fun i v hv => ?_)
    rw [ev]
    exact σC_mem hv
  have hO : HRef (corrRS K ρ f g A) (RS.sub σ corrRSU) 0 := by
    rw [corrRSU_sub K ρ f g hQe]; exact HRef.refl _
  have SU := FSp.uni (sclean_σC _ _ _ _ _ _ _ _ _ _) (noW_corrRSU _ _ _ _ _ _ _ _ _ _) hO hag S
  have W := KFD.IRuns.withPushI (I := I) (iprog := iprog) pl (fcode corrRSU) t Bb hpl
    (pushVals_le hE) (by simp only [pl, corrPl, List.map_cons, List.map_nil]; decide) (rixT g (corrc K ρ f) zs) R _
    (SU.irun fok_corrRSU)
  refine ⟨_, W, ?_⟩
  -- the cost
  have hpc := pushCost_le_size Bb pl 100 hsz
  have hl10 : pl.length = 10 := rfl
  rw [hl10]
  have hM1 : 1 ≤ M := hg.recG.v
  have hfA := f_lt_zsz (by omega) hg hQe
  have hc := cCorr_le K f g A nB (A + 3) (by omega) (by omega) hM1
  have hcount := card_moved hK hρK hf hg hQe
  have hnBM : nB ≤ M := nMv_le _ _
  have hV : (g.V : ℝ) = (M : ℝ) * g.B := by rw [Geo.V_rec]; push_cast; ring
  have hcR : (cCorr K f g A nB (A + 3) : ℝ) ≤ 10 ^ 13 * ((M : ℝ) * ((A : ℝ) + 5) ^ 3 +
      (M : ℝ) * g.B + (A : ℝ) * nB * (g.B + A + 5)) := by
    have := (Nat.cast_le (α := ℝ)).2 hc
    push_cast at this
    refine this.trans (le_of_eq ?_); ring
  set δ := min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K)
  have hδ : (nB : ℝ) ≤ δ * M := by
    rw [min_mul_of_nonneg _ _ (Nat.cast_nonneg _)]
    refine le_min (by rw [one_mul]; exact_mod_cast hnBM) ?_
    have h := (Nat.cast_le (α := ℝ)).2 hcount
    push_cast [Nat.cast_sub hf] at h
    have h2 : (0 : ℝ) < 2 ^ K := by positivity
    rw [inv_pow, show 80 * ((f : ℝ) - 1) * ((2 : ℝ) ^ K)⁻¹ * M = 80 * ((f : ℝ) - 1) * M / 2 ^ K
      by ring, le_div_iff₀ h2]
    exact h
  have hA0 : (0 : ℝ) ≤ A := Nat.cast_nonneg _
  have hB0 : (0 : ℝ) ≤ g.B := Nat.cast_nonneg _
  have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg _
  have hnB0 : (0 : ℝ) ≤ nB := Nat.cast_nonneg _
  have hδ0 : 0 ≤ δ * M := hnB0.trans hδ
  have k1 : ((A : ℝ) + 5) ^ 3 ≤ 125 * ((A : ℝ) + 1) ^ 3 := aux_k1 hA0
  have k2 : (A : ℝ) * nB * (g.B + A + 5) ≤ 5 * (δ * M * ((A : ℝ) + 1) * (g.B + A + 1)) := by
    have : (A : ℝ) * (g.B + A + 5) ≤ 5 * (((A : ℝ) + 1) * (g.B + A + 1)) := aux_k2 hA0 hB0
    calc (A : ℝ) * nB * (g.B + A + 5) = nB * ((A : ℝ) * (g.B + A + 5)) := by ring
      _ ≤ (δ * M) * (5 * (((A : ℝ) + 1) * (g.B + A + 1))) :=
          mul_le_mul hδ this (by positivity) hδ0
      _ = 5 * (δ * M * ((A : ℝ) + 1) * (g.B + A + 1)) := by ring
  have k3 : (M : ℝ) * ((A : ℝ) + 5) ^ 3 ≤ 125 * ((M : ℝ) * ((A : ℝ) + 1) ^ 3) := by
    have := mul_le_mul_of_nonneg_left k1 hM0
    linarith
  have hMB : (0 : ℝ) ≤ M * g.B := by positivity
  have hX : (0 : ℝ) ≤ (M : ℝ) * ((A : ℝ) + 1) ^ 3 := by positivity
  have hY : (0 : ℝ) ≤ δ * M * ((A : ℝ) + 1) * (g.B + A + 1) := by
    exact mul_nonneg (mul_nonneg hδ0 (by positivity)) (by positivity)
  have hcc : (cCorr K f g A nB (A + 3) : ℝ) ≤ 10 ^ 13 * 125 * corrB K f g := by
    unfold corrB
    rw [V_div_B hg, hV]
    calc (cCorr K f g A nB (A + 3) : ℝ) ≤ _ := hcR
      _ ≤ 10 ^ 13 * 125 * ((M : ℝ) * ((A : ℝ) + 1) ^ 3 + M * g.B +
            δ * M * ((A : ℝ) + 1) * (g.B + A + 1)) := by linarith [k2, k3, hMB, hY, hX]
  have hpc' : (pushCost Bb pl : ℝ) ≤ 100 * 10 ^ 7 * ((Bb : ℝ) + 2) ^ 2 + 1 := by
    exact_mod_cast hpc
  have hBb : (1 : ℝ) ≤ ((Bb : ℝ) + 2) ^ 2 := (aux_bb (Nat.cast_nonneg Bb)).1
  push_cast
  have hcc' : (400 : ℝ) * ((cCorr K f g A nB (A + 3) : ℕ) : ℝ) + 400 * 0 ≤
      400 * (10 ^ 13 * 125) * corrB K f g := by linarith
  have hB2 : 2 * (Bb : ℝ) + 2 ≤ ((Bb : ℝ) + 2) ^ 2 := (aux_bb (Nat.cast_nonneg Bb)).2
  linarith

end NLogN.KFX

