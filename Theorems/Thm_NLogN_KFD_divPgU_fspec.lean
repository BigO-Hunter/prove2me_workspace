variable {rp : ℕ → List ℤ} {Q c B : ℕ}

theorem brG_fsp (s : IState HS) (K : NLogN.KIL.KS) (rest O : List ℤ) (w : ℕ) (hc : 0 < c)
    (hr : ∀ y, (rp y).length = B) (hb : ∀ y, Bnd w (rp y))
    (j y : ℕ) (hy : y < Q) (q kk : List ℤ) :
    FSp (brG Q c B j (y % c)) (encK s (toF (NLogN.KIL.gSt rp Q c K rest O j y q kk)))
      (encK s (toF (NLogN.KIL.gSt rp Q c K rest O j (y + 1) q kk))) (cBrF B w) := by
  set k := sig Q c (y % c) with hk
  by_cases h1 : k < j
  · have hcode : brG Q c B j (y % c) = .skip := by simp only [brG, ← hk, if_pos h1]
    rw [hcode]
    refine ((FSp.skip _).congr ?_).mono (by simp only [cBrF, cLp]; omega)
    congr 2
    simp only [NLogN.KIL.gSt, selR_succ _ hy, preR_succ, ← hk]
    simp [show ¬ j ≤ k by omega, show ¬ j < k by omega, show k ≠ j by omega]
  by_cases h2 : k = j
  · have hcode : brG Q c B j (y % c) = mvK 0 12 33 (.lit B) := by
      simp only [brG, ← hk, if_neg h1, if_pos h2]
    rw [hcode]
    set f := toF (NLogN.KIL.gSt rp Q c K rest O j y q kk)
    have hf0 : f 0 = rp y ++ (selR rp Q c (fun k => decide (j ≤ k)) (y + 1) ++ rest) := by
      simp only [f, toF_x, NLogN.KIL.gSt]
      rw [selR_succ _ hy, ← hk, if_pos (by simp; omega), List.append_assoc]
    have m := FSp.mvL (X := 0) (Y := 12) (C := 33) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s f (rp y) _ hf0 w B (hb y) (by rw [hr]; exact zszN B)
    rw [hr, upd_x, upd_o] at m
    refine (m.congr ?_).mono le_rfl
    congr 2
    simp only [NLogN.KIL.gSt, f, preR_succ, ← hk]
    simp [h2, List.reverse_append, List.append_assoc]
  · have hcode : brG Q c B j (y % c) = mvK 0 10 33 (.lit B) := by
      simp only [brG, ← hk, if_neg h1, if_neg h2]
    rw [hcode]
    set f := toF (NLogN.KIL.gSt rp Q c K rest O j y q kk)
    have hf0 : f 0 = rp y ++ (selR rp Q c (fun k => decide (j ≤ k)) (y + 1) ++ rest) := by
      simp only [f, toF_x, NLogN.KIL.gSt]
      rw [selR_succ _ hy, ← hk, if_pos (by simp; omega), List.append_assoc]
    have m := FSp.mvL (X := 0) (Y := 10) (C := 33) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s f (rp y) _ hf0 w B (hb y) (by rw [hr]; exact zszN B)
    rw [hr, upd_x, upd_a] at m
    refine (m.congr ?_).mono le_rfl
    congr 2
    simp only [NLogN.KIL.gSt, f, preR_succ, ← hk]
    simp [h2, show j < k by omega, List.reverse_append, List.append_assoc]

theorem bodyG_fsp (s : IState HS) (K : NLogN.KIL.KS) (rest O : List ℤ) (w b : ℕ) (hc2 : 2 ≤ c)
    (hr : ∀ y, (rp y).length = B) (hb : ∀ y, Bnd w (rp y))
    (zc : zsz ((2 * c : ℕ) : ℤ) ≤ b) (j y : ℕ) (hy : y < Q)
    (kk : List ℤ) :
    FSp (bodyG Q c B j) (encK s (toF (NLogN.KIL.gSt rp Q c K rest O j y [((y % c : ℕ) : ℤ)] kk)))
      (encK s (toF (NLogN.KIL.gSt rp Q c K rest O j (y + 1) [(((y + 1) % c : ℕ) : ℤ)] kk)))
      (cBodyGF c B w b) := by
  have hc : 0 < c := by omega
  set v := y % c with hv
  have hvc : v < c := Nat.mod_lt _ hc
  have hz' : ∀ x : ℕ, x ≤ v + 1 → zsz (x : ℤ) ≤ b := fun x hx =>
    le_trans (NLogN.KIL.zsz_nat_le (show x ≤ 2 * c by omega)) zc
  have m := brG_fsp (rp := rp) (Q := Q) (c := c) (B := B) s K rest O w hc hr hb j y hy
    [(v : ℤ)] kk
  have hS := FSp.sel (r := 13) (by decide) (brG Q c B j)
    (s := encK s (toF (NLogN.KIL.gSt rp Q c K rest O j y [(v : ℤ)] kk)))
    (L := ints [] ++ s.G 13) (by simp [NLogN.KIL.gSt, ints]; omega) m hz' c 0 (by omega) (by omega)
  set g := toF (NLogN.KIL.gSt rp Q c K rest O j (y + 1) [(v : ℤ)] kk)
  have h13 : g 13 = (v : ℤ) :: [] := rfl
  have zv : zsz (v : ℤ) ≤ b := hz' v (by omega)
  have hA := Sp.asg (i := 13) (e := mAdd c (.reg 13) (.lit 1)) s g
    (by decide) h13 zv (mAdd_clean c (clean_reg (by decide)) (clean_lit _))
    (mAdd_ok (ok_reg h13) trivial) (mAdd_lin c trivial trivial)
    (mAdd_bnd (bnd_reg h13 zv) (by simp only [Ex.Bnd]; exact hz' 1 (by omega))
      (by rw [eval_reg h13]; positivity) (by rw [eval_reg h13]; exact_mod_cast hvc)
      (by simp [Ex.eval]) (by simp [Ex.eval]; omega) zc)
  have ev : (mAdd c (.reg 13) (.lit 1)).eval (encK s g) = (((y + 1) % c : ℕ) : ℤ) := by
    rw [mAdd_eval, eval_reg h13]; simp only [Ex.eval]
    have e1 : (y + 1) % c = (v + 1) % c := by
      rw [Nat.add_mod, ← hv, Nat.mod_eq_of_lt (show 1 < c by omega)]
    rw [e1]
    by_cases h : (v : ℤ) + 1 + -(c : ℤ) < 0
    · simp only [h, if_true]
      rw [Nat.mod_eq_of_lt (show v + 1 < c by omega)]; push_cast; ring
    · simp only [h, if_false]
      rw [show v + 1 = c by omega, Nat.mod_self]; push_cast; omega
  rw [ev, upd_qMB] at hA
  refine ((hS.seq (FSp.of_norep rfl hA)).congr ?_).mono
    (by simp only [cBodyGF, Ex.size, mAdd_size']; omega)
  rfl

theorem passG_fsp (s : IState HS) (K : NLogN.KIL.KS) (rest O : List ℤ) (w b : ℕ) (hc2 : 2 ≤ c)
    (hr : ∀ y, (rp y).length = B) (hb : ∀ y, Bnd w (rp y))
    (zc : zsz ((2 * c : ℕ) : ℤ) ≤ b) (j : ℕ) :
    FSp (passG Q c B j) (encK s (toF (NLogN.KIL.gSt rp Q c K rest O j 0 [] [])))
      (encK s (toF (NLogN.KIL.gSt rp Q c K rest
        ((preR rp Q c (fun k => decide (k = j)) Q).reverse ++ O) (j + 1) 0 [] [])))
      (cPassGF Q c B w b) := by
  have hc : 0 < c := by omega
  have L1 := Sp.push s (toF (NLogN.KIL.gSt rp Q c K rest O j 0 [] [])) (i := 13) (e := .lit 0) (B := b)
    (by decide) (clean_lit _) trivial trivial (by simp [Ex.Bnd, zsz_zero])
  rw [upd_qMB] at L1
  have e1 : ({NLogN.KIL.gSt rp Q c K rest O j 0 [] [] with
      qMB := Ex.eval (encK s (toF (NLogN.KIL.gSt rp Q c K rest O j 0 [] []))) (.lit 0) ::
        toF (NLogN.KIL.gSt rp Q c K rest O j 0 [] []) 13} : NLogN.KIL.KS) =
      NLogN.KIL.gSt rp Q c K rest O j 0 [((0 % c : ℕ) : ℤ)] [] := by
    simp [NLogN.KIL.gSt, Ex.eval]
  rw [e1] at L1
  have L2 := FSp.repLit (C := 31) (b := bodyG Q c B j) (s := s)
    (F := fun y => toF (NLogN.KIL.gSt rp Q c K rest O j y [((y % c : ℕ) : ℤ)] [])) (N := Q) (Bb := Q)
    (c := cBodyGF c B w b) (by decide) (fun y => rfl) (bodyG_not_writes j) (zszN Q)
    (fun y hy => by
      rw [upd_k1, upd_k1]
      exact bodyG_fsp s K rest O w b hc2 hr hb zc j y hy _)
  have hQc' : zsz (((Q % c : ℕ) : ℤ)) ≤ b :=
    le_trans (NLogN.KIL.zsz_nat_le (show Q % c ≤ 2 * c by have := Nat.mod_lt Q hc; omega)) zc
  have L3 := Sp.pop (i := 13) s (toF (NLogN.KIL.gSt rp Q c K rest O j Q [((Q % c : ℕ) : ℤ)] [])) (by decide)
    (a := ((Q % c : ℕ) : ℤ)) (l := []) rfl hQc'
  rw [upd_qMB] at L3
  set f := toF ({NLogN.KIL.gSt rp Q c K rest O j Q [((Q % c : ℕ) : ℤ)] [] with qMB := []} : NLogN.KIL.KS)
  have hf10 : f 10 = (preR rp Q c (fun k => decide (j < k)) Q).reverse ++ [] := by
    simp [f, NLogN.KIL.gSt]
  have hlen : (preR rp Q c (fun k => decide (j < k)) Q).reverse.length = cntG Q c j * B := by
    rw [List.length_reverse, length_preR hr]; rfl
  have hcnt : cntG Q c j * B ≤ Q * B :=
    Nat.mul_le_mul_right B (length_filter_range_le Q _)
  have L4 := FSp.mvL (X := 10) (Y := 0) (C := 33) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s f _ _ hf10 w (Q * B) (NLogN.KIL.bnd_reverse (bnd_preR hb _ _))
    (by rw [hlen]; exact le_trans (NLogN.KIL.zsz_nat_le hcnt) (zszN _))
  rw [hlen, upd_a, upd_x] at L4
  refine (((FSp.of_norep rfl L1).seq (L2.seq ((FSp.of_norep rfl L3).seq L4))).congr ?_).mono ?_
  · congr 2
    simp only [f, NLogN.KIL.gSt, List.reverse_reverse, selR_Q, List.nil_append, preR_zero, List.reverse_nil,
      List.append_nil, selR_zero]
    congr 2
  · have := cLp_mono (c := 250 * (w + 2)) (Bb := Q * B) hcnt le_rfl le_rfl
    simp only [cPassGF, Ex.size]
    omega

theorem passGU_fsp {rp : ℕ → List ℤ} {Q c B : ℕ} (s : IState HS) (K : NLogN.KIL.KS) (rest O : List ℤ)
    (w b bL : ℕ) (hc2 : 2 ≤ c) (hr : ∀ y, (rp y).length = B) (hb : ∀ y, Bnd w (rp y))
    (zc : zsz ((2 * c : ℕ) : ℤ) ≤ b) (zB : zsz (B : ℤ) ≤ bL) (zc' : zsz (c : ℤ) ≤ bL)
    (zQ : zsz (Q : ℤ) ≤ bL) (zQB : zsz ((Q * B : ℕ) : ℤ) ≤ bL) (j : ℕ) {LQ LB : List Item}
    (hQs : s.G sQQ = .int Q :: LQ) (hBs : s.G sPC = .int B :: LB) :
    FSp (passGU (Q % c) c j) (encK s (toF (NLogN.KIL.gSt rp Q c K rest O j 0 [] [])))
      (encK s (toF (NLogN.KIL.gSt rp Q c K rest
        ((preR rp Q c (fun k => decide (k = j)) Q).reverse ++ O) (j + 1) 0 [] [])))
      (cPassGUF Q c B w b bL) := by
  have hc : 0 < c := by omega
  set f := toF (NLogN.KIL.gSt rp Q c K rest O j 0 [] [])
  set g := toF (NLogN.KIL.gSt rp Q c K rest ((preR rp Q c (fun k => decide (k = j)) Q).reverse ++ O)
    (j + 1) 0 [] [])
  have hfr : ∀ (k : NLogN.KIL.KS) (i : Fin HS), 14 < i.val → (i.val < 30 ∨ 33 < i.val) → toF k i = [] :=
    fun k i h1 h2 => toF_free k i h1 h2
  have fQ : f sQQ = [] := hfr _ _ (by decide) (by decide)
  have fB : f sPC = [] := hfr _ _ (by decide) (by decide)
  have fC : f sCN = [] := hfr _ _ (by decide) (by decide)
  have gC : g sCN = [] := hfr _ _ (by decide) (by decide)
  have hab : Q / c * cGA (Q % c) c j + cGB (Q % c) c j ≤ Q := by
    rw [← cntG_eq hc]; exact cntG_le Q c j
  obtain ⟨hok, hev, hbd⟩ := cntE_facts (t := encK s f) (Q := Q) (B := B) (c := c)
    (a := cGA (Q % c) c j) (b := cGB (Q % c) c j) (LQ := LQ) (LB := LB) (by simp [fQ, ints, hQs])
    (by simp [fB, ints, hBs]) hc (cGA_le _ _ _) hab zQ zc' zB zQB
  rw [← cntG_eq hc] at hev
  set cnt : ℤ := ((cntG Q c j * B : ℕ) : ℤ)
  have zcnt : zsz cnt ≤ bL := le_trans (NLogN.KIL.zsz_nat_le (Nat.mul_le_mul_right _ (cntG_le Q c j))) zQB
  set s' := s.upd sCN (.int cnt :: s.G sCN)
  have H := passG_fsp (rp := rp) (Q := Q) (c := c) (B := B) s' K rest O w b hc2 hr hb zc j
  rw [passG_eq_T] at H
  set π := pmOf [(sQQ, (Q : ℤ)), (sPC, (B : ℤ)), (sCN, cnt)]
  have hπ : PLow π := PLow.of_idx (by simp only [List.map_cons, List.map_nil]; decide)
  have hsim : RSim π (passGT (Q % c) c j (.lit Q) (.lit B) (.lit cnt))
      (passGT (Q % c) c j (.reg sQQ) (.reg sPC) (.reg sCN)) :=
    rsim_passGT _ _ _ (.par rfl) (.par rfl) (.par rfl)
  have hw := notw_of_idx (l := [(sQQ, (Q : ℤ)), (sPC, (B : ℤ)), (sCN, cnt)])
    (p := passGT (Q % c) c j (.lit Q) (.lit B) (.lit cnt))
    (fun i hi => passGT_writes _ _ _ _ _ _ i (by
      simp only [List.map_cons, List.map_nil, List.mem_cons, List.mem_nil_iff, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide))
  have hPV : PV π (encK s' f) := PV.of_list (by
    intro p hp
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hp
    rcases hp with rfl | rfl | rfl
    · exact ⟨LQ, by simp (config := {decide := true}) [s', fQ, ints, hQs]⟩
    · exact ⟨LB, by simp (config := {decide := true}) [s', fB, ints, hBs]⟩
    · exact ⟨s.G sCN, by simp [s', fC, ints]⟩)
  have S := FSp.sim hπ hsim hw hPV H
  have R := FSp.pushRunPop (i := sCN) (by decide) (cntE_clean _ _ _) fC gC hok hev hbd zcnt S
  refine R.mono (le_of_eq ?_)
  simp only [cntE_size, cPassGUF]

theorem passesGU_fsp {rp : ℕ → List ℤ} {Q c B : ℕ} (s : IState HS) (K : NLogN.KIL.KS) (rest O0 : List ℤ)
    (w b bL : ℕ) (hc2 : 2 ≤ c) (hr : ∀ y, (rp y).length = B) (hb : ∀ y, Bnd w (rp y))
    (zc : zsz ((2 * c : ℕ) : ℤ) ≤ b) (zB : zsz (B : ℤ) ≤ bL) (zc' : zsz (c : ℤ) ≤ bL)
    (zQ : zsz (Q : ℤ) ≤ bL) (zQB : zsz ((Q * B : ℕ) : ℤ) ≤ bL) {LQ LB : List Item}
    (hQs : s.G sQQ = .int Q :: LQ) (hBs : s.G sPC = .int B :: LB) :
    ∀ k, FSp (passesGU (Q % c) c k) (encK s (toF (NLogN.KIL.gSt rp Q c K rest O0 0 0 [] [])))
      (encK s (toF (NLogN.KIL.gSt rp Q c K rest (((List.range k).flatMap (flatD rp Q c)).reverse ++ O0)
        k 0 [] []))) (1 + k * cPassGUF Q c B w b bL)
  | 0 => by
    refine ((FSp.skip _).congr ?_).mono (by simp)
    simp
  | k + 1 => by
    have IH := passesGU_fsp s K rest O0 w b bL hc2 hr hb zc zB zc' zQ zQB hQs hBs k
    have P := passGU_fsp (rp := rp) (Q := Q) (c := c) (B := B) s K rest
      (((List.range k).flatMap (flatD rp Q c)).reverse ++ O0) w b bL hc2 hr hb zc zB zc' zQ zQB k
      hQs hBs
    rw [preR_eq_flatD] at P
    refine ((IH.seq P).congr ?_).mono (by rw [Nat.succ_mul]; omega)
    simp [List.range_succ, List.flatMap_append, List.reverse_append, List.append_assoc]

theorem blkGU_fsp {r : ℕ → ℕ → List ℤ} {P Q c B : ℕ} (s : IState HS) (w b bL : ℕ) (hc2 : 2 ≤ c)
    (hQc : Nat.Coprime Q c) (hr : ∀ p y, (r p y).length = B) (hb : ∀ p y, Bnd w (r p y))
    (zc : zsz ((2 * c : ℕ) : ℤ) ≤ b) (zB : zsz (B : ℤ) ≤ bL) (zc' : zsz (c : ℤ) ≤ bL)
    (zQ : zsz (Q : ℤ) ≤ bL) (zQB : zsz ((Q * B : ℕ) : ℤ) ≤ bL) {LQ LB : List Item}
    (hQs : s.G sQQ = .int Q :: LQ) (hBs : s.G sPC = .int B :: LB) (p : ℕ) (hp : p < P)
    (kk : List ℤ) :
    FSp (passesGU (Q % c) c c) (encK s (toF (dSt r P Q c p kk)))
      (encK s (toF (dSt r P Q c (p + 1) kk))) (cBlkGUF Q c B w b bL) := by
  have hc : 0 < c := by omega
  set K0 := dSt r P Q c p kk
  set rest := (List.range' (p + 1) (P - (p + 1))).flatMap (blk3 r Q)
  have H := passesGU_fsp (rp := r p) (Q := Q) (c := c) (B := B) s K0 rest K0.o w b bL hc2 (hr p)
    (hb p) zc zB zc' zQ zQB hQs hBs c
  rw [outD_eq (r p) hc hQc] at H
  refine (H.congr_s ?_).congr ?_
  · congr 1
    have hx : (List.range' p (P - p)).flatMap (blk3 r Q) = blk3 r Q p ++ rest :=
      fm_range'_succ _ hp
    simp only [NLogN.KIL.gSt, K0, dSt, hx, selR, preR_zero, List.reverse_nil, List.nil_append, blk3,
      Nat.sub_zero, ← List.range_eq_range']
    simp
  · congr 1
    simp only [NLogN.KIL.gSt, K0, dSt, rest, preR_zero, List.reverse_nil, List.nil_append, List.range_succ,
      List.flatMap_append, List.flatMap_singleton, List.reverse_append]
    have : selR (r p) Q c (fun k => decide (c ≤ k)) 0 = [] := by
      unfold selR
      rw [List.filter_eq_nil_iff.2 (fun y _ => by simp [sig_lt hc])]
      rfl
    simp [this, outDB]

theorem divPgR_fsp {r : ℕ → ℕ → List ℤ} {P Q c B : ℕ} (s : IState HS) (w b bL Bb : ℕ)
    (hc2 : 2 ≤ c) (hQc : Nat.Coprime Q c) (hr : ∀ p y, (r p y).length = B)
    (hb : ∀ p y, Bnd w (r p y))
    (zc : zsz ((2 * c : ℕ) : ℤ) ≤ b) (zB : zsz (B : ℤ) ≤ bL) (zc' : zsz (c : ℤ) ≤ bL)
    (zQ : zsz (Q : ℤ) ≤ bL) (zQB : zsz ((Q * B : ℕ) : ℤ) ≤ bL) (zP : zsz (P : ℤ) ≤ Bb)
    (zV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) {LQ LB LA LV : List Item}
    (hQs : s.G sQQ = .int Q :: LQ) (hBs : s.G sPC = .int B :: LB)
    (hAs : s.G sPA = .int P :: LA) (hVs : s.G sVV = .int ((P * (Q * B) : ℕ) : ℤ) :: LV) :
    FSp (divPgR (Q % c) c) (encK s (toF {x := KIL.inR r Q P}))
      (encK s (toF {x := outDiv r P Q c})) (cDivPgRF P Q c B w b bL Bb) := by
  have hfA : ∀ k : NLogN.KIL.KS, toF k sPA = [] := fun k => toF_free k _ (by decide) (by decide)
  have hfV : ∀ k : NLogN.KIL.KS, toF k sVV = [] := fun k => toF_free k _ (by decide) (by decide)
  have hloop := FSp.repReg (C := 30) (r := sPA) (b := passesGU (Q % c) c c) (s := s)
    (F := fun p => toF (dSt r P Q c p [])) (N := P) (Bb := Bb) (c := cBlkGUF Q c B w b bL)
    (by decide) (by decide) (fun _ => rfl) (passesGU_not_writes _ c c) (L := LA)
    (by simp [hfA, ints, hAs]) zP (fun p hp => by
      rw [upd_k0, upd_k0]
      exact blkGU_fsp s w b bL hc2 hQc hr hb zc zB zc' zQ zQB hQs hBs p hp _)
  have e0 : dSt r P Q c 0 [] = {x := KIL.inR r Q P} := by
    simp [dSt, KIL.inR, List.range_eq_range']
  rw [e0] at hloop
  have hlenO : (outDiv r P Q c).length = P * (Q * B) := by
    unfold outDiv
    rw [length_fm_const _ _ (Q * B) (fun p _ => length_outDB (hr p))]; simp
  have m1 := FSp.mvR (X := 12) (Y := 0) (C := 33) (r := sVV) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s (toF (dSt r P Q c P []))
    (outDiv r P Q c).reverse [] (by simp [dSt, outDiv]) (Lr := LV)
    (by rw [List.length_reverse, hlenO]; simp [hfV, ints, hVs]) w Bb
    (NLogN.KIL.bnd_reverse (bnd_flatMap fun p => bnd_flatMap fun z => hb p _))
    (by rw [List.length_reverse, hlenO]; exact zV)
  rw [upd_o, upd_x, List.length_reverse, hlenO] at m1
  refine ((hloop.seq m1).congr ?_).mono le_rfl
  congr 2
  simp [dSt]

theorem divPgR_fspec (t : IState HS) (xs : List ℤ) (P Q c B w b bL Bb : ℕ) (R : List Item)
    (hlen : xs.length = P * Q * B) (hb : Bnd w xs) (hc2 : 2 ≤ c)
    (hQc : Nat.Coprime Q c) (zc : zsz ((2 * c : ℕ) : ℤ) ≤ b) (zB : zsz (B : ℤ) ≤ bL)
    (zc' : zsz (c : ℤ) ≤ bL)
    (zQ : zsz (Q : ℤ) ≤ bL) (zQB : zsz ((Q * B : ℕ) : ℤ) ≤ bL) (zP : zsz (P : ℤ) ≤ Bb)
    (zV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) {LQ LB LA LV : List Item}
    (hQs : t.G sQQ = .int Q :: LQ) (hBs : t.G sPC = .int B :: LB)
    (hAs : t.G sPA = .int P :: LA) (hVs : t.G sVV = .int ((P * (Q * B) : ℕ) : ℤ) :: LV) :
    FSp (divPgR (Q % c) c) t (t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (divAddr Q c) 0 xs) ++ R))
      (cDivPgRF P Q c B w b bL Bb) := by
  have H := divPgR_fsp (r := recR xs Q B) (P := P) (t.upd 0 R) w b bL Bb hc2 hQc
    (fun _ _ => length_recR xs Q B _ _)
    (fun _ _ a ha => by
      simp only [recR, List.mem_map, List.mem_range] at ha
      obtain ⟨b, -, rfl⟩ := ha; exact bnd_getD hb _) zc zB zc' zQ zQB zP zV
    (LQ := LQ) (LB := LB) (LA := LA) (LV := LV)
    (by simp (config := {decide := true}) [hQs]) (by simp (config := {decide := true}) [hBs])
    (by simp (config := {decide := true}) [hAs]) (by simp (config := {decide := true}) [hVs])
  rw [inR_recR hlen, outDiv_recR, encK_x, encK_x] at H
  refine (H.congr_s ?_).congr ?_
  · apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      (try split_ifs) <;> simp_all
  · apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      (try split_ifs) <;> simp_all

end GatherLemmas

end KFD

end NLogN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open IntMul RS
open NLogN.KFD
open KIL AModel
variable {rp : ℕ → List ℤ} {Q c B : ℕ}
theorem NLogN.KFD.divPgU_fspec (t : NLogN.IState NLogN.HS) (xs : List ℤ) (P Q c B w b bL Bb : ℕ) (R : List NLogN.Item)
    (hlen : xs.length = P * Q * B) (hb : NLogN.Bnd w xs) (hc2 : 2 ≤ c)
    (hQc : Nat.Coprime Q c) (zc : NLogN.zsz ((2 * c : ℕ) : ℤ) ≤ b) (zB : NLogN.zsz (B : ℤ) ≤ bL)
    (zc' : NLogN.zsz (c : ℤ) ≤ bL)
    (zQ : NLogN.zsz (Q : ℤ) ≤ bL) (zQB : NLogN.zsz ((Q * B : ℕ) : ℤ) ≤ bL) (zP : NLogN.zsz (P : ℤ) ≤ Bb)
    (zQg : NLogN.zsz (Q : ℤ) ≤ Bb) (zcg : NLogN.zsz ((2 * c : ℕ) : ℤ) ≤ Bb)
    (zV : NLogN.zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = NLogN.ints xs ++ R) {LQ LB LA LV : List NLogN.Item}
    (hQs : t.G NLogN.KIL.sQQ = .int Q :: LQ) (hBs : t.G NLogN.KIL.sPC = .int B :: LB)
    (hAs : t.G NLogN.KIL.sPA = .int P :: LA) (hVs : t.G NLogN.KIL.sVV = .int ((P * (Q * B) : ℕ) : ℤ) :: LV) :
    NLogN.KFD.FSp (NLogN.KIL.divPgU c) t (t.upd 0 (NLogN.ints (AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.divAddr Q c) 0 xs) ++ R))
      (NLogN.KFD.cDivPgUF P Q c B w b bL Bb) := by
  set t1 := t.upd NLogN.KIL.sRR (.int ((Q % c : ℕ) : ℤ) :: t.G NLogN.KIL.sRR)
  have B1 := NLogN.KFD.divPgR_fspec t1 xs P Q c B w b bL Bb R hlen hb hc2 hQc zc zB zc' zQ zQB zP zV
    (by simp (config := {decide := true}) [t1, h0])
    (LQ := LQ) (LB := LB) (LA := LA) (LV := LV)
    (by simp (config := {decide := true}) [t1, hQs]) (by simp (config := {decide := true}) [t1, hBs])
    (by simp (config := {decide := true}) [t1, hAs]) (by simp (config := {decide := true}) [t1, hVs])
  have H := NLogN.KFD.FSp.resSel (c := c) (by omega) (fun r => NLogN.KIL.divPgR r c) hQs zQg zcg B1
    (by simp (config := {decide := true}) [t1])
  rw [NLogN.KIL.upd_restore (by decide)] at H
  exact H
end
