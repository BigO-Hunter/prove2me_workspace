theorem range_tele (lo : ℕ → ℕ) (hm : ∀ j, lo j ≤ lo (j + 1)) :
    ∀ k, (List.range k).flatMap (fun j => List.range' (lo j) (lo (j + 1) - lo j)) =
      List.range' (lo 0) (lo k - lo 0)
  | 0 => by simp
  | k + 1 => by
    have hmk : ∀ k, lo 0 ≤ lo k := by
      intro k; induction k with
      | zero => exact le_rfl
      | succ k ih => exact le_trans ih (hm k)
    rw [List.range_succ, List.flatMap_append, range_tele lo hm k, List.flatMap_singleton]
    have := List.range'_append (s := lo 0) (m := lo k - lo 0) (n := lo (k + 1) - lo k) (step := 1)
    rw [Nat.one_mul, show lo 0 + (lo k - lo 0) = lo k by have := hmk k; omega] at this
    rw [this]; congr 1; have := hmk k; have := hm k; omega

