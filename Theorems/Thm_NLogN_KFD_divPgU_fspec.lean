namespace NLogN.KIL

open IntMul RS AModel

theorem cntG_eq {Q c : ℕ} (hc : 0 < c) (j : ℕ) :
    cntG Q c j = Q / c * cGA (Q % c) c j + cGB (Q % c) c j := by
  have H := cntR_periodic (p := fun y => decide (j < sig Q c (y % c))) (c := c)
    (fun y => by simp) (Q % c) (Q / c)
  rw [Nat.div_add_mod] at H
  have e1 : cntG Q c j = cntR (fun y => decide (j < sig Q c (y % c))) Q := rfl
  rw [e1, H]
  unfold cGA cGB
  rw [cntR_congr (p' := fun v => decide (j < sig (Q % c) c v)) (fun y hy => by
      simp only [Nat.mod_eq_of_lt hy, sig_mod Q c y]),
    cntR_congr (n := Q % c) (p' := fun v => decide (j < sig (Q % c) c v)) (fun y hy => by
      simp only [Nat.mod_eq_of_lt (lt_trans hy (Nat.mod_lt Q hc)), sig_mod Q c y])]

theorem passG_eq_T (Q c B j : ℕ) :
    passG Q c B j = passGT (Q % c) c j (.lit Q) (.lit B) (.lit ((cntG Q c j * B : ℕ) : ℤ)) := by
  unfold passG passGT bodyG bodyGT
  congr 4; congr 1
  funext v
  unfold brG brGT
  rw [sig_mod Q c v]

theorem rsim_passGT {π : PMap} (r c j : ℕ) {eQ eQ' eB eB' eC eC' : Ex HS} (hQ : ESim π eQ eQ')
    (hB : ESim π eB eB') (hC : ESim π eC eC') :
    RSim π (passGT r c j eQ eB eC) (passGT r c j eQ' eB' eC') := by
  unfold passGT bodyGT
  refine .seq (.push _ (.lit _)) (.seq (.rep _ hQ (.seq (RSim.sel _ (fun v => ?_) _ _)
    (.asg _ (ESim.refl _ _)))) (.seq (.pop _) (RSim.mvK _ _ _ hC)))
  unfold brGT
  split_ifs
  · exact .skip
  · exact RSim.mvK _ _ _ hB
  · exact RSim.mvK _ _ _ hB

/-- The stacks written by a pass are among `10 … 13, 0, 31, 33`. -/
theorem passGT_writes (r c j : ℕ) (eQ eB eC : Ex HS) (x : Fin HS)
    (hx : x ∉ ([0, 10, 11, 12, 13, 31, 33] : List (Fin HS))) : x ∉ (passGT r c j eQ eB eC).writes := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
  simp only [passGT, bodyGT, RS.writes, NLogN.mvK, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false, not_or]
  refine ⟨hx.2.2.2.2.1, ⟨hx.2.2.2.2.2.1, sel_not_writes _ _ (fun v => ?_) _ _, hx.2.2.2.2.1⟩,
    hx.2.2.2.2.1, hx.2.2.2.2.2.2, ⟨hx.1, hx.2.1⟩⟩
  unfold brGT
  split_ifs <;> simp [RS.writes, NLogN.mvK] <;> tauto

end NLogN.KIL

