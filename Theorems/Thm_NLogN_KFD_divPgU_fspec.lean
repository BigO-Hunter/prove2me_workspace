section Arith

variable {Q c : ℕ}

theorem lo_le_iff (hc : 0 < c) (j z : ℕ) : lo Q c j ≤ z ↔ j * Q ≤ c * z := by
  have e : lo Q c j ≤ z ↔ (j * Q + 0 + c - 1) / c < z + 1 := Nat.lt_succ_iff.symm
  rw [e, Nat.div_lt_iff_lt_mul hc, Nat.add_mul, Nat.one_mul, Nat.mul_comm z c]
  omega

theorem filt_eq (hc : 0 < c) (hQc : Nat.Coprime Q c) (j : ℕ) (hj : j < c) :
    (List.range Q).filter (fun y => sig Q c (y % c) = j) =
      (List.range' (lo Q c j) (lo Q c (j + 1) - lo Q c j)).map (fun z => c * z - j * Q) := by
  apply List.Pairwise.eq_of_mem_iff (r := (· < ·))
  · exact (List.pairwise_lt_range).filter _
  · rw [List.pairwise_map]
    refine List.Pairwise.imp_of_mem ?_ List.pairwise_lt_range'
    intro a b ha hb hab
    simp only [List.mem_range'_1] at ha
    have h1 := (lo_le_iff (Q := Q) hc j a).1 (by omega)
    have h2 : c * a < c * b := Nat.mul_lt_mul_of_pos_left hab hc
    omega
  · intro y
    simp only [List.mem_filter, List.mem_range, decide_eq_true_eq, List.mem_map, List.mem_range'_1]
    constructor
    · rintro ⟨hy, hs⟩
      have hsp := sig_spec hc hQc y
      rw [hs] at hsp
      obtain ⟨z, hz⟩ : c ∣ j * Q + y := Nat.dvd_of_mod_eq_zero hsp
      refine ⟨z, ⟨(lo_le_iff (Q := Q) hc j z).2 (by omega), ?_⟩, by omega⟩
      have : ¬ lo Q c (j + 1) ≤ z := fun h => by
        have := (lo_le_iff (Q := Q) hc (j + 1) z).1 h
        rw [Nat.add_mul, Nat.one_mul] at this; omega
      omega
    · rintro ⟨z, ⟨hz1, hz2⟩, rfl⟩
      have h1 := (lo_le_iff (Q := Q) hc j z).1 hz1
      have h2 : ¬ (j + 1) * Q ≤ c * z := fun h => by
        have := (lo_le_iff (Q := Q) hc (j + 1) z).2 h; omega
      rw [Nat.add_mul, Nat.one_mul] at h2
      refine ⟨by omega, ?_⟩
      symm
      apply sig_unique hc hQc hj
      rw [show j * Q + (c * z - j * Q) = c * z by omega, Nat.mul_mod_right]

theorem outD_eq (rp : ℕ → List ℤ) (hc : 0 < c) (hQc : Nat.Coprime Q c) :
    (List.range c).flatMap (flatD rp Q c) = (List.range Q).flatMap fun z => rp (c * z % Q) := by
  have e := range_tele (lo Q c) (fun j => lo_mono (Nat.le_succ j)) c
  rw [lo_zero, lo_c hc, Nat.sub_zero, ← List.range_eq_range'] at e
  rw [← e, List.flatMap_assoc]
  refine fm_congr fun j hj => ?_
  simp only [List.mem_range] at hj
  rw [flatD, filt_eq hc hQc j hj, List.flatMap_map]
  refine fm_congr fun z hz => ?_
  simp only [List.mem_range'_1] at hz
  have h1 := (lo_le_iff (Q := Q) hc j z).1 (by omega)
  have h2 : ¬ (j + 1) * Q ≤ c * z := fun h => by
    have := (lo_le_iff (Q := Q) hc (j + 1) z).2 h; omega
  rw [Nat.add_mul, Nat.one_mul] at h2
  congr 1
  have : c * z = (c * z - j * Q) + Q * j := by rw [Nat.mul_comm Q j]; omega
  rw [this, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega)]
  omega

end Arith

