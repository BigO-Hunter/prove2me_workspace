    · rw [Int.toNat_of_nonneg hR0]; omega
    · refine le_trans (NLogN.zsz_mono ?_) (show NLogN.zsz (k : ℤ) ≤ _ by omega)
      have : (((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat : ℤ) ≤ k := by omega
      omega
  generalize hS : n + NLogN.zsz (j : ℤ) + NLogN.zsz (k : ℤ) + 30 = S
  have hnS : n + 30 ≤ S := by omega
  have p1 : NLogN.octExpCost n (NLogN.zsz (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ)) (NLogN.zsz (k : ℤ)) ≤ 10 ^ 20 * (2 * S) ^ 5 := by
    unfold NLogN.octExpCost; exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 5)
  have hEB : NLogN.expB (n + 4) (3 * (n + 4) + 14 + NLogN.zsz (j : ℤ) + NLogN.zsz (k : ℤ) + 4) ≤ 11 * S ^ 2 := by
    unfold NLogN.expB; nlinarith
  have p2 : NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 6 ≤ 25 * S ^ 2 := by rw [hBdef]; nlinarith
  have p3 := Nat.pow_le_pow_left p2 2
  have p4 : (NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 2) ^ 2 ≤ (25 * S ^ 2) ^ 2 :=
    Nat.pow_le_pow_left (by omega) 2
  have e1 : (2 * S) ^ 5 = 32 * S ^ 5 := by ring
  have e2 : (25 * S ^ 2) ^ 2 = 625 * S ^ 4 := by ring
  have q4 : S ^ 4 ≤ S ^ 5 := Nat.pow_le_pow_right (by omega) (by omega)
  rw [e1] at p1; rw [e2] at p3 p4
  generalize NLogN.octExpCost n (NLogN.zsz (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ)) (NLogN.zsz (k : ℤ)) = F at hb p1
  generalize (NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 6) ^ 2 = G1 at hb p3
  generalize (NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 2) ^ 2 = G2 at hb p4
  simp only [NLogN.twiddleCost]
  rw [hS]
  generalize S ^ 5 = W at *
  generalize S ^ 4 = W4 at *
  nlinarith
end
