section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFW
open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
theorem NLogN.KFW.sdQ {σ : Fin NLogN.HS → Option ℤ} {K S r H P D ρ k q0 Bp Z : ℕ} (lo hi : ℕ)
    (hC : NLogN.KFW.CoreR σ K S r H P D ρ k q0 Bp) (hρ : ρ < K) (hS : 1 ≤ S) (hP : 1 ≤ P) (hr : 1 ≤ r)
    (hD : 1 ≤ D) (hZ16 : NLogN.zsz ((16 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFW.SImplQ Isym tbl (fun s => NLogN.KFW.Agree σ s) lo hi r (fun x : Fin D => NLogN.KFH.stT K D S ρ x)
      (P * 2 ^ (K * D) * S) (Butterfly.SD : Matrix (Fin D → Fin 2) (Fin D → Fin 2) ℂ) NLogN.KFW.sdC 0 0
      (fun w => NLogN.KFW.cSD K S r P D Z w) := by
  obtain ⟨b1, b2, b3, b4, b5⟩ := NLogN.KFW.layer_bounds (K := K) (D := D) hS hP hr
  set N := P * 2 ^ (K * D) * S * r with hN
  have zb : ∀ x : ℕ, x ≤ 16 * N → NLogN.zsz (x : ℤ) ≤ Z := fun x hx => le_trans (NLogN.zsz_natCast_le hx) hZ16
  have hK : 1 ≤ K := by omega
  have hKN : K ≤ N := by
    have : K ≤ K * D := Nat.le_mul_of_pos_right _ hD
    omega
  have hDN : D ≤ N := by
    have : D ≤ K * D := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hKDN : K * D ≤ N := by omega
  have hKZ : K * D + 1 ≤ Z := by
    have h1 : 2 ^ (K * D) ≤ 16 * N := by omega
    have h2 := NLogN.lt_two_pow_zsz (16 * N)
    have h3 : 2 ^ (K * D) < 2 ^ Z :=
      lt_of_lt_of_le (lt_of_le_of_lt h1 h2) (Nat.pow_le_pow_right (by norm_num) hZ16)
    have := (Nat.pow_lt_pow_iff_right (by norm_num)).1 h3
    omega
  have hσ0 : σ 0 = none := hC.base.off 0 (by (try dsimp only); decide)
  -- the frame values
  have rK := NLogN.KFW.ExV.reg (B := Z) hC.hK (zb K (by omega))
  have rS := NLogN.KFW.ExV.reg (B := Z) hC.hS (zb S (by have : S ≤ S * r := Nat.le_mul_of_pos_right _ hr; omega))
  have rr := NLogN.KFW.ExV.reg (B := Z) hC.hr (zb r (by have : r ≤ S * r := Nat.le_mul_of_pos_left _ hS; omega))
  have rP := NLogN.KFW.ExV.reg (B := Z) hC.hP (zb P (by omega))
  have rD := NLogN.KFW.ExV.reg (B := Z) hC.hD (zb D (by omega))
  have rρ := NLogN.KFW.ExV.reg (B := Z) hC.hρ (zb ρ (by omega))
  have eSr : NLogN.KFW.ExV σ (.mul (.reg 3) (.reg 4)) ((S * r : ℕ) : ℤ) Z :=
    (NLogN.KFW.ExV.mul rS rr (NLogN.KFW.zszN (n := S * r) (by push_cast; ring) (by omega) hZ16)).congr (by push_cast; ring)
  have eKD : NLogN.KFW.ExV σ (.mul (.reg 1) (.reg 22)) ((K * D : ℕ) : ℤ) Z :=
    (NLogN.KFW.ExV.mul rK rD (NLogN.KFW.zszN (n := K * D) (by push_cast; ring) (by omega) hZ16)).congr (by push_cast; ring)
  have e0 : NLogN.KFW.ExV σ (.lit 0) ((0 % 4 : ℕ) : ℤ) Z :=
    NLogN.KFW.ExV.lit (NLogN.KFW.zszN (n := 0) (by simp) (Nat.zero_le _) hZ16) |>.congr (by simp)
  have ep : NLogN.KFW.ExV σ (.pow2 (.mul (.reg 1) (.reg 22))) ((2 ^ (K * D) : ℕ) : ℤ) Z := by
    have := NLogN.KFW.ExV.pow2 eKD (by positivity) (by rw [Int.toNat_natCast]; exact hKZ)
    rw [Int.toNat_natCast] at this
    exact this.congr (by push_cast; ring)
  have eV : NLogN.KFW.ExV σ (.mul (.lit 2) (.mul (.reg 21) (.mul (.mul (.reg 3) (.reg 4))
      (.pow2 (.mul (.reg 1) (.reg 22)))))) ((2 * (P * (S * r * 2 ^ (K * D))) : ℕ) : ℤ) Z := by
    have hn1 : P * (S * r * 2 ^ (K * D)) = N := by rw [hN]; ring
    have m1 := NLogN.KFW.ExV.mul eSr ep (NLogN.KFW.zszN (n := S * r * 2 ^ (K * D)) (by push_cast; ring)
      (by rw [hn1.symm] at *; have := Nat.le_mul_of_pos_left (S * r * 2 ^ (K * D)) (by omega : 0 < P); omega) hZ16)
    have m2 := NLogN.KFW.ExV.mul rP m1 (NLogN.KFW.zszN (n := N) (by rw [← hn1]; push_cast; ring) (by omega) hZ16)
    have m3 := NLogN.KFW.ExV.mul (NLogN.KFW.ExV.lit (σ := σ) (c := 2) (NLogN.KFW.zszN (n := 2) (by norm_num) (by omega) hZ16)) m2
      (NLogN.KFW.zszN (n := 2 * N) (by rw [← hn1]; push_cast; ring) (by omega) hZ16)
    exact m3.congr (by push_cast; ring)
  have ee : NLogN.KFW.ExV σ (.add (.add (.reg 23) (.mul (.reg 1) (.reg 22))) (.neg (.reg 1)))
      ((ρ + K * (D - 1) : ℕ) : ℤ) Z := by
    have hKD1 : K * (D - 1) + K = K * D := by
      rw [← Nat.mul_succ]; congr 1; omega
    have a1 := NLogN.KFW.ExV.add rρ eKD (NLogN.KFW.zszN (n := ρ + K * D) (by push_cast; ring) (by omega) hZ16)
    have a2 := NLogN.KFW.ExV.add a1 rK.neg (NLogN.KFW.zszN (n := ρ + K * (D - 1)) (by push_cast; omega) (by omega) hZ16)
    exact a2.congr (by push_cast; omega)
  set l := NLogN.KFW.sdL K S r P D ρ with hl
  have hok : NLogN.KFW.FrXOK σ Z 16 l := by
    intro x hx
    simp only [hl, NLogN.KFW.sdL, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl
    · exact ⟨by (try dsimp only); decide, NLogN.KFW.clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eSr⟩
    · exact ⟨by (try dsimp only); decide, NLogN.KFW.clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eKD⟩
    · exact ⟨by (try dsimp only); decide, NLogN.KFW.clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, e0⟩
    · exact ⟨by (try dsimp only); decide, NLogN.KFW.clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eV⟩
    · exact ⟨by (try dsimp only); decide, NLogN.KFW.clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, ee⟩
  have hnr : NLogN.KFW.NoRd [] l := by
    simp only [hl, NLogN.KFW.sdL, NLogN.KFW.NoRd]
    refine ⟨by (try dsimp only); decide, by (try dsimp only); decide, by (try dsimp only); decide, by (try dsimp only); decide, by (try dsimp only); decide, trivial⟩
  have h0 : ∀ x ∈ l, x.1 ≠ 0 := by
    intro x hx
    simp only [hl, NLogN.KFW.sdL, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl <;> ((try dsimp only); decide)
  -- the pushed assignment
  set vl := l.map (fun x => (x.1, x.2.2)) with hvl
  set σ' := NLogN.KFW.σPush σ vl with hσ'
  have hkeys : ∀ p ∈ vl, p.1 ∈ NLogN.KFW.scr := by
    intro p hp
    simp only [hvl, hl, NLogN.KFW.sdL, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil,
      or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl <;> ((try dsimp only); decide)
  have hC' : NLogN.KFW.CoreR σ' K S r H P D ρ k q0 Bp := hC.push vl hkeys
  have hnd : (vl.map Prod.fst).Nodup := by
    simp only [hvl, hl, NLogN.KFW.sdL, List.map_cons, List.map_nil]; decide
  have mem : ∀ i v, (i, v) ∈ vl → σ' i = some v := fun i v h => NLogN.KFW.σPush_mem _ σ _ _ hnd h
  have hR : NLogN.KFW.PReg σ' 12 13 21 14 15 (S * r) (K * D) P 0 := by
    refine ⟨NLogN.KFW.sclean_of_lt hC'.base.lt, hC'.base.offp, mem _ _ (by simp [hvl, hl, NLogN.KFW.sdL]),
      hC'.base.lt, mem _ _ (by simp [hvl, hl, NLogN.KFW.sdL]), hC'.hP, mem _ _ (by simp [hvl, hl, NLogN.KFW.sdL]),
      mem _ _ (by simp [hvl, hl, NLogN.KFW.sdL])⟩
  have hAff : NLogN.KFW.AffReg σ' 16 1 22 (ρ + K * (D - 1)) K D :=
    ⟨mem _ _ (by simp [hvl, hl, NLogN.KFW.sdL]), hC'.hK, hC'.hD, by (try dsimp only); decide, by (try dsimp only); decide, by (try dsimp only); decide⟩
  set pos : Fin D → ℕ := fun i => ρ + K * (D - (i.val + 1)) with hpos
  have hposE : (fun i : Fin D => ρ + K * (D - 1) - K * ((Equiv.refl (Fin D)) i).val) = pos := by
    funext i
    simp only [hpos, Equiv.refl_apply]
    have hi := i.isLt
    have : K * (D - (i.val + 1)) + K * i.val = K * (D - 1) := by
      rw [← Nat.mul_add]; congr 1; omega
    omega
  have hε : ∀ s, NLogN.KFW.Agree σ' s → NLogN.KFW.EpsOK s NLogN.KFW.εSD (K * D) (NLogN.KFN.aEof pos (fun _ => 1)) Z := by
    intro s hs
    have := NLogN.KFW.epsOK_lit hs hAff (by (try dsimp only); decide) (by omega) (Equiv.refl (Fin D)) (by omega) 1 (K * D) Z
      (zb _ (by
        have : ρ + K * (D - 1) ≤ K * D := by
          have : K * (D - 1) + K = K * D := by rw [← Nat.mul_succ]; congr 1; omega
          omega
        omega))
      (zb _ (by omega))
    rw [hposE] at this
    exact this
  have hreg : ∀ j ∈ NLogN.KFW.εSD.regs, j ∉ [NLogN.KFG.xA, NLogN.KFG.xB, NLogN.KFG.xC, NLogN.KFG.xD, NLogN.KFG.xN, NLogN.KFB.c1, NLogN.KFW.xE, NLogN.KFW.cT] := by
    intro j hj
    rcases NLogN.KFW.εLit_regs _ _ _ _ j hj with rfl | rfl | rfl | rfl <;> ((try dsimp only); decide)
  have hε0 : (0 : Fin NLogN.HS) ∉ NLogN.KFW.εSD.regs := by
    intro hj
    rcases NLogN.KFW.εLit_regs _ _ _ _ _ hj with h | h | h | h <;> exact absurd h (by (try dsimp only); decide)
  have hposlt : ∀ i, pos i < K * D := by
    intro i
    simp only [hpos]
    have hi := i.isLt
    have : K * (D - (i.val + 1)) + K ≤ K * D := by
      rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left _ (by omega)
    omega
  have hZph : NLogN.zsz ((4 * (P * (S * r * 2 ^ (K * D)) + S * r + P + 1) : ℕ) : ℤ) ≤ Z := by
    apply zb
    have : P * (S * r * 2 ^ (K * D)) = N := by rw [hN]; ring
    omega
  have Hph := NLogN.KFW.sImplQ_phase (Is := Isym) (iprog := tbl) (Q := fun s => NLogN.KFW.Agree σ' s) (lo := lo)
    (hi := hi) r S (K * D) P 0 pos hposlt (fun _ => 1) (by omega) (by omega) hP Z hZph hR
    (fun s hs => hs) NLogN.KFW.εSD Z hε (zb 4 (by omega)) hreg hε0 (by (try dsimp only); decide)
  have Hf := NLogN.KFW.sImplQ_frX (I := Isym) (iprog := tbl) (lo := lo) (hi := hi) hσ0 l Z 16 hok hnr h0 Hph
  have hst : (fun i : Fin D => 2 ^ pos i * S) = (fun x : Fin D => NLogN.KFH.stT K D S ρ x) := by
    funext i; rw [NLogN.KFW.stT_eq]
  rw [hst, ← NLogN.KFW.SD_eq, hl, NLogN.KFW.sdL_E] at Hf
  have hlen : (NLogN.KFW.sdL K S r P D ρ).length = 5 := rfl
  rw [hlen] at Hf
  exact Hf
end
