namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFN

theorem εLit_regs (eR KR NR : Fin HS) (c : ℤ) (j : Fin HS) (hj : j ∈ (εLit eR KR NR c).regs) :
    j = eR ∨ j = NLogN.KFW.kS ∨ j = KR ∨ j = NR := by
  rcases εAff_regs _ _ _ _ j hj with h | h | h | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr h))
  · simp [Ex.regs] at h

/-- **`EpsOK` for a constant exponent** on the bits `pos i = e - K φ(i)`. -/
theorem epsOK_lit {ι : Type*} [Fintype ι] {σ : Fin HS → Option ℤ} {s : IState HS}
    (hs : Agree σ s) {eR KR NR : Fin HS} {e K N : ℕ} (hR : AffReg σ eR KR NR e K N)
    (hlt : eR.val < 56 ∧ KR.val < 56 ∧ NR.val < 56)
    (hK : 0 < K) (φ : ι ≃ Fin N) (hN : K * (N - 1) ≤ e) (c : ℕ) (t Bε : ℕ)
    (hB : zsz (((e + t + K + N : ℕ)) : ℤ) ≤ Bε) (hc : zsz ((c % 4 : ℕ) : ℤ) ≤ Bε) :
    EpsOK s (εLit eR KR NR ((c % 4 : ℕ) : ℤ)) t
      (aEof (fun i => e - K * (φ i).val) (fun _ => c)) Bε := by
  refine ⟨clean_of_lt (fun j hj => ?_), fun k hk g hgk hfr => ?_⟩
  · rcases εLit_regs _ _ _ _ j hj with rfl | rfl | rfl | rfl
    · exact hlt.1
    · decide
    · exact hlt.2.1
    · exact hlt.2.2
  have mem : ∀ j, (j = eR ∨ j = KR ∨ j = NR) → j ∈ (εLit eR KR NR ((c % 4 : ℕ) : ℤ)).regs := by
    intro j hj; simp only [εLit, εAff, εD, Ex.regs, List.mem_append, List.mem_cons]; tauto
  obtain ⟨t1, t2, t3, t4, t5, t6, t7, t8⟩ := aff_tops hs hR hgk
    (hfr _ (mem _ (Or.inl rfl)) hR.eS) (hfr _ (mem _ (Or.inr (Or.inl rfl))) hR.KS)
    (hfr _ (mem _ (Or.inr (Or.inr rfl))) hR.NS)
  obtain ⟨o, ev, b⟩ := εAff_spec (NLogN.KIL.encK s g) eR KR NR (fun _ => .lit ((c % 4 : ℕ) : ℤ)) e k K N Bε
    hK t1 t2 t3 t4 t5 t6 t7 t8 (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hB) (fun _ => ((c % 4 : ℕ) : ℤ))
    (fun x q _ _ _ _ => ⟨trivial, rfl, hc⟩)
  refine ⟨o, ?_, b⟩
  rw [εLit, ev, aEof_equiv K e N hK φ hN]
  split_ifs <;> simp

end NLogN.KFW

