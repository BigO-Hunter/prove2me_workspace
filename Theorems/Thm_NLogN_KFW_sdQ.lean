  rw [b] at this
  exact this

section Frames

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {lo hi r : ℕ} {st : ι → ℕ} {n : ℕ}

/-- **An expression frame** around an `SImplQ` statement. -/
theorem sImplQ_frX {σ : Fin HS → Option ℤ} (hσ0 : σ 0 = none) (l : List (Fin HS × Ex HS × ℤ))
    (B sz : ℕ) (h : FrXOK σ B sz l) (hn : NoRd [] l) (h0 : ∀ x ∈ l, x.1 ≠ 0)
    {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {U : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (H : SImplQ I iprog (fun s => Agree (σPush σ (l.map fun x => (x.1, x.2.2))) s) lo hi r st n T
      U e dw cost) :
    SImplQ I iprog (fun s => Agree σ s) lo hi r st n T
      (withPushI (l.map fun x => (x.1, x.2.1)) U) e dw
      (fun w => cFrame l.length sz B + cost w + (l.length * (2 * B + 2) + 1)) := by
  have hP := pushSeq_of σ B sz [] l σ (fun _ _ => rfl) h hn
  have := sImplQ_push σ hσ0 (fun s h => h) _ _ _ B hP
    (by
      simp only [List.map_map]; intro hm
      obtain ⟨x, hx, e⟩ := List.mem_map.1 hm
      exact h0 x hx e)
    (frX_zsz h) (fun s hs => agree_pushSt' _ hs) H
  simp only [List.length_map] at this
  exact this

end Frames

theorem sdL_E (K S r P D ρ : ℕ) : (sdL K S r P D ρ).map (fun x => (x.1, x.2.1)) = sdE := rfl

theorem stT_eq {K D S ρ : ℕ} (i : Fin D) :
    KFH.stT K D S ρ i = 2 ^ (ρ + K * (D - (i.val + 1))) * S := by
  rw [KFH.stT, stS_eq K D S i i.isLt, pow_add, ← pow_mul]; ring

theorem SD_eq {D : ℕ} : (Butterfly.SD : Matrix (Fin D → Fin 2) (Fin D → Fin 2) ℂ) =
    Matrix.diagonal fun x => I ^ (0 + ∑ i, 1 * (x i).val) := by
  simp [Butterfly.SD, wt]

/-- Size bounds of the layer. -/
theorem layer_bounds {K S r P D : ℕ} (hS : 1 ≤ S) (hP : 1 ≤ P) (hr : 1 ≤ r) :
    1 ≤ P * 2 ^ (K * D) * S * r ∧ S * r ≤ P * 2 ^ (K * D) * S * r ∧
    P ≤ P * 2 ^ (K * D) * S * r ∧ 2 ^ (K * D) ≤ P * 2 ^ (K * D) * S * r ∧
    K * D < 2 ^ (K * D) := by
  have h2 : 1 ≤ 2 ^ (K * D) := Nat.one_le_two_pow
  have hKD : K * D < 2 ^ (K * D) := Nat.lt_two_pow_self
  have a1 : 1 ≤ P * 2 ^ (K * D) := Nat.mul_le_mul hP h2
  refine ⟨?_, ?_, ?_, ?_, hKD⟩
  · have := Nat.mul_le_mul (Nat.mul_le_mul a1 hS) hr; simpa using this
  · have := Nat.mul_le_mul_right (S * r) a1
    calc S * r = 1 * (S * r) := (one_mul _).symm
      _ ≤ P * 2 ^ (K * D) * (S * r) := this
      _ = _ := by ring
  · have : 1 ≤ 2 ^ (K * D) * S * r := by
      have := Nat.mul_le_mul (Nat.mul_le_mul h2 hS) hr; simpa using this
    have := Nat.mul_le_mul_left P this
    calc P = P * 1 := (mul_one _).symm
      _ ≤ P * (2 ^ (K * D) * S * r) := this
      _ = _ := by ring
  · have : 1 ≤ P * S * r := by
      have := Nat.mul_le_mul (Nat.mul_le_mul hP hS) hr; simpa using this
    have := Nat.mul_le_mul_left (2 ^ (K * D)) this
    calc 2 ^ (K * D) = 2 ^ (K * D) * 1 := (mul_one _).symm
      _ ≤ 2 ^ (K * D) * (P * S * r) := this
      _ = _ := by ring

