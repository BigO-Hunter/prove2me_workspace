set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD KFE KFB AModel AModelL12 NetProp7
theorem NLogN.KFL.swI_spec :
    ∃ T q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u : ℕ) (Pre G Suf : AModel.Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List NLogN.Sym) (t : NLogN.IState NLogN.HS) (xs : List (ZMod 2)) (R : List NLogN.Item),
      t.G 0 = NLogN.ints (NLogN.KIL.enc2 xs) ++ R →
      xs.length = AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) →
      ∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFL.swI q (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u) t
        (t.upd 0 (NLogN.ints (AModel.pull (AModelL12.binShape Pre G Suf (2 ^ u)) (AModelL12.binShape Pre G Suf (2 ^ u))
          (AModel.swapPos Pre.length (Pre.length + 1 + G.length)) 0 (NLogN.KIL.enc2 xs)) ++ R)) c ∧
        (c : ℝ) ≤ K * ((AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) + 1) *
          (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  obtain ⟨T, q₀, H⟩ := NLogN.KFB.lemma12_fine_canon
  refine ⟨T, q₀, fun q hq hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q hq hq₀
  obtain ⟨D, hD0, hD⟩ := NLogN.KFB.overhead_le 0 0
  refine ⟨K + 10 ^ 8 * D, by positivity, fun u Pre G Suf hu hPre hG hS I t xs R h0 hxs => ?_⟩
  set V := AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) with hVdef
  have hV1 : 1 ≤ V := le_trans Nat.one_le_two_pow (NLogN.KFE.two_pow_le_vol Pre G Suf hPre hG hS)
  have hzV := NLogN.KFE.succ_le_zsz_vol (u := u) Pre G Suf hPre hG hS
  set Bb := NLogN.zsz (V : ℤ)
  have hP1 := NLogN.KIL.one_le_vol hPre
  have hG1 := NLogN.KIL.one_le_vol hG
  have hS1 := NLogN.KIL.one_le_vol hS
  have hVe : V = AModel.vol Pre * (2 ^ u * (AModel.vol G * (2 ^ u * AModel.vol Suf))) := NLogN.KIL.vol_binShape _ _ _ _
  have hpu : 1 ≤ 2 ^ u := Nat.one_le_two_pow
  have lP : AModel.vol Pre ≤ V := by
    rw [hVe]; exact Nat.le_mul_of_pos_right _ (by positivity)
  have lG : AModel.vol G ≤ V := by
    rw [hVe]
    calc AModel.vol G ≤ 2 ^ u * (AModel.vol G * (2 ^ u * AModel.vol Suf)) := by
          have : AModel.vol G ≤ AModel.vol G * (2 ^ u * AModel.vol Suf) := Nat.le_mul_of_pos_right _ (by positivity)
          exact le_trans this (Nat.le_mul_of_pos_left _ (by positivity))
      _ ≤ _ := Nat.le_mul_of_pos_left _ (by omega)
  have lS : AModel.vol Suf ≤ V := by
    rw [hVe]
    calc AModel.vol Suf ≤ 2 ^ u * (AModel.vol G * (2 ^ u * AModel.vol Suf)) := by
          have : AModel.vol Suf ≤ 2 ^ u * AModel.vol Suf := Nat.le_mul_of_pos_left _ (by positivity)
          have : 2 ^ u * AModel.vol Suf ≤ AModel.vol G * (2 ^ u * AModel.vol Suf) := Nat.le_mul_of_pos_left _ (by omega)
          exact le_trans ‹vol Suf ≤ _› (le_trans this (Nat.le_mul_of_pos_left _ (by positivity)))
      _ ≤ _ := Nat.le_mul_of_pos_left _ (by omega)
  have lu : u ≤ V := le_trans (le_of_lt Nat.lt_two_pow_self)
    (NLogN.KFE.two_pow_le_vol Pre G Suf hPre hG hS)
  set s := t.upd 0 R
  set F := NLogN.KFL.Fsw (NLogN.KIL.enc2 xs) (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u
  obtain ⟨c, Hc, hc⟩ := HK u Pre G Suf hu hPre hG hS I s F xs [] [] [] []
    (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw])
    (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw])
    (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw])
    (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw])
    (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw]) (by simp +decide [F, NLogN.KFL.Fsw]) hxs
  set ys := AModel.pull (AModelL12.binShape Pre G Suf (2 ^ u)) (AModelL12.binShape Pre G Suf (2 ^ u))
    (AModel.swapPos Pre.length (Pre.length + 1 + G.length)) 0 (NLogN.KIL.enc2 xs)
  rw [NLogN.KFL.update_Fsw, NLogN.KFL.enc2_pull] at Hc
  have ev : NLogN.KIL.evalP t (NLogN.KFL.swL (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u) =
      [(NLogN.KIL.kP, ((AModel.vol Pre : ℕ) : ℤ)), (NLogN.KIL.kG, ((AModel.vol G : ℕ) : ℤ)), (NLogN.KIL.kS, ((AModel.vol Suf : ℕ) : ℤ)), (NLogN.KIL.aU, (u : ℤ))] := by
    simp [NLogN.KIL.evalP, NLogN.KFL.swL, NLogN.Ex.eval]
  have eIn : NLogN.KIL.encK s F = NLogN.KIL.pushSt t (NLogN.KIL.evalP t (NLogN.KFL.swL (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u)) := by
    rw [ev, NLogN.KFL.encK_Fsw]
    conv_rhs => rw [← NLogN.KFL.upd_self (NLogN.KIL.pushSt _ _) 0]
    congr 1
    rw [NLogN.KIL.pushSt_G_of_not_mem _ _ _ (by simp +decide), h0]
  have eOut : NLogN.KIL.encK s (NLogN.KFL.Fsw ys (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u) =
      (NLogN.KIL.pushSt t (NLogN.KIL.evalP t (NLogN.KFL.swL (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u))).upd 0 (NLogN.ints ys ++ R) := by
    rw [ev, NLogN.KFL.encK_Fsw]
  rw [eIn, eOut] at Hc
  have hz : ∀ x : ℕ, x ≤ V → NLogN.zsz (x : ℤ) ≤ Bb := fun x hx => NLogN.KIL.zsz_nat_le hx
  have hl : NLogN.KIL.PushOK t Bb (NLogN.KFL.swL (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u) := by
    intro p hp
    simp only [NLogN.KFL.swL, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl <;>
      refine ⟨by dsimp only; decide, NLogN.KIL.clean_lit _, by simp [NLogN.Ex.regs], trivial, ?_⟩ <;>
      simp only [NLogN.Ex.Bnd] <;> apply hz <;> assumption
  have hv : ∀ p ∈ NLogN.KFL.swL (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u, NLogN.zsz (p.2.eval t) ≤ Bb := by
    intro p hp
    simp only [NLogN.KFL.swL, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl <;> simp only [NLogN.Ex.eval] <;> apply hz <;> assumption
  have W := NLogN.KFD.IRuns.withPushI (I := I) (iprog := NLogN.KFL.l12prog) _ (NLogN.KFL.l12C q) t Bb hl hv (by simp +decide [NLogN.KFL.swL]) ys R c Hc
  refine ⟨_, W, ?_⟩
  -- cost
  have hpc : NLogN.KIL.pushCost Bb (NLogN.KFL.swL (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u) = 8 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 := by
    -- (`simp` with `List.sum_cons` here produces a proof term too large to serialize)
    rw [NLogN.KIL.pushCost]; simp only [NLogN.KFL.swL, List.map_cons, List.map_nil, NLogN.Ex.size]
    rw [List.sum_cons, List.sum_cons, List.sum_cons, List.sum_cons, List.sum_nil]; ring
  have hl4 : (NLogN.KFL.swL (AModel.vol Pre) (AModel.vol G) (AModel.vol Suf) u).length = 4 := rfl
  rw [hpc, hl4]
  have hov := hD 0 V Bb hV1 (by omega) (by omega)
  rw [← hVdef] at hc
  clear_value Bb V
  exact NLogN.KFL.cost_absorb hu hK hD0 (by simpa using hov) hc
end
