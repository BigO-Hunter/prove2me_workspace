namespace IntMul.Kappa.R6.IL3F

open IntMul NLogN RS AModel NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH Complex P8Lift Butterfly
  NLogN.KFN NLogN.KFR

variable {K m F e : ℕ} [NeZero F] {pos : Fin m × Fin F → ℕ}

/-- **Bit `f-1-u` of row `r` sits at `sR r + ρ' + uK`.** -/
theorem pos_eq_sRF (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) (r : Fin m) {u : ℕ}
    (hu : u < F) : pos (r, ⟨F - 1 - u, by omega⟩) = sR K (F) e r + e % K + u * K := by
  have h0 := sR_addF he r
  have h1 : pos (r, ⟨F - 1 - u, by omega⟩) + K * (F - 1 - u + F * r.val) = e := he _
  have e1 : F - 1 - u + F * r.val = (F * (r.val + 1) - 1) - u := by
    rw [Nat.mul_succ]; omega
  have e2 : K * u ≤ K * (F * (r.val + 1) - 1) :=
    Nat.mul_le_mul_left _ (by rw [Nat.mul_succ]; omega)
  rw [e1, Nat.mul_sub] at h1
  rw [Nat.mul_comm u K]
  have h2 := rowE_leF he r
  omega

section Shape

variable {t S0 B : ℕ} {σ : Fin 3 → Fin m}
  (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) (htop : e - e % K + K ≤ t)
  (hσ : σ 0 < σ 1 ∧ σ 1 < σ 2)
include he htop hσ

theorem shR_fieldF (τ : Fin 3) : (shR K (F) e t S0 B σ).getD (slotF τ) 0 = 2 ^ (F * K) := by
  fin_cases τ <;> simp [shR, rect, slotF]

theorem shR_lengthF : (shR K (F) e t S0 B σ).length = 7 := by simp [shR, rect]

theorem shR_digitF {q : ℕ} (hq : q < B * 2 ^ t * S0) (τ : Fin 3) :
    (decode (shR K (F) e t S0 B σ) q).getD (slotF τ) 0 =
      q / (2 ^ sR K (F) e (σ τ) * S0) % 2 ^ (F * K) := by
  have hq' : q < vol (shR K (F) e t S0 B σ) := by rw [shR_volF he htop hσ]; exact hq
  have hv := valid_decode hq'
  rw [getD_digit _ _ _ hv (by rw [hv.length_eq, shR_lengthF he htop hσ]; fin_cases τ <;> simp [slotF]),
    encode_decode hq', shR_weightF he htop hσ, shR_fieldF he htop hσ]

/-- **The packed row addition is the selected-bit address map of `rowAddr`.** -/
theorem encode_rowAddAddrF (hK : 1 ≤ K) {q : ℕ} (hq : q < B * 2 ^ t * S0) {px py : Fin 3}
    {i j : Fin m} (hi : σ px = i) (hj : σ py = j) (hij : i ≠ j) :
    ((encode (shR K (F) e t S0 B σ)
        (rowAddAddr K (e % K) (F) px py (decode (shR K (F) e t S0 B σ) q)) : ℕ) : ℤ) =
      fsetZ (fun p => 2 ^ pos p * S0) q (rowAddr i j (fbit (fun p => 2 ^ pos p * S0) q)) := by
  subst hi hj
  have hq' : q < vol (shR K (F) e t S0 B σ) := by rw [shR_volF he htop hσ]; exact hq
  have hv := valid_decode hq'
  have hlen : (decode (shR K (F) e t S0 B σ) q).length = 7 := by
    rw [hv.length_eq, shR_lengthF he htop hσ]
  unfold rowAddAddr
  rw [encode_set _ _ _ _ (by rw [hlen]; fin_cases py <;> simp [slotF])
      (by rw [hlen, shR_lengthF he htop hσ]), encode_decode hq',
    shR_digitF he htop hσ hq px, shR_digitF he htop hσ hq py, shR_weightF he htop hσ,
    xor_mask_sub hK (Nat.mod_lt _ (by omega)) le_rfl (Nat.mod_lt _ (by positivity))
      (Nat.mod_lt _ (by positivity)),
    fsetZ_rowAddr _ q _ _ hij, Finset.sum_mul]
  congr 1
  refine Finset.sum_congr rfl fun u hu => ?_
  have hu : u < F := Finset.mem_range.1 hu
  have hl : e % K + u * K < F * K := by
    have := Nat.mod_lt e (show 0 < K by omega)
    have : (u + 1) * K ≤ F * K := Nat.mul_le_mul_right _ hu
    rw [Nat.succ_mul] at this; omega
  rw [bitZ_xor_digit hl, bitZ_digit hl]
  unfold rowTerm
  rw [dif_pos (by omega)]
  have hW : ∀ r : Fin m, 2 ^ sR K (F) e r * S0 * 2 ^ (e % K + u * K) =
      2 ^ pos (r, ⟨F - 1 - u, by omega⟩) * S0 := fun r => by
    rw [pos_eq_sRF he r hu, add_assoc, pow_add]; ring
  rw [hW, hW, mul_assoc]
  congr 1
  simp only []; rw [← hW (σ py)]; push_cast; ring

end Shape

end IntMul.Kappa.R6.IL3F

