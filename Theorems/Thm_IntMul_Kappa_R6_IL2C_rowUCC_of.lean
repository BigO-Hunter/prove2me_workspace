variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ} {m : ℕ}

/-! ## The Lemma 13 cost in the `RowUC` form -/

theorem posR_lt' {K e k t : ℕ} (hK : 1 ≤ K) (het : e - e % K + K ≤ t) (p : Fin m × Fin (m ^ k)) :
    posR m K e k p < t := by
  unfold posR
  have := Nat.mod_lt e (by omega : 0 < K)
  have := Nat.mod_le e K
  omega

theorem posR_inj' {K e k : ℕ} (hK : 1 ≤ K) (he : K * (m ^ k * m - 1) ≤ e) :
    Function.Injective (posR m K e k) := by
  intro p p' h
  have a := posR_he he p
  have b := posR_he he p'
  rw [h] at a
  have h1 : K * (p.2.val + m ^ k * p.1.val) = K * (p'.2.val + m ^ k * p'.1.val) := by omega
  have h2 := Nat.eq_of_mul_eq_mul_left (by omega) h1
  have hf : 0 < m ^ k := Nat.pow_pos (by have := p.1.isLt; omega)
  have hd : ∀ x : Fin m × Fin (m ^ k), (x.2.val + m ^ k * x.1.val) / m ^ k = x.1.val ∧
      (x.2.val + m ^ k * x.1.val) % m ^ k = x.2.val := fun x => by
    constructor
    · rw [Nat.add_mul_div_left _ _ hf, Nat.div_eq_of_lt x.2.isLt, zero_add]
    · rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt x.2.isLt]
  have e1 := (hd p).1; have e2 := (hd p').1; have e3 := (hd p).2; have e4 := (hd p').2
  rw [h2] at e1 e3
  exact Prod.ext (Fin.ext (e1.symm.trans e2)) (Fin.ext (e3.symm.trans e4))

