set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW KFH AModel Butterfly KFN P8Lift

theorem posR_lt' {K e k t : ℕ} (hK : 1 ≤ K) (het : e - e % K + K ≤ t) (p : Fin mC × Fin (mC ^ k)) :
    posR K e k p < t := by
  unfold posR
  have := Nat.mod_lt e (by omega : 0 < K)
  have := Nat.mod_le e K
  omega

theorem posR_inj' {K e k : ℕ} (hK : 1 ≤ K) (he : K * (mC ^ k * mC - 1) ≤ e) :
    Function.Injective (posR K e k) := by
  intro p p' h
  have a := posR_he he p
  have b := posR_he he p'
  rw [h] at a
  have h1 : K * (p.2.val + mC ^ k * p.1.val) = K * (p'.2.val + mC ^ k * p'.1.val) := by omega
  have h2 := Nat.eq_of_mul_eq_mul_left (by omega) h1
  have hf : 0 < mC ^ k := by positivity
  have hd : ∀ x : Fin mC × Fin (mC ^ k), (x.2.val + mC ^ k * x.1.val) / mC ^ k = x.1.val ∧
      (x.2.val + mC ^ k * x.1.val) % mC ^ k = x.2.val := fun x => by
    constructor
    · rw [Nat.add_mul_div_left _ _ hf, Nat.div_eq_of_lt x.2.isLt, zero_add]
    · rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt x.2.isLt]
  have e1 := (hd p).1; have e2 := (hd p').1; have e3 := (hd p).2; have e4 := (hd p').2
  rw [h2] at e1 e3
  exact Prod.ext (Fin.ext (e1.symm.trans e2)) (Fin.ext (e3.symm.trans e4))

