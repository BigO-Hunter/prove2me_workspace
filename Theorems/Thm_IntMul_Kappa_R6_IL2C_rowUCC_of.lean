/-!
# KFN: selected-bit operators by record strides

A selected-bit operator on a record array only needs, for every selected bit `i`, its record
stride `st i`: bit `i` of record `j` is `j / st i % 2` (`fbit`), and setting the selected bits to
`y` moves to record `fset st j y = j + Σ_i (y_i - bit_i) st_i`.  `selOpF st n T xs` is the
selected-bit operator in these terms.

* `SLaws st n`: the strides are those of a genuine selected-bit structure on `n` records
  (`fset` stays below `n` and reads back `y`).
* `selOpF_mul`, `selOpF_one`, `selOpF_diagonal`: the operator calculus.
* `StrideSel Sb st`: a `SelBits` structure whose bits/sets are given by the strides;
  `selOp_eq_selOpF` and `slaws_of_strideSel`.
* `strideSel_layer`: the layer layout `[P] × [2^K]^D × [S]` has strides `stT K D S ρ i`
  (independent of `P`).
* `subOp g T` (`T` on the bits `g κ`, identity elsewhere) and **`selOpF_subOp`**:
  `selOpF st n (subOp g T) = selOpF (st ∘ g) n T`.  This one lemma gives reindexing
  (`g` an equivalence, `subOp_tens`), the child slots (`slotOp_eq_subOp`) and the pieces
  (`embed_eq_subOp`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open AModel Matrix Finset

section Basic

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem fset_cast {st : ι → ℕ} {n : ℕ} (h : SLaws st n) {j : ℕ} (hj : j < n) (y : ι → Fin 2) :
    ((fset st j y : ℕ) : ℤ) = fsetZ st j y := Int.toNat_of_nonneg (h.nonneg j hj y)

theorem SLaws.set_set {st : ι → ℕ} {n : ℕ} (h : SLaws st n) {j : ℕ} (hj : j < n)
    (y z : ι → Fin 2) : fset st (fset st j y) z = fset st j z := by
  have h1 := fset_cast h hj y
  have hb := h.bit_set j hj y
  have e : fsetZ st (fset st j y) z = fsetZ st j z := by
    unfold fsetZ
    rw [hb, h1]
    unfold fsetZ
    rw [add_assoc, ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  show (fsetZ st (fset st j y) z).toNat = (fsetZ st j z).toNat
  rw [e]

variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

theorem getD_selOpF (st : ι → ℕ) (n : ℕ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ)
    (xs : List M) {j : ℕ} (hj : j < n) :
    (selOpF st n T xs).getD j 0 = ∑ y, T (fbit st j) y • xs.getD (fset st j y) 0 := by
  rw [List.getD_eq_getElem _ _ (by simpa using hj)]
  simp [selOpF]

theorem selOpF_mul {st : ι → ℕ} {n : ℕ} (h : SLaws st n) (T U : Matrix (ι → Fin 2) (ι → Fin 2) ℂ)
    (xs : List M) : selOpF st n T (selOpF st n U xs) = selOpF st n (T * U) xs := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_selOpF] at h₁
  simp only [selOpF, List.getElem_map, List.getElem_range]
  have e : ∀ y, (List.map (fun j => ∑ y, U (fbit st j) y • xs.getD (fset st j y) 0)
      (List.range n)).getD (fset st j y) 0 =
      ∑ z, U y z • xs.getD (fset st j z) 0 := by
    intro y
    have := getD_selOpF st n U xs (h.lt j h₁ y)
    simp only [selOpF] at this
    rw [this, h.bit_set j h₁ y]
    simp_rw [h.set_set h₁]
  simp_rw [e, Finset.smul_sum, smul_smul, Matrix.mul_apply, Finset.sum_smul]
  exact Finset.sum_comm

end Basic

