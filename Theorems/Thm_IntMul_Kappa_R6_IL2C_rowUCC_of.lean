/-!
# Round six, compact controls (I2C): the compact row code and `RowUCP′`

* `hdrG` (on the row background `rowσC`: the field width `G` in register `46`) and `hdrC` (after
  the frozen header `hdrL` and the bit-length loop): the registers of `CEnv`.
* `rowCodeC l12 = withPushI hdrG (withPushI hdrL (zB (withPushI hdrC (l13C l12))))`;
  **`rowCodeC_runs`**: the row addition `permRecs …` at cost `cL13 + 3 cHd`.
* **`rowUCC_of`**: `IL3H.RowUCC m τ Isym tbl ((rowCodeC l12).ren id g) Kc` (factor `Kc (G+2) + 1`,
  no factor `K`).
* **`RowUCP'`** (`IL3F.RowUCPF` with `IL3H.RowUCC` in place of `RowUCF`) and **`rowUCP'_of`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE NLogN.KFB NLogN.KFL NLogN.KFW NLogN.KFH
  NLogN.KFX NLogN.KFN P8Lift AModel Butterfly IntMul.Kappa.R6.IL

section Run

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ} {m : ℕ}

/-! ## `RowUCC` -/

theorem zsz_V_le {n r H Z : ℕ} (hZ : zsz ((16 * (n * r) : ℕ) : ℤ) ≤ Z) :
    zsz ((n * (r * (2 * (H + 1))) : ℕ) : ℤ) ≤ Z + zsz ((H : ℤ) + 1) := by
  have e : ((n * (r * (2 * (H + 1))) : ℕ) : ℤ) = ((2 * (n * r) : ℕ) : ℤ) * ((H : ℤ) + 1) := by
    push_cast; ring
  rw [e]
  refine le_trans (zsz_mul_le _ _) (Nat.add_le_add_right (le_trans (zsz_mono ?_) hZ) _)
  simp only [Int.natAbs_natCast]; omega

/-- **Compact row additions** with factor `Kc (G + 2) + 1`. -/
theorem rowUCC_of_sol_aux (hm : 16 ≤ m) (hm' : m ≤ 1000000) (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1) {Ksw : ℝ}
    (hKsw : 0 ≤ Ksw) (HSw : SwOK tab l12 τ Ksw) {Pp : ℕ}
    {tbl : Fin Pp → IStmt HS Pp} {g : Fin 1 → Fin Pp} (hprog : ∀ j, tbl (g j) = (tab j).ren id g)
    (Isym : List Sym) :
    IL3H.RowUCC m τ Isym tbl ((rowCodeC l12).ren id g) (10 ^ 31 + 100 * Ksw + 10 ^ 13) := by
  intro G hG F K e t S0 B r Z H i j hij hK hr hZG hGK hS0 hB hF1 he ht hdB hdS hZ
  set n := B * 2 ^ t * S0 with hn
  have hp : IL3F.PF m F K e t S0 B r := ⟨by omega, he, ht, hS0, hB, hr, hK, hm, hm', hF1⟩
  have hK1 : 1 ≤ K := by omega
  haveI : NeZero F := ⟨by omega⟩
  have hm3 : 3 ≤ m := by omega
  have hij' : (i : ℕ) ≠ j := fun h => hij (Fin.ext h)
  have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.2 (by positivity)
  have htZ : t < Z := by
    have h16 : 2 ^ t ≤ 16 * (n * r) := by
      calc 2 ^ t = 1 * 2 ^ t * 1 * 1 := by ring
        _ ≤ B * 2 ^ t * S0 * r := Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul_right _ hB) hS0) hr
        _ ≤ 16 * (n * r) := by rw [hn]; omega
    have := zsz_nat_le h16
    have e2 : zsz (((2 ^ t : ℕ)) : ℤ) = t + 1 := by push_cast; exact zsz_two_pow t
    omega
  have hfZ : F ≤ Z := by have := hp.fT; omega
  have hGK' : G < K := by
    have h1 : 2 ^ G < 2 ^ K := by
      have : 1 ≤ Z := by omega
      have h48 : 48 ≤ 16 * Z * (Z + 2) := by nlinarith
      have : 0 < 2 ^ G := by positivity
      have := Nat.mul_le_mul_right (2 ^ G) h48
      omega
    by_contra hc
    have := Nat.pow_le_pow_right (show 0 < 2 by norm_num) (show K ≤ G by omega)
    omega
  set Bb := zsz ((VbR t S0 B r H : ℕ) : ℤ) with hBbd
  set A13 := cL13 Ksw τ (IL3F.N0R m F K e t B i j) (IL3F.N1R m F K e i j)
          (IL3F.N2R m F K e i j) (IL3F.N3R m F K e S0 i j) K F (e % K) G r H (pxR i j) (pyR i j)
    with hA13
  refine ⟨fun _ => ⌈A13 + 3 * (cHd Bb : ℝ)⌉₊, ?_, ?_⟩
  · intro s f zs l xs F0 w hQ hC h0 hrec hlen hgb hlo hhi
    have hzl : zs.length = n * r := by rw [hrec.1, hlen]
    have hAC : Agree (IL3H.rowσC m F K e t S0 B r H G i j) (encK s f) := agree_encK hQ
      (fun x hx => hC x (by
        rintro rfl; revert hx; unfold IL3H.rowσC IL3F.rowσ; simp))
    have hg0 : (encK s f).G 0 = ints (gflat zs) ++ (ints l ++ s.G 0) := by
      rw [encK_G, h0, ints_append, List.append_assoc]
    obtain ⟨c, Hc, hc⟩ := rowCodeC_runs (l12 := l12) hKsw HSw (I := Isym) hij' (by omega) hp hG hGK'
      hdB hdS hAC zs (ints l ++ s.G 0) hg0 hzl (hgb.mono (by omega))
    set sh := KFR.shR K F e t S0 B (IL2.σF i j) with hshd
    have hsh : sh = rect (IL3F.N0R m F K e t B i j) (IL3F.N1R m F K e i j) (IL3F.N2R m F K e i j)
        (IL3F.N3R m F K e S0 i j) (F * K) := IL3F.shR_eq hm3 hij'
    have hvol : vol sh = n := IL3F.shR_volF (IL3F.posR_he hp.he') ht (IL2.σF_mono hm3 hij')
    have hpx : IL2.σF i j (pxR i j) = i := Fin.ext (by rw [IL2.σF_val hm3 hij', σR_px])
    have hpy : IL2.σF i j (pyR i j) = j := Fin.ext (by rw [IL2.σF_val hm3 hij', σR_py])
    set st : Fin m × Fin F → ℕ := fun p => 2 ^ IL3F.posR m K e F p * S0
    have hL := slaws_pow (IL3F.posR m K e F) (IL3F.posR_inj' hK1 hF1 hp.he') t S0 B
      (IL3F.posR_lt' hK1 ht)
    have henc : ∀ q < n, encode sh (rowAddAddr K (e % K) F (pxR i j) (pyR i j)
        (decode sh q)) = fset st q (rowAddr i j (fbit st q)) := fun q hq => by
      have := IL3F.encode_rowAddAddrF (IL3F.posR_he hp.he') ht (IL2.σF_mono hm3 hij') hK1 hq hpx
        hpy hij
      unfold fset; rw [← this]; simp; rfl
    rw [← hsh] at Hc
    refine ⟨permRecs sh (rowAddAddr K (e % K) F (pxR i j) (pyR i j)) r zs, ?_,
      by rw [add_zero]; exact KFR.permRecs_GB hgb, ?_⟩
    · rw [add_zero]
      have hP := KFR.permRecs_recRep (π := rowAddAddr K (e % K) F (pxR i j) (pyR i j)) hrec
        (hlen.trans hvol.symm)
        (fun q hq => by rw [hvol] at hq ⊢; rw [henc q hq]; exact hL.lt q hq _)
      have e1 : selOpF st n (Pm i j : Butterfly.Op (Fin m × Fin F)) xs =
          (List.range (vol sh)).map fun q =>
            xs.getD (encode sh (rowAddAddr K (e % K) F (pxR i j) (pyR i j)
              (decode sh q))) 0 := by
        rw [KFR.selOpF_Pm, hvol]
        refine List.map_congr_left fun q hq => ?_
        rw [henc q (List.mem_range.1 hq)]
      rw [e1]; exact hP
    · have R := KFM.IRuns.relabel hprog Hc
      refine R.mono' ?_ ?_
      · rw [← List.append_assoc, ← ints_append, encK_upd0]
      · have h3 := Nat.le_ceil (A13 + 3 * (cHd Bb : ℝ))
        have : (c : ℝ) ≤ (⌈A13 + 3 * (cHd Bb : ℝ)⌉₊ : ℝ) := le_trans hc h3
        exact_mod_cast this
  · intro w hw
    show ((⌈A13 + 3 * (cHd Bb : ℝ)⌉₊ : ℕ) : ℝ) ≤ _
    have hrp : 1 ≤ r := hr
    have hzV : zsz ((vol (rect (IL3F.N0R m F K e t B i j) (IL3F.N1R m F K e i j)
        (IL3F.N2R m F K e i j) (IL3F.N3R m F K e S0 i j) (F * K)) * (r * (2 * (H + 1))) : ℕ) : ℤ) ≤
        Z + zsz ((H : ℤ) + 1) := by
      rw [IL3F.vol_rowRect hij' hp]; exact zsz_V_le (by rw [← hn]; exact hZ)
    have hNp := rp_row hp hij' hK hG hGK' hdB hdS
    have h13 := cL13_le hKsw hτ0 hτ1 hNp hr hfZ hZG hGK hzV
    rw [IL3F.vol_rowRect hij' hp] at h13
    -- the header
    have hBbZ : Bb ≤ Z + zsz ((H : ℤ) + 1) := by
      have := zsz_V_le (n := n) (r := r) (H := H) hZ
      rw [hBbd]; refine le_trans (le_of_eq ?_) this
      congr 2; unfold VbR; push_cast; ring
    have hPsi : 2 * ((Z + zsz ((H : ℤ) + 1) + 2 : ℕ) : ℝ) ^ 3 ≤ (KFR.PsiR r Z H : ℝ) := by
      unfold KFR.PsiR; push_cast
      have : (0 : ℝ) ≤ ((r * (H + 1) * zsz ((H : ℤ) + 1) / (Z + 2) : ℕ) : ℝ) := Nat.cast_nonneg _
      push_cast at this
      linarith
    have hHd : (cHd Bb : ℝ) ≤ 10 ^ 12 * ((Z + zsz ((H : ℤ) + 1) + 2 : ℕ) : ℝ) ^ 3 := by
      unfold cHd; push_cast
      have : (Bb : ℝ) ≤ (Z : ℝ) + (zsz ((H : ℤ) + 1) : ℝ) := by exact_mod_cast hBbZ
      have h0 : (0 : ℝ) ≤ (Bb : ℝ) + 2 := by positivity
      nlinarith [pow_le_pow_left₀ h0 (show (Bb : ℝ) + 2 ≤ (Z : ℝ) + (zsz ((H : ℤ) + 1) : ℝ) + 2 by linarith) 3]
    have hY0 : 0 ≤ (r : ℝ) * (H + 1) * ((F : ℝ) + 1) ^ τ := by positivity
    have hP0 : (2 : ℝ) ≤ (KFR.PsiR r Z H : ℝ) := by
      have : 2 ≤ KFR.PsiR r Z H := by unfold KFR.PsiR; exact Nat.le_add_left _ _
      exact_mod_cast this
    have hn' : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn1
    have hG' : (1 : ℝ) ≤ (G : ℝ) := by exact_mod_cast hG
    set Y := (r : ℝ) * (H + 1) * ((F : ℝ) + 1) ^ τ + (KFR.PsiR r Z H : ℝ) with hY
    have hYP : (KFR.PsiR r Z H : ℝ) ≤ Y := by linarith
    have hnY : (KFR.PsiR r Z H : ℝ) ≤ (n : ℝ) * Y := by nlinarith
    have hnYp : 0 ≤ (n : ℝ) * Y := by positivity
    have hmain : A13 ≤ (10 ^ 31 + 100 * Ksw) * ((G : ℝ) + 2) * ((n : ℝ) * Y) := by
      rw [hA13]; refine le_trans h13 (le_of_eq ?_); rw [hn]
    have hhd : 3 * (cHd Bb : ℝ) + 1 ≤ 10 ^ 13 * ((G : ℝ) + 2) * ((n : ℝ) * Y) + (n : ℝ) * Y := by
      nlinarith
    have hfin : A13 + 3 * (cHd Bb : ℝ) + 1 ≤
        ((10 ^ 31 + 100 * Ksw + 10 ^ 13) * ((G : ℝ) + 2) + 1) * ((n : ℝ) * Y) := by nlinarith
    have hR : ((10 ^ 31 + 100 * Ksw + 10 ^ 13) * ((G : ℝ) + 2) + 1) * ((n : ℝ) * Y) =
        ((10 ^ 31 + 100 * Ksw + 10 ^ 13) * ((G : ℝ) + 2) + 1) * ((B * 2 ^ t * S0 : ℕ) : ℝ) *
          ((r : ℝ) * (H + 1) * ((F : ℝ) + 1) ^ τ + (KFR.PsiR r Z H : ℝ)) := by
      rw [hn, hY]; ring
    rw [← hR]
    rcases le_or_gt 0 (A13 + 3 * (cHd Bb : ℝ)) with h0 | h0
    · exact le_trans (Nat.ceil_lt_add_one h0).le hfin
    · rw [Nat.ceil_eq_zero.2 h0.le, Nat.cast_zero]; positivity

/-! ## `RowUCP′` -/

end Run

