theorem zsz_succ_mono {a b : ℕ} (h : a ≤ b) : zsz ((a : ℤ) + 1) ≤ zsz ((b : ℤ) + 1) :=
  zsz_mono (by omega)

theorem psiR_mono (r Z : ℕ) : Monotone (PsiR r Z) := by
  intro a b h
  have h1 := zsz_succ_mono h
  unfold PsiR
  have h2 : (Z + zsz ((a : ℤ) + 1) + 2) ^ 3 ≤ (Z + zsz ((b : ℤ) + 1) + 2) ^ 3 :=
    Nat.pow_le_pow_left (by omega) 3
  have h3 : r * (a + 1) * zsz ((a : ℤ) + 1) / (Z + 2) ≤ r * (b + 1) * zsz ((b : ℤ) + 1) / (Z + 2) :=
    Nat.div_le_div_right (Nat.mul_le_mul (Nat.mul_le_mul_left _ (by omega)) h1)
  omega

theorem psiR_ge (r Z w : ℕ) : Z + 2 ≤ PsiR r Z w := by
  unfold PsiR
  have : Z + zsz ((w : ℤ) + 1) + 2 ≤ (Z + zsz ((w : ℤ) + 1) + 2) ^ 3 :=
    Nat.le_self_pow (by norm_num) _
  generalize r * (w + 1) * zsz ((w : ℤ) + 1) / (Z + 2) = D
  omega

end NLogN.KFR

