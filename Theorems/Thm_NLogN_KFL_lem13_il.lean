theorem mem_permRecs {sh : Shape} {π : List ℕ → List ℕ} {R : ℕ} {zs : List GI} {x : GI}
    (hx : x ∈ permRecs sh π R zs) : x ∈ zs := by
  simp only [permRecs, List.mem_flatMap] at hx
  obtain ⟨_, _, hx⟩ := hx
  exact List.mem_of_mem_drop (List.mem_of_mem_take hx)

theorem zsz_gflat {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) : ∀ x ∈ gflat zs, zsz x ≤ w := by
  intro x hx
  simp only [gflat, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hx
  obtain ⟨z, hz, rfl | rfl⟩ := hx
  · exact (h z hz).1
  · exact (h z hz).2

theorem TV_RAc' {K ρ f L : ℕ} (c : Tr) (hc : TV (2 ^ L) c) : TV (2 ^ L) (RAc K ρ f c) :=
  ⟨hc.1, Nat.xor_lt_two_pow hc.2.1 (lt_of_le_of_lt Nat.and_le_left hc.1), hc.2.2⟩

/-- The core on the canonical slots. -/
theorem coreB_runs {q : ℕ} {Ks Kcr : ℝ} (HL : LinesOK q Ks) (HC : CorrOK Kcr)
    {K ρ f : ℕ} (hK : 6 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (g : Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (I : List Sym) (t : IState HS) (zs : List ℤ) (R : List Item)
    (hb : Bits zs) (h0 : t.G 0 = ints zs ++ R) (hl : zs.length = g.V) :
    ∃ c : ℕ, IRuns I l12prog (coreB q K ρ f g) t (t.upd 0 (ints (rixT g (RAc K ρ f) zs) ++ R)) c ∧
      (c : ℝ) ≤ coreCost Ks Kcr K ρ f g := by
  set Bb := zsz (g.V : ℤ) + 3
  have hB2 : 2 ≤ Bb := by omega
  have hzV : zsz (g.V : ℤ) ≤ Bb := by omega
  have hbig : 4 * 2 ^ (f * K) < 2 ^ Bb := by
    have h1 : 2 ^ (f * K) ≤ g.V := by
      rw [← hQe]; unfold Geo.V
      exact (Nat.le_mul_of_pos_right _ hg.n0).trans' (Nat.le_mul_of_pos_right _ hg.s0)
    have h2 : g.V < 2 ^ zsz (g.V : ℤ) := by have := natAbs_lt_zsz (g.V : ℤ); simpa using this
    have h3 : 2 ^ Bb = 8 * 2 ^ zsz (g.V : ℤ) := by simp only [Bb, pow_add]; ring
    omega
  obtain ⟨c3, S3, hc3⟩ := HL K ρ f (by omega) hρK hf g hg hQe Bb hB2 hbig hzV lines lines_ok I t zs R
    hb h0 hl
  rw [← FSc_lines] at S3
  set z3 := rixT g (FSc K ρ f) zs
  obtain ⟨c4, S4, hc4⟩ := HC K ρ f hK hρK hf g hg hQe I l12prog (t.upd 0 (ints z3 ++ R)) z3 R
    (bits_rixT hb) (by simp) (length_rixT _ _ _)
  set z4 := rixT g (corrc K ρ f) z3
  have S5 := xorStep_geo (I := I) (iprog := l12prog) hρK hf g hg hQe hB2 hzV 1
    ((t.upd 0 (ints z3 ++ R)).upd 0 (ints z4 ++ R)) z4 R (length_rixT _ _ _)
    (bnd_bits (bits_rixT (bits_rixT hb))) (by simp)
  refine ⟨c3 + (c4 + _), (S3.seq (S4.seq S5)).mono' ?_ le_rfl, ?_⟩
  · rw [IState.upd_upd_same, IState.upd_upd_same, pipeline_rixT (by omega) hρK hf g hg hQe zs]
  · have hl8 : (lines.length : ℝ) = 8 := by simp [lines]
    rw [hl8] at hc3
    unfold coreCost
    push_cast at hc3 ⊢
    linarith

theorem l13_runs {q : ℕ} {Ks Ksw Kcr : ℝ} (hKsw : 0 ≤ Ksw) (HL : LinesOK q Ks) (HSW : NLogN.KFL.SwOK q Ksw)
    (HC : CorrOK Kcr) {I : List Sym} (N0 N1 N2 N3 K f ρ R w : ℕ) (px py : Fin 3) (hne : px ≠ py)
    (hK : 6 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (h0 : 1 ≤ N0) (h1 : 1 ≤ N1) (h2 : 1 ≤ N2)
    (h3 : 1 ≤ N3) (hR : 1 ≤ R) (s : IState HS) (gS : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (hg0 : gS 0 = gflat zs ++ l) (hl : zs.length = vol (rect N0 N1 N2 N3 (f * K)) * R)
    (hGB : NLogN.KFB.GB w zs) :
    ∃ c, IRuns I l12prog (l13code q N0 N1 N2 N3 K f ρ R w px py) (encK s gS)
        (encK s (Function.update gS 0 (gflat (permRecs (rect N0 N1 N2 N3 (f * K))
          (rowAddAddr K ρ f px py) R zs) ++ l))) c ∧
      (c : ℝ) ≤ (cTo (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ) +
        2 * (1 + 2 * (Ksw * (((geoB N0 N1 N2 N3 (f * K) R w).V : ℝ) + 1) *
          ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50))) +
        coreCost Ks Kcr K ρ f (geoB N0 N1 N2 N3 (f * K) R w) +
        (cFrom (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ) := by
  set gm := geoB N0 N1 N2 N3 (f * K) R w with hgm
  have hg : gm.Pos := geoB_pos h0 h1 h2 h3 hR
  have hQe : gm.Q = 2 ^ (f * K) := rfl
  have hu : 1 ≤ f * K := Nat.mul_pos (by omega) (by omega)
  set M := vol (rect N0 N1 N2 N3 (f * K))
  set τ := (1 - (2 : ℝ)⁻¹ ^ 50)
  set Lτ := ((f * K : ℕ) : ℝ) ^ τ
  have hLτ : 0 ≤ Lτ := Real.rpow_nonneg (Nat.cast_nonneg _) _
  set P := permRecs (rect N0 N1 N2 N3 (f * K)) (rowAddAddr K ρ f px py) R zs
  set xs := gflat zs
  have hxs : ∀ x ∈ xs, zsz x ≤ w := zsz_gflat hGB
  have hxl : xs.length = 2 * (M * R) := by simp only [xs, length_gflat, hl]
  set R0 := ints l ++ s.G 0
  have ht0 : (encK s gS).G 0 = ints xs ++ R0 := by simp [hg0, ints_append, R0, xs]
  -- 1. to bits
  have S1 := toBitsI_spec (I := I) (iprog := l12prog) (encK s gS) xs w hxs R0 ht0
  rw [hxl] at S1
  set xb := bitsL w xs
  have hxbl : xb.length = gm.V := by
    simp only [xb, length_bitsL, hxl, hgm, geoB_V]; ring
  have hxbb : Bits xb := bits_bitsL w xs
  set t1 := (encK s gS).upd 0 (ints xb ++ R0)
  -- 2. swaps
  obtain ⟨c2, S2, hc2⟩ := swSeq_spec hKsw HSW gm hg (f * K) hu hQe I (preL px py) t1 xb R0 hxbb
    (by simp [t1]) hxbl
  set z2 := rixT gm (compL (preL px py)) xb
  set t2 := t1.upd 0 (ints z2 ++ R0)
  -- 3. core
  obtain ⟨c3, S3, hc3⟩ := coreB_runs HL HC hK hρK hf gm hg hQe I t2 z2 R0 (bits_rixT hxbb)
    (by simp [t2]) (length_rixT _ _ _)
  set z3 := rixT gm (RAc K ρ f) z2
  set t3 := t2.upd 0 (ints z3 ++ R0)
  -- 4. inverse swaps
  obtain ⟨c4, S4, hc4⟩ := swSeq_spec hKsw HSW gm hg (f * K) hu hQe I (preL px py).reverse t3 z3 R0
    (bits_rixT (bits_rixT hxbb)) (by simp [t3]) (length_rixT _ _ _)
  set z4 := rixT gm (compL (preL px py).reverse) z3
  have hz4 : z4 = bitsL w (gflat P) := by
    have TA : ∀ c, TV gm.Q c → TV gm.Q (compL (preL px py) c) := fun c hc => TV_compL _ c hc
    have TB : ∀ c, TV gm.Q c → TV gm.Q (compL (preL px py).reverse c) := fun c hc =>
      TV_compL _ c hc
    have TR : ∀ c, TV gm.Q c → TV gm.Q (RAc K ρ f c) := fun c hc =>
      TV_RAc' c hc
    simp only [z4, z3, z2]
    rw [rixT_rixT hg TA TR, rixT_rixT hg (F := compL (preL px py) ∘ RAc K ρ f)
      (fun c hc => TA _ (TR c hc)) TB,
      bits_permRecs (w := w) h0 h1 h2 h3 hR px py zs hl]
    exact rixT_congr hg (fun c _ => (Fpp_conj K ρ f px py hne c).symm) _
  set t4 := t3.upd 0 (ints z4 ++ R0)
  -- 5. from bits
  have hPl : P.length = M * R := by
    have e1 := congrArg List.length hz4
    rw [length_rixT, length_bitsL, length_gflat] at e1
    have e2 : gm.V = M * R * (2 * (w + 1)) := geoB_V
    rw [e2] at e1
    have : P.length * (2 * (w + 1)) = M * R * (2 * (w + 1)) := by
      rw [e1]; ring
    exact Nat.eq_of_mul_eq_mul_right (by positivity) this
  have hPx : ∀ x ∈ gflat P, zsz x ≤ w := zsz_gflat (fun z hz => hGB z (mem_permRecs hz))
  have S5 := fromBitsI_spec (I := I) (iprog := l12prog) t4 (gflat P) w hPx R0
    (by simp [t4, hz4])
  rw [length_gflat, hPl] at S5
  refine ⟨_, (S1.seq (S2.seq (S3.seq (S4.seq S5)))).mono' ?_ le_rfl, ?_⟩
  · simp only [t4, t3, t2, t1, IState.upd_upd_same, R0]
    rw [← encK_upd s gS 0 (gflat P ++ l), ints_append, List.append_assoc]
  · have hpre := length_preL px py
    have hpre' : (preL px py).reverse.length ≤ 2 := by rw [List.length_reverse]; exact hpre
    have hX : 0 ≤ Ksw * ((gm.V : ℝ) + 1) * Lτ := by positivity
    have e2 : (((preL px py).length : ℕ) : ℝ) * (Ksw * ((gm.V : ℝ) + 1) * Lτ) ≤
        2 * (Ksw * ((gm.V : ℝ) + 1) * Lτ) :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast hpre) hX
    have e4 : (((preL px py).reverse.length : ℕ) : ℝ) * (Ksw * ((gm.V : ℝ) + 1) * Lτ) ≤
        2 * (Ksw * ((gm.V : ℝ) + 1) * Lτ) :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast hpre') hX
    have eL : ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) = Lτ := rfl
    rw [eL] at hc2 hc4
    push_cast
    linarith

theorem xor_dims {K ρ f : ℕ} (hρK : ρ < K) (hf : 1 ≤ f) (g : Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) :
    1 ≤ g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) ∧
    1 ≤ 2 ^ (ρ + (f - 1) * K) * g.S1 ∧
    g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) * 2 * (2 ^ (ρ + (f - 1) * K) * g.S1)
      = g.V ∧
    g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) ≤ g.recG.V := by
  set j := ρ + (f - 1) * K
  set E := 2 ^ (f * K - j - 1)
  set D := 2 ^ j
  have hjK : j + 1 ≤ f * K := by
    have : (f - 1) * K + K = f * K := by
      have : f = (f - 1) + 1 := by omega
      conv_rhs => rw [this]
      ring
    omega
  have hQ : g.Q = 2 * D * E := by
    rw [hQe]; simp only [D, E]; rw [← pow_succ', ← pow_add]; congr 1; omega
  have hE : 0 < E := by positivity
  have hD : 0 < D := by positivity
  refine ⟨Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hg.n0 hg.q) hg.n1) hE, Nat.mul_pos hD hg.s1, ?_, ?_⟩
  · simp only [Geo.V, Geo.S0]; rw [hQ]; ring
  · have hEQ : E ≤ g.Q := by rw [hQ]; nlinarith
    have : g.recG.V = g.N0 * g.Q * g.N1 * g.Q * (g.N2 * g.Q * g.N3) := by
      simp only [Geo.V, Geo.S0, Geo.S1, Geo.S2, Geo.recG_Q, Geo.recG_N0, Geo.recG_N1,
        Geo.recG_N2, Geo.recG_N3, Geo.recG_B]; ring
    rw [this]
    have h1 : 1 ≤ g.N2 * g.Q * g.N3 := Nat.mul_pos (Nat.mul_pos hg.n2 hg.q) hg.n3
    calc g.N0 * g.Q * g.N1 * E ≤ g.N0 * g.Q * g.N1 * g.Q := Nat.mul_le_mul_left _ hEQ
      _ ≤ _ := Nat.le_mul_of_pos_right _ h1

theorem coreCost_le {K ρ f : ℕ} (hK : 6 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (g : Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (Ks Kcr : ℝ) :
    coreCost Ks Kcr K ρ f g ≤ 1 + 16 * Ks * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) +
      2 * 10 ^ 15 * ((g.recG.V : ℝ) * ((zsz (g.V : ℤ) : ℝ) + 1) ^ 3 + g.V) +
      Kcr * ((g.recG.V : ℝ) * ((zsz (g.V : ℤ) : ℝ) + 1) ^ 3 + (g.V : ℝ) +
        min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * (g.recG.V : ℝ) *
          ((zsz (g.V : ℤ) : ℝ) + 1) * ((g.B : ℝ) + (zsz (g.V : ℤ) : ℝ) + 1)) := by
  have hfz := f_lt_zsz (by omega) hg hQe
  set Bb := zsz (g.V : ℤ) + 3
  have hR := cRotG_le K f g hg Bb (by omega)
  obtain ⟨hP1, hB1, hPV, hPM⟩ := xor_dims hρK hf g hg hQe
  have hX := cXor_le _ _ Bb hP1 hB1
  rw [hPV] at hX
  unfold coreCost
  rw [V_div_B hg]
  set X : ℝ := (zsz (g.V : ℤ) : ℝ) + 1
  have hX1 : 1 ≤ X := by simp only [X]; linarith [(Nat.cast_nonneg (zsz (g.V : ℤ)) : (0 : ℝ) ≤ _)]
  have hb : ((Bb + 2 : ℕ) : ℝ) ≤ 5 * X := by
    simp only [Bb, X]; push_cast; linarith [(Nat.cast_nonneg (zsz (g.V : ℤ)) : (0 : ℝ) ≤ _)]
  have hb0 : (0 : ℝ) ≤ ((Bb + 2 : ℕ) : ℝ) := Nat.cast_nonneg _
  have hb3 : ((Bb + 2 : ℕ) : ℝ) ^ 3 ≤ 125 * X ^ 3 := by
    have := pow_le_pow_left₀ hb0 hb 3; nlinarith
  have hb2 : ((Bb + 2 : ℕ) : ℝ) ^ 2 ≤ 25 * X ^ 3 := by
    have := pow_le_pow_left₀ hb0 hb 2
    have : X ^ 2 ≤ X ^ 3 := pow_le_pow_right₀ hX1 (by norm_num)
    nlinarith
  have hM0 : (0 : ℝ) ≤ g.recG.V := Nat.cast_nonneg _
  have hRr : (cRotG K f g Bb : ℝ) ≤ 10 ^ 12 * ((g.recG.V : ℝ) * 125 * X ^ 3 + g.V) := by
    have := (Nat.cast_le (α := ℝ)).2 hR
    push_cast at this
    have h3 : (g.recG.V : ℝ) * ((Bb : ℝ) + 2) ^ 3 ≤ (g.recG.V : ℝ) * (125 * X ^ 3) := by
      apply mul_le_mul_of_nonneg_left _ hM0; exact_mod_cast hb3
    nlinarith
  have hXr : (cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1))
      (2 ^ (ρ + (f - 1) * K) * g.S1) 1 Bb : ℝ) ≤ 10 ^ 10 * ((g.recG.V : ℝ) * 25 * X ^ 3 + g.V) := by
    have := (Nat.cast_le (α := ℝ)).2 hX
    have hPM' : ((g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℝ) ≤ g.recG.V := by
      exact_mod_cast hPM
    have h2 : ((g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℝ) *
        ((Bb + 2 : ℕ) : ℝ) ^ 2 ≤ (g.recG.V : ℝ) * (25 * X ^ 3) :=
      mul_le_mul hPM' hb2 (by positivity) hM0
    push_cast at this h2 ⊢
    nlinarith
  have hV0 : (0 : ℝ) ≤ g.V := Nat.cast_nonneg _
  have hX3 : 0 ≤ (g.recG.V : ℝ) * X ^ 3 := by positivity
  linarith

/-- The final cost arithmetic, on real variables. -/
theorem l13_arith {c n w M R Lτ X δ Ks Ksw Kcr cto cfr core : ℝ} (hn1 : 1 ≤ n) (hw : 0 ≤ w)
    (hM : 0 ≤ M) (hR : 0 ≤ R) (hLτ : 0 ≤ Lτ) (hX1 : 1 ≤ X) (hδ : 0 ≤ δ) (hKs : 0 ≤ Ks)
    (hKsw : 0 ≤ Ksw) (hKcr : 0 ≤ Kcr)
    (hc : c ≤ cto + 2 * (1 + 2 * (Ksw * (2 * n * (w + 1) + 1) * Lτ)) + core + cfr)
    (hcore : core ≤ 1 + 16 * Ks * (2 * n * (w + 1) + 1) * Lτ +
      2 * 10 ^ 15 * (M * X ^ 3 + 2 * n * (w + 1)) +
      Kcr * (M * X ^ 3 + 2 * n * (w + 1) + δ * M * X * (2 * R * (w + 1) + X)))
    (hcto : cto ≤ 3 * 10 ^ 4 * (n * (w + 1))) (hcfr : cfr ≤ 3 * 10 ^ 4 * (n * (w + 1))) :
    c ≤ (10 ^ 16 + 12 * Ksw + 48 * Ks + 5 * Kcr) *
      (n * (w + 1) * (Lτ + 1) + M * X ^ 3 + δ * M * X * (R * (w + 1) + X)) := by
  set T := n * (w + 1) * (Lτ + 1) + M * X ^ 3 + δ * M * X * (R * (w + 1) + X)
  have hA : 0 ≤ n * (w + 1) * Lτ := by positivity
  have hB : 0 ≤ M * X ^ 3 := by positivity
  have hC : 0 ≤ δ * M * X * (R * (w + 1) + X) := by positivity
  have hT1 : n * (w + 1) ≤ T := by simp only [T]; nlinarith
  have hT2 : n * (w + 1) * Lτ ≤ T := by simp only [T]; nlinarith
  have hT3 : M * X ^ 3 ≤ T := by simp only [T]; nlinarith
  have hT4 : δ * M * X * (R * (w + 1) + X) ≤ T := by simp only [T]; nlinarith
  have hT0 : 1 ≤ n * (w + 1) := by nlinarith
  have hT : 0 ≤ T := by linarith
  have q1 : (2 * n * (w + 1) + 1) * Lτ ≤ 3 * (n * (w + 1) * Lτ) := by nlinarith
  have p1 : 2 * (1 + 2 * (Ksw * (2 * n * (w + 1) + 1) * Lτ)) ≤ (2 + 12 * Ksw) * T := by
    have : Ksw * ((2 * n * (w + 1) + 1) * Lτ) ≤ Ksw * (3 * T) :=
      mul_le_mul_of_nonneg_left (q1.trans (by linarith)) hKsw
    nlinarith
  have p2 : 1 + 16 * Ks * (2 * n * (w + 1) + 1) * Lτ ≤ (1 + 48 * Ks) * T := by
    have : Ks * ((2 * n * (w + 1) + 1) * Lτ) ≤ Ks * (3 * T) :=
      mul_le_mul_of_nonneg_left (q1.trans (by linarith)) hKs
    nlinarith
  have p3 : 2 * 10 ^ 15 * (M * X ^ 3 + 2 * n * (w + 1)) ≤ 6 * 10 ^ 15 * T := by nlinarith
  have p4 : Kcr * (M * X ^ 3 + 2 * n * (w + 1) + δ * M * X * (2 * R * (w + 1) + X)) ≤
      Kcr * (5 * T) := by
    apply mul_le_mul_of_nonneg_left _ hKcr
    have : δ * M * X * (2 * R * (w + 1) + X) ≤ 2 * (δ * M * X * (R * (w + 1) + X)) := by
      have : 0 ≤ δ * M * X := by positivity
      have : 0 ≤ δ * M * X * (R * (w + 1)) := by positivity
      nlinarith
    linarith
  have hsum : c ≤ (6 * 10 ^ 4 + (2 + 12 * Ksw) + (1 + 48 * Ks) + 6 * 10 ^ 15 + 5 * Kcr) * T := by
    clear_value T
    linarith
  calc c ≤ _ := hsum
    _ ≤ (10 ^ 16 + 12 * Ksw + 48 * Ks + 5 * Kcr) * T := by
        apply mul_le_mul_of_nonneg_right _ hT; linarith

end NLogN.KFL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD KFB KFH AModel Butterfly
theorem NLogN.KFL.lem13_il :
    ∃ (code : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Fin 3 → Fin 3 → NLogN.IStmt NLogN.HS 1) (Kc : ℝ), 0 < Kc ∧
    ∀ {I : List NLogN.Sym} (N0 N1 N2 N3 K f ρ R w : ℕ) (px py : Fin 3), px ≠ py → 6 ≤ K → ρ < K →
      1 ≤ f → 1 ≤ N0 → 1 ≤ N1 → 1 ≤ N2 → 1 ≤ N3 → 1 ≤ R →
      ∀ (s : NLogN.IState NLogN.HS) (g : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ),
      g 0 = NLogN.KFB.gflat zs ++ l → zs.length = AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R → NLogN.KFB.GB w zs →
      ∃ c, NLogN.IRuns I NLogN.KFL.l12prog (code N0 N1 N2 N3 K f ρ R w px py) (NLogN.KIL.encK s g)
          (NLogN.KIL.encK s (Function.update g 0 (NLogN.KFB.gflat (NLogN.KFH.permRecs (NLogN.KFH.rect N0 N1 N2 N3 (f * K))
            (NLogN.KFH.rowAddAddr K ρ f px py) R zs) ++ l))) c ∧
        (c : ℝ) ≤ Kc * ((zs.length : ℝ) * (w + 1) * (((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) + 1) +
          (AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) : ℝ) * ((NLogN.zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) ^ 3 +
          min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * (AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) : ℝ) *
            ((NLogN.zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) * ((R : ℝ) * (w + 1) +
              (NLogN.zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1)) := by
  obtain ⟨ql, HLs⟩ := NLogN.KFL.linesOK_of_spec
  obtain ⟨qs, HSs⟩ := NLogN.KFL.swOK_of_geo
  obtain ⟨Kcr, hKcr, HC⟩ := NLogN.KFL.corrI_spec
  obtain ⟨q, hq1, hqp⟩ := Nat.exists_infinite_primes (max ql qs + 1)
  obtain ⟨Ks, hKs, HL⟩ := HLs q hqp (by omega)
  obtain ⟨Ksw, hKsw, HSW⟩ := HSs q hqp (by omega)
  refine ⟨fun N0 N1 N2 N3 K f ρ R w px py => NLogN.KFL.l13code q N0 N1 N2 N3 K f ρ R w px py,
    10 ^ 16 + 12 * Ksw + 48 * Ks + 5 * Kcr, by positivity, ?_⟩
  intro I N0 N1 N2 N3 K f ρ R w px py hne hK hρK hf h0 h1 h2 h3 hR s gS zs l hg0 hl hGB
  obtain ⟨c, Hc, hc⟩ := NLogN.KFL.l13_runs (I := I) hKsw HL HSW HC N0 N1 N2 N3 K f ρ R w px py hne hK hρK hf
    h0 h1 h2 h3 hR s gS zs l hg0 hl hGB
  refine ⟨c, Hc, ?_⟩
  -- the cost
  set gm := NLogN.KFL.geoB N0 N1 N2 N3 (f * K) R w with hgm
  have hg : gm.Pos := NLogN.KFL.geoB_pos h0 h1 h2 h3 hR
  have hQe : gm.Q = 2 ^ (f * K) := rfl
  have hMr : gm.recG.V = AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) := (NLogN.KFL.vol_rect (R := R) (w := w)).symm
  have hVn : gm.V = 2 * zs.length * (w + 1) := by rw [NLogN.KFL.geoB_V, hl]; ring
  have hVz : ((gm.V : ℕ) : ℤ) = (2 * zs.length * (w + 1) : ℤ) := by rw [hVn]; push_cast; ring
  have hcore := NLogN.KFL.coreCost_le hK hρK hf gm hg hQe Ks Kcr
  rw [hMr, hVz] at hcore
  have hVr : (gm.V : ℝ) = 2 * (zs.length : ℝ) * (w + 1) := by rw [hVn]; push_cast; ring
  have hBr : (gm.B : ℝ) = 2 * (R : ℝ) * (w + 1) := by simp only [gm, NLogN.KFL.geoB]; push_cast; ring
  rw [hVr, hBr] at hcore
  rw [add_assoc (2 * (R : ℝ) * (w + 1))] at hcore
  rw [hVr] at hc
  have hMpos : 0 < AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) := hMr ▸ hg.recG.v
  have hn1 : (1 : ℝ) ≤ (zs.length : ℝ) := by
    have : 1 ≤ zs.length := by rw [hl]; exact Nat.mul_pos hMpos hR
    exact_mod_cast this
  have hnMR : AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R = zs.length := hl.symm
  have hTo := NLogN.KFL.cTo_le (2 * (AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R)) w
  have hFr := NLogN.KFL.cFrom_le (2 * (AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R)) w
  rw [hnMR] at hTo hFr hc
  have hcast : ∀ x : ℕ, x ≤ 10 ^ 4 * ((2 * zs.length + 1) * (w + 1)) →
      (x : ℝ) ≤ 3 * 10 ^ 4 * ((zs.length : ℝ) * (w + 1)) := by
    intro x hx
    have := (Nat.cast_le (α := ℝ)).2 hx
    push_cast at this
    have hw : (0 : ℝ) ≤ w := Nat.cast_nonneg _
    nlinarith
  have hδ : 0 ≤ min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) := le_min (by norm_num) (by
    have : (1 : ℝ) ≤ f := by exact_mod_cast hf
    have : (0 : ℝ) ≤ 2⁻¹ ^ K := by positivity
    nlinarith)
  have F := NLogN.KFL.l13_arith (X := (NLogN.zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) hn1 (Nat.cast_nonneg _) (Nat.cast_nonneg _) (Nat.cast_nonneg _)
    (Real.rpow_nonneg (Nat.cast_nonneg _) _)
    (by linarith [(Nat.cast_nonneg _ : (0 : ℝ) ≤ (NLogN.zsz (2 * zs.length * (w + 1) : ℤ) : ℝ))])
    hδ hKs hKsw hKcr.le hc hcore (hcast _ hTo) (hcast _ hFr)
  rw [← add_assoc ((R : ℝ) * (w + 1))] at F
  exact F
end
