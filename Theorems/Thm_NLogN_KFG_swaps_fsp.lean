open NLogN
open NLogN.KFG
open IntMul RS AModel KIL KFD KFB Complex
theorem swaps_fsp_aux {W L : ℕ} (s : NLogN.IState NLogN.HS) (l0 : List ℤ) (w Z : ℕ)
    (hZ : NLogN.zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) :
    ∀ (l : List (ℕ × ℕ)), (∀ p ∈ l, p.1 < p.2 ∧ p.2 < W) →
    ∀ (e : ℕ → ℕ) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (y : ℕ → ℕ → ℂ),
      NLogN.KFG.Enc W L e zs y → f 0 = NLogN.KFB.gflat zs ++ l0 → NLogN.KFG.ClP f → NLogN.KFB.GB w zs →
      NLogN.KFG.Enc W L (e ∘ NLogN.KFG.swapsF l) (NLogN.KFG.swapsL L l zs) (fun v => y (NLogN.KFG.swapsF l v)) ∧ NLogN.KFB.GB w (NLogN.KFG.swapsL L l zs) ∧
      NLogN.KFD.FSp (NLogN.KFG.swapsP L l) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (NLogN.KFG.swapsL L l zs) ++ l0)))
        (l.length * NLogN.KFG.cAtom w 0 L W Z + 1) 
  | [], _, e, f, zs, y, hx, h0, hC, hb => by
    refine ⟨by simpa [NLogN.KFG.swapsF, NLogN.KFG.swapsL] using hx, hb, ?_⟩
    simp only [NLogN.KFG.swapsP, NLogN.KFG.swapsL, List.length_nil, zero_mul, zero_add]
    rw [← h0, Function.update_eq_self]; exact NLogN.KFD.FSp.skip _
  | (i, j) :: l, hl, e, f, zs, y, hx, h0, hC, hb => by
    obtain ⟨hij, hj⟩ := hl (i, j) List.mem_cons_self
    have hlen : (j + 1) * L ≤ zs.length := by rw [hx.1]; exact Nat.mul_le_mul_right _ hj
    have H1 := (NLogN.KFG.pairW_fsp NLogN.KFG.swS NLogN.KFG.swS_ok NLogN.KFG.swS_sh s f zs l0 w L i j hij hlen h0 hC hb Z
      (le_trans (NLogN.zsz_natCast_le (Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hj))) hZ)).mono
      (NLogN.KFG.cPairW_le_cAtom hij hj le_rfl le_rfl)
    have hx' := NLogN.KFG.enc_swap hij hj e zs y hx
    obtain ⟨R1, R2, R3⟩ := swaps_fsp_aux s l0 w Z hZ l (fun p hp => hl p (List.mem_cons_of_mem _ hp))
      (e ∘ NLogN.KFG.nsw i j) (Function.update f 0 (NLogN.KFB.gflat (NLogN.KFG.pairL NLogN.KFG.swS L i j zs) ++ l0)) _ _ hx' (by simp)
      (hC.upd0 _) (NLogN.KFG.GB_swap zs hij hlen hb)
    refine ⟨R1, R2, ?_⟩
    have := H1.seq R3
    rw [Function.update_idem] at this
    refine this.mono ?_
    simp only [List.length_cons]; nlinarith

end
