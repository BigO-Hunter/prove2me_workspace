open NLogN
open NLogN.KFH
open IntMul RS AModel KIL KFD KFB Complex
variable {P K D S ρ : ℕ}
theorem NLogN.KFH.layer_partner (hρ : ρ < K) (i : Fin D) {j : ℕ}
    (hj : j < AModel.vol (Butterfly.layerShape P K D S)) (b : Fin 2) :
    ((Butterfly.layerSel P K D S ρ hρ).bits (AModel.decode (Butterfly.layerShape P K D S) j) i : ℕ) =
      j / NLogN.KFH.stT K D S ρ i % 2 ∧
    ((AModel.encode (Butterfly.layerShape P K D S) ((Butterfly.layerSel P K D S ρ hρ).set
      (AModel.decode (Butterfly.layerShape P K D S) j)
      (Function.update ((Butterfly.layerSel P K D S ρ hρ).bits
        (AModel.decode (Butterfly.layerShape P K D S) j)) i b)) : ℕ) : ℤ) =
      j + ((b : ℤ) - (j / NLogN.KFH.stT K D S ρ i % 2 : ℕ)) * NLogN.KFH.stT K D S ρ i := by
  set sh := Butterfly.layerShape P K D S
  set a := AModel.decode sh j
  have hv : AModel.Valid sh a := AModel.valid_decode hj
  have hl : a.length = D + 2 := by rw [hv.length_eq]; simp [sh, Butterfly.layerShape]
  have hdig := NLogN.KFH.getD_digit sh a (i + 1) hv (by omega)
  rw [AModel.encode_decode hj, NLogN.KFH.getD_layer P K D S i i.isLt, NLogN.KFH.drop_layer_eq P K D S i i.isLt] at hdig
  have hbit : (Butterfly.layerBits D ρ a i : ℕ) = j / NLogN.KFH.stT K D S ρ i % 2 := by
    simp only [Butterfly.layerBits]
    rw [hdig, NLogN.KFH.getBit_digit ρ K _ hρ, NLogN.KFH.stT, Nat.div_div_eq_div_mul, Nat.mul_comm]
  refine ⟨hbit, ?_⟩
  show ((AModel.encode sh (Butterfly.layerSet D ρ a (Function.update (Butterfly.layerBits D ρ a) i b)) : ℕ) : ℤ) = _
  rw [NLogN.KFH.layerSet_update a hl i b, NLogN.KFH.encode_set sh a (i + 1) _ (by omega) (by rw [hv.length_eq]),
    AModel.encode_decode hj,
    NLogN.KFH.drop_layer_eq P K D S i i.isLt, NLogN.KFH.setBit_sub]
  have hbit' : (Butterfly.getBit ρ (a.getD (i + 1) 0) : ℕ) = j / NLogN.KFH.stT K D S ρ i % 2 := hbit
  rw [hbit']
  simp only [NLogN.KFH.stT]; push_cast; ring
end
