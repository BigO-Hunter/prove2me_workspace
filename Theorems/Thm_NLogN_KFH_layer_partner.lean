namespace NLogN.KFH

open IntMul RS AModel KIL KFD KFB Complex

variable {P K D S ρ : ℕ}

theorem layerShape_drop (P K D S i : ℕ) (hi : i < D) :
    (Butterfly.layerShape P K D S).drop (i + 2) = List.replicate (D - (i + 1)) (2 ^ K) ++ [S] := by
  simp only [Butterfly.layerShape, List.cons_append, List.drop_succ_cons]
  rw [List.drop_append_of_le_length (by simp; omega), List.drop_replicate]

theorem drop_layer_eq (P K D S i : ℕ) (hi : i < D) :
    vol ((Butterfly.layerShape P K D S).drop (i + 2)) = stS K D S i := by
  rw [layerShape_drop P K D S i hi, stS, layerShape_drop 1 K D S i hi]

theorem getD_layer (P K D S : ℕ) (i : ℕ) (hi : i < D) :
    (Butterfly.layerShape P K D S).getD (i + 1) 0 = 2 ^ K := by
  have h' : i < (List.replicate D (2 ^ K)).length := by simp; omega
  simp only [Butterfly.layerShape]
  rw [List.getD_append _ _ _ _ (by simp; omega), List.getD_cons_succ, List.getD_eq_getElem _ _ h',
    List.getElem_replicate]

theorem getBit_digit (ρ K n : ℕ) (hρ : ρ < K) :
    (Butterfly.getBit ρ (n % 2 ^ K) : ℕ) = n / 2 ^ ρ % 2 := by
  simp only [Butterfly.getBit]
  have e : (2 : ℕ) ^ K = 2 ^ ρ * 2 ^ (K - ρ) := by rw [← pow_add]; congr 1; omega
  rw [e, Nat.mod_mul_right_div_self]
  exact Nat.mod_mod_of_dvd _ (dvd_pow_self 2 (by omega))

theorem setBit_sub (ρ v : ℕ) (b : Fin 2) :
    (Butterfly.setBit ρ v b : ℤ) - v = ((b : ℤ) - (Butterfly.getBit ρ v : ℕ)) * 2 ^ ρ := by
  have h1 := Butterfly.setBit_eq ρ v b
  have h2 := Butterfly.setBit_eq ρ v (Butterfly.getBit ρ v)
  rw [Butterfly.setBit_getBit] at h2
  have : ((Butterfly.setBit ρ v b : ℕ) : ℤ) - ((v : ℕ) : ℤ) =
      (((2 * (v / 2 ^ (ρ + 1)) + b) * 2 ^ ρ + v % 2 ^ ρ : ℕ) : ℤ) -
      (((2 * (v / 2 ^ (ρ + 1)) + (Butterfly.getBit ρ v : ℕ)) * 2 ^ ρ + v % 2 ^ ρ : ℕ) : ℤ) := by
    rw [← h1]; nth_rewrite 2 [h2]; rfl
  rw [this]; push_cast; ring

theorem layerSet_update (a : List ℕ) (ha : a.length = D + 2) (i : Fin D) (b : Fin 2) :
    Butterfly.layerSet D ρ a (Function.update (Butterfly.layerBits D ρ a) i b) =
      a.set (i + 1) (Butterfly.setBit ρ (a.getD (i + 1) 0) b) := by
  have hl : (a.set (i + 1) (Butterfly.setBit ρ (a.getD (i + 1) 0) b)).length = D + 2 := by simp [ha]
  rw [Butterfly.eq_mkAddr D hl, Butterfly.layerSet]
  have g : ∀ k, (a.set (i + 1) (Butterfly.setBit ρ (a.getD (i + 1) 0) b)).getD k 0 =
      if k = i + 1 then Butterfly.setBit ρ (a.getD (i + 1) 0) b else a.getD k 0 := by
    intro k
    by_cases hk : k = i + 1
    · subst hk
      rw [if_pos rfl, List.getD_eq_getElem _ _ (by simp [ha]), List.getElem_set_self]
    · rw [if_neg hk, List.getD_eq_getElem?_getD, List.getElem?_set_ne (Ne.symm hk),
        ← List.getD_eq_getElem?_getD]
  congr 1
  · have := g 0; simp only [show (0 : ℕ) ≠ i + 1 by omega, if_false] at this
    cases a with
    | nil => simp at ha
    | cons x l => simpa using this.symm
  · funext t
    rw [g]
    by_cases ht : t = i
    · subst ht; simp
    · rw [if_neg (by intro h; apply ht; ext; omega), Function.update_of_ne ht]
      simp only [Butterfly.layerBits, Butterfly.setBit_getBit]
  · rw [g, if_neg (by have := i.isLt; omega)]

end NLogN.KFH

