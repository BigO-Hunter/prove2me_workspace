theorem octExpP_cost (n k a : ℕ) (s : IState HS) (L48 L49 L50 : List Item)
    (h48 : s.G 48 = .int n :: L48) (h49 : s.G 49 = .int k :: L49)
    (h50 : s.G 50 = .int a :: L50) :
    octExpP.cost s ≤ octExpCost n (zsz (a : ℤ)) (zsz (k : ℤ)) := by
  have hb := octExpP_cost0 n k a s L48 L49 L50 h48 h49 h50
  have hpi := piCost_le 5 239 (n + 4) (by norm_num) (by norm_num)
  have hφ : zsz (piBits (n + 4) * a / (4 * k)) ≤ 3 * (n + 4) + 14 + zsz (a : ℤ) :=
    le_trans (zsz_ediv_le' (piBits (n + 4) * a) (4 * (k : ℤ)) (by positivity))
      (le_trans (zsz_mul_le _ _) (by have := piBits_zsz (n + 4); omega))
  rw [zsz_zero] at hb
  generalize hS : n + zsz (a : ℤ) + zsz (k : ℤ) + 30 = S
  have hnS : n + 30 ≤ S := by omega
  generalize zsz (piBits (n + 4) * a / (4 * k)) = F at hb hφ
  have p1 : expCost (n + 4) 0 F ≤ 10 ^ 12 * (5 * S) ^ 5 := by
    unfold expCost; exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 5)
  have p2 : octBB n (zsz (a : ℤ)) (zsz (k : ℤ)) + 4 ≤ 14 * S ^ 2 := by
    unfold octBB expB; nlinarith
  have p3 := Nat.pow_le_pow_left p2 2
  have p4 : (n + 4 + 10) ^ 3 ≤ S ^ 3 := Nat.pow_le_pow_left (by omega) 3
  have e1 : (5 * S) ^ 5 = 5 ^ 5 * S ^ 5 := by ring
  have e2 : (14 * S ^ 2) ^ 2 = 14 ^ 2 * S ^ 4 := by ring
  have q3 : S ^ 3 ≤ S ^ 5 := Nat.pow_le_pow_right (by omega) (by omega)
  have q4 : S ^ 4 ≤ S ^ 5 := Nat.pow_le_pow_right (by omega) (by omega)
  rw [e1] at p1; rw [e2] at p3
  generalize expCost (n + 4) 0 F = E at hb p1
  generalize (octBB n (zsz (a : ℤ)) (zsz (k : ℤ)) + 4) ^ 2 = G at hb p3
  generalize piCost 5 239 (n + 4) = Pc at hb hpi
  simp only [octExpCost]
  rw [hS]
  generalize S ^ 5 = W at *
  generalize S ^ 4 = W4 at *
  generalize S ^ 3 = W3 at *
  nlinarith

end NLogN

