theorem octExpP_top (s : IState HS) (h48 : s.IsInt 48) (h48' : 0 ≤ s.top 48)
    (h49 : s.IsInt 49) (h49' : 0 ≤ s.top 49) (h50 : s.IsInt 50) (h50' : 0 ≤ s.top 50) :
    octExpP.ok s ∧
    octExpP.run s = (s.upd 51 (.int (octExp (s.top 48).toNat (s.top 49).toNat
      (s.top 50).toNat).1 :: s.G 51)).upd 52
      (.int (octExp (s.top 48).toNat (s.top 49).toNat (s.top 50).toNat).2 :: s.G 52) ∧
    octExpP.cost s ≤ octExpCost (s.top 48).toNat (zsz ((s.top 50).toNat : ℤ))
      (zsz ((s.top 49).toNat : ℤ)) := by
  obtain ⟨L48, e48⟩ := top_toNat_G h48 h48'
  obtain ⟨L49, e49⟩ := top_toNat_G h49 h49'
  obtain ⟨L50, e50⟩ := top_toNat_G h50 h50'
  exact ⟨octExpP_ok _ _ _ s L48 L49 L50 e48 e49 e50, octExpP_run _ _ _ s L48 L49 L50 e48 e49 e50,
    octExpP_cost _ _ _ s L48 L49 L50 e48 e49 e50⟩

theorem octExpP_ok' (s : IState HS) (h48 : s.IsInt 48) (h48' : 0 ≤ s.top 48)
    (h49 : s.IsInt 49) (h49' : 0 ≤ s.top 49) (h50 : s.IsInt 50) (h50' : 0 ≤ s.top 50) :
    octExpP.ok s := (octExpP_top s h48 h48' h49 h49' h50 h50').1

theorem octExpP_run' (s : IState HS) (h48 : s.IsInt 48) (h48' : 0 ≤ s.top 48)
    (h49 : s.IsInt 49) (h49' : 0 ≤ s.top 49) (h50 : s.IsInt 50) (h50' : 0 ≤ s.top 50) :
    octExpP.run s = (s.upd 51 (.int (octExp (s.top 48).toNat (s.top 49).toNat
      (s.top 50).toNat).1 :: s.G 51)).upd 52
      (.int (octExp (s.top 48).toNat (s.top 49).toNat (s.top 50).toNat).2 :: s.G 52) :=
  (octExpP_top s h48 h48' h49 h49' h50 h50').2.1

theorem aE_eval (s : IState HS) : NLogN.aE.eval s =
