  have zv : zsz (kh i e) ≤ Bb := hW _ (le_trans (Nat.div_le_self _ _) hkW)
  have hc : condE.Clean := clean_all _ (by intro r hr; simp [condE, Ex.regs] at hr; subst hr; decide)
  have hok : condE.ok (encK s Gs) := ⟨ok_reg gK, trivial, ⟨1, by simp [Ex.eval]⟩⟩
  have hbd : condE.Bnd (encK s Gs) Bb :=
    ⟨bnd_reg gK zv, le_trans (zsz_le_of_lt (by norm_num : (2 : ℤ).natAbs < 2 ^ 2)) hB2⟩
  have hev : condE.eval (encK s Gs) = -((e.1 / 2 ^ i % 2 : ℕ) : ℤ) := by
    simp only [condE, Ex.eval]; rw [top_encK gK]; simp [kh, Int.tmod_eq_emod]
  have hkh : ((e.1 / 2 ^ i / 2 : ℕ) : ℤ) = kh (i + 1) e := by
    simp only [kh, Nat.div_div_eq_div_mul, pow_succ]
  by_cases hb : bitP i e = true
  · have hb' : e.1 / 2 ^ i % 2 = 1 := by simpa [bitP] using hb
    have S := bucket_fsp (Or.inl rfl) hB2 s Gs gK gB hl hbe g1 g1B zv
      (by exact_mod_cast hW (Y1.length + 1) (by omega))
      (by exact_mod_cast hW (Y1.length * B + B) (by nlinarith)) (hW _ hBW)
    rw [if_pos hb]
    refine (FSp.iteT hc hok ⟨trivial, trivial⟩ hbd (by rw [hev, hb']; norm_num) S
      (b := bucket sZ0K sZ0B rn0 rn0B B)).congr ?_ |>.mono ?_
    · congr 1
      funext r
      simp only [Gs, RP, kh] at hkh ⊢
      by_cases a1 : r = rn1B
      · subst a1; simp +decide; push_cast; ring
      by_cases a2 : r = rn1
      · subst a2; simp +decide
      by_cases a3 : r = sZ1B
      · subst a3; simp +decide
      by_cases a4 : r = sKB
      · subst a4; simp +decide
      by_cases a5 : r = sKK
      · subst a5; simp +decide
      by_cases a6 : r = sZ1K
      · subst a6; simp +decide [kh, Int.natCast_div, Nat.div_div_eq_div_mul, pow_succ]
      simp [Function.update_apply, a1, a2, a3, a4, a5, a6]
    · simp only [cEnt, condE, Ex.size]; omega
  · have hb' : e.1 / 2 ^ i % 2 = 0 := by
      have := bit_cases e.1 i; simp [bitP] at hb; omega
    have S := bucket_fsp (Or.inr rfl) hB2 s Gs gK gB hl hbe g0 g0B zv
      (by exact_mod_cast hW (Y0.length + 1) (by omega))
      (by exact_mod_cast hW (Y0.length * B + B) (by nlinarith)) (hW _ hBW)
    rw [if_neg hb]
    refine (FSp.iteF hc hok ⟨trivial, trivial⟩ hbd (by rw [hev, hb']; norm_num) S
      (a := bucket sZ1K sZ1B rn1 rn1B B)).congr ?_ |>.mono ?_
    · congr 1
      funext r
      simp only [Gs, RP, kh] at hkh ⊢
      by_cases a1 : r = rn0B
      · subst a1; simp +decide; push_cast; ring
      by_cases a2 : r = rn0
      · subst a2; simp +decide
      by_cases a3 : r = sZ0B
      · subst a3; simp +decide
      by_cases a4 : r = sKB
      · subst a4; simp +decide
      by_cases a5 : r = sKK
      · subst a5; simp +decide
      by_cases a6 : r = sZ0K
      · subst a6; simp +decide [kh, Int.natCast_div, Nat.div_div_eq_div_mul, pow_succ]
      simp [Function.update_apply, a1, a2, a3, a4, a5, a6]
    · simp only [cEnt, condE, Ex.size]; omega

theorem RP_upd (G : Fin HS → List ℤ) (B i : ℕ) (X Y1 Y0 : List Ent) {j : Fin HS}
    (h : j ∉ [sKK, sKB, sZ1K, sZ1B, sZ0K, sZ0B, rn1, rn1B, rn0, rn0B]) (v : List ℤ) :
    Function.update (RP G B i X Y1 Y0) j v = RP (Function.update G j v) B i X Y1 Y0 := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at h
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ := h
  funext r
  by_cases hr : r = j
  · subst hr; simp [RP, Function.update_apply, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10]
  · simp only [RP, Function.update_apply, hr, if_false]
    simp [Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4, Ne.symm h5, Ne.symm h6, Ne.symm h7,
      Ne.symm h8, Ne.symm h9, Ne.symm h10]

theorem take_succ_of_lt {α : Type*} {l : List α} {j : ℕ} (hj : j < l.length) :
    l.take (j + 1) = l.take j ++ [l[j]] := by
  rw [List.take_succ, List.getElem?_eq_getElem hj]; rfl

theorem Yb_succ (i : ℕ) (E : List Ent) {k : ℕ} (hk : k < E.length) (b : Bool) :
    Yb i E (k + 1) b = (if bitP i E[k] == b then [E[k]] else []) ++ Yb i E k b := by
  simp only [Yb, take_succ_of_lt hk, List.filter_append, List.filter_cons, List.filter_nil,
    List.reverse_append]
  split_ifs <;> simp

theorem length_flatMap_const {Y : List Ent} {g : Ent → List ℤ} {B : ℕ}
    (h : ∀ e ∈ Y, (g e).length = B) : (Y.flatMap g).length = Y.length * B := by
  induction Y with
  | nil => simp
  | cons e Y ih =>
    simp only [List.flatMap_cons, List.length_append, List.length_cons]
    rw [h e (by simp), ih (fun e he => h e (by simp [he]))]; ring

theorem entLoop_fsp {B Bb W : ℕ} (hB2 : 2 ≤ Bb) (hW : ∀ n : ℕ, n ≤ W → zsz (n : ℤ) ≤ Bb)
    (s : IState HS) (G : Fin HS → List ℤ) (i : ℕ) (E : List Ent)
    (hE : ∀ e ∈ E, e.2.length = B ∧ Bnd 1 e.2 ∧ e.1 ≤ W) (hEW : (E.length + 1) * (B + 1) ≤ W)
    (hc3 : G c3 = []) {lnb : List ℤ} (hN : G rNB = (E.length : ℤ) :: lnb) :
    FSp (entLoop B) (encK s (RP G B i E [] []))
      (encK s (RP G B i [] (Yb i E E.length true) (Yb i E E.length false)))
      (cLp E.length (cEnt B Bb) Bb) := by
  have hF : ∀ k, RP G B i (E.drop k) (Yb i E k true) (Yb i E k false) c3 = [] := by
    intro k; simp +decide [RP, Function.update_apply, hc3]
  have H := FSp.repReg (C := c3) (r := rNB) (b := entB B) (s := s)
    (F := fun k => RP G B i (E.drop k) (Yb i E k true) (Yb i E k false)) (N := E.length)
    (c := cEnt B Bb) (Bb := Bb) (by decide) (by decide) hF
    (by simp +decide [entB, bucket, NLogN.mvK, RS.writes]) (L := ints lnb ++ s.G rNB)
    (by simp +decide [RP, Function.update_apply, hN, ints]) (hW _ (by nlinarith)) ?_
  · simpa [Yb, entLoop] using H
  · intro k hk
    rw [RP_upd _ _ _ _ _ _ (by decide), RP_upd _ _ _ _ _ _ (by decide)]
    have hd : E.drop k = E[k] :: E.drop (k + 1) := List.drop_eq_getElem_cons hk
    have he := hE E[k] (List.getElem_mem hk)
    have hl1 : (Yb i E k true).length ≤ k := by
      unfold Yb; rw [List.length_reverse]
      exact le_trans (List.length_filter_le _ _) (by simp)
    have hl0 : (Yb i E k false).length ≤ k := by
      unfold Yb; rw [List.length_reverse]
      exact le_trans (List.length_filter_le _ _) (by simp)
    have S := entB_fsp hB2 hW s (Function.update G c3 [(E.length : ℤ) - k]) i E[k]
      (E.drop (k + 1)) (Yb i E k true) (Yb i E k false) he.1 he.2.1 he.2.2
      (by nlinarith) (by nlinarith)
    rw [hd]
    refine S.congr ?_
    rw [Yb_succ i E hk true, Yb_succ i E hk false]
    by_cases hb : bitP i E[k] = true
    · simp [hb]
    · simp at hb; simp [hb]

theorem flatMap_rev_rev (L : List Ent) :
    ((L.reverse).flatMap (fun e => e.2.reverse)).reverse = L.flatMap Prod.snd := by
  induction L with
  | nil => simp
  | cons a L ih =>
    simp only [List.reverse_cons, List.flatMap_append, List.flatMap_cons, List.flatMap_nil,
      List.append_nil, List.reverse_append, List.reverse_reverse, ih, List.flatMap_cons]

set_option maxHeartbeats 4000000 in
/-- **One radix pass.** -/
theorem passB_fsp {B Bb W : ℕ} (hB2 : 2 ≤ Bb) (hW : ∀ n : ℕ, n ≤ W → zsz (n : ℤ) ≤ Bb)
    (s : IState HS) (G : Fin HS → List ℤ) (i : ℕ) (E : List Ent)
    (hE : ∀ e ∈ E, e.2.length = B ∧ Bnd 1 e.2 ∧ e.1 ≤ W) (hEW : (E.length + 1) * (B + 1) ≤ W)
    {kk0 kb0 lnb : List ℤ} (hK : G sKK = E.map (kh i) ++ kk0) (hB : G sKB = E.flatMap Prod.snd ++ kb0)
    (h1K : G sZ1K = []) (h1B : G sZ1B = []) (h0K : G sZ0K = []) (h0B : G sZ0B = [])
    (hc3 : G c3 = []) (hN : G rNB = (E.length : ℤ) :: lnb) :
    FSp (passB B) (encK s G) (encK s (Function.update (Function.update G
      sKK ((rpass i E).map (kh (i + 1)) ++ kk0)) sKB ((rpass i E).flatMap Prod.snd ++ kb0)))
      (cPass B E.length Bb) := by
  set N := E.length
  have z0 : zsz (0 : ℤ) ≤ Bb := by rw [zsz_zero]; omega
  set Gb := Function.update (Function.update G sKK kk0) sKB kb0 with hGb
  -- pushes
  have S1 := Sp.push s G (i := rn0) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial trivial z0
  simp only [Ex.eval] at S1
  set Ga := Function.update G rn0 ((0 : ℤ) :: G rn0)
  have S2 := Sp.push s Ga (i := rn1) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial trivial z0
  simp only [Ex.eval] at S2
  set Gc := Function.update Ga rn1 ((0 : ℤ) :: Ga rn1)
  have S3 := Sp.push s Gc (i := rn0B) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial trivial z0
  simp only [Ex.eval] at S3
  set Gd := Function.update Gc rn0B ((0 : ℤ) :: Gc rn0B)
  have S4 := Sp.push s Gd (i := rn1B) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial trivial z0
  simp only [Ex.eval] at S4
  have e4 : Function.update Gd rn1B ((0 : ℤ) :: Gd rn1B) = RP Gb B i E [] [] := by
    funext r
    simp only [RP, Gb, Gd, Gc, Ga]
    by_cases a1 : r = sKK
    · subst a1; simp +decide [hK]
    by_cases a2 : r = sKB
    · subst a2; simp +decide [hB]
    by_cases a3 : r = sZ1K
    · subst a3; simp +decide [h1K]
    by_cases a4 : r = sZ1B
    · subst a4; simp +decide [h1B]
    by_cases a5 : r = sZ0K
    · subst a5; simp +decide [h0K]
    by_cases a6 : r = sZ0B
    · subst a6; simp +decide [h0B]
    by_cases a7 : r = rn1
    · subst a7; simp +decide
    by_cases a8 : r = rn1B
    · subst a8; simp +decide
    by_cases a9 : r = rn0
    · subst a9; simp +decide
    by_cases a10 : r = rn0B
    · subst a10; simp +decide
    simp [Function.update_apply, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10]
  rw [e4] at S4
  -- the entry loop
  have SL := entLoop_fsp hB2 hW s Gb i E hE hEW (by simp +decide [Gb, Function.update_apply, hc3])
    (lnb := lnb) (by simp +decide [Gb, Function.update_apply, hN, N])
  simp only [Yb, beq_true, beq_false, List.take_length] at SL
  set E1 := E.filter (bitP i)
  set E0 := E.filter (fun e => !bitP i e)
  have hE1 : ∀ e ∈ E1.reverse, e.2.length = B := fun e he => (hE e (by
    simp only [E1, List.mem_reverse, List.mem_filter] at he; exact he.1)).1
  have hE0 : ∀ e ∈ E0.reverse, e.2.length = B := fun e he => (hE e (by
    simp only [E0, List.mem_reverse, List.mem_filter] at he; exact he.1)).1
  have hl1 : E1.length ≤ N := List.length_filter_le _ _
  have hl0 : E0.length ≤ N := List.length_filter_le _ _
  have hNB : N * B ≤ W := by nlinarith
  have hNW : N ≤ W := by nlinarith
  set G6 := RP Gb B i [] E1.reverse E0.reverse with hG6
  -- move bucket 0
  set L0 := E0.reverse.flatMap (fun e => e.2.reverse)
  have hL0 : L0.length = E0.length * B := by
    rw [NLogN.KFL.length_flatMap_const (B := B) (fun e he => by rw [List.length_reverse]; exact hE0 e he),
      List.length_reverse]
  have g6a : G6 sZ0B = L0 ++ G sZ0B := by simp +decide [G6, RP, Gb, Function.update_apply, L0]
  have g6r : (encK s G6).G rn0B = .int (L0.length : ℤ) :: (ints (G rn0B) ++ s.G rn0B) := by
    simp +decide [G6, RP, Gb, Function.update_apply, hL0, ints]
  have bL0 : Bnd 1 L0 := by
    intro a ha
    simp only [L0, List.mem_flatMap, List.mem_reverse] at ha
    obtain ⟨e, he, ha⟩ := ha
    exact (hE e (by simp only [E0, List.mem_filter] at he; exact he.1)).2.1 a ha
  have S6 := FSp.mvR (X := sZ0B) (Y := sKB) (C := NLogN.KFL.cMv) (r := rn0B) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s G6 L0 (G sZ0B) g6a g6r 1 Bb bL0
    (hW _ (by rw [hL0]; nlinarith))
  set G7 := Function.update (Function.update G6 sZ0B (G sZ0B)) sKB (L0.reverse ++ G6 sKB)
  set K0 := E0.reverse.map (kh (i + 1))
  have g7a : G7 sZ0K = K0 ++ G sZ0K := by simp +decide [G7, G6, RP, Gb, Function.update_apply, K0]
  have g7r : (encK s G7).G rn0 = .int (K0.length : ℤ) :: (ints (G rn0) ++ s.G rn0) := by
    simp +decide [G7, G6, RP, Gb, Function.update_apply, K0, ints]
  have bK0 : Bnd Bb K0 := by
    intro a ha
    simp only [K0, List.mem_map, List.mem_reverse] at ha
    obtain ⟨e, he, rfl⟩ := ha
    exact hW _ (le_trans (Nat.div_le_self _ _) (hE e (by
      simp only [E0, List.mem_filter] at he; exact he.1)).2.2)
  have S7 := FSp.mvR (X := sZ0K) (Y := sKK) (C := NLogN.KFL.cMv) (r := rn0) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s G7 K0 (G sZ0K) g7a g7r Bb Bb bK0
    (hW _ (by simp [K0]; omega))
  set G8 := Function.update (Function.update G7 sZ0K (G sZ0K)) sKK (K0.reverse ++ G7 sKK)
  -- move bucket 1
  set L1 := E1.reverse.flatMap (fun e => e.2.reverse)
  have hL1 : L1.length = E1.length * B := by
    rw [NLogN.KFL.length_flatMap_const (B := B) (fun e he => by rw [List.length_reverse]; exact hE1 e he),
      List.length_reverse]
  have g8a : G8 sZ1B = L1 ++ G sZ1B := by
    simp +decide [G8, G7, G6, RP, Gb, Function.update_apply, L1]
  have g8r : (encK s G8).G rn1B = .int (L1.length : ℤ) :: (ints (G rn1B) ++ s.G rn1B) := by
    simp +decide [G8, G7, G6, RP, Gb, Function.update_apply, hL1, ints]
  have bL1 : Bnd 1 L1 := by
    intro a ha
    simp only [L1, List.mem_flatMap, List.mem_reverse] at ha
    obtain ⟨e, he, ha⟩ := ha
    exact (hE e (by simp only [E1, List.mem_filter] at he; exact he.1)).2.1 a ha
  have S8 := FSp.mvR (X := sZ1B) (Y := sKB) (C := NLogN.KFL.cMv) (r := rn1B) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s G8 L1 (G sZ1B) g8a g8r 1 Bb bL1
    (hW _ (by rw [hL1]; nlinarith))
  set G9 := Function.update (Function.update G8 sZ1B (G sZ1B)) sKB (L1.reverse ++ G8 sKB)
  set K1 := E1.reverse.map (kh (i + 1))
  have g9a : G9 sZ1K = K1 ++ G sZ1K := by
    simp +decide [G9, G8, G7, G6, RP, Gb, Function.update_apply, K1]
  have g9r : (encK s G9).G rn1 = .int (K1.length : ℤ) :: (ints (G rn1) ++ s.G rn1) := by
    simp +decide [G9, G8, G7, G6, RP, Gb, Function.update_apply, K1, ints]
  have bK1 : Bnd Bb K1 := by
    intro a ha
    simp only [K1, List.mem_map, List.mem_reverse] at ha
    obtain ⟨e, he, rfl⟩ := ha
    exact hW _ (le_trans (Nat.div_le_self _ _) (hE e (by
      simp only [E1, List.mem_filter] at he; exact he.1)).2.2)
  have S9 := FSp.mvR (X := sZ1K) (Y := sKK) (C := NLogN.KFL.cMv) (r := rn1) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s G9 K1 (G sZ1K) g9a g9r Bb Bb bK1
    (hW _ (by simp [K1]; omega))
  set G10 := Function.update (Function.update G9 sZ1K (G sZ1K)) sKK (K1.reverse ++ G9 sKK)
  -- pops
  have p1 : G10 rn0 = (E0.length : ℤ) :: G rn0 := by
    simp +decide [G10, G9, G8, G7, G6, RP, Gb, Function.update_apply]
  have S10 := Sp.pop s G10 (B := Bb) (by decide) p1 (hW _ (by omega))
  set G11 := Function.update G10 rn0 (G rn0)
  have p2 : G11 rn1 = (E1.length : ℤ) :: G rn1 := by
    simp +decide [G11, G10, G9, G8, G7, G6, RP, Gb, Function.update_apply]
  have S11 := Sp.pop s G11 (B := Bb) (by decide) p2 (hW _ (by omega))
  set G12 := Function.update G11 rn1 (G rn1)
  have p3 : G12 rn0B = ((E0.length * B : ℕ) : ℤ) :: G rn0B := by
    simp +decide [G12, G11, G10, G9, G8, G7, G6, RP, Gb, Function.update_apply]
  have S12 := Sp.pop s G12 (B := Bb) (by decide) p3 (hW _ (by nlinarith))
  set G13 := Function.update G12 rn0B (G rn0B)
  have p4 : G13 rn1B = ((E1.length * B : ℕ) : ℤ) :: G rn1B := by
    simp +decide [G13, G12, G11, G10, G9, G8, G7, G6, RP, Gb, Function.update_apply]
  have S13 := Sp.pop s G13 (B := Bb) (by decide) p4 (hW _ (by nlinarith))
  have H := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq
    ((FSp.of_norep rfl S4).seq (SL.seq (S6.seq (S7.seq (S8.seq (S9.seq ((FSp.of_norep rfl S10).seq
    ((FSp.of_norep rfl S11).seq ((FSp.of_norep rfl S12).seq (FSp.of_norep rfl S13))))))))))))
  refine (H.congr ?_).mono ?_
  · congr 1
    have eB : L1.reverse ++ (L0.reverse ++ kb0) = (rpass i E).flatMap Prod.snd ++ kb0 := by
      simp only [L1, L0, flatMap_rev_rev, rpass, List.flatMap_append, List.append_assoc, E1, E0]
    have eK : K1.reverse ++ (K0.reverse ++ kk0) = (rpass i E).map (kh (i + 1)) ++ kk0 := by
      simp only [K1, K0, List.map_reverse, List.reverse_reverse, rpass, List.map_append,
        List.append_assoc, E1, E0]
    funext r
    simp only [G13, G12, G11, G10, G9, G8, G7, G6, RP, Gb]
    by_cases a1 : r = sKK
    · subst a1; simp +decide; exact eK
    by_cases a2 : r = sKB
    · subst a2; simp +decide; exact eB
    by_cases a3 : r = sZ1K
    · subst a3; simp +decide
    by_cases a4 : r = sZ1B
    · subst a4; simp +decide
    by_cases a5 : r = sZ0K
    · subst a5; simp +decide
    by_cases a6 : r = sZ0B
    · subst a6; simp +decide
    by_cases a7 : r = rn1
    · subst a7; simp +decide
    by_cases a8 : r = rn1B
    · subst a8; simp +decide
    by_cases a9 : r = rn0
    · subst a9; simp +decide
    by_cases a10 : r = rn0B
    · subst a10; simp +decide
    simp [Function.update_apply, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10]
  · clear H SL S6 S7 S8 S9 S10 S11 S12 S13 S1 S2 S3 S4
    have m1 := cLp_mono (N := L0.length) (N' := N * B) (c := 250 * (1 + 2)) (Bb := Bb)
      (by rw [hL0]; exact Nat.mul_le_mul_right _ hl0) le_rfl le_rfl
    have m2 := cLp_mono (N := L1.length) (N' := N * B) (c := 250 * (1 + 2)) (Bb := Bb)
      (by rw [hL1]; exact Nat.mul_le_mul_right _ hl1) le_rfl le_rfl
    have m3 := cLp_mono (N := K0.length) (N' := N) (c := 250 * (Bb + 2)) (Bb := Bb)
      (by simp [K0]; exact hl0) le_rfl le_rfl
    have m4 := cLp_mono (N := K1.length) (N' := N) (c := 250 * (Bb + 2)) (Bb := Bb)
      (by simp [K1]; exact hl1) le_rfl le_rfl
    have m5 : cLp E.length (cEnt B Bb) Bb = cLp N (cEnt B Bb) Bb := rfl
    simp only [cPass, Ex.size]
    omega

end NLogN.KFL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD Butterfly
theorem NLogN.KFL.radix_fsp {B Bb W A : ℕ} (hB2 : 2 ≤ Bb) (hW : ∀ n : ℕ, n ≤ W → NLogN.zsz (n : ℤ) ≤ Bb)
    (hA : A ≤ W) (s : NLogN.IState NLogN.HS) (G : Fin NLogN.HS → List ℤ) (E : List NLogN.KFL.Ent)
    (hE : ∀ e ∈ E, e.2.length = B ∧ NLogN.Bnd 1 e.2 ∧ e.1 ≤ W) (hEW : (E.length + 1) * (B + 1) ≤ W)
    {kk0 kb0 lnb : List ℤ} (hK : G NLogN.KFL.sKK = E.map (NLogN.KFL.kh 0) ++ kk0) (hB : G NLogN.KFL.sKB = E.flatMap Prod.snd ++ kb0)
    (h1K : G NLogN.KFL.sZ1K = []) (h1B : G NLogN.KFL.sZ1B = []) (h0K : G NLogN.KFL.sZ0K = []) (h0B : G NLogN.KFL.sZ0B = [])
    (hc3 : G NLogN.KFL.c3 = []) (hc2 : G NLogN.KFL.c2 = []) (hN : G NLogN.KFL.rNB = (E.length : ℤ) :: lnb) :
    NLogN.KFD.FSp (NLogN.KFL.radixProg B A) (NLogN.KIL.encK s G) (NLogN.KIL.encK s (Function.update (Function.update G
      NLogN.KFL.sKK ((NLogN.KFL.rsort A E).map (NLogN.KFL.kh A) ++ kk0)) NLogN.KFL.sKB ((NLogN.KFL.rsort A E).flatMap Prod.snd ++ kb0)))
      (NLogN.KFD.cLp A (NLogN.KFL.cPass B E.length Bb) Bb) := by
  set F : ℕ → Fin NLogN.HS → List ℤ := fun k => Function.update (Function.update G
      NLogN.KFL.sKK ((NLogN.KFL.rsort k E).map (NLogN.KFL.kh k) ++ kk0)) NLogN.KFL.sKB ((NLogN.KFL.rsort k E).flatMap Prod.snd ++ kb0) with hF
  have e0 : F 0 = G := by
    simp only [F, NLogN.KFL.rsort]; rw [← hK, ← hB]; simp
  have H := NLogN.KFD.FSp.repLit (C := NLogN.KFL.c2) (b := NLogN.KFL.passB B) (s := s) (F := F) (N := A) (c := NLogN.KFL.cPass B E.length Bb)
    (Bb := Bb) (by decide) (fun k => by simp +decide [F, Function.update_apply, hc2])
    (by simp +decide [NLogN.KFL.passB, NLogN.KFL.entLoop, NLogN.KFL.entB, NLogN.KFL.bucket, NLogN.mvK, NLogN.RS.writes]) (hW _ hA) ?_
  · rw [e0] at H; exact H
  · intro k hk
    have hp := NLogN.KFL.rsort_perm k E
    have hE' : ∀ e ∈ NLogN.KFL.rsort k E, e.2.length = B ∧ NLogN.Bnd 1 e.2 ∧ e.1 ≤ W := fun e he => hE e (hp.subset he)
    have hl := hp.length_eq
    have S := NLogN.KFL.passB_fsp hB2 hW s (Function.update (F k) NLogN.KFL.c2 [(A : ℤ) - k]) k (NLogN.KFL.rsort k E) hE'
      (by rw [hl]; exact hEW) (kk0 := kk0) (kb0 := kb0) (lnb := lnb)
      (by simp +decide [F, Function.update_apply])
      (by simp +decide [F, Function.update_apply])
      (by simp +decide [F, Function.update_apply, h1K]) (by simp +decide [F, Function.update_apply, h1B])
      (by simp +decide [F, Function.update_apply, h0K]) (by simp +decide [F, Function.update_apply, h0B])
      (by simp +decide [F, Function.update_apply, hc3])
      (by simp +decide [F, Function.update_apply, hN, hl])
    rw [hl] at S
    refine S.congr ?_
    congr 1
    funext r
    simp only [F, NLogN.KFL.rsort]
    by_cases a1 : r = NLogN.KFL.sKB
    · subst a1; simp +decide
    by_cases a2 : r = NLogN.KFL.sKK
    · subst a2; simp +decide
    by_cases a3 : r = NLogN.KFL.c2
    · subst a3; simp +decide
    simp [Function.update_apply, a1, a2, a3]
end
