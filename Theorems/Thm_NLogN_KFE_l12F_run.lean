variable {α β : Type*}

theorem pull_map (f : α → β) (sh sh' : Shape) (g : List ℕ → List ℕ) (d : α) (xs : List α) :
    AModel.pull sh sh' g (f d) (xs.map f) = (AModel.pull sh sh' g d xs).map f := by
  simp only [AModel.pull, List.map_map]
  refine List.map_congr_left fun j _ => ?_
  simp only [Function.comp, List.getD_map]

theorem highSwaps_map (f : α → β) (sh : Shape) (i j : ℕ) (d : α) :
    ∀ (r : ℕ) (xs : List α), highSwaps sh i j r (f d) (xs.map f) = (highSwaps sh i j r d xs).map f
  | 0, xs => rfl
  | r + 1, xs => by
    simp only [highSwaps, List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil]
    have := highSwaps_map f sh i j d r xs
    simp only [highSwaps] at this
    rw [this, pull_map]

end Aux

