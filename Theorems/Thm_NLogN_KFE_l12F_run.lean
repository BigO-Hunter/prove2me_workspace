theorem extract_trans {S T U : Shape} (h1 : ShapeLE S T) (d : α) (ys : List α) :
    extract S T d (extract T U d ys) = extract S U d ys := by
  unfold extract
  rw [pull_comp id id (fun a ha => h1.valid ha)]
