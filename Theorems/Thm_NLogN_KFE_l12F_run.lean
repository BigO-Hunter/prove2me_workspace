-- Source module: Solutions.KIL6Reg
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem Sp.popD (s : IState HS) (B : ℕ) :
    ∀ (D : List (Fin HS)) (F : Fin HS → List ℤ) (v : Fin HS → ℕ), (∀ i ∈ D, i.val < 56) →
      D.Nodup → (∀ i ∈ D, zsz (v i : ℤ) ≤ B) →
      Sp (popDs D) (encK s (regState F v D)) (encK s F) (D.length * (2 * B + 2) + 1)
  | [], F, v, _, _, _ => by rw [regState_nil]; exact (Sp.skip _).mono (by simp)
  | i :: D, F, v, h56, hnd, hB => by
      have h1 := Sp.pop s (regState F v (i :: D)) (i := i) (B := B) (h56 i (by simp))
        (regState_mem (by simp)) (hB i (by simp))
      have h2 := Sp.popD s B D F v (fun j hj => h56 j (by simp [hj])) (List.nodup_cons.1 hnd).2
        (fun j hj => hB j (by simp [hj]))
      refine ((h1.congr ?_).seq h2).mono ?_
      · congr 1; funext j
        simp only [regState, Function.update_apply, List.mem_cons]
        by_cases hj : j = i
        · subst hj; simp [(List.nodup_cons.1 hnd).1]
        · simp [hj]
      · simp only [List.length_cons]; ring_nf; omega

end NLogN.KIL

end

