theorem postB_fsp (s : IState HS) (F : Fin HS → List ℤ) (v : Fin HS → ℕ) {M B : ℕ}
    (hM : zsz (M : ℤ) ≤ B) (hv : ∀ i ∈ regD, v i ≤ M) {Pre G Suf : Shape} {T Q : ℕ}
    {LP LG LS : List ℤ}
    (FP : F kP = (vol Pre : ℤ) :: LP) (FG : F kG = (vol G : ℤ) :: LG)
    (FS : F NLogN.KIL.kS = (vol Suf : ℤ) :: LS)
    (vP : v kP = vol Pre) (vG : v kG = vol G) (vS : v NLogN.KIL.kS = vol Suf) (vT : v aT2 = T)
    (vQ : v aQE = Q) (hP : 1 ≤ vol Pre) (hg : 1 ≤ vol G) (hS : 1 ≤ vol Suf) (hT : 1 ≤ T)
    (hTQ : T ≤ Q) (hVM : vol (binShape Pre G Suf Q) ≤ M) (ys : List (ZMod 2))
    (F0 : F 0 = enc2 ys) (F15 : F 15 = []) (F20 : F 20 = []) (F21 : F 21 = [])
    (hys : ys.length = vol (binShape Pre G Suf Q)) (hB1 : 1 ≤ B) :
    ∃ v' : Fin HS → ℕ, (∀ i, i ∉ [pX, pB, pZ, pT] → v' i = v i) ∧ (∀ i ∈ regD, v' i ≤ M) ∧
      FSp postB (encK s (regState F v regD))
        (encK s (regState (Function.update F 0
          (enc2 (extract (binShape Pre G Suf T) (binShape Pre G Suf Q) 0 ys))) v' regD))
        (2 * (10 ^ 9 * (B + 2) ^ 2 + cPadF (vol (binShape Pre G Suf Q)) B)) := by
  set P := vol Pre
  set g := vol G
  set S := vol Suf
  have hVM' : P * (Q * (g * (Q * S))) ≤ M := by rw [← vol_binShape]; exact hVM
  obtain ⟨b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18⟩ :=
    binBounds hP hg hS hT hTQ
  obtain ⟨-, -, -, -, e5, e6, e7, -, e8, -⟩ :=
    padE_all FP FG FS vP vG vS vT vQ hP hg hS hT hTQ hVM'
  have S1 := unpadS_fsp s F v hM hv (.reg kP) NLogN.KIL.bB NLogN.KIL.zB tUB e5 e6 e7 e8 (X := P) (Fa := T) (Fb := Q)
    (Y := g * (Q * S)) (by simp [NE.val, vP])
    (by simp [NLogN.KIL.bB, yB, NE.val, vP, vG, vS, vT, vQ])
    (by simp [NLogN.KIL.zB, yB, NE.val, vP, vG, vS, vT, vQ])
    (by simp [tUB, yB, NE.val, vP, vG, vS, vT, vQ])
    hTQ (by omega) (Nat.mul_pos hg (Nat.mul_pos (by omega) hS)) (by omega) (enc2 ys) F0 F15 F20 F21
    (by rw [length_enc2, hys, vol_binShape]) (bnd_enc2 ys (le_refl 1))
  set v1 := padV v P (T * (g * (Q * S))) ((Q - T) * (g * (Q * S))) (P * (T * (g * (Q * S))))
    with hv1
  have fr1 : ∀ i, i ∉ [pX, pB, pZ, pT] → v1 i = v i := fun i hi => by
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    exact padV_frame _ _ _ _ _ i hi.1 hi.2.1 hi.2.2.1 hi.2.2.2
  have hv1 : ∀ i ∈ regD, v1 i ≤ M := padV_bound hv (by omega) (by omega) (by omega) (by omega)
  set F1 := Function.update F 0 (unpadL P T Q (g * (Q * S)) (enc2 ys)) with hF1
  have F1n : ∀ i, i ≠ 0 → F1 i = F i := fun i hi => Function.update_of_ne hi _ _
  obtain ⟨e1, e2, e3, -, -, -, -, -, -, e4⟩ := padE_all (F := F1) (v := v1) (M := M)
    (by rw [F1n _ (by decide)]; exact FP) (by rw [F1n _ (by decide)]; exact FG)
