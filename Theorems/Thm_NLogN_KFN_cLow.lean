section Mono

variable {L s W A m : ℕ} {CR τ : ℝ}

theorem Eb_succ (hs : 1 ≤ s) (k : ℕ) : Eb L s k ≤ Eb L s (k + 1) := by
  show Eb L s k ≤ L + s * Eb L s k; nlinarith

theorem DWb_succ (hs : 1 ≤ s) (k : ℕ) : DWb L s W A k ≤ DWb L s W A (k + 1) := by
  show DWb L s W A k ≤ s * (DWb L s W A k + (Eb L s k + 2) * W) + L * dwloc W A
  nlinarith [Nat.mul_le_mul_right (DWb L s W A k + (Eb L s k + 2) * W) hs]

theorem Whb_succ (k : ℕ) : Whb L s W A k ≤ Whb L s W A (k + 1) := by
  show Whb L s W A k ≤ DWb L s W A (k + 1) + Ob L s W A k + Whb L s W A k; omega

theorem cb_nonneg (hCR : 0 ≤ CR) (k : ℕ) : 0 ≤ cb L s W A m CR τ k := by
  induction k with
  | zero => simp [cb]
  | succ k ih =>
    simp only [cb]
    have : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ := mul_nonneg hCR (by positivity)
    positivity

theorem cb_succ (hCR : 0 ≤ CR) (hsW : W ≤ s) (hW : 1 ≤ W) (k : ℕ) :
    cb L s W A m CR τ k ≤ cb L s W A m CR τ (k + 1) := by
  simp only [cb]
  have h0 := cb_nonneg (L := L) (s := s) (W := W) (A := A) (m := m) (τ := τ) hCR k
  have h1 : (1 : ℝ) ≤ (s / W : ℝ) := by
    rw [le_div_iff₀ (by exact_mod_cast hW)]; simp; exact_mod_cast hsW
  have h2 : (0 : ℝ) ≤ ((s + L : ℕ) : ℝ) * ((alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) := by
    have : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ := mul_nonneg hCR (by positivity)
    positivity
  nlinarith

end Mono

