variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}
theorem NLogN.KFN.cLow (hGc : NLogN.KFN.GClass J A) (hrow : NLogN.KFN.RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hsW : W ≤ s) (hm : 1 ≤ m) (hr : 1 ≤ r) (hΨm : Monotone Ψ)
    (hZΨ : ∀ v, Z + 2 ≤ Ψ v) (k D' : ℕ) (hD' : D' < m ^ (k + 1)) (pos : Fin D' → ℕ)
    (hinj : Function.Injective pos) (t S0 B : ℕ) (hpos : ∀ i, pos i < t) (haff : NLogN.KFN.AffK K t pos)
    (hS : 1 ≤ S0)
    (hB : 1 ≤ B) (hdvd : W ^ k ∣ B) (hZ : NLogN.zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z) :
    ∃ (code : ℕ → NLogN.IStmt NLogN.HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      NLogN.KFN.SImplI Isym iprog r (fun i => 2 ^ pos i * S0) (B * 2 ^ t * S0) (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D'))
        code e dw cost ∧
      e ≤ (k + 1) * m * NLogN.KFN.Eb J.net.length s k ∧ dw ≤ (k + 1) * m * NLogN.KFN.DWb J.net.length s W A k ∧
      ∀ w, (cost w : ℝ) ≤ ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb J.net.length s W A m CR τ k + 1) *
        ((B * 2 ^ t * S0 : ℕ) : ℝ) *
        (NLogN.KFN.Xf r Ψ (w + (k + 1) * m * NLogN.KFN.DWb J.net.length s W A k + NLogN.KFN.Whb J.net.length s W A k) : ℝ) := by
  have hs1 : 1 ≤ s := le_trans hW hsW
  set L := J.net.length
  have LV := NLogN.KFN.lv_all J hGc hrow hCR hτ hW hr hΨm hZΨ
  set n := B * 2 ^ t * S0
  have hn : 1 ≤ n := NLogN.KFN.one_le_nR (t := t) hS hB
  set ps := NLogN.KFN.pcs m k 0 D'
  have hmem : ∀ p ∈ ps, p.1 ≤ k ∧ p.2 + m ^ p.1 ≤ D' := fun p hp => by
    have := NLogN.KFN.mem_pcs m hm k 0 D' p hp; exact ⟨this.1, by omega⟩
  have hEm : Monotone (NLogN.KFN.Eb L s) := monotone_nat_of_le_succ (NLogN.KFN.Eb_succ hs1)
  have hDm : Monotone (NLogN.KFN.DWb L s W A) := monotone_nat_of_le_succ (NLogN.KFN.DWb_succ hs1)
  have hWm : Monotone (NLogN.KFN.Whb L s W A) := monotone_nat_of_le_succ NLogN.KFN.Whb_succ
  have hcm : Monotone (NLogN.KFN.cb L s W A m CR τ) := monotone_nat_of_le_succ (NLogN.KFN.cb_succ hCR hsW hW)
  set F : ℕ × ℕ → Fin D' → Butterfly.M2 := fun p i => if NLogN.KFN.covers m i.val p then Butterfly.Cm else 1
  haveI : Inhabited (ℕ → NLogN.IStmt NLogN.HS Pp) := ⟨fun _ => .skip⟩
  have hpiece : ∀ p, p ∈ ps → ∃ (code : ℕ → NLogN.IStmt NLogN.HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      NLogN.KFN.SImplI Isym iprog r (fun i => 2 ^ pos i * S0) n (Butterfly.tensF (F p)) code e dw cost ∧
      e ≤ NLogN.KFN.Eb L s k ∧ dw ≤ NLogN.KFN.DWb L s W A k ∧
      ∀ w, (cost w : ℝ) ≤ NLogN.KFN.cb L s W A m CR τ k * (n : ℝ) * (NLogN.KFN.Xf r Ψ (w + NLogN.KFN.Whb L s W A k) : ℝ) := by
    intro p hp
    obtain ⟨hj, ho⟩ := hmem p hp
    obtain ⟨LVj, hcj⟩ := LV p.1
    have hdj : W ^ p.1 ∣ B := (pow_dvd_pow W hj).trans hdvd
    obtain ⟨c, e, d, cost, H, he, hd, hc⟩ := LVj (pos ∘ NLogN.KFN.pcE ho) t S0 B
      (hinj.comp (NLogN.KFN.pcE_inj ho)) (fun i => hpos _) (NLogN.KFN.affK_piece haff (NLogN.KFN.pcE ho) (fun i => rfl)) hS hB hdj hZ
    have H2 := NLogN.KFN.sImpl_subOp (st := fun i => 2 ^ pos i * S0) (NLogN.KFN.pcE_inj ho) H
    rw [NLogN.KFN.subOp_tens (NLogN.KFN.pcE_inj ho)] at H2
    have hiff : ∀ i : Fin D', (∃ q, NLogN.KFN.pcE ho q = i) ↔ (p.2 ≤ i.val ∧ i.val < p.2 + m ^ p.1) := by
      intro i
      constructor
      · rintro ⟨q, hq⟩
        have := congrArg Fin.val hq
        simp only [NLogN.KFN.pcE] at this
        have := q.isLt
        omega
      · intro hc
        exact ⟨⟨i.val - p.2, by omega⟩, Fin.ext (by simp only [NLogN.KFN.pcE]; omega)⟩
    have H3 := H2.congrT (show Butterfly.tensF _ = Butterfly.tensF (F p) by
      congr 1; funext i
      simp only [F, NLogN.KFN.covers, decide_eq_true_eq, hiff])
    refine ⟨c, e, d, cost, H3, he.trans (hEm hj), hd.trans (hDm hj), fun w => ?_⟩
    refine (hc w).trans ?_
    have hX : (NLogN.KFN.Xf r Ψ (w + NLogN.KFN.Whb L s W A p.1) : ℝ) ≤ (NLogN.KFN.Xf r Ψ (w + NLogN.KFN.Whb L s W A k) : ℝ) := by
      exact_mod_cast NLogN.KFN.Xf_mono hΨm (by have := hWm hj; omega)
    have h0 : 0 ≤ NLogN.KFN.cb L s W A m CR τ p.1 := hcj
    have h1 : NLogN.KFN.cb L s W A m CR τ p.1 ≤ NLogN.KFN.cb L s W A m CR τ k := hcm hj
    have hX0 : (0 : ℝ) ≤ (NLogN.KFN.Xf r Ψ (w + NLogN.KFN.Whb L s W A p.1) : ℝ) := by positivity
    calc NLogN.KFN.cb L s W A m CR τ p.1 * (n : ℝ) * (NLogN.KFN.Xf r Ψ (w + NLogN.KFN.Whb L s W A p.1) : ℝ)
        ≤ NLogN.KFN.cb L s W A m CR τ k * (n : ℝ) * (NLogN.KFN.Xf r Ψ (w + NLogN.KFN.Whb L s W A p.1) : ℝ) := by
          apply mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h1 (by positivity)) hX0
      _ ≤ _ := mul_le_mul_of_nonneg_left hX (by have := hcj.trans h1; positivity)
  choose! code e dw cost hP using hpiece
  have hs : NLogN.KFN.SLaws (fun i => 2 ^ pos i * S0) n := NLogN.KFN.slaws_pow pos hinj t S0 B hpos
  have H := NLogN.KFN.sImpl_tensF_list hs F code e dw cost ps (fun p hp => (hP p hp).1)
  have hT : (Butterfly.tensF fun i => ((ps.map fun p => F p i).reverse).prod) =
      (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D')) := by
    unfold Butterfly.tens; congr 1; funext i
    rw [← List.map_reverse]
    have := NLogN.KFN.prod_ind Butterfly.Cm (NLogN.KFN.covers m i.val) ps.reverse
    simp only [F] at this ⊢
    rw [this, List.countP_reverse, NLogN.KFN.countP_pcs m hm i.val k 0 D', if_pos ⟨by omega, by simp⟩,
      pow_one]
  rw [hT] at H
  have hlen : ps.length ≤ (k + 1) * m := by
    have := NLogN.KFN.length_pcs m hm k 0 D'
    have h2 : D' / m ^ k < m := by
      rw [Nat.div_lt_iff_lt_mul (pow_pos (by omega) k), ← pow_succ']; exact hD'
    nlinarith
  have hdw : (ps.map dw).sum ≤ (k + 1) * m * NLogN.KFN.DWb L s W A k := by
    have := NLogN.KFN.sum_le_count' (fun _ => false) (NLogN.KFN.DWb L s W A k) (NLogN.KFN.DWb L s W A k) dw ps
      (fun p hp => by simpa using (hP p hp).2.2.1)
    rw [show ps.countP (fun _ => false) = 0 by simp, zero_mul, zero_add] at this
    exact this.trans (Nat.mul_le_mul_right _ hlen)
  refine ⟨_, _, _, _, H, ?_, hdw, fun w => ?_⟩
  · have := NLogN.KFN.sum_le_count' (fun _ => false) (NLogN.KFN.Eb L s k) (NLogN.KFN.Eb L s k) e ps
      (fun p hp => by simpa using (hP p hp).2.1)
    rw [show ps.countP (fun _ => false) = 0 by simp, zero_mul, zero_add] at this
    exact this.trans (Nat.mul_le_mul_right _ hlen)
  · set bd : ℕ × ℕ → ℕ → ℝ := fun _ v => NLogN.KFN.cb L s W A m CR τ k * (n : ℝ) * (NLogN.KFN.Xf r Ψ (v + NLogN.KFN.Whb L s W A k) : ℝ)
    have hcb0 : 0 ≤ NLogN.KFN.cb L s W A m CR τ k := (LV k).2
    have hmono : ∀ p, Monotone (bd p) := fun p u v huv => by
      simp only [bd]
      exact mul_le_mul_of_nonneg_left (by exact_mod_cast NLogN.KFN.Xf_mono hΨm (by omega)) (by positivity)
    have C := NLogN.KFN.costL_le cost dw bd hmono ps (fun p hp => (hP p hp).2.2.2) w
    simp only [bd, List.map_const', List.sum_replicate, nsmul_eq_mul] at C
    have hX : (NLogN.KFN.Xf r Ψ (w + (ps.map dw).sum + NLogN.KFN.Whb L s W A k) : ℝ) ≤
        (NLogN.KFN.Xf r Ψ (w + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k) : ℝ) := by
      exact_mod_cast NLogN.KFN.Xf_mono hΨm (by omega)
    have hXW : (1 : ℝ) ≤ (NLogN.KFN.Xf r Ψ (w + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k) : ℝ) := by
      have : 1 ≤ NLogN.KFN.Xf r Ψ (w + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k) := by
        unfold NLogN.KFN.Xf; have := hZΨ (w + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k); omega
      exact_mod_cast this
    set XW := (NLogN.KFN.Xf r Ψ (w + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k) : ℝ)
    have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have hl : (ps.length : ℝ) ≤ (((k + 1) * m : ℕ) : ℝ) := by exact_mod_cast hlen
    have hX0 : (0 : ℝ) ≤ (NLogN.KFN.Xf r Ψ (w + (ps.map dw).sum + NLogN.KFN.Whb L s W A k) : ℝ) := by positivity
    have k1 : (ps.length : ℝ) * (NLogN.KFN.cb L s W A m CR τ k * (n : ℝ) *
        (NLogN.KFN.Xf r Ψ (w + (ps.map dw).sum + NLogN.KFN.Whb L s W A k) : ℝ)) ≤
        (((k + 1) * m : ℕ) : ℝ) * (NLogN.KFN.cb L s W A m CR τ k * (n : ℝ) * XW) := by
      apply mul_le_mul hl _ (by positivity) (by positivity)
      exact mul_le_mul_of_nonneg_left hX (by positivity)
    have k2 : (1 : ℝ) ≤ (n : ℝ) * XW := by nlinarith
    calc (NLogN.KFN.costL cost dw ps w : ℝ)
        ≤ (ps.length : ℝ) * (NLogN.KFN.cb L s W A m CR τ k * (n : ℝ) *
          (NLogN.KFN.Xf r Ψ (w + (ps.map dw).sum + NLogN.KFN.Whb L s W A k) : ℝ)) + 1 := C
      _ ≤ (((k + 1) * m : ℕ) : ℝ) * (NLogN.KFN.cb L s W A m CR τ k * (n : ℝ) * XW) + (n : ℝ) * XW := by
        linarith
      _ = _ := by ring
end
