variable {r : ℕ} {Ψ : ℕ → ℕ} {Z : ℕ}

theorem cMv_X {n w : ℕ} (hn : 1 ≤ n) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    (hZ : zsz ((2 * (n * r) : ℕ) : ℤ) ≤ Z) : NLogN.KFN.cMv (2 * (n * r)) w ≤ 6000 * n * Xf r Ψ w := by
  unfold NLogN.KFN.cMv Xf
  have h1 := cRep_le_lin (2 * (n * r))
  have h2 := hZΨ w
  have e : 2 * (n * r) * (250 * (w + 2)) = 500 * n * (r * (w + 1)) + 500 * (n * r) := by ring
  have h3 : Z + 2 + 1200 ≤ 601 * n * Ψ w := by nlinarith
  have h4 : 1500 * (2 * (n * r)) + 500 * (n * r) ≤ 3500 * n * (r * (w + 1)) := by
    have : n * r ≤ n * (r * (w + 1)) := Nat.mul_le_mul_left _ (by nlinarith)
    nlinarith
  have hzz : zsz (((2 * (n * r) : ℕ)) : ℤ) ≤ Z := hZ
  nlinarith

theorem cLp_X {n Q c w : ℕ} (hn : 1 ≤ n) (hr : 1 ≤ r) (hQ : Q ≤ 2 * (n * r)) (hc : c ≤ 2 * w + 8000)
    (hZΨ : ∀ v, Z + 2 ≤ Ψ v) : cLp Q c Z ≤ 30000 * n * Xf r Ψ w := by
  unfold cLp Xf
  have h2 := hZΨ w
  have h3 : 1000 * (Z + 2) ≤ 1000 * n * Ψ w := by nlinarith
  have h4 : Q * (c + 1100) ≤ 2 * (n * r) * (2 * w + 9100) := Nat.mul_le_mul hQ (by omega)
  have h5 : 2 * (n * r) * (2 * w + 9100) ≤ 20000 * n * (r * (w + 1)) := by nlinarith
  nlinarith

theorem cPadC_X {n np w dw : ℕ} (cost : ℕ → ℕ) (hn : 1 ≤ n) (hr : 1 ≤ r) (hnp : np ≤ 2 * n)
    (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) (hZ : zsz ((2 * (n * r) : ℕ) : ℤ) ≤ Z) :
    cPadC (2 * (n * r)) (2 * ((np - n) * r)) Z w dw cost ≤
      cost w + 100000 * n * Xf r Ψ (w + dw) := by
  unfold cPadC
  have hQ : 2 * ((np - n) * r) ≤ 2 * (n * r) := by
    have : (np - n) * r ≤ n * r := Nat.mul_le_mul_right _ (by omega)
    omega
  have a1 := cMv_X (r := r) (Ψ := Ψ) (w := w) hn hZΨ hZ
  have a2 := cMv_X (r := r) (Ψ := Ψ) (w := w + dw) hn hZΨ hZ
  have a3 := cLp_X (r := r) (Ψ := Ψ) (c := 8000) (w := w) hn hr hQ (by omega) hZΨ
  have a4 := cLp_X (r := r) (Ψ := Ψ) (c := 2 * (w + dw) + 2) (w := w + dw) hn hr hQ (by omega) hZΨ
  have x1 : Xf r Ψ w ≤ Xf r Ψ (w + dw) := Xf_mono hΨm (by omega)
  have b1 : 6000 * n * Xf r Ψ w ≤ 6000 * n * Xf r Ψ (w + dw) := Nat.mul_le_mul_left _ x1
  have b3 : 30000 * n * Xf r Ψ w ≤ 30000 * n * Xf r Ψ (w + dw) := Nat.mul_le_mul_left _ x1
  linarith

end Bounds

section Layer

variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}

theorem mem_topL {D q0 : ℕ} (h : q0 ≤ D) (i : Fin D) : i ∈ topL D q0 h ↔ i.val < q0 := by
  simp only [topL, List.mem_map, List.mem_finRange, true_and]
  constructor
  · rintro ⟨j, rfl⟩; simp
  · intro hi; exact ⟨⟨i.val, hi⟩, Fin.ext (by simp)⟩

theorem nodup_topL {D q0 : ℕ} (h : q0 ≤ D) : (topL D q0 h).Nodup :=
  (List.nodup_finRange q0).map (Fin.castLE_injective h)

theorem length_topL {D q0 : ℕ} (h : q0 ≤ D) : (topL D q0 h).length = q0 := by simp [topL]

theorem lowE_inj {D q0 : ℕ} (h : q0 ≤ D) : Function.Injective (lowE h) := by
  intro a b e
  have := congrArg Fin.val e
  simp only [lowE] at this
  exact Fin.ext (by omega)

theorem ck_X {n w : ℕ} (hn : 1 ≤ n) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) :
    ck (n * r) Z w ≤ 100000 * n * Xf r Ψ (w + 2) := by
  unfold ck Xf
  have hΨ := hZΨ (w + 2)
  have e : w + 2 + 1 = w + 3 := by ring
  rw [e]
  have h1 : 30000 * (Z + 2) ≤ 100000 * n * Ψ (w + 2) := by nlinarith
  nlinarith

end Layer

end NLogN.KFN

