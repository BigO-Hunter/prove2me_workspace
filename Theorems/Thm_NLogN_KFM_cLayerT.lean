          apply Nat.mul_le_mul_right; omega
    have HP := NLogN.KFN.sImpl_pad hs' hnp Hl Z hZpad
    have hst : (fun i : Fin D' => 2 ^ pos' i * S) = (fun i : Fin D => NLogN.KFH.stT K D S ρ i) ∘ NLogN.KFN.lowE hq0 := by
      funext i
      simp only [Function.comp_apply, hpos'def]
      rw [NLogN.KFN.stT_low hq0 i]
    rw [hst, ← hnB] at HP
    have HL := NLogN.KFN.sImpl_subOp (NLogN.KFN.lowE_inj hq0) HP
    rw [NLogN.KFN.subOp_tens (NLogN.KFN.lowE_inj hq0)] at HL
    -- the top kernels
