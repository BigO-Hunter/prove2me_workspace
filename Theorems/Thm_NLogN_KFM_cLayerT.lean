    rw [NLogN.KFN.length_topL] at HC'
    refine ⟨_, _, _, _, HC', ?_, ?_, fun w => ?_⟩
    · have := hel
      linarith
    · have := hdl
      linarith
    · -- cost
      set Wf := w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2
      have c1 := NLogN.KFN.ck_X (r := r) (Ψ := Ψ) (Z := Z) (w := w + 2 * q0) hn1 hZΨ
      have x1 : NLogN.KFN.Xf r Ψ (w + 2 * q0 + 2) ≤ NLogN.KFN.Xf r Ψ Wf := NLogN.KFN.Xf_mono hΨm (by omega)
      have cT : q0 * NLogN.KFH.ck (n * r) Z (w + 2 * q0) + 1 ≤ 100000 * (q0 + 1) * n * NLogN.KFN.Xf r Ψ Wf := by
        have h0 := Nat.mul_le_mul_left q0 (c1.trans (Nat.mul_le_mul_left _ x1))
        have h1 : 1 ≤ NLogN.KFN.Xf r Ψ Wf := by unfold NLogN.KFN.Xf; have := hZΨ Wf; omega
        have h2 : 1 ≤ n * NLogN.KFN.Xf r Ψ Wf := Nat.mul_le_mul hn1 h1
        have e : 100000 * (q0 + 1) * n * NLogN.KFN.Xf r Ψ Wf = q0 * (100000 * n * NLogN.KFN.Xf r Ψ Wf) +
            100000 * (n * NLogN.KFN.Xf r Ψ Wf) := by ring
