    have HT := (NLogN.KFN.sImpl_of_limpl hρ LT).toI (I := Isym) (iprog := iprog) (NLogN.KFH.fok_kersP _ _ _ _ _ _ _ _)
    rw [← hndef] at HT
    have hTT : (((NLogN.KFN.topL D q0 hq0).map fun i => Butterfly.kerAt i Butterfly.Cm).map Butterfly.tensF).prod =
        Butterfly.tensF (fun i : Fin D => if i ∈ NLogN.KFN.topL D q0 hq0 then Butterfly.Cm else 1) := by
      rw [← Butterfly.tensF_list_prod]
      congr 1; funext i
      rw [List.map_map]
      have := Butterfly.list_prod_kerAt Butterfly.Cm i (NLogN.KFN.topL D q0 hq0) (NLogN.KFN.nodup_topL hq0)
      rw [List.map_map] at this
      exact this
    have HT' := HT.congrT hTT
    have hsL : NLogN.KFN.SLaws (fun i : Fin D => NLogN.KFH.stT K D S ρ i) n := by
      have := NLogN.KFN.slaws_layer (P := P) (D := D) (S := S) hρ
      rw [hnv]; exact this
    have HC := HT'.comp hsL HL
    rw [← Butterfly.tensF_mul] at HC
    have HC' := HC.congrT (show Butterfly.tensF _ = (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) by
      unfold Butterfly.tens; congr 1; funext i
      by_cases hi : i.val < q0
      · have h1 : ¬ ∃ q, NLogN.KFN.lowE hq0 q = i := by
          rintro ⟨q, hq⟩
          have := congrArg Fin.val hq
          simp only [NLogN.KFN.lowE] at this
          omega
        have h2 : i ∈ NLogN.KFN.topL D q0 hq0 := (NLogN.KFN.mem_topL hq0 i).2 hi
        simp [h1, h2]
      · have h1 : ∃ q, NLogN.KFN.lowE hq0 q = i :=
          ⟨⟨i.val - q0, by omega⟩, Fin.ext (by simp only [NLogN.KFN.lowE]; omega)⟩
        have h2 : i ∉ NLogN.KFN.topL D q0 hq0 := fun h => hi ((NLogN.KFN.mem_topL hq0 i).1 h)
