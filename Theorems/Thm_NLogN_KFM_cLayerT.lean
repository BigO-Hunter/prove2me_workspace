    refine q'.trans ?_
    have hX0 := hXge (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2)
    have hn0 : (0 : ℝ) ≤ n := by positivity
    have : 100000 * ((D : ℝ) + 1) ≤ 2 * (((((k + 1) * m : ℕ)) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) +
        1000000 * (((Nat.log m D * L2 : ℕ) : ℝ) + 2) := by
      have : (0 : ℝ) ≤ ((((k + 1) * m : ℕ)) : ℝ) * NLogN.KFN.cb L s W A m CR τ k := by positivity
      have hqD : (D : ℝ) ≤ ((Nat.log m D * L2 : ℕ) : ℝ) := by exact_mod_cast hq
      nlinarith
    apply mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right this hn0) (by linarith)
  · -- top kernels, then digit pieces on the padded low part
    push Not at hq
    set q0 := k * L2 with hq0def
    have hq0 : q0 ≤ D := by omega
    set D' := D - q0 with hD'def
    have hD'1 : 1 ≤ D' := by omega
    have hK : 1 ≤ K := by omega
    set t' := K * D'
    set B := P * 2 ^ (K * q0) with hBdef
    have hnB : n = B * 2 ^ t' * S := by
      rw [hnv, ← pow_mul, hBdef]
      have : K * D = K * q0 + K * D' := by rw [← Nat.mul_add]; congr 1; omega
      rw [this, pow_add]; ring
    -- B ≥ W^k
    have hWkB : W ^ k ≤ B := by
      calc W ^ k ≤ (2 ^ L2) ^ k := Nat.pow_le_pow_left hL2 k
        _ = 2 ^ q0 := by rw [← pow_mul, hq0def, mul_comm]
        _ ≤ 2 ^ (K * q0) := Nat.pow_le_pow_right (by norm_num) (Nat.le_mul_of_pos_left _ hK)
        _ ≤ B := Nat.le_mul_of_pos_left _ hP
    set Wk := W ^ k
    have hWk1 : 1 ≤ Wk := Nat.one_le_pow _ _ (by omega)
    set B' := Wk * ((B + Wk - 1) / Wk) with hB'def
    have hB'ge : B ≤ B' := by
      have h1 := Nat.div_add_mod (B + Wk - 1) Wk
      have h2 := Nat.mod_lt (B + Wk - 1) (by omega : 0 < Wk)
      rw [hB'def]; omega
    have hB'le : B' ≤ 2 * B := by
      have h1 := Nat.div_mul_le_self (B + Wk - 1) Wk
      rw [hB'def, mul_comm]; omega
    have hB1 : 1 ≤ B := le_trans hWk1 hWkB
    -- the low positions
    set pos' : Fin D' → ℕ := fun i => ρ + K * (D' - 1 - i) with hpos'def
    have hinj' : Function.Injective pos' := by
      intro a b e
      simp only [hpos'def] at e
      have h1 : K * (D' - 1 - a) = K * (D' - 1 - b) := by omega
      have h2 := Nat.eq_of_mul_eq_mul_left (by omega) h1
      exact Fin.ext (by have := a.isLt; have := b.isLt; omega)
    have hpos' : ∀ i, pos' i < t' := by
      intro i
      simp only [hpos'def, t']
      have := i.isLt
      have : K * (D' - 1 - i) + K ≤ K * D' := by
        rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left _ (by omega)
      omega
    have hnp : B * 2 ^ t' * S ≤ B' * 2 ^ t' * S :=
      Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hB'ge)
    have hnp2 : B' * 2 ^ t' * S ≤ 2 * n := by
      rw [hnB]
      calc B' * 2 ^ t' * S ≤ (2 * B) * 2 ^ t' * S :=
            Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hB'le)
        _ = 2 * (B * 2 ^ t' * S) := by ring
    have hZlow : NLogN.zsz ((16 * (B' * 2 ^ t' * S * r) : ℕ) : ℤ) ≤ Z := by
      refine le_trans (NLogN.KIL.zsz_nat_le ?_) hZ
      have h1 := Nat.mul_le_mul_left 16 (Nat.mul_le_mul_right r hnp2)
      have e : 32 * (n * r) = 16 * (2 * n * r) := by ring
      rw [e]; exact h1
