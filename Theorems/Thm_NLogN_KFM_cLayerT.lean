variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}

theorem stT_low {K D S ρ q0 : ℕ} (h : q0 ≤ D) (i : Fin (D - q0)) :
    KFH.stT K D S ρ (lowE h i) = 2 ^ (ρ + K * (D - q0 - 1 - i)) * S := by
  simp only [lowE, KFH.stT]
  rw [KFH.stS_eq K D S _ (by have := i.isLt; omega), ← pow_mul, pow_add]
  have : D - (q0 + i + 1) = D - q0 - 1 - i := by omega
  rw [this]; ring

end CL

