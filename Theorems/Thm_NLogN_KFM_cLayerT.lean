      refine ⟨ρ + K * (D' - 1), fun i => ?_, ?_⟩
      · simp only [hpos'def]
        have := i.isLt
        rw [add_assoc, ← Nat.mul_add]
        congr 2; omega
      · have hm : (ρ + K * (D' - 1)) % K = ρ := by
          rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hρ]
        rw [hm]
        simp only [t']
        have : K * (D' - 1) + K = K * D' := by
          rw [← Nat.mul_succ]; congr 1; omega
        omega
    obtain ⟨cl, el, dl, kl, Hl, hel, hdl, hkl⟩ := NLogN.KFN.cLow J hGc hrow hCR hτ hW hsW
      (le_trans (by norm_num) hm) hr hΨm hZΨ k D' (lt_of_le_of_lt (Nat.sub_le D q0) hk) pos' hinj' t' S B' hpos' haff' hS
      (le_trans hB1 hB'ge) (dvd_mul_right _ _) hZlow
    have hs' : NLogN.KFN.SLaws (fun i => 2 ^ pos' i * S) (B * 2 ^ t' * S) := NLogN.KFN.slaws_pow pos' hinj' t' S B hpos'
    have hZpad : NLogN.zsz ((2 * ((B' * 2 ^ t' * S - B * 2 ^ t' * S) * r) : ℕ) : ℤ) ≤ Z := by
      refine le_trans (NLogN.KIL.zsz_nat_le ?_) hZ
      have h1 : (B' * 2 ^ t' * S - B * 2 ^ t' * S) * r ≤ B' * 2 ^ t' * S * r :=
        Nat.mul_le_mul_right _ (Nat.sub_le _ _)
      have h2 := Nat.mul_le_mul_right r hnp2
      have e : 32 * (n * r) = 2 * (16 * n * r) := by ring
      rw [e]
      apply Nat.mul_le_mul_left
      calc (B' * 2 ^ t' * S - B * 2 ^ t' * S) * r ≤ 2 * n * r := h1.trans h2
