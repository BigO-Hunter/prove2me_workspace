theorem regState_congr (F : Fin HS → List ℤ) {v v' : Fin HS → ℕ} (D : List (Fin HS))
    (h : ∀ i ∈ D, v i = v' i) : regState F v D = regState F v' D := by
  funext i; by_cases hi : i ∈ D
  · simp [regState, hi, h i hi]
  · simp [regState, hi]

end NLogN.KIL

end

