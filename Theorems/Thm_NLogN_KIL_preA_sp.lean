theorem cstep_iter {b : ℕ} (hb : 1 < b) :
    ∀ N y k, Nat.clog b y ≤ N → ((cstep b)^[N] (y, k)).2 = k + Nat.clog b y
  | 0, y, k, h => by
      have : Nat.clog b y = 0 := by omega
      simp [this]
  | N + 1, y, k, h => by
      rw [Function.iterate_succ_apply]
      by_cases hy : 1 < y
      · have hc := Nat.clog_of_two_le hb hy
        simp only [cstep, if_pos hy]
        rw [cstep_iter hb N _ _ (by omega)]; omega
      · have hc : Nat.clog b y = 0 := Nat.clog_of_right_le_one (by omega) b
        have hfix : ∀ j, (cstep b)^[j] (y, k) = (y, k) := by
          intro j; induction j with
          | zero => rfl
          | succ j ih => rw [Function.iterate_succ_apply', ih]; simp [cstep, hy]
        simp only [cstep, if_neg hy]; rw [hfix]; simp [hc]

theorem cstep_iter_fst_le {b : ℕ} (hb : 1 < b) :
    ∀ N y k, ((cstep b)^[N] (y, k)).1 ≤ y ∧ ((cstep b)^[N] (y, k)).2 ≤ k + N
  | 0, y, k => by simp
  | N + 1, y, k => by
      rw [Function.iterate_succ_apply]
      by_cases hy : 1 < y
      · simp only [cstep, if_pos hy]
        obtain ⟨h1, h2⟩ := cstep_iter_fst_le hb N ((y + b - 1) / b) (k + 1)
        refine ⟨le_trans h1 ?_, by omega⟩
        apply Nat.div_le_of_le_mul
        obtain ⟨c, rfl⟩ : ∃ c, b = c + 1 := ⟨b - 1, by omega⟩
        obtain ⟨z, rfl⟩ : ∃ z, y = z + 1 := ⟨y - 1, by omega⟩
        ring_nf; have := Nat.zero_le (z * c); omega
      · simp only [cstep, if_neg hy]
        obtain ⟨h1, h2⟩ := cstep_iter_fst_le hb N y k
        exact ⟨h1, by omega⟩

theorem evalA_clogL {b : ℕ} (hb : 1 ≤ b) {Y K : Fin HS} (hYK : Y ≠ K) (v : Fin HS → ℕ) :
    evalA (clogL b Y K) v = Function.update (Function.update v K (cstep b (v Y, v K)).2) Y
      (cstep b (v Y, v K)).1 := by
  simp only [clogL, evalA, NE.val, Function.update_self, Function.update_of_ne hYK, cstep]
  by_cases h : 1 < v Y
  · simp only [h, if_true]
    rw [show v Y + (b - 1) = v Y + b - 1 by omega]
  · simp [h]

theorem iter_clogL {b : ℕ} (hb : 1 ≤ b) {Y K : Fin HS} (hYK : Y ≠ K) (v : Fin HS → ℕ) :
    ∀ N, (evalA (clogL b Y K))^[N] v = Function.update (Function.update v K
      ((cstep b)^[N] (v Y, v K)).2) Y ((cstep b)^[N] (v Y, v K)).1
  | 0 => by simp
  | N + 1 => by
      rw [Function.iterate_succ_apply', iter_clogL hb hYK v N, evalA_clogL hb hYK,
        Function.iterate_succ_apply' (cstep b)]
      simp only [Function.update_self, Function.update_of_ne (Ne.symm hYK), Prod.mk.eta]
      funext j
      simp only [Function.update_apply]
      split_ifs <;> rfl

theorem okA_clogL {F : Fin HS → List ℤ} {D : List (Fin HS)} {M b : ℕ} {Y K : Fin HS}
    (hb : 1 < b) (hYK : Y ≠ K) (hY : Y ∈ D) (hK : K ∈ D) (hY5 : Y.val < 56) (hK5 : K.val < 56)
    {v : Fin HS → ℕ} (hvY : v Y + b ≤ M) (hvK : v K + 1 ≤ M) : OKA F D M (clogL b Y K) v := by
  have hYv : Function.update v K (if 1 < v Y then v K + 1 else v K) Y = v Y :=
    Function.update_of_ne hYK _ _
  refine ⟨hK, hK5, by omega, ?_, ?_, hY, hY5, ?_, ?_, ?_, trivial⟩
  · intro j hj
    have : j = Y ∨ j = K := by simp [NE.regs] at hj; tauto
    rcases this with rfl | rfl
    · exact ⟨hY5, Or.inl hY⟩
    · exact ⟨hK5, Or.inl hK⟩
  · by_cases h : 1 < v Y
    · simp [NE.OK, NE.val, h]; omega
    · simp [NE.OK, NE.val, h]; omega
  · simp only [NE.val]; rw [Function.update_of_ne hYK]; omega
  · intro j hj
    have : j = Y := by simp [NE.regs] at hj; tauto
    subst this; exact ⟨hY5, Or.inl hY⟩
  · simp only [NE.val, NE.OK, Function.update_of_ne hYK]
    by_cases h : 1 < v Y
    · simp [h]; omega
    · simp [h]; omega

theorem regD_lt : ∀ i ∈ regD, i.val < 56 := by decide
theorem regD_nodup : regD.Nodup := by decide

theorem evalA_frame : ∀ (L : List (Fin HS × NE)) (v : Fin HS → ℕ) (i : Fin HS),
    i ∉ L.map Prod.fst → evalA L v i = v i
  | [], v, i, _ => rfl
  | (j, e) :: L, v, i, h => by
      simp only [List.map_cons, List.mem_cons, not_or] at h
      rw [evalA, evalA_frame L _ i h.2, Function.update_of_ne h.1]

/-- Bounds on the file are kept when the assigned registers are bounded. -/
theorem bound_keep {D Wl : List (Fin HS)} {M : ℕ} {v v' : Fin HS → ℕ} (hv : ∀ i ∈ D, v i ≤ M)
    (hfr : ∀ i, i ∉ Wl → v' i = v i) (hw : ∀ i ∈ Wl, v' i ≤ M) : ∀ i ∈ D, v' i ≤ M := by
  intro i hi
  by_cases h : i ∈ Wl
  · exact hw i h
  · rw [hfr i h]; exact hv i hi

