section
-- Source module: Solutions.KIL6Stage
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem regState_congr (F : Fin HS → List ℤ) {v v' : Fin HS → ℕ} (D : List (Fin HS))
    (h : ∀ i ∈ D, v i = v' i) : regState F v D = regState F v' D := by
  funext i; by_cases hi : i ∈ D
  · simp [regState, hi, h i hi]
  · simp [regState, hi]

end NLogN.KIL

end

section
-- Source module: Solutions.KIL6PreA
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem not_regD_kP : kP ∉ regD := by decide
theorem not_regD_kG : kG ∉ regD := by decide
theorem not_regD_kS : NLogN.KIL.kS ∉ regD := by decide
theorem not_regD_aU : aU ∉ regD := by decide

theorem v0_regD (P g sv u : ℕ) : ∀ i ∈ regD, v0 P g sv u i = 0 := by
  intro i hi
  have h1 : i ≠ kP := fun h => not_regD_kP (h ▸ hi)
  have h2 : i ≠ kG := fun h => not_regD_kG (h ▸ hi)
  have h3 : i ≠ kS := fun h => not_regD_kS (h ▸ hi)
  have h4 : i ≠ aU := fun h => not_regD_aU (h ▸ hi)
  simp [v0, Function.update_apply, h1, h2, h3, h4]

theorem clog_le_self {m : ℕ} (hm : 2 ≤ m) (e : ℕ) : Nat.clog m e ≤ e :=
  Nat.clog_le_of_le_pow (Nat.lt_pow_self (by omega)).le

end NLogN.KIL

end

