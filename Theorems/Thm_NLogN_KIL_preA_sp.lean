  · intro j hj
    have : j = Y ∨ j = K := by simp [NE.regs] at hj; tauto
    rcases this with rfl | rfl
    · exact ⟨hY5, Or.inl hY⟩
    · exact ⟨hK5, Or.inl hK⟩
  · by_cases h : 1 < v Y
    · simp [NE.OK, NE.val, h]; omega
    · simp [NE.OK, NE.val, h]; omega
  · simp only [NE.val]; rw [Function.update_of_ne hYK]; omega
  · intro j hj
    have : j = Y := by simp [NE.regs] at hj; tauto
    subst this; exact ⟨hY5, Or.inl hY⟩
  · simp only [NE.val, NE.OK, Function.update_of_ne hYK]
    by_cases h : 1 < v Y
    · simp [h]; omega
    · simp [h]; omega

