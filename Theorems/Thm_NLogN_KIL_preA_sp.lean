-- Source module: Solutions.KIL6PreA
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem not_regD_kP : kP ∉ regD := by decide
theorem not_regD_kG : kG ∉ regD := by decide
theorem not_regD_kS : NLogN.KIL.kS ∉ regD := by decide
theorem not_regD_aU : aU ∉ regD := by decide

theorem v0_regD (P g sv u : ℕ) : ∀ i ∈ regD, v0 P g sv u i = 0 := by
  intro i hi
  have h1 : i ≠ kP := fun h => not_regD_kP (h ▸ hi)
  have h2 : i ≠ kG := fun h => not_regD_kG (h ▸ hi)
  have h3 : i ≠ kS := fun h => not_regD_kS (h ▸ hi)
  have h4 : i ≠ aU := fun h => not_regD_aU (h ▸ hi)
  simp [v0, Function.update_apply, h1, h2, h3, h4]

theorem clog_le_self {m : ℕ} (hm : 2 ≤ m) (e : ℕ) : Nat.clog m e ≤ e :=
  Nat.clog_le_of_le_pow (Nat.lt_pow_self (by omega)).le

end NLogN.KIL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12
set_option maxHeartbeats 1000000
theorem NLogN.KIL.preA_sp (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) {M B : ℕ} (hM : NLogN.zsz (M : ℤ) ≤ B)
    {q m W u P g sv : ℕ} (hq : 2 ≤ q) (hm : 2 ≤ m)
    (FP : ∃ L, F NLogN.KIL.kP = (P : ℤ) :: L) (FG : ∃ L, F NLogN.KIL.kG = (g : ℤ) :: L)
    (FS : ∃ L, F NLogN.KIL.kS = (sv : ℤ) :: L) (FU : ∃ L, F NLogN.KIL.aU = (u : ℤ) :: L) (hg : 1 ≤ g)
    (F23 : F 23 = [])
    (hM1 : 2 ^ u + q ≤ M) (hM4 : Nat.clog q (2 ^ u) + m ≤ M) (hM6 : W * Nat.clog q (2 ^ u) ≤ M)
    (hM6' : W ≤ M) (hM7 : g * q ^ Nat.clog q (2 ^ u) ≤ M) :
    ∃ v : Fin NLogN.HS → ℕ, (∀ i ∈ NLogN.KIL.regD, v i ≤ M) ∧ v NLogN.KIL.kP = P ∧ v NLogN.KIL.kG = g ∧ v NLogN.KIL.kS = sv ∧ v NLogN.KIL.aU = u ∧
      v NLogN.KIL.aT2 = 2 ^ u ∧ v NLogN.KIL.aE = Nat.clog q (2 ^ u) ∧ v NLogN.KIL.aQE = q ^ Nat.clog q (2 ^ u) ∧
      v NLogN.KIL.aK = Nat.clog m (Nat.clog q (2 ^ u)) ∧
      v NLogN.KIL.kR = min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v NLogN.KIL.aN = Nat.clog q (2 ^ u) - min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v NLogN.KIL.aQR = q ^ min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v NLogN.KIL.aQN = q ^ (Nat.clog q (2 ^ u) -
        min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u))) ∧
      v NLogN.KIL.aGR = g * q ^ min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v NLogN.KIL.kQt = q ^ 0 ∧ v NLogN.KIL.kQr = q ^ (Nat.clog q (2 ^ u) - 0) / q ∧
      NLogN.KIL.Sp (NLogN.KIL.preA q m W) (NLogN.KIL.encK s F) (NLogN.KIL.encK s (NLogN.KIL.regState F v NLogN.KIL.regD)) (NLogN.KIL.cPreA u (Nat.clog q (2 ^ u)) B) := by
  set e := Nat.clog q (2 ^ u) with he
  set K := Nat.clog m e with hK
  obtain ⟨LP, hLP⟩ := FP
  obtain ⟨LG, hLG⟩ := FG
  obtain ⟨LS, hLS⟩ := FS
  obtain ⟨LU, hLU⟩ := FU
  have hqe1 : 1 ≤ q ^ e := Nat.one_le_pow _ _ (by omega)
  have hqeM : q ^ e ≤ M := le_trans (Nat.le_mul_of_pos_left _ hg) hM7
  have heq : e < q ^ e := Nat.lt_pow_self (by omega)
  have hu2 : u < 2 ^ u := Nat.lt_two_pow_self
  have hKe : K ≤ e := NLogN.KIL.clog_le_self hm e
  -- create the file
  have S0 := NLogN.KIL.Sp.pushZ s B NLogN.KIL.regD F NLogN.KIL.regD_lt NLogN.KIL.regD_nodup
  set w0 := NLogN.KIL.v0 P g sv u
  rw [NLogN.KIL.regState_congr F NLogN.KIL.regD (v := fun _ => 0) (v' := w0) (fun i hi => (NLogN.KIL.v0_regD P g sv u i hi).symm)]
    at S0
  have w0P : w0 NLogN.KIL.kP = P := by simp +decide [w0, NLogN.KIL.v0, Function.update_apply]
  have w0G : w0 NLogN.KIL.kG = g := by simp +decide [w0, NLogN.KIL.v0, Function.update_apply]
  have w0S : w0 NLogN.KIL.kS = sv := by simp +decide [w0, NLogN.KIL.v0, Function.update_apply]
  have w0U : w0 NLogN.KIL.aU = u := by simp +decide [w0, NLogN.KIL.v0, Function.update_apply]
  have hw0 : ∀ i ∈ NLogN.KIL.regD, w0 i ≤ M := fun i hi => by show NLogN.KIL.v0 P g sv u i ≤ M; rw [NLogN.KIL.v0_regD P g sv u i hi]; omega
  -- descriptor 1
  obtain ⟨w1, fr1, w1T, w1E, w1Y, S1⟩ := NLogN.KIL.desc1_sp s F hM hq w0 hw0 ⟨LU, hLU⟩ w0U F23 hM1 (by omega)
  have hw1 : ∀ i ∈ NLogN.KIL.regD, w1 i ≤ M := NLogN.KIL.bound_keep hw0 fr1 (by
    intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl
    · rw [w1T]; omega
    · omega
    · rw [w1E]; omega)
  -- descriptor 2
  obtain ⟨w2, fr2, w2Q, w2K, w2Y, S2⟩ := NLogN.KIL.desc2_sp s F hM hq hm w1 hw1 w1E F23 hqeM hM4
  have hw2 : ∀ i ∈ NLogN.KIL.regD, w2 i ≤ M := NLogN.KIL.bound_keep hw1 fr2 (by
    intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl
    · rw [w2Q]; exact hqeM
    · omega
    · rw [w2K]; exact le_trans hKe (by omega))
  have w2E : w2 NLogN.KIL.aE = e := by rw [fr2 NLogN.KIL.aE (by decide), w1E]
  have w2G : w2 NLogN.KIL.kG = g := by rw [fr2 NLogN.KIL.kG (by decide), fr1 NLogN.KIL.kG (by decide), w0G]
  -- descriptor 3
  obtain ⟨w3, fr3, w3R, w3N, w3QR, w3QN, w3GR, w3Qt, w3Qr, w3Y, S3⟩ :=
    NLogN.KIL.desc3_sp s F hM hq w2 hw2 w2E w2K w2Q w2G ⟨LG, hLG⟩ hg hKe F23
      (le_trans (Nat.mul_le_mul_left _ hKe) hM6) hM6' hM7 (by omega)
  set r := min (W * K) e with hr
  have hre : r ≤ e := min_le_right _ _
  have hqr : q ^ r ≤ q ^ e := Nat.pow_le_pow_right (by omega) hre
  have hqn : q ^ (e - r) ≤ q ^ e := Nat.pow_le_pow_right (by omega) (Nat.sub_le _ _)
  have hw3 : ∀ i ∈ NLogN.KIL.regD, w3 i ≤ M := NLogN.KIL.bound_keep hw2 fr3 (by
    intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rw [w3Y]; exact le_trans (Nat.mul_le_mul_left _ hKe) hM6
    · rw [w3R]; omega
    · rw [w3N]; omega
    · rw [w3QR]; omega
    · rw [w3QN]; omega
    · rw [w3GR]; exact le_trans (Nat.mul_le_mul_left _ hqr) hM7
    · rw [w3Qt]; simp; omega
    · rw [w3Qr]; exact le_trans (Nat.div_le_self _ _) (by simpa using hqeM))
  have kp : ∀ i, i ∉ [NLogN.KIL.aT2, NLogN.KIL.aY, NLogN.KIL.aE] → i ∉ [NLogN.KIL.aQE, NLogN.KIL.aY, NLogN.KIL.aK] →
      i ∉ [NLogN.KIL.aY, NLogN.KIL.kR, NLogN.KIL.aN, NLogN.KIL.aQR, NLogN.KIL.aQN, NLogN.KIL.aGR, NLogN.KIL.kQt, NLogN.KIL.kQr] → w3 i = w0 i := fun i h1 h2 h3 => by
    rw [fr3 i h3, fr2 i h2, fr1 i h1]
  refine ⟨w3, hw3, by rw [kp NLogN.KIL.kP (by decide) (by decide) (by decide), w0P],
    by rw [kp NLogN.KIL.kG (by decide) (by decide) (by decide), w0G],
    by rw [kp NLogN.KIL.kS (by decide) (by decide) (by decide), w0S],
    by rw [kp NLogN.KIL.aU (by decide) (by decide) (by decide), w0U],
    by rw [fr3 NLogN.KIL.aT2 (by decide), fr2 NLogN.KIL.aT2 (by decide), w1T],
    by rw [fr3 NLogN.KIL.aE (by decide), w2E],
    by rw [fr3 NLogN.KIL.aQE (by decide), w2Q],
    by rw [fr3 NLogN.KIL.aK (by decide), w2K],
    w3R, w3N, w3QR, w3QN, w3GR, w3Qt, w3Qr, ?_⟩
  refine (S0.seq (S1.seq (S2.seq S3))).mono ?_
  unfold NLogN.KIL.cPreA
  have hX : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
  simp only [NLogN.KIL.regD, List.length_cons, List.length_nil]
  generalize (B + 2) ^ 2 = X at hX ⊢
  have h1 : 1 ≤ X := by omega
  ring_nf
  linarith
end
