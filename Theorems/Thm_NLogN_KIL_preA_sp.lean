  have v3E : v3 NLogN.KIL.aE = e := by simp +decide [v3, v2, v1, evalA, NE.val, hvE, Function.update_apply]
  have v3Q : v3 aQE = q ^ e := by simp +decide [v3, v2, evalA, NE.val, Function.update_apply]
  have SD := Sp.repA s F regD hM (C := 23) (by decide) (by decide) hF23 (clogL m aY aK)
    (by simp +decide [clogL]) (.reg NLogN.KIL.aE) trivial v3 (fun j hj => by
      simp [NE.regs] at hj; subst hj; exact ⟨by decide, Or.inl (by decide)⟩)
    (by simp only [NE.OK]; rw [v3E]; omega)
    (by
      intro k hk
      simp only [NE.val, v3E] at hk
      rw [iter_clogL (by omega) (by decide)]
      obtain ⟨h1, h2⟩ := cstep_iter_fst_le (show 1 < m by omega) k e 0
      refine okA_clogL (by omega) (by decide) (by decide) (by decide) (by decide) (by decide) ?_ ?_
      · simp only [Function.update_self, v3Y, v3K]; omega
      · rw [Function.update_of_ne (by decide), Function.update_self]
        simp only [v3Y, v3K]; omega)
  simp only [NE.val, v3E] at SD
  rw [iter_clogL (by omega) (by decide)] at SD
  refine ⟨_, ?_, ?_, ?_, ?_, (SA.seq (SB.seq (SC.seq SD))).mono ?_⟩
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    simp [Function.update_of_ne hi.1, Function.update_of_ne hi.2.1, Function.update_of_ne hi.2.2,
      v3, v2, v1, evalA]
  · rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide), v3Q]
  · rw [Function.update_of_ne (by decide), Function.update_self, v3Y, v3K,
      cstep_iter (show 1 < m by omega) e _ _
        (Nat.clog_le_of_le_pow (Nat.lt_pow_self (by omega)).le)]
    simp
  · rw [Function.update_self]
    have := (cstep_iter_fst_le (show 1 < m by omega) e (v3 aY) (v3 aK)).1
    simp only [v3Y] at this ⊢; exact this
  · simp only [szA, NLogN.KIL.mulL, clogL, NE.size, NE.toEx, Ex.size]
    have hB1 : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    nlinarith

theorem desc3_sp (s : IState HS) (F : Fin HS → List ℤ) {M B : ℕ} (hM : zsz (M : ℤ) ≤ B)
    {q W e K g : ℕ} (hq : 2 ≤ q) (v : Fin HS → ℕ) (hv : ∀ i ∈ regD, v i ≤ M)
    (hvE : v NLogN.KIL.aE = e) (hvK : v aK = K) (hvQ : v aQE = q ^ e) (hvG : v kG = g)
    (hG : ∃ L, F kG = (g : ℤ) :: L) (hg : 1 ≤ g) (hKe : K ≤ e)
    (hF23 : F 23 = []) (hMW : W * K ≤ M) (hMW1 : W ≤ M) (hMq : g * q ^ e ≤ M) (hqM : q ≤ M) :
    ∃ v', (∀ i, i ∉ [aY, kR, aN, aQR, aQN, aGR, kQt, kQr] → v' i = v i) ∧
      v' kR = min (W * K) e ∧ v' aN = e - min (W * K) e ∧ v' aQR = q ^ min (W * K) e ∧
      v' aQN = q ^ (e - min (W * K) e) ∧ v' aGR = g * q ^ min (W * K) e ∧ v' kQt = q ^ 0 ∧
      v' kQr = q ^ (e - 0) / q ∧ v' aY = W * K ∧
      Sp (desc3 q W) (encK s (regState F v regD)) (encK s (regState F v' regD))
        (100 * (e + 1) * 10 ^ 7 * (B + 2) ^ 2) := by
  obtain ⟨LG, hLG⟩ := hG
  set r := min (W * K) e with hr
  have hr1 : (if W * K < e then W * K else e) = r := by simp only [r]; split_ifs <;> omega
  have hre : r ≤ e := min_le_right _ _
  have hqk : ∀ k ≤ e, q ^ k ≤ q ^ e := fun k hk => Nat.pow_le_pow_right (by omega) hk
  have hqe : q ^ e ≤ M := le_trans (Nat.le_mul_of_pos_left _ hg) hMq
  have hq1 : 1 ≤ q ^ e := Nat.one_le_pow _ _ (by omega)
  have heM : e ≤ M := le_trans (Nat.lt_pow_self (by omega)).le hqe
  have SA := Sp.asgs s F regD hM [(aY, .mul (.lit W) (.reg aK)),
      (kR, .lt (.reg aY) (.reg NLogN.KIL.aE) (.reg aY) (.reg NLogN.KIL.aE)),
      (aN, .sub (.reg NLogN.KIL.aE) (.reg kR)), (aQR, .lit 1)] v (by
    simp +decide [OKA, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, hvK, hvE, hvQ, hvG]
    have h1 := hv aY (by decide); have h2 := hv kR (by decide); have h3 := hv aN (by decide)
    have h4 := hv aQR (by decide)
    split_ifs <;> omega)
  set v1 := evalA [(aY, .mul (.lit W) (.reg aK)),
      (kR, .lt (.reg aY) (.reg NLogN.KIL.aE) (.reg aY) (.reg NLogN.KIL.aE)),
      (aN, .sub (.reg NLogN.KIL.aE) (.reg kR)), (aQR, .lit 1)] v with hv1
  have v1R : v1 kR = r := by
    simp +decide [v1, evalA, NE.val, Function.update_apply, hvK, hvE]; exact hr1
  have v1N : v1 aN = e - r := by
    simp +decide [v1, evalA, NE.val, Function.update_apply, hvK, hvE]; rw [hr1]
  have v1Q : v1 aQR = 1 := by simp +decide [v1, evalA, NE.val, Function.update_apply]
  have v1Y : v1 aY = W * K := by simp +decide [v1, evalA, NE.val, Function.update_apply, hvK]
  have hfr1 : ∀ i, i ∉ [aY, kR, aN, aQR] → v1 i = v i := fun i hi => evalA_frame _ _ _ (by simpa using hi)
  have SB := Sp.repA s F regD hM (C := 23) (by decide) (by decide) hF23 (NLogN.KIL.mulL aQR q)
    (by simp +decide [NLogN.KIL.mulL]) (.reg kR) trivial v1 (fun j hj => by
      simp [NE.regs] at hj; subst hj; exact ⟨by decide, Or.inl (by decide)⟩)
    (by simp only [NE.OK]; rw [v1R]; omega)
    (by
      intro k hk
      simp only [NE.val, v1R] at hk
      rw [iter_mulL, v1Q]
      have hk2 : q ^ k * q ≤ q ^ e := by rw [← pow_succ]; exact hqk _ (by omega)
      have hk3 : q ^ k ≤ q ^ e := hqk _ (by omega)
      exact okA_mulL (by decide) (by decide) hqM (by simp; omega) (by simp; omega))
  simp only [NE.val, v1R] at SB
  rw [iter_mulL, v1Q, one_mul] at SB
  set v2 := Function.update v1 aQR (q ^ r) with hv2
  have v2E : v2 NLogN.KIL.aE = e := by rw [hv2, Function.update_of_ne (by decide), hfr1 _ (by decide), hvE]
  have v2Q : v2 aQE = q ^ e := by rw [hv2, Function.update_of_ne (by decide), hfr1 _ (by decide), hvQ]
  have v2G : v2 kG = g := by rw [hv2, Function.update_of_ne (by decide), hfr1 _ (by decide), hvG]
  have v2R : v2 aQR = q ^ r := by simp [v2]
  have hqr : q ^ r ≤ q ^ e := hqk _ hre
  have hgr : g * q ^ r ≤ M := le_trans (Nat.mul_le_mul_left _ hqr) hMq
  have hqr1 : 1 ≤ q ^ r := Nat.one_le_pow _ _ (by omega)
  have hfr2 : ∀ i, i ∉ [aY, kR, aN, aQR] → v2 i = v i := fun i hi => by
    rw [hv2, Function.update_of_ne (by simp at hi; exact hi.2.2.2), hfr1 i hi]
  have hv2b : ∀ i ∈ regD, v2 i ≤ M := bound_keep hv hfr2 (by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl
    · rw [hv2, Function.update_of_ne (by decide), v1Y]; exact hMW
    · rw [hv2, Function.update_of_ne (by decide), v1R]; omega
    · rw [hv2, Function.update_of_ne (by decide), v1N]; omega
    · rw [v2R]; omega)
  have hgM : g ≤ M := le_trans (Nat.le_mul_of_pos_right _ hq1) hMq
  have SC := Sp.asgs s F regD hM [(aQN, .div (.reg aQE) (.reg aQR)), (aGR, .mul (.reg kG) (.reg aQR)),
      (kQt, .lit 1), (kQr, .div (.reg aQE) (.lit q))] v2 (by
    simp +decide [OKA, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, v2E, v2Q, v2G, v2R, hLG]
    have := hv2b aQN (by decide); have := hv2b aGR (by decide); have := hv2b kQt (by decide)
    have := hv2b kQr (by decide)
    and_intros <;> omega)
  set v3 := evalA [(aQN, .div (.reg aQE) (.reg aQR)), (aGR, .mul (.reg kG) (.reg aQR)),
      (kQt, .lit 1), (kQr, .div (.reg aQE) (.lit q))] v2 with hv3
  refine ⟨v3, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, (SA.seq (SB.seq SC)).mono ?_⟩
  · intro i hi
    rw [hv3, evalA_frame _ _ _ (by simp at hi ⊢; tauto), hfr2 i (by simp at hi ⊢; tauto)]
  · rw [hv3, evalA_frame _ _ _ (by simp +decide), hv2, Function.update_of_ne (by decide), v1R]
  · rw [hv3, evalA_frame _ _ _ (by simp +decide), hv2, Function.update_of_ne (by decide), v1N]
  · rw [hv3, evalA_frame _ _ _ (by simp +decide), v2R]
  · simp +decide [v3, evalA, NE.val, Function.update_apply, v2Q, v2R]
    exact Nat.pow_div hre (by omega)
  · simp +decide [v3, evalA, NE.val, Function.update_apply, v2G, v2R]
  · simp +decide [v3, evalA, NE.val, Function.update_apply]
  · simp +decide [v3, evalA, NE.val, Function.update_apply, v2Q]
  · rw [hv3, evalA_frame _ _ _ (by simp +decide), hv2, Function.update_of_ne (by decide), v1Y]
  · simp only [szA, NLogN.KIL.mulL, NE.size, NE.toEx, Ex.size]
    have hB1 : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    nlinarith

end NLogN.KIL

end

