theorem regState_nil (F : Fin HS → List ℤ) (v : Fin HS → ℕ) : regState F v [] = F := by
  funext j; simp [regState]

theorem Sp.pushZ (s : IState HS) (B : ℕ) :
    ∀ (D : List (Fin HS)) (F : Fin HS → List ℤ), (∀ i ∈ D, i.val < 56) → D.Nodup →
      Sp (pushZs D) (encK s F) (encK s (regState F (fun _ => 0) D)) (D.length * 4000 * (B + 2) + 1)
  | [], F, _, _ => by rw [regState_nil]; exact (Sp.skip _).mono (by simp)
  | i :: D, F, h56, hnd => by
      have h1 := Sp.push s F (i := i) (e := .lit 0) (B := B) (h56 i (by simp)) (clean_lit 0) trivial
        trivial (by simp [Ex.Bnd, zsz_zero])
      have h2 := Sp.pushZ s B D (Function.update F i ((Ex.lit (0 : ℤ)).eval (encK s F) :: F i))
        (fun j hj => h56 j (by simp [hj])) (List.nodup_cons.1 hnd).2
      refine ((h1.seq h2).congr ?_).mono ?_
      · congr 1; funext j
        simp only [regState, Function.update_apply, Ex.eval, List.mem_cons]
        by_cases hj : j = i
        · subst hj; simp [(List.nodup_cons.1 hnd).1]
        · simp [hj]
      · simp only [Ex.size, List.length_cons]; ring_nf; omega

end NLogN.KIL

