  refine sImplQ_equiv (finCongr (pow_zero mC).symm) _ Cm ?_
  have hst : ((fun i : Fin (mC ^ 0) => 2 ^ (e - K * i.val) * S0) ∘ finCongr (pow_zero mC).symm) =
