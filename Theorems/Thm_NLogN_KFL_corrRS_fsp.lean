/-- **One record of pass 1.** -/
theorem p1B_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {g : Geo} (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * g.V < 2 ^ Bb)
    (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = g.B) (hbits : ∀ m, Bnd 1 (recs m))
    (s : IState HS) (G0 : Fin HS → List ℤ) (hC : G0 rC = []) {k : ℕ} (hk : k < g.recG.V) :
    FSp (NLogN.KFL.p1B K ρ f g) (NLogN.KIL.encK s (NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 k))
      (NLogN.KIL.encK s (NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 (k + 1))) (cP1 K f g.B Bb) := by
  set κ := keyR K ρ f g
  set M := g.recG.V
  have hMV : M ≤ g.V := recG_V_le g hg
  have hBV : g.B ≤ g.V := by
    have := hg.v; rw [Geo.V_rec g] at this ⊢
    exact Nat.le_mul_of_pos_left _ (Nat.pos_of_mul_pos_right this)
  have hb4 : ((4 * g.V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  push_cast at hb4
  have zN : ∀ n : ℕ, n ≤ 2 * g.V → zsz (n : ℤ) ≤ Bb := fun n hn => zsz_of_le hb4 (by
    rw [abs_of_nonneg (by positivity)]; have : (n : ℤ) ≤ 2 * g.V := by exact_mod_cast hn
    linarith)
  set G := NLogN.KFL.P1 κ recs M G0 k with hG
  have gm : G NLogN.KFL.rm = (k : ℤ) :: G0 rm := by simp +decide [G, NLogN.KFL.P1, Function.update_apply]
  have gc : G rC = [] := by simp +decide [G, NLogN.KFL.P1, Function.update_apply, hC]
  have gK : G NLogN.KFL.rK = G0 rK := by simp +decide [G, NLogN.KFL.P1, Function.update_apply]
  have gN : G rNB = (nMv κ k : ℤ) :: G0 rNB := by simp +decide [G, NLogN.KFL.P1, Function.update_apply]
  have g0 : G 0 = recs k ++ restR recs M (k + 1) := by
    simp +decide [G, NLogN.KFL.P1, Function.update_apply]; exact restR_succ recs hk
  -- the key
  have hbig' : 4 * g.recG.V < 2 ^ Bb := by omega
  have SK := keyProg_fsp hK hρK hf hg.recG (by simpa using hQe) hB2 hbig' s G gc hk gm
  have hκ : phi g.recG (keyc K ρ f) k = κ k := rfl
  rw [hκ] at SK
  set G1 := Function.update G NLogN.KFL.rK ((κ k : ℤ) :: G NLogN.KFL.rK) with hG1
  have hκM : κ k < M := keyR_lt hg hQe hk
  -- the branch
  have SB := NLogN.KFL.brB_fsp (B := g.B) (Bb := Bb) (by omega) s G1 (recs k) (restR recs M (k + 1))
    (by simp only [G1]; rw [upd_ne (by decide)]; exact g0) (hlen k) (hbits k) (zN _ (by omega))
    (k := k) (kv := κ k) (nb := nMv κ k) (lk := G NLogN.KFL.rK) (lm := G0 NLogN.KFL.rm) (ln := G0 rNB)
    (by simp only [G1]; rw [Function.update_self])
    (zN _ (by omega)) (by simp only [G1]; rw [upd_ne (by decide)]; exact gm) (zN _ (by omega))
    (by simp only [G1]; rw [upd_ne (by decide)]; exact gN)
    (zN _ (by have := nMv_le κ k; omega))
    (by have := nMv_le κ k; exact_mod_cast zN (nMv κ k + 1) (by omega))
    (zsz_of_le hb4 (by
      rw [abs_le]; constructor
      · have : (k : ℤ) ≤ g.V := by exact_mod_cast (by omega : k ≤ g.V)
        have : (0 : ℤ) ≤ κ k := by positivity
        linarith
      · have : (κ k : ℤ) ≤ g.V := by exact_mod_cast (by omega : κ k ≤ g.V)
        have : (0 : ℤ) ≤ k := by positivity
        linarith))
  set G2 := Function.update (Function.update (Function.update (Function.update (Function.update
      (Function.update G1 0 (restR recs M (k + 1)))
      NLogN.KFL.sT ((if decide (κ k ≠ k) then [] else (recs k).reverse) ++ G1 NLogN.KFL.sT))
      sKB ((if decide (κ k ≠ k) then (recs k).reverse else []) ++ G1 sKB))
      sKK ((if decide (κ k ≠ k) then [(κ k : ℤ)] else []) ++ G1 sKK))
      sFL ((if κ k ≠ k then 1 else 0) :: G1 sFL))
      rNB (((nMv κ k + if κ k ≠ k then 1 else 0 : ℕ) : ℤ) :: G0 rNB) with hG2
  have g2K : G2 NLogN.KFL.rK = (κ k : ℤ) :: G0 rK := by
    simp only [G2]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
      upd_ne (by decide), upd_ne (by decide)]
    simp only [G1]; rw [Function.update_self, gK]
  have S3 := Sp.pop s G2 (B := Bb) (by decide) g2K (zN _ (by omega))
  set G3 := Function.update G2 NLogN.KFL.rK (G0 NLogN.KFL.rK) with hG3
  have g3m : G3 NLogN.KFL.rm = (k : ℤ) :: G0 rm := by
    simp only [G3, G2]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
      upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
    simp only [G1]; rw [upd_ne (by decide)]; exact gm
  have S4 := Sp.asg s G3 (i := NLogN.KFL.rm) (e := .add (.reg NLogN.KFL.rm) (.lit 1)) (B := Bb) (by decide) g3m
    (zN _ (by omega)) (clean_add (clean_reg (by decide)) (clean_lit _)) ⟨ok_reg g3m, trivial⟩
    ⟨trivial, trivial⟩
    ⟨bnd_reg g3m (zN _ (by omega)), by simp only [Ex.Bnd, zsz_one]; omega, by
      simp only [Ex.eval]; rw [top_encK g3m]; exact_mod_cast zN (k + 1) (by omega)⟩
  have ev4 : (Ex.add (.reg NLogN.KFL.rm) (.lit 1) : Ex HS).eval (NLogN.KIL.encK s G3) = (k : ℤ) + 1 := by
    simp only [Ex.eval]; rw [top_encK g3m]
  rw [ev4] at S4
  have H := SK.seq (SB.seq ((FSp.of_norep rfl S3).seq (FSp.of_norep rfl S4)))
  refine (H.congr ?_).mono ?_
  · congr 1
    funext j
    simp only [G3, G2, G1, G, NLogN.KFL.P1]
    by_cases a1 : j = NLogN.KFL.rm
    · subst a1; simp +decide
    by_cases a2 : j = NLogN.KFL.rK
    · subst a2; simp +decide
    by_cases a3 : j = rNB
    · subst a3; simp +decide [nMv_succ]
    by_cases a4 : j = sFL
    · subst a4; simp +decide [flL_succ, flagV]
    by_cases a5 : j = sKK
    · subst a5; simp +decide [stkK_succ, mvP]
    by_cases a6 : j = sKB
    · subst a6; simp +decide [stkF_succ, mvP]
    by_cases a7 : j = NLogN.KFL.sT
    · subst a7; simp +decide [stkF_succ, mvP]
    by_cases a8 : j = 0
    · subst a8; simp +decide
    simp [Function.update_apply, a1, a2, a3, a4, a5, a6, a7, a8]
  · clear H SK SB S3 S4
    simp only [cP1, Ex.size]
    have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
    have : (Bb + 2) ≤ (Bb + 2) ^ 2 := by nlinarith
    nlinarith

theorem P1_upd (κ : ℕ → ℕ) (recs : ℕ → List ℤ) (M : ℕ) (G0 : Fin HS → List ℤ) (k : ℕ)
    {j : Fin HS} (h0 : j ≠ 0) (h1 : j ≠ NLogN.KFL.sT) (h2 : j ≠ sKB) (h3 : j ≠ sKK) (h4 : j ≠ sFL)
    (h5 : j ≠ NLogN.KFL.rm) (h6 : j ≠ rNB) (v : List ℤ) :
    Function.update (NLogN.KFL.P1 κ recs M G0 k) j v = NLogN.KFL.P1 κ recs M (Function.update G0 j v) k := by
  funext i
  by_cases hi : i = j
  · subst hi; simp [NLogN.KFL.P1, Function.update_apply, h0, h1, h2, h3, h4, h5, h6]
  · simp only [NLogN.KFL.P1, Function.update_apply, hi, if_false]
    simp [Ne.symm h0, Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4, Ne.symm h5, Ne.symm h6]

theorem c1_notin (K ρ f : ℕ) (g : Geo) : NLogN.KFL.c1 ∉ (NLogN.KFL.p1B K ρ f g).writes := by
  simp only [NLogN.KFL.p1B, keyProg, progL, lines, lineR, t0R, segStep, segLoop, NLogN.KFL.brB, badB, goodB,
    NLogN.mvK, tgtR, othR, RS.writes, segBody]
  simp +decide

/-- **Pass 1.** -/
theorem p1_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {g : Geo} (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * g.V < 2 ^ Bb)
    (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = g.B) (hbits : ∀ m, Bnd 1 (recs m))
    (s : IState HS) (G0 : Fin HS → List ℤ) (hC : G0 rC = []) (hc1 : G0 NLogN.KFL.c1 = []) :
    FSp (p1Prog K ρ f g) (NLogN.KIL.encK s (NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 0))
      (NLogN.KIL.encK s (NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 g.recG.V))
      (cLp g.recG.V (cP1 K f g.B Bb) Bb) := by
  have hMV := recG_V_le g hg
  have hb4 : ((4 * g.V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  push_cast at hb4
  refine FSp.repLit (F := fun k => NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 k) (by decide)
    (fun k => by simp +decide [NLogN.KFL.P1, Function.update_apply, hc1]) (c1_notin K ρ f g)
    (zsz_of_le hb4 (by rw [abs_of_nonneg (by positivity)]; push_cast; omega)) ?_
  intro k hk
  rw [P1_upd _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide), P1_upd _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide)]
  exact p1B_fsp hK hρK hf hg hQe hB2 hbig recs hlen hbits s _
    (by rw [upd_ne (by decide)]; exact hC) hk

end NLogN.KFL

