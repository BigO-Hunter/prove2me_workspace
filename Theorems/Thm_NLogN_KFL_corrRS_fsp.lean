theorem corrR_keyR (m : ℕ) : corrR K ρ f g (keyR K ρ f g m) = m := by
  unfold corrR keyR
  rw [phi_phi hg.recG (TV_corrc' (g := g) hg hQe) (TV_keyc' (g := g) hg hQe)]
