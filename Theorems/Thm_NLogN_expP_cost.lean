theorem NLogN.expP_cost (n : ℕ) (x y : ℤ) (s : NLogN.IState NLogN.HS) (L5 L6 L7 : List NLogN.Item)
    (h5 : s.G 5 = .int n :: L5) (h6 : s.G 6 = .int x :: L6) (h7 : s.G 7 = .int y :: L7) :
    NLogN.expP.cost s ≤ NLogN.expCost n (NLogN.zsz x) (NLogN.zsz y) := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, gj⟩ := NLogN.exp_pre n x y s L5 L6 L7 h5 h6 h7
  obtain ⟨-, hrun⟩ := NLogN.exp_loop n x y s L5 L6 L7 h5 h6 h7
  have hinv := NLogN.exp_inv_all n x y s L5 L6 L7 h5 h6 h7
  obtain ⟨f30, f31, f32, f33, f34, f35, f36, f37, f38, -, fj⟩ := hinv (2 * n + 13) le_rfl
  have hK := NLogN.exp_K n x y s L5 L6 L7 h5 h6 h7
  have hMlt := NLogN.exp_M_lt n x y
  have f5 := fj 5 (by decide)
  rw [h5] at f5
  generalize hBdef : NLogN.expB n (NLogN.zsz x + NLogN.zsz y) = B at hMlt
  obtain ⟨W, hWeq⟩ : ∃ W : ℤ, W = |x * 2 ^ (n + 9)| + |y * 2 ^ (n + 9)| + 1 := ⟨_, rfl⟩
  obtain ⟨T, hTeq⟩ : ∃ T : ℤ, T = 2 ^ (2 * n + 9) * W ^ (2 * n + 13) := ⟨_, rfl⟩
  obtain ⟨M, hMeq⟩ : ∃ M : ℤ, M = ((2 * n + 13 : ℕ) + 1 : ℤ) * T := ⟨_, rfl⟩
  have hMB : M < 2 ^ B := by rw [hMeq, hTeq, hWeq]; exact hMlt
  have hMbody : ((2 * n + 13 : ℕ) + 1 : ℤ) * (2 ^ (2 * n + 9) *
      (|x * 2 ^ (n + 9)| + |y * 2 ^ (n + 9)| + 1) ^ (2 * n + 13)) ≤ M := by
    rw [hMeq, hTeq, hWeq]
  have big : ∀ z : ℤ, |z| ≤ M → NLogN.zsz z ≤ B := fun z hz => NLogN.zsz_le_of_abs (by linarith)
  generalize hXdef : x * 2 ^ (n + 9) = X at *
  generalize hYdef : y * 2 ^ (n + 9) = Y at *
  have hXW : |X| + |Y| ≤ W := by rw [hWeq]; linarith
  have hW1 : (1 : ℤ) ≤ W := by rw [hWeq]; linarith [abs_nonneg X, abs_nonneg Y]
  obtain ⟨a1, a2⟩ := NLogN.expTerm_abs_le (2 * n + 9) X Y W hXW (2 * n + 13)
  obtain ⟨c1, c2⟩ := NLogN.expApprox_abs_le (2 * n + 9) X Y W hXW hW1 (2 * n + 13)
  have hWW : W ≤ W ^ (2 * n + 13) := by
    calc W = W ^ 1 := (pow_one W).symm
      _ ≤ _ := pow_le_pow_right₀ hW1 (by omega)
  have hN1 : (1 : ℤ) ≤ 2 ^ (2 * n + 9) := one_le_pow₀ (by norm_num)
  have hWK1 : (1 : ℤ) ≤ W ^ (2 * n + 13) := one_le_pow₀ hW1
  have h89 : (2 : ℤ) ^ (n + 9) ≤ 2 ^ (2 * n + 9) := pow_le_pow_right₀ (by norm_num) (by omega)
  have h88 : (2 : ℤ) ^ (n + 8) ≤ 2 ^ (2 * n + 9) := pow_le_pow_right₀ (by norm_num) (by omega)
  rw [← hTeq] at a1 a2 c1 c2
  have hT1 : 1 ≤ T := by rw [hTeq]; nlinarith
  have hTW : W ≤ T := by rw [hTeq]; nlinarith
  have hTP : (2 : ℤ) ^ (2 * n + 9) ≤ T := by rw [hTeq]; nlinarith
  push_cast at hMeq c1 c2
  have hTM : T ≤ M := by rw [hMeq]; nlinarith
  have hKT : (2 * (n : ℤ) + 13) * T ≤ M := by rw [hMeq]; nlinarith
  have hXW' : |X| ≤ W := by rw [hWeq]; linarith [abs_nonneg Y]
  have hYW' : |Y| ≤ W := by rw [hWeq]; linarith [abs_nonneg X]
  have hnM : 2 * (n : ℤ) + 13 ≤ M := by nlinarith
  have hX : |X| ≤ M := by linarith
  have hY : |Y| ≤ M := by linarith
  have hxX : |x| ≤ |X| := by
    rw [← hXdef, abs_mul, abs_of_pos (show (0 : ℤ) < 2 ^ (n + 9) by positivity)]
    exact le_mul_of_one_le_right (abs_nonneg x) (one_le_pow₀ (by norm_num))
  have hyY : |y| ≤ |Y| := by
    rw [← hYdef, abs_mul, abs_of_pos (show (0 : ℤ) < 2 ^ (n + 9) by positivity)]
    exact le_mul_of_one_le_right (abs_nonneg y) (one_le_pow₀ (by norm_num))
  have hnB : 2 * n + 20 ≤ B := by rw [← hBdef, NLogN.expB]; nlinarith
  -- the three phases
  have cpre := NLogN.exp_pre_cost n x y s L5 L6 L7 h5 h6 h7 M B big hnB (by linarith) (by linarith)
    (by rw [hXdef]; exact hX) (by rw [hYdef]; exact hY) (by linarith) (by linarith) (by linarith)
  have crep := NLogN.RS.rep_cost_le 39 NLogN.eKE NLogN.expBody (NLogN.expPre.run s) B (1000 * 10 ^ 7 * (B + 4) ^ 2)
    (by
      simp (config := {decide := true}) only [NLogN.eKE, NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top,
        gj 5 (by decide), h5]
      repeat' apply And.intro
      all_goals apply big; rw [abs_of_nonneg (by positivity)]; linarith)
    (fun k hk => by
      rw [hK, Int.toNat_natCast] at hk
      exact NLogN.exp_body_cost (2 * n + 9) (2 * n + 13) X Y s _ k (hinv k hk.le) hk M B
        hMbody big)
  rw [hK, Int.toNat_natCast] at crep
  have u5 : ((NLogN.RS.repSt 39 NLogN.eKE NLogN.expBody (NLogN.expPre.run s) (2 * n + 13)).upd 39 (s.G 39)).G 5 =
      .int n :: L5 := by simp (config := {decide := true}) [NLogN.IState.upd_G, f5]
  have cpost := NLogN.exp_post_cost n ((NLogN.RS.repSt 39 NLogN.eKE NLogN.expBody (NLogN.expPre.run s) (2 * n + 13)).upd 39 (s.G 39))
    L5 u5 X Y (2 ^ (2 * n + 9)) ((2 * n + 13 : ℕ) : ℤ) (expTerm (2 * n + 9) X Y (2 * n + 13)).1
    (expTerm (2 * n + 9) X Y (2 * n + 13)).2 (expApprox (2 * n + 9) (2 * n + 13) X Y).1
    (expApprox (2 * n + 9) (2 * n + 13) X Y).2 (expTerm (2 * n + 9) X Y (2 * n + 13)).1
    (s.G 30) (s.G 31) (s.G 32) (s.G 33) (s.G 34) (s.G 35) (s.G 36) (s.G 37) (s.G 38)
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f30])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f31])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f32])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f33])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f34])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f35])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f36])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f37])
    (by simp (config := {decide := true}) [NLogN.IState.upd_G, f38])
    M B big (by omega) hX hY (by rw [abs_of_pos (by positivity)]; linarith)
    (by push_cast; rw [abs_of_nonneg (by positivity)]; linarith)
    (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)
    (by
      refine le_trans (abs_add_le _ _) ?_
      rw [abs_of_pos (show (0 : ℤ) < 2 ^ (n + 8) by positivity)]; linarith)
    (by
      refine le_trans (abs_add_le _ _) ?_
      rw [abs_of_pos (show (0 : ℤ) < 2 ^ (n + 8) by positivity)]; linarith)
    (by linarith) (by linarith)
  have e : NLogN.expP.cost s = NLogN.expPre.cost s + ((NLogN.RS.rep 39 NLogN.eKE NLogN.expBody).cost (NLogN.expPre.run s) +
      NLogN.expPost.cost ((NLogN.RS.rep 39 NLogN.eKE NLogN.expBody).run (NLogN.expPre.run s))) := rfl
  rw [e, hrun]
  rw [show NLogN.eKE.size = 5 from rfl] at crep
  -- arithmetic
  set S := n + NLogN.zsz x + NLogN.zsz y + 20 with hS
  have hB4 : B + 4 ≤ 3 * S ^ 2 := by
    have h1 : (2 * n + 13) * (NLogN.zsz x + NLogN.zsz y + n + 11) ≤ (2 * S) * S :=
      Nat.mul_le_mul (by omega) (by omega)
    have h2 : 2 * S ≤ S * S := Nat.mul_le_mul_right S (by omega)
    rw [← hBdef, NLogN.expB]
    have h3 : S ^ 2 = S * S := by ring
    rw [h3]
    have h4 : 2 * S * S = 2 * (S * S) := by ring
    omega
  have hZ : (B + 4) ^ 2 ≤ 9 * S ^ 4 := by
    calc (B + 4) ^ 2 ≤ (3 * S ^ 2) ^ 2 := Nat.pow_le_pow_left hB4 2
      _ = 9 * S ^ 4 := by ring
  have hZ2 : (B + 2) ^ 2 ≤ (B + 4) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have hS1 : 1 ≤ S := by omega
  have hKS : 2 * n + 13 ≤ 2 * S := by omega
  generalize (B + 4) ^ 2 = Z at *
  have hKZ : (2 * n + 13) * Z ≤ 18 * S ^ 5 := by
    calc (2 * n + 13) * Z ≤ (2 * S) * (9 * S ^ 4) := Nat.mul_le_mul hKS hZ
      _ = 18 * S ^ 5 := by ring
  have hS45 : S ^ 4 ≤ S ^ 5 := Nat.pow_le_pow_right hS1 (by omega)
  have hS15 : S ≤ S ^ 5 := by
    calc S = S ^ 1 := (pow_one S).symm
      _ ≤ S ^ 5 := Nat.pow_le_pow_right hS1 (by omega)
  simp only [NLogN.expCost, ← hS]
  linarith
