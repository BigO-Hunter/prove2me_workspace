theorem rep_cost_le (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (B C : ℕ)
    (hn : n.Bnd s B)
    (hb : ∀ k < (n.eval s).toNat, b.cost (NLogN.RS.repSt i n b s k) +
      asgCost i (decE i) (b.run (NLogN.RS.repSt i n b s k)) ≤ C) :
    (NLogN.RS.rep i n b).cost s ≤ (n.size + 1) * 10 ^ 7 * (B + 2) ^ 2 + (n.eval s).toNat * (C + 30) + 32 := by
  have h1 := pushCost_le n s B hn
  have h2 : ∑ k ∈ Finset.range (n.eval s).toNat, (b.cost (NLogN.RS.repSt i n b s k) +
      asgCost i (decE i) (b.run (NLogN.RS.repSt i n b s k)) + 30) ≤ (n.eval s).toNat * (C + 30) := by
    have := Finset.sum_le_sum (s := Finset.range (n.eval s).toNat)
      (f := fun k => b.cost (NLogN.RS.repSt i n b s k) + asgCost i (decE i) (b.run (NLogN.RS.repSt i n b s k)) + 30)
      (g := fun _ => C + 30) (fun k hk => by have := hb k (Finset.mem_range.1 hk); omega)
    simpa using this
  simp only [NLogN.RS.cost]; omega

end RS

end NLogN

end

