  have m0 : |(0 : ℤ)| ≤ M := by rw [abs_zero]; linarith [abs_nonneg x]
  have mn : |(n : ℤ)| ≤ M := by rw [abs_of_nonneg (by positivity)]; linarith
  have mn9 : |(n : ℤ) + 9| ≤ M := by rw [abs_of_nonneg (by positivity)]; linarith
  have mnn : |(n : ℤ) + n| ≤ M := by rw [abs_of_nonneg (by positivity)]; linarith
  have mnn9 : |(n : ℤ) + n + 9| ≤ M := by rw [abs_of_nonneg (by positivity)]; linarith
  have m9 : |(9 : ℤ)| ≤ M := by rw [abs_of_nonneg (by positivity)]; linarith
  have mP : |(2 : ℤ) ^ (2 * n + 9)| ≤ M := by rw [abs_of_nonneg (by positivity)]; linarith
  have mP9 : |(2 : ℤ) ^ (n + 9)| ≤ M := by rw [abs_of_nonneg (by positivity)]; linarith
  simp only [expPre, NLogN.RS.seqL, RS.cost, NLogN.RS.run_seq]
