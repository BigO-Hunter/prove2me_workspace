section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12 AModelFac AModelRat Finset
variable {m : ℕ}
theorem NLogN.KIL.tok_edgeTpl {R : Type*} [CommRing R] {W : ℕ} (Qc : AModelRat.QCircuit R m W) (X : AModel.IMat m)
    {q e Bb : ℕ} (hq : q.Prime) (he : 1 ≤ e)
    (hg : AModelRat.GoodAtQ q ((Qc.den : ℚ)⁻¹ • AModelFac.ratM X)) (hlt : NLogN.KIL.tokBnd ((Qc.den : ℚ)⁻¹ • AModelFac.ratM X) < q)
    (hBb : NLogN.zsz ((NLogN.KIL.tokBnd ((Qc.den : ℚ)⁻¹ • AModelFac.ratM X) * (q ^ e + 1) ^ 2 : ℕ) : ℤ) ≤ Bb) :
    ∀ T, NLogN.KIL.TStep.sh T ∈ NLogN.KIL.edgeTplQ Qc X → NLogN.KIL.TOK T (q ^ e) Bb := by
  set A := (Qc.den : ℚ)⁻¹ • AModelFac.ratM X with hA
  intro T hT
  simp only [NLogN.KIL.edgeTplQ, List.mem_map] at hT
  obtain ⟨s, hs, hsT⟩ := hT
  obtain ⟨-, hd1, hd2, hn1, hn2⟩ := hg
  obtain ⟨-, hz1, -, hz2, -⟩ := AModelRat.ratFacQ_spec A
  have g1 : NLogN.KIL.FGood (q ^ e) (AModelRat.ratFacQ A).1 := NLogN.KIL.fgood_of (dvd_refl _) hd1 hz1 hn1
  have g2 : NLogN.KIL.FGood (q ^ e) (AModelRat.ratFacQ A).2.2 := NLogN.KIL.fgood_of (dvd_refl _) hd2 hz2 hn2
  have hgood := NLogN.KIL.shearQ_good (AModelRat.piQ A) g1 g2 s hs
  have hle : NLogN.KIL.qsB s ≤ NLogN.KIL.tokBnd A := List.le_sum_of_mem (List.mem_map_of_mem hs)
  exact NLogN.KIL.tok_of_good hq he s hgood (by omega)
    (le_trans (NLogN.KIL.zsz_nat_le (Nat.mul_le_mul_right _ hle)) hBb) T hsT
end
