/-! ## Header refinement -/

theorem HRef.writes {p p' : RS} {X : ℕ} (h : HRef p p' X) : p'.writes = p.writes := by
  induction h with
  | refl => rfl
  | seq _ _ ha hb => simp [RS.writes, ha, hb]
  | ite _ _ ha hb => simp [RS.writes, ha, hb]
  | push => rfl
  | mono _ _ ih => exact ih

