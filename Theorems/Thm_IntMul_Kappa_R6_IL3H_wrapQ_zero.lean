        (encK s (Function.update f 0 (gflat zs1 ++ l)))
        (encK s (Function.update f 0 (gflat zs1 ++ l))) 1 := IRuns.skip _
    rw [Function.update_idem] at H3 H4
    have HG : HRef (gateP (levA 2 0) e2 L) (RS.sub σ (levG 2 ρ ρE)) (2 * Xp Z) := by
