-- Derived field restored by repair: midPre_sol_aux consumes `h.VbH_mid`; the bound
-- itself lives in the imported VbH_mid module as `VbH_mid_sol_aux`.
def VbH_mid (hc : CfgOK c) {ρ : ℕ} (hρ : ρ < K) :=
  h.VbH_mid_sol_aux hc hρ

/-- **The middle-part preconditions.** -/
theorem midPre_sol_aux (hc : CfgOK c) {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
    {jL : Fin Pp} {rowC : IStmt HS Pp} {CB : ℕ → ℝ} {ρ : ℕ} (hρ : ρ < K)
    (LV : ∀ E, LvH c Isym tbl jL rowC K r (Zl c P K D S r w) (3 * Z) (w + EwH c D)
      (Gv czH (Zl c P K D S r w)) CB E)
    (hlt : (chV c (cWc c) P K D S r w).q0 + (chV c (cWc c) P K D S r w).qB < D) :
    MidPre c Isym tbl jL rowC CB K S r (chV c (cWc c) P K D S r w).H P D ρ
      (chV c (cWc c) P K D S r w).q0 (chV c (cWc c) P K D S r w).Bp
      (chV c (cWc c) P K D S r w).qB (chV c (cWc c) P K D S r w).Zl Z (3 * Z)
      (chV c (cWc c) P K D S r w).G := by
  have hm := hc.m1
  obtain ⟨hB1, hB2, hBd⟩ := h.Bp_bounds hc
  have hV := h.VbH_mid hc hρ
  have hK1 : 1 ≤ K := by have := h.K6; omega
  have hqB : (chV c (cWc c) P K D S r w).qB =
      qBv c.m K D (Gv czH (Zl c P K D S r w)) (chV c (cWc c) P K D S r w).q0 := rfl
  have hG := chV_G c (cWc c) P K D S r w
  refine ⟨LV _, hB1, hB2, ?_, ?_, ?_, hV⟩
  · -- divisibility
    refine dvd_trans ?_ hBd
    unfold WkV
    rw [hG]
    apply mul_dvd_mul
    · exact pow_dvd_pow _ (dep_mono hm (by omega))
    · apply pow_dvd_pow
      apply Nat.mul_le_mul_left
      apply Nat.mul_le_mul_right
      exact le_trans (Nat.sub_le _ _) (Nat.div_le_div_right (by omega))
  · -- the bottom chunk covers the shift
    rw [hG]
    set G := Gv czH (Zl c P K D S r w) with hGd
    set q0 := (chV c (cWc c) P K D S r w).q0 with hq0
    set qB := (chV c (cWc c) P K D S r w).qB with hqBd
    have hmin : qB = (D / c.m * G + K - 1) / K := by
      rw [hqB]; unfold qBv
      rcases min_cases (D - q0) ((D / c.m * G + K - 1) / K) with ⟨e, -⟩ | ⟨e, -⟩
      · rw [e]; rw [hqB] at hlt; unfold qBv at hlt; omega
      · exact e
    have a := le_mul_ceil (x := D / c.m * G) hK1
    rw [← hmin] at a
    have b : ((D - q0 - qB) / c.m - 1) * G ≤ D / c.m * G := by
      apply Nat.mul_le_mul_right
      exact le_trans (Nat.sub_le _ _) (Nat.div_le_div_right (by omega))
    exact le_trans b a
  · -- the guard covers the leftover node term
    rw [chV_H]
    have := h.GE_le hc (E := D - (chV c (cWc c) P K D S r w).q0 - (chV c (cWc c) P K D S r w).qB)
      (by omega)
    have : c.G D ≤ EwH c D := by
      unfold EwH
      have : D + c.G D ≤ (c.Wr + 4) * (D + c.G D) := Nat.le_mul_of_pos_left _ (by omega)
      omega
    omega

end Hyp14

