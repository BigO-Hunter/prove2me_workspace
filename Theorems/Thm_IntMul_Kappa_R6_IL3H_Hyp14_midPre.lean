namespace IntMul.Kappa.R6.IL3H

open Matrix Finset Complex Butterfly P8Lift IntMul.Kappa.R6.Cx

/-! ## Role transport -/

/-! ## The item-language network -/

/-! ## The closed-form scale bound -/

section Scale

theorem le_Ap {A p x : ℕ} (hA : 1 ≤ A) (hp : 1 ≤ p) : x ≤ A * ((x + 1) ^ p - 1) := by
  have h1 : x + 1 ≤ (x + 1) ^ p := Nat.le_self_pow (by omega) _
  have h2 : (x + 1) ^ p - 1 ≤ A * ((x + 1) ^ p - 1) := Nat.le_mul_of_pos_left _ hA
  omega

theorem Gs_lt {A p m x : ℕ} (h : x < 2 * m) : Gs A p m x = x := by simp [Gs, h]

end Scale

/-! ## The depth -/

section Dep

theorem dep_mono {m : ℕ} (hm : 1 ≤ m) : ∀ {x y : ℕ}, x ≤ y → dep m x ≤ dep m y := by
  intro x y hxy
  induction y using Nat.strong_induction_on generalizing x with
  | _ y ih =>
    by_cases hx : 2 * m ≤ x
    · have hy : 2 * m ≤ y := le_trans hx hxy
      rw [dep_ge hm hx, dep_ge hm hy]
      have hc : (m - 1) * (y / m) < y := by
        have h1 : (m - 1) * (y / m) + y / m = m * (y / m) := by
          rw [← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel hm, mul_comm]
        have h2 : m * (y / m) ≤ y := Nat.mul_div_le y m
        have h3 : 1 ≤ y / m := by rw [Nat.le_div_iff_mul_le (by omega)]; linarith
        omega
      have := ih _ hc (Nat.mul_le_mul_left _ (Nat.div_le_div_right hxy))
      omega
    · rw [dep_lt (by omega)]; exact Nat.zero_le _

end Dep

end IntMul.Kappa.R6.IL3H

