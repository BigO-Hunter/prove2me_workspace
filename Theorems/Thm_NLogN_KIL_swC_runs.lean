        · exact NLogN.KIL.powE_regs _ a (NLogN.KIL.rd_reg rdQ) r h) (le_of_eq eA) (hle _ lA)
  have gB : NLogN.KIL.GoodE t0 Bb (.mul (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (m - 1 - a)) (.mul (.reg NLogN.KIL.rVB) (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (b - m)))) :=
    NLogN.KIL.goodE_pos ⟨NLogN.KIL.powE_pos pQ _, NLogN.KIL.posE_reg hVB' (by exact_mod_cast hB1), NLogN.KIL.powE_pos pQ _⟩
      (fun r hr => by
        simp only [NLogN.Ex.regs, List.mem_append] at hr
        rcases hr with h | h | h
        · exact NLogN.KIL.powE_regs _ _ (NLogN.KIL.rd_reg rdQ) r h
        · simp at h; rw [h]; exact NLogN.KIL.rd_reg' ⟨by decide, by decide⟩
        · exact NLogN.KIL.powE_regs _ _ (NLogN.KIL.rd_reg rdQ) r h) (le_of_eq eB) (hle _ lB)
  have gC : NLogN.KIL.GoodE t0 Bb (.mul (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (m + m - 1 - b)) (.reg NLogN.KIL.rVC)) :=
    NLogN.KIL.goodE_pos ⟨NLogN.KIL.powE_pos pQ _, NLogN.KIL.posE_reg hVC' (by exact_mod_cast hC1)⟩
      (fun r hr => by
        simp only [NLogN.Ex.regs, List.mem_append] at hr
        rcases hr with h | h
        · exact NLogN.KIL.powE_regs _ _ (NLogN.KIL.rd_reg rdQ) r h
        · simp at h; rw [h]; exact NLogN.KIL.rd_reg' ⟨by decide, by decide⟩) (le_of_eq eC) (hle _ lC)
  have hgood : ∀ p ∈ NLogN.KIL.chL m a b, NLogN.KIL.GoodE t0 Bb p.2 := by
    intro p hp
    simp only [NLogN.KIL.chL, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl <;> assumption
  have hPO : NLogN.KIL.PushOK t0 Bb (NLogN.KIL.chL m a b) := by
    intro p hp
    have gp := hgood p hp
    refine ⟨?_, NLogN.KIL.clean_of_rd gp.rd, ?_, gp.ok, gp.bnd⟩
    · simp only [NLogN.KIL.chL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide)
    · intro r hr hm
      have hr' := NLogN.KIL.regs_chL p hp r hr
      simp only [NLogN.KIL.chL, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil,
        or_false] at hm
      rcases hr' with h | h | h | h | h | h <;> subst h <;>
        rcases hm with h | h | h | h | h <;> exact absurd h (by decide)
  have S1 := NLogN.KIL.Sp.pushes Bb (NLogN.KIL.chL m a b) t0 hPO
  set t1 := NLogN.KIL.pushSt t0 ((NLogN.KIL.chL m a b).map fun p => (p.1, p.2.eval t0))
  -- the evaluated push list
  have eJ : (NLogN.Ex.reg NLogN.KIL.rJ1 : NLogN.Ex NLogN.HS).eval t0 = (k : ℤ) := NLogN.KIL.eval_reg' hJ1'
  have eL : (NLogN.Ex.reg NLogN.KIL.rLp : NLogN.Ex NLogN.HS).eval t0 = (L' : ℤ) := NLogN.KIL.eval_reg' hLp'
  have hev : (NLogN.KIL.chL m a b).map (fun p => (p.1, p.2.eval t0)) =
      [(NLogN.KIL.dJ, (k : ℤ)), (NLogN.KIL.dL, (L' : ℤ)), (NLogN.KIL.dA, ((AModel.vol A * N ^ a : ℕ) : ℤ)),
        (NLogN.KIL.dB, ((N ^ (m - 1 - a) * (AModel.vol B * N ^ (b - m)) : ℕ) : ℤ)),
        (NLogN.KIL.dC, ((N ^ (m + m - 1 - b) * AModel.vol Cs : ℕ) : ℤ))] := by
    simp only [NLogN.KIL.chL, List.map_cons, List.map_nil, eJ, eL, eA, eB, eC]
  -- the descriptor of the child
  have hD : NLogN.KIL.DescIn t1 q m k P L' (A ++ List.replicate a N)
      (List.replicate (m - 1 - a) N ++ (B ++ List.replicate (b - m) N))
      (List.replicate (m + m - 1 - b) N ++ Cs) := by
    simp only [t1, hev, NLogN.KIL.pushSt]
    refine ⟨⟨t0.G NLogN.KIL.dJ, by simp +decide [NLogN.IState.upd_G]⟩, ⟨L7, ?_⟩,
      ⟨t0.G NLogN.KIL.dL, by simp +decide [NLogN.IState.upd_G]⟩,
      ⟨t0.G NLogN.KIL.dA, ?_⟩, ⟨t0.G NLogN.KIL.dB, ?_⟩, ⟨t0.G NLogN.KIL.dC, ?_⟩, ⟨L8, ?_⟩⟩
    · simp +decide [NLogN.IState.upd_G, t0, hP]
    · simp +decide [NLogN.IState.upd_G, AModel.vol_append, AModel.vol_replicate]
    · simp +decide [NLogN.IState.upd_G, AModel.vol_append, AModel.vol_replicate]
    · simp +decide [NLogN.IState.upd_G, AModel.vol_append, AModel.vol_replicate]
    · simp +decide [NLogN.IState.upd_G, t0, hT]
  set evl : List (Fin NLogN.HS × ℤ) := [(NLogN.KIL.dJ, (k : ℤ)), (NLogN.KIL.dL, (L' : ℤ)), (NLogN.KIL.dA, ((AModel.vol A * N ^ a : ℕ) : ℤ)),
        (NLogN.KIL.dB, ((N ^ (m - 1 - a) * (AModel.vol B * N ^ (b - m)) : ℕ) : ℤ)),
        (NLogN.KIL.dC, ((N ^ (m + m - 1 - b) * AModel.vol Cs : ℕ) : ℤ))] with hevl
  have ht1 : t1 = NLogN.KIL.pushSt t0 evl := by simp only [t1, hev, evl]
  have h0n : (0 : Fin NLogN.HS) ∉ evl.map Prod.fst := by simp +decide [evl]
  have h0t1 : t1.G 0 = NLogN.ints (NLogN.KIL.enc2 ys) ++ R := by
    rw [ht1, NLogN.KIL.pushSt_G_of_not_mem _ _ _ h0n]; simp [t0]
  have h2 := hrec t1 R ys hD hys
  rw [show t1.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R) = t1 by rw [← h0t1, NLogN.IState.upd_self]] at h2
  have e2 : t1.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R) =
      NLogN.KIL.pushSt (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R)) evl := by
    rw [ht1, show t0 = t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R) from rfl, NLogN.KIL.pushSt_upd_comm _ _ _ _ h0n,
      NLogN.KIL.pushSt_upd_comm _ _ _ _ h0n, NLogN.IState.upd_upd_same]
  rw [e2] at h2
  have S3 := NLogN.KIL.Sp.popsR Bb evl (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R)) (by
    intro p hp
    simp only [evl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl
    · exact ⟨by dsimp only; decide, hk⟩
    · exact ⟨by dsimp only; decide, hle _ lL⟩
    · exact ⟨by dsimp only; decide, hle _ lA⟩
    · exact ⟨by dsimp only; decide, hle _ lB⟩
    · exact ⟨by dsimp only; decide, hle _ lC⟩)
  have hfst : evl.map Prod.fst = [NLogN.KIL.dJ, NLogN.KIL.dL, NLogN.KIL.dA, NLogN.KIL.dB, NLogN.KIL.dC] := rfl
  rw [hfst] at S3
  rw [ht1] at S1
  rw [← ht1] at S1
  have H := S1.toIRuns (I := I) (iprog := iprog) |>.seq ((NLogN.IRuns.call h2).seq S3.toIRuns)
  refine H.mono' rfl ?_
  simp only [NLogN.KIL.cSwC, hevl, List.length_cons, List.length_nil]
  omega
end
