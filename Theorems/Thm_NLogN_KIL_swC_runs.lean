theorem rd_reg' {r : Fin HS} (h : 38 ≤ r.val ∧ r.val < 56) : RdOK r := Or.inr h

theorem posE_reg {t : IState HS} {r : Fin HS} {v : ℤ} {L : List Item} (h : t.G r = .int v :: L)
    (hv : 1 ≤ v) : PosE t (.reg r) := ⟨IState.isInt_of h, by rw [IState.top_eq h]; exact hv⟩

theorem powE_sQQ_regs (n : ℕ) : ∀ r ∈ (powE (.reg sQQ) n : Ex HS).regs, r = sQQ := by
  intro r hr
  obtain ⟨e', he', hr'⟩ := prodE_regs _ r hr
  rw [List.eq_of_mem_replicate he'] at hr'
  simpa [Ex.regs] using hr'

theorem regs_chL {m a b : ℕ} : ∀ p ∈ NLogN.KIL.chL m a b, ∀ r ∈ p.2.regs,
    r = rJ1 ∨ r = rLp ∨ r = rVA ∨ r = sQQ ∨ r = rVB ∨ r = rVC := by
  intro p hp r hr
  simp only [NLogN.KIL.chL, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl <;> simp only [Ex.regs, List.mem_append,
    List.mem_cons, List.not_mem_nil, or_false] at hr
  · simp [hr]
  · simp [hr]
  · rcases hr with h | h
    · simp [h]
    · simp [powE_sQQ_regs _ r h]
  · rcases hr with h | h | h
    · simp [powE_sQQ_regs _ r h]
    · simp [h]
    · simp [powE_sQQ_regs _ r h]
  · rcases hr with h | h
    · simp [powE_sQQ_regs _ r h]
    · simp [h]

end Call

end NLogN.KIL

