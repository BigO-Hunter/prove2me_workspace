section IRepF

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **Counted loop with an item-language body and iteration-dependent costs.** -/
theorem IRuns.irepF {C : Fin HS} {n : Ex HS} {body : IStmt HS Pp} {s : IState HS}
    {F : ℕ → Fin HS → List ℤ} {N B : ℕ} (c : ℕ → ℕ) (hB1 : 1 ≤ B) (hC5 : C.val < 56)
    (hC : ∀ k, F k C = [])
    (hnc : n.Clean) (hno : n.ok (encK s (F 0))) (hnl : n.Lin) (hnb : n.Bnd (encK s (F 0)) B)
    (hn : n.eval (encK s (F 0)) = N)
    (hb : ∀ k < N, IRuns I iprog body (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (c k)) :
    IRuns I iprog (NLogN.KIL.irep C n body) (encK s (F 0)) (encK s (F N))
      ((n.size + 1) * 2000 * (B + 2) + ∑ k ∈ Finset.range N, (c k + 8000 * (B + 2) + 30) +
        (2 * B + 32)) := by
  have hzN : zsz (N : ℤ) ≤ B := by rw [← hn]; exact Ex.zsz_eval_le _ B n hnb
  have hz : ∀ k ≤ N, zsz ((N : ℤ) - k) ≤ B := fun k hk => by
    have : ((N : ℤ) - k) = ((N - k : ℕ) : ℤ) := by push_cast [Nat.cast_sub hk]; ring
    rw [this]; exact le_trans (NLogN.KIL.zsz_nat_le (Nat.sub_le _ _)) hzN
  have S1 := Sp.push s (F 0) (i := C) (e := n) (B := B) hC5 hnc hno hnl hnb
  rw [hn, hC 0] at S1
  set ss : ℕ → IState HS := fun k => encK s (Function.update (F k) C [(N : ℤ) - k])
  have hss0 : encK s (Function.update (F 0) C [(N : ℤ)]) = ss 0 := by simp [ss]
  rw [hss0] at S1
  have hcl : ∀ k, (ss k).cl C = if (N : ℤ) - k = 0 then Cls.zero else
      if (N : ℤ) - k < 0 then Cls.neg else Cls.pos := fun k =>
    cl_int (ss k) C _ (s.G C) (by simp [ss, ints])
  have hstep : ∀ k < N, IRuns I iprog (.seq body (RS.asg C (decE C)).code) (ss k) (ss (k + 1))
      (c k + (decE C).size.succ * 2000 * (B + 2)) := by
    intro k hk
    have h1 := hb k hk
    have htop : (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])).top C = (N : ℤ) - k :=
      top_encK (l := []) (by simp)
    have h2 := Sp.asg s (Function.update (F (k + 1)) C [(N : ℤ) - k]) (i := C) (e := decE C)
      (a := (N : ℤ) - k) (l := []) (B := B) hC5 (by simp) (hz k hk.le)
      (by intro j hj; simp only [decE, Ex.regs, List.append_nil] at hj; exact clean_of_lt hC5 j hj)
      (by simp only [decE, Ex.ok, and_true]; exact ok_reg (a := (N : ℤ) - k) (l := []) (by simp))
      ⟨trivial, trivial⟩
      (by
        simp only [decE, Ex.Bnd, Ex.eval, htop]
        refine ⟨hz k hk.le, by rw [zsz_neg_one']; exact hB1, ?_⟩
        have : (N : ℤ) - k + -1 = (N : ℤ) - (k + 1 : ℕ) := by push_cast; ring
        rw [this]; exact hz (k + 1) hk)
    have e2 : (decE C).eval (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) =
        (N : ℤ) - (k + 1 : ℕ) := by
      simp only [decE, Ex.eval, htop]; push_cast; ring
    rw [e2, Function.update_idem] at h2
    exact (h1.seq h2.toIRuns).mono (by simp [Nat.succ_eq_add_one])
  have L := IRuns.loop (I := I) (iprog := iprog) (i := C) (f := fun c => c != .zero)
    (p := .seq body (RS.asg C (decE C)).code) ss
    (fun k => c k + (decE C).size.succ * 2000 * (B + 2)) N
    (fun k hk => by rw [hcl k]; have : (N : ℤ) - k ≠ 0 := by omega
                    simp only [this, if_false]; split_ifs <;> rfl)
    (by rw [hcl N]; simp)
    hstep
  have S3 := Sp.pop s (Function.update (F N) C [(N : ℤ) - N]) (i := C) (a := (N : ℤ) - N) (l := [])
    (B := B) hC5 (by simp) (by simp [zsz_zero])
  rw [Function.update_idem, show Function.update (F N) C [] = F N by
    rw [← hC N, Function.update_eq_self]] at S3
  refine (S1.toIRuns.seq (L.seq S3.toIRuns)).mono ?_
  have hdec : (decE C).size.succ * 2000 * (B + 2) ≤ 8000 * (B + 2) := by
    simp only [decE, Ex.size]; omega
  have hsum : ∑ k ∈ Finset.range N, (c k + (decE C).size.succ * 2000 * (B + 2) + 30) ≤
      ∑ k ∈ Finset.range N, (c k + 8000 * (B + 2) + 30) :=
    Finset.sum_le_sum fun k _ => by omega
  generalize ∑ k ∈ Finset.range N, (c k + (decE C).size.succ * 2000 * (B + 2) + 30) = X1 at hsum ⊢
  generalize ∑ k ∈ Finset.range N, (c k + 8000 * (B + 2) + 30) = X2 at hsum ⊢
  generalize (n.size + 1) * 2000 * (B + 2) = X3
  omega

end IRepF

theorem pushF_upd (v : Fin HS → ℕ) (j : Fin HS) (X : List ℤ) :
    ∀ (L : List (Fin HS × NE)) (F : Fin HS → List ℤ), j ∉ L.map Prod.fst →
      pushF (Function.update F j X) v L = Function.update (pushF F v L) j X
  | [], F, _ => rfl
  | (i, e) :: L, F, h => by
      simp only [List.map_cons, List.mem_cons, not_or] at h
      simp only [pushF]
      rw [← pushF_upd v j X L _ h.2]
      congr 1
      rw [Function.update_comm (Ne.symm h.1), Function.update_of_ne (Ne.symm h.1)]

theorem pushF_nmem (v : Fin HS → ℕ) (j : Fin HS) :
    ∀ (L : List (Fin HS × NE)) (F : Fin HS → List ℤ), j ∉ L.map Prod.fst → pushF F v L j = F j
  | [], F, _ => rfl
  | (i, e) :: L, F, h => by
      simp only [List.map_cons, List.mem_cons, not_or] at h
      simp only [pushF]
      rw [pushF_nmem v j L _ h.2, Function.update_of_ne h.1]

theorem Sp.pushNL (s : IState HS) (D : List (Fin HS)) {M B : ℕ} (hM : zsz (M : ℤ) ≤ B)
    (v : Fin HS → ℕ) :
    ∀ (L : List (Fin HS × NE)) (F : Fin HS → List ℤ), PushNOK F v D M L →
      Sp (pushNL L) (encK s (regState F v D)) (encK s (regState (pushF F v L) v D))
        (szA L * 10 ^ 7 * (B + 2) ^ 2)
  | [], F, _ => (Sp.skip _).mono (by simp only [szA]; have := Nat.one_le_two_pow (n := 0); nlinarith)
  | (i, e) :: L, F, h => by
      obtain ⟨hi, hiD, hr, hok, hreg⟩ := h (i, e) List.mem_cons_self
      have h1 := Sp.pushN s (regState F v D) e v hi hM hr.lt hr.holds hok
      rw [regState_nmem hiD, regState_upd_nmem F v hiD] at h1
      have hL : PushNOK (Function.update F i ((e.val v : ℤ) :: F i)) v D M L := by
        intro p hp
        obtain ⟨a1, a2, a3, a4, a5⟩ := h p (List.mem_cons_of_mem _ hp)
        refine ⟨a1, a2, ?_, a4, fun j hj => fun hm => a5 j hj (by simp [hm])⟩
        intro j hj
        refine ⟨(a3 j hj).1, ?_⟩
        have hji : j ≠ i := fun he => a5 j hj (by simp [he])
        rw [Function.update_of_ne hji]; exact (a3 j hj).2
      have h2 := Sp.pushNL s D hM v L _ hL
      refine (h1.seq h2).mono ?_
      simp only [szA, pushF]; ring_nf; rfl

theorem Sp.popsN (s : IState HS) (D : List (Fin HS)) {M B : ℕ} (hM : zsz (M : ℤ) ≤ B)
    (v : Fin HS → ℕ) :
    ∀ (L : List (Fin HS × NE)) (F : Fin HS → List ℤ),
      (∀ p ∈ L, p.1.val < 56 ∧ p.1 ∉ D ∧ p.2.val v ≤ M) →
      Sp (NLogN.KIL.popsR (L.map Prod.fst)) (encK s (regState (pushF F v L) v D)) (encK s (regState F v D))
        (L.length * (2 * B + 2) + 1)
  | [], F, _ => (Sp.skip _).mono (by simp)
  | (i, e) :: L, F, h => by
      obtain ⟨hi, hiD, hle⟩ := h (i, e) List.mem_cons_self
      have h1 := Sp.popsN s D hM v L (Function.update F i ((e.val v : ℤ) :: F i))
        (fun p hp => h p (List.mem_cons_of_mem _ hp))
      rw [← regState_upd_nmem F v hiD] at h1
      have h2 := Sp.pop s (Function.update (regState F v D) i ((e.val v : ℤ) :: F i)) (i := i)
        (a := (e.val v : ℤ)) (l := F i) (B := B) hi (by simp) (le_trans (NLogN.KIL.zsz_nat_le hle) hM)
      have e2 : Function.update (Function.update (regState F v D) i ((e.val v : ℤ) :: F i)) i (F i) =
          regState F v D := by
        rw [Function.update_idem]
        conv_rhs => rw [← Function.update_eq_self i (regState F v D)]
        rw [regState_nmem hiD]
      rw [e2] at h2
      refine (h1.seq h2).mono ?_
      simp only [List.length_cons]; ring_nf; omega

theorem vol_piece_sw (P R' : ℕ) (G' Suf : Shape) (q m n o j : ℕ) (h : o + m ^ j ≤ n) :
    vol (P :: R' :: swShape (List.replicate o q)
      (List.replicate (n - o - m ^ j) q ++ (G' ++ List.replicate o q))
      (List.replicate (n - o - m ^ j) q ++ Suf) (q ^ m ^ j)) =
      vol (rowShape P R' G' Suf q n) := by
  rw [vol_cons, vol_cons, ← vol_hdShape, hdShape_piece G' Suf q n o (m ^ j) h, rowShape, vol_cons,
    vol_cons]

theorem encK_self0 (s : IState HS) (f : Fin HS → List ℤ) :
    (encK s f).upd 0 (ints (f 0) ++ s.G 0) = encK s f := by
  rw [show ints (f 0) ++ s.G 0 = (encK s f).G 0 by simp, IState.upd_self]

theorem piece_run {I : List Sym} {iprog : Fin 1 → IStmt HS 1} (s : IState HS)
    (F : Fin HS → List ℤ) (v : Fin HS → ℕ) {M B : ℕ} (hM : zsz (M : ℤ) ≤ B)
    {q m n P R' j o : ℕ} (G' Suf : Shape) (child : Oracle (ZMod 2)) {cO : ℕ} (ys : List (ZMod 2))
    (hq : 2 ≤ q) (hG' : ∀ a ∈ G', 1 ≤ a) (hS : ∀ a ∈ Suf, 1 ≤ a) (hP : 1 ≤ P) (hR' : 1 ≤ R')
    (hO : CallSpec I iprog child q m j P R' (vol (rowShape P R' G' Suf q n)) cO)
    (vJ : v aJ = j) (vRp : v aRp = R') (vQO : v aQO = q ^ o) (vQM : v aQM = q ^ (n - o))
    (vTw : v aTw = q ^ m ^ j) (vGR : v aGR = vol G') (vS : v NLogN.KIL.kS = vol Suf)
    (FS : ∃ L, F NLogN.KIL.kS = (vol Suf : ℤ) :: L) (FP : ∃ L, F NLogN.KIL.dP = (P : ℤ) :: L)
    (FT : ∃ L, F dT = towerL q m j ++ L) (F0 : F 0 = enc2 ys)
    (ho : o + m ^ j ≤ n) (hys : ys.length = vol (rowShape P R' G' Suf q n))
    (hVM : vol (rowShape P R' G' Suf q n) ≤ M) (hjM : j ≤ M) :
    IRuns I iprog pieceI (encK s (regState F v regD))
      (encK s (regState (Function.update F 0 (enc2 (pieceStep child P R' G' Suf q m n o j ys)))
        (Function.update (Function.update v aQO (q ^ (o + m ^ j))) aQM (q ^ (n - (o + m ^ j))))
        regD))
      (cO + 100 * 10 ^ 7 * (B + 2) ^ 2) := by
  obtain ⟨LS, hLS⟩ := FS
  obtain ⟨LP, hLP⟩ := FP
  obtain ⟨LT, hLT⟩ := FT
  set w := m ^ j with hw
  set a := n - o - w with ha
  have hq0 : 0 < q := by omega
  have hqp : ∀ k, 1 ≤ q ^ k := fun k => Nat.one_le_pow _ _ hq0
  have hqle : ∀ k ≤ n, q ^ k ≤ q ^ n := fun k hk => Nat.pow_le_pow_right hq0 hk
  have hgv : 1 ≤ vol G' := by
    unfold vol; exact Nat.one_le_iff_ne_zero.2 (List.prod_ne_zero (fun h0 => by
      have := hG' 0 h0; omega))
  have hsv : 1 ≤ vol Suf := by
    unfold vol; exact Nat.one_le_iff_ne_zero.2 (List.prod_ne_zero (fun h0 => by
      have := hS 0 h0; omega))
  have hV : vol (rowShape P R' G' Suf q n) = P * R' * (q ^ n * (vol G' * (q ^ n * vol Suf))) := by
    rw [vol_rowShape]; simp [restShape, vol_append, vol_replicate]
  set V := vol (rowShape P R' G' Suf q n) with hVdef
  have hdiv : q ^ (n - o) / q ^ w = q ^ a := by
    rw [Nat.pow_div (by omega) hq0]
  have hqa : q ^ a * q ^ w * q ^ o = q ^ n := by
    rw [← pow_add, ← pow_add]; congr 1; omega
  -- every value is at most `V`
  have hX : ∀ x, x ≤ q ^ n * (vol G' * (q ^ n * vol Suf)) → x ≤ V := fun x hx => by
    rw [hV]; exact le_trans hx (Nat.le_mul_of_pos_left _ (Nat.mul_pos hP hR'))
  have hn1 : q ^ n ≤ q ^ n * (vol G' * (q ^ n * vol Suf)) :=
    Nat.le_mul_of_pos_right _ (Nat.mul_pos hgv (Nat.mul_pos (hqp n) hsv))
  have hQn : q ^ n ≤ M := le_trans (hX _ hn1) hVM
  have hR'M : R' ≤ M := by
    refine le_trans (le_trans ?_ (le_of_eq hV.symm)) hVM
    calc R' = 1 * R' * 1 := by ring
      _ ≤ P * R' * (q ^ n * (vol G' * (q ^ n * vol Suf))) :=
        Nat.mul_le_mul (Nat.mul_le_mul_right _ hP) (le_trans (hqp n) hn1)
  have hGn : vol G' * q ^ n ≤ q ^ n * (vol G' * (q ^ n * vol Suf)) := by
    calc vol G' * q ^ n = q ^ n * (vol G' * 1) := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_pos (hqp n) hsv))
  have hSn : q ^ n * vol Suf ≤ q ^ n * (vol G' * (q ^ n * vol Suf)) :=
    Nat.mul_le_mul_left _ (le_trans (Nat.le_mul_of_pos_left _ (hqp n))
      (Nat.le_mul_of_pos_left _ hgv))
  have hao : q ^ a * q ^ o ≤ q ^ n := by
    calc q ^ a * q ^ o ≤ q ^ a * q ^ o * q ^ w := Nat.le_mul_of_pos_right _ (hqp w)
      _ = q ^ n := by rw [← hqa]; ring
  have hBv : q ^ a * vol G' * q ^ o ≤ M := by
    refine le_trans (hX _ ?_) hVM
    calc q ^ a * vol G' * q ^ o = vol G' * (q ^ a * q ^ o) := by ring
      _ ≤ vol G' * q ^ n := Nat.mul_le_mul_left _ hao
      _ ≤ _ := hGn
  have hCv : q ^ a * vol Suf ≤ M := by
    refine le_trans (hX _ ?_) hVM
    exact le_trans (Nat.mul_le_mul_right _ (hqle _ (by omega))) hSn
  have hGv : vol G' ≤ M := by
    refine le_trans ?_ hBv
    calc vol G' = 1 * vol G' * 1 := by ring
      _ ≤ q ^ a * vol G' * q ^ o := Nat.mul_le_mul (Nat.mul_le_mul_right _ (hqp a)) (hqp o)
  have hSv : vol Suf ≤ M := le_trans (Nat.le_mul_of_pos_left _ (hqp a)) hCv
  have hQO : q ^ o ≤ M := le_trans (hqle _ (by omega)) hQn
  have hQM : q ^ (n - o) ≤ M := le_trans (hqle _ (by omega)) hQn
  have hQw : q ^ w ≤ M := le_trans (hqle _ (by omega)) hQn
  have hQa : q ^ a ≤ M := le_trans (hqle _ (by omega)) hQn
  have hQaG : q ^ a * vol G' ≤ M := le_trans (Nat.le_mul_of_pos_right _ (hqp o)) hBv
  -- pushes
  have S1 := Sp.pushNL s regD hM v pcL F (by
    simp +decide [PushNOK, pcL, RegsIn, NE.regs, NE.OK, NE.val, vJ, vRp, vQO, vQM, vTw, vGR, vS,
      hLS, hdiv]
    refine ⟨hjM, by omega, hQO, ⟨⟨⟨hQM, hQw, ?_⟩, hGv, hQaG⟩, hQO, hBv⟩, ⟨hQM, hQw, ?_⟩, hSv, hCv⟩
    · exact Nat.pos_of_ne_zero (by positivity)
    · exact Nat.pos_of_ne_zero (by positivity))
  set F1 := pushF F v pcL with hF1
  have F1J : F1 dJ = (j : ℤ) :: F dJ := by simp +decide [F1, pcL, pushF, Function.update_apply, NE.val, vJ]
  have F1L : F1 dL = (R' : ℤ) :: F dL := by simp +decide [F1, pcL, pushF, Function.update_apply, NE.val, vRp]
  have F1A : F1 dA = ((q ^ o : ℕ) : ℤ) :: F dA := by
    simp +decide [F1, pcL, pushF, Function.update_apply, NE.val, vQO]
  have F1B : F1 dB = ((q ^ a * vol G' * q ^ o : ℕ) : ℤ) :: F dB := by
    simp +decide [F1, pcL, pushF, Function.update_apply, NE.val, vQO, vQM, vTw, vGR, hdiv]
  have F1C : F1 dC = ((q ^ a * vol Suf : ℕ) : ℤ) :: F dC := by
    simp +decide [F1, pcL, pushF, Function.update_apply, NE.val, vQM, vTw, vS, hdiv]
  have F1P : F1 NLogN.KIL.dP = F dP := pushF_nmem v NLogN.KIL.dP pcL F (by decide)
  have F1T : F1 dT = F dT := pushF_nmem v dT pcL F (by decide)
  have F10 : F1 0 = F 0 := pushF_nmem v 0 pcL F (by decide)
  -- the call
  set A : Shape := List.replicate o q
  set Bs : Shape := List.replicate a q ++ (G' ++ List.replicate o q)
  set Cs : Shape := List.replicate a q ++ Suf
  set t1 := encK s (regState F1 v regD) with ht1
  have hG1 : ∀ i : Fin HS, i ∉ regD → t1.G i = ints (F1 i) ++ s.G i := fun i hi => by
    simp [t1, regState_nmem hi]
  have hD : DescIn t1 q m j P R' A Bs Cs := by
    refine ⟨⟨ints (F dJ) ++ s.G dJ, by rw [hG1 dJ (by decide), F1J]; rfl⟩, ⟨ints LP ++ s.G NLogN.KIL.dP, ?_⟩,
      ⟨ints (F dL) ++ s.G dL, by rw [hG1 dL (by decide), F1L]; rfl⟩, ⟨ints (F dA) ++ s.G dA, ?_⟩,
      ⟨ints (F dB) ++ s.G dB, ?_⟩, ⟨ints (F dC) ++ s.G dC, ?_⟩, ⟨ints LT ++ s.G dT, ?_⟩⟩
    · rw [hG1 NLogN.KIL.dP (by decide), F1P, hLP]; rfl
    · rw [hG1 dA (by decide), F1A]; simp [A, vol_replicate]
    · rw [hG1 dB (by decide), F1B]; simp [Bs, vol_replicate, vol_append]; ring
    · rw [hG1 dC (by decide), F1C]; simp [Cs, vol_replicate, vol_append]
    · rw [hG1 dT (by decide), F1T, hLT, ints_append, List.append_assoc]
  have hAp : ∀ x ∈ A, 1 ≤ x := fun x hx => by simp [A] at hx; omega
  have hBp : ∀ x ∈ Bs, 1 ≤ x := fun x hx => by
    simp only [Bs, List.mem_append, List.mem_replicate] at hx
    rcases hx with h | h | h
    · omega
    · exact hG' x h
    · omega
  have hCp : ∀ x ∈ Cs, 1 ≤ x := fun x hx => by
    simp only [Cs, List.mem_append, List.mem_replicate] at hx
    rcases hx with h | h
    · omega
    · exact hS x h
  have hlen : ys.length = vol (P :: R' :: swShape A Bs Cs (q ^ m ^ j)) := by
    rw [hys]; exact (vol_piece_sw P R' G' Suf q m n o j ho).symm
  have H := hO A Bs Cs t1 (s.G 0) ys hD hAp hBp hCp hlen (vol_piece_sw P R' G' Suf q m n o j ho)
  have e1 : t1.upd 0 (ints (enc2 ys) ++ s.G 0) = t1 := by
    rw [show enc2 ys = regState F1 v regD 0 by rw [regState_nmem (by decide), F10, F0]]
    exact encK_self0 s _
  set ys' := child j P R' A Bs Cs ys with hys'
  have e2 : t1.upd 0 (ints (enc2 ys') ++ s.G 0) =
      encK s (regState (pushF (Function.update F 0 (enc2 ys')) v pcL) v regD) := by
    rw [ht1, encK_upd, regState_upd_nmem _ _ (by decide), pushF_upd v 0 _ pcL F (by decide)]
  rw [e1, e2] at H
  -- pops
  have S3 := Sp.popsN s regD hM v pcL (Function.update F 0 (enc2 ys')) (by
    simp +decide [pcL, NE.val, vJ, vRp, vQO, vQM, vTw, vGR, vS, hdiv]
    exact ⟨hjM, hR'M, hQO, hBv, hCv⟩)
  -- advance
  have hfin : Function.update (Function.update v aQO (q ^ (o + m ^ j))) aQM (q ^ (n - (o + m ^ j))) =
      evalA advL v := by
    have e3 : Function.update v aQO (q ^ o * q ^ w) aTw = q ^ w := by
      rw [Function.update_of_ne (by decide), vTw]
    simp only [advL, evalA, NE.val, Function.update_of_ne (show aQM ≠ aQO by decide), vQO, vTw, vQM,
      e3]
    rw [pow_add, hdiv, show n - (o + w) = a by omega]
  have hqow : q ^ o * q ^ w ≤ M := by
    rw [← pow_add]; exact le_trans (hqle _ ho) hQn
  have S4 := Sp.asgs s (Function.update F 0 (enc2 ys')) regD hM advL v (by
    simp +decide [OKA, advL, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, vQO, vQM, vTw]
    exact ⟨hQO, ⟨hQO, hQw, hqow⟩, hQM, hQw, Nat.pos_of_ne_zero (pow_ne_zero _ (by omega))⟩)
  rw [← hfin] at S4
  have hstep : pieceStep child P R' G' Suf q m n o j ys = ys' := rfl
  rw [hstep]
  refine ((S1.toIRuns.seq (H.call.seq (S3.toIRuns.seq S4.toIRuns)))).mono ?_
  simp only [szA, pcL, advL, NE.size, List.length_cons, List.length_nil]
  have hB1 : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
  nlinarith

end NLogN.KIL

