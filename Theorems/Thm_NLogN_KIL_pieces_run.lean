namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem one_le_vol {S : Shape} (h : ∀ a ∈ S, 1 ≤ a) : 1 ≤ vol S := by
  unfold vol; exact Nat.one_le_iff_ne_zero.2 (List.prod_ne_zero (fun h0 => by have := h 0 h0; omega))

theorem qn_le_row {P R' q n : ℕ} {G' Suf : Shape} (hq : 1 ≤ q) (hP : 1 ≤ P) (hR' : 1 ≤ R')
    (hG' : ∀ a ∈ G', 1 ≤ a) (hS : ∀ a ∈ Suf, 1 ≤ a) : q ^ n ≤ vol (rowShape P R' G' Suf q n) := by
  rw [vol_rowShape]
  simp only [restShape, vol_append, vol_replicate]
  have h1 := NLogN.KIL.one_le_vol hG'
  have h2 := NLogN.KIL.one_le_vol hS
  have h3 : 1 ≤ q ^ n := Nat.one_le_pow _ _ hq
  calc q ^ n = 1 * (q ^ n * 1) := by ring
    _ ≤ P * R' * (q ^ n * (vol G' * (q ^ n * vol Suf))) :=
      Nat.mul_le_mul (Nat.mul_pos hP hR') (Nat.mul_le_mul_left _ (Nat.mul_pos h1 (Nat.mul_pos h3 h2)))

theorem runPieces_length {α β : Type*} {step : ℕ → β → List α → List α} {w : β → ℕ} {V : ℕ}
    (h : ∀ o t zs, zs.length = V → (step o t zs).length = V) :
    ∀ (ts : List β) (o : ℕ) (xs : List α), xs.length = V → (runPieces step w o ts xs).length = V
  | [], o, xs, hx => hx
  | t :: ts, o, xs, hx => runPieces_length h ts _ _ (h o t xs hx)

theorem levels_succ (m n J : ℕ) :
    levels m n (J + 1) = levels m n J ++ List.replicate (n / m ^ J % m) J := by
  simp [levels, List.range_succ, List.flatMap_append]

theorem sum_levels (m n : ℕ) : ∀ J, ((levels m n J).map fun j => m ^ j).sum = n % m ^ J
  | 0 => by simp [levels, Nat.mod_one]
  | J + 1 => by
      rw [levels_succ, List.map_append, List.sum_append, sum_levels m n J, Nat.mod_pow_succ]
      simp [List.sum_replicate]; ring

theorem pieceLevels_eq_levels {m : ℕ} (hm : 2 ≤ m) (n : ℕ) :
    pieceLevels m n = levels m n (Nat.digits m n).length := by
  unfold pieceLevels levels
  exact List.flatMap_congr (fun j _ => by rw [digit_eq hm])

theorem pow_le_of_lt_len {m n j : ℕ} (hm : 2 ≤ m) (hn : 1 ≤ n) (hj : j < (Nat.digits m n).length) :
    m ^ j ≤ n := by
  have h := Nat.base_pow_length_digits_le m n (by omega) (by omega)
  have : m ^ j * m ≤ m * n := le_trans (by rw [← pow_succ]; exact Nat.pow_le_pow_right (by omega) hj) h
  rw [mul_comm] at this
  exact Nat.le_of_mul_le_mul_left this (by omega)

theorem dstep_iter {m : ℕ} (hm : 2 ≤ m) :
    ∀ N y k, (Nat.digits m y).length ≤ N → ((dstep m)^[N] (y, k)).2 = k + (Nat.digits m y).length
  | 0, y, k, h => by simp at h; simp [h]
  | N + 1, y, k, h => by
      rw [Function.iterate_succ_apply]
      by_cases hy : 0 < y
      · rw [Nat.digits_def' (by omega) hy] at h ⊢
        simp only [dstep, if_pos hy, List.length_cons]
        rw [dstep_iter hm N _ _ (by simpa using h)]; omega
      · have hy0 : y = 0 := by omega
        subst hy0
        have hfix : ∀ j, (dstep m)^[j] (0, k) = (0, k) := by
          intro j; induction j with
          | zero => rfl
          | succ j ih => rw [Function.iterate_succ_apply', ih]; simp [dstep]
        simp only [dstep]; simp [hfix]

theorem dstep_iter_le {m : ℕ} (hm : 2 ≤ m) :
    ∀ N y k, ((dstep m)^[N] (y, k)).1 ≤ y ∧ ((dstep m)^[N] (y, k)).2 ≤ k + N
  | 0, y, k => by simp
  | N + 1, y, k => by
      rw [Function.iterate_succ_apply]
      by_cases hy : 0 < y
      · simp only [dstep, if_pos hy]
        obtain ⟨h1, h2⟩ := dstep_iter_le hm N (y / m) (k + 1)
        exact ⟨le_trans h1 (Nat.div_le_self _ _), by omega⟩
      · simp only [dstep, if_neg hy]
        obtain ⟨h1, h2⟩ := dstep_iter_le hm N y k
        exact ⟨h1, by omega⟩

theorem iter_dlenL (m : ℕ) {Y L : Fin HS} (hYL : Y ≠ L) (v : Fin HS → ℕ) :
    ∀ N, (evalA (dlenL m Y L))^[N] v = Function.update (Function.update v L
      ((dstep m)^[N] (v Y, v L)).2) Y ((dstep m)^[N] (v Y, v L)).1
  | 0 => by simp
  | N + 1 => by
      rw [Function.iterate_succ_apply', iter_dlenL m hYL v N, Function.iterate_succ_apply' (dstep m)]
      simp only [dlenL, evalA, NE.val, Function.update_self, Function.update_of_ne hYL,
        Function.update_of_ne (Ne.symm hYL)]
      funext x
      simp only [Function.update_apply, dstep]
      split_ifs <;> simp_all

theorem okA_dlenL {F : Fin HS → List ℤ} {D : List (Fin HS)} {M m : ℕ} {Y L : Fin HS}
    (hm : 1 ≤ m) (hYL : Y ≠ L) (hY : Y ∈ D) (hL : L ∈ D) (hY5 : Y.val < 56) (hL5 : L.val < 56)
    {v : Fin HS → ℕ} (hvY : v Y ≤ M) (hvL : v L + 1 ≤ M) (hmM : m ≤ M) :
    OKA F D M (dlenL m Y L) v := by
  refine ⟨hL, hL5, by omega, ?_, ?_, hY, hY5, ?_, ?_, ?_, trivial⟩
  · intro j hj
    have : j = Y ∨ j = L := by simp [NE.regs] at hj; tauto
    rcases this with rfl | rfl
    · exact ⟨hY5, Or.inl hY⟩
    · exact ⟨hL5, Or.inl hL⟩
  · by_cases h : 0 < v Y
    · simp [NE.OK, NE.val, h]; omega
    · simp [NE.OK, NE.val, h]; omega
  · simp only [NE.val]; rw [Function.update_of_ne hYL]; omega
  · intro j hj
    have : j = Y := by simp [NE.regs] at hj; tauto
