    (hqM : q ^ n ≤ M) (hmM : m ≤ M) (hPM : P ≤ M) (hnM : n + 1 ≤ M) (hn1 : 1 ≤ n) :
    ∃ vI : Fin HS → ℕ, (∀ i, i ∉ pcW → vI i = v i) ∧ vI aJ = 0 ∧ vI aNN = n ∧ vI aQO = 1 ∧
      vI aQM = q ^ n ∧ vI aTw = q ∧ vI aY = 0 ∧ vI aDg = 0 ∧
      vI aL = (Nat.digits m n).length ∧
      Sp (pcInit q m) (encK s (regState F v regD))
        (encK s (regState (Function.update (Function.update F NLogN.KIL.dP ((P : ℤ) :: F NLogN.KIL.dP)) dT
          ((q : ℤ) :: F dT)) vI regD))
        (100 * (n + 1) * 10 ^ 7 * (B + 2) ^ 2) := by
  obtain ⟨LP, hLP⟩ := FP
  have hq1 : 1 ≤ q ^ n := Nat.one_le_pow _ _ (by omega)
  have hqq : q ≤ M := le_trans (by simpa using Nat.pow_le_pow_right (show 0 < q by omega) hn1) hqM
  have S1 := Sp.asgs s F regD hM (inL q) v (by
    simp +decide [OKA, inL, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, vN, vQN]
    have := hv aJ (by decide); have := hv aNN (by decide); have := hv aQO (by decide)
    have := hv aQM (by decide); have := hv aTw (by decide); have := hv aY (by decide)
    have := hv aL (by decide); have := hv aDg (by decide)
    and_intros <;> omega)
  set v1 := evalA (inL q) v with hv1
  have v1Y : v1 aY = n := by simp +decide [v1, inL, evalA, NE.val, Function.update_apply, vN]
  have v1L : v1 aL = 0 := by simp +decide [v1, inL, evalA, NE.val, Function.update_apply]
  have v1N : v1 aN = n := by simp +decide [v1, inL, evalA, NE.val, Function.update_apply, vN]
  have S2 := Sp.repA s F regD hM (C := 23) (by decide) (by decide) F23 (dlenL m aY aL)
    (by simp +decide [dlenL]) (.reg aN) trivial v1
    (fun j hj => by simp [NE.regs] at hj; subst hj; exact ⟨by decide, Or.inl (by decide)⟩)
    (by simp only [NE.OK]; rw [v1N]; omega) (by
      intro k hk
      simp only [NE.val, v1N] at hk
      rw [iter_dlenL m (by decide)]
      obtain ⟨h1, h2⟩ := dstep_iter_le hm k n 0
      refine okA_dlenL (by omega) (by decide) (by decide) (by decide) (by decide) (by decide)
        ?_ ?_ hmM
      · simp only [Function.update_self, v1Y, v1L]; omega
      · rw [Function.update_of_ne (by decide), Function.update_self]; simp only [v1Y, v1L]; omega)
  simp only [NE.val, v1N] at S2
  rw [iter_dlenL m (by decide)] at S2
  set v2 := Function.update (Function.update v1 aL ((dstep m)^[n] (v1 aY, v1 aL)).2) aY
    ((dstep m)^[n] (v1 aY, v1 aL)).1 with hv2
  have S3 := Sp.asgs s F regD hM y0L v2 (by
    simp +decide [OKA, y0L, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, v2]
    rw [v1Y]; exact le_trans (dstep_iter_le hm n n _).1 (by omega))
  set v3 := evalA y0L v2 with hv3
  have S4 := Sp.pushNL s regD hM v3 [(NLogN.KIL.dP, .reg kP), (dT, .reg aTw)] F (by
    simp +decide [PushNOK, RegsIn, NE.regs, NE.OK, NE.val, v3, y0L, evalA, v2, v1, inL,
      Function.update_apply, vP, hLP]
    exact ⟨hPM, hqq⟩)
  have hpF : pushF F v3 [(NLogN.KIL.dP, .reg kP), (dT, .reg aTw)] =
      Function.update (Function.update F NLogN.KIL.dP ((P : ℤ) :: F NLogN.KIL.dP)) dT ((q : ℤ) :: F dT) := by
    simp +decide [pushF, NE.val, v3, y0L, evalA, v2, v1, inL, Function.update_apply, vP]
  rw [hpF] at S4
  have hlen : ((dstep m)^[n] (n, 0)).2 = (Nat.digits m n).length := by
    rw [dstep_iter hm n n 0 ((Nat.digits_length_le_iff (by omega) n).2 (Nat.lt_pow_self (by omega)))]
    simp
  refine ⟨v3, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, (S1.seq (S2.seq (S3.seq S4))).mono ?_⟩
  · intro i hi
    simp only [pcW, List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    simp [v3, y0L, evalA, v2, v1, inL, Function.update_apply, hi.1, hi.2.1, hi.2.2.1, hi.2.2.2.1,
      hi.2.2.2.2.1, hi.2.2.2.2.2.1, hi.2.2.2.2.2.2.1, hi.2.2.2.2.2.2.2]
  · simp +decide [v3, y0L, evalA, v2, v1, inL, Function.update_apply, NE.val]
  · simp +decide [v3, y0L, evalA, v2, v1, inL, Function.update_apply, NE.val, vN]
  · simp +decide [v3, y0L, evalA, v2, v1, inL, Function.update_apply, NE.val]
  · simp +decide [v3, y0L, evalA, v2, v1, inL, Function.update_apply, NE.val, vQN]
  · simp +decide [v3, y0L, evalA, v2, v1, inL, Function.update_apply, NE.val]
  · simp +decide [v3, y0L, evalA, v2, v1, inL, Function.update_apply, NE.val]
  · simp +decide [v3, y0L, evalA, v2, v1, inL, Function.update_apply, NE.val]
  · have : v3 aL = ((dstep m)^[n] (v1 aY, v1 aL)).2 := by
      simp +decide [v3, y0L, evalA, v2, Function.update_apply]
    rw [this, v1Y, v1L, hlen]
  · simp only [szA, inL, y0L, dlenL, NE.size, NE.toEx, Ex.size, List.length_cons, List.length_nil]
    have hX : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    generalize (B + 2) ^ 2 = X at hX
    nlinarith

theorem pcFin_sp (s : IState HS) (X : Fin HS → List ℤ) (v : Fin HS → ℕ) {M B : ℕ}
    (hM : zsz (M : ℤ) ≤ B) {P : ℕ} (T : List ℤ) (hT : T.length = v aL) (hTB : ∀ a ∈ T, zsz a ≤ B)
    (hPB : zsz (P : ℤ) ≤ B) (hL : v aL ≤ M) (X8 : X 8 = []) :
    Sp pcFin (encK s (regState (Function.update (Function.update X NLogN.KIL.dP ((P : ℤ) :: X NLogN.KIL.dP)) dT
        (T ++ X dT)) v regD))
      (encK s (regState X v regD)) ((T.length + 2) * 10 ^ 4 * (B + 2)) := by
  set Fk : ℕ → Fin HS → List ℤ := fun k => regState (Function.update (Function.update X NLogN.KIL.dP
    ((P : ℤ) :: X NLogN.KIL.dP)) dT (T.drop k ++ X dT)) v regD with hFk
  obtain ⟨o, b, ev⟩ := NE.good (t := encK s (Fk 0)) (v := v) hM (NE.reg aL)
    (NE.holds_encK (fun i hi => by
      simp [NE.regs] at hi; subst hi; exact ⟨_, regState_mem (by decide)⟩))
    (by simp only [NE.OK]; exact hL)
  have H := Sp.rep (C := 8) (n := (NE.reg aL).toEx) (b := .pop dT) (s := s) (F := Fk) (N := T.length)
    (B := B) (c := 2 * B + 2) (by decide) (fun k => by
      simp only [hFk]; rw [regState_nmem (by decide)]; simp +decide [Function.update_apply, X8])
    (by decide) (clean_reg (by decide)) o trivial b (by rw [ev]; simp [NE.val, hT]) (by
      intro k hk
      have hd : T.drop k = T[k] :: T.drop (k + 1) := List.drop_eq_getElem_cons hk
      have h1 := Sp.pop s (Function.update (Fk k) 8 [(T.length : ℤ) - k]) (i := dT)
        (a := T[k]) (l := T.drop (k + 1) ++ X dT) (B := B) (by decide)
        (by simp only [hFk]; rw [regState_upd_nmem _ _ (by decide), regState_nmem (by decide),
              Function.update_of_ne (by decide), Function.update_self, hd, List.cons_append])
        (hTB _ (List.getElem_mem _))
      refine h1.congr ?_
      congr 1
      simp only [hFk]
      rw [regState_upd_nmem _ _ (by decide), regState_upd_nmem _ _ (by decide),
        regState_upd_nmem _ _ (by decide)]
      congr 1
      rw [Function.update_comm (show (8 : Fin HS) ≠ dT by decide), Function.update_idem])
  have e0 : Fk 0 = regState (Function.update (Function.update X NLogN.KIL.dP ((P : ℤ) :: X NLogN.KIL.dP)) dT
      (T ++ X dT)) v regD := by simp [hFk]
  rw [e0] at H
  have e1 : Fk T.length = regState (Function.update X NLogN.KIL.dP ((P : ℤ) :: X NLogN.KIL.dP)) v regD := by
    simp only [hFk, List.drop_length, List.nil_append]
    congr 1
    rw [Function.update_eq_self_iff.2]
    rw [Function.update_of_ne (by decide)]
  rw [e1] at H
  have h2 := Sp.pop s (regState (Function.update X NLogN.KIL.dP ((P : ℤ) :: X NLogN.KIL.dP)) v regD) (i := NLogN.KIL.dP)
    (a := P) (l := X NLogN.KIL.dP) (B := B) (by decide)
    (by rw [regState_nmem (by decide)]; simp) hPB
  rw [regState_upd_nmem _ _ (by decide), Function.update_idem, Function.update_eq_self] at h2
  refine (H.seq h2).mono ?_
  simp only [NE.toEx, Ex.size]
  nlinarith

theorem sum_split_le (N : ℕ) (c g : ℕ → ℕ) (A B0 : ℕ) (hc : ∀ k, c k ≤ g (k + 1))
    (hA : A ≤ g 0 + B0) :
    ∑ k ∈ Finset.range N, c k + A ≤ ∑ j ∈ Finset.range (N + 1), g j + B0 := by
  rw [Finset.sum_range_succ']
  have := Finset.sum_le_sum (s := Finset.range N) (fun k _ => hc k)
  omega

theorem pcs_arith (n m B Ls c X : ℕ) (hX : B + 2 ≤ X) (hLs : Ls ≤ n) :
    100 * (n + 1) * 10 ^ 7 * X + c + ((1 + 1 + 1 + 2) * 2000 * (B + 2) + (2 * B + 32)) +
      (Ls + 2) * 10 ^ 4 * (B + 2) ≤ c + (m + 2) * 10 ^ 9 * X + 2 * 10 ^ 9 * (n + 2) * X := by
  have h1 : (Ls + 2) * (B + 2) ≤ (n + 2) * X := Nat.mul_le_mul (by omega) hX
  have h2 : 0 ≤ m * X := Nat.zero_le _
  have h3 : 0 ≤ n * X := Nat.zero_le _
  norm_num
  nlinarith

theorem lvl_arith (m B c X : ℕ) (hX : B + 2 ≤ X) :
    (m + 1) * 10 ^ 9 * X + c + 8000 * (B + 2) + 30 ≤ c + (m + 2) * 10 ^ 9 * X := by
  have h2 : 0 ≤ m * X := Nat.zero_le _
  norm_num
  nlinarith

theorem vLev_zero {vI : Fin HS → ℕ} {q m n : ℕ} (h1 : vI aJ = 0) (h2 : vI aNN = n) (h3 : vI aQO = 1)
    (h4 : vI aQM = q ^ n) (h5 : vI aTw = q) :
    vLev vI 0 (n / m ^ 0) (q ^ (n % m ^ 0)) (q ^ (n - n % m ^ 0)) (q ^ m ^ 0) = vI := by
  simp only [vLev, pow_zero, Nat.div_one, Nat.mod_one, Nat.sub_zero, pow_one]
  (( (funext x_m2)
     (by_cases h1_m2 : x_m2 = NLogN.KIL.aJ)
     (· (subst h1_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h2_m2 : x_m2 = NLogN.KIL.aNN)
     (· (subst h2_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h3_m2 : x_m2 = NLogN.KIL.aQO)
     (· (subst h3_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h4_m2 : x_m2 = NLogN.KIL.aQM)
     (· (subst h4_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h5_m2 : x_m2 = NLogN.KIL.aTw)
     (· (subst h5_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h6_m2 : x_m2 = NLogN.KIL.aDg)
     (· (subst h6_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h7_m2 : x_m2 = NLogN.KIL.aY)
     (· (subst h7_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h8_m2 : x_m2 = NLogN.KIL.aL)
     (· (subst h8_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (simp [Function.update_apply, h1_m2, h2_m2, h3_m2, h4_m2, h5_m2, h6_m2, h7_m2, h8_m2, h1, h2, h3,
         h4, h5])))

end NLogN.KIL

