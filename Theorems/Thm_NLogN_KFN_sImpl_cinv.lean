section Node

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

theorem diag_ZD : (Matrix.diagonal fun x : κ → Fin 2 => I ^ (0 + ∑ i, 2 * (x i).val)) = ZD := by
  unfold ZD wt
  congr 1; funext x
  rw [zero_add, ← Finset.mul_sum, pow_mul, I_sq]

theorem diag_ZD' : (Matrix.diagonal fun x : κ → Fin 2 =>
    I ^ (3 * Fintype.card κ + ∑ i, 2 * (x i).val)) = (-I) ^ Fintype.card κ • ZD := by
  unfold ZD wt
  ext x y
  simp only [Matrix.diagonal, Matrix.of_apply, Matrix.smul_apply, smul_eq_mul]
  split_ifs
  · rw [pow_add, ← Finset.mul_sum, pow_mul, pow_mul, I_sq]
    have : I ^ 3 = -I := by rw [pow_succ, I_sq]; ring
    rw [this]
  · simp

end Node

