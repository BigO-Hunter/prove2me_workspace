theorem NLogN.KIL.Sp_mvK {X Y C : Fin NLogN.HS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (hX5 : X.val < 56)
    (hY5 : Y.val < 56) (hC5 : C.val < 56) (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (n : NLogN.Ex NLogN.HS)
    (hnc : n.Clean) (hno : n.ok (NLogN.KIL.encK s f)) (L l : List ℤ) (hX : f X = L ++ l)
    (hn : n.eval (NLogN.KIL.encK s f) = L.length) (B : ℕ) (hL : NLogN.Bnd B L) (hnl : n.Lin)
    (hnb : n.Bnd (NLogN.KIL.encK s f) B) :
    NLogN.KIL.Sp (NLogN.mvK X Y C n) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update (Function.update f X l) Y (L.reverse ++ f Y)))
      ((n.size + 1) * 2000 * (B + 2) + L.length * (14000 * (B + 2)) + 32) := by
  have hXs : (NLogN.KIL.encK s f).G X = NLogN.ints L ++ (NLogN.ints l ++ s.G X) := by simp [hX, NLogN.ints_append]
  have H := NLogN.mvK_spec hXY hXC hYC hX5 hY5 hC5 n hnc (NLogN.KIL.encK s f) L _ hXs hno hn
  refine ⟨H.1, ?_, NLogN.mvK_cost hXY hXC hYC n (NLogN.KIL.encK s f) L _ hXs hn B hL hnl hnb⟩
  rw [H.2]
  refine NLogN.IState.ext' (fun j => ?_) rfl rfl
  by_cases h1 : j = Y
  · subst h1; simp [Ne.symm hXY, NLogN.ints_append, NLogN.ints_reverse]
  by_cases h2 : j = X
  · subst h2; simp [hXY]
  · simp [h1, h2]
end

