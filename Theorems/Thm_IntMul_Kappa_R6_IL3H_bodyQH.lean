        omega)
    ⟨fun j _ => by simp, trivial⟩ (hfσ σ2 hσ20) (fun x hx => hfx x.1 (by
      simp only [bF3, List.mem_singleton] at hx; subst hx; (try dsimp only); decide)) F4
  have F2 := runQ_fr (I := Isym) (iprog := tbl) bF2 Mb Bz 12 hMb (by
      intro x hx
      simp only [bF2, List.mem_singleton] at hx
      subst hx
      refine ⟨by decide, regsLt_of_all (by decide), by decide, natR_of [29, 14] (by
        intro i hi
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl
        exacts [⟨_, hC1.hD'⟩, ⟨_, h14a⟩]) (by decide), ?_⟩
      simp only [NE.OK, NE.val, vOf_eq hC1.hD', vOf_eq h14a]
      have : qBr ≤ D / c.m * G + K := Nat.div_le_self _ _ |>.trans (by omega)
      refine ⟨by omega, by omega, ?_⟩
      split_ifs <;> (try simp only [NE.OK]) <;> omega)
    (noRdN_of_B _ _ (by decide)) (hfσ σ1 hσ10) (fun x hx => hfx x.1 (by
      simp only [bF2, List.mem_singleton] at hx; subst hx; (try dsimp only); decide)) F3
  have F1 := runQ_fr (I := Isym) (iprog := tbl) (bF1 c.m) Mb Bz 12 hMb (by
      intro x hx
      simp only [bF1, List.mem_singleton] at hx
      subst hx
      refine ⟨by (try dsimp only); decide, regsLt_of_all (e := qBrNE c.m) (by rw [qBrNE_regs]; decide),
        by show (qBrNE c.m).size ≤ 12; rw [qBrNE_size]; decide,
        natR_of (e := qBrNE c.m) [22, 24, 1] (by
        intro i hi
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl
        exacts [⟨_, hC.hD⟩, ⟨_, hG⟩, ⟨_, hC.hK⟩]) (by rw [qBrNE_regs]; decide), ?_⟩
      show (qBrNE c.m).OK (vOf σ) Mb
      simp only [qBrNE, gWNE, NE.OK, NE.val, vOf_eq hC.hD, vOf_eq hG, vOf_eq hC.hK]
      have : D / c.m ≤ D := Nat.div_le_self _ _
      repeat' apply And.intro
      all_goals omega)
    (by show NoRdN [] [(14, qBrNE c.m)]
        exact ⟨fun j hj => by rw [qBrNE_regs] at hj; revert j; decide, trivial⟩) (hfσ σ hσ0) (fun x hx => hfx x.1 (by
      simp only [bF1, List.mem_singleton] at hx; subst hx; (try dsimp only); decide)) F2
  exact F1

