/-- **The layer body.** -/
theorem bodyQH_sol_aux {c : Cfg} (hc : CfgOK c) (jK jL : Fin Pp) (rowC : IStmt HS Pp)
    (hK : tbl jK = kerLoopC jK jL) (hL : tbl jL = levCH c jL rowC)
    {K S r H P D ρ q0 Bp Zl Z Zr G Mb Bz : ℕ} {CB : ℕ → ℝ}
    (L1 : LvH c Isym tbl jL rowC K r Zl Zr H G CB 1) (hρ : ρ < K) (hS : 1 ≤ S) (hP : 1 ≤ P)
    (hr : 1 ≤ r) (hD : 1 ≤ D) (hq0 : q0 ≤ D)
    (hZl : zsz ((32 * c.Wr * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Zl)
    (hZ32 : zsz ((32 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z) (hHZ : zsz (H : ℤ) ≤ Z)
    (hV1 : zsz ((VbH c K (K * D) S r H 1 (ρ + K * (D - 1)) P : ℕ) : ℤ) ≤ Zr) (hH1 : 1 ≤ H)
    (hMb : zsz (Mb : ℤ) ≤ Bz)
    (hM : MbBody c K P D S G q0 (qBv c.m K D G q0) ≤ Mb)
    (pre : q0 + qBv c.m K D G q0 < D →
      MidPre c Isym tbl jL rowC CB K S r H P D ρ q0 Bp (qBv c.m K D G q0) Zl Z Zr G)
    (hEZ : zsz ((Etot c D q0 (qBv c.m K D G q0) : ℕ) : ℤ) ≤ Z)
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ)) (p w : ℕ)
    (hC0 : Clean0 f) (h0 : f 0 = gflat zs ++ l) (hx : RecRep r p zs xs)
    (hl : xs.length = vol (Butterfly.layerShape P K D S)) (hb : GB w zs)
    (hH : w + (dwCL c D q0 (qBv c.m K D G q0) + 2) ≤ H)
    (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1)
    (hex : ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
        (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs)) :
    ∀ σ, CoreR σ K S r H P D ρ 0 q0 Bp → σ vG = some (G : ℤ) →
      RunQ Isym tbl σ (bodyCH c jK jL) f (Function.update f 0 (gflat (Classical.choose hex) ++ l))
        (cBodyH c CB K S r H P D q0 (qBv c.m K D G q0) Bp Z Zr Bz w) := by
  intro σ hC hG
  have hσ0 : σ 0 = none := hC.base.off 0 (by decide)
  have hm := hc.m1
  set qB := qBv c.m K D G q0 with hqB
  set zs' := Classical.choose hex with hzs'
  have hzs := Classical.choose_spec hex
  set g := Function.update f 0 (gflat zs' ++ l) with hgd
  have hg : Clean0 g := hC0.upd0 _
  have hfx : ∀ x : Fin HS, x ≠ 0 → f x = [] ∧ g x = [] := fun x hx => ⟨hC0 x hx, hg x hx⟩
  have hfσ : ∀ σ : Fin HS → Option ℤ, σ 0 = none → ∀ j, (σ j).isSome → f j = [] := by
    intro σ h0 j hj
    have : j ≠ 0 := by rintro rfl; simp [h0] at hj
    exact hC0 j this
  have hK1 : 1 ≤ K := by omega
  have hqq : q0 + qB ≤ D := by have : qB ≤ D - q0 := min_le_left _ _; omega
  unfold MbBody at hM
  -- frame 1: `14 ← ⌈⌊D/m⌋ G / K⌉`
  set qBr := (D / c.m * G + K - 1) / K with hqBr
  have hv1 : (qBrNE c.m).val (vOf σ) = qBr := by
    simp only [qBrNE, gWNE, NE.val, vOf_eq hC.hD, vOf_eq hG, vOf_eq hC.hK, hqBr]
  have hfr1 : frV σ (bF1 c.m) = [(14, ((qBr : ℕ) : ℤ))] := by
    simp only [frV, bF1, List.map_cons, List.map_nil, hv1]
  have hk1 : ∀ q ∈ frV σ (bF1 c.m), q.1 ∈ KFW.scr := by
    rw [hfr1]; intro q hq; simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide
  set σ1 := σPush σ (frV σ (bF1 c.m)) with hσ1
  have hC1 : CoreR σ1 K S r H P D ρ 0 q0 Bp := hC.push _ hk1
  have hG1 : σ1 vG = some (G : ℤ) := by rw [hσ1, σPush_scr_ne hk1 (by decide)]; exact hG
  have h14a : σ1 14 = some ((qBr : ℕ) : ℤ) := by rw [hσ1, hfr1]; exact σPush_one _ _ _
  have hσ10 : σ1 0 = none := hC1.base.off 0 (by decide)
  -- frame 2: `14 ← min(D - q₀, 14)`
  have hv2 : (NE.lt (.reg 29) (.reg 14) (.reg 29) (.reg 14)).val (vOf σ1) = qB := by
    simp only [NE.val, vOf_eq hC1.hD', vOf_eq h14a, hqB, qBv, min_def]
    split_ifs <;> omega
  have hfr2 : frV σ1 bF2 = [(14, ((qB : ℕ) : ℤ))] := by
    simp only [frV, bF2, List.map_cons, List.map_nil, hv2]
  have hk2 : ∀ q ∈ frV σ1 bF2, q.1 ∈ KFW.scr := by
    rw [hfr2]; intro q hq; simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide
  set σ2 := σPush σ1 (frV σ1 bF2) with hσ2
  have hC2 : CoreR σ2 K S r H P D ρ 0 q0 Bp := hC1.push _ hk2
  have hG2 : σ2 vG = some (G : ℤ) := by rw [hσ2, σPush_scr_ne hk2 (by decide)]; exact hG1
  have h14 : σ2 14 = some ((qB : ℕ) : ℤ) := by rw [hσ2, hfr2]; exact σPush_one _ _ _
  have hσ20 : σ2 0 = none := hC2.base.off 0 (by decide)
  -- frame 3: `15 ← Gs D''`
  set E := D - q0 - qB with hE
  have hdv : dppNE.val (vOf σ2) = E := by
    simp only [dppNE, NE.val, vOf_eq hC2.hD', vOf_eq h14, hE]
  have hv3 : (gsNE c.Aw c.p c.m dppNE).val (vOf σ2) = c.G E := by
    rw [gsNE_val, hdv]
  have hfr3 : frV σ2 (bF3 c) = [(15, ((c.G E : ℕ) : ℤ))] := by
    simp only [frV, bF3, List.map_cons, List.map_nil, hv3]
  have hk3 : ∀ q ∈ frV σ2 (bF3 c), q.1 ∈ KFW.scr := by
    rw [hfr3]; intro q hq; simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide
  set σ3 := σPush σ2 (frV σ2 (bF3 c)) with hσ3
  have hC3 : CoreR σ3 K S r H P D ρ 0 q0 Bp := hC2.push _ hk3
  have hG3 : σ3 vG = some (G : ℤ) := by rw [hσ3, σPush_scr_ne hk3 (by decide)]; exact hG2
  have h15 : σ3 15 = some ((c.G E : ℕ) : ℤ) := by rw [hσ3, hfr3]; exact σPush_one _ _ _
  have h14' : σ3 14 = some ((qB : ℕ) : ℤ) := by
    rw [hσ3, hfr3, σPush_ne _ _ _ (fun q hq => by
      simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide)]; exact h14
  have hσ30 : σ3 0 = none := hC3.base.off 0 (by decide)
  -- frame 4: `13 ← E_tot`
  have hv4 : etNE.val (vOf σ3) = Etot c D q0 qB := by
    simp only [etNE, NE.val, vOf_eq hC3.hq, vOf_eq h14', vOf_eq h15, vOf_eq hC3.hD, Etot, hE]
    try ring
  have hfr4 : frV σ3 bF4 = [(13, ((Etot c D q0 qB : ℕ) : ℤ))] := by
    simp only [frV, bF4, List.map_cons, List.map_nil, hv4]
  have hk4 : ∀ q ∈ frV σ3 bF4, q.1 ∈ KFW.scr := by
    rw [hfr4]; intro q hq; simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide
  set σ4 := σPush σ3 (frV σ3 bF4) with hσ4
  have hC4 : CoreR σ4 K S r H P D ρ 0 q0 Bp := hC3.push _ hk4
  have hG4 : σ4 vG = some (G : ℤ) := by rw [hσ4, σPush_scr_ne hk4 (by decide)]; exact hG3
  have h13 : σ4 13 = some ((Etot c D q0 qB : ℕ) : ℤ) := by rw [hσ4, hfr4]; exact σPush_one _ _ _
  have h14'' : σ4 14 = some ((qB : ℕ) : ℤ) := by
    rw [hσ4, hfr4, σPush_ne _ _ _ (fun q hq => by
      simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide)]; exact h14'
  have h15' : σ4 15 = some ((c.G E : ℕ) : ℤ) := by
    rw [hσ4, hfr4, σPush_ne _ _ _ (fun q hq => by
      simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide)]; exact h15
  -- the body proper
  obtain ⟨z2, r2, R⟩ := bodyCoreQ hc jK jL rowC hK hL L1 hρ hS hP hr hD hqq hZl hZ32 hHZ hV1 hH1
    hMb (by omega) pre hEZ hC4 hG4 h14'' h15' h13 f zs l xs p w hC0 h0 hx hl hb hH hdisk
  have e : z2 = zs' := recRep_uniq r2 hzs
  rw [e] at R
  -- the frames, inside out
  have hGE : c.G E ≤ c.Aw * (D + 1) ^ c.p :=
    le_trans (Gs_mono hc.Aw1 hc.p1 (by omega)) (Gs_le_pow hc.Aw1 hc.p1)
  have F4 := runQ_fr (I := Isym) (iprog := tbl) bF4 Mb Bz 16 hMb (by
      intro x hx
      simp only [bF4, List.mem_singleton] at hx
      subst hx
      refine ⟨by decide, regsLt_of_all (by decide), by decide, natR_of [28, 14, 15, 22] (by
        intro i hi
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl | rfl
        exacts [⟨_, hC3.hq⟩, ⟨_, h14'⟩, ⟨_, h15⟩, ⟨_, hC3.hD⟩]) (by decide), ?_⟩
      simp only [etNE, NE.OK, NE.val, vOf_eq hC3.hq, vOf_eq h14', vOf_eq h15, vOf_eq hC3.hD]
      have hEt : Etot c D q0 qB = q0 + (qB + c.G E) + (D / 2 + D % 2) := rfl
      have : D / 2 ≤ D := Nat.div_le_self _ _
      have : D % 2 < 2 := Nat.mod_lt _ (by norm_num)
      repeat' apply And.intro
      all_goals omega)
    (noRdN_of_B _ _ (by decide)) (hfσ σ3 hσ30) (fun x hx => hfx x.1 (by
      simp only [bF4, List.mem_singleton] at hx; subst hx; (try dsimp only); decide)) R
  have F3 := runQ_fr (I := Isym) (iprog := tbl) (bF3 c) Mb Bz (szB c) hMb (by
      intro x hx
      simp only [bF3, List.mem_singleton] at hx
      subst hx
      refine ⟨by (try dsimp only); decide, ?_, by simp only [szB]; omega, fun i hi => ?_, ?_⟩
      · intro i hi
        have := gsNE_regs _ _ _ _ i hi
        simp only [dppNE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
          or_false] at this
        rcases this with rfl | rfl <;> decide
      · have := gsNE_regs _ _ _ _ i hi
        simp only [dppNE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
          or_false] at this
        rcases this with rfl | rfl
        exacts [⟨_, hC2.hD'⟩, ⟨_, h14⟩]
      · have hx : dppNE.OK (vOf σ2) Mb := by
