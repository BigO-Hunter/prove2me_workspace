namespace NLogN

open IntMul RS

namespace KFD

open KFC (marks marks_zero isMk NM toUL cUL uK uR uY uB)

theorem writes_sub : ∀ (p : RS), ∀ j ∈ p.writes, j ∈ touch p
  | .skip, j, h => by simp [RS.writes] at h
  | .asg i e, j, h | .push i e, j, h => by simp [RS.writes] at h; simp [touch, h]
  | .pop i, j, h => by simp [RS.writes] at h; simp [touch, h]
  | .seq a b, j, h => by
    simp only [RS.writes, List.mem_append] at h
    simp only [touch, List.mem_append]
    rcases h with h | h
    · exact Or.inl (writes_sub a j h)
    · exact Or.inr (writes_sub b j h)
  | .ite c a b, j, h => by
    simp only [RS.writes, List.mem_append] at h
    simp only [touch, List.mem_append]
    rcases h with h | h
    · exact Or.inr (Or.inl (writes_sub a j h))
    · exact Or.inr (Or.inr (writes_sub b j h))
  | .rep i n b, j, h => by
    simp only [RS.writes, List.mem_cons] at h
    simp only [touch, List.mem_cons, List.mem_append]
    rcases h with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (writes_sub b j h))

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end KFD

