-- Source module: Solutions.KFWLoop
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul KIL KFD

theorem fcost_rep_le_sum {i : Fin HS} {n : Ex HS} {b : RS} {s : IState HS} {S : ℕ → IState HS}
    (h : RepStates i n b s S) (c : ℕ → ℕ)
    (hb : ∀ k < (n.eval s).toNat, fcost b (withCtr i s (n.eval s).toNat k (S k)) ≤ c k) :
    fcost (.rep i n b) s ≤ n.cost s + cRep (n.eval s).toNat +
      ∑ k ∈ Finset.range (n.eval s).toNat, c k := by
  simp only [fcost]
  set N := (n.eval s).toNat with hN
  have hNv : n.eval s = (N : ℤ) := by have := h.nonneg; omega
  have hsum : ∑ k ∈ Finset.range N, (fcost b (RS.repSt i n b s k) + 31) ≤
      ∑ k ∈ Finset.range N, c k + N * 31 := by
    have := Finset.sum_le_sum (s := Finset.range N)
      (f := fun k => fcost b (RS.repSt i n b s k) + 31) (g := fun k => c k + 31) (fun k hk => by
        have hk' := Finset.mem_range.1 hk
        rw [h.repSt k (by rw [← hN]; exact hk'.le), ← hN]
        have := hb k hk'
        omega)
    simpa [Finset.sum_add_distrib] using this
  rw [hNv]
  simp only [cRep, KFC.cUL, moveCost]
  nlinarith

/-- **Counted loop with per-iteration costs.** -/
theorem FSp.repSum {C : Fin HS} {n : Ex HS} {b : RS} {s : IState HS} {F : ℕ → Fin HS → List ℤ}
    {N : ℕ} (c : ℕ → ℕ) (hC5 : C.val < 56) (hC : ∀ k, F k C = []) (hw : C ∉ b.writes)
    (hnc : n.Clean) (hno : n.ok (NLogN.KIL.encK s (F 0))) (hn : n.eval (NLogN.KIL.encK s (F 0)) = N)
    (hb : ∀ k < N, FSp b (NLogN.KIL.encK s (Function.update (F k) C [(N : ℤ) - k]))
      (NLogN.KIL.encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (c k)) :
    FSp (.rep C n b) (NLogN.KIL.encK s (F 0)) (NLogN.KIL.encK s (F N))
      (n.cost (NLogN.KIL.encK s (F 0)) + cRep N + ∑ k ∈ Finset.range N, c k) := by
  have hN : (n.eval (NLogN.KIL.encK s (F 0))).toNat = N := by rw [hn]; simp
  have H : RepStates C n b (NLogN.KIL.encK s (F 0)) (fun k => NLogN.KIL.encK s (F k)) :=
    { nonneg := by rw [hn]; positivity
      hw := hw
      h0 := rfl
      hG := fun k => by simp [hC]
      step := by
        intro k hk
        rw [hN] at hk ⊢
        rw [withCtr_encK C s _ _ (hC 0) (hC k), withCtr_encK C s _ _ (hC 0) (hC (k + 1))]
        exact (hb k hk).2.1 }
  refine ⟨?_, ?_, ?_⟩
  · refine H.ok hC5 hnc hno ?_
    intro k hk
    rw [hN] at hk ⊢
    rw [withCtr_encK C s _ _ (hC 0) (hC k)]
    exact (hb k hk).1
  · rw [H.run, hN]
  · have := fcost_rep_le_sum H c (by
      intro k hk
      rw [hN] at hk ⊢
      rw [withCtr_encK C s _ _ (hC 0) (hC k)]
      exact (hb k hk).2.2)
    rw [hN] at this
    exact this

end NLogN.KFW

end

section
-- Source module: Solutions.KFWPhase
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFN

theorem encK_G_bg {s : IState HS} {f : Fin HS → List ℤ} {j : Fin HS} (h : f j = []) :
    (NLogN.KIL.encK s f).G j = s.G j := by simp +decide [h, ints]

theorem sub_dblX (ε : ℤ) : RS.sub (σE ε) dblX = dblP ε := by
  simp +decide [dblX, dblP, dblB, NLogN.KFG.dE, RS.sub, Ex.sub, σE, NLogN.mvK]

theorem writes_dblX : ∀ i ∈ dblX.writes, i ≠ xE := by decide

theorem noW_dblX (ε : ℤ) : NoW (σE ε) dblX := by
  intro i hi
  simp only [σE, if_neg (writes_dblX i hi)]

theorem sClean_σE (ε : ℤ) : SClean (σE ε) := by
  intro i hi
  simp only [σE] at hi
  split_ifs at hi with h
  · subst h; decide
  · simp at hi

theorem dblU_fsp (s : IState HS) (f : Fin HS → List ℤ) (εE : Ex HS) (ε : ℤ) (he : 0 ≤ ε)
    (he' : ε < 4) (hcl : εE.Clean) (hok : εE.ok (NLogN.KIL.encK s f)) (hev : εE.eval (NLogN.KIL.encK s f) = ε)
    {Bε : ℕ} (hB : εE.Bnd (NLogN.KIL.encK s f) Bε) (hzε : zsz ε ≤ Bε)
    (T R : List ℤ) (hT : Ex4 T) (hA : f NLogN.KFG.xA = T ++ R) (hB' : f NLogN.KFG.xB = []) (hC : f NLogN.KFG.xC = [])
    (hD : f NLogN.KFG.xD = []) (hc : f NLogN.KFB.c1 = []) (hN : f xN = [(T.length : ℤ)]) (hE : f NLogN.KFW.xE = []) (Z : ℕ)
    (hZ : zsz ((2 * T.length : ℕ) : ℤ) ≤ Z) :
    FSp (dblU εE) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update (Function.update f NLogN.KFG.xA (dblL ε T ++ R)) xN
      [((2 * T.length : ℕ) : ℤ)]))
      ((εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + 400 * cDbl T.length Z + (2 * Bε + 2)) := by
  -- push
  have P1 := FSp.of_norep (p := .push NLogN.KFW.xE εE) rfl (Sp.pushE (NLogN.KIL.encK s f) (i := NLogN.KFW.xE) (by decide) hcl hok hB)
  rw [hev] at P1
  have e1 : (NLogN.KIL.encK s f).upd NLogN.KFW.xE (.int ε :: (NLogN.KIL.encK s f).G NLogN.KFW.xE) = NLogN.KIL.encK s (Function.update f NLogN.KFW.xE [ε]) := by
    rw [← encK_upd]; simp +decide [hE, ints]
  rw [e1] at P1
  set f1 := Function.update f NLogN.KFW.xE [ε]
  -- doubling
  have D := dbl_fsp s f1 ε he he' T R hT (by simp +decide [f1, hA]) (by simp +decide [f1, hB'])
    (by simp +decide [f1, hC]) (by simp +decide [f1, hD]) (by simp +decide [f1, hc]) (by simp +decide [f1, hN]) Z hZ
  rw [← sub_dblX ε] at D
  have hag : Agree (σE ε) (NLogN.KIL.encK s f1) := by
    intro i v hv
    simp only [σE] at hv
    split_ifs at hv with h
    · subst h; cases hv; exact ⟨s.G NLogN.KFW.xE, by simp +decide [f1, ints]⟩
  have D' := FSp.of_sub (sClean_σE ε) (noW_dblX ε) hag D
  -- pop
  set f2 := Function.update (Function.update f1 NLogN.KFG.xA (dblL ε T ++ R)) xN [((2 * T.length : ℕ) : ℤ)]
  have hf2 : f2 NLogN.KFW.xE = [ε] := by simp +decide [f2, f1]
  have P3 := FSp.of_norep (p := .pop NLogN.KFW.xE) rfl (Sp.popI (NLogN.KIL.encK s f2) (i := NLogN.KFW.xE) (by decide)
    (a := ε) (L := s.G NLogN.KFW.xE) (by simp +decide [hf2, ints]) hzε)
  have e3 : (NLogN.KIL.encK s f2).upd NLogN.KFW.xE (s.G NLogN.KFW.xE) = NLogN.KIL.encK s (Function.update (Function.update f NLogN.KFG.xA
      (dblL ε T ++ R)) xN [((2 * T.length : ℕ) : ℤ)]) := by
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases h : j = NLogN.KFW.xE
    · subst h; simp +decide [f2, f1, hE]
    · simp +decide [h, f2, f1, Function.update_apply]
  rw [e3] at P3
  exact (P1.seq (D'.seq P3)).mono (by omega)

theorem writes_dblX' : ∀ i ∈ dblX.writes, i ∈ [KFG.xA, NLogN.KFG.xB, NLogN.KFG.xC, NLogN.KFG.xD, xN, NLogN.KFB.c1, NLogN.KFW.xE] := by decide

theorem writes_dblU (εE : Ex HS) : ∀ j ∈ (dblU εE).writes, j ∈ [KFG.xA, NLogN.KFG.xB, NLogN.KFG.xC, NLogN.KFG.xD, xN, NLogN.KFB.c1, NLogN.KFW.xE] := by
  intro j hj
  simp only [dblU, RS.writes, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with h | h | h
  · subst h; decide
  · exact writes_dblX' j h
  · subst h; decide

theorem writes_bodyU (εE : Ex HS) : ∀ j ∈ (bodyU εE).writes,
    j ∈ [KFG.xA, NLogN.KFG.xB, NLogN.KFG.xC, NLogN.KFG.xD, xN, NLogN.KFB.c1, NLogN.KFW.xE, NLogN.KFW.kS] := by
  intro j hj
  simp only [bodyU, RS.writes, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with h | h
  · have := writes_dblU εE j h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at this ⊢
    tauto
  · subst h; decide

/-- **The uniform table loop.** -/
theorem tblU_fsp (s : IState HS) (T0 : List ℤ) (h4 : Ex4 T0) (aE : ℕ → ℕ) (ρt : Fin HS)
    (εE : Ex HS) (t Bε : ℕ) (hε : EpsOK s εE t aE Bε) (hBε : zsz (4 : ℤ) ≤ Bε)
    (hρ : ρt.val < 56) (hρt : ∃ L, s.G ρt = .int (t : ℤ) :: L) (hρk : ρt ≠ NLogN.KFW.kS)
    (hreg : ∀ j ∈ εE.regs, j ∉ [KFG.xA, NLogN.KFG.xB, NLogN.KFG.xC, NLogN.KFG.xD, xN, NLogN.KFB.c1, NLogN.KFW.xE, NLogN.KFW.cT])
    (f : Fin HS → List ℤ) (R : List ℤ)
    (hA : f NLogN.KFG.xA = T0 ++ R) (hB : f NLogN.KFG.xB = []) (hC : f NLogN.KFG.xC = []) (hD : f NLogN.KFG.xD = [])
    (hc : f NLogN.KFB.c1 = []) (hN : f xN = [(T0.length : ℤ)]) (hcT : f NLogN.KFW.cT = []) (hE : f NLogN.KFW.xE = [])
    (hkS : f NLogN.KFW.kS = []) (hρf : f ρt = []) (hfr : ∀ j ∈ εE.regs, j ≠ NLogN.KFW.kS → f j = []) (Z : ℕ)
    (hZ : zsz ((T0.length * 2 ^ t : ℕ) : ℤ) ≤ Z) (hZt : zsz (t : ℤ) ≤ Z) (hZ1 : zsz (1 : ℤ) ≤ Z) :
    FSp (tblU ρt εE) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update (Function.update f NLogN.KFG.xA
      (tblG T0 aE t ++ R)) xN [((T0.length * 2 ^ t : ℕ) : ℤ)]))
      (12000 + ((Ex.reg ρt).cost (NLogN.KIL.encK s f) + cRep t +
        ∑ k ∈ Finset.range t, cTbl ((εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + (2 * Bε + 2))
          T0.length Z k) + (2 * Z + 2)) := by
  obtain ⟨L, hL⟩ := hρt
  -- push the index
  have P1 := Sp.push s f (i := NLogN.KFW.kS) (e := .lit 0) (B := 1) (by decide) (clean_lit _) trivial trivial
    (by simp [Ex.Bnd, zsz_zero])
  simp only [Ex.eval, hkS, Ex.size] at P1
  set f0 := Function.update f NLogN.KFW.kS [0]
  set F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update (Function.update f NLogN.KFG.xA
    (tblG T0 aE k ++ R)) xN [((T0.length * 2 ^ k : ℕ) : ℤ)]) NLogN.KFW.kS [(k : ℤ)] with hF
  have F0 : F 0 = f0 := by
    funext x
    simp only [hF, f0, Function.update_apply, pow_zero, mul_one]
    by_cases x0 : x = NLogN.KFW.kS
    · subst x0; simp
    by_cases x1 : x = xN
    · subst x1; simp +decide [hN]
    by_cases x2 : x = KFG.xA
    · subst x2; simp +decide [hA, tblG]
    simp +decide [x0, x1, x2]
  have hρf0 : f0 ρt = [] := by simp [f0, Function.update_apply, hρk, hρf]
  have hev : (Ex.reg ρt).eval (NLogN.KIL.encK s f0) = (t : ℤ) := by
    simp only [Ex.eval]; exact IState.top_eq (by rw [encK_G_bg hρf0, hL])
  have hco : (Ex.reg ρt).cost (NLogN.KIL.encK s f0) = (Ex.reg ρt).cost (NLogN.KIL.encK s f) := by
    simp only [Ex.cost]
    rw [IState.top_eq (by rw [encK_G_bg hρf0, hL]), IState.top_eq (by rw [encK_G_bg hρf, hL])]
  have Rp := FSp.repSum (C := NLogN.KFW.cT) (n := .reg ρt) (b := bodyU εE) (s := s) (F := F) (N := t)
    (cTbl ((εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + (2 * Bε + 2)) T0.length Z) (by decide)
    (fun k => by simp +decide [hF, hcT])
    (fun h => by have := writes_bodyU εE NLogN.KFW.cT h; revert this; decide)
    (clean_reg hρ) (by rw [F0]; simp only [Ex.ok]; exact IState.isInt_of (by rw [encK_G_bg hρf0, hL]))
    (by rw [F0]; exact hev)
    (by
      intro k hk
      have hl := length_tblG T0 aE k
      set g := Function.update (F k) NLogN.KFW.cT [(t : ℤ) - k] with hg
      have hgK : g NLogN.KFW.kS = [(k : ℤ)] := by simp +decide [hg, hF]
      have hgr : ∀ j ∈ εE.regs, j ≠ NLogN.KFW.kS → g j = [] := by
        intro j hj hjc
        have hn := hreg j hj
        simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hn
        simp +decide [hg, hF, Function.update_apply, hn.1, hn.2.1, hn.2.2.1, hn.2.2.2.1, hn.2.2.2.2.1,
          hn.2.2.2.2.2.1, hn.2.2.2.2.2.2.1, hn.2.2.2.2.2.2.2, hfr j hj hjc, hjc]
      obtain ⟨o, v, b⟩ := hε.2 k hk g hgK hgr
      have hε4 : (((aE k % 4 : ℕ) : ℤ)) < 4 := by omega
      have hzε : zsz (((aE k % 4 : ℕ) : ℤ)) ≤ Bε :=
        le_trans (zsz_natCast_le (show aE k % 4 ≤ 4 by omega)) (by simpa using hBε)
      have D := dblU_fsp s g εE _ (by omega) hε4 hε.1 o v b hzε (tblG T0 aE k) R
        (ex4_tblG h4 aE k) (by simp +decide [hg, hF]) (by simp +decide [hg, hF, hB]) (by simp +decide [hg, hF, hC])
        (by simp +decide [hg, hF, hD]) (by simp +decide [hg, hF, hc]) (by simp +decide [hg, hF, hl])
        (by simp +decide [hg, hF, hE]) Z
        (by
          rw [hl]; refine le_trans (zsz_natCast_le ?_) hZ
          have : 2 ^ (k + 1) ≤ 2 ^ t := Nat.pow_le_pow_right (by norm_num) hk
          rw [pow_succ] at this; nlinarith)
      rw [hl] at D
      -- the increment
      set g2 := Function.update (Function.update g NLogN.KFG.xA (dblL (((aE k % 4 : ℕ) : ℤ)) (tblG T0 aE k) ++ R))
        xN [((2 * (T0.length * 2 ^ k) : ℕ) : ℤ)]
      have hg2 : g2 NLogN.KFW.kS = (k : ℤ) :: [] := by simp +decide [g2, hgK]
      have zk : zsz (k : ℤ) ≤ Z := le_trans (zsz_natCast_le hk.le) hZt
      have zk1 : zsz ((k : ℤ) + 1) ≤ Z := by
        have := le_trans (zsz_natCast_le (show k + 1 ≤ t by omega)) hZt; push_cast at this; exact this
      have A := Sp.asg s g2 (i := NLogN.KFW.kS) (e := .add (.reg NLogN.KFW.kS) (.lit 1)) (B := Z) (by decide) hg2 zk
        (clean_add (clean_reg (by decide)) (clean_lit _)) ⟨ok_reg hg2, trivial⟩ ⟨trivial, trivial⟩
        ⟨bnd_reg hg2 zk, by simpa [Ex.Bnd] using hZ1, by simp only [Ex.eval]; rw [top_encK hg2]; exact zk1⟩
      have ev : (Ex.add (.reg NLogN.KFW.kS) (.lit 1) : Ex HS).eval (NLogN.KIL.encK s g2) = (k : ℤ) + 1 := by
        simp only [Ex.eval]; rw [top_encK hg2]
      rw [ev] at A
      refine (D.seq (FSp.of_norep rfl A)).mono ?_ |>.congr ?_
      · simp only [cTbl, Ex.size]; omega
      · congr 1; funext x
        simp only [g2, hg, hF, Function.update_apply]
        by_cases x0 : x = NLogN.KFW.kS
        · subst x0; simp +decide
        by_cases x1 : x = xN
        · subst x1; simp +decide; ring
        by_cases x2 : x = KFG.xA
        · subst x2; simp +decide [tblG]
        by_cases x3 : x = NLogN.KFW.cT
        · subst x3; simp +decide
        simp +decide [x0, x1, x2, x3])
  rw [F0, hco] at Rp
  -- pop the index
  have hFt : F t NLogN.KFW.kS = [(t : ℤ)] := by simp +decide [hF]
  have P3 := Sp.pop s (F t) (i := NLogN.KFW.kS) (l := []) (B := Z) (by decide) hFt hZt
  refine (FSp.of_norep rfl P1 |>.seq (Rp.seq (FSp.of_norep rfl P3))).mono ?_ |>.congr ?_
  · omega
  · congr 1; funext x
    simp only [hF, Function.update_apply]
    by_cases x0 : x = NLogN.KFW.kS
    · subst x0; simp +decide [hkS]
    simp +decide [x0]

theorem touch_blkP : ∀ i ∈ touch blkP, i ∈ pT := by decide

theorem upd_reg {σ : Fin HS → Option ℤ} (hoff : ∀ i ∈ NLogN.KFW.pT, σ i = none) {g : Fin HS → List ℤ}
    {x : Fin HS} (hx : x ∈ NLogN.KFW.pT) (v : List ℤ) {j : Fin HS} (hj : (σ j).isSome) :
    Function.update g x v j = g j := by
  rw [Function.update_of_ne]
  rintro rfl; rw [hoff _ hx] at hj; simp at hj

theorem sum_cDbl (R0 Z : ℕ) : ∀ t, ∑ k ∈ Finset.range t, cDbl (R0 * 2 ^ k) Z ≤
    120000 * (R0 * 2 ^ t) + t * (10000 * (Z + 2) + 20000)
  | 0 => by simp
  | t + 1 => by
    rw [Finset.sum_range_succ]
    have := sum_cDbl R0 Z t
    simp only [cDbl, pow_succ] at this ⊢
    nlinarith

theorem sub_blkP {σ : Fin HS → Option ℤ} (hoff : ∀ i ∈ NLogN.KFW.pT, σ i = none) : RS.sub σ blkP = blkP :=
  RS.sub_id σ blkP (fun i hi => hoff i (touch_blkP i hi))

theorem phLU_arith {R0 B t P w Z S3 X c3r a1 a2 a3 a4 : ℕ}
    (hs3 : S3 ≤ t * (X + 10000 * (Z + 2)) + 400 * (120000 * (R0 * P) + t * (10000 * (Z + 2) + 20000)))
    (hρt : c3r + 17 ≤ 1000 * (Z + 2)) (zR : a1 ≤ Z) (zB : a2 ≤ Z) (zT : a3 ≤ Z)
    (hTV : R0 * P ≤ B * (R0 * P)) (hR0V : R0 ≤ R0 * P) (hB1 : 1 ≤ B) :
    400 * (a1 + 2 + (400 * a1 + 1100 * R0 + 1200) + R0 * 24000) +
      (400 * ((1 + 1) * 2000 * (Z + 2)) +
        (12000 + (c3r + 17 + (400 * a4 + 1100 * t + 1200) + S3) + (2 * Z + 2) +
          (400 * (a2 + 2 + (400 * a2 + 1100 * B + 1200) + B * (R0 * P * (cMulB w + 5000) + 1000 * (Z + 2) + 5000)) +
            (R0 * P * (250 * 4 + 2600) + 2000 +
              (dupCost a3 + 17 + (400 * a3 + 1100 * (R0 * P) + 1200) + R0 * P * 10 +
                (400 * ((1 + 1) * 2000 * (Z + 2)) + (2 * (B * (R0 * P)) * (250 * w + 2600) + 2000 + (2 * Z + 2)))))))) ≤
    400 * (B * (R0 * P) * (cMulB w + 300000 + 500 * w) + (t + B + 10) * (20000 * (Z + 2) + 30000)) +
              400 * (120000 * (R0 * P) + t * (10000 * (Z + 2) + 20000)) +
            t * (X + 10000 * (Z + 2)) +
          1000 * (Z + 2) +
        20000 +
      (400 * a4 + 1100 * t + 1200) := by
  unfold dupCost zipCost moveCost
  have h1 : R0 ≤ B * (R0 * P) := le_trans hR0V hTV
  nlinarith [Nat.zero_le (B * (R0 * P) * w), Nat.zero_le (B * Z), Nat.zero_le (t * Z),
    Nat.zero_le (B * (R0 * P) * cMulB w)]

/-- **The uniform phase pass runs as `phL`.** -/
theorem phLU_fsp (s : IState HS) (f : Fin HS → List ℤ) (R0 t B u : ℕ) (aE : ℕ → ℕ)
    (zs : List GI) (l : List ℤ) (hB1 : 1 ≤ B) (hR01 : 1 ≤ R0) (hlen : zs.length = B * (R0 * 2 ^ t))
    (h0 : f 0 = gflat zs ++ l) (hC : ClT f) (hcO : f NLogN.KFN.cO = []) (hxE : f NLogN.KFW.xE = []) {w : ℕ}
    (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : zsz ((4 * (B * (R0 * 2 ^ t) + R0 + B + 1) : ℕ) : ℤ) ≤ Z)
    {σ : Fin HS → Option ℤ} {ρR0 ρt ρB ρu ρV : Fin HS} (hR : PReg σ ρR0 ρt ρB ρu ρV R0 t B u)
    (hag : Agree σ s) (hfr : ∀ j, (σ j).isSome → f j = [])
    (εE : Ex HS) (Bε : ℕ) (hε : EpsOK s εE t aE Bε) (hBε : zsz (4 : ℤ) ≤ Bε)
    (hreg : ∀ j ∈ εE.regs, j ∉ [KFG.xA, NLogN.KFG.xB, NLogN.KFG.xC, NLogN.KFG.xD, xN, NLogN.KFB.c1, NLogN.KFW.xE, NLogN.KFW.cT])
    (hkS : f NLogN.KFW.kS = []) (hfε : ∀ j ∈ εE.regs, j ≠ NLogN.KFW.kS → f j = []) :
    FSp (phLU ρR0 ρt ρB ρu ρV εE) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0 (gflat (NLogN.KFN.phOut R0 t B u aE zs) ++ l)))
      (cPhU w (B * (R0 * 2 ^ t)) t B Z R0
        ((εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + (2 * Bε + 2) + 10000 * (Z + 2))) := by
  have zl : ∀ k : ℕ, k ≤ 4 * (B * (R0 * 2 ^ t) + R0 + B + 1) → zsz (k : ℤ) ≤ Z :=
    fun k hk => le_trans (zsz_natCast_le hk) hZ
  have hAg : ∀ g : Fin HS → List ℤ, (∀ j, (σ j).isSome → g j = []) → Agree σ (NLogN.KIL.encK s g) :=
    fun g hg => agree_encK hag hg
  set T0 := List.replicate R0 ((u % 4 : ℕ) : ℤ) with hT0
  have h40 : Ex4 T0 := by
    intro a ha; rw [hT0, List.mem_replicate] at ha; rw [ha.2]; omega
  set T := tblG T0 aE t with hTd
  have hTl : T.length = R0 * 2 ^ t := by rw [hTd, length_tblG, hT0, List.length_replicate]
  have hT4 : Ex4 T := ex4_tblG h40 aE t
  have hTV : R0 * 2 ^ t ≤ B * (R0 * 2 ^ t) := Nat.le_mul_of_pos_left _ hB1
  have hR0V : R0 ≤ R0 * 2 ^ t := Nat.le_mul_of_pos_right _ (by positivity)
  -- 1. the initial table
  have i1 := init_fsp s f R0 ((u % 4 : ℕ) : ℤ) (by omega) (by omega) hC.a hC.c1
  have e1 : RS.sub σ (.rep NLogN.KFB.c1 (.reg ρR0) (.push KFG.xA (.reg ρu))) = initP R0 ((u % 4 : ℕ) : ℤ) := by
    simp [RS.sub, Ex.sub, hR.r0, hR.u, initP]
  rw [← e1] at i1
  have i1' := FSp.of_sub hR.cl (by
    intro i hi; simp only [RS.writes, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl <;> exact hR.off _ (by decide)) (hAg f hfr) i1
  set f1 := Function.update f KFG.xA T0
  have hf1 : ∀ j, (σ j).isSome → f1 j = [] := fun j hj => by
    simp only [f1]; rw [upd_reg hR.off (by decide) _ hj]; exact hfr j hj
  have p2 := Sp.push s f1 (i := xN) (e := .lit (R0 : ℤ)) (B := Z) (by decide)
    (clean_lit _) trivial trivial (zl _ (by omega))
  rw [show Ex.eval (NLogN.KIL.encK s f1) (.lit (R0 : ℤ)) :: f1 xN = [(R0 : ℤ)] by
    simp +decide [Ex.eval, f1, hC.n]] at p2
  have e2 : RS.sub σ (.push xN (.reg ρR0)) = .push xN (.lit (R0 : ℤ)) := by
    simp [RS.sub, Ex.sub, hR.r0]
  have p2' := FSp.of_sub hR.cl (by
    intro i hi; simp only [RS.writes, List.mem_cons, List.not_mem_nil, or_false] at hi
    subst hi; exact hR.off _ (by decide)) (hAg f1 hf1) (FSp.of_norep (p := RS.sub σ (.push xN (.reg ρR0)))
      (by rw [e2]; rfl) (by rw [e2]; exact p2))
  set f2 := Function.update f1 xN [(R0 : ℤ)]
  have hf2 : ∀ j, (σ j).isSome → f2 j = [] := fun j hj => by
    simp only [f2]; rw [upd_reg hR.off (by decide) _ hj]; exact hf1 j hj
  -- 2. the table loop
  obtain ⟨Lt, hLt⟩ := hag ρt t hR.tt
  have t3 := tblU_fsp s T0 h40 aE ρt εE t Bε hε hBε (hR.lt _ _ hR.tt) ⟨Lt, hLt⟩
    (by intro h; have := hR.off NLogN.KFW.kS (by decide); rw [← h, hR.tt] at this; simp at this) hreg f2 []
    (by simp +decide [f2, f1]) (by simp +decide [f2, f1, hC.b]) (by simp +decide [f2, f1, hC.c])
    (by simp +decide [f2, f1, hC.d]) (by simp +decide [f2, f1, hC.c1]) (by simp +decide [f2, hT0])
    (by simp +decide [f2, f1, hcO]) (by simp +decide [f2, f1, hxE]) (by simp +decide [f2, f1, hkS])
    (hf2 ρt (by simp [hR.tt]))
    (fun j hj hjc => by
      have hn := hreg j hj
      simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hn
      simp +decide [f2, f1, Function.update_apply, hn.1, hn.2.2.2.2.1, hfε j hj hjc]) Z
    (by rw [hT0, List.length_replicate]; exact zl _ (by omega))
    (zl t (le_trans (Nat.lt_two_pow_self).le (by nlinarith [Nat.le_mul_of_pos_left (2 ^ t) hR01])))
    (by simpa using zl 1 (by omega))
  rw [List.append_nil, ← hTd, hT0, List.length_replicate] at t3
  set f3 := Function.update (Function.update f2 KFG.xA T) xN [((R0 * 2 ^ t : ℕ) : ℤ)]
  have hf3 : ∀ j, (σ j).isSome → f3 j = [] := fun j hj => by
    simp only [f3]; rw [upd_reg hR.off (by decide) _ hj, upd_reg hR.off (by decide) _ hj]
    exact hf2 j hj
  -- 3. the blocks
  have o4 := outer_fsp s f3 T B zs l [] hT4 (by rw [hlen, hTl]) (by simp +decide [f3, f2, f1, h0])
    (by simp +decide [f3]) (by simp +decide [f3, f2, f1, hC.b]) (by simp +decide [f3, f2, f1, hC.o])
    (by simp +decide [f3, f2, f1, hC.ur]) (by simp +decide [f3, f2, f1, hC.ui])
    (by simp +decide [f3, f2, f1, hC.c1]) (by simp +decide [f3, hTl])
    (by simp +decide [f3, f2, f1, hcO]) hb Z (by rw [hTl]; exact zl _ (by omega))
  rw [List.append_nil] at o4
  have e4 : RS.sub σ (.rep NLogN.KFN.cO (.reg ρB) blkP) = .rep NLogN.KFN.cO (.lit (B : ℤ)) blkP := by
    simp only [RS.sub, Ex.sub, hR.b, sub_blkP hR.off]
  rw [← e4] at o4
  have o4' := FSp.of_sub hR.cl (by
    intro i hi
    simp only [RS.writes, List.mem_cons] at hi
    rcases hi with rfl | hi
    · exact hR.off _ (by decide)
    · exact hR.off _ (touch_blkP i (writes_sub _ i hi))) (hAg f3 hf3) o4
  set f4 := Function.update (Function.update f3 0 l) qO (gflat (KFG.mulL (repT B T) zs)).reverse
  have hf4 : ∀ j, (σ j).isSome → f4 j = [] := fun j hj => by
    simp only [f4]; rw [upd_reg hR.off (by decide) _ hj, upd_reg hR.off (by decide) _ hj]
    exact hf3 j hj
  -- 4. drop the table
  have m5 := FSp.mvN (X := KFG.xA) (Y := NLogN.KFG.xB) (C := NLogN.KFB.c1) (r := xN) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f4 T [] (by simp +decide [f4, f3])
    (Lr := s.G xN) (by simp +decide [f4, f3, ints, hTl]) 4 hT4.bnd
  set f5 := Function.update (Function.update f4 KFG.xA []) NLogN.KFG.xB (T.reverse ++ f4 NLogN.KFG.xB)
  have hN5 : f5 xN = [(T.reverse.length : ℤ)] := by simp +decide [f5, f4, f3, hTl]
  have d6 := dropLoop_fsp s f5 T.reverse (NLogN.KIL.bnd_reverse hT4.bnd)
    (by simp +decide [f5, f4, f3, f2, f1, hC.b]) (by simp +decide [f5, f4, f3, f2, f1, hC.c1]) hN5
  simp only [Ex.cost, top_encK hN5, List.length_reverse] at d6
  set f6 := Function.update f5 NLogN.KFG.xB []
  have hf6 : ∀ j, (σ j).isSome → f6 j = [] := fun j hj => by
    simp only [f6, f5]
    rw [upd_reg hR.off (by decide) _ hj, upd_reg hR.off (by decide) _ hj,
      upd_reg hR.off (by decide) _ hj]
    exact hf4 j hj
  -- 5. results back
  have hN6 : f6 xN = [((R0 * 2 ^ t : ℕ) : ℤ)] := by simp +decide [f6, f5, f4, f3]
  have a7 := Sp.asg s f6 (i := xN) (e := .lit ((2 * (B * (R0 * 2 ^ t)) : ℕ) : ℤ)) (B := Z)
    (by decide) hN6 (zl _ (by omega)) (clean_lit _) trivial trivial (zl _ (by omega))
  simp only [Ex.eval] at a7
  have e7 : RS.sub σ (.asg xN (.reg ρV)) = .asg xN (.lit ((2 * (B * (R0 * 2 ^ t)) : ℕ) : ℤ)) := by
    simp [RS.sub, Ex.sub, hR.v]
  have a7' := FSp.of_sub hR.cl (by
    intro i hi; simp only [RS.writes, List.mem_cons, List.not_mem_nil, or_false] at hi
    subst hi; exact hR.off _ (by decide)) (hAg f6 hf6)
    (FSp.of_norep (p := RS.sub σ (.asg xN (.reg ρV))) (by rw [e7]; rfl) (by rw [e7]; exact a7))
  set f7 := Function.update f6 xN [((2 * (B * (R0 * 2 ^ t)) : ℕ) : ℤ)]
  have hlo : (gflat (KFG.mulL (repT B T) zs)).reverse.length = 2 * (B * (R0 * 2 ^ t)) := by
    have hg : ∀ ms : List GI, (gflat ms).length = 2 * ms.length := by
      intro ms; induction ms with
      | nil => simp
      | cons z ms ih => simp only [gflat_cons, List.length_cons, ih]; omega
    simp [hg, length_mulL _ _ (show (repT B T).length = zs.length by rw [length_repT, hlen, hTl]), hlen]
  have m8 := FSp.mvN (X := qO) (Y := 0) (C := NLogN.KFB.c1) (r := xN) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f7 (gflat (KFG.mulL (repT B T) zs)).reverse []
    (by simp +decide [f7, f6, f5, f4]) (Lr := s.G xN) (by simp +decide [f7, ints, hlo]) w
    (NLogN.KIL.bnd_reverse (GB_mulL _ zs (ex4_repT hT4 B) hb).bnd)
  set f8 := Function.update (Function.update f7 qO []) 0
    ((gflat (KFG.mulL (repT B T) zs)).reverse.reverse ++ f7 0)
  have p9 := Sp.pop s f8 (i := xN) (a := ((2 * (B * (R0 * 2 ^ t)) : ℕ) : ℤ)) (l := []) (B := Z)
    (by decide) (by simp +decide [f8, f7]) (zl _ (by omega))
  have F := fun {p : RS} {a b : IState HS} {c : ℕ} (h : Sp p a b c) (hr : norep p = true) =>
    FSp.of_norep hr h
  have hρt : (Ex.reg ρt).cost (NLogN.KIL.encK s f2) ≤ 1000 * (Z + 2) := by
    simp only [Ex.cost]
    rw [IState.top_eq (by rw [encK_G_bg (hf2 ρt (by simp [hR.tt])), hLt])]
    have ht2 : t ≤ R0 * 2 ^ t := le_trans (Nat.lt_two_pow_self).le (Nat.le_mul_of_pos_left _ hR01)
    have := zl t (by omega)
    simp only [dupCost, zipCost, moveCost]; omega
  have hsum := sum_cDbl R0 Z t
  refine (i1'.seq (p2'.seq (t3.seq (o4'.seq (m5.seq (d6.seq (a7'.seq
    (m8.seq (F p9 rfl))))))))).mono ?_ |>.congr ?_
  · have hs3 : ∑ k ∈ Finset.range t, cTbl ((εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + (2 * Bε + 2))
        R0 Z k ≤ t * ((εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 +
        (2 * Bε + 2) + 10000 * (Z + 2)) + 400 * (120000 * (R0 * 2 ^ t) + t * (10000 * (Z + 2) + 20000)) := by
      simp only [cTbl]
      rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
      simp only [Finset.sum_const, Finset.card_range, smul_eq_mul]
      rw [← Finset.mul_sum]
      nlinarith
    rw [hlo, hTl]
    have zR := zl R0 (by omega)
    have zB := zl B (by omega)
    have zT := zl (R0 * 2 ^ t) (by omega)
    simp only [Ex.cost, Ex.size] at hρt ⊢
    unfold cPhU cPhL KFN.cBlk cRep
    generalize (∑ k ∈ Finset.range t, cTbl ((εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + (2 * Bε + 2))
        R0 Z k) = S3 at hs3 ⊢
    generalize (εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + (2 * Bε + 2) = X at hs3 ⊢
    generalize dupCost (zsz ((NLogN.KIL.encK s f2).top ρt)) = c3r at hρt ⊢
    generalize zsz (R0 : ℤ) = a1 at zR ⊢
    generalize zsz (B : ℤ) = a2 at zB ⊢
    generalize zsz ((R0 * 2 ^ t : ℕ) : ℤ) = a3 at zT ⊢
    generalize zsz (t : ℤ) = a4
    generalize 2 ^ t = P at hTV hR0V hs3 ⊢
    clear * - hs3 hρt zR zB zT hTV hR0V hB1 hR01
    exact phLU_arith hs3 hρt zR zB zT hTV hR0V hB1
  · congr 1; funext x
    simp only [f8, f7, f6, f5, f4, f3, f2, f1, Function.update_apply]
    by_cases e0 : x = 0
    · subst e0; simp +decide [NLogN.KFN.phOut, hTd, hT0]
    by_cases e3 : x = KFG.xA
    · subst e3; simp +decide [hC.a]
    by_cases e4 : x = xN
    · subst e4; simp +decide [hC.n]
    by_cases e5 : x = KFG.xB
    · subst e5; simp +decide [hC.b]
    by_cases e6 : x = qO
    · subst e6; simp +decide [hC.o]
    simp [e0, e3, e4, e5, e6]

end NLogN.KFW

namespace NLogN.KFW
open IntMul KIL KFD KFB KFG KFN

theorem fok_phLU {ρR0 ρt ρB ρu ρV : Fin HS} {εE : Ex HS} (hu : ρu ≠ NLogN.KFB.c1) (hε : NLogN.KFW.cT ∉ εE.regs) :
    fok (phLU ρR0 ρt ρB ρu ρV εE) = true := by
  have h1 : fok dblX = true := by decide
  have h2 : fok blkP = true := by decide
  have h3 : fok (NLogN.mvK KFG.xA NLogN.KFG.xB NLogN.KFB.c1 (.reg xN)) = true := by decide
  have h3' : fok (NLogN.mvK qO 0 NLogN.KFB.c1 (.reg xN)) = true := by decide
  have h4 : (touch dblX).contains NLogN.KFW.cT = false := by decide
  simp [phLU, tblU, bodyU, dblU, fok, touch, h1, h2, h3, h3', h4, hε, NLogN.KFD.scr, Ne.symm hu]
  have h5 : NLogN.KFW.cT ∉ touch dblX := by decide
  have h6 : NLogN.KFN.cO ∉ touch blkP := by decide
  refine ⟨⟨⟨by decide, by simp [Ex.regs, Ne.symm hu]⟩, by decide⟩, ⟨⟨by decide, h5, by decide, by decide,
    by simp [Ex.regs]; decide⟩, by decide⟩, ⟨h6, by decide⟩, by decide⟩

end NLogN.KFW

