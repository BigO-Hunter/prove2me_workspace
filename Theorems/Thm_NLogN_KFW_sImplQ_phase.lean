open IntMul KIL KFD KFB KFG KFN Complex
theorem NLogN.KFW.sImplQ_phase {Is : List NLogN.Sym} {Pp : ℕ} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    {Q : NLogN.IState NLogN.HS → Prop} {lo hi : ℕ}
    {ι : Type*} [Fintype ι] [DecidableEq ι] (r S t B u : ℕ) (pos : ι → ℕ)
    (hpos : ∀ i, pos i < t) (a' : ι → ℕ) (hr : 0 < r) (hS : 0 < S) (hB : 1 ≤ B) (Z : ℕ)
    (hZ : NLogN.zsz ((4 * (B * (S * r * 2 ^ t) + S * r + B + 1) : ℕ) : ℤ) ≤ Z)
    {σ : Fin NLogN.HS → Option ℤ} {ρR0 ρt ρB ρu ρV : Fin NLogN.HS}
    (hR : NLogN.KFW.PReg σ ρR0 ρt ρB ρu ρV (S * r) t B u) (hQ : ∀ s, Q s → NLogN.KFW.Agree σ s)
    (εE : NLogN.Ex NLogN.HS) (Bε : ℕ) (hε : ∀ s, Q s → NLogN.KFW.EpsOK s εE t (NLogN.KFN.aEof pos a') Bε)
    (hBε : NLogN.zsz (4 : ℤ) ≤ Bε)
    (hreg : ∀ j ∈ εE.regs, j ∉ [NLogN.KFG.xA, NLogN.KFG.xB, NLogN.KFG.xC, NLogN.KFG.xD, NLogN.KFG.xN, NLogN.KFB.c1, NLogN.KFW.xE, NLogN.KFW.cT]) (hε0 : (0 : Fin NLogN.HS) ∉ εE.regs)
    (hu : ρu ≠ NLogN.KFB.c1) :
    NLogN.KFW.SImplQ Is iprog Q lo hi r (fun i => 2 ^ pos i * S) (B * 2 ^ t * S)
      (Matrix.diagonal fun x => I ^ (u + ∑ i, a' i * (x i).val))
      (NLogN.KFD.fcode (NLogN.KFW.phLU ρR0 ρt ρB ρu ρV εE)) 0 0
      (fun w => NLogN.KFW.cPhU w (B * (S * r * 2 ^ t)) t B Z (S * r) (NLogN.KFW.xPh εE Bε Z)) := by
  intro s f zs l xs F w hq hC h0 hx hl hb _ _
  have hzl : zs.length = B * (S * r * 2 ^ t) := by rw [hx.1, hl]; ring
  have h0σ : σ 0 = none := hR.off 0 (by decide)
  have hfr : ∀ j, (σ j).isSome → f j = [] := fun j hj => by
    have : j ≠ 0 := by rintro rfl; simp [h0σ] at hj
    exact hC j this
  have P := NLogN.KFW.phLU_fsp s f (S * r) t B u (NLogN.KFN.aEof pos a') zs l hB (Nat.mul_pos hS hr) hzl h0
    hC.clN.t hC.clN.o (hC _ (by decide)) hb Z hZ hR (hQ s hq) hfr εE Bε (hε s hq) hBε hreg
    (hC _ (by decide)) (fun j hj _ => hC j (by rintro rfl; exact hε0 hj))
  set T := NLogN.KFN.tblG (List.replicate (S * r) ((u % 4 : ℕ) : ℤ)) (NLogN.KFN.aEof pos a') t with hT
  have hTl : T.length = S * r * 2 ^ t := by rw [hT, NLogN.KFN.length_tblG, List.length_replicate]
  have hT4 : NLogN.KFG.Ex4 T := NLogN.KFN.ex4_tblG (by
    intro a ha; rw [List.mem_replicate] at ha; rw [ha.2]; omega) _ t
  have hrl : (NLogN.KFN.repT B T).length = zs.length := by rw [NLogN.KFN.length_repT, hTl, hzl]
  refine ⟨NLogN.KFN.phOut (S * r) t B u (NLogN.KFN.aEof pos a') zs, ⟨?_, fun J c hJ => ?_⟩,
    by unfold NLogN.KFN.phOut; exact NLogN.KFG.GB_mulL _ zs (NLogN.KFN.ex4_repT hT4 B) hb,
    P.irun (NLogN.KFW.fok_phLU hu (fun h => hreg _ h (by simp)))⟩
  · rw [NLogN.KFN.phOut, NLogN.KFG.length_mulL _ _ hrl, hx.1, hl, NLogN.KFN.length_selOpF]
  · rw [NLogN.KFN.length_selOpF] at hJ
    have hq : J * r + c < zs.length := by
      rw [hx.1, hl]; have := c.isLt
      have : (J + 1) * r ≤ B * 2 ^ t * S * r := Nat.mul_le_mul_right _ hJ
      rw [Nat.succ_mul] at this; omega
    have hTpos : 0 < S * r * 2 ^ t := by positivity
    rw [NLogN.KFN.phOut, NLogN.KFN.getD_mulL _ _ _ (by rw [hrl]; exact hq) hq,
      NLogN.KFN.getD_repT T B _ (by rw [hTl, ← hzl]; exact hq), hTl,
      NLogN.KFN.getD_tblR _ _ _ t _ (Nat.mod_lt _ hTpos)]
    rw [NLogN.KFG.toC_rot (by positivity) (by omega), Int.toNat_natCast, NLogN.KFG.I_pow_mod4,
      hx.2 J c (by rw [hl]; exact hJ), NLogN.KFN.selOpF_diagonal,
      List.getD_eq_getElem ((List.range (B * 2 ^ t * S)).map _) _ (by rw [List.length_map, List.length_range]; exact hJ), List.getElem_map, List.getElem_range]
    simp only [Pi.smul_apply, smul_eq_mul, add_zero]
    have hJr : (J * r + c) / r = J := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hr, Nat.div_eq_of_lt c.isLt, zero_add]
    have hb : ∀ p < t, (J * r + c) % (S * r * 2 ^ t) / (S * r) / 2 ^ p % 2 = J / S / 2 ^ p % 2 := by
      intro p hp
      rw [Nat.mod_mul_right_div_self, mul_comm S r, ← Nat.div_div_eq_div_mul, hJr, NLogN.KFN.bit_mod _ _ _ hp]
    have hf : ∀ i, ((NLogN.KFN.fbit (fun i => 2 ^ pos i * S) J i : Fin 2) : ℕ) = J / S / 2 ^ pos i % 2 := by
      intro i
      simp only [NLogN.KFN.fbit]
      rw [Nat.div_div_eq_div_mul, mul_comm S]
    rw [Finset.sum_congr rfl (fun p hp => by rw [hb p (Finset.mem_range.1 hp)]),
      NLogN.KFN.sum_aEof pos a' t hpos]
    simp only [hf]
    ring
end
