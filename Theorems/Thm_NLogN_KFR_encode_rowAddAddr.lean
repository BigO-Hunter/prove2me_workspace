open NLogN
open NLogN.KFR
open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly KFN
variable {K m k e : ℕ} {pos : Fin m × Fin (m ^ k) → ℕ}
variable {t S0 B : ℕ} {σ : Fin 3 → Fin m}
  (he : ∀ p, pos p + K * (p.2.val + m ^ k * p.1.val) = e) (htop : e - e % K + K ≤ t)
  (hσ : σ 0 < σ 1 ∧ σ 1 < σ 2)
include he htop hσ
theorem NLogN.KFR.encode_rowAddAddr (hK : 1 ≤ K) {q : ℕ} (hq : q < B * 2 ^ t * S0) {px py : Fin 3}
    {i j : Fin m} (hi : σ px = i) (hj : σ py = j) (hij : i ≠ j) :
    ((AModel.encode (NLogN.KFR.shR K (m ^ k) e t S0 B σ)
        (NLogN.KFH.rowAddAddr K (e % K) (m ^ k) px py (AModel.decode (NLogN.KFR.shR K (m ^ k) e t S0 B σ) q)) : ℕ) : ℤ) =
      NLogN.KFN.fsetZ (fun p => 2 ^ pos p * S0) q (P8Lift.rowAddr i j (NLogN.KFN.fbit (fun p => 2 ^ pos p * S0) q)) := by
  subst hi hj
  have hq' : q < AModel.vol (NLogN.KFR.shR K (m ^ k) e t S0 B σ) := by rw [NLogN.KFR.shR_vol he htop hσ]; exact hq
  have hv := AModel.valid_decode hq'
  have hlen : (AModel.decode (NLogN.KFR.shR K (m ^ k) e t S0 B σ) q).length = 7 := by
    rw [hv.length_eq, NLogN.KFR.shR_length he htop hσ]
  unfold NLogN.KFH.rowAddAddr
  rw [NLogN.KFH.encode_set _ _ _ _ (by rw [hlen]; fin_cases py <;> simp [NLogN.KFH.slotF])
      (by rw [hlen, NLogN.KFR.shR_length he htop hσ]), AModel.encode_decode hq',
    NLogN.KFR.shR_digit he htop hσ hq px, NLogN.KFR.shR_digit he htop hσ hq py, NLogN.KFR.shR_weight he htop hσ,
    NLogN.KFR.xor_mask_sub hK (Nat.mod_lt _ (by omega)) le_rfl (Nat.mod_lt _ (by positivity))
      (Nat.mod_lt _ (by positivity)),
    NLogN.KFR.fsetZ_rowAddr _ q _ _ hij, Finset.sum_mul]
  congr 1
  refine Finset.sum_congr rfl fun u hu => ?_
  have hu : u < m ^ k := Finset.mem_range.1 hu
  have hl : e % K + u * K < m ^ k * K := by
    have := Nat.mod_lt e (show 0 < K by omega)
    have : (u + 1) * K ≤ m ^ k * K := Nat.mul_le_mul_right _ hu
    rw [Nat.succ_mul] at this; omega
  rw [NLogN.KFR.bitZ_xor_digit hl, NLogN.KFR.bitZ_digit hl]
  unfold NLogN.KFR.rowTerm
  rw [dif_pos (by omega)]
  have hW : ∀ r : Fin m, 2 ^ NLogN.KFR.sR K (m ^ k) e r * S0 * 2 ^ (e % K + u * K) =
      2 ^ pos (r, ⟨m ^ k - 1 - u, by omega⟩) * S0 := fun r => by
    rw [NLogN.KFR.pos_eq_sR he r hu, add_assoc, pow_add]; ring
  rw [hW, hW, mul_assoc]
  congr 1
  simp only []; rw [← hW (σ py)]; push_cast; ring
end
