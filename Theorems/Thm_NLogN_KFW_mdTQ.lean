    SImplQ I iprog (fun s => Agree σ s) lo hi r st n T (withPushI (fr l) U) e dw
      (fun w => cFrame l.length sz B + cost w + (l.length * (2 * B + 2) + 1)) := by
  have := sImplQ_push σ hσ0 (fun s h => h) (fr l) (frV σ l) _ B (pushSeq_NE σ M B sz hM l h hn)
    (by
      rw [fr_keys]; intro hm
      obtain ⟨x, hx, e⟩ := List.mem_map.1 hm
      exact h0 x hx e)
    (frV_zsz hM h) (fun s hs => agree_pushSt' _ hs) H
  rw [frV_length] at this
  exact this

/-- The test frame. -/
theorem sImplQ_test {σ : Fin HS → Option ℤ} (hσ0 : σ 0 = none) (x : Fin HS) (hx : x.val < 56)
    (hx0 : x ≠ 0) (c : NE) (M B sz : ℕ) (hM : zsz (M : ℤ) ≤ B) (hc : c.RegsLt)
    (hsz : c.size ≤ sz) (hnat : NatR σ c) (hok : c.OK (NLogN.KFW.vOf σ) M)
    {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {p q : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (H : SImplQ I iprog (fun s => Agree (σPush σ [(x, ((c.val (NLogN.KFW.vOf σ) : ℕ) : ℤ))]) s) lo hi r st n T
      (if c.val (NLogN.KFW.vOf σ) = 0 then p else q) e dw cost) :
    SImplQ I iprog (fun s => Agree σ s) lo hi r st n T (testC x c p q) e dw
