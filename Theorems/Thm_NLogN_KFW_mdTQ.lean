theorem qopU_writes_any (M : M2G) : ∀ k ∈ (qopU [M] eB1L eGL).writes, k ∈ gT := by
  have : (qopU [M] eB1L eGL).writes = (qopU [MC] eB1L eGL).writes := rfl
  rw [this]; exact qopU_writes

theorem touch_zb (M : M2G) : ∀ k ∈ touch (zb M), k ∈ gT := by
  intro k hk
  simp only [zb, touch, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hk
  have hr : ∀ p q : GI, ∀ j ∈ (lcE (reT p q)).regs, j ∈ gT := fun p q j hj => by
    have := lcE_regs' _ j hj
    simp only [reT, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] at this
    rcases this with rfl | rfl | rfl | rfl <;> decide
  have hi : ∀ p q : GI, ∀ j ∈ (lcE (imT p q)).regs, j ∈ gT := fun p q j hj => by
    have := lcE_regs' _ j hj
    simp only [imT, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] at this
    rcases this with rfl | rfl | rfl | rfl <;> decide
  rcases hk with (h | h) | (h | h) | (h | h) | (h | h) | h | h | h | h
  all_goals first | (subst h; decide) | exact hr _ _ _ h | exact hi _ _ _ h

theorem qop_touch_any (M : M2G) : ∀ k ∈ touch (qop [M]), k ∈ gT := by
  intro k hk
  have f1 : ∀ k ∈ touch (NLogN.mvK 0 NLogN.KFB.qT c1 (.reg rB4)), k ∈ gT := by decide
  have f2 : ∀ k ∈ touch (distB rVr rVi), k ∈ gT := by decide
  have f3 : ∀ k ∈ touch (distB rUr rUi), k ∈ gT := by decide
  have f4 : ∀ k ∈ touch (NLogN.mvK qO NLogN.KFB.qT c1 (.reg NLogN.KFB.rB2)), k ∈ gT := by decide
  have f5 : ∀ k ∈ touch (NLogN.mvK NLogN.KFB.qT NLogN.KFB.qA c1 (.reg NLogN.KFB.rB2)), k ∈ gT := by decide
  have f6 : ∀ k ∈ touch (NLogN.mvK NLogN.KFB.qA 0 c1 (.reg NLogN.KFB.rN)), k ∈ gT := by decide
  have f7 : ∀ k ∈ ([cG] ++ (Ex.reg NLogN.KFB.rG : Ex HS).regs ++ [c1] ++ (Ex.reg NLogN.KFB.rB : Ex HS).regs), k ∈ gT := by decide
  revert k
  simp only [qop, blks, NLogN.KFB.blk, zipR, touch, List.forall_mem_append, List.forall_mem_cons,
    List.append_nil, List.cons_append, List.nil_append]
  and_intros
  all_goals first
    | decide
    | exact f1 | exact f2 | exact f3 | exact f4 | exact f5 | exact f6
    | exact touch_zb M
    | (intro x hx; simp at hx)

