    (h0 : ∀ x ∈ l, x.1 ≠ 0) {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {U : IStmt HS Pp}
    {e dw : ℕ} {cost : ℕ → ℕ}
