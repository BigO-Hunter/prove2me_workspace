    apply min_eq_left
    have : (x + 1) * (F' * Y) ≤ X * (F' * Y) := Nat.mul_le_mul_right _ hx
    have h2 : F * Y ≤ F' * Y := Nat.mul_le_mul_right _ hF
    rw [Nat.succ_mul] at this; omega)]

