open IntMul RS AModel AModelL12

theorem unpadL_succ {α : Type*} (k F F' Y : ℕ) (ys : List α) :
    unpadL (k + 1) F F' Y ys = unpadL k F F' Y ys ++ (ys.drop (k * (F' * Y))).take (F * Y) := by
  simp [unpadL, List.range_succ, List.flatMap_append]

theorem bnd_unpadL {Bb : ℕ} {X F F' Y : ℕ} {ys : List ℤ} (h : Bnd Bb ys) :
    Bnd Bb (unpadL X F F' Y ys) := by
  intro a ha
  simp only [unpadL, List.mem_flatMap] at ha
  obtain ⟨x, -, hx⟩ := ha
  exact h a (List.mem_of_mem_drop (List.mem_of_mem_take hx))

end NLogN.KIL

end

