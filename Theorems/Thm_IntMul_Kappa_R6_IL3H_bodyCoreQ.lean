    {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {U : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (H : SImplQ I iprog (fun s => Agree σ s) lo hi r st n T U e dw cost)
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ)) (F w : ℕ)
    (hC : Clean0 f) (h0 : f 0 = gflat zs ++ l) (hx : RecRep r F zs xs) (hl : xs.length = n)
